          <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — Art helpers (v0.7 "Art 1")
	Small procedural-modeling kit used by WeaponVisuals, BotStyles, the arena and the lobby.
	Every part is built in the LOCAL space of an anchor part and welded to it, so a model can be
	authored once ("−Y = away from the wrist, −Z = forward") and attached to any limb.

	All decorative parts are massless, non-colliding and non-queryable, so art can never change
	physics or hit detection.
]]

local Art = {}

export type Kit = {
	Model: Instance,
	Anchor: BasePart,
	Origin: CFrame, -- world CFrame that local coordinates are relative to
	Scale: number,
}

local ROT_Y_TO_X = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis (X) -> local Y
local ROT_Z_TO_X = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis (X) -> local Z

function Art.Kit(model: Instance, anchor: BasePart, origin: CFrame?, scale: number?): Kit
	return { Model = model, Anchor = anchor, Origin = origin or anchor.CFrame, Scale = scale or 1 }
end

function Art.Decor(p: BasePart)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end
Art.Weld = weld

local function scaled(k: Kit, cf: CFrame): CFrame
	if k.Scale == 1 then
		return cf
	end
	local p = cf.Position * k.Scale
	return CFrame.new(p) * (cf - cf.Position)
end

-- Core: place a part at local CFrame `cf` (relative to kit origin) and weld it to the anchor.
function Art.Part(
	k: Kit,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?,
	name: string?
): Part
	local p = Instance.new("Part")
	p.Name = name or "Art"
	if shape then
		p.Shape = shape
	end
	p.Size = size * k.Scale
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	Art.Decor(p)
	p.CFrame = k.Origin * scaled(k, cf)
	weld(k.Anchor, p)
	p.Parent = k.Model
	return p
end

function Art.Box(k: Kit, size: Vector3, pos: Vector3 | CFrame, color: Color3, mat: Enum.Material?, name: string?): Part
	local cf = if typeof(pos) == "CFrame" then pos else CFrame.new(pos)
	return Art.Part(k, size, cf, color, mat, nil, name)
end

function Art.Ball(k: Kit, d: number, pos: Vector3, color: Color3, mat: Enum.Material?, name: string?): Part
	return Art.Part(k, Vector3.new(d, d, d), CFrame.new(pos), color, mat, Enum.PartType.Ball, name)
end

-- Cylinders along local X / Y / Z.  `rot` is an optional extra rotation applied after placement.
function Art.CylX(k: Kit, d: number, len: number, pos: Vector3, color: Color3, mat: Enum.Material?, name: string?, rot: CFrame?): Part
	return Art.Part(k, Vector3.new(len, d, d), CFrame.new(pos) * (rot or CFrame.identity), color, mat, Enum.PartType.Cylinder, name)
end

function Art.CylY(k: Kit, d: number, len: number, pos: Vector3, color: Color3, mat: Enum.Material?, name: string?, rot: CFrame?): Part
	return Art.Part(k, Vector3.new(len, d, d), CFrame.new(pos) * (rot or CFrame.identity) * ROT_Y_TO_X, color, mat, Enum.PartType.Cylinder, name)
end

function Art.CylZ(k: Kit, d: number, len: number, pos: Vector3, color: Color3, mat: Enum.Material?, name: string?, rot: CFrame?): Part
	return Art.Part(k, Vector3.new(len, d, d), CFrame.new(pos) * (rot or CFrame.identity) * ROT_Z_TO_X, color, mat, Enum.PartType.Cylinder, name)
end

function Art.Wedge(k: Kit, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, name: string?): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = name or "Art"
	p.Size = size * k.Scale
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	Art.Decor(p)
	p.CFrame = k.Origin * scaled(k, cf)
	weld(k.Anchor, p)
	p.Parent = k.Model
	return p
end

-- A straight beam-like box from local point a to local point b.
function Art.Segment(k: Kit, a: Vector3, b: Vector3, thick: number, color: Color3, mat: Enum.Material?, name: string?): Part
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local dir = b - a
	local cf
	if len < 1e-4 then
		cf = CFrame.new(mid)
	elseif math.abs(dir.Unit.Y) > 0.98 then
		cf = CFrame.lookAt(mid, b, Vector3.xAxis) -- vertical: avoid a degenerate up-vector
	else
		cf = CFrame.lookAt(mid, b)
	end
	return Art.Part(k, Vector3.new(thick, thick, len + thick * 0.35), cf, color, mat, nil, name)
end

-- Arc made of segments.  `point(theta)` returns a local position; angles in degrees.
function Art.Arc(
	k: Kit,
	point: (number) -> Vector3,
	a0: number,
	a1: number,
	segments: number,
	thick: number,
	color: Color3,
	mat: Enum.Material?,
	name: string?
): { Part }
	local out = {}
	for i = 0, segments - 1 do
		local t0 = math.rad(a0 + (a1 - a0) * i / segments)
		local t1 = math.rad(a0 + (a1 - a0) * (i + 1) / segments)
		table.insert(out, Art.Segment(k, point(t0), point(t1), thick, color, mat, name))
	end
	return out
end

-- Ring of segments in the plane perpendicular to local `axis` ("X" | "Y" | "Z").
function Art.Ring(k: Kit, center: Vector3, radius: number, axis: string, segments: number, thick: number, color: Color3, mat: Enum.Material?, name: string?): { Part }
	local function pt(t: number): Vector3
		local c, s = math.cos(t) * radius, math.sin(t) * radius
		if axis == "X" then
			return center + Vector3.new(0, c, s)
		elseif axis == "Y" then
			return center + Vector3.new(c, 0, s)
		end
		return center + Vector3.new(c, s, 0)
	end
	return Art.Arc(k, pt, 0, 360, segments, thick, color, mat, name)
end

function Art.Light(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

-- Deterministic 0..1 hash for stable per-tile / per-prop variation.
function Art.Hash(a: number, b: number, c: number?, d: number?): number
	local n = math.sin(a * 12.9898 + b * 78.233 + (c or 0) * 37.719 + (d or 0) * 19.191) * 43758.5453
	return n - math.floor(n)
end

function Art.Shade(color: Color3, f: number): Color3
	return Color3.new(math.clamp(color.R * f, 0, 1), math.clamp(color.G * f, 0, 1), math.clamp(color.B * f, 0, 1))
end

-- World-anchored static prop part (for arena / lobby set dressing).
-- v0.9.14 BRAND PALETTE: one deliberate set of accent colours for the whole game, so props read as
-- designed (orange + teal + gold on cream/wood/ink) instead of a random rainbow.
Art.Brand = {
	Orange = Color3.fromRGB(255, 120, 60),
	Teal = Color3.fromRGB(34, 160, 150),
	Gold = Color3.fromRGB(246, 176, 40),
	Cream = Color3.fromRGB(252, 248, 238),
	Ink = Color3.fromRGB(38, 42, 66),
	Red = Color3.fromRGB(226, 76, 70),
}

function Art.Static(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, v in props do
		(p :: any)[key] = v
	end
	p.Parent = parent
	return p
end

------------------------------------------------------------------------
-- v0.7.1 SOFTEN: turn a sharp block Part into a rounded-edge composite (no meshes needed).
--   • long bars / pillars (square-ish cross-section) → edges along the long axis are rounded
--   • slabs / panels / cubes → edges along the thinnest axis are rounded (rounded rectangle)
-- The original part stays as the core (keeps its collisions, prompts, SurfaceGuis, welds);
-- one cross box + 4 edge cylinders are added. Unanchored parts get their extras welded on.
------------------------------------------------------------------------
type SoftenOpts = { MaxRadius: number?, MinRadius: number?, Ratio: number?, Filter: ((BasePart) -> boolean)? }

local AXES = { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis }

local function comp(v: Vector3, i: number): number
	return if i == 1 then v.X elseif i == 2 then v.Y else v.Z
end

local function vec(i: number, a: number, j: number, b: number, k: number, c: number): Vector3
	local t = { 0, 0, 0 }
	t[i], t[j], t[k] = a, b, c
	return Vector3.new(t[1], t[2], t[3])
end

function Art.Soften(part: BasePart, opts: SoftenOpts?): boolean
	local o: SoftenOpts = opts or {}
	if part.ClassName ~= "Part" and part.ClassName ~= "SpawnLocation" then
		return false
	end
	if (part :: Part).Shape ~= Enum.PartType.Block or part.Transparency >= 0.95 or part:GetAttribute("Softened") then
		return false
	end
	local size = part.Size
	local order = { 1, 2, 3 }
	table.sort(order, function(a, b)
		return comp(size, a) < comp(size, b)
	end)
	local s1, s2, s3 = comp(size, order[1]), comp(size, order[2]), comp(size, order[3])
	-- edge axis k = the axis the rounded edges run along; i, j = the rounded cross-section
	-- a "bar" is long AND has a roughly square cross-section (pillar, rail, girder)
	local k = if s3 > 3 * s2 and s2 < 2 * s1 then order[3] else order[1]
	local i, j
	if k == order[3] then
		i, j = order[1], order[2]
	else
		i, j = order[2], order[3]
	end
	local a, b, len = comp(size, i), comp(size, j), comp(size, k)
	local r = math.min(math.min(a, b) * (o.Ratio or 0.25), o.MaxRadius or 2.5)
	if r < (o.MinRadius or 0.12) then
		return false
	end
	part:SetAttribute("Softened", true)
	local cf = part.CFrame
	local anchored = part.Anchored
	local function extra(sz: Vector3, at: CFrame, cyl: boolean): Part
		local e = Instance.new("Part")
		e.Name = part.Name .. "_R"
		if cyl then
			e.Shape = Enum.PartType.Cylinder
		end
		e.Size = sz
		e.CFrame = at
		e.Color = part.Color
		e.Material = part.Material
		e.Transparency = part.Transparency
		e.Reflectance = part.Reflectance
		e.CastShadow = part.CastShadow
		e.CanCollide = part.CanCollide
		e.CanQuery = false
		e.CanTouch = false
		e.Anchored = anchored
		e.Massless = true
		e.TopSurface = Enum.SurfaceType.Smooth
		e.BottomSurface = Enum.SurfaceType.Smooth
		if not anchored then
			e.CanCollide = false
			weld(part, e)
		end
		e.Parent = part.Parent
		return e
	end
	-- core shrinks along i; the cross box covers the rest along j
	part.Size = vec(i, a - 2 * r, j, b, k, len)
	extra(vec(i, a, j, b - 2 * r, k, len), cf, false)
	-- edge cylinders run along axis k (cylinder axis is local X → rotate X onto k)
	local rot = if k == 1 then CFrame.identity elseif k == 2 then CFrame.Angles(0, 0, math.rad(90)) else CFrame.Angles(0, math.rad(90), 0)
	for _, si in { -1, 1 } do
		for _, sj in { -1, 1 } do
			local off = AXES[i] * (si * (a / 2 - r)) + AXES[j] * (sj * (b / 2 - r))
			extra(Vector3.new(len, 2 * r, 2 * r), cf * CFrame.new(off) * rot, true)
		end
	end
	return true
end

-- Soften every eligible block Part under `root`.
function Art.SoftenAll(root: Instance, opts: SoftenOpts?)
	local list = {}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local f = opts and opts.Filter
			if not f or f(d) then
				table.insert(list, d)
			end
		end
	end
	for _, p in list do
		Art.Soften(p, opts)
	end
end

------------------------------------------------------------------------
-- v0.7.2 TOON: the reference look — flat SmoothPlastic colour everywhere (no metal/leather/
-- slate textures, no reflections), near-black lifted a little so shadows read soft.
-- Neon (glows, rarity gems, crack stages) and ForceField are left alone.
------------------------------------------------------------------------
-- v0.7.3: a true ellipsoid prop (Ball parts are always uniform spheres): a block with a sphere
-- SpecialMesh scaled to its size. Marked Softened so SoftenAll leaves it alone.
function Art.Egg(parent: Instance, size: Vector3, cf: CFrame, color: Color3, collide: boolean?): Part
	local p = Art.Static(parent, { Name = "Egg", Size = size, CFrame = cf, Color = color })
	p.CanCollide = collide == true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p:SetAttribute("Softened", true)
	return p
end

------------------------------------------------------------------------
-- v0.8 LOW-POLY NATURE KIT
-- Real faceted shapes (cones, tapered rock bodies, shards) built from triangles: each triangle
-- is two WedgeParts, so it needs no uploaded meshes. Facets get a small shade jitter, which gives
-- the classic soft low-poly look under Future lighting. This replaces the v0.7.5 ellipsoid stacks,
-- which read as "snowmen" from a distance.
------------------------------------------------------------------------
local function newWedge(parent: Instance, color: Color3, collide: boolean?): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.CanCollide = collide == true
	w.CanQuery = collide == true
	w.CanTouch = false
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Material = Enum.Material.SmoothPlastic
	w.Color = color
	w.Parent = parent
	return w
end

-- A solid triangle a-b-c (thickness `thick`, centred on the triangle's plane).
function Art.Tri(parent: Instance, a: Vector3, b: Vector3, c: Vector3, color: Color3, thick: number?, collide: boolean?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	-- put the longest edge on b-c (a = the corner opposite it)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cr = ac:Cross(ab)
	if cr.Magnitude < 1e-6 or bc.Magnitude < 1e-4 then
		return
	end
	local right = cr.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 0.02 then
		return
	end
	local t = thick or 0.3
	local d1, d2 = math.abs(ab:Dot(back)), math.abs(ac:Dot(back))
	if d1 > 0.02 then
		local w1 = newWedge(parent, color, collide)
		w1.Size = Vector3.new(t, height, d1)
		w1.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
	end
	if d2 > 0.02 then
		local w2 = newWedge(parent, color, collide)
		w2.Size = Vector3.new(t, height, d2)
		w2.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
	end
end

-- A ring of n jittered points around `center` (rx/rz radii, `y` offset). Rings that share
-- (seed, salt) share their angles and radius jitter, so bands between them line up.
-- p > 2 gives a superellipse (rounded rectangle) for rectangular islands.
local function ringPts(center: Vector3, n: number, rx: number, rz: number, y: number, seed: number, salt: number, jr: number, jy: number, p: number?): { Vector3 }
	local pts = {}
	local e = 2 / (p or 2)
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2 + (Art.Hash(seed, salt, k) - 0.5) * (math.pi * 2 / n) * 0.35
		local s = 1 + (Art.Hash(seed, salt, k, 2) - 0.5) * 2 * jr
		local ca, sa = math.cos(a), math.sin(a)
		local x = math.sign(ca) * math.abs(ca) ^ e
		local z = math.sign(sa) * math.abs(sa) ^ e
		pts[k + 1] = center + Vector3.new(x * rx * s, y + (Art.Hash(seed, salt, k, 3) - 0.5) * 2 * jy, z * rz * s)
	end
	return pts
end

local function band(parent: Instance, A: { Vector3 }, B: { Vector3 }, colA: Color3, colB: Color3, seed: number, salt: number, thick: number)
	local n = #A
	for k = 1, n do
		local k2 = k % n + 1
		local col = (k % 2 == 0) and colA or colB
		Art.Tri(parent, A[k], A[k2], B[k2], Art.Shade(col, 0.93 + Art.Hash(seed, salt, k) * 0.12), thick)
		Art.Tri(parent, A[k], B[k2], B[k], Art.Shade(col, 0.88 + Art.Hash(seed, salt, k, 5) * 0.12), thick)
	end
end

local function fan(parent: Instance, A: { Vector3 }, apex: Vector3, col: Color3, seed: number, salt: number, thick: number)
	local n = #A
	for k = 1, n do
		Art.Tri(parent, A[k], A[k % n + 1], apex, Art.Shade(col, 0.9 + Art.Hash(seed, salt, k) * 0.14), thick)
	end
end

local PINE_GREENS = { Color3.fromRGB(44, 132, 82), Color3.fromRGB(56, 152, 90), Color3.fromRGB(74, 172, 98) }
local SNOW_GREENS = { Color3.fromRGB(52, 120, 116), Color3.fromRGB(64, 136, 126), Color3.fromRGB(236, 246, 255) }
local BARK = Color3.fromRGB(122, 82, 56)
-- v0.9.10 DETAIL & VARIETY: pines come in several species so a forest never repeats one colour
-- (weights: classic green 4, teal fir 2, spring lime 2, autumn 1, golden larch 1, blossom 1)
local PINE_SPECIES = { -- v0.9.14: greens + teal fir only (autumn / golden / lime removed: read as random)
	PINE_GREENS,
	PINE_GREENS,
	PINE_GREENS,
	PINE_GREENS,
	{ Color3.fromRGB(30, 118, 108), Color3.fromRGB(40, 138, 120), Color3.fromRGB(58, 158, 134) }, -- teal fir
	{ Color3.fromRGB(30, 118, 108), Color3.fromRGB(40, 138, 120), Color3.fromRGB(58, 158, 134) },
}
Art.PineSpecies = PINE_SPECIES
-- round-tree canopies (3 shades each): green, deep green, autumn, blossom, golden, plum
Art.LeafSpecies = { -- v0.9.14: two greens only (the autumn / pink / gold / plum mix read as random)
	{ Color3.fromRGB(116, 196, 90), Color3.fromRGB(138, 212, 102), Color3.fromRGB(100, 182, 84) },
	{ Color3.fromRGB(116, 196, 90), Color3.fromRGB(138, 212, 102), Color3.fromRGB(100, 182, 84) },
	{ Color3.fromRGB(64, 160, 92), Color3.fromRGB(84, 178, 104), Color3.fromRGB(52, 142, 84) },
}
local BARKS = { BARK, Color3.fromRGB(104, 70, 50) }
Art.Barks = BARKS
local PINE_TIERS = { { R = 0.37, Yb = 0.2, Ya = 0.62 }, { R = 0.29, Yb = 0.4, Ya = 0.81 }, { R = 0.21, Yb = 0.59, Ya = 1.0 } }

export type PineOpts = { Snow: boolean?, Colors: { Color3 }? }

-- Low-poly pine: a trunk and three faceted 7-sided cones with drooping, jittered rims.
function Art.Pine(parent: Instance, base: Vector3, h: number, seed: number?, collideTrunk: boolean?, opts: PineOpts?): Model
	local o: PineOpts = opts or {}
	local m = Instance.new("Model")
	m.Name = "Pine"
	local sd = seed or math.floor(base.X * 7 + base.Z * 13)
	local greens = o.Colors
		or (o.Snow and SNOW_GREENS or PINE_SPECIES[1 + math.floor(Art.Hash(sd, 991) * #PINE_SPECIES) % #PINE_SPECIES])
	local bark = BARKS[1 + math.floor(Art.Hash(sd, 992) * #BARKS) % #BARKS]
	local trunk = Art.Static(m, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h * 0.36, h * 0.1, h * 0.1), CFrame = CFrame.new(base + Vector3.new(0, h * 0.18, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = bark })
	trunk:SetAttribute("Softened", true)
	if collideTrunk then
		trunk.CanCollide = true
		trunk.CanQuery = true
	end
	local sides = 7
	for k, T in PINE_TIERS do
		local rim = ringPts(base, sides, h * T.R, h * T.R, h * T.Yb, sd, 100 + k, 0.1, h * 0.02)
		local tip = base + Vector3.new((Art.Hash(sd, k, 7) - 0.5) * h * 0.04, h * T.Ya, (Art.Hash(sd, k, 8) - 0.5) * h * 0.04)
		fan(m, rim, tip, greens[k], sd, 110 + k, 0.25)
		if k == 1 then
			-- underside of the lowest skirt, slightly hollow
			fan(m, rim, base + Vector3.new(0, h * (T.Yb + 0.07), 0), Art.Shade(greens[1], 0.8), sd, 120, 0.25)
		end
	end
	m.Parent = parent
	return m
end

export type IslandOpts = { Low: boolean?, Sides: number?, Squash: number?, Dirt: Color3? }

-- Floating island: a flat polygon grass slab (top surface exactly at `top`, walk-safe), a dirt
-- band, and a faceted rock body that tapers to a hanging point. Decorative (no collisions).
-- opts.Low = cheaper far-away version (one rock band fewer, no shards).
function Art.Island(parent: Instance, top: Vector3, r: number, seed: number, grass: Color3?, rockA: Color3?, rockB: Color3?, opts: IslandOpts?): Model
	local o: IslandOpts = opts or {}
	local m = Instance.new("Model")
	m.Name = "Island"
	local G = grass or Color3.fromRGB(120, 196, 96)
	local RA = rockA or Color3.fromRGB(150, 140, 190)
	local RB = rockB or Color3.fromRGB(118, 108, 160)
	local DIRT = o.Dirt or Color3.fromRGB(156, 112, 82)
	local low = o.Low == true
	local n = o.Sides or (r >= 20 and 14 or (r >= 7 and 9 or 7))
	local rz = r * (o.Squash or 1)
	local function H(b: number, c: number?): number
		return Art.Hash(seed, b, c)
	end
	-- grass slab
	local rim = ringPts(top, n, r, rz, -0.7, seed, 1, 0.07, 0)
	fan(m, rim, top - Vector3.new(0, 0.7, 0), G, seed, 2, 1.4)
	-- dirt band (same salt as the rim, so it lines up just inside the grass lip)
	local dirtDepth = math.max(1.6, r * 0.16)
	local d0 = ringPts(top, n, r * 0.975, rz * 0.975, -1.2, seed, 1, 0.07, 0)
	local d1 = ringPts(top, n, r * 0.9, rz * 0.9, -1.2 - dirtDepth, seed, 1, 0.07, 0)
	band(m, d0, d1, DIRT, Art.Shade(DIRT, 0.86), seed, 3, 0.4)
	-- rock body
	local y1 = -1.2 - dirtDepth
	local prev = d1
	if not low then
		local r1 = ringPts(top, n, r * 0.74, rz * 0.74, y1 - r * 0.36, seed, 4, 0.1, r * 0.06)
		band(m, prev, r1, RA, RB, seed, 5, 0.5)
		prev = r1
	end
	local r2 = ringPts(top, n, r * 0.4, rz * 0.4, y1 - r * (low and 0.55 or 0.82), seed, 6, 0.15, r * 0.08)
	band(m, prev, r2, RA, RB, seed, 7, 0.5)
	local apex = top + Vector3.new((H(8) - 0.5) * r * 0.25, y1 - r * (1.25 + H(9) * 0.3), (H(10) - 0.5) * r * 0.25)
	fan(m, r2, apex, RB, seed, 11, 0.5)
	if not low then
		for k = 1, 2 do
			local a = H(20, k) * math.pi * 2
			local p = top + Vector3.new(math.cos(a) * r * 0.45, y1 - r * 0.7, math.sin(a) * rz * 0.45)
			Art.Shard(m, p, r * 0.14, r * (0.45 + H(21, k) * 0.25), seed + k * 17, k == 1 and RA or RB)
		end
	end
	m.Parent = parent
	return m
end

-- Big rectangular island underside (the Yard): superellipse rim that hugs a w × d slab.
function Art.IslandUnder(parent: Instance, rimCenter: Vector3, w: number, d: number, depth: number, seed: number, rockA: Color3, rockB: Color3, sides: number?)
	local n = sides or 24
	local r0 = ringPts(rimCenter, n, w / 2, d / 2, 0, seed, 1, 0.02, 0, 4)
	local r1 = ringPts(rimCenter, n, w * 0.42, d * 0.4, -depth * 0.28, seed, 2, 0.06, depth * 0.04, 3)
	local r2 = ringPts(rimCenter, n, w * 0.26, d * 0.24, -depth * 0.6, seed, 3, 0.12, depth * 0.05, 2)
	band(parent, r0, r1, rockA, rockB, seed, 4, 0.8)
	band(parent, r1, r2, rockB, rockA, seed, 5, 0.8)
	fan(parent, r2, rimCenter - Vector3.new(0, depth, 0), rockA, seed, 6, 0.8)
end

-- Hanging rock shard: an n-sided inverted pyramid (top cap optional).
function Art.Shard(parent: Instance, top: Vector3, radius: number, length: number, seed: number, color: Color3, sides: number?, cap: boolean?)
	local n = sides or 5
	local rim = ringPts(top, n, radius, radius, 0, seed, 31, 0.15, radius * 0.15)
	local tip = top + Vector3.new((Art.Hash(seed, 32) - 0.5) * radius * 0.8, -length, (Art.Hash(seed, 33) - 0.5) * radius * 0.8)
	fan(parent, rim, tip, color, seed, 34, 0.3)
	if cap then
		fan(parent, rim, top + Vector3.new(0, radius * 0.25, 0), Art.Shade(color, 1.05), seed, 35, 0.3)
	end
end

-- Faceted blob (low-poly "geo sphere") centred at `center`: tree canopies, bushes, clouds.
function Art.Blob(parent: Instance, center: Vector3, sx: number, sy: number, seed: number, color: Color3, sides: number?)
	local n = sides or 7
	local up = ringPts(center, n, sx * 0.42, sx * 0.42, sy * 0.24, seed, 51, 0.12, sy * 0.05)
	local dn = ringPts(center, n, sx * 0.5, sx * 0.5, -sy * 0.12, seed, 51, 0.12, sy * 0.05)
	local tip = center + Vector3.new((Art.Hash(seed, 52) - 0.5) * sx * 0.12, sy * 0.5, (Art.Hash(seed, 53) - 0.5) * sx * 0.12)
	local bottom = center - Vector3.new(0, sy * 0.42, 0)
	fan(parent, up, tip, Art.Shade(color, 1.06), seed, 54, 0.3)
	band(parent, up, dn, color, Art.Shade(color, 0.94), seed, 55, 0.3)
	fan(parent, dn, bottom, Art.Shade(color, 0.82), seed, 56, 0.3)
end

-- Low-poly boulder sitting on the ground at `base`.
function Art.Rock(parent: Instance, base: Vector3, size: number, seed: number, color: Color3)
	local n = 6
	local ground = ringPts(base, n, size * 0.56, size * 0.5, -size * 0.05, seed, 41, 0.15, 0)
	local mid = ringPts(base, n, size * 0.5, size * 0.45, size * 0.28, seed, 41, 0.15, size * 0.05)
	local high = ringPts(base, n, size * 0.3, size * 0.28, size * 0.6, seed, 42, 0.2, size * 0.06)
	local tip = base + Vector3.new((Art.Hash(seed, 43) - 0.5) * size * 0.2, size * 0.72, (Art.Hash(seed, 44) - 0.5) * size * 0.2)
	band(parent, ground, mid, color, Art.Shade(color, 0.92), seed, 45, 0.3)
	band(parent, mid, high, Art.Shade(color, 1.04), color, seed, 46, 0.3)
	fan(parent, high, tip, Art.Shade(color, 1.08), seed, 47, 0.3)
end

function Art.ToonPart(p: BasePart, lift: number?)
	local m = p.Material
	if m == Enum.Material.Neon or m == Enum.Material.ForceField then
		return
	end
	p.Material = Enum.Material.SmoothPlastic
	p.Reflectance = 0
	local c = p.Color
	local l = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	local amount = lift or 0.18
	if l < 0.22 and amount > 0 then
		p.Color = c:Lerp(Color3.fromRGB(120, 116, 150), amount * (1 - l / 0.22))
	end
end

function Art.Toon(root: Instance, lift: number?)
	if root:IsA("BasePart") then
		Art.ToonPart(root, lift)
	end
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and not d:IsA("Terrain") then
			Art.ToonPart(d, lift)
		end
	end
end

------------------------------------------------------------------------
-- v0.9.10 VARIETY PASS: repeated base colours (wood, stone, grass, dirt...) get one of several
-- related tones per object, so the world never shows one flat colour everywhere. Every part of
-- the same Model gets the same tone (objects stay coherent); loose parts are grouped by a
-- 24-stud cell. The tone is applied as an offset, so per-facet shading jitter is kept.
-- Parts with a "BaseColor" attribute (map re-tint sources) get the attribute updated too.
------------------------------------------------------------------------
export type VaryFamily = { Base: Color3, Tones: { Color3 }, Tol: number?, ModelsOnly: boolean? }

local function cdist(a: Color3, b: Color3): number
	local dr, dg, db = a.R - b.R, a.G - b.G, a.B - b.B
	return math.sqrt(dr * dr + dg * dg + db * db)
end

function Art.Vary(root: Instance, families: { VaryFamily }, salt: number?, skip: ((BasePart) -> boolean)?): number
	local changed = 0
	local sl = salt or 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and d.Material ~= Enum.Material.Neon and d.Transparency < 0.9 and not d:GetAttribute("NoVary") and not (skip and skip(d)) then
			local col = d.Color
			for fi, fam in families do
				if cdist(col, fam.Base) < (fam.Tol or 0.08) then
					-- group: nearest Model ancestor under root, else a 24-stud cell
					local key: Vector3
					local anc = d:FindFirstAncestorWhichIsA("Model")
					if anc and anc:IsDescendantOf(root) then
						key = anc:GetPivot().Position
					elseif fam.ModelsOnly then
						break
					else
						key = d.Position
					end
					local cx, cy, cz = math.floor(key.X / 24), math.floor(key.Y / 24), math.floor(key.Z / 24)
					local tone = fam.Tones[1 + math.floor(Art.Hash(cx + sl, cz, cy, fi) * #fam.Tones) % #fam.Tones]
					local nc = Color3.new(
						math.clamp(col.R + tone.R - fam.Base.R, 0, 1),
						math.clamp(col.G + tone.G - fam.Base.G, 0, 1),
						math.clamp(col.B + tone.B - fam.Base.B, 0, 1)
					)
					d.Color = nc
					if typeof(d:GetAttribute("BaseColor")) == "Color3" then
						d:SetAttribute("BaseColor", nc)
					end
					changed += 1
					break
				end
			end
		end
	end
	return changed
end

-- the shared families (cozy v0.9.7 palette)
Art.Families = {
	Wood = { Base = Color3.fromRGB(212, 156, 100), Tones = { Color3.fromRGB(212, 156, 100), Color3.fromRGB(228, 174, 96), Color3.fromRGB(190, 132, 86), Color3.fromRGB(232, 196, 146), Color3.fromRGB(204, 128, 92) }, Tol = 0.05 },
	WoodLight = { Base = Color3.fromRGB(232, 190, 132), Tones = { Color3.fromRGB(232, 190, 132), Color3.fromRGB(240, 206, 150), Color3.fromRGB(222, 172, 120), Color3.fromRGB(236, 182, 112) }, Tol = 0.04 },
	WoodDark = { Base = Color3.fromRGB(150, 102, 70), Tones = { Color3.fromRGB(150, 102, 70), Color3.fromRGB(128, 86, 62), Color3.fromRGB(166, 112, 66), Color3.fromRGB(120, 88, 72) }, Tol = 0.05 },
	Rock = { Base = Color3.fromRGB(168, 158, 196), Tones = { Color3.fromRGB(168, 158, 196), Color3.fromRGB(150, 162, 196), Color3.fromRGB(184, 162, 182), Color3.fromRGB(176, 170, 160), Color3.fromRGB(150, 168, 160) }, Tol = 0.09 },
	RockDark = { Base = Color3.fromRGB(128, 118, 162), Tones = { Color3.fromRGB(128, 118, 162), Color3.fromRGB(110, 122, 160), Color3.fromRGB(144, 120, 146), Color3.fromRGB(136, 128, 120), Color3.fromRGB(110, 128, 124) }, Tol = 0.09 },
	Grass = { Base = Color3.fromRGB(116, 196, 98), Tones = { Color3.fromRGB(116, 196, 98), Color3.fromRGB(132, 206, 88), Color3.fromRGB(98, 184, 104), Color3.fromRGB(144, 200, 84), Color3.fromRGB(104, 190, 120) }, Tol = 0.07, ModelsOnly = true },
	Dirt = { Base = Color3.fromRGB(156, 112, 82), Tones = { Color3.fromRGB(156, 112, 82), Color3.fromRGB(170, 116, 72), Color3.fromRGB(140, 104, 86), Color3.fromRGB(164, 124, 92) }, Tol = 0.07 },
}

-- v0.9.13 GLOW GOVERNOR: the lobby is a bright daylight scene, so big or near-white Neon surfaces and
-- strong PointLights bloomed into glare. Tames everything under `root` (and anything added later):
--   * near-white neon is toned down to a mid colour (it bloomed the most)
--   * large neon faces get see-through (the bigger, the more), small trims/gems stay crisp
--   * PointLights are capped (brightness ≤ 0.7, range ≤ 18)
local function tameOne(d: Instance)
	if d:IsA("BasePart") and d.Material == Enum.Material.Neon and not d:GetAttribute("GlowOK") then
		local c = d.Color
		local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
		if lum > 0.68 then
			local k = 0.68 / lum
			d.Color = Color3.new(c.R * k, c.G * k, c.B * k)
		end
		local s = d.Size
		local a, b = math.max(s.X, s.Y, s.Z), s.X + s.Y + s.Z - math.max(s.X, s.Y, s.Z) - math.min(s.X, s.Y, s.Z)
		local face = a * b
		if face > 40 then
			d.Transparency = math.max(d.Transparency, 0.6)
		elseif face > 6 then
			d.Transparency = math.max(d.Transparency, 0.4)
		end
	elseif d:IsA("PointLight") then
		d.Brightness = math.min(d.Brightness * 0.55, 0.7)
		d.Range = math.min(d.Range * 0.75, 18)
	end
end

function Art.TameGlow(root: Instance)
	for _, d in root:GetDescendants() do
		tameOne(d)
	end
	root.DescendantAdded:Connect(function(d)
		task.defer(tameOne, d)
	end)
end

return Art
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Config
	Every tuning number in the game lives here. Values follow the v3 design doc.
	Change numbers here, never inside the services.
]]

local Config = {}

Config.Version = "v1.0.1"

-- DevMode adds a DEV tab to the menu: free spins/coins and "test any weapon at any level"
-- (session-only, never saved).
-- v0.9.7 RC: release-safe by default: ON in Roblox Studio, OFF on live servers. Set
-- DevModeLive = true only for a private test place.
Config.DevModeLive = false
local okStudio, inStudio = pcall(function()
	return game:GetService("RunService"):IsStudio()
end)
Config.DevMode = (okStudio and inStudio == true) or Config.DevModeLive

Config.MaxSeats = 12

------------------------------------------------------------------------
-- ARENA (28×28 tiles, 8 studs each = 224 studs across)
-- 8-stud tiles: a single hole is wider than you can walk across, so it's always a real threat.
------------------------------------------------------------------------
Config.Arena = {
	Size = 28,
	TileSize = 8,
	TileThickness = 3,
	Center = Vector3.new(0, 100, 0), -- top surface of the floor sits at Center.Y
	KillY = 70, -- falling below this height = eliminated
	WarnTime = 1.4, -- crack warning before a tile drops
	WarnTimeOccupied = 2.4, -- slower when a player is standing on it
	RedAt = 0.55, -- fraction of the warning when the tile switches amber -> red
	CrackAt = 0.85, -- v0.7: third crack stage (red tile breaks into cracked lava)
	Grout = 0.3, -- v0.7: visual seam between tiles (studs)
	CoreColor = Color3.fromRGB(150, 204, 240), -- v0.7.2: the never-falling centre (flat sky-blue)
	SpawnRadius = 62,
	OuterRingFrom = 7, -- rings >= this count as the "outer half" for the funnel
	FunnelOuterWeight = 0.7, -- 70% of collapses come from the outer half
	ColorA = Color3.fromRGB(242, 234, 216), -- v0.7.2 flat cream / sand checker
	ColorB = Color3.fromRGB(216, 200, 172),
	MaterialA = Enum.Material.SmoothPlastic,
	MaterialB = Enum.Material.SmoothPlastic,
	WarnColor = Color3.fromRGB(255, 176, 32),
	DangerColor = Color3.fromRGB(255, 58, 38),
}

-- Random holes (Classic). Rate = 8-stud tiles per second (1 tile = 4× the old 4-stud tile).
Config.Collapse = {
	{ Name = "Grace", From = 0, To = 10, Rate = 0 },
	{ Name = "Crumble", From = 10, To = 60, Rate = 1.0 },
	{ Name = "Break", From = 60, To = 120, Rate = 1.6 },
	{ Name = "Collapse", From = 120, To = 150, Rate = 1.4 },
	{ Name = "Sudden Death", From = 150, To = 180, Rate = 0.6 },
}

-- SHRINK: the whole outer ring of tiles drops together, closing in all round long.
-- Ring 13 = the outer edge, ring 0 = the 2×2 centre. Rings below CoreRings never shrink away
-- (only random holes can take them), so the last 32×32 studs are fought over in Sudden Death.
-- Timeline: rings fall at 26, 42, 58, 74, 86, 98, 110, 122, 132, 142, 152, 160 s.
Config.Shrink = {
	FirstAt = 26, -- seconds into the round
	WarnTime = 2.5, -- the whole ring flashes for this long before it drops
	CoreRings = 2,
	Interval = { -- seconds until the NEXT ring, by the phase the current ring fell in
		Grace = 16,
		Crumble = 16,
		Break = 12,
		Collapse = 10,
		["Sudden Death"] = 8,
	},
	BotAvoidLead = 5, -- bots leave the next ring this many seconds before it starts flashing
}

------------------------------------------------------------------------
-- ROUND FLOW
------------------------------------------------------------------------
Config.Round = {
	-- v0.7.1 JOIN PROMPT: before every match each player in the Yard is asked "Join the next match?".
	-- Only players who answer YES play; no answer = sit out. Bots fill every empty seat (12 total).
	-- v1.0 patch FASTER FLOW (new players were leaving during long waits): ~25 s from results to the next fight
	JoinWindow = 12, -- seconds to answer (ends early once everyone has answered)
	VoteGrace = 4, -- everyone answered but not all voted: wait at most this long for the map vote
	StartDelay = 6, -- lobby countdown before the match (late JOIN / leave allowed)
	StartDelayAllIn = 3, -- everyone in the server already joined: start sooner
	NoJoinPause = 3, -- nobody said yes -> short notice, then a bots-only exhibition match (PLAY NOW ends it)
	Countdown = 4, -- frozen on spawn pads: 3, 2, 1, CRUMBLE!
	Cap = 180,
	Results = 7,
	SpawnProtection = 3,
	RespawnDelay = 2.5, -- seconds after falling before you reappear in the Yard
}

------------------------------------------------------------------------
-- LOBBY ("The Yard") — floats above the arena so you can watch the round
------------------------------------------------------------------------
Config.Lobby = {
	Center = Vector3.new(0, 132, 221), -- v0.7.4: front edge stays at z 158 (same gap to the arena)
	Size = Vector2.new(240, 126), -- v0.7.4: 1.5x bigger Yard (Range paddock = back-west corner)
	KillY = 110,
}

Config.Movement = {
	WalkSpeed = 20,
	BlockWalkSpeed = 10,
	JumpPower = 50,
}

------------------------------------------------------------------------
-- COMBAT
------------------------------------------------------------------------
Config.Combat = {
	KBCap = 34, -- v0.7.5: 40 → 34 with the Mythic nerf; v1.0: Void Hook L10 = 17 × 2.03 = 34.5 → 34
	-- SHIELD: very strong while it lasts (blocks 90%), but it's a resource, not a free wall.
	BlockReduction = 0.9, -- block removes 90% of knockback
	GuardMax = 100,
	GuardDrainPerKB = 3, -- per blocked hit: BASE kb × 3 (Boot 14 KB = 42 guard → breaks on the 3rd hit; Void Hook 17 = 51 → 2nd)
	GuardDrainHeld = 5, -- per second while holding block (max ~20 s of turtling even if nobody hits you)
	GuardRegen = 8, -- per second (slow: 12.5 s from empty to full)
	GuardRegenDelay = 2, -- seconds after releasing block before regen starts
	GuardBreakStun = 1.0,
	GuardBreakFullKB = true, -- the hit that breaks your guard lands at FULL knockback
	MinBlockGuard = 15, -- can't raise the shield again until guard is back above this
	ParryWindow = 0.18,
	ParryStagger = 0.5,
	ParrySpamLockout = 0.6, -- re-blocking within this time gets no parry window

	RushDistance = 10,
	RushTime = 0.25,
	RushCooldown = 4,
	RushKB = 8, -- fixed; never scales
	RushRecoil = 0.3,
	RushHitRadius = 3.6,

	JuggleWindow = 2,
	JuggleFactor = 0.8,
	JuggleMin = 0.5,

	KOCreditWindow = 6,
	BodyRadius = 1.6,
	MaxVerticalReach = 7,

	-- Launch physics: KB = horizontal studs travelled while airborne
	LaunchBaseVy = 24,
	LaunchVyPerKB = 0.6,
	StunPadding = 0.2,
}

------------------------------------------------------------------------
-- REWARDS (v3 doc §15)
------------------------------------------------------------------------
Config.Rewards = {
	SurvivalCoinEvery = 10,
	SurvivalCoinMax = 18,
	Placement = { 60, 30, 15 },
	BotHeavyMultiplier = 0.67, -- placement coins when 1–3 humans
	BotHeavyMaxHumans = 3,
	TimeoutSurvivor = 30,
	HumanKO = 5,
	HumanKOMax = 25,
	BotKO = 2,
	BotKOMax = 10,
	RoundCap = 120,
	FirstWinOfDay = 100,
	LeaderboardWinMinHumans = 4,

	XP = {
		Participation = 25,
		PerSecondAlive = 1,
		PerSecondMax = 180,
		HumanKO = 20,
		BotKO = 10,
		Assist = 10,
		Placement = { 150, 100, 60, 30, 30, 30 },
	},

	Score = {
		PerSecond = 1,
		HumanKO = 100,
		BotKO = 40,
		Assist = 30,
		Win = 150,
		TimeoutSurvivor = 50,
	},
}

function Config.XPForLevel(level: number): number
	return 400 + 120 * (level - 1)
end
Config.MaxLevel = 100
-- v0.9.13 economy pass (tools/economy_sim.py): a new player opened ~1 spin on day 1 and ~9 in week 1.
-- Now: a spin at L2 and L3 (first-session hook) and every 5 levels (was 10) → ~5 on day 1, ~21 in week 1.
Config.MilestoneSpinEvery = 5
Config.EarlySpinLevels = { 2, 3 }

------------------------------------------------------------------------
-- SPINS (v3 doc §16). v0.9.1: the Boot IS in the Common pool, because Boot copies are how it levels up.
------------------------------------------------------------------------
Config.Spins = {
	Odds = { Common = 55, Uncommon = 26, Rare = 12, Epic = 5, Legendary = 1.6, Mythic = 0.4 },
	-- Pity: guaranteed tier-or-better after this many spins without one (counters always visible)
	Pity = { Epic = 20, Legendary = 60, Mythic = 200 },
	-- v0.9.23 COIN SPIN: no free spin and no weekly cap any more. One coin spin per hour (real time,
	-- also while offline, no stacking; the next hour starts when you use it). Coins are the real limit:
	-- a normal player earns ~800 coins a day, so it's ~1 coin spin a day; grinders get more.
	CoinSpinCost = 1000, -- v0.9.23: was 1500 ×3 a week (economy_sim: week 1 ≈ 29 spins, month ≈ 76)
	CoinSpinEvery = 3600,
	CoinSpinFastEvery = 1800, -- with the FAST COIN SPINS game pass
	MaxBatch = 10, -- "spin all" opens at most this many spins at once
	SkipsPerDay = 3, -- SKIP TIMER (Robux) can make the coin spin ready at most 3 times a day
}

------------------------------------------------------------------------
-- MERGE / FORGE (v3 doc §11)
------------------------------------------------------------------------
Config.Merge = {
	-- copies needed for each step L1→2 … L9→10
	Copies = {
		Common = { 1, 1, 1, 2, 2, 2, 3, 3, 4 }, -- 19
		Uncommon = { 1, 1, 1, 2, 2, 2, 3, 3, 4 }, -- 19
		Rare = { 1, 1, 2, 2, 2, 2, 3, 3, 4 }, -- 20
		Epic = { 1, 1, 1, 1, 2, 2, 2, 2, 2 }, -- 14
		Legendary = { 1, 1, 1, 1, 1, 1, 2, 2, 2 }, -- 12
		Mythic = { 1, 1, 1, 1, 1, 1, 1, 1, 1 }, -- 9
	},
	Coins = { 100, 200, 400, 700, 1000, 1500, 2000, 3000, 4000 }, -- 12,900 total
	-- v0.9.1: no more coin-only Boot Training: EVERY weapon (Boot included) levels only by merging
	-- duplicates of a weapon that is already L10 convert to coins
	MaxedRefund = { Common = 40, Uncommon = 100, Rare = 260, Epic = 700, Legendary = 1800, Mythic = 5000 },
	SameRarityRate = 2, -- 2 copies → 1 wildcard of the same rarity
	UpTierRate = 3, -- 3 copies → 1 wildcard of the NEXT rarity
}

-- Starter quests (v3 doc §6). One-time, in order shown.
Config.StarterQuests = {
	{ Id = "Survive60", Text = "Survive 60 seconds in a round", Coins = 200 },
	{ Id = "KO1", Text = "Knock 1 rival off", Coins = 150 },
	{ Id = "Top3", Text = "Finish in the top 3", Spins = 1 },
}

Config.Range = {
	DummyCount = 4, -- v0.7.4: bigger paddock, 4 lanes
	ResetDelay = 2.2, -- seconds before a dummy glides back to its post
}

------------------------------------------------------------------------
-- BOTS (League Drones)
------------------------------------------------------------------------
Config.Bots = {
	-- v0.7.3: the "Toy Brawler" roster (looks in BotStyles; nameplate colour = signature glow)
	Names = {
		"BLITZ", "NOVA", "TURBO", "VOLT", "JINX", "ZEPHYR",
		"KABOOM", "GLITCH", "TITAN", "MOCHI", "RAPTOR",
	},
	-- signature glow colours (match BotStyles; no pastels, no amber/red/gold — those are reserved
	-- for cracking tiles and winners)
	Colors = {
		Color3.fromRGB(170, 240, 0), Color3.fromRGB(200, 150, 255), Color3.fromRGB(0, 229, 255),
		Color3.fromRGB(0, 240, 200), Color3.fromRGB(255, 90, 210), Color3.fromRGB(140, 210, 255),
		Color3.fromRGB(120, 255, 120), Color3.fromRGB(0, 255, 240), Color3.fromRGB(230, 230, 255),
		Color3.fromRGB(255, 120, 190), Color3.fromRGB(100, 255, 160),
	},
	ThinkInterval = 0.35,
	TargetRange = 80, -- v0.8.3: was 26 (≈3 tiles) — far bots never found anyone and idled
	SearchTries = 14,
	PatchSize = 9, -- tiles (8-stud)
	BootWeight = 0.3,
	MaxHighRarityBots = 1, -- Legendary/Mythic
	MaxEpicBots = 2,

	-- v0.8 solo-lobby tuning (target: bots win 10–30% of matches with 1–3 humans)
	SoloHumans = 3, -- "small lobby" = this many humans or fewer
	SoloMaxPerHuman = 2, -- v0.9.12: two bots may hunt the same human (was 1)
	SoloHumanAggression = 0.9, -- v1.0.1: Easy/Medium bots swing at humans 10% less often in small lobbies (Hard/Pro: full)
	-- v0.9.12 HUMAN FOCUS: when picking a target, a real player counts as this × their distance
	-- (0.5 = a player 40 studs away is as tempting as a bot 20 studs away)
	HumanFocus = 0.5,
	HumanBreather = 0.7, -- s of breathing room after a human was hit (was 0.5)
	-- (AdaptStep / AdaptRecover: lobby-wide shift, unused since v1.0.1, replaced by per-player form)
	AdaptStep = 1, -- each bot win in a small lobby lowers the next lobby's tier by one (min Easy) …
	AdaptRecover = 2, -- … and it takes this many human wins in a row to step back up
	-- v1.0.1 PER-PLAYER SKILL (replaces the lobby-wide shift): each player's tier comes from their
	-- stats, then a session "form" moves it: a win = +1, losing to a bot = −1 (range −2..+2)
	SkillMinRounds = 3, -- fewer rounds than this = brand new = Easy (+ form)
	FormMin = -2,
	FormMax = 2,
	PreyFocus = 0.6, -- a bot treats its own player as this × the real distance (= hunts them first)
	MismatchAvoid = 1.8, -- a bot 2+ tiers above another player treats them as this × further (no bullying beginners)
	MaxHighRarityPro = 3,

	-- Lobby average account level -> difficulty tier
	MediumFromLevel = 10,
	HardFromLevel = 35,

	-- v1.0.1 HARDER + PER-PLAYER: every tier is tougher, and the bots in a match are split between the
	-- real players: each one hunts "their" player at THAT player's skill (see SkillTier below).
	-- Breather = s a human gets after being hit before this bot swings at them again.
	Difficulty = {
		Easy = {
			Reaction = 0.45, Aggression = 0.35, Block = 0.15, Parry = 0.0, Rush = 0.10, Breather = 0.8,
			Lookahead = 1, MaxPerTarget = 1, -- margin = Lookahead − 1 healthy tiles around goals
			Pool = { "Boot", "Gloves", "BigBoot", "Slingshot", "Bat" },
		},
		Medium = {
			Reaction = 0.28, Aggression = 0.60, Block = 0.35, Parry = 0.15, Rush = 0.30, Breather = 0.6,
			Lookahead = 1, MaxPerTarget = 2,
			Pool = { "Boot", "Gloves", "BigBoot", "Slingshot", "Bat", "Pan", "Hammer" }, -- v0.9.20: Magnet is Mythic now
		},
		Hard = {
			Reaction = 0.16, Aggression = 0.85, Block = 0.55, Parry = 0.35, Rush = 0.50, Breather = 0.45,
			Lookahead = 2, MaxPerTarget = 2,
			Pool = { "Boot", "Gloves", "BigBoot", "Slingshot", "Bat", "Pan", "Hammer", "BombBag", "Magnet", "VoidHook" },
		},
		-- v1.0.1 NEW top tier for strong players: near-instant reactions, blocks/parries a lot, rushes,
		-- best weapons (up to MaxHighRarityPro Legendary/Mythic bots), weapon level at or above yours
		Pro = {
			Reaction = 0.10, Aggression = 0.95, Block = 0.70, Parry = 0.50, Rush = 0.60, Breather = 0.3,
			Lookahead = 2, MaxPerTarget = 3, LevelBonus = 1,
			Pool = { "Boot", "Gloves", "BigBoot", "Slingshot", "Bat", "Pan", "Hammer", "BombBag", "Magnet", "VoidHook" },
		},
	},
}

------------------------------------------------------------------------
-- THE FOREMAN (announcer text lines; voice comes later)
------------------------------------------------------------------------
-- v0.8 THE FOREMAN: the show's host. Every line is subtitled in the banner (with a "THE FOREMAN"
-- tag) and "spoken" as robot babble (V cycles the voice volume 100% → 50% → off).
Config.Announcer = {
	-- v0.9.12 quieter Foreman: fewer, shorter lines (KO / parry / geyser / slam / freeze banners are
	-- gone; the HUD drops a minor line if another one showed in the last few seconds)
	Start = { "CRUMBLE!", "BEGIN!", "SHOVE OR BE SHOVED!", "LET'S BREAK STUFF!" },
	MapIntro = {
		Grid = { "CLASSIC! JUST SHOVES!", "CLASSIC ARENA!" },
		Molten = { "MOLTEN! RUSH OUT OF MAGMA!", "MOLTEN! MIND THE LAVA!" },
		Ice = { "ICE RINK! NO BRAKES!", "ICE! MIND THE FROST!" },
	},
	ModeIntro = {
		Rumble = { "RUMBLE! RANDOM WEAPONS!", "RUMBLE TIME!" },
	},
	KO = { "TILE DOWN!", "BYE BYE!", "INTO THE VOID!" },
	Parry = { "PARRY!", "DENIED!" },
	Phase = {
		Crumble = "CRACKING!",
		Break = "HOLES!",
		Collapse = "ISLANDS!",
		["Sudden Death"] = "SUDDEN DEATH!",
	},
	Shrink = "EDGE FALLING! MOVE IN!",
	Boxes = "WEAPON BOXES!", -- v0.9.17: once, at the first Rumble box
	FinalThree = "THREE LEFT!",
	Win = "LAST ONE STANDING!",
	WinLines = { "LAST ONE STANDING!", "WHAT A FINISH!", "CHAMPION!" },
	Timeout = "SURVIVORS!",
	BotsWin = "THE DRONES WIN!",
	Magma = { "MAGMA POOLS!", "THE FLOOR IS MELTING!" },
	Swallowed = { "%s SANK!", "MAGMA ATE %s!" },
	Freeze = { "%s IS FROZEN!", "HIT %s!" },
	Traps = { "FROST TRAPS OUT!", "WATCH YOUR STEP!" },
	VoteResult = { "VOTED: %s!", "NEXT: %s!" },
	VoteRandom = { "I PICK: %s!", "FOREMAN PICKS: %s!" },
	Geyser = { "GEYSER!", "WHOOSH!" },
	Drop = { "HEADS UP!", "CRANE DROP!" },
	Slam = { "SPLAT!", "OOPS!" },
	Eruption = { "ERUPTION!", "THE CORE BLOWS!" },
	Gust = { "WIND FROM THE %s!", "GUST: %s!" },
}

-- v0.8 MAPS: one pooled grid, re-skinned per round. Classic (id "Grid", no hazards) · Molten · Ice.
-- Amber/red stay reserved for cracking tiles; gold for winners.
Config.Maps = {
	Order = { "Grid", "Molten", "Ice" }, -- display order (the lobby vote picks the map)
	-- v0.8.2 MAP IDENTITY: every map has its own floor material, rim, surroundings, lighting mood
	-- and ONE signature hazard that changes how you play.
	Grid = {
		-- v0.9.5 CLASSIC: the normal map is the plain original arena: NO map hazards or modifiers
		-- (no crane drops, KBScale 1). It keeps the default cozy sky-stadium look; only the floor
		-- crumbling + shrinking ring apply. (id stays "Grid" so saved quest/stat keys keep working)
		Name = "CLASSIC", Tagline = "The original arena · no hazards",
		Classic = true, -- SetMap uses the default arena look (no re-skin, no themed props)
		ColorA = Color3.fromRGB(214, 210, 200), ColorB = Color3.fromRGB(190, 186, 176), Core = Color3.fromRGB(150, 160, 178),
		Sea = Color3.fromRGB(236, 240, 255), SeaGlow = false, KBScale = 1,
	},
	Molten = {
		Name = "MOLTEN CORE", Tagline = "Sinking magma · geysers · eruption",
		-- v0.8.3: real lava colours — charcoal basalt, orange/yellow lava (v0.8.2's pink is gone)
		-- v0.9.12: lighter ash basalt (was 70/54) so the near-black drop under a hole stands out
		ColorA = Color3.fromRGB(112, 98, 90), ColorB = Color3.fromRGB(92, 80, 74), Core = Color3.fromRGB(132, 106, 90),
		HoleEdge = Color3.fromRGB(255, 120, 24), -- glowing outline around every hole
		TileMaterial = Enum.Material.Basalt, CoreMaterial = Enum.Material.Slate,
		Sea = Color3.fromRGB(255, 90, 10), SeaGlow = true, KBScale = 1,
		Rim = Color3.fromRGB(44, 38, 36), RimBand = Color3.fromRGB(110, 36, 10), RimGlow = Color3.fromRGB(255, 120, 20), RimMaterial = Enum.Material.Basalt,
		RockTint = Color3.fromRGB(64, 56, 52),
		DecorGrass = Color3.fromRGB(72, 62, 58), -- scorched ash where the stadium grass was
		Rock = Color3.fromRGB(56, 50, 48), RockLight = Color3.fromRGB(82, 72, 66), Glow = Color3.fromRGB(255, 110, 20),
		Lava = Color3.fromRGB(255, 96, 12), LavaHot = Color3.fromRGB(255, 186, 50), LavaDeep = Color3.fromRGB(214, 44, 6), Crust = Color3.fromRGB(46, 34, 30),
		-- geysers: a tile bubbles (Warn s), then launches everyone within Radius straight up
		Geysers = { FirstAt = 18, Every = 10, Count = 2, CountLate = 3, MoreAfter = 70, Warn = 1.4, Radius = 6, LaunchVy = 86, Drift = 15, Stun = 1.0, NearPlayers = 0.6 },
		-- MAGMA POOLS: a tile crusts (Warn s), then turns semi-solid for Life s. Standing in it sinks
		-- you SinkRate studs/s (it rises back when empty); walk ×SlowMul, no jumping. At MaxDepth the
		-- pool swallows the tile. RUSH out: a rush from magma pops you up RushPop.
		-- v0.8.2: pools SPREAD once to a neighbour after SpreadAfter s (up to MaxPools on the floor).
		Magma = {
			FirstAt = 12, Every = 7, Count = 3, CountLate = 4, MoreAfter = 60, Warn = 1.3, Life = 14,
			SinkRate = 1.5, RiseRate = 0.7, MaxDepth = 4.2, SlowMul = 0.3, RushPop = 46, NearPlayers = 0.6,
			SpreadAfter = 5, MaxPools = 14,
			Crust = Color3.fromRGB(120, 34, 8), Hot = Color3.fromRGB(255, 110, 18),
		},
		-- ERUPTION: once per match the core blows: a ring of geysers all over the floor at once
		Eruption = { At = 95, Geysers = 7 },
	},
	Ice = {
		Name = "ICE RINK", Tagline = "Skating · frost traps · blizzards",
		ColorA = Color3.fromRGB(226, 244, 255), ColorB = Color3.fromRGB(190, 222, 248), Core = Color3.fromRGB(110, 176, 232),
		HoleEdge = Color3.fromRGB(40, 120, 220), -- v0.9.12 deep-blue outline around every hole
		TileMaterial = Enum.Material.Ice, CoreMaterial = Enum.Material.Glacier,
		Sea = Color3.fromRGB(214, 240, 255), SeaGlow = false, Reflectance = 0.18,
		Rim = Color3.fromRGB(206, 230, 248), RimBand = Color3.fromRGB(140, 186, 228), RimGlow = Color3.fromRGB(150, 232, 255), RimMaterial = Enum.Material.Ice,
		RockTint = Color3.fromRGB(176, 212, 240),
		DecorGrass = Color3.fromRGB(236, 244, 252), -- snow-covered
		KBScale = 1.2, -- launches carry 20% farther on ice
		FrostDelay = 0.4, -- random-hole warnings appear 0.4 s late (the tile still drops on time)
		-- v0.8.5 FAST ICE: you skate 45% faster than you run, push off hard (Push studs/s² toward
		-- where you steer, so turning drifts), and glide for ages when you let go (Glide = friction).
		-- v0.9.17 playtest "too slippery": about half the slide (Glide = how fast the glide dies:
		-- 0.35 → 0.75), turns grip harder (Push 46 → 72) and skating is 25% faster, not 45%
		Skate = { SpeedMul = 1.25, Push = 72, Glide = 0.75, BotPush = 80 },
		-- FROST TRAPS: frosted tiles; step on one = frozen in an ice block for FreezeTime (no moving,
		-- attacking, blocking or rushing). A hit shatters the ice early.
		Traps = { FirstAt = 10, Every = 6, Count = 3, CountLate = 4, MoreAfter = 60, MaxActive = 7, Life = 18, FreezeTime = 2.0, NearPlayers = 0.45, Tint = 0.55 },
		-- BLIZZARD GUSTS: warning (Warn s, the Foreman calls the direction), then a wind pushes every
		-- skater Speed studs/s that way for Duration s. Steer against it or ride it.
		Gusts = { FirstAt = 26, Every = 21, Warn = 2.5, Duration = 4.5, Speed = 12 },
		Snow = Color3.fromRGB(246, 250, 255), Rock = Color3.fromRGB(170, 210, 240), RockDark = Color3.fromRGB(128, 176, 222), Crystal = Color3.fromRGB(150, 232, 255),
	},
}

-- v0.8.1 MODES. Both are chosen by the lobby vote (no automatic rotation).
-- RUMBLE is its own party mode: everyone gets a random weapon for the round (never unlocked).
Config.Modes = {
	Order = { "Classic", "Rumble" },
	Classic = { Name = "CLASSIC", CollapseScale = 1, RandomWeapon = false, Blurb = "Your own weapon" },
	Rumble = { Name = "RUMBLE", CollapseScale = 1.3, RandomWeapon = true, WeaponLevel = 5, HazardScale = 1.5, Blurb = "Random weapons · weapon boxes",
		-- v0.9.17 WEAPON BOXES (Rumble only): a box drops onto a healthy tile near the middle every
		-- Interval s (first at First s, at most Max on the floor). Walk into it = a new random weapon at
		-- WeaponLevel until the round ends (never kept). Boxes vanish after Life s or when their tile goes.
		Boxes = { First = 6, Interval = 10, Max = 3, Life = 22, Fall = 1.2, GrabRadius = 3.8 } },
}

-- v0.8.1 MAP VOTE: everyone in the lobby votes during the join window. Majority wins;
-- ties and no-votes are settled at random (mode: no votes = Classic).
Config.Vote = {
	Maps = { "Grid", "Molten", "Ice" },
	Modes = { "Classic", "Rumble" },
	NoRepeat = false, -- if true, the last map can't win twice in a row (off for now)
}

------------------------------------------------------------------------
-- v0.9 RETENTION (doc §06 FTUE, §15–16): daily quests, weekly chain, Season 1 track,
-- leaderboards, the shop (developer products) and the first-time tutorial.
------------------------------------------------------------------------
-- Stats a quest can count (filled from every round result, see Retention.StatsFromResult):
--   Rounds · AnyKOs (bots count) · HumanKOs · Seconds (alive) · Top3 · Wins · Assists ·
--   MapGrid / MapMolten / MapIce · ModeRumble
Config.Retention = {
	DailyCount = 3, -- 3 dailies a day (UTC), picked per player; coins are paid outside the round cap
	DailyAllSpins = 1, -- v0.9.13: +1 spin for finishing all of today's dailies
	Daily = {
		{ Id = "Play3", Text = "Play 3 matches", Stat = "Rounds", Goal = 3, Coins = 80 },
		{ Id = "KO5", Text = "Knock off 5 rivals (bots count)", Stat = "AnyKOs", Goal = 5, Coins = 100 },
		{ Id = "Survive300", Text = "Survive 5 minutes in total", Stat = "Seconds", Goal = 300, Coins = 90 },
		{ Id = "Top3x2", Text = "Finish top 3 twice", Stat = "Top3", Goal = 2, Coins = 120 },
		{ Id = "Win1", Text = "Win a match", Stat = "Wins", Goal = 1, Coins = 150 },
		{ Id = "Assist3", Text = "Get 3 assists", Stat = "Assists", Goal = 3, Coins = 90 },
		{ Id = "Molten1", Text = "Play a match on Molten Core", Stat = "MapMolten", Goal = 1, Coins = 70 },
		{ Id = "Ice1", Text = "Play a match on the Ice Rink", Stat = "MapIce", Goal = 1, Coins = 70 },
		{ Id = "Grid1", Text = "Play a match on the Classic map", Stat = "MapGrid", Goal = 1, Coins = 70 },
		{ Id = "Rumble1", Text = "Play a RUMBLE match", Stat = "ModeRumble", Goal = 1, Coins = 90 },
		{ Id = "PlayerKO1", Text = "Knock off a real player", Stat = "HumanKOs", Goal = 1, Coins = 120 },
	},
	-- the weekly chain: 5 steps in order (Monday reset, UTC); the last step pays a SPIN
	Weekly = {
		{ Text = "Play 5 matches", Stat = "Rounds", Goal = 5, Coins = 150 },
		{ Text = "Knock off 10 rivals", Stat = "AnyKOs", Goal = 10, Coins = 200 },
		{ Text = "Finish top 3 three times", Stat = "Top3", Goal = 3, Coins = 250 },
		{ Text = "Survive 15 minutes in total", Stat = "Seconds", Goal = 900, Coins = 300 },
		{ Text = "Win 2 matches", Stat = "Wins", Goal = 2, Spins = 1 },
	},
}

-- SEASON 1 · GROUND ZERO (24 Oct – 18 Dec 2026, starts on launch day). Season XP = the XP you earn in matches.
-- Before StartsAt the track runs as a PREVIEW (key "S1P"); at StartsAt everyone resets to "S1" automatically.
-- After EndsAt no more Season XP is added (rewards you reached can still be claimed).
Config.Season = {
	-- v1.0: the Id switches by itself: "S1P" (preview) before StartsAt, "S1" from StartsAt on, so the
	-- preview progress really resets when Season 1 starts (it used to need a manual Id change).
	Id = "S1",
	PreviewId = "S1P",
	Name = "SEASON 1 · GROUND ZERO",
	StartsAt = 1792800000, -- Sat 24 Oct 2026 00:00 UTC (launch day; was 9 Jan 2027)
	EndsAt = 1797638400, -- Sat 19 Dec 2026 00:00 UTC (8 weeks; Season 2 starts here)
	TierXP = 600, -- ≈ 3 matches a tier, ≈ 90 matches for all 30 over 8 weeks
	-- free track: coins, wildcards and 4 spins (doc §16: "season track +4")
	Free = {
		{ Coins = 100 }, { Coins = 110 }, { Coins = 120 }, { Coins = 130 }, { Wild = "Common", Count = 2 },
		{ Coins = 150 }, { Coins = 160 }, { Spins = 1 }, { Coins = 180 }, { Wild = "Uncommon", Count = 2 },
		{ Coins = 200 }, { Coins = 210 }, { Coins = 220 }, { Coins = 230 }, { Wild = "Rare", Count = 1 },
		{ Spins = 1 }, { Coins = 260 }, { Coins = 270 }, { Coins = 280 }, { Wild = "Rare", Count = 2 },
		{ Coins = 300 }, { Coins = 320 }, { Coins = 340 }, { Spins = 1 }, { Wild = "Epic", Count = 1 },
		{ Coins = 380 }, { Coins = 400 }, { Coins = 450 }, { Coins = 500 }, { Spins = 1 },
	},
	-- The premium Season Pass is a concept only (design doc §19, planned for v1.2); it is not in the game.
}

-- which season key counts right now (preview before the start date)
function Config.SeasonIdAt(unix: number): string
	return if unix < Config.Season.StartsAt then Config.Season.PreviewId else Config.Season.Id
end

Config.Leaderboards = {
	Refresh = 90, -- seconds between fetches of the global top lists
	Top = 10,
	PostEvery = 120, -- a player's scores are posted at most this often (and when they leave)
	Boards = {
		{ Key = "Wins", Title = "TOP WINNERS", Sub = "wins in lobbies with 4+ players", Stat = "LeaderboardWins", Color = Color3.fromRGB(240, 166, 20) },
		{ Key = "KOs", Title = "TOP SHOVERS", Sub = "players knocked off (bots don't count)", Stat = "KOs", Color = Color3.fromRGB(255, 104, 46) },
		{ Key = "Level", Title = "TOP LEVELS", Sub = "account level", Stat = "Level", Color = Color3.fromRGB(56, 140, 255) },
	},
}

-- SHOP (developer products, doc §16). Put your real product ids in Id once they exist on the
-- Creator Dashboard. Id = 0 → "not on sale" (in DevMode the button SIMULATES the purchase so the
-- whole grant path can be tested without Robux). Random = true → a paid random item: hidden for
-- players whose PolicyService says paid random items are restricted.
Config.Shop = {
	Enabled = true, -- local kill switch (there is also a remote one: DataStore "CrumbleFlags"/"Shop")
	BoostCap = 240, -- the round coin cap while 2x Coins is active
	Products = {
		{ Key = "Spin1", Id = 3721876276, Name = "1 SPIN", Price = 49, Spins = 1, Random = true, Icon = "spin" },
		{ Key = "Spin5", Id = 3721876454, Name = "5 SPINS", Price = 199, Spins = 5, Random = true, Icon = "spin" },
		{ Key = "Spin12", Id = 3721876610, Name = "12 SPINS", Price = 449, Spins = 12, Random = true, Icon = "spin", Tag = "BEST VALUE" },
		{ Key = "Coins500", Id = 3721877347, Name = "500 COINS", Price = 25, Coins = 500, Icon = "coin", FeedsSpins = true },
		{ Key = "Coins2500", Id = 3721877577, Name = "2,500 COINS", Price = 99, Coins = 2500, Icon = "coins", FeedsSpins = true },
		{ Key = "Boost2x", Id = 3721877938, Name = "2x COINS · 30 MIN", Price = 49, BoostMinutes = 30, Icon = "bolt", Tag = "2x CAP TOO", FeedsSpins = true },
		-- v0.9.23: makes the hourly COIN SPIN ready now (only while it's counting down, 3 a day; the
		-- spin still costs coins). It leads to a random spin, so it's treated as a paid random item.
		{ Key = "SkipTimer", Id = 3721878204, Name = "SKIP TIMER", Price = 25, SkipTimer = true, Random = true, Icon = "spin", Tag = "COIN SPIN NOW" },
	},
	-- v1.0 FeedsSpins = true: coins / coin boosts / faster coin spins can be spent on the (random)
	-- COIN SPIN, so Roblox counts them as paid random items too: they're hidden / blocked for
	-- players whose PolicyService says ArePaidRandomItemsRestricted (same as Random = true).
	-- v0.9.22 GAME PASSES (one-time, forever). Put the real pass ids from the Creator Dashboard
	-- (Monetization → Passes) in Id. Id = 0 → "not on sale" (DevMode simulates, saved per profile).
	-- Convenience and coins only: no pass makes a weapon hit harder.
	Passes = {
		{ Key = "AutoMerge", Id = 2053541441, Name = "AUTO MERGE", Price = 199, Icon = "hammer", Tag = "MERGE EVERYTHING" },
		{ Key = "FastSpins", Id = 2052833405, Name = "FAST COIN SPINS", Price = 149, Icon = "spin", Tag = "EVERY 30 MIN", FeedsSpins = true },
		{ Key = "Coins2x", Id = 2052839434, Name = "2x COINS FOREVER", Price = 299, Icon = "coins", Tag = "STACKS WITH BOOST", FeedsSpins = true },
		{ Key = "VIP", Id = 2054021437, Name = "VIP", Price = 149, Icon = "crown", Tag = "GOLD TAG" },
	},
}

-- FIRST-TIME TUTORIAL (doc §06 "Hooked before the first spin")
-- v1.0 SOCIAL: the FREE SPIN button under Help Tips opens Roblox's "favorite this game" pop-up;
-- answering YES pays FavoriteSpins once per player (the button then disappears for good).
-- No reward for likes: Roblox can't detect them and its rules don't allow rewards for a thumbs-up.
Config.Social = {
	FavoriteSpins = 1,
}

-- v1.0 patch AFK MODE: tap AFK in the lobby (Yard). You sit out matches and every 2 minutes roll ONE
-- reward. About 1.5 spins and 4.5 wildcards an hour, so the hourly coin spin and the shop still matter.
Config.Afk = {
	Interval = 120, -- seconds between rewards
	Odds = { Coins = 0.80, Wildcard = 0.15, Spin = 0.05 },
	Coins = { 15, 25 }, -- min, max
	-- wildcard rarity (low rarities only: AFK can't hand out Legendary / Mythic copies)
	WildOdds = { { "Common", 0.55 }, { "Uncommon", 0.30 }, { "Rare", 0.12 }, { "Epic", 0.03 } },
	-- v1.0 patch 4: Roblox disconnects anyone idle for 20 min and games may NOT fake input to stop it.
	-- So at 18 idle minutes an AFK player is saved and moved to a fresh CRUMBLE server, AFK still on.
	RejoinAfter = 18 * 60, -- idle seconds
}

Config.Tutorial = {
	BasicsCoins = 150, -- paid when the Range basics are done …
	BasicsBootCopies = 1, -- … plus 1 Boot copy, so the first MERGE (L1 → L2: 1 copy + 100 coins) is ready
	ParryWindow = 0.30, -- the sparring bot is a little kinder than a real fight (0.18 s)
	Done = 100,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Descriptions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — Descriptions (v0.9.17)
	One place for every player-facing description: weapons, rarities, maps, modes, moves, shop
	products, lobby stations and the Rumble weapon box. Short and punchy (Toy Box style): a 2–3 word
	TAG for tight spots (lobby plates, the equipped pill), one DESC sentence, and a TIP.
]]

local Weapons = require(script.Parent:WaitForChild("Weapons"))

export type WeaponText = { Tag: string, Desc: string, Tip: string }

local Descriptions = {}

Descriptions.Weapons = {
	Boot = { Tag = "QUICK KICK", Desc = "A fast, honest kick. The free weapon everyone starts with.", Tip = "Kick them off the edge the moment they get close." },
	Gloves = { Tag = "3-HIT COMBO", Desc = "Fast jabs. The 3rd jab within 1.5 s hits much harder.", Tip = "Jab, jab, BOOM. Keep the chain going." },
	BigBoot = { Tag = "LAUNCHER", Desc = "A slow stomp-kick that pops rivals high into the air.", Tip = "Launch them over holes: bad landings do the rest." },
	Slingshot = { Tag = "LONG RANGE", Desc = "Fires a pellet up to 40 studs away.", Tip = "Aim where they're going, not where they are." },
	Bat = { Tag = "HITS 3", Desc = "A wide swing that hits up to 3 rivals and knocks shots away.", Tip = "Swing into crowds and at incoming pellets." },
	Pan = { Tag = "360° SPIN", Desc = "Spin and smack everyone around you at once.", Tip = "Save it for when you get surrounded." },
	Hammer = { Tag = "GROUND SMASH", Desc = "Smash the floor in front: pops everyone there and cracks the tile.", Tip = "Smash where they stand, then watch the tile drop." },
	BombBag = { Tag = "AREA BLAST", Desc = "Lob a bomb that blasts everyone nearby and breaks cracked tiles.", Tip = "Throw it where they're about to stand." },
	Magnet = { Tag = "PUSH + PULL", Desc = "Click: pull a rival in. Click again within 2 s: BLAST them away.", Tip = "Pull them close, then face the edge and REPEL." },
	VoidHook = { Tag = "YANK + SLAM", Desc = "Hooks a rival, reels them in, then slams them away.", Tip = "The strongest hit in the game. Block or parry the windup!" },
} :: { [string]: WeaponText }

function Descriptions.Weapon(id: string?): WeaponText
	local def = Weapons.Get(id)
	return Descriptions.Weapons[def.Id] or { Tag = "", Desc = def.Blurb, Tip = "" }
end

-- "Reach 6.5 · Windup 0.12 s · Cooldown 2.4 s"
function Descriptions.Stats(id: string?): string
	local def = Weapons.Get(id)
	local reach = def.Kind == "aoe" and string.format("Radius %g", def.Range)
		or def.Kind == "slam" and string.format("Smash %g ahead", (def.SlamOffset or 4.5) + (def.SlamRadius or 4.5))
		or string.format("Reach %g", def.Range)
	return string.format("%s  ·  Windup %gs  ·  Cooldown %gs", reach, def.Windup, def.Cooldown)
end

Descriptions.Rarities = {
	Common = "Base knockback (x1.00).",
	Uncommon = "Hits 12% harder (x1.12).",
	Rare = "Hits 25% harder (x1.25).",
	Epic = "Hits 40% harder (x1.40).",
	Legendary = "Hits 50% harder (x1.50).",
	Mythic = "Hits 60% harder (x1.60). Still blockable.",
} :: { [string]: string }

-- one line for small spaces (Spin Vault notes)
Descriptions.RarityLine = "Rarer hits harder: U +12% · R +25% · E +40% · L +50% · M +60%."

-- shown in the hint pill during the countdown (short: one line)
Descriptions.Maps = {
	Grid = "No hazards. Shove them off!",
	Molten = "Magma pulls you down: RUSH out! Mind the geysers.",
	Ice = "You skate fast and slide. Frosty tiles freeze you.",
} :: { [string]: string }

Descriptions.Modes = {
	Classic = "Your own weapon and level.",
	Rumble = "Random weapons! Grab WEAPON BOXES for a new one.",
} :: { [string]: string }

Descriptions.Moves = {
	SHOVE = "Attack with your weapon in the way you face.",
	RUSH = "Dash forward. Escapes magma and dodges hits.",
	GUARD = "Hold BLOCK to stop 90% of a hit. Block right before it lands to PARRY.",
} :: { [string]: string }

Descriptions.Shop = {
	Spin1 = "1 spin on the weapon wheel. Pity counts.",
	Spin5 = "5 spins on the weapon wheel. Pity counts.",
	Spin12 = "12 spins: the cheapest per spin.",
	Coins500 = "500 coins for Forge merges and coin spins.",
	Coins2500 = "2,500 coins for Forge merges and coin spins.",
	Boost2x = "Double round coins for 30 min (the coin cap doubles too).",
	SkipTimer = "Your COIN SPIN is ready right now (it still costs coins). Up to 3 times a day.",
	-- v0.9.22 game passes (one-time, forever)
	AutoMerge = "A MERGE EVERYTHING button in the Forge, and new copies merge by themselves after spins (switch it off any time).",
	FastSpins = "Your coin spin is ready every 30 minutes instead of every hour.",
	Coins2x = "Double round coins and the coin cap, forever. With a 30-min boost it's 3x.",
	VIP = "A gold VIP tag over your head and in chat.",
} :: { [string]: string }

-- lobby station plates (second line)
Descriptions.Stations = {
	Vault = "win new weapons",
	Shop = "passes · spins · coins",
	Forge = "merge copies · level up",
	Range = "test your hits",
	Armory = "every weapon on show",
} :: { [string]: string }

Descriptions.Box = {
	Name = "WEAPON BOX",
	Desc = "Walk into it for a random new weapon (this round only).",
}

return Descriptions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Icons</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Icons (v0.9.15; moved out of UI.luau so lobby signs can use them too)
	Drawn icons built from rounded Frames in scale coordinates (no emoji, no image assets).
	Icons.make(name, props?, color?) -> Frame
]]
local Icons = {}
local INK = Color3.fromRGB(30, 26, 40)
Icons.Ink = INK
------------------------------------------------------------------------
-- v0.9.14 DRAWN ICONS (replace every emoji). Built from rounded Frames in scale coordinates so
-- they fit any square: UI.icon("coin", { Size = UDim2.fromOffset(32, 32), Parent = x }).
-- Names: coin coins spin bolt check lock swords hammer wrench scroll trophy gem crown gift
--        target arrow warn fire snow clock hardhat card vote chat
------------------------------------------------------------------------
local IC = {
	Gold = Color3.fromRGB(255, 196, 40),
	GoldD = Color3.fromRGB(222, 140, 20),
	GoldL = Color3.fromRGB(255, 232, 140),
	Red = Color3.fromRGB(232, 72, 64),
	RedD = Color3.fromRGB(176, 44, 44),
	Green = Color3.fromRGB(60, 196, 96),
	Teal = Color3.fromRGB(70, 210, 230),
	Steel = Color3.fromRGB(214, 220, 232),
	Wood = Color3.fromRGB(176, 112, 60),
	Cream = Color3.fromRGB(255, 248, 232),
	Ice = Color3.fromRGB(150, 220, 255),
	Orange = Color3.fromRGB(255, 120, 40),
	Purple = Color3.fromRGB(150, 90, 230),
	White = Color3.fromRGB(255, 255, 255),
}
Icons.Colors = IC

type Holder = { f: Frame, z: number }

local function shp(h: Holder, cx: number, cy: number, w: number, hh: number, color: Color3?, rot: number?, radius: number?, stroke: number?, strokeColor: Color3?): Frame
	h.z += 1
	local f = Instance.new("Frame")
	f.Name = "Ic"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(w, hh)
	f.Rotation = rot or 0
	f.BorderSizePixel = 0
	if color then
		f.BackgroundColor3 = color
	else
		f.BackgroundTransparency = 1
	end
	f.ZIndex = h.z
	f:SetAttribute("NoSkin", true)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(radius or 0.2, 0)
	c.Parent = f
	if stroke and stroke > 0 then
		local st = Instance.new("UIStroke")
		st.Thickness = stroke
		st.Color = strokeColor or INK
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st:SetAttribute("NoSkin", true)
		st.Parent = f
	end
	f.Parent = h.f
	return f
end

local function sub(h: Holder, cx: number, cy: number, sz: number): Holder
	local f = shp(h, cx, cy, sz, sz)
	return { f = f, z = h.z }
end

local O = 2 -- ink outline thickness (px)

local DRAW: { [string]: (h: Holder, c: Color3?) -> () } = {}
DRAW.coin = function(h, c)
	shp(h, 0.5, 0.5, 0.88, 0.88, c or IC.Gold, 0, 0.5, O)
	shp(h, 0.5, 0.5, 0.6, 0.6, IC.GoldD, 0, 0.5)
	shp(h, 0.5, 0.5, 0.14, 0.38, IC.GoldL, 0, 0.5)
end
DRAW.coins = function(h, c)
	DRAW.coin(sub(h, 0.36, 0.6, 0.7), c)
	h.z += 8
	DRAW.coin(sub(h, 0.62, 0.4, 0.7), c)
end
DRAW.spin = function(h, c)
	shp(h, 0.5, 0.16, 0.3, 0.16, IC.Gold, 0, 0.5, O)
	shp(h, 0.5, 0.56, 0.9, 0.72, c or IC.Red, 0, 0.18, O)
	shp(h, 0.5, 0.54, 0.7, 0.4, IC.Cream, 0, 0.12, O)
	for _, x in { 0.38, 0.62 } do
		shp(h, x, 0.54, 0.05, 0.4, INK, 0, 0)
	end
	for i, x in { 0.27, 0.5, 0.73 } do
		shp(h, x, 0.54, 0.12, 0.12, i == 2 and IC.Gold or IC.Red, 0, 0.5)
	end
end
DRAW.bolt = function(h, c)
	local col = c or IC.Gold
	shp(h, 0.5, 0.28, 0.17, 0.52, col, 24, 0.1, O)
	shp(h, 0.5, 0.72, 0.17, 0.52, col, 24, 0.1, O)
	shp(h, 0.5, 0.5, 0.34, 0.15, col, 0, 0.1, O)
	shp(h, 0.5, 0.28, 0.1, 0.46, col, 24, 0.1) -- hide the inner seams
	shp(h, 0.5, 0.72, 0.1, 0.46, col, 24, 0.1)
	shp(h, 0.5, 0.5, 0.3, 0.08, col, 0, 0.1)
end
DRAW.check = function(h, c)
	local col = c or IC.Green
	shp(h, 0.3, 0.62, 0.17, 0.4, col, -45, 0.5, O)
	shp(h, 0.6, 0.48, 0.17, 0.8, col, 38, 0.5, O)
end
DRAW.lock = function(h, c)
	shp(h, 0.5, 0.36, 0.5, 0.56, nil, 0, 0.5, 4, IC.Steel)
	shp(h, 0.5, 0.66, 0.8, 0.56, c or IC.Gold, 0, 0.2, O)
	shp(h, 0.5, 0.64, 0.13, 0.24, INK, 0, 0.5)
end
DRAW.swords = function(h, c)
	for _, sgn in { 1, -1 } do
		shp(h, 0.5, 0.48, 0.15, 0.86, c or IC.Steel, sgn * 45, 0.4, O)
		shp(h, 0.5 - sgn * 0.23, 0.71, 0.32, 0.11, IC.Gold, sgn * 45, 0.5, O)
		shp(h, 0.5 - sgn * 0.33, 0.83, 0.12, 0.18, IC.Wood, sgn * 45, 0.4, O)
	end
end
DRAW.hammer = function(h, c)
	shp(h, 0.42, 0.6, 0.15, 0.74, IC.Wood, 45, 0.4, O)
	shp(h, 0.66, 0.34, 0.6, 0.3, c or IC.Steel, 45, 0.2, O)
end
DRAW.wrench = function(h, c)
	shp(h, 0.66, 0.34, 0.4, 0.4, nil, 0, 0.5, 7, INK)
	shp(h, 0.4, 0.6, 0.16, 0.62, c or IC.Steel, 45, 0.5, O)
	shp(h, 0.66, 0.34, 0.4, 0.4, nil, 0, 0.5, 4, c or IC.Steel)
end
DRAW.scroll = function(h, c)
	shp(h, 0.5, 0.5, 0.64, 0.74, c or IC.Cream, 0, 0.08, O)
	shp(h, 0.5, 0.15, 0.84, 0.15, IC.Wood, 0, 0.5, O)
	shp(h, 0.5, 0.85, 0.84, 0.15, IC.Wood, 0, 0.5, O)
	for i, w in { 0.4, 0.4, 0.28 } do
		shp(h, 0.5 - (0.4 - w) / 2, 0.32 + i * 0.12, w, 0.06, INK, 0, 0.5)
	end
end
DRAW.trophy = function(h, c)
	local col = c or IC.Gold
	for _, x in { 0.2, 0.8 } do
		shp(h, x, 0.34, 0.24, 0.28, nil, 0, 0.5, 4, IC.GoldD)
	end
	shp(h, 0.5, 0.34, 0.6, 0.5, col, 0, 0.35, O)
	shp(h, 0.5, 0.68, 0.14, 0.2, IC.GoldD, 0, 0)
	shp(h, 0.5, 0.86, 0.58, 0.14, IC.GoldD, 0, 0.3, O)
	shp(h, 0.42, 0.28, 0.08, 0.22, IC.GoldL, 0, 0.5)
end
DRAW.gem = function(h, c)
	shp(h, 0.5, 0.52, 0.62, 0.62, c or IC.Teal, 45, 0.12, O)
	shp(h, 0.4, 0.42, 0.14, 0.14, IC.White, 45, 0.2)
end
DRAW.crown = function(h, c)
	local col = c or IC.Gold
	for _, x in { 0.2, 0.5, 0.8 } do
		shp(h, x, 0.38, 0.24, 0.24, col, 45, 0.12, O)
	end
	shp(h, 0.5, 0.66, 0.8, 0.38, col, 0, 0.12, O)
	shp(h, 0.5, 0.66, 0.15, 0.15, IC.Red, 0, 0.5)
	shp(h, 0.25, 0.66, 0.1, 0.1, IC.Teal, 0, 0.5)
	shp(h, 0.75, 0.66, 0.1, 0.1, IC.Teal, 0, 0.5)
end
DRAW.gift = function(h, c)
	for _, x in { 0.36, 0.64 } do
		shp(h, x, 0.18, 0.26, 0.2, nil, 0, 0.5, 4, IC.Gold)
	end
	shp(h, 0.5, 0.64, 0.74, 0.54, c or IC.Red, 0, 0.12, O)
	shp(h, 0.5, 0.36, 0.86, 0.18, IC.RedD, 0, 0.15, O)
	shp(h, 0.5, 0.58, 0.14, 0.64, IC.Gold, 0, 0)
end
DRAW.target = function(h, c)
	shp(h, 0.5, 0.5, 0.9, 0.9, c or IC.Red, 0, 0.5, O)
	shp(h, 0.5, 0.5, 0.62, 0.62, IC.White, 0, 0.5)
	shp(h, 0.5, 0.5, 0.34, 0.34, c or IC.Red, 0, 0.5)
end
DRAW.arrow = function(h, c) -- points right; rotate the holder for other directions
	local col = c or IC.White
	shp(h, 0.47, 0.5, 0.64, 0.2, col, 0, 0.5, O)
	shp(h, 0.76, 0.4, 0.46, 0.2, col, 45, 0.5, O)
	shp(h, 0.76, 0.6, 0.46, 0.2, col, -45, 0.5, O)
	shp(h, 0.47, 0.5, 0.6, 0.12, col, 0, 0.5) -- clean joint
end
DRAW.warn = function(h, c)
	shp(h, 0.5, 0.5, 0.66, 0.66, c or IC.Gold, 45, 0.14, O)
	shp(h, 0.5, 0.43, 0.12, 0.3, INK, 0, 0.5)
	shp(h, 0.5, 0.7, 0.13, 0.13, INK, 0, 0.5)
end
DRAW.fire = function(h, c)
	shp(h, 0.5, 0.42, 0.5, 0.5, c or IC.Orange, 45, 0.14, O)
	shp(h, 0.5, 0.62, 0.7, 0.66, c or IC.Orange, 0, 0.5, O)
	shp(h, 0.5, 0.66, 0.36, 0.36, IC.Gold, 0, 0.5)
end
DRAW.snow = function(h, c)
	for _, r in { 0, 60, 120 } do
		shp(h, 0.5, 0.5, 0.14, 0.9, c or IC.Ice, r, 0.5, O)
	end
	shp(h, 0.5, 0.5, 0.2, 0.2, IC.White, 0, 0.5)
end
DRAW.clock = function(h, c)
	shp(h, 0.5, 0.5, 0.88, 0.88, c or IC.Cream, 0, 0.5, O)
	shp(h, 0.5, 0.38, 0.08, 0.3, INK, 0, 0.5)
	shp(h, 0.6, 0.52, 0.08, 0.26, INK, 115, 0.5)
end
DRAW.hardhat = function(h, c)
	shp(h, 0.5, 0.54, 0.7, 0.56, c or IC.Gold, 0, 0.5, O)
	shp(h, 0.5, 0.74, 0.94, 0.16, IC.GoldD, 0, 0.5, O)
	shp(h, 0.5, 0.44, 0.13, 0.38, IC.GoldL, 0, 0.5)
end
DRAW.card = function(h, c)
	shp(h, 0.5, 0.5, 0.6, 0.84, IC.White, 12, 0.12, O)
	shp(h, 0.5, 0.5, 0.3, 0.3, c or IC.Purple, 57, 0.12, O)
end
DRAW.vote = function(h, c)
	shp(h, 0.5, 0.42, 0.56, 0.62, IC.White, -8, 0.1, O)
	DRAW.check(sub(h, 0.52, 0.4, 0.46), IC.Green)
	h.z += 4
	shp(h, 0.5, 0.78, 0.9, 0.34, c or IC.Teal, 0, 0.18, O)
end

DRAW.chat = function(h, c) -- v1.0 patch speech bubble (FEEDBACK)
	shp(h, 0.3, 0.74, 0.22, 0.22, IC.White, 45, 0.15, O)
	shp(h, 0.5, 0.44, 0.86, 0.62, IC.White, 0, 0.3, O)
	h.z += 1
	shp(h, 0.3, 0.71, 0.14, 0.12, IC.White, 45, 0.1)
	local dot = c or Color3.fromRGB(56, 140, 255)
	shp(h, 0.29, 0.44, 0.13, 0.13, dot, 0, 0.5)
	shp(h, 0.5, 0.44, 0.13, 0.13, dot, 0, 0.5)
	shp(h, 0.71, 0.44, 0.13, 0.13, dot, 0, 0.5)
end

DRAW.info = function(h, c)
	shp(h, 0.5, 0.5, 0.88, 0.88, c or Color3.fromRGB(56, 140, 255), 0, 0.5, O)
	shp(h, 0.5, 0.6, 0.15, 0.36, IC.White, 0, 0.5)
	shp(h, 0.5, 0.3, 0.16, 0.16, IC.White, 0, 0.5)
end
DRAW.portal = function(h, c)
	shp(h, 0.5, 0.56, 0.5, 0.66, c or IC.Orange, 0, 0.3, O)
	shp(h, 0.5, 0.6, 0.3, 0.46, IC.GoldL, 0, 0.3)
	for _, x in { 0.17, 0.83 } do
		shp(h, x, 0.56, 0.16, 0.76, IC.Cream, 0, 0.3, O)
	end
	shp(h, 0.5, 0.17, 0.9, 0.16, IC.Cream, 0, 0.3, O)
end
DRAW.boot = function(h, c)
	local col = c or Color3.fromRGB(176, 112, 62)
	shp(h, 0.4, 0.4, 0.36, 0.56, col, 0, 0.25, O)
	shp(h, 0.55, 0.68, 0.7, 0.3, col, 0, 0.45, O)
	shp(h, 0.55, 0.86, 0.76, 0.1, IC.Cream, 0, 0.5, O)
	shp(h, 0.4, 0.18, 0.42, 0.12, IC.Gold, 0, 0.4, O)
end

-- Build an icon. Returns a transparent square Frame (give it Size / Position / Parent via props).
function Icons.make(name: string, props: { [string]: any }?, color: Color3?): Frame
	local f = Instance.new("Frame")
	f.Name = "Icon"
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromOffset(32, 32)
	f:SetAttribute("NoSkin", true)
	f:SetAttribute("IconName", name)
	local parent: Instance? = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(f :: any)[k] = v
			end
		end
	end
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectRatio = 1
	ar.Parent = f
	local draw = DRAW[name] or DRAW.gem
	draw({ f = f, z = f.ZIndex }, color)
	f.Parent = parent
	return f
end


-- v1.0 patch 5: mobile control icons
DRAW.shield = function(h, c)
	local col = c or IC.Teal
	shp(h, 0.5, 0.4, 0.74, 0.56, col, 0, 0.28, O)
	shp(h, 0.5, 0.62, 0.52, 0.52, col, 45, 0.16, O)
	shp(h, 0.5, 0.42, 0.68, 0.5, col, 0, 0.26) -- hide the inner seam
	shp(h, 0.5, 0.6, 0.44, 0.44, col, 45, 0.12)
	shp(h, 0.5, 0.5, 0.12, 0.56, IC.White, 0, 0.5)
end
DRAW.burst = function(h, c) -- impact star (SHOVE)
	local col = c or IC.Gold
	shp(h, 0.5, 0.5, 0.74, 0.74, col, 0, 0.12, O)
	shp(h, 0.5, 0.5, 0.74, 0.74, col, 45, 0.12, O)
	shp(h, 0.5, 0.5, 0.7, 0.7, col, 0, 0.1)
	shp(h, 0.5, 0.5, 0.42, 0.42, IC.White, 0, 0.5, O)
end
DRAW.jump = function(h, c) -- up arrow
	local s = sub(h, 0.5, 0.5, 1)
	s.f.Rotation = -90
	DRAW.arrow(s, c)
end

Icons.Names = {}
for n in DRAW do
	table.insert(Icons.Names, n)
end
table.sort(Icons.Names)

return Icons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Net
	The server creates every RemoteEvent; clients wait for them.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"Action", -- C->S  (action: string, aim: Vector3)
	"Knockback", -- S->C  (velocity: Vector3, stunTime: number)
	"SelfMove", -- S->C  (kind: string, data)  rush / tether pulls applied to your own character
	"Effect", -- S->All (kind: string, data: table)
	"TileEvent", -- S->All (kind: string, indices: {number})
	"KillFeed", -- S->All (data: table)
	"Announce", -- S->All (text: string, style: string?)
	"RoundResults", -- S->C  (data: table)
	"Profile", -- S->C  (profile summary)
	"DevLoadout", -- C->S  (weaponId: string, level: number)
	"Toast", -- S->C  (text: string)
	"RangeResult", -- S->C  (data: table) Training Range measurement
	"JoinReply", -- C->S  (join: boolean) answer to "Join the next match?"
	"Vote", -- C->S  (kind: "map" | "mode", id: string) v0.8.1 lobby vote
	"Spar", -- S->C  (data: table) v0.9 sparring bot result: Block / Parry / Hit / WindUp
}

-- RemoteFunctions (request → validated response)
local FUNCTIONS = {
	"Request", -- C->S  (action: string, ...) → { Ok: boolean, Msg: string?, ... }
}

local Net = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local f = Instance.new("RemoteFunction")
			f.Name = name
			f.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.Get(name: string): RemoteEvent
	local e = folder:FindFirstChild(name) or folder:WaitForChild(name, 15)
	return e :: RemoteEvent
end

function Net.GetFunction(name: string): RemoteFunction
	local f = folder:FindFirstChild(name) or folder:WaitForChild(name, 15)
	return f :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Progression (shared, pure functions)
	Merge / wildcard / spin-odds math used by BOTH the server (authoritative)
	and the client (previews). Never trust the client's copy: the server re-checks everything.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rarity = require(Shared.Rarity)
local Weapons = require(Shared.Weapons)

local M = Config.Merge

local Progression = {}

export type Owned = { Level: number, Copies: number }

function Progression.NextRarity(rarity: string): string?
	local i = Rarity.Index(rarity)
	return Rarity.Order[i + 1]
end

-- Copies needed to go from `level` to `level + 1` (nil when maxed or Boot).
function Progression.CopiesFor(rarity: string, level: number): number?
	if level >= Rarity.MaxLevel then
		return nil
	end
	local row = M.Copies[rarity]
	return row and row[level] or nil
end

function Progression.CoinsFor(level: number): number?
	if level >= Rarity.MaxLevel then
		return nil
	end
	return M.Coins[level]
end

-- Knockback shown in menus (main hit, plus Gloves' combo finisher / v0.9.18 the Magnet's repel blast).
function Progression.KB(def: Weapons.WeaponDef, level: number): (number, number?)
	local mult = Rarity.Multiplier(def.Rarity, level)
	local cap = Config.Combat.KBCap
	local main = math.min(def.KB * mult, cap)
	local second = def.ComboKB or def.RepelKB
	local combo = second and math.min(second * mult, cap) or nil
	return main, combo
end

function Progression.KBText(def: Weapons.WeaponDef, level: number): string
	local main, combo = Progression.KB(def, level)
	if def.Kind == "tether" then
		return string.format("yank + KB %.1f", main)
	end
	if def.Kind == "pull" then
		return if combo then string.format("pull %.1f + repel %.1f", main, combo) else string.format("pull %.1f", main)
	end
	if combo then
		return string.format("KB %.1f (combo %.1f)", main, combo)
	end
	return string.format("KB %.1f", main)
end

export type MergeCheck = {
	Ok: boolean,
	Reason: string?,
	Maxed: boolean,
	NeedCopies: number,
	OwnCopies: number,
	Wildcards: number,
	UseOwn: number,
	UseWild: number,
	Coins: number,
}

-- Can `weaponId` be merged up one level with this profile? Own copies are used first,
-- then same-rarity wildcards. v0.9.1: the Boot merges exactly like every other weapon.
function Progression.CheckMerge(profile: any, weaponId: string): MergeCheck
	local def = Weapons.ById[weaponId]
	local owned: Owned? = profile and profile.Weapons and profile.Weapons[weaponId]
	local res: MergeCheck = {
		Ok = false,
		Reason = nil,
		Maxed = false,
		NeedCopies = 0,
		OwnCopies = 0,
		Wildcards = 0,
		UseOwn = 0,
		UseWild = 0,
		Coins = 0,
	}
	if not def or not owned then
		res.Reason = "You don't own this weapon yet."
		return res
	end
	local o = owned :: Owned
	if o.Level >= Rarity.MaxLevel then
		res.Maxed = true
		res.Reason = "Already L10 (max)."
		return res
	end
	local need = Progression.CopiesFor(def.Rarity, o.Level) :: number
	local wild = (profile.Wildcards and profile.Wildcards[def.Rarity]) or 0
	res.NeedCopies = need
	res.OwnCopies = o.Copies
	res.Wildcards = wild
	res.UseOwn = math.min(o.Copies, need)
	res.UseWild = math.min(wild, need - res.UseOwn)
	res.Coins = Progression.CoinsFor(o.Level) :: number
	if res.UseOwn + res.UseWild < need then
		res.Reason = string.format("Need %d copies (you have %d + %d wildcards).", need, o.Copies, wild)
		return res
	end
	if (profile.Coins or 0) < res.Coins then
		res.Reason = string.format("Need %d coins.", res.Coins)
		return res
	end
	res.Ok = true
	return res
end

-- Total copies still missing to reach L10 (for progress bars).
function Progression.CopiesToMax(rarity: string, level: number): number
	local total = 0
	for l = level, Rarity.MaxLevel - 1 do
		total += (Progression.CopiesFor(rarity, l) or 0)
	end
	return total
end

function Progression.WeaponsOfRarity(rarity: string, includeFree: boolean?): { Weapons.WeaponDef }
	local list = {}
	for _, def in Weapons.List do
		if def.Rarity == rarity and (includeFree or not def.Free) then
			table.insert(list, def)
		end
	end
	return list
end

-- Monday-based week number, for the coin-spin weekly limit.
function Progression.WeekIndex(unix: number): number
	return math.floor((unix - 4 * 86400) / (7 * 86400))
end

function Progression.DayIndex(unix: number): number
	return math.floor(unix / 86400)
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rarity</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Rarity
	Final KB = Base KB × Rarity Bonus × (1 + (Level − 1) × 0.03), capped by Config.Combat.KBCap.
	v1.0 balance: levels now scale WITH the rarity (was a flat +0.04 per level for every rarity, which
	squeezed the tiers together at L10: a maxed Common pushed as hard as a maxed Epic). Now each tier
	keeps the same lead at every level. L10 = ×1.27 Common … ×2.03 Mythic (Mythic hits the 34 cap).
	Timing (windup/cooldown/range) NEVER scales.
]]

local Rarity = {}

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

Rarity.Bonus = {
	Common = 1.00,
	-- v0.7.1 "clear power ladder": each tier hits clearly harder.
	-- v0.7.5 balance: the top was too strong, so Legendary/Mythic are compressed
	-- (Mythic L1 ×1.80 → ×1.60, L10 ×2.16 → ×1.96; Legendary 1.60 → 1.50).
	Uncommon = 1.12,
	Rare = 1.25,
	Epic = 1.40,
	Legendary = 1.50,
	Mythic = 1.60,
}

Rarity.Colors = {
	Common = Color3.fromRGB(201, 209, 220),
	Uncommon = Color3.fromRGB(61, 220, 151),
	Rare = Color3.fromRGB(78, 168, 255),
	Epic = Color3.fromRGB(176, 124, 255),
	Legendary = Color3.fromRGB(255, 176, 32),
	Mythic = Color3.fromRGB(255, 77, 109),
}

Rarity.LevelBonus = 0.03 -- v1.0: +3% of the rarity bonus per level (multiplies)
Rarity.MaxLevel = 10

function Rarity.Multiplier(rarity: string, level: number): number
	local base = Rarity.Bonus[rarity] or 1
	local lvl = math.clamp(math.floor(level or 1), 1, Rarity.MaxLevel)
	return base * (1 + (lvl - 1) * Rarity.LevelBonus)
end

-- Power Rating shown on nameplates (100–203)
function Rarity.PWR(rarity: string, level: number): number
	return math.floor(Rarity.Multiplier(rarity, level) * 100 + 0.5)
end

function Rarity.Index(rarity: string): number
	for i, r in Rarity.Order do
		if r == rarity then
			return i
		end
	end
	return 1
end

return Rarity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Retention</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Retention (shared, pure functions) · v0.9
	Daily quests, the weekly chain and the Season track. Used by the server (authoritative:
	RetentionService) and by the client (menus / previews). Never trust the client's copy.

	Profile fields used (see DataService):
	  Daily  = { Day: number, Ids: {string}, Progress: {[string]: number}, Done: {[string]: boolean} }
	  Weekly = { Week: number, Step: number, Progress: number }
	  Season = { Id: string, XP: number, Claimed: {[string]: boolean} }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local RT = Config.Retention
local SE = Config.Season

local Retention = {}

export type Stats = { [string]: number }
export type Completed = { Kind: string, Text: string, Coins: number?, Spins: number? }

function Retention.DayIndex(unix: number): number
	return math.floor(unix / 86400)
end

-- Monday-based week (same rule as the coin-spin limit)
function Retention.WeekIndex(unix: number): number
	return math.floor((unix - 4 * 86400) / (7 * 86400))
end

function Retention.DailyDef(id: string): { [string]: any }?
	for _, q in RT.Daily do
		if q.Id == id then
			return q
		end
	end
	return nil
end

-- the dailies for one player on one day: a deterministic shuffle (same picks all day, on
-- every server), never two map quests on the same day
function Retention.DailyFor(userId: number, day: number): { string }
	-- Park–Miller LCG: every product stays below 2^53, so it's exact (and identical) everywhere
	local seed = ((math.abs(userId) % 1000003) * 7919 + day * 104729) % 2147483647
	if seed == 0 then
		seed = 1
	end
	local function rnd(): number
		seed = (seed * 16807) % 2147483647
		return seed / 2147483647
	end
	rnd()
	local pool = {}
	for _, q in RT.Daily do
		table.insert(pool, q.Id)
	end
	for i = #pool, 2, -1 do
		local j = 1 + math.floor(rnd() * i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local out = {}
	local mapPicked = false
	for _, id in pool do
		local isMap = id == "Molten1" or id == "Ice1" or id == "Grid1"
		if not (isMap and mapPicked) then
			table.insert(out, id)
			mapPicked = mapPicked or isMap
		end
		if #out >= RT.DailyCount then
			break
		end
	end
	return out
end

-- reset the dailies / weekly chain when the day / week rolls over. Returns true if changed.
function Retention.Ensure(p: any, userId: number, unix: number): boolean
	local changed = false
	local day = Retention.DayIndex(unix)
	if type(p.Daily) ~= "table" or p.Daily.Day ~= day then
		p.Daily = { Day = day, Ids = Retention.DailyFor(userId, day), Progress = {}, Done = {} }
		changed = true
	end
	local week = Retention.WeekIndex(unix)
	if type(p.Weekly) ~= "table" or p.Weekly.Week ~= week then
		p.Weekly = { Week = week, Step = 1, Progress = 0 }
		changed = true
	end
	local seasonId = Config.SeasonIdAt(unix)
	if type(p.Season) ~= "table" or p.Season.Id ~= seasonId then
		p.Season = { Id = seasonId, XP = 0, Claimed = {} }
		changed = true
	end
	return changed
end

-- what one round counts for
function Retention.StatsFromResult(you: { [string]: any }): Stats
	local s: Stats = {
		Rounds = 1,
		HumanKOs = you.KOs or 0,
		AnyKOs = (you.KOs or 0) + (you.BotKOs or 0),
		Seconds = you.SecondsAlive or 0,
		Top3 = ((you.Placement or 99) <= 3 or you.Timeout == true) and 1 or 0,
		Wins = you.Won == true and 1 or 0,
		Assists = you.Assists or 0,
	}
	if type(you.Map) == "string" then
		s["Map" .. you.Map] = 1
	end
	if type(you.Mode) == "string" then
		s["Mode" .. you.Mode] = 1
	end
	return s
end

local function pay(p: any, coins: number?, spins: number?)
	if coins then
		p.Coins = (p.Coins or 0) + coins
	end
	if spins then
		p.Spins = (p.Spins or 0) + spins
	end
end

-- count a round toward dailies + the weekly chain; rewards are paid straight away.
function Retention.Apply(p: any, userId: number, stats: Stats, unix: number): { Completed }
	Retention.Ensure(p, userId, unix)
	local done: { Completed } = {}
	-- dailies
	for _, id in p.Daily.Ids do
		local q = Retention.DailyDef(id)
		if q and not p.Daily.Done[id] then
			local add = stats[q.Stat] or 0
			if add > 0 then
				local v = math.min(q.Goal, (p.Daily.Progress[id] or 0) + add)
				p.Daily.Progress[id] = v
				if v >= q.Goal then
					p.Daily.Done[id] = true
					pay(p, q.Coins, q.Spins)
					table.insert(done, { Kind = "Daily", Text = q.Text, Coins = q.Coins, Spins = q.Spins })
				end
			end
		end
	end
	-- v0.9.13: finishing ALL of today's dailies pays a bonus spin (once a day)
	if (RT.DailyAllSpins or 0) > 0 and not p.Daily.BonusPaid then
		local all = #p.Daily.Ids > 0
		for _, id in p.Daily.Ids do
			if not p.Daily.Done[id] then
				all = false
				break
			end
		end
		if all then
			p.Daily.BonusPaid = true
			pay(p, nil, RT.DailyAllSpins)
			table.insert(done, { Kind = "Daily", Text = "All dailies done!", Spins = RT.DailyAllSpins })
		end
	end
	-- weekly chain: a round can finish at most ONE step (no overflow into the next one)
	local w = p.Weekly
	local step = RT.Weekly[w.Step]
	local add = step and (stats[step.Stat] or 0) or 0
	if step and add > 0 then
		w.Progress = math.min(step.Goal, w.Progress + add)
		if w.Progress >= step.Goal then
			pay(p, step.Coins, step.Spins)
			table.insert(done, { Kind = "Weekly", Text = step.Text, Coins = step.Coins, Spins = step.Spins })
			w.Step += 1
			w.Progress = 0
		end
	end
	return done
end

------------------------------------------------------------------------
-- Season
------------------------------------------------------------------------
function Retention.SeasonTiers(): number
	return #SE.Free
end

-- tier reached (0 … 30), XP into the next tier, XP needed for it
function Retention.SeasonTier(xp: number): (number, number, number)
	local tier = math.min(math.floor(xp / SE.TierXP), #SE.Free)
	if tier >= #SE.Free then
		return tier, SE.TierXP, SE.TierXP
	end
	return tier, xp - tier * SE.TierXP, SE.TierXP
end

function Retention.SeasonRewardText(r: { [string]: any }): string
	if r.Spins then
		return string.format("+%d SPIN", r.Spins)
	elseif r.Wild then
		return string.format("+%d %s wildcard%s", r.Count or 1, r.Wild, (r.Count or 1) > 1 and "s" or "")
	end
	return string.format("+%d coins", r.Coins or 0)
end

-- claim one tier (or every reachable unclaimed tier with tier = 0). Returns what was paid.
function Retention.ClaimSeason(p: any, tier: number): { { [string]: any } }
	local reached = Retention.SeasonTier(p.Season.XP)
	local paid = {}
	local first, last = tier, tier
	if tier == 0 then
		first, last = 1, reached
	end
	for t = first, last do
		local key = tostring(t)
		local r = SE.Free[t]
		if r and t <= reached and not p.Season.Claimed[key] then
			p.Season.Claimed[key] = true
			if r.Wild then
				p.Wildcards[r.Wild] = (p.Wildcards[r.Wild] or 0) + (r.Count or 1)
			else
				pay(p, r.Coins, r.Spins)
			end
			table.insert(paid, { Tier = t, Text = Retention.SeasonRewardText(r) })
		end
	end
	return paid
end

function Retention.UnclaimedSeason(p: any): number
	if type(p.Season) ~= "table" then
		return 0
	end
	local reached = Retention.SeasonTier(p.Season.XP or 0)
	local n = 0
	for t = 1, reached do
		if not (p.Season.Claimed or {})[tostring(t)] then
			n += 1
		end
	end
	return n
end

return Retention
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">WeaponPoses</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by tools/weapon_poses.py (v0.9.16) — edit the tool, not this file.
-- Per-weapon grip, holding pose, idle bob and swing clips (Motor6D C0 offsets, R15).

local function E(x: number, y: number, z: number): CFrame
	return CFrame.fromEulerAnglesYXZ(math.rad(x), math.rad(y), math.rad(z))
end

export type Pose = { [string]: CFrame }
export type ClipKey = { a: number, b: number, e: string?, pose: Pose }
export type ClipDef = { Keys: { ClipKey }, Hold: string, Recover: number }
export type Bob = { Joint: string, Axis: string, Amp: number, Freq: number }

local WeaponPoses = {}

WeaponPoses.Grip = {
	Boot = CFrame.identity,
	BigBoot = CFrame.identity,
	Gloves = CFrame.identity,
	Bat = E(78, 0, 14),
	Pan = E(80, 0, 0),
	Slingshot = E(90, 0, 0) * E(0, 180, 0),
	Magnet = CFrame.identity,
	BombBag = CFrame.identity,
	VoidHook = E(90, 0, 0),
	Hammer = E(78, 0, 14),
} :: { [string]: CFrame }

WeaponPoses.Hold = {
	Boot = { LeftElbow = E(40, 0, 0), LeftShoulder = E(14, 0, -10), RightElbow = E(40, 0, 0), RightShoulder = E(14, 0, 10) },
	BigBoot = { LeftElbow = E(40, 0, 0), LeftShoulder = E(14, 0, -10), RightElbow = E(40, 0, 0), RightShoulder = E(14, 0, 10) },
	Gloves = { LeftElbow = E(100, 0, 0), LeftKnee = E(-8, 0, 0), LeftShoulder = E(52, -32, 0), RightElbow = E(100, 0, 0), RightKnee = E(-8, 0, 0), RightShoulder = E(52, 32, 0), Waist = E(-4, 0, 0) },
	Bat = { LeftShoulder = E(6, 0, -6), RightElbow = E(128, 0, 0), RightShoulder = E(28, 18, 12) },
	Pan = { LeftElbow = E(20, 0, 0), LeftShoulder = E(10, 0, -8), RightElbow = E(92, 0, 0), RightShoulder = E(18, 0, 26) },
	Slingshot = { LeftElbow = E(70, 0, 0), LeftShoulder = E(62, -30, 0), RightElbow = E(22, 0, 0), RightShoulder = E(68, 14, 0) },
	Magnet = { LeftElbow = E(62, 0, 0), LeftShoulder = E(52, -34, 0), RightElbow = E(28, 0, 0), RightShoulder = E(58, 12, 0) },
	BombBag = { LeftElbow = E(25, 0, 0), LeftShoulder = E(10, 0, -10), RightElbow = E(96, 0, 0), RightShoulder = E(34, 14, 6) },
	Hammer = { LeftElbow = E(14, 0, 0), LeftShoulder = E(8, 0, -6), RightElbow = E(124, 0, 0), RightShoulder = E(30, 18, 12) },
	VoidHook = { LeftShoulder = E(8, 0, -8), RightElbow = E(78, 0, 0), RightShoulder = E(16, 0, 14) },
} :: { [string]: Pose }

WeaponPoses.Bob = {
	Gloves = { { Joint = "RightShoulder", Axis = "X", Amp = 5, Freq = 7 }, { Joint = "LeftShoulder", Axis = "X", Amp = -5, Freq = 7 }, { Joint = "Waist", Axis = "Y", Amp = 4, Freq = 3.5 } },
	BombBag = { { Joint = "RightElbow", Axis = "X", Amp = 6, Freq = 4 } },
	VoidHook = { { Joint = "RightShoulder", Axis = "Z", Amp = 5, Freq = 2.6 } },
	Bat = { { Joint = "RightShoulder", Axis = "X", Amp = 2, Freq = 2 } },
	Hammer = { { Joint = "RightShoulder", Axis = "X", Amp = 3, Freq = 2.6 }, { Joint = "RightKnee", Axis = "X", Amp = -3, Freq = 2.6 }, { Joint = "LeftKnee", Axis = "X", Amp = -3, Freq = 2.6 } },
	Pan = { { Joint = "RightElbow", Axis = "X", Amp = 3, Freq = 2.4 } },
	Boot = { { Joint = "RightKnee", Axis = "X", Amp = -4, Freq = 5 }, { Joint = "LeftKnee", Axis = "X", Amp = -4, Freq = 5 }, { Joint = "RightShoulder", Axis = "X", Amp = 3, Freq = 5 } },
	BigBoot = { { Joint = "RightKnee", Axis = "X", Amp = -5, Freq = 3.6 }, { Joint = "LeftKnee", Axis = "X", Amp = -5, Freq = 3.6 }, { Joint = "Waist", Axis = "X", Amp = -2, Freq = 3.6 } },
	Slingshot = { { Joint = "LeftElbow", Axis = "X", Amp = 4, Freq = 3 }, { Joint = "Neck", Axis = "Y", Amp = 3, Freq = 1.4 } },
	Magnet = { { Joint = "RightShoulder", Axis = "Z", Amp = 1.5, Freq = 21 }, { Joint = "LeftShoulder", Axis = "Z", Amp = -1.5, Freq = 21 }, { Joint = "Waist", Axis = "Y", Amp = 2, Freq = 1.6 } },
} :: { [string]: { Bob } }

WeaponPoses.Clips = {
	Kick = { Hold = "Boot", Recover = 0.22, Keys = {
		{ a = 0.5, b = 0, e = "smooth", pose = { LeftElbow = E(40, 0, 0), LeftKnee = E(-26, 0, 0), LeftShoulder = E(38, 0, -16), RightElbow = E(40, 0, 0), RightHip = E(-30, 0, 0), RightKnee = E(-62, 0, 0), RightShoulder = E(-30, 0, 14), Root = CFrame.new(0, -0.18, 0.12) * E(4, -8, 0), Waist = E(-8, -14, 0) } },
		{ a = 1, b = 0, e = "accel", pose = { LeftElbow = E(40, 0, 0), LeftKnee = E(-20, 0, 0), LeftShoulder = E(50, 0, -28), RightElbow = E(40, 0, 0), RightHip = E(76, 0, 0), RightKnee = E(-120, 0, 0), RightShoulder = E(-18, 0, 24), Root = CFrame.new(0, -0.06, 0.05) * E(6, 4, 0), Waist = E(10, 8, 0) } },
		{ a = 1, b = 0.04, e = "snap", pose = { LeftElbow = E(40, 0, 0), LeftKnee = E(-24, 0, 0), LeftShoulder = E(-36, 0, -50), Neck = E(-14, 0, 0), RightElbow = E(40, 0, 0), RightHip = E(122, 0, 0), RightKnee = E(-2, 0, 0), RightShoulder = E(60, 0, 36), Root = CFrame.new(0, 0.04, -0.4) * E(10, 10, 0), Waist = E(26, 10, 0) } },
		{ a = 1, b = 0.12, e = "smooth", pose = { LeftElbow = E(40, 0, 0), LeftKnee = E(-24, 0, 0), LeftShoulder = E(-32, 0, -48), Neck = E(-12, 0, 0), RightElbow = E(40, 0, 0), RightHip = E(126, 0, 0), RightKnee = E(-4, 0, 0), RightShoulder = E(56, 0, 34), Root = CFrame.new(0, 0.02, -0.44) * E(11, 11, 0), Waist = E(27, 11, 0) } },
		{ a = 1, b = 0.22, e = "smooth", pose = { LeftElbow = E(40, 0, 0), LeftKnee = E(-20, 0, 0), LeftShoulder = E(4, 0, -30), RightElbow = E(40, 0, 0), RightHip = E(90, 0, 0), RightKnee = E(-70, 0, 0), RightShoulder = E(26, 0, 22), Root = CFrame.new(0, -0.1, -0.2) * E(6, 4, 0), Waist = E(16, 4, 0) } },
