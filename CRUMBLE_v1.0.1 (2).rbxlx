local function showWeaponReveal(weaponId: string, level: number, fromBox: boolean)
	local r = refs.Reveal
	if not r then
		return
	end
	local def = Weapons.Get(weaponId)
	local text = Descriptions.Weapon(def.Id)
	local rc = Rarity.Colors[def.Rarity] or Col.Gold
	r.Stripe.BackgroundColor3 = rc
	r.Chip.BackgroundColor3 = rc
	r.Chip.Text = string.format("%s · L%d", string.upper(def.Rarity), level)
	r.Name.Text = string.upper(def.Name)
	r.Short.Text = text.Tag
	r.Desc.Text = text.Desc
	r.Card.Visible = true
	r.Until = now() + (fromBox and 3.2 or 4.5)
	EffectsController.Play("Click", 0.5, 1.2)
end

