local function buildActionBar()
	-- v0.7.3 layout: weapon card + skills card, each with key caps, floating bottom-centre
	local a = UI.new("Frame", {
		Name = "ActionBar",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(548, 92),
		BackgroundTransparency = 1,
		Visible = false,
	})
	refs.ActionBar = a
	local wc = panel({ Name = "WeaponCard", Parent = a, Size = UDim2.fromOffset(196, 92) })
	local stripe = UI.new("Frame", { Name = "Stripe", Parent = wc, Position = UDim2.fromOffset(8, 10), Size = UDim2.new(0, 8, 1, -20), BackgroundColor3 = Col.Text, BorderSizePixel = 0 })
	UI.corner(4).Parent = stripe
	refs.WeaponStripe = stripe
	refs.WeaponName = UI.label({ Parent = wc, Position = UDim2.fromOffset(24, 10), Size = UDim2.fromOffset(164, 28), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, Text = "BOOT" })
	refs.WeaponInfo = UI.label({ Parent = wc, Position = UDim2.fromOffset(24, 42), Size = UDim2.fromOffset(164, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "" })
	refs.PWR = UI.label({ Parent = wc, Position = UDim2.fromOffset(24, 62), Size = UDim2.fromOffset(164, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Gold, Text = "" })
	local sk = panel({ Name = "SkillsCard", Parent = a, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(344, 92) })
	-- v1.0 patch MOBILE: on touch the thumb buttons show the cooldowns themselves; only the weapon card
	-- stays (patch 4: switches live with Layout's touch mode)
	Layout.OnModeChanged(function(touch: boolean)
		sk.Visible = not touch
		a.Size = UDim2.fromOffset(if touch then 196 else 548, 92)
	end)
	local function keycap(y: number, key: string)
		if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
			key = if key == "CLICK" then "R2" elseif key == "SHIFT" then "L1" else "L2"
		end
		local k = UI.label({ Parent = sk, Position = UDim2.fromOffset(10, y), Size = UDim2.fromOffset(38, 22), BackgroundTransparency = 0, BackgroundColor3 = Col.Text, TextColor3 = Color3.new(1, 1, 1), TextScaled = false, TextSize = 12, Text = key })
		UI.corner(7).Parent = k
	end
	keycap(8, "CLICK")
	keycap(35, "SHIFT")
	keycap(62, "E")
	local f1, l1 = bar(sk, UDim2.fromOffset(56, 8), UDim2.fromOffset(276, 22), Col.Lava, "SHOVE")
	local f2, l2 = bar(sk, UDim2.fromOffset(56, 35), UDim2.fromOffset(276, 22), Color3.fromRGB(78, 120, 255), "RUSH")
	local f3, l3 = bar(sk, UDim2.fromOffset(56, 62), UDim2.fromOffset(276, 22), Col.Ice, "GUARD")
	refs.ShoveFill, refs.ShoveLabel = f1, l1
	refs.RushFill, refs.RushLabel = f2, l2
	refs.GuardFill, refs.GuardLabel = f3, l3
	-- v0.9.17: hover a move bar (free mouse, e.g. in the Range) to read what it does
	local tip = UI.label({ Name = "MoveTip", Parent = a, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 0, -8), Size = UDim2.fromOffset(344, 40), BackgroundTransparency = 0.04, BackgroundColor3 = Col.Text, TextColor3 = Color3.new(1, 1, 1), TextScaled = false, TextSize = 14, TextWrapped = true, Visible = false, Text = "" })
	UI.corner(10).Parent = tip
	UI.new("UIPadding", { Parent = tip, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
	for _, pair in { { f1, "SHOVE" }, { f2, "RUSH" }, { f3, "GUARD" } } do
		local host = pair[1].Parent :: GuiObject
		host.MouseEnter:Connect(function()
			tip.Text = Descriptions.Moves[pair[2]]
			tip.Visible = true
		end)
		host.MouseLeave:Connect(function()
			tip.Visible = false
		end)
	end

	-- v0.9.3: the equipped line is a readable pill (it used to be bare text over the world)
	refs.Equipped = UI.label({
		Name = "EquippedPill",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 0.08,
		BackgroundColor3 = Col.Panel,
		TextScaled = false,
		TextSize = 17,
		RichText = true,
		Text = "",
	})
	UI.corner(17).Parent = refs.Equipped
	UI.new("UIPadding", { Parent = refs.Equipped, PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) })
end

