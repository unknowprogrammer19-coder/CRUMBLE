} :: { [string]: string }

return WeaponPoses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">WeaponVisuals</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — WeaponVisuals (v0.9.20 "Crafted": real-object toy models, per-weapon grips)
	Procedural, part-built weapon models + rarity finish + merge-level visual stages.

	ART PIPELINE: drop a real 3D model into ReplicatedStorage/WeaponModels named after the weapon id
	(e.g. "Pan") with a part named "Handle" (grip point; −Y = away from wrist, −Z = forward).
	Parts named "Accent" and "Gem" get the rarity / level treatment automatically, and attachments
	named "TrailTop" / "TrailTip" drive the L5 swing trail. Everything below is used only as the
	fallback, so real meshes swap in with zero code changes.

	Rarity finish (always on):
		Common   bare materials           Uncommon  green gem
		Rare     blue gem + soft light     Epic      purple gem + light + sparkle
		Legendary gold gem + light + embers  Mythic  red gem + light + dark-void wisps

	Level stages (doc §9 merge table):
		L3  coloured finish   — accent parts take the rarity colour (metal)
		L4  glowing accents   — accents turn neon + light
		L5  swing trail       — Trail (enabled only while swinging, by AnimationController)
		L7  particle aura     — rarity-coloured aura particles
		L8  KO effect         — character attribute KOEffect → light pillar where the victim fell
		L10 ASCENDED          — 15 % bigger, halo ring, white-gold sparkle, "ASCENDED" title
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Weapons = require(script.Parent.Weapons)
local Rarity = require(script.Parent.Rarity)
local Art = require(script.Parent.Art)
local WeaponPoses = require(script.Parent.WeaponPoses)

local WeaponVisuals = {}

local MODEL_NAME = "CrumbleWeapon"
local M = Enum.Material

-- Shared palette (no pastels; amber/red stay reserved for cracking tiles)
local C = {
	Leather = Color3.fromRGB(92, 58, 38),
	LeatherDark = Color3.fromRGB(58, 36, 24),
	Rubber = Color3.fromRGB(28, 28, 32),
	Steel = Color3.fromRGB(150, 156, 166),
	SteelDark = Color3.fromRGB(70, 74, 82),
	Iron = Color3.fromRGB(40, 42, 48),
	Wood = Color3.fromRGB(150, 104, 62),
	WoodDark = Color3.fromRGB(96, 64, 38),
	Lace = Color3.fromRGB(235, 235, 240),
	GloveRed = Color3.fromRGB(170, 22, 30),
	Cuff = Color3.fromRGB(236, 236, 240),
	MagnetRed = Color3.fromRGB(176, 28, 34),
	Canvas = Color3.fromRGB(96, 84, 60),
	Void = Color3.fromRGB(120, 40, 255),
	VoidDark = Color3.fromRGB(24, 16, 40),
}

type BuildResult = {
	Accents: { BasePart },
	Gems: { BasePart },
	TrailTop: Vector3,
	TrailTip: Vector3,
	HaloAt: Vector3,
	HaloRadius: number,
}

type Builder = (k: Art.Kit, side: string) -> BuildResult

local function result(top: Vector3, tip: Vector3, haloAt: Vector3, haloR: number): BuildResult
	return { Accents = {}, Gems = {}, TrailTop = top, TrailTip = tip, HaloAt = haloAt, HaloRadius = haloR }
end

------------------------------------------------------------------------
-- Builders (local space of the grip / foot)
------------------------------------------------------------------------
local BUILDERS: { [string]: Builder } = {}

-- v0.9.20 "Crafted" weapon models (playtest: three looks rejected; the redesign was left to us).
-- Each weapon is now built like the REAL object it is, in toy proportions: real silhouettes
-- (a canvas high-top, a work boot, a lathe-turned bat, a cast-iron skillet with flared walls, an
-- electromagnet with a copper coil...), real materials (canvas/leather/rubber/wood/metal keep
-- their Roblox material, only plain plastic is flattened) and only details the object really has
-- (laces and eyelets, lug tread, grip tape, rivets, a hang hole, a fuse). One clear palette per
-- object. Anchor conventions, trail points, Accent parts (L3/L4 finish) and Gems are kept; the
-- Void Hook keeps its approved look.

local INK = Color3.fromRGB(30, 28, 42)
local WHITE = Color3.fromRGB(250, 248, 242)
local SILVER = Color3.fromRGB(206, 210, 220)
local YELLOW = Color3.fromRGB(252, 196, 40)
local RUBBER = Color3.fromRGB(44, 40, 48)

-- result() in the kit's scale (trail / halo points follow the oversized model)
local function sres(k: Art.Kit, top: Vector3, tip: Vector3, haloAt: Vector3, haloR: number): BuildResult
	local s = k.Scale
	return result(top * s, tip * s, haloAt * s, haloR * s)
end

-- a smooth ellipsoid (block + sphere SpecialMesh: Ball parts are always uniform spheres)
local function egg(k: Art.Kit, size: Vector3, pos: Vector3 | CFrame, color: Color3, mat: Enum.Material?, name: string?): Part
	local p = Art.Box(k, size, pos, color, mat, name)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p:SetAttribute("Softened", true) -- SoftenAll leaves it alone
	return p
end

-- a plain cylinder from a to b (no end caps)
local function tube(k: Art.Kit, a: Vector3, b: Vector3, d: number, color: Color3, mat: Enum.Material?, name: string?): Part
	local dir = b - a
	local len = dir.Magnitude
	local rot = if len < 1e-4 then CFrame.identity
		elseif math.abs(dir.Unit.Y) > 0.98 then CFrame.lookAt(Vector3.zero, dir, Vector3.xAxis)
		else CFrame.lookAt(Vector3.zero, dir)
	return Art.CylZ(k, d, math.max(len, 0.02), (a + b) / 2, color, mat, name, rot)
end

-- a capsule: tube + a ball on each end (returns the tube)
local function capsule(k: Art.Kit, a: Vector3, b: Vector3, d: number, color: Color3, mat: Enum.Material?, name: string?): Part
	local t = tube(k, a, b, d, color, mat, name)
	Art.Ball(k, d, a, color, mat)
	Art.Ball(k, d, b, color, mat)
	return t
end

-- a smooth bent tube along point(theta) (degrees), with ball joints so it never shows a crease
local function bend(k: Art.Kit, point: (number) -> Vector3, a0: number, a1: number, n: number, d: number, color: Color3, mat: Enum.Material?, joints: boolean?)
	local prev = point(math.rad(a0))
	if joints ~= false then
		Art.Ball(k, d, prev, color, mat)
	end
	for i = 1, n do
		local p = point(math.rad(a0 + (a1 - a0) * i / n))
		local dir = p - prev
		-- overlap a hair so the seams close
		tube(k, prev - dir * 0.04, p + dir * 0.04, d, color, mat)
		if joints ~= false then
			Art.Ball(k, d, p, color, mat)
		end
		prev = p
	end
end

-- a flat strip from a to b (width along X, thickness t): tongues, lace panels, labels
local function slab(k: Art.Kit, a: Vector3, b: Vector3, w: number, t: number, color: Color3, mat: Enum.Material?, name: string?): Part
	local dir = (b - a).Unit
	local vY = dir:Cross(Vector3.xAxis)
	return Art.Part(k, Vector3.new(w, t, (b - a).Magnitude), CFrame.fromMatrix((a + b) / 2, Vector3.xAxis, vY, dir), color, mat, nil, name)
end

-- a "stadium" outline (sole shapes): a box between two upright discs (toe zt, heel zh)
local function stadium(k: Art.Kit, w: number, h: number, y: number, zt: number, zh: number, color: Color3, mat: Enum.Material?, name: string?): { Part }
	return {
		Art.Box(k, Vector3.new(w, h, zh - zt), Vector3.new(0, y, (zt + zh) / 2), color, mat, name),
		Art.CylY(k, w, h, Vector3.new(0, y, zt), color, mat, name),
		Art.CylY(k, w * 0.94, h, Vector3.new(0, y, zh), color, mat, name),
	}
end

local function addAll(into: { BasePart }, parts: { Part })
	for _, p in parts do
		table.insert(into, p)
	end
end

-- a sneaker / boot lace column: eyelets (or hooks) up both sides and criss-crossed laces, laid on
-- the line a -> b (the front of the tongue)
local function laceUp(k: Art.Kit, a: Vector3, b: Vector3, rows: number, half: number, lace: Color3, eye: Color3, eyeD: number)
	local pts = {}
	for i = 0, rows - 1 do
		local p = a:Lerp(b, (i + 0.5) / rows)
		table.insert(pts, p)
		for _, sx in { -1, 1 } do
			Art.Ball(k, eyeD, p + Vector3.new(sx * half, 0, 0), eye, M.Metal)
		end
	end
	for i = 1, rows - 1 do
		local p0, p1 = pts[i], pts[i + 1]
		capsule(k, p0 + Vector3.new(-half, 0, -0.02), p1 + Vector3.new(half, 0, -0.02), 0.08, lace, M.Fabric)
		capsule(k, p0 + Vector3.new(half, 0, -0.03), p1 + Vector3.new(-half, 0, -0.03), 0.08, lace, M.Fabric)
	end
end

BUILDERS.Boot = function(k)
	-- the free Boot: a red canvas high-top (white rubber toe cap and midsole, black foxing stripe,
	-- white laces through silver eyelets, round ankle patch)
	local r = sres(k, Vector3.new(0, 0.7, 0.3), Vector3.new(0, -0.1, -1.45), Vector3.new(0, 1.45, 0.32), 0.85)
	local red, redD = Color3.fromRGB(206, 36, 44), Color3.fromRGB(150, 24, 34)
	stadium(k, 1.42, 0.16, -0.37, -0.72, 0.6, RUBBER, M.Rubber) -- outsole
	stadium(k, 1.38, 0.26, -0.16, -0.72, 0.6, WHITE, M.Rubber) -- midsole
	addAll(r.Accents, stadium(k, 1.46, 0.05, -0.12, -0.72, 0.6, INK, nil, "Accent")) -- foxing stripe
	egg(k, Vector3.new(1.28, 0.6, 1.0), Vector3.new(0, -0.04, -0.92), WHITE, M.Rubber) -- toe cap
	egg(k, Vector3.new(1.3, 0.86, 1.6), Vector3.new(0, 0, -0.5), red, M.Fabric) -- toe box
	Art.Box(k, Vector3.new(1.3, 0.8, 1.05), Vector3.new(0, 0.33, 0.1), red, M.Fabric) -- quarter
	Art.CylY(k, 1.3, 0.8, Vector3.new(0, 0.33, 0.6), red, M.Fabric) -- heel
	Art.Box(k, Vector3.new(0.34, 0.42, 0.06), Vector3.new(0, 0.18, 1.24), INK) -- heel label
	-- v1.0: shorter shaft so the worn boot ends just under the knee (was up to the hip)
	Art.CylY(k, 1.28, 0.5, Vector3.new(0, 0.88, 0.32), red, M.Fabric) -- ankle shaft
	egg(k, Vector3.new(1.44, 0.32, 1.44), Vector3.new(0, 1.12, 0.32), INK, M.Fabric) -- padded collar
	Art.CylY(k, 1.04, 0.06, Vector3.new(0, 1.26, 0.32), Color3.fromRGB(16, 14, 22)) -- opening
	slab(k, Vector3.new(0, 0.42, -0.54), Vector3.new(0, 1.36, -0.36), 0.74, 0.2, redD, M.Fabric) -- tongue
	local la, lb = Vector3.new(0, 0.5, -0.66), Vector3.new(0, 1.12, -0.55)
	slab(k, la, lb, 0.6, 0.06, redD, M.Fabric) -- lace panel
	laceUp(k, la + Vector3.new(0, 0, -0.04), lb + Vector3.new(0, 0, -0.04), 3, 0.22, WHITE, SILVER, 0.09)
	Art.Box(k, Vector3.new(0.3, 0.3, 0.06), Vector3.new(0, 1.2, 0.97), INK) -- heel pull tab
	Art.CylX(k, 0.5, 0.05, Vector3.new(0.645, 0.86, 0.32), WHITE) -- ankle patch
	table.insert(r.Gems, Art.CylX(k, 0.26, 0.06, Vector3.new(0.67, 0.86, 0.32), SILVER, M.Metal, "Gem"))
	return r
end

BUILDERS.BigBoot = function(k)
	-- the launcher: a big wheat-leather WORK BOOT on a chunky lug sole, steel toe cap, padded brown
	-- collar and tongue, red laces on silver speed hooks
	local s = 1.3
	local kk = Art.Kit(k.Model, k.Anchor, k.Origin * CFrame.new(0, 0.45 * s - 0.5, 0), k.Scale * s)
	local r = sres(kk, Vector3.new(0, 0.8, 0.3), Vector3.new(0, -0.1, -1.45), Vector3.new(0, 1.65, 0.32), 0.9)
	local lift = Vector3.new(0, 0.45 * s - 0.5, 0)
	r.TrailTop += lift
	r.TrailTip += lift
	r.HaloAt += lift
	local wheat, brown = Color3.fromRGB(204, 146, 72), Color3.fromRGB(86, 54, 34)
	local sole, lace = Color3.fromRGB(52, 38, 30), Color3.fromRGB(190, 56, 40)
	stadium(kk, 1.56, 0.3, -0.3, -0.72, 0.6, sole, M.Rubber) -- lug sole
	for _, z in { -0.55, -0.15, 0.25, 0.6 } do
		Art.Box(kk, Vector3.new(1.64, 0.14, 0.22), Vector3.new(0, -0.37, z), sole, M.Rubber) -- lugs
	end
	stadium(kk, 1.6, 0.08, -0.11, -0.72, 0.6, Color3.fromRGB(120, 78, 44), M.Leather) -- welt
	egg(kk, Vector3.new(1.46, 1.0, 1.7), Vector3.new(0, 0, -0.52), wheat, M.Leather) -- toe box
	table.insert(r.Accents, egg(kk, Vector3.new(1.5, 0.72, 1.0), Vector3.new(0, -0.04, -0.95), SILVER, M.Metal, "Accent")) -- steel toe
	Art.Box(kk, Vector3.new(1.46, 0.95, 1.05), Vector3.new(0, 0.38, 0.1), wheat, M.Leather) -- vamp
	Art.CylY(kk, 1.46, 0.95, Vector3.new(0, 0.38, 0.58), wheat, M.Leather) -- heel
	-- v1.0: shorter shaft so the worn boot ends above the knee, not at the chest
	Art.CylY(kk, 1.44, 0.5, Vector3.new(0, 1.03, 0.32), wheat, M.Leather) -- shaft
	egg(kk, Vector3.new(1.6, 0.42, 1.6), Vector3.new(0, 1.28, 0.32), brown, M.Leather) -- padded collar
	Art.CylY(kk, 1.1, 0.06, Vector3.new(0, 1.46, 0.32), Color3.fromRGB(24, 16, 12)) -- opening
	local ta, tb = Vector3.new(0, 0.5, -0.6), Vector3.new(0, 1.52, -0.42)
	slab(kk, ta, tb, 0.8, 0.22, brown, M.Leather) -- padded tongue
	local off = Vector3.new(0, 0, -0.13)
	laceUp(kk, ta:Lerp(tb, 0.14) + off, ta:Lerp(tb, 0.86) + off, 3, 0.36, lace, SILVER, 0.14)
	Art.Box(kk, Vector3.new(0.32, 0.36, 0.08), Vector3.new(0, 1.42, 1.05), brown, M.Leather) -- pull loop
	table.insert(r.Gems, Art.CylX(kk, 0.34, 0.06, Vector3.new(0.74, 0.98, 0.32), SILVER, M.Metal, "Gem")) -- rivet badge
	return r
end

BUILDERS.Gloves = function(k, side)
	-- a red leather boxing glove: padded knuckle roll, thumb along the side, white cuff band, laced
	-- back, round logo patch (punch face -Z)
	k.Scale *= 1.0 -- v1.0: was 1.25 (the guard pose hid the whole head behind the gloves)
	local r = sres(k, Vector3.new(0, 0.2, 0), Vector3.new(0, -0.9, -0.6), Vector3.new(0, 0.75, 0), 0.7)
	local red, redD = Color3.fromRGB(214, 30, 40), Color3.fromRGB(168, 20, 32)
	local tx = side == "Left" and 0.6 or -0.6
	egg(k, Vector3.new(1.42, 1.4, 1.6), Vector3.new(0, -0.88, -0.1), red) -- fist
	capsule(k, Vector3.new(-0.32, -0.56, -0.52), Vector3.new(0.32, -0.56, -0.52), 0.6, red) -- knuckle roll
	capsule(k, Vector3.new(tx, -0.62, -0.06), Vector3.new(tx * 0.98, -1.02, -0.5), 0.42, redD) -- thumb
	Art.CylY(k, 0.9, 0.4, Vector3.new(0, -0.3, 0.02), red) -- wrist
	Art.CylY(k, 0.94, 0.62, Vector3.new(0, 0.06, 0.02), red) -- cuff
	table.insert(r.Accents, Art.CylY(k, 0.97, 0.2, Vector3.new(0, -0.08, 0.02), WHITE, nil, "Accent")) -- cuff band
	Art.CylY(k, 0.96, 0.08, Vector3.new(0, 0.36, 0.02), INK) -- hem
	Art.Box(k, Vector3.new(0.16, 0.56, 0.04), Vector3.new(0, 0.08, 0.48), INK) -- lace slit
	for _, y in { -0.12, 0.12 } do
		capsule(k, Vector3.new(-0.15, y, 0.5), Vector3.new(0.15, y + 0.14, 0.5), 0.06, WHITE, M.Fabric)
		capsule(k, Vector3.new(0.15, y, 0.51), Vector3.new(-0.15, y + 0.14, 0.51), 0.06, WHITE, M.Fabric)
	end
	local lx = tx > 0 and -0.7 or 0.7
	Art.CylX(k, 0.56, 0.04, Vector3.new(lx, -0.88, -0.1), WHITE) -- logo patch
	table.insert(r.Gems, Art.CylX(k, 0.28, 0.06, Vector3.new(lx * 1.03, -0.88, -0.1), SILVER, M.Metal, "Gem"))
	k.Scale /= 1.25
	return r
end

BUILDERS.Slingshot = function(k)
	-- a carved wooden Y: leather-wrapped handle, tapered fork arms with tied tips, yellow rubber
	-- tubes, leather pouch with a stone
	k.Scale *= 1.25
	local r = sres(k, Vector3.new(0, -0.6, 0), Vector3.new(0, -1.75, 0), Vector3.new(0, -1.35, 0), 0.8)
	local wood, woodD = Color3.fromRGB(176, 112, 58), Color3.fromRGB(118, 72, 36)
	local leather, band = Color3.fromRGB(96, 58, 34), Color3.fromRGB(246, 186, 40)
	Art.CylY(k, 0.42, 1.25, Vector3.new(0, -0.15, 0), wood, M.Wood) -- handle
	egg(k, Vector3.new(0.5, 0.3, 0.5), Vector3.new(0, 0.48, 0), woodD, M.Wood) -- pommel
	for i = 0, 4 do
		table.insert(r.Accents, Art.CylY(k, 0.47, 0.13, Vector3.new(0, 0.3 - i * 0.17, 0), leather, M.Fabric, "Accent")) -- wrap
	end
	local fork = Vector3.new(0, -0.82, 0)
	Art.Ball(k, 0.5, fork, wood, M.Wood)
	local tips = {}
	for _, sx in { -1, 1 } do
		local mid = Vector3.new(sx * 0.38, -1.22, 0)
		local tip = Vector3.new(sx * 0.56, -1.74, 0)
		tube(k, fork, mid, 0.4, wood, M.Wood)
		Art.Ball(k, 0.4, mid, wood, M.Wood)
		tube(k, mid, tip, 0.32, wood, M.Wood)
		egg(k, Vector3.new(0.32, 0.18, 0.32), tip, wood, M.Wood) -- rounded tip
		Art.CylY(k, 0.37, 0.12, tip + Vector3.new(0, 0.14, 0), woodD, M.Fabric) -- tie
		table.insert(tips, tip + Vector3.new(0, 0.14, 0))
	end
	local pouch = Vector3.new(0, -1.62, 0.66)
	for _, tip in tips do
		capsule(k, tip, pouch + Vector3.new(tip.X * 0.3, 0, 0), 0.13, band, M.Rubber)
	end
	Art.Box(k, Vector3.new(0.46, 0.28, 0.12), pouch, leather, M.Leather) -- pouch
	table.insert(r.Gems, Art.Ball(k, 0.26, pouch + Vector3.new(0, 0, -0.1), Color3.fromRGB(120, 124, 134), M.Slate, "Gem")) -- stone
	k.Scale /= 1.25
	return r
end

BUILDERS.Bat = function(k)
	-- a lathe-turned ash slugger: flared knob, black grip tape wound up the handle, smooth taper
	-- into the barrel, domed end, black brand oval
	k.Scale *= 1.2
	local r = sres(k, Vector3.new(0, -1.0, 0), Vector3.new(0, -3.4, 0), Vector3.new(0, -2.9, 0), 0.65)
	local wood = Color3.fromRGB(226, 184, 118)
	egg(k, Vector3.new(0.66, 0.24, 0.66), Vector3.new(0, 0.62, 0), wood, M.Wood) -- knob
	Art.CylY(k, 0.38, 1.6, Vector3.new(0, -0.1, 0), wood, M.Wood) -- handle
	for i = 0, 5 do
		local tilt = CFrame.Angles(math.rad(9), 0, 0)
		table.insert(r.Accents, Art.CylY(k, 0.43, 0.17, Vector3.new(0, 0.47 - i * 0.19, 0), INK, M.Fabric, "Accent", tilt)) -- grip tape
	end
	egg(k, Vector3.new(0.86, 2.6, 0.86), Vector3.new(0, -2.05, 0), wood, M.Wood) -- taper
	Art.CylY(k, 0.86, 1.2, Vector3.new(0, -2.75, 0), wood, M.Wood) -- barrel
	egg(k, Vector3.new(0.86, 0.3, 0.86), Vector3.new(0, -3.35, 0), wood, M.Wood) -- domed end
	egg(k, Vector3.new(0.34, 0.62, 0.06), Vector3.new(0, -2.6, -0.42), INK) -- brand oval
	table.insert(r.Gems, Art.CylZ(k, 0.2, 0.05, Vector3.new(0, -2.6, -0.45), SILVER, M.Metal, "Gem"))
	k.Scale /= 1.2
	return r
end

BUILDERS.Pan = function(k)
	-- a cast-iron skillet: flat base, flared walls, rolled rim, riveted iron neck and a red silicone
	-- handle sleeve with a hang hole (cooking side faces -Z)
	k.Scale *= 1.15
	local r = sres(k, Vector3.new(0, -1.2, 0), Vector3.new(0, -3.8, 0), Vector3.new(0, -2.6, 0), 1.45)
	local iron, floor = Color3.fromRGB(58, 60, 70), Color3.fromRGB(88, 92, 104)
	local sleeve = Color3.fromRGB(214, 44, 40)
	Art.Box(k, Vector3.new(0.42, 1.3, 0.3), Vector3.new(0, -0.05, 0), sleeve, M.Rubber) -- handle sleeve
	Art.CylZ(k, 0.2, 0.32, Vector3.new(0, 0.42, 0), Color3.fromRGB(16, 14, 22)) -- hang hole
	table.insert(r.Gems, Art.CylZ(k, 0.18, 0.04, Vector3.new(0, -0.2, -0.16), SILVER, M.Metal, "Gem"))
	Art.Box(k, Vector3.new(0.28, 0.75, 0.16), Vector3.new(0, -1.0, -0.02), iron, M.Metal) -- iron neck
	local pc = Vector3.new(0, -2.6, 0)
	Art.Box(k, Vector3.new(0.5, 0.36, 0.2), Vector3.new(0, -1.42, -0.02), iron, M.Metal) -- rivet plate
	for _, sx in { -1, 1 } do
		Art.Ball(k, 0.12, Vector3.new(sx * 0.14, -1.42, -0.12), SILVER, M.Metal) -- rivets
	end
	Art.CylZ(k, 2.2, 0.14, pc + Vector3.new(0, 0, 0.04), iron, M.Metal) -- base
	Art.CylZ(k, 2.06, 0.04, pc + Vector3.new(0, 0, -0.04), floor, M.Metal) -- cooking floor
	local n = 16
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		local radial = Vector3.new(math.cos(a), math.sin(a), 0)
		local tangent = Vector3.new(-math.sin(a), math.cos(a), 0)
		local wall = (radial * 0.22 + Vector3.new(0, 0, -0.36)).Unit
		local pos = pc + radial * 1.17 + Vector3.new(0, 0, -0.12)
		local w = Art.Part(k, Vector3.new(2 * math.pi * 1.2 / n + 0.06, 0.44, 0.1), CFrame.fromMatrix(pos, tangent, wall), iron, M.Metal, nil, "Wall")
		w:SetAttribute("Softened", true)
	end
	local rimR = 1.3
	local rim = {}
	for i = 0, 23 do
		local a0, a1 = i / 24 * math.pi * 2, (i + 1) / 24 * math.pi * 2
		local p0 = pc + Vector3.new(math.cos(a0) * rimR, math.sin(a0) * rimR, -0.32)
		local p1 = pc + Vector3.new(math.cos(a1) * rimR, math.sin(a1) * rimR, -0.32)
		local d = p1 - p0
		table.insert(rim, tube(k, p0 - d * 0.05, p1 + d * 0.05, 0.13, iron, M.Metal, "Accent"))
	end
	addAll(r.Accents, rim)
	k.Scale /= 1.15
	return r
end

BUILDERS.Magnet = function(k)
	-- the Mythic ELECTROMAGNET: a square-section horseshoe, RED half pulls, BLUE half pushes,
	-- copper coil wound over the bend, silver pole pieces, rubber grip on a steel bracket
	k.Scale *= 1.2
	local r = sres(k, Vector3.new(0, -0.6, 0), Vector3.new(0, -2.35, 0), Vector3.new(0, -1.3, 0), 1.0)
	local red, blue = Color3.fromRGB(222, 36, 44), Color3.fromRGB(36, 96, 230)
	local copper = Color3.fromRGB(204, 112, 52)
	Art.CylY(k, 0.44, 0.8, Vector3.new(0, 0.05, 0), RUBBER, M.Rubber) -- grip
	for _, y in { -0.2, 0.05, 0.3 } do
		Art.CylY(k, 0.48, 0.06, Vector3.new(0, y, 0), INK, M.Rubber) -- grip rings
	end
	egg(k, Vector3.new(0.5, 0.24, 0.5), Vector3.new(0, 0.46, 0), SILVER, M.Metal) -- end cap
	Art.Box(k, Vector3.new(0.72, 0.26, 0.5), Vector3.new(0, -0.4, 0), SILVER, M.Metal) -- bracket
	table.insert(r.Gems, Art.CylZ(k, 0.2, 0.05, Vector3.new(0, -0.4, -0.26), SILVER, M.Metal, "Gem"))
	local cy, rad, th = -1.12, 0.62, 0.5
	local n = 12
	for i = 0, n - 1 do
		local tm = (i + 0.5) / n * math.pi
		local radial = Vector3.new(math.cos(tm), math.sin(tm), 0)
		local tangent = Vector3.new(-math.sin(tm), math.cos(tm), 0)
		local seg = Art.Part(k, Vector3.new(th, 2 * math.pi * rad / (2 * n) * 1.15, th), CFrame.fromMatrix(Vector3.new(0, cy, 0) + radial * rad, radial, tangent),
			tm > math.pi / 2 and red or blue, nil, nil, "Arc")
		seg:SetAttribute("Softened", true)
	end
	for i = 0, 6 do
		local tm = math.rad(62 + i * 9.3)
		local radial = Vector3.new(math.cos(tm), math.sin(tm), 0)
		local tangent = Vector3.new(-math.sin(tm), math.cos(tm), 0)
		table.insert(r.Accents, Art.Part(k, Vector3.new(0.07, 0.76, 0.76), CFrame.fromMatrix(Vector3.new(0, cy, 0) + radial * rad, tangent, radial),
			copper, M.Metal, Enum.PartType.Cylinder, "Accent")) -- coil windings
	end
	for _, sx in { -1, 1 } do
		local col = sx < 0 and red or blue
		local leg = Art.Box(k, Vector3.new(th, 0.78, th), Vector3.new(sx * rad, cy - 0.39, 0), col)
		leg:SetAttribute("Softened", true)
		Art.Box(k, Vector3.new(th + 0.04, 0.05, th + 0.04), Vector3.new(sx * rad, cy - 0.8, 0), INK) -- seam
		Art.Box(k, Vector3.new(th + 0.02, 0.36, th + 0.02), Vector3.new(sx * rad, cy - 1.0, 0), SILVER, M.Metal) -- pole piece
	end
	k.Scale /= 1.2
	return r
end

BUILDERS.BombBag = function(k)
	-- a classic iron bomb: riveted steel band, bolted filler cap, rope fuse with a live spark
	k.Scale *= 1.05 -- v1.0: was 1.25 (the bomb was bigger than the head and covered the face)
	local r = sres(k, Vector3.new(0, -0.3, 0), Vector3.new(0, -0.7, -1.15), Vector3.new(0, -0.7, 0), 0.85)
	local bomb = Vector3.new(0, -0.74, -0.1)
	local steel = Color3.fromRGB(96, 100, 112)
	Art.Ball(k, 1.3, bomb, Color3.fromRGB(38, 40, 56), M.Metal)
	table.insert(r.Accents, Art.CylY(k, 1.34, 0.18, bomb + Vector3.new(0, -0.06, 0), steel, M.Metal, "Accent")) -- band
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + math.pi / 10
		Art.Ball(k, 0.1, bomb + Vector3.new(math.cos(a) * 0.68, -0.06, math.sin(a) * 0.68), SILVER, M.Metal) -- rivets
	end
	Art.CylY(k, 0.56, 0.24, bomb + Vector3.new(0, 0.64, 0), steel, M.Metal) -- cap
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Art.Ball(k, 0.1, bomb + Vector3.new(math.cos(a) * 0.25, 0.77, math.sin(a) * 0.25), SILVER, M.Metal) -- bolts
	end
	Art.CylY(k, 0.18, 0.12, bomb + Vector3.new(0, 0.82, 0), INK, M.Metal) -- fuse holder
	local f0 = bomb + Vector3.new(0, 0.86, 0)
	local f1 = bomb + Vector3.new(0.06, 1.06, -0.08)
	local f2 = bomb + Vector3.new(0.2, 1.18, -0.22)
	local rope = Color3.fromRGB(226, 200, 146)
	capsule(k, f0, f1, 0.1, rope, M.Fabric)
	capsule(k, f1, f2, 0.1, rope, M.Fabric)
	local spark = Art.Ball(k, 0.22, f2 + Vector3.new(0.02, 0.06, -0.02), Color3.fromRGB(255, 236, 160), M.Neon)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(0.15, 0.3)
	pe.Speed = NumberRange.new(2, 4)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Size = NumberSequence.new(0.14, 0)
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120))
	pe.LightEmission = 1
	pe.Parent = spark
	table.insert(r.Gems, Art.CylZ(k, 0.24, 0.05, bomb + Vector3.new(0, -0.06, -0.68), SILVER, M.Metal, "Gem"))
	k.Scale /= 1.25
	return r
end

BUILDERS.Hammer = function(k)
	-- the Epic SQUEAKY HAMMER: a big red accordion-pleated head with yellow end caps on a yellow
	-- handle with a red rubber grip
	k.Scale *= 1.15
	local r = sres(k, Vector3.new(0, -1.2, 0), Vector3.new(0, -2.7, -1.05), Vector3.new(0, -2.7, 0), 1.2)
	local red, redD = Color3.fromRGB(226, 38, 48), Color3.fromRGB(176, 24, 38)
	Art.CylY(k, 0.34, 2.6, Vector3.new(0, -0.85, 0), YELLOW) -- handle
	table.insert(r.Accents, Art.CylY(k, 0.42, 0.9, Vector3.new(0, 0.1, 0), red, M.Rubber, "Accent")) -- grip
	egg(k, Vector3.new(0.46, 0.22, 0.46), Vector3.new(0, 0.56, 0), red, M.Rubber) -- grip end
	Art.CylY(k, 0.5, 0.2, Vector3.new(0, -2.0, 0), YELLOW) -- collar
	local hc = Vector3.new(0, -2.7, 0)
	for i = 0, 6 do
		local z = -0.6 + i * 0.2
		Art.CylZ(k, i % 2 == 0 and 1.24 or 1.04, 0.21, hc + Vector3.new(0, 0, z), i % 2 == 0 and red or redD) -- pleats
	end
