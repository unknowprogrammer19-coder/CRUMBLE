------------------------------------------------------------------------
-- Dynamic pieces
------------------------------------------------------------------------
local bannerToken = 0
local BANNER_COLORS = {
	start = Col.Gold,
	ko = Col.Lava,
	parry = Color3.fromRGB(255, 230, 120),
	phase = Col.Amber,
	win = Col.Gold,
	warn = Col.Lava,
}

-- v0.9.12 quieter Foreman: minor "phase" lines are skipped if another line showed in the last
-- few seconds; start / win / warn (gameplay warnings) always show. Smaller banner, shorter hold.
local lastBannerAt = -100
local BANNER_GAP = 5
local function showBanner(text: string, style: string?)
	local nowC = os.clock()
	local important = style == "start" or style == "win" or style == "warn"
	if not important and nowC - lastBannerAt < BANNER_GAP then
		return
	end
	lastBannerAt = nowC
	bannerToken += 1
	local mine = bannerToken
	local b = refs.Banner :: TextLabel
	b.Text = text
	b.TextColor3 = BANNER_COLORS[style or ""] or Col.Gold
	b.TextTransparency = 0
	b.TextStrokeTransparency = 0
	b.Size = UDim2.fromOffset(720, 60)
	TweenService:Create(b, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(620, 52) }):Play()
	local tag = refs.ForemanTag :: TextLabel
	tag.TextTransparency = 0
	tag.TextStrokeTransparency = 0.3
	EffectsController.Babble(text)
	local hold = math.clamp(0.9 + #text * 0.03, 1.3, 2.2)
	task.delay(hold, function()
		if mine == bannerToken then
			TweenService:Create(b, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			TweenService:Create(tag, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

local toastToken = 0
local function showToast(text: string, color: Color3?)
	toastToken += 1
	local mine = toastToken
	local t = refs.Toast :: TextLabel
	t.Text = text
	t.TextColor3 = color or Col.Good
	t.TextTransparency = 0
	t.BackgroundTransparency = 0.12
	t.Visible = true
	task.delay(3.4, function()
		if mine == toastToken then
			local tw = TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			if mine == toastToken then
				t.Visible = false -- frees its slot in the stack
			end
		end
	end)
end

local feedOrder = 0
local function addKillFeed(d: { [string]: any })
	feedOrder += 1
	local victimColor = d.VictimBot and Col.Mute or Col.Text
	local text
	if d.Killer then
		local killerColor = d.KillerBot and Col.Mute or Col.Gold
		local wcol = Rarity.Colors[d.Rarity or "Common"] or Col.Text
		text = string.format(
			'<font color="%s">%s</font>  <font color="%s">[%s]</font>  ›  <font color="%s">%s</font>',
			hex(killerColor), d.Killer, hex(wcol), d.Weapon or "?", hex(victimColor), d.Victim
		)
	elseif d.Reason == "left" then
		text = string.format('<font color="%s">%s</font> left the arena', hex(victimColor), d.Victim)
	else
		text = string.format('<font color="%s">%s</font> <font color="%s">fell</font>', hex(victimColor), d.Victim, hex(Col.Amber))
	end
	local row = UI.new("Frame", {
		Parent = refs.KillFeed,
		LayoutOrder = -feedOrder,
		Size = UDim2.fromOffset(330, 28),
		BackgroundColor3 = Col.Panel,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	})
	UI.corner(6).Parent = row
	UI.label({ Parent = row, Size = UDim2.new(1, -14, 1, -8), Position = UDim2.fromOffset(7, 4), RichText = true, TextXAlignment = Enum.TextXAlignment.Right, Text = text })
	local rows = {}
	for _, c in (refs.KillFeed :: Frame):GetChildren() do
		if c:IsA("Frame") then
			table.insert(rows, c)
		end
	end
	if #rows > 6 then
		table.sort(rows, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		rows[#rows]:Destroy()
	end
	task.delay(7, function()
		if row.Parent then
			row:Destroy()
		end
	end)
end

------------------------------------------------------------------------
-- Spectate
------------------------------------------------------------------------
local function spectateTargets(): { Model }
	local list = {}
	for _, p in Players:GetPlayers() do
		local c = p.Character
		if c and p ~= player and c:GetAttribute("InRound") and c:GetAttribute("Alive") then
			table.insert(list, c)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, m in bots:GetChildren() do
			if m:IsA("Model") and m:GetAttribute("InRound") and m:GetAttribute("Alive") then
				table.insert(list, m)
			end
		end
	end
	return list
end

local function stopSpectate()
	spectating = false
	refs.SpecLabel.Visible = false
	local cam = workspace.CurrentCamera
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if cam and hum then
		cam.CameraSubject = hum
	end
end

local function cycleSpectate(step: number)
	local list = spectateTargets()
	if #list == 0 then
		stopSpectate()
		return
	end
	spectating = true
	spectateIndex = ((spectateIndex - 1 + step) % #list) + 1
end

------------------------------------------------------------------------
-- Results
------------------------------------------------------------------------
local function clearChildren(frame: Instance, keepClass: string)
	for _, c in frame:GetChildren() do
		if not c:IsA(keepClass) and not c:IsA("UIPadding") and not c:IsA("UICorner") then
			c:Destroy()
		end
	end
end

local function rewardLine(parent: Instance, order: number, left: string, right: string, color: Color3?)
	local row = UI.new("Frame", { Parent = parent, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, ZIndex = 12 })
	UI.label({ Parent = row, Size = UDim2.new(0.62, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color or Col.Text, Text = left, ZIndex = 12 })
	UI.label({ Parent = row, Position = UDim2.fromScale(0.62, 0), Size = UDim2.new(0.38, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = color or Col.Text, Text = right, ZIndex = 12 })
end

local function showResults(d: { [string]: any })
	local r = refs.Results :: Frame
	local you = d.You
	local title, color = "ROUND OVER", Col.Gold
	if you then
		if you.Timeout then
			title, color = "SURVIVED!", Col.Good
		elseif you.Placement == 1 and d.Reason == "win" then
			title, color = "YOU WON!", Col.Gold
			EffectsController.Play("Victory", 0.8, 1)
		else
			title, color = string.upper(UI.ordinal(you.Placement or 12)) .. " PLACE", Col.Text
		end
	end
	refs.ResTitle.Text = title
	refs.ResTitle.TextColor3 = color
	if d.Reason == "timeout" then
		refs.ResSub.Text = "TIME'S UP! SURVIVORS WIN"
	elseif d.Reason == "bots" then
		refs.ResSub.Text = "The League Drones win this one."
	elseif d.Winner then
		refs.ResSub.Text = "Last one standing: " .. d.Winner
	else
		refs.ResSub.Text = ""
	end

	clearChildren(refs.ResList, "UIListLayout")
	for i, s in d.Standings or {} do
		local row = UI.new("Frame", {
			Parent = refs.ResList,
			LayoutOrder = i,
			Size = UDim2.new(1, -4, 0, 24),
			BackgroundColor3 = (s.Placement == 1) and Color3.fromRGB(255, 238, 196) or Col.Panel,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			ZIndex = 12,
		})
		UI.corner(5).Parent = row
		local place = s.Placement <= 12 and ("#" .. s.Placement) or "-"
		local name = (s.IsBot and "[BOT] " or "") .. s.Name
		UI.label({ Parent = row, Position = UDim2.fromOffset(6, 3), Size = UDim2.fromOffset(34, 18), Font = Enum.Font.GothamBlack, TextColor3 = s.Placement == 1 and Col.Gold or Col.Mute, Text = place, ZIndex = 13 })
		UI.label({ Parent = row, Position = UDim2.fromOffset(42, 3), Size = UDim2.fromOffset(150, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = s.IsBot and Col.Mute or Col.Text, Text = name, ZIndex = 13 })
		UI.label({ Parent = row, Position = UDim2.fromOffset(196, 3), Size = UDim2.fromOffset(100, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Rarity.Colors[s.Rarity] or Col.Text, Text = string.format("%s L%d", s.Weapon, s.Level or 1), ZIndex = 13 })
		UI.label({ Parent = row, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 3), Size = UDim2.fromOffset(52, 18), TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(s.Score), ZIndex = 13 })
	end

	clearChildren(refs.ResRewards, "UIListLayout")
	local rw = d.Reward
	if you and rw then
		local b = rw.CoinBreakdown or {}
		rewardLine(refs.ResRewards, 1, "COINS", "+" .. rw.Coins, Col.Gold)
		local order = 2
		for _, key in { "Survival", "Placement", "Timeout", "PlayerKOs", "BotKOs" } do
			if b[key] and b[key] > 0 then
				rewardLine(refs.ResRewards, order, "  " .. key, "+" .. b[key], Col.Mute)
				order += 1
			end
		end
		if rw.FirstWinBonus and rw.FirstWinBonus > 0 then
			rewardLine(refs.ResRewards, order, "FIRST WIN TODAY", "+" .. rw.FirstWinBonus, Col.Good)
			order += 1
		end
		rewardLine(refs.ResRewards, order + 1, "XP", "+" .. rw.XP, Col.Lava)
		if rw.LevelUps and rw.LevelUps > 0 then
			rewardLine(refs.ResRewards, order + 2, "LEVEL UP!", "+" .. rw.LevelUps, Col.Good)
		end
		rewardLine(refs.ResRewards, order + 3, "MATCH SCORE", tostring(rw.Score), Col.Text)
		rewardLine(refs.ResRewards, order + 4, "Player KOs", tostring(you.KOs), Col.Mute)
		rewardLine(refs.ResRewards, order + 5, "Bot KOs", tostring(you.BotKOs), Col.Mute)
		rewardLine(refs.ResRewards, order + 6, "Assists", tostring(you.Assists), Col.Mute)
		rewardLine(refs.ResRewards, order + 7, "Time alive", UI.formatTime(you.SecondsAlive), Col.Mute)
		rewardLine(refs.ResRewards, order + 8, "Coin cap / round", tostring(Config.Rewards.RoundCap), Col.Mute)
	else
		rewardLine(refs.ResRewards, 1, "You watched this round.", "", Col.Mute)
		rewardLine(refs.ResRewards, 2, "Join the next one!", "", Col.Mute)
	end
	r.Visible = true
end

------------------------------------------------------------------------
-- Per-frame update
------------------------------------------------------------------------
-- v0.7.2 hint pill: server message first; otherwise a rotating lobby tip (Help Tips toggle)
local LOBBY_TIPS = {
	"SPIN VAULT = new weapons",
	"FORGE = merge to level up",
	"RANGE = test your hits",
	"HOLD E block · TAP E parry",
	"Amber cracks · red drops",
}
local function setHint(text: string, lobby: boolean)
	if text == "" and lobby and Players.LocalPlayer:GetAttribute("HelpTips") ~= false and not Layout.StackBusy() then
		-- (rotating tips step aside while the tutorial / join pill / spectate line are up)
		text = LOBBY_TIPS[(math.floor(os.clock() / 8) % #LOBBY_TIPS) + 1]
	end
	if refs.Message.Text ~= text then
		refs.Message.Text = text
	end
	refs.HintPill.Visible = text ~= ""
end

local function myChar(): Model?
	return player.Character
end

local function onRender()
	local state = ReplicatedStorage:GetAttribute("State") or "Waiting"
	local endsAt = ReplicatedStorage:GetAttribute("EndsAt") or 0
	local remaining = endsAt - now()
	local alive = ReplicatedStorage:GetAttribute("Alive") or 0
	local total = ReplicatedStorage:GetAttribute("Total") or 0
	local phase = ReplicatedStorage:GetAttribute("Phase") or ""
	local message = ReplicatedStorage:GetAttribute("Message") or ""

	-- top bar
	refs.Timer.TextColor3 = Col.Text
	if state == "Live" then
		refs.Phase.Text = string.upper(phase)
		refs.Timer.Text = UI.formatTime(remaining)
		if remaining < 30 then
			refs.Timer.TextColor3 = Col.Bad
		end
		refs.Alive.Text = string.format("%d / %d", alive, total)
		refs.AliveSub.Text = "STILL STANDING"
		setHint("", false)
		-- shrink countdown
		local shrinkAt = ReplicatedStorage:GetAttribute("ShrinkAt") or 0
		if shrinkAt > 0 then
			local left = shrinkAt - now()
			refs.Map.Text = left > 0 and ("EDGE FALLS " .. UI.formatTime(left)) or "EDGE FALLING!"
			refs.Map.TextColor3 = left < 4 and Col.Bad or Col.Mute
		else
			refs.Map.Text = "FINAL CORE"
			refs.Map.TextColor3 = Col.Bad
		end
	elseif state == "Countdown" then
		refs.Phase.Text = "GET READY"
		refs.Timer.Text = "0:00"
		refs.Alive.Text = string.format("%d / %d", total, total)
		refs.AliveSub.Text = "PLAYERS"
		setHint("", false)
	else
		refs.Phase.Text = string.upper(state)
		refs.Timer.Text = endsAt > 0 and UI.formatTime(remaining) or "--:--"
		refs.Alive.Text = tostring(#Players:GetPlayers())
		refs.AliveSub.Text = "IN SERVER"
		setHint(message, true)
	end

	if state ~= "Live" then
		-- v0.8: show what's coming up (mode · map), or the map being played during the countdown
		local mapName = ReplicatedStorage:GetAttribute("MapName") or "CLASSIC"
		if state == "Countdown" then
			local modeName = ReplicatedStorage:GetAttribute("ModeName") or "CLASSIC"
			refs.Map.Text = string.upper(modeName .. " · " .. mapName)
		elseif state == "Joining" and ReplicatedStorage:GetAttribute("VoteOpen") == true then
			-- v0.8.1: live vote leader
			local leader, best = nil, 0
			for _, id in Config.Vote.Maps do
				local n = (ReplicatedStorage:GetAttribute("Votes_" .. id) :: number?) or 0
				if n > best then
					leader, best = id, n
				end
			end
			refs.Map.Text = if leader then string.upper("VOTE LEAD: " .. Config.Maps[leader].Name) else "VOTE THE MAP!"
		else
			local nm = ReplicatedStorage:GetAttribute("NextMapName")
			local nmode = ReplicatedStorage:GetAttribute("NextModeName")
			refs.Map.Text = if nm then string.upper("NEXT: " .. tostring(nmode or "CLASSIC") .. " · " .. tostring(nm)) else string.upper(mapName)
		end
		refs.Map.TextColor3 = Col.Mute
	end

	-- countdown numbers
	local cd = refs.Countdown :: TextLabel
	if state == "Countdown" then
		local n = math.ceil(remaining - 1)
		cd.Visible = true
		if n >= 1 then
			cd.Text = tostring(n)
			cd.TextColor3 = Col.Text
		else
			cd.Text = "GO!"
			cd.TextColor3 = Col.Gold
		end
		if n ~= lastCountdown then
			lastCountdown = n
			EffectsController.Play("Tick", 0.6, n >= 1 and 1 or 1.5)
		end
	else
		cd.Visible = false
		lastCountdown = -1
	end

	-- action bar / equipped line
	local char = myChar()
	local inRound = char ~= nil and char:GetAttribute("InRound") == true and char:GetAttribute("Alive") == true
	-- v0.9.2: the fight bar (shove / rush / shield) also shows in the Training Range
	local inRange = char ~= nil and char:GetAttribute("InRange") == true
	refs.ActionBar.Visible = (inRound and (state == "Live" or state == "Countdown")) or inRange
	refs.Equipped.Visible = not refs.ActionBar.Visible and not refs.FellCard.Visible and refs.Equipped.Text ~= ""
	if refs.ControlsHint then
		-- the action bar already shows the keys; the free line only shows on wide screens
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		refs.ControlsHint.Visible = not Layout.IsTouch() and not refs.ActionBar.Visible and vp.X >= 1150 and not refs.Results.Visible
	end
	if char then
		local def = Weapons.Get(char:GetAttribute("WeaponId") :: string?)
		local level = (char:GetAttribute("WeaponLevel") :: number?) or 1
		local rc = Rarity.Colors[def.Rarity]
		refs.WeaponName.Text = string.upper(def.Name)
		refs.WeaponName.TextColor3 = rc
		refs.WeaponStripe.BackgroundColor3 = rc
		refs.WeaponInfo.Text = string.format("%s · L%d", def.Rarity, level)
		refs.PWR.Text = "PWR " .. Rarity.PWR(def.Rarity, level)
		refs.Equipped.Text = string.format(
			'EQUIPPED: <font color="%s"><b>%s</b></font>  %s L%d  ·  PWR %d  ·  %s',
			hex(rc), def.Name, def.Rarity, level, Rarity.PWR(def.Rarity, level), Descriptions.Weapon(def.Id).Tag
		)
		-- v0.9.17: in RUMBLE every new weapon (round start or a weapon box) gets the reveal card
		local key = def.Id .. "|" .. tostring(char)
		local rumble = ReplicatedStorage:GetAttribute("Mode") == "Rumble" and char:GetAttribute("InRound") == true
			and (state == "Live" or state == "Countdown")
		if not rumble then
			refs.LastWeaponKey = nil -- the next Rumble round reveals again, even the same weapon
		elseif key ~= refs.LastWeaponKey then
			local fromBox = refs.LastWeaponKey ~= nil and state == "Live"
			refs.LastWeaponKey = key
			showWeaponReveal(def.Id, level, fromBox)
		end
		if refs.Reveal and refs.Reveal.Card.Visible and (now() > refs.Reveal.Until or not rumble) then
			refs.Reveal.Card.Visible = false
		end

		local t = now()
		-- v0.9.18 Magnet push-pull: "REPEL!" while the 2nd click is armed, then the cycle cooldown
		local follow = InputController.Follow
		local armed = t < follow.RepelUntil
		local readyAt = InputController.ShoveReadyAt
		if not armed and t < follow.CycleAt then
			readyAt = math.max(readyAt, follow.CycleAt)
		end
		local shoveLeft = readyAt - t
		local shoveFrac = (shoveLeft > 0 and not armed) and (1 - shoveLeft / math.max(InputController.ShoveDuration, 0.01)) or 1
		refs.ShoveFill.Size = UDim2.fromScale(math.clamp(shoveFrac, 0, 1), 1)
		refs.ShoveFill.BackgroundColor3 = armed and Color3.fromRGB(56, 140, 255) or Col.Lava
		if armed then
			refs.ShoveLabel.Text = string.format("REPEL!  %.1fs", follow.RepelUntil - t)
		else
			refs.ShoveLabel.Text = shoveLeft > 0 and string.format("SHOVE  %.1fs", shoveLeft) or "SHOVE" -- v0.9.12: no READY shout
		end
		local rushLeft = InputController.RushReadyAt - t
		local rushFrac = rushLeft > 0 and (1 - rushLeft / Config.Combat.RushCooldown) or 1
		refs.RushFill.Size = UDim2.fromScale(math.clamp(rushFrac, 0, 1), 1)
		refs.RushLabel.Text = rushLeft > 0 and string.format("RUSH  %.1fs", rushLeft) or "RUSH"
		local guard = (char:GetAttribute("Guard") :: number?) or 100
		refs.GuardFill.Size = UDim2.fromScale(math.clamp(guard / 100, 0, 1), 1)
		local recharging = guard < Config.Combat.MinBlockGuard
		refs.GuardFill.BackgroundColor3 = recharging and Col.Bad or (guard < 40 and Col.Amber or Col.Ice)
		if char:GetAttribute("Blocking") then
			refs.GuardLabel.Text = "SHIELD UP  " .. math.floor(guard)
		elseif recharging then
			refs.GuardLabel.Text = "SHIELD RECHARGING  " .. math.floor(guard)
		else
			refs.GuardLabel.Text = "SHIELD  " .. math.floor(guard)
		end
	end


	-- spectate camera enforcement
	if spectating then
		local list = spectateTargets()
		if #list == 0 or (state ~= "Live") then
			stopSpectate()
		else
			spectateIndex = math.clamp(spectateIndex, 1, #list)
			local target = list[spectateIndex]
			local hum = target:FindFirstChildOfClass("Humanoid")
			local cam = workspace.CurrentCamera
			if hum and cam and cam.CameraSubject ~= hum then
				cam.CameraSubject = hum
			end
			refs.SpecLabel.Visible = true
			refs.SpecLabel.Text = "SPECTATING: " .. ((target:GetAttribute("DisplayName") :: string?) or target.Name)
		end
	end

	if state ~= "Live" and state ~= "Countdown" then
		refs.FellCard.Visible = false
	end
end

------------------------------------------------------------------------
-- Character / fell detection
------------------------------------------------------------------------
local function watchCharacter(char: Model)
	char:GetAttributeChangedSignal("Alive"):Connect(function()
		local placement = char:GetAttribute("Placement") :: number?
		if char:GetAttribute("Alive") == false and placement and ReplicatedStorage:GetAttribute("State") == "Live" then
			local total = ReplicatedStorage:GetAttribute("Total") or 12
			refs.FellTitle.Text = "YOU FELL"
			refs.FellSub.Text = string.format("%s of %d", UI.ordinal(placement), total)
			refs.FellCard.Visible = true
			EffectsController.Play("Fall", 0.7)
			EffectsController.Shake(0.6)
		end
	end)
end

------------------------------------------------------------------------
-- Init
------------------------------------------------------------------------
function HUDController.Init()
	gui = Instance.new("ScreenGui")
	gui.Name = "CrumbleHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	buildTopBar()
	buildProfile()
	buildActionBar()
	buildKillFeed()
	buildBanner()
	buildFellCard()
	buildResults()
	buildHint()
	UI.Skin(gui) -- v0.7.1 rounded "Bubbly Brawler" style
	task.defer(function()
		-- v0.9.3 layout pass: scaled blocks + the shared top stack / right column (no more overlaps)
		Layout.Fit(refs.TopBar, function()
			return UDim2.new(0.5, 0, 0, 10)
		end)
		Layout.Fit(refs.LeftStack, function()
			return UDim2.fromOffset(12, Layout.TOP_INSET)
		end)
		local function bottomCentre(lift: number): (number, Vector2) -> UDim2
			return function(sc: number, vp: Vector2): UDim2
				if Layout.IsTouch() then
					-- keep clear of the thumb buttons (bottom-right)
					-- between the move stick (left 40%) and the jump/fight buttons (right)
					return UDim2.new(0, math.max((vp.X * 0.4 + vp.X - Layout.TouchCluster(vp)) / 2, 120 * sc), 1, -lift)
				end
				return UDim2.new(0.5, 0, 1, -lift)
			end
		end
		Layout.Fit(refs.ActionBar, bottomCentre(14))
		Layout.Fit(refs.Equipped, bottomCentre(16))
		if refs.ControlsHint then
			Layout.Fit(refs.ControlsHint, function()
				return UDim2.new(0, 12, 1, -12)
			end)
		end
		Layout.Fit(refs.Banner)
		Layout.Fit(refs.ForemanTag)
		Layout.Fit(refs.Countdown)
		Layout.Fit(refs.FellCard)
		Layout.Fit(refs.Results)
		Layout.AddToStack(refs.SpecLabel, 40, 380)
		Layout.AddToStack(refs.HintPill, 50, 560)
		-- the hint line fills the pill and scales its text down instead of overflowing
		refs.Message.AutomaticSize = Enum.AutomaticSize.None
		refs.Message.Size = UDim2.new(1, -64, 0, 24) -- pill padding 6+18, icon 28, gap 10
		refs.Message.TextScaled = true
		Layout.AddToStack(refs.Toast, 60, 560)
		Layout.AddToStack(refs.Reveal.Card, 55, 440)
		refs.Toast.TextWrapped = true
		refs.Toast.AutomaticSize = Enum.AutomaticSize.Y -- long toasts wrap onto a 2nd line
		Layout.AddToRight(refs.KillFeed, 30)
	end)

	refs.SpecBtn.Activated:Connect(function()
		cycleSpectate(0)
	end)
	refs.SpecNext.Activated:Connect(function()
		cycleSpectate(1)
	end)
	refs.SpecPrev.Activated:Connect(function()
		cycleSpectate(-1)
	end)
	refs.SpecBack.Activated:Connect(function()
		stopSpectate()
		refs.FellCard.Visible = false
	end)

	Net.Get("Announce").OnClientEvent:Connect(showBanner)
	-- v0.8.1 hazard hints for your own character
	local function watchHazards(char: Model)
		char:GetAttributeChangedSignal("InMagma"):Connect(function()
			if char:GetAttribute("InMagma") == true then
				showToast("MAGMA! RUSH TO POP OUT", Col.Bad)
				EffectsController.Play("Bubble", 0.6, 0.5)
			end
		end)
		char:GetAttributeChangedSignal("Iced"):Connect(function()
			if char:GetAttribute("Iced") == true then
				showToast("FROZEN!", Color3.fromRGB(120, 200, 255))
			end
		end)
	end
	if player.Character then
		watchHazards(player.Character)
	end
	player.CharacterAdded:Connect(watchHazards)
	-- V: Foreman voice 100% → 50% → off
	UserInputService.InputBegan:Connect(function(input: InputObject, gpe: boolean)
		if gpe or input.KeyCode ~= Enum.KeyCode.V then
			return
		end
		local cur = player:GetAttribute("ForemanVolume")
		local v = if type(cur) == "number" then cur else 1
		local nextV = if v >= 1 then 0.5 elseif v > 0 then 0 else 1
		player:SetAttribute("ForemanVolume", nextV)
		showToast(nextV == 0 and "Foreman voice: OFF (V)" or string.format("Foreman voice: %d%% (V)", nextV * 100), Col.Mute)
	end)
	Net.Get("KillFeed").OnClientEvent:Connect(addKillFeed)
	Net.Get("RoundResults").OnClientEvent:Connect(function(d)
		stopSpectate()
		refs.FellCard.Visible = false
		showResults(d)
	end)
	Net.Get("Toast").OnClientEvent:Connect(function(text)
		showToast(text)
		EffectsController.Play("Win", 0.5, 1.5)
	end)
	Net.Get("Profile").OnClientEvent:Connect(function(p)
		_profile = p
		refs.Level.Text = "LV " .. p.Level
		refs.Coins.Text = UI.comma(p.Coins)
		refs.XPFill.Size = UDim2.fromScale(math.clamp(p.XP / math.max(p.XPNeeded, 1), 0, 1), 1)
		refs.XPLabel.Text = string.format("%s / %s XP", UI.comma(p.XP), UI.comma(p.XPNeeded))
		if p.Saving == false then
			refs.Coins.Text ..= " !"
		end
	end)

	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		local s = ReplicatedStorage:GetAttribute("State")
		if s == "Intermission" or s == "Countdown" or s == "Joining" then
			refs.Results.Visible = false
		end
	end)

	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	RunService.RenderStepped:Connect(onRender)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — InputController
	PC:      Shove = Left Click / F · Rush = Shift / Q · Block = hold E
	Mobile:  big on-screen SHOVE / RUSH / BLOCK buttons
	Console: Shove = RT · Rush = LB · Block = LT
	Sends intent only; the server decides what happens. Local cooldowns drive the HUD.

	v0.9.2 LOCKED AIM is the only aim system: every hit (Shove / Block / Rush) goes the way your
	character is FACING (turn by walking). A yellow chevron on the ground shows that direction.
	AIM ASSIST ("target tracking"): the closest enemy in front of you (within your weapon's reach
	+ a little, inside a ±55° cone) is tracked with a yellow ring + ▲ marker; when you hit, your
	character snaps to face them so the hit lands. No camera tricks, no aiming with the mouse.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)

local KnockbackController = require(script.Parent.KnockbackController)
local EffectsController = require(script.Parent.EffectsController)

local player = Players.LocalPlayer
local actionRemote = Net.Get("Action")

local InputController = {}

InputController.ShoveReadyAt = 0
InputController.Follow = Weapons.NewFollow() -- v0.9.18 Magnet push-pull (RepelUntil / CycleAt)
InputController.ShoveDuration = 1
local followWeapon = ""
local repelBuffered = false
InputController.RushReadyAt = 0
InputController.Blocking = false

-- v0.7.5: local Gloves combo prediction (same rule as the server) so the uppercut plays instantly
local comboStart, comboCount = -10, 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function character(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function InputController.CanAct(): boolean
	local char = player.Character
	if not char then
		return false
	end
	if char:GetAttribute("InRange") == true then
		return true -- Training Range in the Yard
	end
	return ReplicatedStorage:GetAttribute("State") == "Live" and char:GetAttribute("InRound") == true and char:GetAttribute("Alive") == true
end

------------------------------------------------------------------------
-- v0.9.2 LOCKED AIM (the only aim system) + AIM ASSIST target tracking
------------------------------------------------------------------------
InputController.LockMode = true -- kept for older callers: always LOCKED now
InputController.AssistTarget = nil :: Model?
InputController.AssistHits = 0 -- hits thrown with a tracked target (tutorial uses it)
local ASSIST_CONE = math.cos(math.rad(55))
local ASSIST_EXTRA = 5 -- studs past the weapon's reach that still get tracked
-- v0.9.3 long-range assist: ranged weapons track over their FULL reach in a tighter cone,
-- the Slingshot leads moving targets and the Bomb Bag lands its bomb on the target
local RANGED_KIND: { [string]: boolean } = { projectile = true, thrown = true, pull = true, tether = true }
local ASSIST_CONE_RANGED = math.cos(math.rad(40))

local function currentDef(): Weapons.WeaponDef
	local char = player.Character
	return Weapons.Get(char and char:GetAttribute("WeaponId") :: string? or nil)
end

local function isRanged(def: Weapons.WeaponDef): boolean
	return RANGED_KIND[def.Kind] == true
end

local function facingDirection(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return flat.Magnitude > 1e-3 and flat.Unit or nil
end

local function rootOf(m: Model): BasePart?
	local r = m:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return m.PrimaryPart
end

-- everything you could hit right now: rivals in the round, or the dummies + sparring bot in the Range
local function candidates(): { Model }
	local out = {}
	local me = player.Character
	if not me then
		return out
	end
	if me:GetAttribute("InRange") == true then
		local f = workspace:FindFirstChild("RangeDummies")
		if f then
			local serverNow = workspace:GetServerTimeNow()
			for _, d in f:GetChildren() do
				local flying = d:GetAttribute("LaunchedUntil")
				if d:IsA("Model") and rootOf(d) and not (type(flying) == "number" and flying > serverNow) then
					table.insert(out, d)
				end
			end
		end
		return out
	end
	if me:GetAttribute("InRound") ~= true then
		return out
	end
	local function ok(m: Model): boolean
		local hum = m:FindFirstChildOfClass("Humanoid")
		return m ~= me and hum ~= nil and hum.Health > 0 and m:GetAttribute("InRound") == true and m:GetAttribute("Alive") == true and rootOf(m) ~= nil
	end
	for _, plr in Players:GetPlayers() do
		local ch = plr.Character
		if plr ~= player and ch and ok(ch) then
			table.insert(out, ch)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, b in bots:GetChildren() do
			if b:IsA("Model") and ok(b) then
				table.insert(out, b)
			end
		end
	end
	return out
end

local function assistRange(): number
	local def = currentDef()
	if isRanged(def) then
		return (def.Range or 18) + Config.Combat.BodyRadius + 1 -- the weapon's real reach
	end
	return math.min((def.Range or 6) + Config.Combat.BodyRadius + ASSIST_EXTRA, 45)
end

-- the enemy aim assist is tracking: in front of you (±55°), in reach, closest + most centred
local function findAssistTarget(): Model?
	local _, _, root = character()
	local f = facingDirection()
	if not root or not f then
		return nil
	end
	local range = assistRange()
	local cone = isRanged(currentDef()) and ASSIST_CONE_RANGED or ASSIST_CONE
	local best: Model? = nil
	local bestScore = math.huge
	for _, m in candidates() do
		local r = rootOf(m) :: BasePart
		local off = r.Position - root.Position
		local flat = Vector3.new(off.X, 0, off.Z)
		local d = flat.Magnitude
		if d <= range and math.abs(off.Y) < 10 then
			local dot = d > 0.5 and f:Dot(flat.Unit) or 1
			if dot >= cone then
				local score = d * (2 - dot)
				if score < bestScore then
					best, bestScore = m, score
				end
			end
		end
	end
	return best
end

-- where to aim at a target: its position, or (Slingshot) where it WILL be when the pellet arrives
local function aimPoint(target: Model, def: Weapons.WeaponDef, origin: Vector3): Vector3?
	local tr = rootOf(target)
	if not tr then
		return nil
	end
	local p = tr.Position
	if def.Kind == "projectile" and (def.Speed or 0) > 0 then
		local v = tr.AssemblyLinearVelocity
		local vh = Vector3.new(v.X, 0, v.Z)
		if vh.Magnitude > 1 then
			for _ = 1, 2 do
				local travel = (p - origin).Magnitude / (def.Speed :: number)
				p = tr.Position + vh * math.min(travel, 1)
			end
		end
	end
	return p
end

-- LOCKED: the way you face, bent onto the tracked enemy (or its lead point) if there is one
local function aimDirection(): Vector3
	local _, _, root = character()
	local t = InputController.AssistTarget
	if root and t and t.Parent then
		local ap = aimPoint(t, currentDef(), root.Position)
		if ap then
			local off = ap - root.Position
			local flat = Vector3.new(off.X, 0, off.Z)
			if flat.Magnitude > 0.3 then
				return flat.Unit
			end
		end
	end
	return facingDirection() or Vector3.new(0, 0, -1)
end

-- how far a thrown weapon will fly right now: onto the tracked target, otherwise full reach
function InputController.ThrowDistance(): number
	local def = currentDef()
	local range = def.Range or 25
	local _, _, root = character()
	local t = InputController.AssistTarget
	if root and t and t.Parent then
		local ap = aimPoint(t, def, root.Position)
		if ap then
			local off = ap - root.Position
			return math.clamp(Vector3.new(off.X, 0, off.Z).Magnitude, 6, range)
		end
	end
	return range
end

local function faceAim(aim: Vector3)
	local _, _, root = character()
	if root and not KnockbackController.IsStunned() then
		local pos = root.Position
		root.CFrame = CFrame.lookAt(pos, pos + aim)
	end
end

function InputController.Shove()
	if not InputController.CanAct() or KnockbackController.IsStunned() then
		return
	end
	local t = now()
	if t < InputController.ShoveReadyAt then
		-- v0.9.18c: a Magnet REPEL click that comes a hair too early is buffered, not dropped
		if t < InputController.Follow.RepelUntil and not repelBuffered then
			repelBuffered = true
			task.delay(InputController.ShoveReadyAt - t + 0.02, function()
				repelBuffered = false
				InputController.Shove()
			end)
		end
		return
	end
	local char = player.Character :: Model
	local def = Weapons.Get(char:GetAttribute("WeaponId") :: string?)
	-- v0.9.18 Magnet push-pull: same state machine as the server (Weapons.FollowUp)
	if followWeapon ~= def.Id then
		followWeapon = def.Id -- weapon swapped (Rumble box / loadout): fresh push-pull state
		InputController.Follow = Weapons.NewFollow()
	end
	local step, readyAt = Weapons.FollowUp(def, InputController.Follow, t)
	if not step then
		return
	end
	local repel = step == "repel"
	InputController.ShoveReadyAt = readyAt
	InputController.ShoveDuration = math.max(0.05, readyAt - t)
	if def.RepelKB and not repel then
		-- the HUD shows the full cycle once the repel window runs out
		InputController.ShoveDuration = def.Cooldown
	end
	InputController.AssistTarget = findAssistTarget()
	local aim = aimDirection()
	if InputController.AssistTarget then
		faceAim(aim) -- aim assist: snap to face the tracked enemy
		InputController.AssistHits += 1
	end
	if def.Kind == "thrown" then
		-- the aim's LENGTH = throw distance (server clamps it): bombs land on the tracked target
		aim = aim * InputController.ThrowDistance()
	end
	if InputController.Blocking then
		InputController.BlockEnd()
	end
	-- v0.7.5: no more click-to-hit gap: send the click time (server resolves at click + windup)
	-- and play our own swing right now instead of waiting for the server's echo
	actionRemote:FireServer("Shove", aim, t)
	local combo = false
	if def.ComboHits and char:GetAttribute("InRange") ~= true then
		if t - comboStart > (def.ComboWindow or 1.5) then
			comboStart, comboCount = t, 1
		else
			comboCount += 1
		end
		if comboCount >= def.ComboHits then
			combo = true
			comboStart, comboCount = -10, 0
		end
	end
	if repel then
		EffectsController.LocalSwing(def.Id, def.RepelWindup or 0.1, true)
		return
	end
	EffectsController.LocalSwing(def.Id, def.Windup, combo)
end

function InputController.Rush()
	if not InputController.CanAct() or KnockbackController.IsStunned() then
		return
	end
	local t = now()
	if t < InputController.RushReadyAt then
		return
	end
	InputController.RushReadyAt = t + Config.Combat.RushCooldown
	local _, hum, _ = character()
	local dir = aimDirection()
	if hum and hum.MoveDirection.Magnitude > 0.2 then
		local md = hum.MoveDirection
		dir = Vector3.new(md.X, 0, md.Z).Unit
	end
	faceAim(dir)
	local char = player.Character
	if char then
		-- v0.9.2 dash pose + speed trail right away (the server sets it for everyone else)
		char:SetAttribute("RushUntil", t + Config.Combat.RushTime + 0.12)
		EffectsController.LocalRush(char)
	end
	KnockbackController.Rush(dir)
	actionRemote:FireServer("Rush", dir)
end

function InputController.BlockStart()
	if not InputController.CanAct() or InputController.Blocking then
		return
	end
	InputController.Blocking = true
	InputController.AssistTarget = findAssistTarget()
	local aim = aimDirection()
	if InputController.AssistTarget then
		faceAim(aim) -- turn the shield toward the tracked enemy
	end
	actionRemote:FireServer("BlockStart", aim)
end

function InputController.BlockEnd()
	if not InputController.Blocking then
		return
	end
	InputController.Blocking = false
	actionRemote:FireServer("BlockEnd")
end

local SHOVE_KEYS = {
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.KeyCode.F] = true,
	[Enum.KeyCode.ButtonR2] = true,
}
local RUSH_KEYS = {
	[Enum.KeyCode.LeftShift] = true,
	[Enum.KeyCode.Q] = true,
	[Enum.KeyCode.ButtonL1] = true,
}
local BLOCK_KEYS = {
	[Enum.KeyCode.E] = true,
	[Enum.KeyCode.ButtonL2] = true,
}

local function matches(set: { [any]: boolean }, input: InputObject): boolean
	return set[input.KeyCode] == true or set[input.UserInputType] == true
end

------------------------------------------------------------------------
-- v0.9.2 aim visuals: yellow chevron (where you face) + the aim-assist tracking ring/marker
------------------------------------------------------------------------
local facingArrow: Model? = nil
local ring: Part? = nil
local RING_SEGS = 18
local ringSegs: { Part } = {}
local ringMarker: BillboardGui? = nil
-- v0.9.3 long-range aim guide: dotted path (reach + direction) and the bomb's blast circle
local GUIDE_DOTS = 24
local GUIDE_RING = 22
local guide: Model? = nil
local guideDots: { Part } = {}
local guideRing: { Part } = {}

local function guidePart(name: string, size: Vector3, ball: boolean): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Shape = ball and Enum.PartType.Ball or Enum.PartType.Block
	p.Size = size
	return p
end

local function buildGuide()
	local m = Instance.new("Model")
	m.Name = "CrumbleAimGuide"
	for i = 1, GUIDE_DOTS do
		local d = guidePart("Dot" .. i, Vector3.new(0.5, 0.5, 0.5), true)
		d.Parent = m
		guideDots[i] = d
	end
	for i = 1, GUIDE_RING do
		local r = guidePart("Ring" .. i, Vector3.new(0.22, 0.12, 1), false)
		r.Parent = m
		guideRing[i] = r
	end
	guide = m
end

local function hideGuide()
	if guide and guide.Parent then
		guide.Parent = nil
	end
end

-- draw the path for the held long-range weapon (called every frame while it's out)
local function drawGuide(root: BasePart, def: Weapons.WeaponDef, dir: Vector3, tracking: boolean)
	local g = guide
	if not g then
		return
	end
	local groundY = root.Position.Y - 2.85
	local origin = Vector3.new(root.Position.X, groundY, root.Position.Z)
	local col = tracking and Color3.fromRGB(255, 214, 64) or Color3.fromRGB(235, 240, 255)
	local reach = def.Range or 18
	if def.Kind == "slam" then
		-- v0.9.20 hammer: just the impact circle on the floor in front of you
		local center = origin + dir * (def.SlamOffset or 4.5) + Vector3.new(0, 0.15, 0)
		for _, d in guideDots do
			d.Transparency = 1
		end
		local rad = def.SlamRadius or 4.5
		local seg = 2 * math.pi * rad / GUIDE_RING
		for i, r in guideRing do
			local a = (i - 0.5) / GUIDE_RING * 2 * math.pi
			local p = center + Vector3.new(math.cos(a) * rad, 0, math.sin(a) * rad)
			r.Size = Vector3.new(0.26, 0.1, seg * 0.6)
			r.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
			r.Color = col
			r.Transparency = 0.45
		end
		g.Parent = workspace
		return
	end
	if def.Kind == "thrown" then
		-- arc from the hand to the landing spot + the blast circle there
		local dist = InputController.ThrowDistance()
		local hand = root.Position + Vector3.new(0, 1.5, 0)
		local land = origin + dir * dist + Vector3.new(0, 0.15, 0)
		local peak = math.max(4, dist * 0.32)
		for i, d in guideDots do
			local u = i / GUIDE_DOTS
			local p = hand:Lerp(land, u) + Vector3.new(0, 4 * peak * u * (1 - u), 0)
			d.CFrame = CFrame.new(p)
			d.Color = col
			d.Transparency = 0.15 + 0.5 * u
			d.Size = Vector3.new(0.42, 0.42, 0.42)
		end
		local rad = def.BlastRadius or 7
		local blast = Color3.fromRGB(255, 96, 50)
		local seg = 2 * math.pi * rad / GUIDE_RING
		for i, r in guideRing do
			local a = (i - 0.5) / GUIDE_RING * 2 * math.pi
			local p = land + Vector3.new(math.cos(a) * rad, 0, math.sin(a) * rad)
			r.Size = Vector3.new(0.3, 0.12, seg * 0.8)
			r.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
			r.Color = blast
			r.Transparency = 0.2
		end
	else
		-- straight shot / pull / hook: dotted line out to the exact reach, end bar at max range;
		-- the dots past the tracked target dim out so you see where it will hit
		local hitAt = reach
		local t = InputController.AssistTarget
		if tracking and t then
			local tr = rootOf(t)
			if tr then
				local off = tr.Position - root.Position
				hitAt = math.min(reach, Vector3.new(off.X, 0, off.Z).Magnitude)
			end
		end
		for i, d in guideDots do
			local along = 2 + (reach - 2) * (i - 1) / (GUIDE_DOTS - 1)
			d.CFrame = CFrame.new(origin + dir * along + Vector3.new(0, 0.2, 0))
			d.Color = col
			d.Transparency = along <= hitAt + 0.5 and 0.1 or 0.7
			d.Size = Vector3.new(0.38, 0.38, 0.38)
		end
		-- end of reach: a short bar across the line (uses the first few ring parts)
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local tip = origin + dir * reach + Vector3.new(0, 0.2, 0)
		for i, r in guideRing do
			if i <= 3 then
				local p = tip + side * ((i - 2) * 0.9)
				r.Size = Vector3.new(0.26, 0.14, 0.9)
				r.CFrame = CFrame.lookAt(p, p + side)
				r.Color = col
				r.Transparency = 0.1
			else
				r.Transparency = 1
			end
		end
	end
	g.Parent = workspace
end

local function buildLockUi()
	-- a flat chevron "^" on the ground in front of you (only you see it) = your hit direction
	local model = Instance.new("Model")
	model.Name = "CrumbleFacingArrow"
	local tip = Vector3.new(0, 0, -0.9)
	for _, side in { -1, 1 } do
		local tail = Vector3.new(side * 1.1, 0, 0.6)
		local bar = Instance.new("Part")
		bar.Name = side < 0 and "L" or "R"
		bar.Anchored = true
		bar.CanCollide = false
		bar.CanQuery = false
		bar.CanTouch = false
		bar.CastShadow = false
		bar.Material = Enum.Material.Neon
		bar.Color = Color3.fromRGB(255, 214, 64)
		bar.Transparency = 0.15
		bar.Size = Vector3.new(0.34, 0.08, (tip - tail).Magnitude + 0.3)
		bar:SetAttribute("Local", CFrame.lookAt((tip + tail) / 2, tip))
		bar.Parent = model
	end
	facingArrow = model

	-- the tracking ring under the enemy aim assist will hit (+ a bobbing marker over them)
	local r = Instance.new("Part")
	r.Name = "CrumbleAssistRing"
	r.Shape = Enum.PartType.Cylinder
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CastShadow = false
	r.Shape = Enum.PartType.Block
	r.Transparency = 1 -- v0.9.7 RC: an invisible anchor; the ring itself is a HOLLOW circle of
	r.Size = Vector3.new(0.2, 0.2, 0.2) -- dashes, so the target's feet stay visible (was a filled disc)
	for k = 1, RING_SEGS do
		local seg = Instance.new("Part")
		seg.Name = "Seg" .. k
		seg.Anchored = true
		seg.CanCollide = false
		seg.CanQuery = false
		seg.CanTouch = false
		seg.CastShadow = false
		seg.Material = Enum.Material.Neon
		seg.Color = Color3.fromRGB(255, 214, 64)
		seg.Transparency = 0.1
		seg.Size = Vector3.new(0.7, 0.1, 0.32)
		seg.Parent = r
		table.insert(ringSegs, seg)
	end
	ring = r
	local bb = Instance.new("BillboardGui")
	bb.Name = "AssistMarker"
	bb.Size = UDim2.fromOffset(46, 46)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 4.6, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = r
	for _, rot in { 45, -45 } do
		-- a drawn "V" pointing down at the target (no font glyphs)
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(rot > 0 and 0.36 or 0.64, 0.45)
		bar.Size = UDim2.new(0.56, 0, 0, 8)
		bar.Rotation = rot
		bar.BackgroundColor3 = Color3.fromRGB(255, 214, 64)
		bar.BorderSizePixel = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = bar
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Color = Color3.fromRGB(60, 40, 0)
		st.Parent = bar
		bar.Parent = bb
	end
	ringMarker = bb
	buildGuide()
end

-- kept so old buttons/keys don't break: there is only one mode now
function InputController.ToggleLock() end

local function stepLock()
	local char, _, root = character()
	local active = char ~= nil and (char:GetAttribute("InRange") == true or (char:GetAttribute("InRound") == true and char:GetAttribute("Alive") == true and (ReplicatedStorage:GetAttribute("State") == "Live" or ReplicatedStorage:GetAttribute("State") == "Countdown")))
	local f = facingDirection()
	-- chevron
	local arrow = facingArrow
	if arrow then
		if active and root and f then
			local pos = root.Position + f * 4.2 - Vector3.new(0, 2.9, 0)
			local cf = CFrame.lookAt(pos, pos + f)
			for _, bar in arrow:GetChildren() do
				if bar:IsA("BasePart") then
					local lc = bar:GetAttribute("Local")
					if typeof(lc) == "CFrame" then
						bar.CFrame = cf * lc
					end
				end
			end
			arrow.Parent = workspace
		else
			arrow.Parent = nil
		end
	end
	-- aim assist tracking (who your next hit will snap to)
	local target = active and findAssistTarget() or nil
	InputController.AssistTarget = target
	-- long-range weapons: show the reach + direction the shot will actually take
	local def = currentDef()
	if active and root and (isRanged(def) or def.Kind == "slam") then
		drawGuide(root, def, aimDirection(), target ~= nil)
	else
		hideGuide()
	end
	local r = ring
	if r then
		local tr = target and rootOf(target)
		if tr then
			local pulse = 1 + 0.08 * math.sin(os.clock() * 8)
			local center = tr.Position - Vector3.new(0, 2.9, 0)
			r.CFrame = CFrame.new(center)
			-- hollow dashed ring that slowly spins (radius 2.8, dash = 60% of the arc)
			local radius = 2.8 * pulse
			local arc = 2 * math.pi * radius / RING_SEGS
			local spin = os.clock() * 0.8
			for k, seg in ringSegs do
				local a = spin + (k - 1) * (2 * math.pi / RING_SEGS)
				seg.Size = Vector3.new(arc * 0.6, 0.1, 0.32)
				seg.CFrame = CFrame.new(center) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius)
			end
			r.Parent = workspace
			if ringMarker then
				ringMarker.StudsOffsetWorldSpace = Vector3.new(0, 7.2 + 0.4 * math.sin(os.clock() * 6), 0)
			end
		else
			r.Parent = nil
		end
	end
end

-- (v1.0 patch 5: the mobile joystick, jump and fight buttons live in TouchController)


function InputController.Init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if matches(SHOVE_KEYS, input) then
			InputController.Shove()
		elseif matches(RUSH_KEYS, input) then
			InputController.Rush()
		elseif matches(BLOCK_KEYS, input) then
			InputController.BlockStart()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if matches(BLOCK_KEYS, input) then
			InputController.BlockEnd()
		end
	end)

	buildLockUi()
	RunService.RenderStepped:Connect(function()
		local ok, err = pcall(stepLock)
		if not ok then
			warn("[CRUMBLE] aim assist:", err)
		end
	end)

	-- release block if the round ends / you fall while holding it
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if ReplicatedStorage:GetAttribute("State") ~= "Live" then
			InputController.Blocking = false
		end
		if ReplicatedStorage:GetAttribute("State") == "Live" then
			InputController.ShoveReadyAt = 0
			InputController.Follow = Weapons.NewFollow()
			InputController.RushReadyAt = 0
		end
	end)

	player.CharacterAdded:Connect(function(char)
		InputController.Blocking = false
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
		if hum then
			hum.CameraOffset = Vector3.new(1.4, 0.6, 0) -- over-the-shoulder feel
		end
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">JoinController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — JoinController (v0.7.1)
	"Join the next match?" card shown to everyone in the Yard before every match.
	  • JOIN!  → you play the next match       • SIT OUT → you stay in the Yard
	  • no answer within 20 s = you sit out (bots take every empty seat)
	v0.7.5: a status pill explains what's happening while a match runs without you.
	After answering, the card collapses into a small status pill with a CHANGE button
	(you can change your mind until the timer ends). Hotkeys: J = join, N = sit out.
	v0.8.1: a VOTE panel (everyone in the Yard) picks the next map (1 / 2 / 3) and mode.
	Majority wins; ties and no-votes are settled at random.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local UI = require(script.Parent.UI)
local Layout = require(script.Parent.Layout)
local EffectsController = require(script.Parent.EffectsController)

local player = Players.LocalPlayer
local Col = UI.Colors

local JoinController = {}

local gui: ScreenGui
local card: Frame
local cardScale: UIScale
local pill: Frame
local playNowSent = false -- v1.0 patch
local refs: { [string]: any } = {}
local replyRemote: RemoteEvent
local voteRemote: RemoteEvent
local votePanel: Frame
local voteScale: UIScale
local voteShownRound = -1
local voteClosedRound = -1 -- v0.9.18c: the X hides the vote panel for this round (1/2/3 brings it back)
local mapCards: { [string]: { Frame: TextButton, Count: TextLabel, Stroke: UIStroke } } = {}
local modeButtons: { [string]: { Button: TextButton, Stroke: UIStroke } } = {}

-- what each map card says (short: the twist you're voting for)
local MAP_BLURB = {
	Grid = "The original · no hazards",
	Molten = "Sinking magma · geysers",
	Ice = "Skating · frost traps · blizzards",
}
local shownRound = -1
local forceCard = false
-- v1.0 patch 6 NEW PLAYERS: until the Range basics are done (tutorial steps 1-6) the big join card +
-- map vote don't pop over the tutorial; a small "match starting · JOIN" pill offers the match instead
local tutorialStep = Config.Tutorial.Done
local LEARN_UNTIL = 6 -- step 7 of the tutorial is "JOIN A MATCH"
local function learning(): boolean
	return tutorialStep < LEARN_UNTIL and not forceCard
end
local lastTick = -1

local function now(): number
	return workspace:GetServerTimeNow()
end

local function answer(): string?
	return player:GetAttribute("JoinAnswer") :: string?
end

-- v0.9.5 CENTRED: the join card + vote panel form ONE block in the middle of the screen
-- (card on top, vote under it, fixed gap so they never touch). The block scales to fit the free
-- band between the top bar/top stack and the action bar, and only moves off-centre if it has to.
local fitK = 1
local popUntil = 0
local CARD_H, CARD_TAB = 214, 21 -- card height + how far its "NEXT MATCH" tab sticks out on top
local VOTE_H, VOTE_TAB = 196, 19
local GAP = 16 -- clear space between the card's bottom edge and the vote tab
local function popCard()
	card.Visible = true
	cardScale.Scale = fitK * 0.6
	popUntil = os.clock() + 0.34
	TweenService:Create(cardScale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fitK }):Play()
end

local function placeCards()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = Layout.Scale()
	local showC, showV = card.Visible, votePanel.Visible
	Layout.SetCenterBusy(showC or showV)
	-- block height in unscaled px (tabs included)
	local h = 0
	if showC then
		h += CARD_TAB + CARD_H
	end
	if showV then
		h += (showC and GAP or 0) + VOTE_TAB + VOTE_H
	end
	if h <= 0 then
		return
	end
	local topLimit = math.max(Layout.TopBarBottom(s), Layout.StackBottom()) + 8
	local botLimit = vp.Y - 14 - 100 * s -- keep clear of the action bar (14 px margin + 92 px bar)
	-- never wider than the gap between the left dock and the right column (520 px panels) and,
	-- v1.0 patch, on touch while the fight buttons are up (Range), never under the thumb cluster
	local side = 12 + 300 * s + 10
	local ch = player.Character
	if Layout.IsTouch() and ch and ch:GetAttribute("InRange") == true then
		side = math.max(side, Layout.TouchCluster(vp))
	end
	local function fit()
		local band = math.max(60, botLimit - topLimit)
		fitK = math.clamp(math.min(s, band / h), 0.4, s)
		fitK = math.max(0.4, math.min(fitK, (vp.X - 2 * side) / 520))
	end
	fit()
	-- v1.0 patch: a wide card on a narrow screen would reach the coin / level cards: start under them
	if vp.X / 2 - 260 * fitK < 12 + 386 * s + 6 then
		topLimit = math.max(topLimit, Layout.TOP_INSET + 58 * s + 8)
		fit()
	end
	local H = h * fitK
	local y0 = math.clamp(vp.Y / 2 - H / 2, topLimit, math.max(topLimit, botLimit - H))
	local y = y0
	if showC then
		y += CARD_TAB * fitK
		card.Position = UDim2.new(0.5, 0, 0, y + CARD_H * fitK / 2)
		y += CARD_H * fitK + GAP * fitK
	end
	if showV then
		y += VOTE_TAB * fitK
		votePanel.Position = UDim2.new(0.5, 0, 0, y + VOTE_H * fitK / 2)
	end
	if os.clock() > popUntil then
		cardScale.Scale = fitK
		voteScale.Scale = fitK
	end
end

local function reply(join: boolean)
	if ReplicatedStorage:GetAttribute("State") ~= "Joining" and ReplicatedStorage:GetAttribute("LateJoin") ~= true then
		return
	end
	replyRemote:FireServer(join)
	forceCard = false
	EffectsController.Play("Click", 0.6, join and 1.1 or 0.85)
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "CrumbleJoin"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 8
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	card = UI.new("Frame", {
		Name = "JoinCard", Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(520, 214), BackgroundColor3 = Col.Panel, Visible = false,
	})
	UI.corner(24).Parent = card
	UI.stroke(UI.Outline, 4).Parent = card
	UI.gradient(card, Color3.fromRGB(190, 196, 214))
	cardScale = UI.new("UIScale", { Parent = card })

	local tab = UI.new("Frame", { Parent = card, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(220, 42), BackgroundColor3 = Col.Lava, ZIndex = 3 })
	UI.corner(21).Parent = tab
	UI.stroke(UI.Outline, 3).Parent = tab
	UI.gradient(tab)
	UI.label({ Parent = tab, Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Text = "NEXT MATCH", TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, ZIndex = 4 })

	UI.label({ Parent = card, Position = UDim2.fromOffset(20, 30), Size = UDim2.new(1, -40, 0, 38), Text = "JOIN THE NEXT MATCH?", TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline })
	refs.Sub = UI.label({ Parent = card, Position = UDim2.fromOffset(20, 70), Size = UDim2.new(1, -40, 0, 18), TextColor3 = Col.Mute, Text = "" })

	-- countdown bar
	local back = UI.new("Frame", { Parent = card, Position = UDim2.fromOffset(24, 96), Size = UDim2.new(1, -48, 0, 16), BackgroundColor3 = Col.Panel2 })
	UI.corner(8).Parent = back
	refs.Fill = UI.new("Frame", { Parent = back, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Col.Gold })
	UI.corner(8).Parent = refs.Fill
	refs.Secs = UI.label({ Parent = back, Size = UDim2.fromScale(1, 1), Text = "", TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, ZIndex = 3 })

	refs.Yes = UI.button({ Parent = card, Position = UDim2.fromOffset(24, 126), Size = UDim2.new(0.5, -32, 0, 56), Text = "JOIN! [J]", BackgroundColor3 = Col.Good })
	refs.No = UI.button({ Parent = card, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 126), Size = UDim2.new(0.5, -32, 0, 56), Text = "SIT OUT  [N]", BackgroundColor3 = Col.Panel2 })
	refs.Note = UI.label({ Parent = card, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Size = UDim2.new(1, -40, 0, 16), TextColor3 = Col.Mute, Text = "No answer = sit out" })
	refs.Yes.Activated:Connect(function()
		reply(true)
	end)
	refs.No.Activated:Connect(function()
		reply(false)
	end)

	-- status pill (after answering)
	pill = UI.new("Frame", { Name = "JoinPill", Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 128), Size = UDim2.fromOffset(400, 46), BackgroundColor3 = Col.Panel, Visible = false })
	UI.corner(23).Parent = pill
	UI.stroke(UI.Outline, 3).Parent = pill
	refs.PillText = UI.label({ Parent = pill, Position = UDim2.fromOffset(18, 8), Size = UDim2.new(1, -130, 1, -16), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = "" })
	refs.Change = UI.button({ Parent = pill, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(100, 34), Text = "CHANGE", BackgroundColor3 = Col.Panel2 })
	refs.Change.Activated:Connect(function()
		if player:GetAttribute("AFK") == true then
			-- v1.0 patch: STOP AFK from the pill
			EffectsController.Play("Click", 0.5)
			task.spawn(function()
				pcall(function()
					Net.GetFunction("Request"):InvokeServer("AfkToggle", false)
				end)
			end)
			return
		end
		local st = ReplicatedStorage:GetAttribute("State")
		if st == "Live" and ReplicatedStorage:GetAttribute("Exhibition") == true then
			-- v1.0 patch PLAY NOW: end the bots-only match and get a seat in the next one
			if not playNowSent then
				playNowSent = true
				replyRemote:FireServer("playnow")
				EffectsController.Play("Click", 0.6, 1.1)
			end
			return
		end
		if st == "Intermission" then
			reply(answer() ~= "yes") -- late JOIN / LEAVE during the countdown
			return
		end
		forceCard = true
		popCard()
	end)

	-- v0.8.1 VOTE panel: separate from the join card, stays up for the whole join window
	votePanel = UI.new("Frame", {
		Name = "VotePanel", Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.65),
		Size = UDim2.fromOffset(520, 196), BackgroundColor3 = Col.Panel, Visible = false,
	})
	UI.corner(24).Parent = votePanel
	UI.stroke(UI.Outline, 4).Parent = votePanel
	UI.gradient(votePanel, Color3.fromRGB(190, 196, 214))
	voteScale = UI.new("UIScale", { Parent = votePanel })
	local vtab = UI.new("Frame", { Parent = votePanel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(240, 38), BackgroundColor3 = Color3.fromRGB(56, 140, 255), ZIndex = 3 })
	UI.corner(19).Parent = vtab
	UI.stroke(UI.Outline, 3).Parent = vtab
	UI.gradient(vtab)
	refs.VoteTitle = UI.label({ Parent = vtab, Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Text = "VOTE MAP", TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, ZIndex = 4 })
	-- v0.9.18c: the panel stays up after you vote (and shows the result until the match), with an
	-- X to close it yourself (same round red close button as the menus)
	local vclose = UI.button({ Name = "VoteClose", Parent = votePanel, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -4, 0, 2), Size = UDim2.fromOffset(42, 42), Text = "", BackgroundColor3 = Col.Bad, ZIndex = 6 })
	UI.cross(vclose, Color3.new(1, 1, 1), 5, 7)
	UI.corner(21).Parent = vclose
	vclose.Activated:Connect(function()
		voteClosedRound = (ReplicatedStorage:GetAttribute("JoinRound") :: number?) or 0
		EffectsController.Play("Click", 0.5, 0.9)
	end)

	local order = Config.Vote.Maps
	local w = (520 - 24 * 2 - 12 * (#order - 1)) / #order
	for k, id in order do
		local def = Config.Maps[id]
		local b = UI.button({
			Name = "Vote" .. id, Parent = votePanel, Position = UDim2.fromOffset(24 + (k - 1) * (w + 12), 28),
			Size = UDim2.fromOffset(w, 104), BackgroundColor3 = Col.Panel2, Text = "",
		})
		local stroke = UI.stroke(UI.Outline, 3)
		stroke.Parent = b
		-- swatch: the map's own tile colours, checkered
		local sw = UI.new("Frame", { Parent = b, Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 42), BackgroundColor3 = def.ColorA })
		UI.corner(10).Parent = sw
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, def.ColorA), ColorSequenceKeypoint.new(0.5, def.ColorB), ColorSequenceKeypoint.new(1, def.Core),
		})
		g.Parent = sw
		UI.label({ Parent = sw, Size = UDim2.fromScale(1, 1), Text = tostring(k), TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, TextTransparency = 0.1 })
		UI.label({ Parent = b, Position = UDim2.fromOffset(6, 54), Size = UDim2.new(1, -12, 0, 20), Text = def.Name, TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline })
		UI.label({ Parent = b, Position = UDim2.fromOffset(6, 74), Size = UDim2.new(1, -12, 0, 13), Text = def.Tagline or MAP_BLURB[id] or "", TextColor3 = Col.Mute })
		local count = UI.label({ Parent = b, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 2), Size = UDim2.fromOffset(44, 22), Text = "0", TextColor3 = Col.Gold, TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, ZIndex = 5 })
		b.Activated:Connect(function()
			voteRemote:FireServer("map", id)
			EffectsController.Play("Click", 0.6, 1 + k * 0.08)
		end)
		mapCards[id] = { Frame = b, Count = count, Stroke = stroke }
	end
	-- mode row
	local modes = Config.Vote.Modes
	local mw = (520 - 48 - 12) / #modes
	for k, id in modes do
		local def = Config.Modes[id]
		local b = UI.button({
			Name = "Mode" .. id, Parent = votePanel, Position = UDim2.fromOffset(24 + (k - 1) * (mw + 12), 142),
			Size = UDim2.fromOffset(mw, 40), BackgroundColor3 = id == "Rumble" and Color3.fromRGB(150, 90, 230) or Col.Panel2,
			Text = "",
		})
		local stroke = UI.stroke(UI.Outline, 3)
		stroke.Parent = b
		UI.label({ Name = "Txt", Parent = b, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 1, -8), RichText = true, Text = def.Name, TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline })
		b.Activated:Connect(function()
			voteRemote:FireServer("mode", id)
			EffectsController.Play("Click", 0.6, id == "Rumble" and 1.2 or 1)
		end)
		modeButtons[id] = { Button = b, Stroke = stroke }
	end

	UI.Skin(gui)
	task.defer(function()
		Layout.AddToStack(pill, 10, 420) -- "You're IN / sitting out" pill: first row of the top stack
	end)
end

local function stepVote(state: any)
	local voting = state == "Joining" and ReplicatedStorage:GetAttribute("VoteOpen") == true
	-- v0.9.18c: once the vote closes, the panel stays up showing the winner until the match starts
	local winner = ReplicatedStorage:GetAttribute("NextMap") :: string?
	local showResult = not voting and (state == "Joining" or state == "Intermission") and winner ~= nil
	local round = (ReplicatedStorage:GetAttribute("JoinRound") :: number?) or 0
	if (not voting and not showResult) or voteClosedRound == round or (learning() and answer() == nil) then
		votePanel.Visible = false
		return
	end
	refs.VoteTitle.Text = if voting then "VOTE MAP" else "NEXT MAP"
	if round ~= voteShownRound then
		voteShownRound = round
		votePanel.Visible = true
		voteScale.Scale = fitK * 0.6
		popUntil = os.clock() + 0.34
		TweenService:Create(voteScale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fitK }):Play()
	end
	votePanel.Visible = true
	-- (centred under the join card, or centred alone once you've answered: see placeCards)
	local myMap = player:GetAttribute("VoteMap")
	local myMode = player:GetAttribute("VoteMode") or "Classic"
	local best = 0
	for _, id in Config.Vote.Maps do
		best = math.max(best, (ReplicatedStorage:GetAttribute("Votes_" .. id) :: number?) or 0)
	end
	for id, mc in mapCards do
		local n = (ReplicatedStorage:GetAttribute("Votes_" .. id) :: number?) or 0
		mc.Count.Text = n > 0 and tostring(n) or ""
		local mine = myMap == id
		if showResult then
			-- result: the winner glows green, the rest fade back
			local won = winner == id
			mc.Stroke.Color = won and Col.Good or UI.Outline
			mc.Stroke.Thickness = won and 6 or 3
			mc.Frame.BackgroundColor3 = won and Color3.fromRGB(214, 250, 220) or Col.Panel2
			mc.Count.Text = (won and "WIN " or "") .. (n > 0 and tostring(n) or "")
		else
			mc.Stroke.Color = mine and Col.Gold or (n > 0 and n == best and Color3.fromRGB(56, 140, 255) or UI.Outline)
			mc.Stroke.Thickness = mine and 5 or 3
			mc.Frame.BackgroundColor3 = mine and Color3.fromRGB(255, 236, 190) or Col.Panel2
		end
	end
	for id, mb in modeButtons do
		local n = (ReplicatedStorage:GetAttribute("Votes_" .. id) :: number?) or 0
		local def = Config.Modes[id]
		local txt = mb.Button:FindFirstChild("Txt") :: TextLabel?
		if txt then
			txt.Text = string.format("%s  <font size=\"14\">%s</font>%s", def.Name, def.Blurb or "", n > 0 and ("  · " .. n) or "")
		end
		local mine = myMode == id
		if showResult then
			local won = (ReplicatedStorage:GetAttribute("NextMode") or "Classic") == id
			mb.Stroke.Color = won and Col.Good or UI.Outline
			mb.Stroke.Thickness = won and 6 or 3
		else
			mb.Stroke.Color = mine and Col.Gold or UI.Outline
			mb.Stroke.Thickness = mine and 5 or 3
		end
	end
end

local function step()
	local state = ReplicatedStorage:GetAttribute("State")
	stepVote(state)
	local round = (ReplicatedStorage:GetAttribute("JoinRound") :: number?) or 0
	local endsAt = (ReplicatedStorage:GetAttribute("EndsAt") :: number?) or 0
	local a = answer()

	if state ~= "Live" then
		playNowSent = false
	end
	local afkChar = player.Character
	if player:GetAttribute("AFK") == true and not (afkChar and afkChar:GetAttribute("InRound") == true) then
		-- v1.0 patch AFK MODE: no join card (patch 5: the big AFK card from AfkController replaces the pill)
		card.Visible = false
		pill.Visible = false
		placeCards()
		return
	end
	if state == "Joining" then
		if round ~= shownRound then
			shownRound = round
			forceCard = false
			popCard()
			EffectsController.Play("Win", 0.4, 1.2)
		end
		local left = math.max(0, endsAt - now())
		local joined = (ReplicatedStorage:GetAttribute("JoinedCount") :: number?) or 0
		local seats = Config.MaxSeats
		refs.Sub.Text = string.format("%d / %d seats · bots fill the rest", math.min(joined, seats), seats)
		refs.Fill.Size = UDim2.fromScale(math.clamp(left / Config.Round.JoinWindow, 0, 1), 1)
		refs.Fill.BackgroundColor3 = left <= 5 and Col.Bad or Col.Gold
		refs.Secs.Text = string.format("%ds", math.ceil(left))
		local whole = math.ceil(left)
		if left <= 5 and whole ~= lastTick and a == nil then
			lastTick = whole
			EffectsController.Play("Tick", 0.4)
		end

		local learn = a == nil and learning()
		local showCard = (a == nil and not learn) or forceCard
		card.Visible = showCard
		pill.Visible = not showCard
		if learn then
			refs.PillText.Text = string.format('<font color="#%s">Match in %ds</font>  ·  train first, or', Col.Gold:ToHex(), math.ceil(left))
			refs.Change.Visible = true
			refs.Change.Text = "JOIN"
			refs.Change.BackgroundColor3 = Col.Good
			placeCards()
			return
		elseif a == "yes" then
			refs.PillText.Text = string.format('<font color="#%s">YOU\'RE IN!</font>  Match in %ds', Col.Good:ToHex(), math.ceil(left))
		elseif a == "no" then
			refs.PillText.Text = string.format('<font color="#%s">Sitting out</font>  ·  next ask in a bit', Col.Mute:ToHex())
		end
		refs.Change.Visible = true
		refs.Change.Text = "CHANGE"
		refs.Change.BackgroundColor3 = Col.Panel2
		-- highlight the current choice on the card
		refs.Yes.BackgroundColor3 = a == "no" and Col.Panel2 or Col.Good
	elseif state == "Intermission" and ReplicatedStorage:GetAttribute("LateJoin") == true then
		-- v0.7.2 longer intermission: countdown pill with late JOIN / LEAVE
		card.Visible = false
		pill.Visible = true
		refs.Change.Visible = true
		local left = math.ceil(math.max(0, endsAt - now()))
		local nextName = ReplicatedStorage:GetAttribute("NextMapName")
		local nextMode = ReplicatedStorage:GetAttribute("NextMode")
		local what = if nextName then string.format("  ·  %s%s", tostring(nextName), nextMode == "Rumble" and " RUMBLE" or "") else ""
		if a == "yes" then
			refs.PillText.Text = string.format('<font color="#%s">YOU\'RE IN!</font>  Match in %ds%s', Col.Good:ToHex(), left, what)
			refs.Change.Text = "LEAVE [N]"
			refs.Change.BackgroundColor3 = Col.Panel2
		else
			local joined = (ReplicatedStorage:GetAttribute("JoinedCount") :: number?) or 0
			refs.PillText.Text = string.format("Match in %ds  ·  %d joined", left, joined)
			refs.Change.Text = "JOIN [J]"
			refs.Change.BackgroundColor3 = Col.Good
		end
	elseif state == "Intermission" and a == "yes" then
		card.Visible = false
		pill.Visible = true
		refs.Change.Visible = false
		refs.PillText.Text = string.format('<font color="#%s">YOU\'RE IN!</font>  Get ready…', Col.Good:ToHex())
	elseif state == "Live" or state == "Countdown" or state == "Results" or (state == "Intermission" and a ~= "yes") then
		-- v0.7.5: always say what's happening, so nobody wonders where the join question went
		local char = player.Character
		local inRound = char ~= nil and char:GetAttribute("InRound") == true
		if inRound then
			card.Visible = false
			pill.Visible = false
		else
			card.Visible = false
			pill.Visible = true
			local exhibition = state == "Live" and ReplicatedStorage:GetAttribute("Exhibition") == true
			refs.Change.Visible = exhibition and not playNowSent
			if exhibition then
				refs.Change.Text = "PLAY NOW"
				refs.Change.BackgroundColor3 = Col.Good
			end
			local msg = if exhibition and playNowSent then "Starting a new match..."
				elseif exhibition then "Bots match · want in?"
				elseif state == "Results" then "Match over · join is next"
				elseif state == "Intermission" then "Next match starting soon"
				else "Match on · join after it"
			refs.PillText.Text = msg
		end
	else
		card.Visible = false
		pill.Visible = false
	end
	placeCards() -- v0.9.5: after this frame's visibility is settled
end

function JoinController.Init()
	replyRemote = Net.Get("JoinReply")
	Net.Get("Profile").OnClientEvent:Connect(function(p)
		if type(p) == "table" and type(p.Tutorial) == "number" then
			tutorialStep = p.Tutorial
		end
	end)
	voteRemote = Net.Get("Vote")
	build()
	RunService.RenderStepped:Connect(step)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or (ReplicatedStorage:GetAttribute("State") ~= "Joining" and ReplicatedStorage:GetAttribute("LateJoin") ~= true) then
			return
		end
		local maps = Config.Vote.Maps
		local numKey = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 }
		local k = numKey[input.KeyCode]
		if k and maps[k] and ReplicatedStorage:GetAttribute("VoteOpen") == true then
			voteClosedRound = -1 -- voting by key brings a closed panel back
			voteRemote:FireServer("map", maps[k])
			EffectsController.Play("Click", 0.6, 1 + k * 0.08)
			return
		end
		if input.KeyCode == Enum.KeyCode.J then
			reply(true)
		elseif input.KeyCode == Enum.KeyCode.N then
			reply(false)
		end
	end)
end

return JoinController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">KnockbackController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — KnockbackController
	Your client owns your character's physics, so the server asks it to apply launches.
	Also performs your own Rush dash instantly (the server validates it separately).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local player = Players.LocalPlayer

local KnockbackController = {}

local token = 0
local stunUntil = 0
local onLaunched: ((number) -> ())? = nil

local function charParts(): (Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function clearRush(root: BasePart)
	local lv = root:FindFirstChild("RushVelocity")
	if lv then
		lv:Destroy()
	end
end

function KnockbackController.IsStunned(): boolean
	return os.clock() < stunUntil
end

function KnockbackController.OnLaunched(fn: (number) -> ())
	onLaunched = fn
end

function KnockbackController.Launch(velocity: Vector3, stun: number)
	local hum, root = charParts()
	if not hum or not root then
		return
	end
	token += 1
	local mine = token
	stunUntil = os.clock() + stun
	clearRush(root)
	local skate = root:FindFirstChild("SkateVelocity") :: LinearVelocity?
	if skate then
		skate.Enabled = false
	end
	hum.PlatformStand = true
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = Vector3.new(math.random(-6, 6), math.random(-3, 3), math.random(-6, 6))
	if onLaunched then
		(onLaunched :: (number) -> ())(velocity.Magnitude)
	end
	task.delay(stun, function()
		if token == mine and hum.Parent then
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

function KnockbackController.Rush(dir: Vector3)
	local hum, root = charParts()
	if not hum or not root then
		return
	end
	if player.Character and player.Character:GetAttribute("Iced") == true then
		return -- frozen in a frost trap: no dashing out of the ice block
	end
	local att = root:FindFirstChild("RootAttachment") :: Attachment?
	if not att then
		return
	end
	clearRush(root)
	local C = Config.Combat
	local lv = Instance.new("LinearVelocity")
	lv.Name = "RushVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.MaxAxesForce = Vector3.new(1e5, 0, 1e5)
	lv.VectorVelocity = dir * (C.RushDistance / C.RushTime)
	lv.Parent = root
	local char = player.Character
	if char and char:GetAttribute("InMagma") == true then
		-- v0.8.1: rushing out of a magma pool pops you up and over the rim
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, Config.Maps.Molten.Magma.RushPop, v.Z)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	task.delay(C.RushTime, function()
		if lv.Parent then
			lv:Destroy()
		end
	end)
end

-- No climbing: tile sides / gaps must never act like a ladder. Your own client runs your
-- character's physics, so the state has to be disabled here (server-side doesn't replicate).
local function noClimb(char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	end
end

-- v0.8 Frostbite: ice tiles make you skate. The legacy Humanoid ignores part friction, so a
-- planar LinearVelocity eases your velocity toward where you're steering instead of snapping.
local skateVel = Vector2.zero
local function stepSkate(dt: number)
	local hum, root = charParts()
	if not hum or not root then
		return
	end
	local lv = root:FindFirstChild("SkateVelocity") :: LinearVelocity?
	local onIce = ReplicatedStorage:GetAttribute("Map") == "Ice"
		and ReplicatedStorage:GetAttribute("State") == "Live"
		and math.abs(root.Position.Y - Config.Arena.Center.Y) < 12
		and not hum.PlatformStand
		and hum.FloorMaterial ~= Enum.Material.Air
		and root:FindFirstChild("RushVelocity") == nil
		and hum.WalkSpeed > 0
	if not onIce then
		if lv then
			lv.Enabled = false
		end
		local v = root.AssemblyLinearVelocity
		skateVel = Vector2.new(v.X, v.Z)
		return
	end
	local att = root:FindFirstChild("RootAttachment") :: Attachment?
	if not att then
		return
	end
	if not lv then
		local n = Instance.new("LinearVelocity")
		n.Name = "SkateVelocity"
		n.Attachment0 = att
		n.RelativeTo = Enum.ActuatorRelativeTo.World
		n.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		n.PrimaryTangentAxis = Vector3.xAxis
		n.SecondaryTangentAxis = Vector3.zAxis
		n.MaxForce = 1e5
		n.Enabled = false
		n.Parent = root
		lv = n
	end
	local c = lv :: LinearVelocity
	if not c.Enabled then
		local v = root.AssemblyLinearVelocity
		skateVel = Vector2.new(v.X, v.Z)
		c.Enabled = true
	end
	local sk = Config.Maps.Ice.Skate
	local md = hum.MoveDirection
	local target = Vector2.new(md.X, md.Z) * hum.WalkSpeed
	-- v0.8.2 blizzard gusts push every skater
	if ReplicatedStorage:GetAttribute("WindPhase") == "blow" then
		local wd = ReplicatedStorage:GetAttribute("WindDir")
		if typeof(wd) == "Vector3" then
			local sp = Config.Maps.Ice.Gusts.Speed
			target += Vector2.new(wd.X, wd.Z) * sp
		end
	end
	-- v0.8.5 fast ice: push hard toward where you steer (capped acceleration = drifty turns),
	-- glide with very little friction when you let go
	if md.Magnitude > 0.05 then
		local delta = target - skateVel
		local step = sk.Push * dt
		if delta.Magnitude <= step then
			skateVel = target
		else
			skateVel += delta.Unit * step
		end
	else
		skateVel = target + (skateVel - target) * math.exp(-sk.Glide * dt) -- target = wind only (or zero)
	end
	c.PlaneVelocity = skateVel
end

function KnockbackController.Init()
	RunService.Heartbeat:Connect(stepSkate)
	if player.Character then
		task.spawn(noClimb, player.Character)
	end
	player.CharacterAdded:Connect(noClimb)
	Net.Get("Knockback").OnClientEvent:Connect(function(velocity: Vector3, stun: number)
		if typeof(velocity) == "Vector3" and type(stun) == "number" then
			KnockbackController.Launch(velocity, math.clamp(stun, 0, 3))
		end
	end)
end

return KnockbackController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — Layout (v0.9.3)
	One place that decides WHERE the HUD lives, so panels never pile on top of each other.

	  ┌ LeftStack (coins · level) ─────┐   TopBar (phase · timer · players)   ┌ RIGHT COLUMN ┐
	  │                                │   TOP STACK (one column, no overlap): │ quests  OR   │
	  │ Dock (menu tiles, lobby)       │     join pill → tutorial → tip →      │ range card   │
	  │                                │     spectate → hint → toast           │ kill feed    │
	  │                                │   [join card + vote: under the stack] │              │
	  └────────────────────────────────┘        ActionBar (bottom centre)       └──────────────┘

	* Scale: every HUD block gets a UIScale = clamp(min(w/1280, h/760), 0.55, 1.15), so phones get a
	  smaller HUD and big screens a bigger one; offsets are re-computed with it.
	* TOP STACK / RIGHT COLUMN are UIListLayouts: only VISIBLE children take space, so a toast can
	  never sit on the tutorial card again.
	* Touch: the action bar slides left of the thumb buttons, the right column stays above them.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Layout = {}

local player = Players.LocalPlayer
local gui: ScreenGui? = nil
local stack: Frame? = nil
local right: Frame? = nil
local placed: { { Obj: GuiObject, Place: ((s: number, vp: Vector2) -> UDim2)? } } = {}
local listeners: { (s: number, vp: Vector2) -> () } = {}
local current = 1

Layout.TOP_INSET = 64 -- clears Roblox's own top-left buttons
Layout.TOUCH_CLUSTER = 270 -- (old fixed value; use Layout.TouchCluster)

-- v1.0 patch: px from the right edge the mobile SHOVE/RUSH/BLOCK + jump cluster uses (matches InputController)
-- (patch 5: our own JUMP + SHOVE/RUSH/BLOCK arc, 207 px at k = 1; k grows to 1.6 on tablets)
function Layout.TouchCluster(vp: Vector2): number
	return 207 * math.clamp(math.min(vp.X, vp.Y) / 390, 1, 1.6)
end

-- v1.0 patch 4 TOUCH MODE (live): Roblox's PreferredInput first (it is Touch on phones/tablets even
-- when the device ALSO reports a keyboard, which the old "touch and no keyboard" test missed, e.g.
-- Studio's device emulator and many tablets). A real tap switches to touch mode at once; a real mouse
-- click switches back (keys never do). Everything that reads IsTouch re-lays out.
local touchMode = false
local lastTouch: boolean? = nil -- nil = no input yet
local lastTouchAt = -10
local modeListeners: { (touch: boolean) -> () } = {}

local function preferred(): string
	local ok, v = pcall(function()
		return tostring((UserInputService :: any).PreferredInput)
	end)
	return if ok then v else ""
end

local function detect(): boolean
	local pref = preferred()
	if pref == "Enum.PreferredInput.Touch" then
		return true
	end
	if not UserInputService.TouchEnabled then
		return false
	end
	if lastTouch ~= nil then
		return lastTouch
	end
	if pref == "Enum.PreferredInput.KeyboardAndMouse" or pref == "Enum.PreferredInput.Gamepad" then
		return false
	end
	return not UserInputService.KeyboardEnabled or not UserInputService.MouseEnabled
end

touchMode = detect()

-- patch 6: y (px) of the top of our joystick's rest ring (TouchController: 20 + 126 px at k = 1),
-- minus a little room for the phone's home-bar inset. The touch dock must end above it.
function Layout.StickTop(vp: Vector2): number
	local k = math.clamp(math.min(vp.X, vp.Y) / 390, 1, 1.6)
	return vp.Y - (20 + 126) * k - 10
end

function Layout.IsTouch(): boolean
	return touchMode
end

-- fn(touch) runs now and every time the player switches between touch and mouse/keyboard
function Layout.OnModeChanged(fn: (touch: boolean) -> ())
	table.insert(modeListeners, fn)
	task.spawn(fn, touchMode)
end

local function viewport(): Vector2
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

-- v1.0 patch RESPONSIVE UI: one scale for the whole HUD, from the screen size (Roblox screen units,
-- so phones/tablets/PCs/TVs all map to the same 1280x760 design). Touch screens keep a 0.55 floor
-- so text and buttons stay finger-sized; big monitors grow up to 1.3x.
local function compute(vp: Vector2): number
	local s = math.min(vp.X / 1280, vp.Y / 760)
	return math.clamp(s, if Layout.IsTouch() then 0.55 else 0.5, 1.3)
end

function Layout.Scale(): number
	return current
end

-- the y (px) right under the TopBar (10 px margin + 70 px bar, scaled)
function Layout.TopBarBottom(s: number?): number
	local k = s or current
	return 10 + 70 * k + 6
end

local function scaleOf(obj: GuiObject): UIScale
	local sc = obj:FindFirstChild("LayoutScale")
	if sc and sc:IsA("UIScale") then
		return sc
	end
	local n = Instance.new("UIScale")
	n.Name = "LayoutScale"
	n.Parent = obj
	return n
end

local function apply()
	local vp = viewport()
	current = compute(vp)
	local s = current
	for _, p in placed do
		if p.Obj.Parent then
			scaleOf(p.Obj).Scale = s
			if p.Place then
				p.Obj.Position = p.Place(s, vp)
			end
		end
	end
	if stack then
		stack.Position = UDim2.new(0.5, 0, 0, Layout.TopBarBottom(s))
		scaleOf(stack).Scale = s
		-- the stack is as wide as the gap between the coin/level cards (left) and the right column,
		-- so a long toast or tip WRAPS instead of running under them
		local side = 12 + math.max(386, 330) * s + 10
		stack.Size = UDim2.fromOffset(math.clamp((vp.X - 2 * side) / s, 340, 640), 0)
	end
	if right then
		right.Position = UDim2.new(1, -12, 0, Layout.TOP_INSET)
		scaleOf(right).Scale = s
	end
	for _, fn in listeners do
		task.spawn(fn, s, vp)
	end
end

local function ensureGui(): ScreenGui
	if gui then
		return gui
	end
	local g = Instance.new("ScreenGui")
	g.Name = "CrumbleLayout"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 4 -- under the menu windows (5) and the join card (8): an open window covers it
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = player:WaitForChild("PlayerGui")
	gui = g

	local st = Instance.new("Frame")
	st.Name = "TopStack"
	st.AnchorPoint = Vector2.new(0.5, 0)
	st.Size = UDim2.fromOffset(640, 0)
	st.AutomaticSize = Enum.AutomaticSize.Y
	st.BackgroundTransparency = 1
	st.Parent = g
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Vertical
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, 6)
	l.Parent = st
	stack = st

	local rc = Instance.new("Frame")
	rc.Name = "RightColumn"
	rc.AnchorPoint = Vector2.new(1, 0)
	rc.Size = UDim2.fromOffset(300, 0)
	rc.AutomaticSize = Enum.AutomaticSize.Y
	rc.BackgroundTransparency = 1
	rc.Parent = g
	local l2 = Instance.new("UIListLayout")
	l2.FillDirection = Enum.FillDirection.Vertical
	l2.HorizontalAlignment = Enum.HorizontalAlignment.Right
	l2.SortOrder = Enum.SortOrder.LayoutOrder
	l2.Padding = UDim.new(0, 8)
	l2.Parent = rc
	right = rc

	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local c = workspace.CurrentCamera
		if c then
			c:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		end
		apply()
	end)
	touchMode = detect()
	local function recheck()
		local m = detect()
		if m ~= touchMode then
			touchMode = m
			for _, fn in modeListeners do
				task.spawn(fn, m)
			end
			apply()
		end
	end
	UserInputService.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			lastTouch = true
			lastTouchAt = os.clock()
		elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseWheel then
			-- (a tap can also fire a fake mouse click; only a real click, away from taps, means PC)
			if os.clock() - lastTouchAt < 1.5 then
				return
			end
			lastTouch = false
		else
			return -- keys never flip a phone/tablet back to the PC layout
		end
		recheck()
	end)
	for _, prop in { "PreferredInput", "TouchEnabled", "KeyboardEnabled", "MouseEnabled" } do
		pcall(function()
			UserInputService:GetPropertyChangedSignal(prop :: any):Connect(recheck)
		end)
	end
	apply()
	return g
end

-- Top-centre stack. Orders: 10 join pill · 20 tutorial · 30 tutorial tip · 40 spectate · 50 hint · 60 toast
-- The item fills the stack's width up to maxW (its height stays; wrap-able items grow downward).
function Layout.AddToStack(obj: GuiObject, order: number, maxW: number)
	ensureGui()
	obj.AnchorPoint = Vector2.new(0.5, 0)
	obj.Position = UDim2.new()
	obj.Size = UDim2.new(1, 0, 0, obj.Size.Y.Offset)
	if obj.AutomaticSize == Enum.AutomaticSize.X or obj.AutomaticSize == Enum.AutomaticSize.XY then
		obj.AutomaticSize = Enum.AutomaticSize.None
	end
	local c = obj:FindFirstChild("StackWidth") :: UISizeConstraint?
	if not c then
		local n = Instance.new("UISizeConstraint")
		n.Name = "StackWidth"
		n.Parent = obj
		c = n
	end
	(c :: UISizeConstraint).MaxSize = Vector2.new(maxW, math.huge)
	obj.LayoutOrder = order
	obj.Parent = stack
end

-- Right column (top-right). Orders: 10 quests · 20 range card · 30 kill feed
function Layout.AddToRight(obj: GuiObject, order: number)
	ensureGui()
	obj.AnchorPoint = Vector2.new(1, 0)
	obj.Position = UDim2.new()
	obj.LayoutOrder = order
	obj.Parent = right
end

-- Scale a free block (and optionally re-place it) whenever the screen size changes.
function Layout.Fit(obj: GuiObject, place: ((s: number, vp: Vector2) -> UDim2)?)
	ensureGui()
	table.insert(placed, { Obj = obj, Place = place })
	scaleOf(obj).Scale = current
	if place then
		obj.Position = place(current, viewport())
	end
end

function Layout.OnChanged(fn: (s: number, vp: Vector2) -> ())
	ensureGui()
	table.insert(listeners, fn)
	task.spawn(fn, current, viewport())
end

-- v0.9.5: true while the centred join card / vote block is up (lobby tips stay hidden then)
local centerBusy = false
function Layout.SetCenterBusy(on: boolean)
	centerBusy = on
end

function Layout.CenterBusy(): boolean
	return centerBusy
end

-- true while something important (join pill, tutorial, tip, spectate) is in the top stack:
-- the rotating lobby tips stay hidden then, so the stack stays short
function Layout.StackBusy(): boolean
	if centerBusy then
		return true
	end
	if not stack then
		return false
	end
	for _, c in stack:GetChildren() do
		if c:IsA("GuiObject") and c.Visible and c.LayoutOrder < 50 then
			return true
		end
	end
	return false
end

-- bottom edge (px, screen space) of the top stack, for things placed under it (join card, vote)
function Layout.StackBottom(): number
	if stack and stack.AbsoluteSize.Y > 1 then
		return stack.AbsolutePosition.Y + stack.AbsoluteSize.Y -- every CRUMBLE gui ignores the inset
	end
	return Layout.TopBarBottom()
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — MenuController (v0.6 Power)
	WEAPONS (inventory + equip) · SPIN VAULT (odds, pity, reveal) · FORGE (merge, Merge All,
	wildcard bench) · DEV (DevMode only). v0.9.1: the Boot merges like every weapon.
	v0.9: QUESTS (starter, daily, weekly chain) · SEASON (Season 1 track + claims) · SHOP (dev
	products, odds + pity shown, PolicyService-aware) · LEADERS (global top lists).
	Also: lobby side buttons, starter-quest tracker, Training Range panel.
	Opens from the Yard stations (ProximityPrompts), the side buttons, or B.
	All numbers shown here are previews; the server validates every request.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local Descriptions = require(Shared:WaitForChild("Descriptions"))
local Progression = require(Shared.Progression)
local Retention = require(Shared.Retention)

local UI = require(script.Parent.UI)
local Layout = require(script.Parent:WaitForChild("Layout"))
local EffectsController = require(script.Parent.EffectsController)
local Social = require(script.Parent:WaitForChild("Social"))

local player = Players.LocalPlayer
local Col = UI.Colors

local MenuController = {}

local request: RemoteFunction
local gui: ScreenGui
local pages: { [string]: Frame } = {}
local windows: { [string]: Frame } = {}
local fitScales: { [string]: UIScale } = {}
local statusLabels: { [string]: TextLabel } = {}
local walletLabels: { TextLabel } = {}
local dockButtons: { [string]: TextButton } = {}
local openName: string? = nil
local refs: { [string]: any } = {}
local profile: { [string]: any }? = nil
local currentTab = "Weapons"
local selectedForge = "Boot"
local busy = false
local revealing = false
local skipReveal = false
local rangeMode = "current"

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
local function panel(props: { [string]: any }): Frame
	local base = { BackgroundColor3 = Col.Panel, BackgroundTransparency = 0.04, BorderSizePixel = 0 }
	for k, v in props do
		base[k] = v
	end
	local f = UI.new("Frame", base)
	UI.corner(12).Parent = f
	UI.stroke(Col.Line, 1.5, 0.2).Parent = f
	return f
end

local function setStatus(text: string, color: Color3?)
	if refs.Status then
		refs.Status.Text = text
		refs.Status.TextColor3 = color or Col.Mute
	end
end

local function call(action: string, a: any?, b: any?): { [string]: any }?
	if busy then
		return nil
	end
	busy = true
	local ok, res = pcall(function()
		return request:InvokeServer(action, a, b)
	end)
	busy = false
	if not ok or type(res) ~= "table" then
		setStatus("Connection problem — nothing was spent.", Col.Bad)
		return nil
	end
	if not res.Ok and res.Msg then
		setStatus(res.Msg, Col.Bad)
		EffectsController.Play("Click", 0.4, 0.6)
	end
	return res
end

local function owned(id: string): { Level: number, Copies: number }?
	return profile and profile.Weapons and profile.Weapons[id] or nil
end

local function inRound(): boolean
	local char = player.Character
	return char ~= nil and char:GetAttribute("InRound") == true and char:GetAttribute("Alive") == true
end

local function bar(parent: Instance, pos: UDim2, size: UDim2, color: Color3): (Frame, TextLabel)
	local back = UI.new("Frame", { Parent = parent, Position = pos, Size = size, BackgroundColor3 = Col.Panel2, BorderSizePixel = 0 })
	UI.corner(5).Parent = back
	local fill = UI.new("Frame", { Parent = back, Size = UDim2.fromScale(0, 1), BackgroundColor3 = color, BorderSizePixel = 0 })
	UI.corner(5).Parent = fill
	local label = UI.label({ Parent = back, Position = UDim2.fromOffset(6, 2), Size = UDim2.new(1, -12, 1, -4), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, ZIndex = 3 })
	return fill, label
end

------------------------------------------------------------------------
-- v0.7.1: SEPARATE WINDOWS — each menu has its own window, title tab, colour and dock button.
-- (One window open at a time so they never overlap; there is no shared tab bar any more.)
------------------------------------------------------------------------
local WINDOW_ORDER = { "Weapons", "Vault", "Forge", "Quests", "Season", "Shop", "Leaders", "Feedback" } -- v1.0 patch: FEEDBACK fills the free 8th tile
local WINDOW_SPECS: { [string]: { Title: string, Icon: string, Color: Color3, Key: string? } } = {
	Weapons = { Title = "WEAPONS", Icon = "swords", Color = Color3.fromRGB(56, 140, 255), Key = "B" },
	Vault = { Title = "SPIN VAULT", Icon = "spin", Color = Color3.fromRGB(255, 184, 40) },
	Forge = { Title = "FORGE", Icon = "hammer", Color = Color3.fromRGB(255, 104, 40) },
	Dev = { Title = "DEV", Icon = "wrench", Color = Color3.fromRGB(110, 118, 138) },
	Quests = { Title = "QUESTS", Icon = "scroll", Color = Color3.fromRGB(52, 186, 96) },
	Season = { Title = "SEASON", Icon = "trophy", Color = Color3.fromRGB(150, 90, 230) },
	Shop = { Title = "SHOP", Icon = "gem", Color = Color3.fromRGB(40, 190, 190) },
	Leaders = { Title = "LEADERS", Icon = "crown", Color = Color3.fromRGB(220, 56, 56) },
	Feedback = { Title = "FEEDBACK", Icon = "chat", Color = Color3.fromRGB(70, 110, 230) },
}

local refreshers: { [string]: () -> () } = {}

local function fitValue(): number
	local cam = workspace.CurrentCamera
	if not cam then
		return 1
	end
	local vp = cam.ViewportSize
	-- v1.0 patch: windows fit the screen AND grow with the HUD on big screens (they stopped at 1x)
	return math.clamp(math.min(vp.X / 880, vp.Y / 620) * 0.96, 0.5, math.max(1, Layout.Scale()))
end

local function isOpen(): boolean
	return openName ~= nil
end

function MenuController.Close()
	if openName then
		local w = windows[openName]
		if w then
			w.Visible = false
		end
		local b = dockButtons[openName]
		if b then
			b:SetAttribute("Selected", false)
		end
	end
	openName = nil
	Players.LocalPlayer:SetAttribute("MenuOpen", false) -- v1.0.1 (frees the mouse in first person)
end

function MenuController.Open(name: string?)
	if inRound() then
		return
	end
	local target = name or currentTab
	if not windows[target] then
		return
	end
	if openName and openName ~= target then
		MenuController.Close()
	end
	currentTab = target
	openName = target
	Players.LocalPlayer:SetAttribute("MenuOpen", true)
	local w = windows[target]
	w.Visible = true
	-- pop-in
	local sc = fitScales[target]
	local fit = fitValue()
	sc.Scale = fit * 0.82
	TweenService:Create(sc, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fit }):Play()
	refs.Status = statusLabels[target]
	setStatus("")
	local r = refreshers[target]
	if r then
		r()
	end
	EffectsController.Play("Click", 0.5)
end

-- kept for the page builders' "go to Vault / Forge" buttons
local function showTab(name: string)
	MenuController.Open(name)
end

local function buildWindow(name: string)
	local spec = WINDOW_SPECS[name]
	local window = panel({
		Name = name .. "Window",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(820, 520),
		Visible = false,
		ZIndex = 20,
	})
	windows[name] = window
	local scale = UI.new("UIScale", { Parent = window })
	fitScales[name] = scale

	-- title tab sticking out of the top-left edge
	local tab = UI.new("Frame", { Name = "TitleTab", Parent = window, Position = UDim2.fromOffset(22, -24), Size = UDim2.fromOffset(270, 48), BackgroundColor3 = spec.Color, ZIndex = 24 })
	UI.corner(24).Parent = tab
	UI.stroke(UI.Outline, 3).Parent = tab
	UI.gradient(tab)
	UI.icon(spec.Icon, { Parent = tab, Position = UDim2.fromOffset(10, 6), Size = UDim2.fromOffset(36, 36), ZIndex = 25 })
	UI.label({ Parent = tab, Position = UDim2.fromOffset(52, 7), Size = UDim2.new(1, -62, 0, 34), Text = spec.Title, TextXAlignment = Enum.TextXAlignment.Left, Font = UI.Font, TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, ZIndex = 25 })

	local wallet = UI.label({ Parent = window, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -70, 0, 16), Size = UDim2.fromOffset(300, 26), TextXAlignment = Enum.TextXAlignment.Right, Font = UI.Font, TextColor3 = Col.Gold, RichText = true, ZIndex = 21 })
	table.insert(walletLabels, wallet)
	if profile then
		wallet.Text = string.format("%s COINS  ·  %d SPINS", UI.comma(profile.Coins or 0), profile.Spins or 0)
	end

	-- round close button on the top-right corner
	local close = UI.button({ Parent = window, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(48, 48), Text = "", BackgroundColor3 = Col.Bad, ZIndex = 26 })
	UI.cross(close, Color3.new(1, 1, 1), 6, 27)
	UI.corner(24).Parent = close
	close.Activated:Connect(MenuController.Close)

	statusLabels[name] = UI.label({ Parent = window, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -8), Size = UDim2.new(1, -36, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, ZIndex = 21 })

	pages[name] = UI.new("Frame", {
		Name = name,
		Parent = window,
		Position = UDim2.fromOffset(14, 56),
		Size = UDim2.new(1, -28, 1, -90),
		BackgroundTransparency = 1,
		Visible = true,
		ZIndex = 21,
	})
end

local function buildWindows()
	local names = table.clone(WINDOW_ORDER)
	if Config.DevMode then
		table.insert(names, "Dev")
	end
	for _, n in names do
		buildWindow(n)
	end
	-- re-fit the open window whenever the screen changes (rotate / resize / camera swap)
	Layout.OnChanged(function()
		if openName and fitScales[openName] then
			fitScales[openName].Scale = fitValue()
		end
	end)
end

