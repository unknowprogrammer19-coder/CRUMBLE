local forgeButtons: { [string]: TextButton } = {}

local function buildForge()
	local page = pages.Forge
	local list = UI.new("ScrollingFrame", { Parent = page, Size = UDim2.new(0, 220, 1, 0), BackgroundColor3 = Col.Panel2, BackgroundTransparency = 0.2, BorderSizePixel = 0, ScrollBarThickness = 5, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 })
	UI.corner(10).Parent = list
	UI.padding(6).Parent = list
	UI.new("UIListLayout", { Parent = list, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
	for i, def in Weapons.List do
		local b = UI.button({ Parent = list, LayoutOrder = i, Size = UDim2.new(1, -4, 0, 34), Text = def.Name, TextColor3 = Rarity.Colors[def.Rarity], ZIndex = 23 })
		b.Activated:Connect(function()
			selectedForge = def.Id
			EffectsController.Play("Click", 0.4)
			if refreshers.Forge then
				refreshers.Forge()
			end
		end)
		forgeButtons[def.Id] = b
	end

	local d = UI.new("Frame", { Parent = page, Position = UDim2.fromOffset(234, 0), Size = UDim2.new(1, -234, 1, 0), BackgroundTransparency = 1, ZIndex = 22 })
	refs.FName = UI.label({ Parent = d, Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, ZIndex = 23 })
	refs.FRarity = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, ZIndex = 23 })
	refs.FLevels = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 58), Size = UDim2.fromOffset(300, 56), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, ZIndex = 23 })
	refs.FKB = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Text, ZIndex = 23 })
	refs.FPWR = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 142), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Gold, ZIndex = 23 })
	refs.FCopies = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 170), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 23 })
	refs.FCoins = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 192), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 23 })
	refs.FMerge = UI.button({ Parent = d, Position = UDim2.fromOffset(0, 220), Size = UDim2.fromOffset(180, 44), Text = "MERGE", BackgroundColor3 = Col.Lava, ZIndex = 23 })
	refs.FMergeAll = UI.button({ Parent = d, Position = UDim2.fromOffset(190, 220), Size = UDim2.fromOffset(150, 44), Text = "MERGE ALL", ZIndex = 23 })
	-- v0.9.22 AUTO MERGE pass: every weapon at once (+ an auto-merge switch)
	refs.FMergeEvery = UI.button({ Parent = d, Position = UDim2.fromOffset(350, 220), Size = UDim2.new(1, -350, 0, 44), Text = "MERGE EVERYTHING", BackgroundColor3 = Col.Gold, ZIndex = 23 })
	refs.FAuto = UI.button({ Parent = d, Position = UDim2.fromOffset(350, 270), Size = UDim2.new(1, -350, 0, 22), Text = "AUTO MERGE: ON", TextSize = 12, ZIndex = 23 })
	refs.FNote = UI.label({ Parent = d, Position = UDim2.fromOffset(0, 270), Size = UDim2.fromOffset(340, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "+3% knockback per level.", ZIndex = 23 })

	local bench = UI.new("Frame", { Parent = d, Position = UDim2.fromOffset(0, 296), Size = UDim2.new(1, 0, 1, -296), BackgroundColor3 = Col.Panel2, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 22 })
	UI.corner(10).Parent = bench
	UI.label({ Parent = bench, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, TextColor3 = Col.Gold, Text = "WILDCARD BENCH", ZIndex = 23 })
	refs.BInfo = UI.label({ Parent = bench, Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, RichText = true, ZIndex = 23 })
	refs.BWild = UI.button({ Parent = bench, Position = UDim2.fromOffset(12, 54), Size = UDim2.fromOffset(250, 34), Text = "", ZIndex = 23 })
	refs.BUp = UI.button({ Parent = bench, Position = UDim2.fromOffset(272, 54), Size = UDim2.new(1, -284, 0, 34), Text = "", ZIndex = 23 })

	local function afterMerge(res: { [string]: any }?)
		if not res or not res.Ok then
			return
		end
		local def = Weapons.Get(res.WeaponId)
		local fromKB = Progression.KB(def, res.From)
		local toKB = Progression.KB(def, res.To)
		setStatus(string.format("%s: L%d → L%d", def.Name, res.From, res.To), Col.Good)
		EffectsController.Play("Hit", 0.9, 0.7)
		task.delay(0.12, function()
			EffectsController.Play("Win", 0.8, 1.2)
		end)
		-- the knockback number ticks up
		local nv = Instance.new("NumberValue")
		nv.Value = fromKB
		nv.Changed:Connect(function(v)
			refs.FKB.Text = string.format("Knockback  %.1f", v)
		end)
		local tw = TweenService:Create(nv, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Value = toKB })
		tw:Play()
		tw.Completed:Connect(function()
			nv:Destroy()
			if refreshers.Forge then
				refreshers.Forge()
			end
		end)
		local lv = refs.FLevels :: TextLabel
		lv.TextColor3 = Col.Gold
		TweenService:Create(lv, TweenInfo.new(0.8), { TextColor3 = Col.Text }):Play()
	end
	refs.FMerge.Activated:Connect(function()
		afterMerge(call("Merge", selectedForge))
	end)
	refs.FMergeAll.Activated:Connect(function()
		afterMerge(call("MergeAll", selectedForge))
	end)
	refs.FMergeEvery.Activated:Connect(function()
		if not hasPass("AutoMerge") then
			showTab("Shop")
			local sc = refs.ShopScroll :: ScrollingFrame?
			if sc then
				sc.CanvasPosition = Vector2.zero -- passes are at the top
			end
			return
		end
		local res = call("MergeEverything")
		if res and res.Ok then
			setStatus("MERGED: " .. mergedText(res.Merged), Col.Good)
			EffectsController.Play("Hit", 0.9, 0.7)
			task.delay(0.12, function()
				EffectsController.Play("Win", 0.8, 1.2)
			end)
		end
	end)
	refs.FAuto.Activated:Connect(function()
		local res = call("SetAutoMerge", not (profile and profile.AutoMerge ~= false))
		if res and res.Ok then
			EffectsController.Play("Click", 0.5)
		end
	end)
	refs.BWild.Activated:Connect(function()
		local res = call("ToWildcard", selectedForge)
		if res and res.Ok then
			setStatus(res.Msg or "Wildcard made.", Col.Good)
			EffectsController.Play("Win", 0.6, 1.4)
		end
	end)
	refs.BUp.Activated:Connect(function()
		local res = call("UpTier", selectedForge)
		if res and res.Ok then
			setStatus(res.Msg or "Wildcard made.", Col.Good)
			EffectsController.Play("Win", 0.7, 1.1)
		end
	end)
end

refreshers.Forge = function()
	local p = profile
	if not p then
		return
	end
	if not owned(selectedForge) then
		selectedForge = "Boot"
	end
	for id, b in forgeButtons do
		local o = owned(id)
		local def = Weapons.Get(id)
		b.Visible = o ~= nil
		if o then
			local check = Progression.CheckMerge(p, id)
			b.Text = string.format("%s  L%d%s", def.Name, o.Level, check.Ok and "  · MERGE!" or "")
			b.BackgroundColor3 = id == selectedForge and Color3.fromRGB(255, 228, 204) or Col.Panel
		end
	end
	local def = Weapons.Get(selectedForge)
	local o = owned(selectedForge) :: { Level: number, Copies: number }
	local rc = Rarity.Colors[def.Rarity]
	refs.FName.Text = string.upper(def.Name)
	refs.FName.TextColor3 = rc
	refs.FRarity.Text = def.Rarity .. "  ·  merge copies + coins"
	local check = Progression.CheckMerge(p, selectedForge)
	if check.Maxed then
		refs.FLevels.Text = "L10  MAX"
		refs.FKB.Text = string.format("Knockback  %s", Progression.KBText(def, 10))
		refs.FPWR.Text = "PWR " .. Rarity.PWR(def.Rarity, 10)
		refs.FCopies.Text = "MAXED! Extra copies = coins."
		refs.FCoins.Text = ""
		refs.FMerge.Visible = false
		refs.FMergeAll.Visible = false
	else
		refs.FLevels.Text = string.format("L%d  →  L%d", o.Level, o.Level + 1)
		refs.FKB.Text = string.format("%s  →  %s", Progression.KBText(def, o.Level), Progression.KBText(def, o.Level + 1))
		refs.FPWR.Text = string.format("PWR %d  →  %d", Rarity.PWR(def.Rarity, o.Level), Rarity.PWR(def.Rarity, o.Level + 1))
		local good, bad = Col.Good:ToHex(), Col.Bad:ToHex()
		local have = check.UseOwn + check.UseWild
		refs.FCopies.Text = string.format('Copies: <font color="#%s">%d own + %d wildcard</font> / %d needed', have >= check.NeedCopies and good or bad, o.Copies, check.Wildcards, check.NeedCopies)
		refs.FCoins.Text = string.format('Coins: <font color="#%s">%s</font> / %s', (p.Coins or 0) >= check.Coins and good or bad, UI.comma(p.Coins or 0), UI.comma(check.Coins))
		refs.FMerge.Visible = true
		refs.FMergeAll.Visible = true
		refs.FMerge.Text = "MERGE"
		refs.FMergeAll.Text = "MERGE ALL"
		refs.FMerge.BackgroundColor3 = check.Ok and Col.Lava or Col.Panel2
		refs.FMergeAll.BackgroundColor3 = check.Ok and Color3.fromRGB(150, 70, 30) or Col.Panel2
	end
	-- v0.9.22 AUTO MERGE pass buttons
	do
		local owns = hasPass("AutoMerge")
		refs.FMergeEvery.Text = owns and "MERGE EVERYTHING" or "MERGE EVERYTHING  (PASS)"
		refs.FMergeEvery.BackgroundColor3 = owns and Col.Gold or Col.Panel2
		refs.FAuto.Visible = owns
		local on = p.AutoMerge ~= false
		refs.FAuto.Text = on and "AUTO MERGE AFTER SPINS: ON" or "AUTO MERGE AFTER SPINS: OFF"
		refs.FAuto.BackgroundColor3 = on and Col.Good or Col.Panel2
	end
	-- wildcard bench
	do
		local nextR = Progression.NextRarity(def.Rarity)
		local wild = p.Wildcards and p.Wildcards[def.Rarity] or 0
		refs.BInfo.Text = string.format('Spare %s copies: <b>%d</b>  ·  your <font color="#%s">%s wildcards</font>: <b>%d</b> (work for any %s weapon)', def.Name, o.Copies, rc:ToHex(), def.Rarity, wild, def.Rarity)
		refs.BWild.Visible = true
		refs.BWild.Text = string.format("%d copies → 1 %s wildcard", Config.Merge.SameRarityRate, def.Rarity)
		refs.BWild.BackgroundColor3 = o.Copies >= Config.Merge.SameRarityRate and Color3.fromRGB(214, 228, 255) or Col.Panel
		refs.BUp.Visible = nextR ~= nil
		if nextR then
			refs.BUp.Text = string.format("%d copies → 1 %s wildcard", Config.Merge.UpTierRate, nextR)
			refs.BUp.TextColor3 = Rarity.Colors[nextR]
			refs.BUp.BackgroundColor3 = o.Copies >= Config.Merge.UpTierRate and Color3.fromRGB(214, 228, 255) or Col.Panel
		end
	end
end


------------------------------------------------------------------------
-- v0.9 helpers
------------------------------------------------------------------------
local function timeLeft(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local d = math.floor(seconds / 86400)
	local h = math.floor(seconds % 86400 / 3600)
	local m = math.floor(seconds % 3600 / 60)
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%dm", math.max(1, m))
end

local function heading(parent: Instance, pos: UDim2, size: UDim2, text: string, color: Color3?): TextLabel
	return UI.label({ Parent = parent, Position = pos, Size = size, Font = Enum.Font.GothamBlack, TextColor3 = color or Col.Gold, TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = text, ZIndex = 23 })
end

local function card(parent: Instance, pos: UDim2, size: UDim2, color: Color3?): Frame
	local f = UI.new("Frame", { Parent = parent, Position = pos, Size = size, BackgroundColor3 = color or Col.Panel2, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 22 })
	UI.corner(10).Parent = f
	return f
end

