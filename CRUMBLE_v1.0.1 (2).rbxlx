		egg(k, Vector3.new(1.3, 1.3, 0.34), hc + Vector3.new(0, 0, sz * 0.92), YELLOW) -- rounded face
	end
	table.insert(r.Gems, Art.CylX(k, 0.3, 0.05, hc + Vector3.new(0.62, 0, 0), SILVER, M.Metal, "Gem"))
