-- WEAPONS
------------------------------------------------------------------------
local cards: { [string]: { [string]: any } } = {}

local function buildWeapons()
	local page = pages.Weapons
	refs.WildLine = UI.label({ Parent = page, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 22 })
	local scroll = UI.new("ScrollingFrame", {
		Parent = page,
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 22,
	})
	UI.new("UIGridLayout", { Parent = scroll, CellSize = UDim2.fromOffset(250, 178), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	for i, def in Weapons.List do
		local rc = Rarity.Colors[def.Rarity]
		local card = UI.new("Frame", { Parent = scroll, LayoutOrder = i, BackgroundColor3 = Col.Panel2, BorderSizePixel = 0, ZIndex = 22 })
		UI.corner(10).Parent = card
		local stroke = UI.stroke(rc, 2, 0.3)
		stroke.Parent = card
		UI.new("Frame", { Parent = card, Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = rc, BorderSizePixel = 0, ZIndex = 23 })
		local c = {}
		c.Card = card
		c.Stroke = stroke
		c.Name = UI.label({ Parent = card, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(170, 22), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, TextColor3 = rc, Text = def.Name, ZIndex = 23 })
		local text = Descriptions.Weapon(def.Id)
		c.Rarity = UI.label({ Parent = card, Position = UDim2.fromOffset(10, 32), Size = UDim2.fromOffset(170, 14), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = def.Rarity .. (def.Free and " · FREE" or "") .. "  ·  " .. text.Tag, ZIndex = 23 })
		c.Level = UI.label({ Parent = card, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(60, 34), TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBlack, Text = "L1", ZIndex = 23 })
		-- v0.9.17 descriptions: what it does + the numbers that never change with level
		c.Desc = UI.label({ Parent = card, Position = UDim2.fromOffset(10, 50), Size = UDim2.new(1, -20, 0, 32), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextScaled = false, TextSize = 13, TextWrapped = true, TextColor3 = Col.Text, Text = text.Desc, ZIndex = 23 })
		UI.new("UITextSizeConstraint", { Parent = c.Desc, MaxTextSize = 13 })
		c.Info = UI.label({ Parent = card, Position = UDim2.fromOffset(10, 84), Size = UDim2.new(1, -20, 0, 13), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = Descriptions.Stats(def.Id), ZIndex = 23 })
		c.Fill, c.BarText = bar(card, UDim2.fromOffset(10, 102), UDim2.new(1, -20, 0, 18), rc)
		c.Stats = UI.label({ Parent = card, Position = UDim2.fromOffset(10, 124), Size = UDim2.new(1, -20, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Text, ZIndex = 23 })
		c.Equip = UI.button({ Parent = card, Position = UDim2.fromOffset(10, 144), Size = UDim2.fromOffset(140, 26), Text = "EQUIP", ZIndex = 23 })
		c.Forge = UI.button({ Parent = card, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 144), Size = UDim2.fromOffset(84, 26), Text = "FORGE", BackgroundColor3 = Col.Lava, ZIndex = 23 })
		c.Equip.Activated:Connect(function()
			if not owned(def.Id) then
				showTab("Vault")
				return
			end
			local res = call("Equip", def.Id)
			if res and res.Ok then
				setStatus("Equipped " .. def.Name .. ".", Col.Good)
				EffectsController.Play("Click", 0.6, 1.2)
			end
		end)
		c.Forge.Activated:Connect(function()
			selectedForge = def.Id
			showTab("Forge")
		end)
		cards[def.Id] = c
	end
end

refreshers.Weapons = function()
	local p = profile
	if not p then
		return
	end
	local parts = {}
	for _, r in Rarity.Order do
		local n = p.Wildcards and p.Wildcards[r] or 0
		table.insert(parts, string.format('<font color="#%s">%s %d</font>', Rarity.Colors[r]:ToHex(), r:sub(1, 1), n))
	end
	refs.WildLine.Text = "WILDCARDS:  " .. table.concat(parts, "  ·  ") .. "     (make them in the Forge)"
	local devWeapon = p.DevWeapon
	for _, def in Weapons.List do
		local c = cards[def.Id]
		local o = owned(def.Id)
		if o then
			c.Card.BackgroundTransparency = 0
			c.Level.Text = "L" .. o.Level
			c.Level.TextColor3 = Col.Text
			local need = Progression.CopiesFor(def.Rarity, o.Level)
			if o.Level >= Rarity.MaxLevel then
				c.Fill.Size = UDim2.fromScale(1, 1)
				c.BarText.Text = "MAX LEVEL"
			else
				local n = need or 1
				c.Fill.Size = UDim2.fromScale(math.clamp(o.Copies / n, 0, 1), 1)
				c.BarText.Text = string.format("%d / %d copies to L%d", o.Copies, n, o.Level + 1)
			end
			c.Stats.Text = string.format("%s  ·  PWR %d", Progression.KBText(def, o.Level), Rarity.PWR(def.Rarity, o.Level))
			local equipped = p.Equipped == def.Id and not devWeapon
			c.Equip.Text = equipped and "EQUIPPED" or "EQUIP"
			c.Equip.BackgroundColor3 = equipped and Col.Good or Col.Panel
			c.Equip.TextColor3 = equipped and Color3.new(0, 0, 0) or Col.Text
			c.Forge.Visible = true
			c.Stroke.Transparency = equipped and 0 or 0.4
		else
			c.Card.BackgroundTransparency = 0.45
			c.Level.Text = "?"
			c.Level.TextColor3 = Col.Mute
			c.Fill.Size = UDim2.fromScale(0, 1)
			c.BarText.Text = "LOCKED — win it in the Spin Vault"
			c.Stats.Text = string.format("%s at L1  ·  PWR %d", Progression.KBText(def, 1), Rarity.PWR(def.Rarity, 1))
			c.Equip.Text = "GET IT"
			c.Equip.BackgroundColor3 = Col.Panel
			c.Equip.TextColor3 = Col.Mute
			c.Forge.Visible = false
			c.Stroke.Transparency = 0.7
		end
	end
end

