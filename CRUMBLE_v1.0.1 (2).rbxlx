		{ a = 1, b = 0.12, e = "smooth", pose = { LeftHip = E(24, 0, 0), LeftKnee = E(-24, 0, 0), LeftShoulder = E(-24, 0, -22), Neck = E(-8, 0, 0), RightElbow = CFrame.identity, RightShoulder = E(20, 0, 0), Root = CFrame.new(0, -0.22, -0.38) * E(-11, -8, 0), Waist = E(-20, -6, 0) } },
		{ a = 1, b = 0.24, e = "smooth", pose = { LeftElbow = E(60, 0, 0), LeftKnee = E(-10, 0, 0), LeftShoulder = E(40, 0, -26), RightElbow = E(114, 0, 0), RightHip = E(-12, 0, 0), RightKnee = E(-22, 0, 0), RightShoulder = E(62, 0, 12), Root = CFrame.new(0, -0.2, 0.3) * E(12, 8, 0), Waist = E(16, 8, 0) } },
		{ a = 1, b = 0.37, e = "smooth", pose = { LeftElbow = E(64, 0, 0), LeftKnee = E(-12, 0, 0), LeftShoulder = E(44, 0, -28), RightElbow = E(120, 0, 0), RightHip = E(-14, 0, 0), RightKnee = E(-26, 0, 0), RightShoulder = E(72, 0, 18), Root = CFrame.new(0, -0.26, 0.34) * E(13, 14, 0), Waist = E(18, 14, 0) } },
		{ a = 1, b = 0.45, e = "snap", pose = { LeftHip = E(22, 0, 0), LeftKnee = E(-26, 0, 0), LeftShoulder = E(-20, 0, -36), Neck = E(-6, 0, 0), RightElbow = E(10, 0, 0), RightShoulder = E(120, -24, 28), Root = CFrame.new(0, -0.3, -0.3) * E(-10, -22, 0), Waist = E(-14, -30, 0) } },
		{ a = 1, b = 0.52, e = "smooth", pose = { LeftHip = E(22, 0, 0), LeftKnee = E(-26, 0, 0), LeftShoulder = E(-18, 0, -34), RightElbow = E(12, 0, 0), RightShoulder = E(112, -28, 26), Root = CFrame.new(0, -0.32, -0.34) * E(-11, -24, 0), Waist = E(-14, -32, 0) } },
		{ a = 1, b = 0.66, e = "smooth", pose = { LeftShoulder = E(-6, 0, -24), RightElbow = E(22, 0, 0), RightShoulder = E(64, -36, 22), Root = CFrame.new(0, -0.12, -0.12) * E(-4, -12, 0), Waist = E(-8, -24, 0) } },
