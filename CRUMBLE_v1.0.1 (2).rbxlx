		{ a = 1, b = 0, e = "accel", pose = { LeftHip = E(16, 0, 0), LeftShoulder = E(36, 0, -24), RightElbow = E(72, 0, 0), RightKnee = E(-10, 0, 0), RightShoulder = E(180, 0, 8), Root = CFrame.new(0, 0.05, 0.2) * E(8, 8, 0), Waist = E(14, 10, 0) } },
