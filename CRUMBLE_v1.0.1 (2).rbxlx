	return r
end

BUILDERS.VoidHook = function(k)
	-- approved look (slim dark-purple cane, dark curled crook, glowing magenta orb with a ring under
	-- the crook, no blade), 1.15× bigger; the crook and ring are smooth tubes now.
	k.Scale *= 1.15
	local r = sres(k, Vector3.new(0, -1.4, 0), Vector3.new(0, -3.6, -0.9), Vector3.new(0, -2.2, 0), 0.7)
	local shaft, dark = Color3.fromRGB(70, 40, 116), Color3.fromRGB(30, 24, 44)
	local magenta = Color3.fromRGB(236, 64, 210)
	egg(k, Vector3.new(0.36, 0.26, 0.36), Vector3.new(0, 0.74, 0), dark, M.Metal) -- ferrule
	Art.CylY(k, 0.28, 2.7, Vector3.new(0, -0.7, 0), shaft)
	Art.CylY(k, 0.34, 0.5, Vector3.new(0, 0.1, 0), Color3.fromRGB(40, 28, 60), M.Fabric) -- grip wrap
	table.insert(r.Accents, egg(k, Vector3.new(0.38, 0.12, 0.38), Vector3.new(0, -0.2, 0), dark, M.Metal, "Accent"))
	table.insert(r.Accents, egg(k, Vector3.new(0.38, 0.12, 0.38), Vector3.new(0, -1.3, 0), dark, M.Metal, "Accent"))
	local cc = Vector3.new(0, -2.25, 0)
	egg(k, Vector3.new(0.36, 0.16, 0.36), cc + Vector3.new(0, 0.38, 0), dark, M.Metal) -- orb collar
	local core = Art.Ball(k, 0.62, cc, magenta, M.Neon, "Core")
	bend(k, function(t)
		return cc + Vector3.new(math.cos(t) * 0.46, 0, math.sin(t) * 0.46)
	end, 0, 360, 16, 0.08, dark, M.Metal, false) -- ring
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 10
	pe.Lifetime = NumberRange.new(0.4, 0.8)
	pe.Speed = NumberRange.new(0.3, 0.8)
	pe.Size = NumberSequence.new(0.3, 0)
	pe.Color = ColorSequence.new(magenta, C.VoidDark)
	pe.LightEmission = 0.6
	pe.Parent = core
	Art.CylY(k, 0.26, 0.42, Vector3.new(0, -2.72, 0), shaft)
	local hc, hr = Vector3.new(0, -3.05, -0.5), 0.5
	bend(k, function(t)
		return hc + Vector3.new(0, math.cos(t) * hr, math.sin(t) * hr)
	end, 90, 290, 10, 0.24, dark, M.Metal)
	local e = math.rad(290)
	local n = Vector3.new(0, math.cos(e), math.sin(e))
	local tipP = hc + n * hr
	local c2, r2 = tipP + n * 0.16, 0.16
	local phi0 = math.atan2(-n.Z, -n.Y)
	bend(k, function(t)
		return c2 + Vector3.new(0, math.cos(t) * r2, math.sin(t) * r2)
	end, math.deg(phi0), math.deg(phi0) - 220, 5, 0.18, dark, M.Metal)
	table.insert(r.Gems, Art.Ball(k, 0.18, Vector3.new(0, -0.5, -0.15), SILVER, M.Metal, "Gem"))
	k.Scale /= 1.15
	return r
end

------------------------------------------------------------------------
-- Rarity finish + level stages
------------------------------------------------------------------------
local function emitter(parent: Instance, color: Color3, rate: number, size: number, speed: number, life: number, emission: number): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(life * 0.6, life)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = emission
	pe.LightInfluence = 0
	pe.Parent = parent
	return pe
end

local function collect(model: Model, name: string, into: { BasePart })
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name == name and not table.find(into, d) then
			table.insert(into, d)
		end
	end
end

local function applyFinish(model: Model, handle: BasePart, r: BuildResult, rarity: string, level: number)
	local color = Rarity.Colors[rarity] or Color3.new(1, 1, 1)
	local idx = Rarity.Index(rarity)
	collect(model, "Accent", r.Accents)
	collect(model, "Gem", r.Gems)

	-- rarity gem (Uncommon+)
	if idx >= 2 then
		for _, g in r.Gems do
			g.Color = color
			g.Material = M.Neon
		end
	end
	-- L3 coloured finish / L4 glowing accents
	if level >= 3 then
		for _, a in r.Accents do
			a.Color = if level >= 4 then color else Art.Shade(color, 0.75)
			a.Material = if level >= 4 then M.Neon else M.Metal
		end
	end
	-- light: rarity baseline, stronger with glowing accents
	-- v0.9.13: softer (was 0.6 + 0.35/tier + 0.8 → up to 2.45, it lit up whole lobby corners)
	local brightness = (idx >= 3 and 0.45 + (idx - 3) * 0.25 or 0) + (level >= 4 and 0.45 or 0)
	if brightness > 0 then
		Art.Light(handle, color, 6 + idx, brightness)
	end
	-- rarity particles
	if idx == 4 then
		local pe = emitter(handle, color, 3, 0.18, 1, 0.8, 1)
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	elseif idx == 5 then
		local pe = emitter(handle, Color3.fromRGB(255, 200, 80), 6, 0.16, 2, 1.0, 1)
		pe.Acceleration = Vector3.new(0, 4, 0)
	elseif idx == 6 then
		local wisps = emitter(handle, Color3.fromRGB(30, 8, 20), 8, 0.6, 0.6, 1.0, 0)
		wisps.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		emitter(handle, color, 4, 0.2, 1.5, 0.7, 1)
	end
	-- L5 swing trail (AnimationController enables it during swings)
	if level >= 5 then
		local a0 = handle:FindFirstChild("TrailTop") :: Attachment?
		local a1 = handle:FindFirstChild("TrailTip") :: Attachment?
		if not a0 then
			local att = Instance.new("Attachment")
			att.Name = "TrailTop"
			att.Position = r.TrailTop
			att.Parent = handle
			a0 = att
		end
		if not a1 then
			local att = Instance.new("Attachment")
			att.Name = "TrailTip"
			att.Position = r.TrailTip
			att.Parent = handle
			a1 = att
		end
		local trail = Instance.new("Trail")
		trail.Name = "SwingTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
		trail.Lifetime = 0.22
		trail.LightEmission = 0.8
		trail.FaceCamera = true
		trail.Enabled = false
		trail.Parent = handle
	end
	-- L7 aura
	if level >= 7 then
		local aura = emitter(handle, color, 14, 0.35, 1.2, 0.9, 0.9)
		aura.Name = "Aura"
		aura.Shape = Enum.ParticleEmitterShape.Sphere
		aura.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	end
	-- L10 ascended: halo ring + white-gold sparkle (scale applied by caller)
	if level >= 10 then
		local k = Art.Kit(model, handle, handle.CFrame, 1)
		local hr = r.HaloRadius + 0.25
		bend(k, function(t) -- v0.9.18c: a smooth neon tube ring
			return r.HaloAt + Vector3.new(math.cos(t) * hr, 0, math.sin(t) * hr)
		end, 0, 360, 20, 0.09, Color3.fromRGB(255, 244, 214), M.Neon, false)
		local sp = emitter(handle, Color3.fromRGB(255, 244, 214), 8, 0.22, 2, 1.1, 1)
		sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	end
	model:SetAttribute("Rarity", rarity)
	model:SetAttribute("Level", level)
end

local function newHandle(model: Model): Part
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	Art.Decor(handle)
	handle.CFrame = CFrame.new()
	handle.Parent = model
	model.PrimaryPart = handle
	return handle
end

local function buildModel(weaponId: string, rarity: string, level: number, side: string): Model
	local custom = ReplicatedStorage:FindFirstChild("WeaponModels")
	local src = custom and custom:FindFirstChild(weaponId)
	local model: Model
	local r: BuildResult
	local procedural = true
	if src and src:IsA("Model") and src:FindFirstChild("Handle") then
		procedural = false
		model = src:Clone()
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				Art.Decor(d)
			end
		end
		model.PrimaryPart = model:FindFirstChild("Handle") :: BasePart
		local ext = model:GetExtentsSize()
		r = result(Vector3.zero, Vector3.new(0, -ext.Y, 0), Vector3.new(0, -ext.Y * 0.5, 0), math.max(ext.X, ext.Z) * 0.5)
	else
		model = Instance.new("Model")
		local handle = newHandle(model)
		local builder = BUILDERS[weaponId] or BUILDERS.Boot
		r = builder(Art.Kit(model, handle, handle.CFrame, 1), side)
	end
	applyFinish(model, model.PrimaryPart :: BasePart, r, rarity, level)
	-- v0.9.11: every weapon carries an "FxTip" attachment where cast effects start (magnet field,
	-- void hook rope, ...)
	do
		local h = model.PrimaryPart :: BasePart
		if h and not h:FindFirstChild("FxTip") then
			local att = Instance.new("Attachment")
			att.Name = "FxTip"
			att.Position = r.TrailTip
			att.Parent = h
		end
	end
	if procedural then
		-- v0.9.20: flatten only plain plastic; canvas/leather/rubber/wood/metal keep their material
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and (d.Material == M.SmoothPlastic or d.Material == M.Plastic) then
				Art.ToonPart(d, 0.15)
			end
		end
		-- v0.7.1: rounded edges on the procedural blocks (after the finish, so edges copy its colours)
		Art.SoftenAll(model, { MaxRadius = 0.26, Ratio = 0.34, MinRadius = 0.08, Filter = function(p) -- v0.9.18b chunkier rounding
			return p.Name ~= "Handle"
		end })
	end
	if level >= 10 then
		pcall(function()
			model:ScaleTo(1.15)
		end)
		-- sphere SpecialMeshes fit their part; make sure ScaleTo didn't scale them twice
		for _, d in model:GetDescendants() do
			if d:IsA("SpecialMesh") and d.MeshType == Enum.MeshType.Sphere then
				d.Scale = Vector3.one
			end
		end
	end
	return model
end

local function findLimb(character: Model, limbType: string, side: string): BasePart?
	if limbType == "Leg" then
		return (character:FindFirstChild(side .. "Foot") or character:FindFirstChild(side .. " Leg")) :: any
	end
	return (character:FindFirstChild(side .. "Hand") or character:FindFirstChild(side .. " Arm")) :: any
end

local function weldTo(model: Model, limb: BasePart, offset: CFrame, character: Model, name: string)
	model.Name = name
	model:PivotTo(limb.CFrame * offset)
	local handle = model.PrimaryPart :: BasePart
	local w = Instance.new("WeldConstraint")
	w.Part0 = limb
	w.Part1 = handle
	w.Parent = handle
	model.Parent = character
end

-- PWR badge over player heads (bots carry their own nameplate)
local function powerBadge(character: Model, rarity: string, level: number, pwr: number)
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head or character:HasTag("CrumbleRig") or character:FindFirstChild("Nameplate", true) then
		return
	end
	local old = head:FindFirstChild("PowerBadge")
	if old then
		old:Destroy()
	end
	local color = Rarity.Colors[rarity] or Color3.new(1, 1, 1)
	local bb = Instance.new("BillboardGui")
	bb.Name = "PowerBadge"
	bb.Size = UDim2.fromOffset(110, level >= 10 and 40 or 22)
	bb.StudsOffset = Vector3.new(0, 1.55, 0)
	bb.MaxDistance = 90
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	local box = Instance.new("TextLabel")
	box.AnchorPoint = Vector2.new(0.5, 1)
	box.Position = UDim2.fromScale(0.5, 1)
	box.Size = UDim2.fromOffset(78, 20)
	-- v0.7.2 reference-style plate: rarity-coloured pill, white text, darker outline
	box.BackgroundColor3 = color
	box.BackgroundTransparency = 0
	box.Font = Enum.Font.FredokaOne
	box.TextSize = 13
	box.TextColor3 = Color3.new(1, 1, 1)
	box.TextStrokeColor3 = Color3.new(color.R * 0.4, color.G * 0.4, color.B * 0.4)
	box.TextStrokeTransparency = 0.3
	box.Text = "PWR " .. pwr .. (level > 1 and ("  L" .. level) or "")
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = box
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(color.R * 0.6, color.G * 0.6, color.B * 0.6)
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = box
	box.Parent = bb
	-- v0.9.22 VIP pass: a gold VIP pill to the left of the power pill
	local okOwner, owner = pcall(function()
		return game:GetService("Players"):GetPlayerFromCharacter(character)
	end)
	if okOwner and owner and owner:GetAttribute("Pass_VIP") == true then
		bb.Size = UDim2.fromOffset(150, level >= 10 and 40 or 22)
		box.Position = UDim2.new(0.5, 20, 1, 0)
		local vip = Instance.new("TextLabel")
		vip.Name = "VIP"
		vip.AnchorPoint = Vector2.new(1, 1)
		vip.Position = UDim2.new(0.5, -23, 1, 0)
		vip.Size = UDim2.fromOffset(38, 20)
		vip.BackgroundColor3 = Color3.fromRGB(255, 196, 40)
		vip.Font = Enum.Font.FredokaOne
		vip.TextSize = 13
		vip.TextColor3 = Color3.fromRGB(92, 52, 0)
		vip.Text = "VIP"
		local vc = Instance.new("UICorner")
		vc.CornerRadius = UDim.new(0, 10)
		vc.Parent = vip
		local vs = Instance.new("UIStroke")
		vs.Color = Color3.fromRGB(150, 96, 0)
		vs.Thickness = 1.5
		vs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		vs.Parent = vip
		vip.Parent = bb
	end
	if level >= 10 then
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, 16)
		t.Font = Enum.Font.FredokaOne
		t.TextSize = 12
		t.TextColor3 = Color3.fromRGB(255, 244, 214)
		t.TextStrokeTransparency = 0.4
		t.Text = "ASCENDED"
		t.Parent = bb
	end
	bb.Parent = head
end

function WeaponVisuals.Remove(character: Model)
	for _, child in character:GetChildren() do
		if child.Name == MODEL_NAME or child.Name == MODEL_NAME .. "L" then
			child:Destroy()
		end
	end
end

-- v1.0 WORN FIT: the boots are built in chunky "toy" proportions for the armory. On a character
-- they are scaled so the shaft just covers the shin and the sole sits on the ground (before, one size
-- fit all and the Big Boot reached the chest). Shaft = shaft width in model units at scale 1.
-- Top = how far above the knee the boot may reach, as a share of the thigh (caps the size on
-- short-legged avatars).
local WORN_FIT: { [string]: { Shaft: number, Cover: number, Top: number } } = {
	Boot = { Shaft = 1.28, Cover = 1.22, Top = 0.15 }, -- shaft 22% wider than the shin (covers bot cuffs); ends at the knee
	BigBoot = { Shaft = 1.44 * 1.3, Cover = 1.45, Top = 0.5 }, -- the big one: 45% wider, up to mid-thigh
}

local function sphereMeshFix(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("SpecialMesh") and d.MeshType == Enum.MeshType.Sphere then
			d.Scale = Vector3.one
		end
	end
end

-- scales a leg weapon to the wearer and returns the weld offset from the foot
local function fitToLeg(model: Model, character: Model, limb: BasePart, weaponId: string): CFrame
	local fit = WORN_FIT[weaponId]
	local handle = model.PrimaryPart
	if not fit or not handle then
		return CFrame.new(0, 0.1, 0)
	end
	local shin = character:FindFirstChild("RightLowerLeg")
	local legW = if shin and shin:IsA("BasePart") then math.min(shin.Size.X, shin.Size.Z) else limb.Size.X
	local before = 1
	pcall(function()
		before = model:GetScale()
	end)
	local w = legW * fit.Cover / fit.Shaft
	-- height cap: sole to top no higher than knee + Top × thigh
	local thigh = character:FindFirstChild("RightUpperLeg")
	if shin and shin:IsA("BasePart") and thigh and thigh:IsA("BasePart") then
		local lo, hi = 0, 0
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d ~= handle then
				local cf = handle.CFrame:ToObjectSpace(d.CFrame)
				local _, _, _, _, _, _, r10, r11, r12 = cf:GetComponents()
				local ey = (math.abs(r10) * d.Size.X + math.abs(r11) * d.Size.Y + math.abs(r12) * d.Size.Z) * 0.5
				lo = math.min(lo, cf.Y - ey)
				hi = math.max(hi, cf.Y + ey)
			end
		end
		local maxTop = limb.Size.Y + shin.Size.Y + thigh.Size.Y * fit.Top
		if hi - lo > 0 then
			w = math.min(w, maxTop / (hi - lo))
		end
	end
	w = math.clamp(w, 0.4, 1.5)
	if math.abs(w - 1) > 0.01 then
		pcall(function()
			model:ScaleTo(before * w)
		end)
		sphereMeshFix(model)
	end
	-- lowest point of the model below its handle (after scaling)
	local minY = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= handle then
			local cf = handle.CFrame:ToObjectSpace(d.CFrame)
			local _, _, _, _, _, _, r10, r11, r12 = cf:GetComponents()
			local ey = (math.abs(r10) * d.Size.X + math.abs(r11) * d.Size.Y + math.abs(r12) * d.Size.Z) * 0.5
			minY = math.min(minY, cf.Y - ey)
		end
	end
	return CFrame.new(0, -limb.Size.Y * 0.5 - minY - 0.02, 0)
end

function WeaponVisuals.Attach(character: Model, weaponId: string, level: number)
	WeaponVisuals.Remove(character)
	local def = Weapons.Get(weaponId)
	local limb = findLimb(character, def.Limb, "Right")
	if not limb then
		return
	end
	-- v0.7.3: per-weapon grip (bat/pan/slingshot/crook sit upright in the fist, see WeaponPoses)
	local model = buildModel(def.Id, def.Rarity, level, "Right")
	local base = if def.Limb == "Leg" then fitToLeg(model, character, limb, def.Id) else CFrame.new(0, -0.1, 0)
	local offset = base * (WeaponPoses.Grip[def.Id] or CFrame.identity)
	weldTo(model, limb, offset, character, MODEL_NAME)

	-- Gloves come as a pair
	if def.Id == "Gloves" then
		local left = findLimb(character, "Arm", "Left")
		if left then
			local m2 = buildModel(def.Id, def.Rarity, level, "Left")
			weldTo(m2, left, offset, character, MODEL_NAME .. "L")
		end
	end
	local pwr = Rarity.PWR(def.Rarity, level)
	character:SetAttribute("WeaponId", def.Id)
	character:SetAttribute("WeaponLevel", level)
	character:SetAttribute("PWR", pwr)
	character:SetAttribute("KOEffect", level >= 8)
	character:SetAttribute("Ascended", level >= 10)
	powerBadge(character, def.Rarity, level, pwr)
end

-- Anchored display copy (lobby armory, Forge/Vault pedestals). Caller parents and positions it.
function WeaponVisuals.BuildDisplay(weaponId: string, level: number): Model
	local def = Weapons.Get(weaponId)
	local model = buildModel(def.Id, def.Rarity, level, "Right")
	model.Name = "Display_" .. def.Id
	;(model.PrimaryPart :: BasePart).Anchored = true
	return model
end

return WeaponVisuals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Weapon definitions (9 launch weapons, v3 doc §12)

	Kind:
	  melee      single target in a forward cone
	  arc        up to MaxTargets in a wide forward arc (Bat; deflects projectiles)
	  aoe        everyone in a 360° radius (Pan)
	  projectile travelling shot (Slingshot)
	  pull       PUSH-PULL (Magnet, v0.9.18): click 1 yanks one target toward you; a 2nd click within
	             RepelWindow fires the REPEL blast (cone push, up to RepelMaxTargets). One cooldown per cycle.
	  thrown     lobbed bomb with a fuse; also drops already-cracked tiles (Bomb Bag)
	  tether     v0.7.1: YANKS the target to you, then launches it along your aim (Void Hook)
	  slam       v0.9.20: overhead smash on a spot in front of you (SlamOffset): everyone within
	             SlamRadius pops up and away, and the tile under the impact starts to crack (Hammer)

	Range/Windup/Cooldown never change with rarity or level. Only KB scales.
	Cone = minimum dot product between your facing and the target (0.5 ≈ 60° half-angle).
]]

export type WeaponDef = {
	Id: string,
	Name: string,
	Rarity: string,
	Kind: string,
	Range: number,
	Windup: number,
	Cooldown: number,
	KB: number,
	Cone: number?,
	MaxTargets: number?,
	Lift: number?,
	ComboKB: number?,
	ComboWindow: number?,
	ComboHits: number?,
	Speed: number?,
	HitRadius: number?,
	Fuse: number?,
	BlastRadius: number?,
	SelfSlow: number?,
	SelfSlowTime: number?,
	SlamDelay: number?, -- tether: seconds between the yank and the launch
	SlamOffset: number?, -- slam: impact point distance in front of you
	SlamRadius: number?, -- slam: hit radius around the impact point
	CrackTile: boolean?, -- slam: the tile under the impact starts cracking (arena only)
	-- v0.9.18 Magnet push-pull follow-up
	RepelKB: number?,
	RepelRange: number?,
	RepelCone: number?,
	RepelWindup: number?,
	RepelMaxTargets: number?,
	RepelWindow: number?, -- seconds after the pull in which the 2nd click repels
	RepelDelay: number?, -- earliest repel after the pull click
	Limb: string, -- "Arm" or "Leg" (for the procedural swing animation)
	Free: boolean?,
	Blurb: string,
}

local Weapons = {}

Weapons.List = {
	{
		Id = "Boot", Name = "Boot", Rarity = "Common", Kind = "melee",
		Range = 6.5, Windup = 0.12, Cooldown = 2.4, KB = 14, Cone = 0.55, MaxTargets = 1,
		Limb = "Leg", Free = true,
		Blurb = "The skill floor. Free forever. Merge Boot copies (from spins) to level it.",
	},
	{
		Id = "Gloves", Name = "Boxing Gloves", Rarity = "Common", Kind = "melee",
		-- NOTE: cooldown 0.7 (doc said 0.8) so the 3rd jab can land inside the 1.5 s combo window.
		Range = 5.5, Windup = 0.08, Cooldown = 0.7, KB = 5.5, Cone = 0.55, MaxTargets = 1, -- v0.9.16: jab 6 → 5.5 (top pressure Common)
		ComboKB = 15, ComboWindow = 1.5, ComboHits = 3, -- v0.9.12 balance: combo 16 → 15 (top KB/s weapon)
		Limb = "Arm",
		Blurb = "Third jab within 1.5 s hits much harder.",
	},
	{
		Id = "BigBoot", Name = "Big Boot", Rarity = "Common", Kind = "melee",
		-- v0.9.12 balance: weakest Common → KB 11 → 12, cooldown 2.8 → 2.5
		-- v0.9.16: still the weakest → windup 0.3 → 0.26, KB 12 → 13, lift 13 → 14, cooldown 2.5 → 2.3
		Range = 6, Windup = 0.26, Cooldown = 2.3, KB = 13, Lift = 14, Cone = 0.55, MaxTargets = 1,
		Limb = "Leg",
		Blurb = "Pops rivals high into the air. Bad landings are the point.",
	},
	{
		Id = "Slingshot", Name = "Slingshot", Rarity = "Uncommon", Kind = "projectile",
		Range = 40, Windup = 0.17, Cooldown = 2.1, KB = 13, Speed = 90, HitRadius = 2.4, -- v0.9.16: weakest weapon → KB 11 → 13, cd 2.8 → 2.2; v1.0: cd 2.2 → 2.1 (was below the Gloves, a Common)
		Limb = "Arm",
		Blurb = "Long range, but you have to lead your shots.",
	},
	{
		Id = "Bat", Name = "Baseball Bat", Rarity = "Uncommon", Kind = "arc",
		Range = 7, Windup = 0.26, Cooldown = 3.7, KB = 15, Cone = 0.5, MaxTargets = 3, -- v0.9.16: cd 3 → 3.7 (3-target arc out-pressured Rare/Epic)
		Limb = "Arm",
		Blurb = "Wide arc, hits up to 3, deflects projectiles.",
	},
	{
		Id = "Pan", Name = "Frying Pan", Rarity = "Rare", Kind = "aoe",
		Range = 6, Windup = 0.22, Cooldown = 5.2, KB = 14, SelfSlow = 0.3, SelfSlowTime = 0.6, -- v0.9.12: cd 4.5 → 4.2; v0.9.16: → 5.2 (360° ring hit too often)
		Limb = "Arm",
		Blurb = "360° panic button. Anti-dogpile insurance.",
	},
	{
		Id = "Hammer", Name = "Squeaky Hammer", Rarity = "Epic", Kind = "slam",
		-- v0.9.20 new weapon (fills Epic after the Magnet moved up to Mythic): a big toy mallet.
		-- Overhead smash 4.5 studs in front: everyone within 4.5 studs pops up and away (max 4) and the
		-- tile under the impact starts cracking. Slow, readable windup; no reach beyond the impact.
		Range = 8, Windup = 0.32, Cooldown = 5.8, KB = 15, Lift = 9, MaxTargets = 4,
		SlamOffset = 4.5, SlamRadius = 4.5, CrackTile = true,
		Limb = "Arm",
		Blurb = "Smash the floor in front of you: pops everyone there and cracks the tile.",
	},
	{
		Id = "BombBag", Name = "Bomb Bag", Rarity = "Legendary", Kind = "thrown",
		Range = 25, Windup = 0.18, Cooldown = 6.5, KB = 16, Fuse = 1.2, BlastRadius = 7, -- v0.9.16: cd 8 → 6.5; v0.9.20: → 6.3; v1.0: back to 6.5 (a maxed Bomb Bag out-pushed the capped L10 Void Hook)
		Limb = "Arm",
		Blurb = "Lobbed bomb. Also drops tiles that are already cracking.",
	},
	{
		Id = "Magnet", Name = "Magnet", Rarity = "Mythic", Kind = "pull",
		-- (v0.9.21: listed after the Bomb Bag so every menu, the Armory and the Dev grid run Common → Mythic)
		-- v0.9.18 PUSH-PULL: the pull alone never rang anyone out ("the magnet is useless"); now the
		-- red pole pulls, then a 2nd click within 2 s fires the blue pole's REPEL blast.
		-- v0.9.20: Epic → MYTHIC (two powers in one weapon); stats retuned for the Mythic ×1.6 bonus
		-- (tools/balance_sim.py, Mythic band): cycle 4.8 → 6.0 s, repel KB 13.5 → 14.
		Range = 18, Windup = 0.22, Cooldown = 6.0, KB = 13, Cone = 0.5,
		RepelKB = 14, RepelRange = 9, RepelCone = 0.3, RepelWindup = 0.1, RepelMaxTargets = 3,
		RepelWindow = 2.0, RepelDelay = 0.3,
		Limb = "Arm",
		Blurb = "Click to PULL them in, click again to BLAST them away.",
	},
	{
		Id = "VoidHook", Name = "Void Hook", Rarity = "Mythic", Kind = "tether",
		Range = 18, Windup = 0.36, Cooldown = 5.5, KB = 17, Cone = 0.55, SlamDelay = 0.45, -- v0.9.20: cd 5.8 → 5.5 (top of the pressure ladder with the Magnet) -- v0.7.5 nerf (was 22 range / 8 s / 20 KB / 0.4 slam)
		-- v0.9.16: one hook per 9 s gave the Mythic the LOWEST pressure of all nine (tools/balance_sim.py) → windup 0.4 → 0.36 (still a readable,
		-- blockable tell), cone 0.6 → 0.55, cooldown 9 → 5.8. KB unchanged (ladder top stays 27.2 / 33.3).
		Limb = "Arm",
		Blurb = "Yanks a rival to you, then launches them. The strongest hit in the game.",
	},
} :: { WeaponDef }

Weapons.ById = {} :: { [string]: WeaponDef }
for _, w in Weapons.List do
	Weapons.ById[w.Id] = w
end

-- v0.9.18 push-pull follow-up (Magnet). Shared by the server, the Range and the client so their
-- cooldowns agree. Call AFTER the usual `t < readyAt` check. Returns the action ("main" / "repel")
-- or nil when the cycle cooldown is still running, plus the new ready time.
export type FollowState = { RepelUntil: number, CycleAt: number }
function Weapons.NewFollow(): FollowState
	return { RepelUntil = 0, CycleAt = 0 }
end
function Weapons.FollowUp(def: WeaponDef, st: FollowState, t: number): (string?, number)
	if not def.RepelKB then
		return "main", t + def.Cooldown
	end
	if t < st.RepelUntil then
		st.RepelUntil = 0
		st.CycleAt = math.max(st.CycleAt, t + 1.2)
		return "repel", st.CycleAt
	end
	if t < st.CycleAt then
		return nil, st.CycleAt
	end
	st.RepelUntil = t + (def.RepelWindow or 2)
	st.CycleAt = t + def.Cooldown
	return "main", t + (def.RepelDelay or 0.35)
end

function Weapons.Get(id: string?): WeaponDef
	return Weapons.ById[id or "Boot"] or Weapons.ById.Boot
end

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">WeaponModels</string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="17">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	CRUMBLE! — Server bootstrap
	Order matters: data → arena → lobby → combat → bots → rounds → progression → range →
	(v0.9) retention → leaderboards → shop.
]]

local RunService = game:GetService("RunService")

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local ArenaService = require(Services.ArenaService)
local LobbyBuilder = require(Services.LobbyBuilder)
local CombatService = require(Services.CombatService)
local BotService = require(Services.BotService)
local RoundService = require(Services.RoundService)
local ProgressionService = require(Services.ProgressionService)
local RangeService = require(Services.RangeService)
local RetentionService = require(Services.RetentionService)
local LeaderboardService = require(Services.LeaderboardService)
local ShopService = require(Services.ShopService)
local RumbleBoxService = require(Services.RumbleBoxService)
local SocialService = require(Services.SocialService)
local FeedbackService = require(Services.FeedbackService)
local AfkService = require(Services.AfkService)
local VisitorService = require(Services.VisitorService)

-- v0.9.10: every start-up step runs protected, so one error can never stop the rest of the
-- game from starting (no lobby / character / rounds).
local function boot(name: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn(("[CRUMBLE] start-up step %s failed: %s"):format(name, tostring(err)))
	end
end
boot("DataService", DataService.Init)
boot("ArenaService", ArenaService.Build)
boot("LobbyBuilder", function()
	LobbyBuilder.Build()
end)
boot("CombatService", CombatService.Init)
boot("BotService", BotService.Init)
boot("RoundService", RoundService.Init)
boot("ProgressionService", ProgressionService.Init)
boot("RangeService", RangeService.Init)
boot("RetentionService", RetentionService.Init)
boot("LeaderboardService", LeaderboardService.Init)
boot("ShopService", ShopService.Init)
boot("SocialService", SocialService.Init)
boot("FeedbackService", FeedbackService.Init) -- v1.0 patch
boot("AfkService", AfkService.Init) -- v1.0 patch
boot("VisitorService", VisitorService.Init) -- v1.0 patch 8: owner-only visitor log

ProgressionService.SetInRoundCheck(RoundService.IsInRound)
ProgressionService.SetRangeModeSetter(RangeService.SetMode)
RangeService.SetInRoundCheck(RoundService.IsInRound)
RetentionService.SetSparInfo(RangeService.SparInfo)

-- v0.8.3b: every service steps in its own protected call, so an error in one (e.g. a map
-- hazard) can never stop the others — before, one arena error froze every bot for the frame.
local lastWarn: { [string]: number } = {}
local function safeStep(name: string, fn: (...any) -> (), ...: any)
	local ok, err = pcall(fn, ...)
	if not ok then
		local t = os.clock()
		if t - (lastWarn[name] or -99) > 5 then
			lastWarn[name] = t
			warn(("[CRUMBLE] %s.Step error: %s"):format(name, tostring(err)))
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	local t = workspace:GetServerTimeNow()
	safeStep("Arena", ArenaService.Step, dt, t)
	safeStep("Combat", CombatService.Step, dt)
	safeStep("Bot", BotService.Step, dt)
	safeStep("Round", RoundService.Step, dt)
	safeStep("RumbleBox", RumbleBoxService.Step, dt)
	safeStep("Range", RangeService.Step, dt)
end)

task.spawn(RoundService.Run)

print("[CRUMBLE] server ready —", require(game:GetService("ReplicatedStorage").Shared.Config).Version)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">AfkService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — AfkService (v1.0 patch)
	AFK MODE: the player taps AFK in the Yard. While it's on they sit out every match (no join card)
	and every Config.Afk.Interval seconds roll one reward: coins (80%), a low-rarity wildcard (15%)
	or a spin (5%). It switches off when they tap again or join a match (patch 5: it stays on in the Training Range).
	Player attributes (read by the client): AFK (bool), AfkNextAt (server time of the next reward),
	AfkCoins / AfkSpins / AfkWilds (this session's totals).
	Patch 4: Roblox kicks anyone idle for 20 min (games may not fake input), so at 18 idle minutes
	the client asks for "AfkRejoin": the profile is saved and the player hops to a fresh server with
	TeleportData CrumbleAfk = true, which turns AFK back on there.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Services = script.Parent
local DataService = require(Services.DataService)
local ProgressionService = require(Services.ProgressionService)

local AfkService = {}

local A = Config.Afk
local rng = Random.new()
local toastRemote: RemoteEvent? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

-- v1.0 patch 5: a gold "AFK" tag over the head, so everyone can see who is AFK
local function tag(player: Player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("AfkTag")
	local on = player:GetAttribute("AFK") == true
	if not on then
		if old then
			old:Destroy()
		end
		return
	end
	if old then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "AfkTag"
	bb.Size = UDim2.fromOffset(110, 44)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.ResetOnSpawn = false
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.fromRGB(255, 196, 40)
	f.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = f
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = Color3.fromRGB(30, 26, 40)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = f
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0.08, 0.12)
	t.Size = UDim2.fromScale(0.84, 0.76)
	t.Font = Enum.Font.LuckiestGuy
	t.TextScaled = true
	t.Text = "AFK zZ"
	t.TextColor3 = Color3.fromRGB(30, 26, 40)
	t.Parent = f
	f.Parent = bb
	bb.Parent = head
end

local function setAfk(player: Player, on: boolean)
	player:SetAttribute("AFK", on)
	task.spawn(tag, player)
	if on then
		player:SetAttribute("AfkNextAt", now() + A.Interval)
	else
		player:SetAttribute("AfkNextAt", nil)
	end
end

function AfkService.IsAfk(player: Player): boolean
	return player:GetAttribute("AFK") == true
end

function AfkService.Stop(player: Player)
	if AfkService.IsAfk(player) then
		setAfk(player, false)
	end
end

local function pickWild(): string
	local r = rng:NextNumber()
	local acc = 0
	for _, pair in A.WildOdds do
		acc += pair[2]
		if r <= acc then
			return pair[1]
		end
	end
	return A.WildOdds[1][1]
end

local function reward(player: Player)
	local p = DataService.Get(player)
	if not p then
		return
	end
	local r = rng:NextNumber()
	local text: string
	if r < A.Odds.Spin then
		p.Spins += 1
		player:SetAttribute("AfkSpins", ((player:GetAttribute("AfkSpins") :: number?) or 0) + 1)
		text = "AFK REWARD: +1 SPIN!"
	elseif r < A.Odds.Spin + A.Odds.Wildcard then
		local rarity = pickWild()
		p.Wildcards[rarity] = (p.Wildcards[rarity] or 0) + 1
		player:SetAttribute("AfkWilds", ((player:GetAttribute("AfkWilds") :: number?) or 0) + 1)
		text = string.format("AFK REWARD: +1 %s WILDCARD!", string.upper(rarity))
	else
		local c = rng:NextInteger(A.Coins[1], A.Coins[2])
		p.Coins += c
		player:SetAttribute("AfkCoins", ((player:GetAttribute("AfkCoins") :: number?) or 0) + c)
		text = string.format("AFK REWARD: +%d COINS", c)
	end
	DataService.Push(player)
	DataService.SaveSoon(player)
	if toastRemote then
		toastRemote:FireClient(player, text)
	end
end

function AfkService.Init()
	toastRemote = Net.Get("Toast")
	ProgressionService.RegisterAction("AfkToggle", function(player, _p, on)
		local want = on == true
		local char = player.Character
		if want and char and char:GetAttribute("InRound") == true then
			return { Ok = false, Msg = "Finish your match first!" }
		end
		setAfk(player, want)
		if want and toastRemote then
			toastRemote:FireClient(player, "AFK MODE ON: a reward every 2 min. Tap STOP to play.")
		end
		return { Ok = true, Silent = true, AFK = want }
	end)
	-- v1.0 patch 4 ANTI-KICK: the client asks at 18 idle minutes; save, then hop to a fresh server
	local lastHop: { [Player]: number } = {}
	ProgressionService.RegisterAction("AfkRejoin", function(player, _p)
		if not AfkService.IsAfk(player) then
			return { Ok = false, Silent = true }
		end
		if os.clock() - (lastHop[player] or -1e9) < 120 then
			return { Ok = false, Silent = true }
		end
		lastHop[player] = os.clock()
		if RunService:IsStudio() then
			if toastRemote then
				toastRemote:FireClient(player, "AFK: the anti-kick rejoin only works in the live game.")
			end
			return { Ok = false, Silent = true }
		end
		if toastRemote then
			toastRemote:FireClient(player, "AFK: moving you to a fresh server so you don't get kicked...")
		end
		DataService.Save(player) -- saved BEFORE the hop, so the next server loads the newest coins
		local ok, err = pcall(function()
			local opts = Instance.new("TeleportOptions")
			opts:SetTeleportData({ CrumbleAfk = true })
			TeleportService:TeleportAsync(game.PlaceId, { player }, opts)
		end)
		if not ok then
			warn("[CRUMBLE] AFK rejoin failed:", err)
		end
		return { Ok = ok, Silent = true }
	end)
	-- v1.0 patch 9: a hop can fail (server shutting down for an update = GameEnded, Roblox busy, or
	-- Unauthorized). Retry once after a few seconds; if it fails again, tell the player.
	local retried: { [Player]: boolean } = {}
	pcall(function()
		TeleportService.TeleportInitFailed:Connect(function(player: Player, result: Enum.TeleportResult, msg: string)
			if not player.Parent or not AfkService.IsAfk(player) then
				return
			end
			if retried[player] then
				retried[player] = nil
				if toastRemote then
					toastRemote:FireClient(player, "AFK: couldn't switch servers. Move a little every 20 min to avoid the idle kick.")
				end
				return
			end
			retried[player] = true
			task.delay(8, function()
				if player.Parent and AfkService.IsAfk(player) then
					pcall(function()
						local opts = Instance.new("TeleportOptions")
						opts:SetTeleportData({ CrumbleAfk = true })
						TeleportService:TeleportAsync(game.PlaceId, { player }, opts)
					end)
				end
			end)
		end)
	end)
	Players.PlayerRemoving:Connect(function(pl)
		retried[pl] = nil
	end)
	-- arriving from an AFK hop: switch AFK straight back on once the profile has loaded
	local function onJoin(player: Player)
		local okData, data = pcall(function()
			return player:GetJoinData()
		end)
		local td = okData and type(data) == "table" and data.TeleportData or nil
		if type(td) ~= "table" or td.CrumbleAfk ~= true then
			return
		end
		local t0 = os.clock()
		while player.Parent and not DataService.Get(player) and os.clock() - t0 < 30 do
			task.wait(0.5)
		end
		if player.Parent and DataService.Get(player) then
			setAfk(player, true)
			if toastRemote then
				toastRemote:FireClient(player, "AFK MODE still ON: new server, rewards keep coming.")
			end
		end
	end
	local function hook(pl: Player)
		task.spawn(onJoin, pl)
		-- keep the tag in sync (also when other code switches AFK off, e.g. JoinReply / PLAY NOW)
		pl:GetAttributeChangedSignal("AFK"):Connect(function()
			tag(pl)
		end)
		pl.CharacterAdded:Connect(function(char)
			char:WaitForChild("Head", 10)
			tag(pl)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in Players:GetPlayers() do
		hook(pl)
	end
	Players.PlayerRemoving:Connect(function(p)
		p:SetAttribute("AFK", nil)
		lastHop[p] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local t = now()
			for _, player in Players:GetPlayers() do
				if player:GetAttribute("AFK") ~= true then
					continue
				end
				local char = player.Character
				if char and char:GetAttribute("InRound") == true then
					setAfk(player, false) -- joined a match (patch 5: the Training Range keeps AFK on)
					continue
				end
				local nextAt = (player:GetAttribute("AfkNextAt") :: number?) or (t + A.Interval)
				if t >= nextAt then
					player:SetAttribute("AfkNextAt", t + A.Interval)
					local ok, err = pcall(reward, player)
					if not ok then
						warn("[CRUMBLE] AFK reward failed:", err)
					end
				end
			end
		end
	end)
end

return AfkService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ArenaService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — ArenaService
	28×28 pooled 8-stud tiles. Created ONCE and recycled every round (never destroyed).
	States: 0 = healthy, 1 = warned (cracking), 2 = fallen.
	Two collapse systems run together:
	  • Random holes — phase rates from Config.Collapse with a 70/30 outer/inner "funnel".
	  • SHRINK — the whole outer ring flashes and drops together, closing inward all round
	    (Config.Shrink), down to the 4×4-tile core.
	v0.8 MAPS (Config.Maps): the same pooled grid is re-skinned per round (The Grid, Molten Core,
	Ice Rink) with its own palette, sea and themed decor. Map hazards live here too:
	  • Molten Core geysers — a tile bubbles for Warn seconds, then launches everyone on it upward.
	  • Ice Rink frost — random-hole warnings stay hidden for FrostDelay seconds (less time to react).
	Rumble passes a collapse scale (×1.3 faster holes and shrink).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Art = require(Shared.Art)
local BotStyles = require(script.Parent.BotStyles)

local A = Config.Arena
local N = A.Size
local TS = A.TileSize
local HALF = N * TS / 2
local MIN_X = A.Center.X - HALF
local MIN_Z = A.Center.Z - HALF

type Tile = {
	Part: Part,
	IX: number,
	IZ: number,
	Ring: number,
	State: number,
	Outer: boolean,
	ListPos: number,
	FallAt: number,
	RedAt: number,
	Red: boolean,
	CrackAt: number,
	Cracked: boolean,
	BaseColor: Color3,
	BaseMaterial: Enum.Material,
	OrigColor: Color3, -- v0.8.3b the cozy default look (restored between matches)
	OrigMaterial: Enum.Material,
}

local ArenaService = {}

local tiles: { Tile } = {}
local outerList: { number } = {}
local innerList: { number } = {}
local warned: { [number]: boolean } = {}
local ringTiles: { [number]: { number } } = {}

local active = false
local roundStart = 0
local accum = 0
local shrinkRing = 0 -- next ring that will fall (counts down)
local nextShrinkAt = math.huge
local dangerRing = math.huge -- bots treat rings >= this as unsafe
local tileEvent = nil :: any
local occupancyProvider: (() -> { Vector3 })? = nil

local pendingWarn: { number } = {}
local pendingFall: { number } = {}

-- v0.8 maps & hazards
local currentMap = "Grid"
local collapseScale = 1
local clockNow = 0
local frostUntil: { [number]: number } = {} -- warned tiles whose warning is still hidden under frost
local geysers: { [number]: number } = {} -- tile -> erupt time
local nextGeyserAt = math.huge
local geyserHandler: ((Vector3, number) -> ())? = nil
-- v0.8.1 map hazards: Molten magma pools + Ice frost traps
type Pool = { Phase: string, LiveAt: number, EndAt: number, Depth: number, Floor: Part?, Fx: Model? }
local magma: { [number]: Pool } = {}
local nextMagmaAt = math.huge
local traps: { [number]: number } = {} -- tile -> expiry
local trapMarks: { [number]: Instance } = {}
local nextTrapAt = math.huge
local trapHandler: ((number, Vector3) -> ())? = nil
local hazardScale = 1
local clearMagma: (number, boolean) -> ()
local makeMagmaFx: (Vector3, number) -> Model
local setGust: (string, Vector3, number) -> ()
local clearTrap: (number, boolean) -> ()
local magmaAnnounced, trapsAnnounced = false, false
local themeFolders: { [string]: Folder } = {}
-- v0.8.2 map identity: pieces that re-skin per map
local gridSet: Folder? = nil -- the cozy sky-stadium extras (balloons, clouds, blimp...): default look + The Grid
local rimOrig: { [BasePart]: { Color: Color3, Material: Enum.Material } } = {}
local seaOrig: { Color: Color3, Material: Enum.Material }? = nil
local rimParts: { { Part: BasePart, Kind: string } } = {}
local rimRocks: Folder? = nil
local blizzard: Part? = nil
-- v0.8.2 hazards
type Drop = { Tile: number, At: number, SnapAt: number, Model: Model?, Cable: BasePart?, Top: Vector3, Landed: boolean, GoneAt: number }
local drops: { Drop } = {}
local nextDropAt = math.huge
local dropHandler: ((Vector3, number) -> ())? = nil
local eruptionDone = false
local nextGustAt = math.huge
local gustPhase = "" -- "" | "warn" | "blow"
local gustDir = Vector3.zero
local gustChangeAt = 0
local cloudSea: Part? = nil
local tintParts: { BasePart } = {} -- v0.8.3 stadium parts re-tinted per map
local stadium: Folder? = nil -- v0.8.5 the cozy stands + scoreboard (hidden on Molten/Ice: they get themed copies)
local ServerStorage = game:GetService("ServerStorage")

tileEvent = Net.Get("TileEvent")
local announceRemote = Net.Get("Announce")
local folder: Folder

local function index(ix: number, iz: number): number
	return iz * N + ix + 1
end

local function ringOf(ix: number, iz: number): number
	local c = N / 2
	return math.floor(math.max(math.abs(ix + 0.5 - c), math.abs(iz + 0.5 - c)))
end

function ArenaService.TileCenter(i: number): Vector3
	local t = tiles[i]
	return Vector3.new(MIN_X + (t.IX + 0.5) * TS, A.Center.Y, MIN_Z + (t.IZ + 0.5) * TS)
end

function ArenaService.TileAt(pos: Vector3): number?
	local ix = math.floor((pos.X - MIN_X) / TS)
	local iz = math.floor((pos.Z - MIN_Z) / TS)
	if ix < 0 or iz < 0 or ix >= N or iz >= N then
		return nil
	end
	return index(ix, iz)
end

-- The state as players can SEE it: a frosted warning still looks healthy; a bubbling geyser
-- tile counts as unsafe. Bots use this, so they're fooled by frost exactly like players.
local function seenState(i: number): number
	local t = tiles[i]
	if not t then
		return 2
	end
	if t.State == 0 and (geysers[i] or magma[i]) then
		return 1 -- bubbling geyser / magma pool: visibly unsafe (frost traps are NOT, they're sneaky)
	end
	if t.State == 0 then
		for _, d in drops do
			if not d.Landed and d.Tile == i then
				return 1 -- a crane weight's shadow
			end
		end
	end
	if t.State == 1 and frostUntil[i] and clockNow < frostUntil[i] then
		return 0
	end
	return t.State
end

function ArenaService.TileState(i: number?): number
	if not i then
		return 2
	end
	return seenState(i)
end

function ArenaService.IsSafeAt(pos: Vector3): boolean
	local i = ArenaService.TileAt(pos)
	if ArenaService.TileState(i) ~= 0 then
		return false
	end
	return tiles[i :: number].Ring < dangerRing
end

function ArenaService.GetTiles()
	return tiles
end

function ArenaService.GetFolder(): Folder
	return folder
end

function ArenaService.SetOccupancyProvider(fn: () -> { Vector3 })
	occupancyProvider = fn
end

function ArenaService.Elapsed(now: number): number
	return active and (now - roundStart) or 0
end

------------------------------------------------------------------------
-- Healthy-list bookkeeping (O(1) swap-remove)
------------------------------------------------------------------------
local function listAdd(i: number)
	local t = tiles[i]
	local list = t.Outer and outerList or innerList
	table.insert(list, i)
	t.ListPos = #list
end

local function listRemove(i: number)
	local t = tiles[i]
	local list = t.Outer and outerList or innerList
	local pos = t.ListPos
	if pos <= 0 or list[pos] ~= i then
		return
	end
	local last = list[#list]
	list[pos] = last
	tiles[last].ListPos = pos
	list[#list] = nil
	t.ListPos = 0
end

------------------------------------------------------------------------
-- Build (once)
------------------------------------------------------------------------
------------------------------------------------------------------------
-- v0.7.3 set dressing ("Sky Stadium" layout, v0.7.2 reference style): wooden frame, hanging rock,
-- crescent stands, Scoreboard Island, hot-air balloons, lantern-isle trail, blimp, cloud sea.
-- Everything is non-colliding and non-queryable: art never changes the floor or the KO plane.
------------------------------------------------------------------------
local WOOD = Color3.fromRGB(212, 156, 100)
local WOOD_DARK = Color3.fromRGB(150, 102, 70)
local ROCK = Color3.fromRGB(168, 158, 196)
local ROCK_DARK = Color3.fromRGB(128, 118, 162)
local GRASS = Color3.fromRGB(116, 196, 98)
local GUIDE = Color3.fromRGB(130, 232, 255) -- cool guide-line glow: never amber/red (those mean "cracking")
local LANTERN = Color3.fromRGB(255, 220, 160)

-- a small floating island: grass cap, dirt band, tapered rock underneath
local function miniIsland(parent: Instance, top: Vector3, r: number, seed: number, low: boolean?)
	Art.Island(parent, top, r, seed, GRASS, ROCK, ROCK_DARK, { Low = low }) -- v0.8 low-poly island
end

local function pine(parent: Instance, base: Vector3, h: number)
	Art.Pine(parent, base, h, nil, false) -- v0.8 low-poly pine (decor near the arena never collides)
end

-- v0.9.14 CROWD = MINI BOTS: a light version of the fighting bots (helmet, dark face screen, glowing
-- eyes, body + chest plate in the bot's own colours, cheering arms). ~6–8 parts each.
local FAN_STYLES: { BotStyles.Style } = {}
for _, nm in Config.Bots.Names do
	local st = BotStyles.Get(nm)
	if st then
		table.insert(FAN_STYLES, st)
	end
end
local FAN_SCREEN = Color3.fromRGB(22, 24, 36)
local function miniBotFan(S: (props: { [string]: any }) -> Part, fan: CFrame, st: BotStyles.Style, h: number, n: number)
	local function soft(p: Part)
		p:SetAttribute("Softened", true)
	end
	-- body (rounded capsule) + chest plate + belt
	S({ Name = "Fan", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.2, 1.9, 1.9), CFrame = fan * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = st.Body })
	soft(S({ Name = "FanPlate", Size = Vector3.new(1.3, 1.1, 0.3), CFrame = fan * CFrame.new(0, 0.35, 0.86), Color = st.Trim }))
	S({ Name = "FanPlate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 2.0, 2.0), CFrame = fan * CFrame.new(0, -0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = st.Legs })
	-- big round helmet, dark screen facing the arena (+Z), glowing eyes
	local hc = fan * CFrame.new(0, 2.15, 0)
	S({ Name = "FanHead", Shape = Enum.PartType.Ball, Size = Vector3.new(2.1, 2.1, 2.1), CFrame = hc, Color = st.Body })
	soft(S({ Name = "FanScreen", Size = Vector3.new(1.5, 0.95, 0.4), CFrame = hc * CFrame.new(0, -0.02, 0.82), Color = FAN_SCREEN }))
	if st.Face == "Visor" or st.Face == "Mono" then
		soft(S({ Name = "FanEye", Size = Vector3.new(st.Face == "Mono" and 0.4 or 1.1, 0.2, 0.08), CFrame = hc * CFrame.new(0, 0.06, 1.04), Color = st.Glow, Material = Enum.Material.Neon }))
	else
		for _, sx in { -1, 1 } do
			S({ Name = "FanEye", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.08, 0.32, 0.32), CFrame = hc * CFrame.new(sx * 0.27, 0.08, 1.04) * CFrame.Angles(0, math.rad(90), 0), Color = st.Glow, Material = Enum.Material.Neon })
		end
	end
	-- ear caps in the trim colour
	for _, sx in { -1, 1 } do
		S({ Name = "FanPlate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.22, 0.7, 0.7), CFrame = hc * CFrame.new(sx * 1.02, 0, 0), Color = st.Trim })
	end
	-- arms: cheering (both up) / waving (one up) / resting, with the white cartoon mitts
	local pose = if h > 0.72 then 2 elseif h > 0.45 then 1 else 0
	for i, sx in { -1, 1 } do
		local up = pose == 2 or (pose == 1 and i == 2)
		local sh = fan * CFrame.new(sx * 1.05, 0.7, 0)
		local tip = if up then sh * CFrame.new(sx * 0.35, 1.5, 0.2) else sh * CFrame.new(sx * 0.15, -1.0, 0.25)
		local mid = sh.Position:Lerp(tip.Position, 0.5)
		local len = (tip.Position - sh.Position).Magnitude
		S({ Name = "FanArm", Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, 0.55, 0.55), CFrame = CFrame.lookAt(mid, tip.Position) * CFrame.Angles(0, math.rad(90), 0), Color = st.Body })
		S({ Name = "FanMitt", Shape = Enum.PartType.Ball, Size = Vector3.new(0.75, 0.75, 0.75), CFrame = tip, Color = Color3.fromRGB(250, 250, 255) })
	end
	-- a few hold a foam finger in their style colour
	if h > 0.9 then
		local tip = fan * CFrame.new(1.4, 2.4, 0.2)
		soft(S({ Name = "FoamFinger", Size = Vector3.new(0.9, 1.8, 0.4), CFrame = tip * CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.rad(-10)), Color = st.Glow }))
	end
	local _ = n
end

local function buildDecor(root: Folder)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = root
	local c = A.Center
	local topY = c.Y - A.TileThickness
	-- v0.8.2: the cozy sky extras belong to The Grid's theme (swapped out on other maps)
	local gs = Instance.new("Folder")
	gs.Name = "CozySky"
	gs.Parent = root
	gridSet = gs
	local rr = Instance.new("Folder")
	rr.Name = "RimRocks"
	rr.Parent = decor
	rimRocks = rr
	local function snapshot(): { [Instance]: boolean }
		local set = {}
		for _, ch in decor:GetChildren() do
			set[ch] = true
		end
		return set
	end
	local function moveNew(snap: { [Instance]: boolean })
		for _, ch in decor:GetChildren() do
			if not snap[ch] then
				ch.Parent = gs
			end
		end
	end

	-- frame: chunky wooden beams just below floor level (no ledge to stand on) + soft guide glow
	for side = 0, 3 do
		local horizontal = side < 2
		local sgn = (side % 2 == 0) and -1 or 1
		local len = N * TS + 8
		local size = horizontal and Vector3.new(len, 5, 4) or Vector3.new(4, 5, len)
		local pos = horizontal and Vector3.new(c.X, topY - 1.5, c.Z + sgn * (HALF + 2)) or Vector3.new(c.X + sgn * (HALF + 2), topY - 1.5, c.Z)
		table.insert(rimParts, { Part = Art.Static(decor, { Name = "Rim", Size = size, CFrame = CFrame.new(pos), Color = WOOD }), Kind = "Rim" })
		local band = horizontal and Vector3.new(len + 0.4, 1, 4.4) or Vector3.new(4.4, 1, len + 0.4)
		table.insert(rimParts, { Part = Art.Static(decor, { Name = "RimBand", Size = band, CFrame = CFrame.new(pos - Vector3.new(0, 1.6, 0)), Color = WOOD_DARK }), Kind = "RimBand" })
		local strip = horizontal and Vector3.new(len, 0.4, 0.3) or Vector3.new(0.3, 0.4, len)
		local spos = pos + (horizontal and Vector3.new(0, 0.9, sgn * 2.1) or Vector3.new(sgn * 2.1, 0.9, 0))
		table.insert(rimParts, { Part = Art.Static(decor, { Name = "RimGlow", Size = strip, CFrame = CFrame.new(spos), Color = GUIDE, Material = Enum.Material.Neon, Transparency = 0.2 }), Kind = "RimGlow" })
		-- hanging rock chunks outside the tile area (the arena reads as a floating island)
		for k = 0, 9 do
			local h = Art.Hash(side, k, 7)
			local along = -HALF + (k + 0.5) * (N * TS / 10)
			local depth = 10 + h * 22
			local w = 12 + h * 8
			local out = HALF + 4.5
			-- v0.8: faceted rock shards instead of boxes
			local top = horizontal and Vector3.new(c.X + along, topY - 3.5, c.Z + sgn * (out - 1)) or Vector3.new(c.X + sgn * (out - 1), topY - 3.5, c.Z + along)
			Art.Shard(rimRocks :: Folder, top, w * 0.42, depth + 6, side * 31 + k, k % 2 == 0 and ROCK or ROCK_DARK, 5)
		end
	end

	-- cloud sea far below the KO plane + soft puffs + drifting white sparkles (reference look)
	cloudSea = Art.Static(decor, {
		Name = "CloudSea", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 760, 760),
		CFrame = CFrame.new(c.X, A.KillY - 55, c.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(222, 218, 252), Transparency = 0.1,
	})
	local snapClouds = snapshot()
	for k = 1, 22 do
		local ang = k / 22 * math.pi * 2
		local rad = 120 + Art.Hash(k, 3) * 220
		local sz = 26 + Art.Hash(k, 9) * 40
		Art.Static(decor, { Name = "CloudPuff", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz * 0.55, sz), CFrame = CFrame.new(c.X + math.cos(ang) * rad, A.KillY - 52 + Art.Hash(k, 5) * 6, c.Z + math.sin(ang) * rad), Color = Color3.fromRGB(246, 244, 255) })
	end
	local motes = Art.Static(decor, { Name = "Sparkles", Size = Vector3.new(N * TS + 120, 1, N * TS + 120), CFrame = CFrame.new(c.X, topY - 30, c.Z), Transparency = 1 })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(8, 12)
	pe.Speed = NumberRange.new(2, 4)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.45), NumberSequenceKeypoint.new(1, 0) })
	pe.Color = ColorSequence.new(Color3.new(1, 1, 1))
	pe.LightEmission = 0.8
	pe.Transparency = NumberSequence.new(0.1, 0.6)
	pe.Parent = motes
	moveNew(snapClouds)

	--------------------------------------------------------------------
	-- v0.7.3 SURROUNDINGS LAYOUT ("Sky Stadium"):
	--   east + west  curved crescent stands (4 tiers, crowd with foam fingers, striped canopy)
	--   north        the Scoreboard Island: tower, giant CRUMBLE! board, screens, firework cannons
	--   corners      hot-air balloons tethered over little islands
	--   south        open sight-line to the Yard, with a trail of tiny lantern islands below it
	--   far ring     floating tree islands and a slow blimp
	--------------------------------------------------------------------
	local function S(props: { [string]: any }): Part
		return Art.Static(decor, props)
	end
	local function cylY(name: string, pos: Vector3, h: number, d: number, color: Color3, mat: Enum.Material?): Part
		return S({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, d, d), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = mat or Enum.Material.SmoothPlastic })
	end
	-- v0.9.14 BRAND PALETTE: stand segments alternate orange / teal (striped with cream), gold pennants
	local STRIPES = { Art.Brand.Orange, Art.Brand.Teal }
	local TIER_WOOD = { WOOD, Color3.fromRGB(194, 138, 88), Color3.fromRGB(226, 176, 112), Color3.fromRGB(180, 124, 84) }
	local GEMS = { Color3.fromRGB(90, 220, 230) } -- v0.9.14: one crystal colour
	local CREAM = Color3.fromRGB(252, 248, 238)

	-- crescent stands
	for _, sideYaw in { 90, -90 } do
		local segs, spread = 7, 84
		local R0 = HALF + 46
		for sgi = 0, segs - 1 do
			local segId = (sideYaw > 0 and 0 or 3) + sgi
			local segCol = STRIPES[segId % #STRIPES + 1]
			local yaw = math.rad(sideYaw + (sgi - (segs - 1) / 2) * (spread / segs))
			local base = CFrame.new(c) * CFrame.Angles(0, yaw, 0)
			local function at(tier: number): CFrame
				return base * CFrame.new(0, -6 + tier * 5, -(R0 + tier * 7))
			end
			local width = 2 * (R0 + 21) * math.sin(math.rad(spread / segs / 2)) + 1.5
			for tier = 0, 3 do
				local cf = at(tier)
				local wT = 2 * (R0 + tier * 7) * math.sin(math.rad(spread / segs / 2)) + 1.5
				S({ Name = "Stand", Size = Vector3.new(wT, 5, 7), CFrame = cf, Color = TIER_WOOD[(tier + sgi) % #TIER_WOOD + 1] })
				S({ Name = "StandEdge", Size = Vector3.new(wT, 0.5, 0.6), CFrame = cf * CFrame.new(0, 2.6, -3.3), Color = segCol })
				-- v0.9.10: front trim strip + seat-back boards in the segment colour
				S({ Name = "StandTrim", Size = Vector3.new(wT, 0.6, 0.4), CFrame = cf * CFrame.new(0, 2.2, 3.4), Color = Art.Shade(segCol, 0.8) })
				if tier < 3 then
					S({ Name = "SeatBack", Size = Vector3.new(wT - 1, 1.6, 0.5), CFrame = cf * CFrame.new(0, 3.3, -2.6), Color = (tier % 2 == 0) and CREAM or Art.Shade(segCol, 1.08) })
				end
				if tier == 0 then
					-- front railing (cream rail, posts every ~5 studs)
					S({ Name = "Rail", Shape = Enum.PartType.Cylinder, Size = Vector3.new(wT - 0.6, 0.45, 0.45), CFrame = cf * CFrame.new(0, 4.7, 3.2), Color = CREAM })
					local np = math.max(2, math.floor(wT / 5))
					for q = 0, np do
						S({ Name = "RailPost", Size = Vector3.new(0.4, 2.2, 0.4), CFrame = cf * CFrame.new(-wT / 2 + 0.4 + q * ((wT - 0.8) / np), 3.6, 3.2), Color = Art.Shade(segCol, 0.85) })
					end
				end
				if tier < 3 then
					for n = 0, 3 do
						local h = Art.Hash(sideYaw, sgi * 10 + tier, n)
						if h > 0.2 then
							local x = -wT / 2 + 3 + n * ((wT - 6) / 3) + (h - 0.5) * 2
							-- v0.9.14: the crowd are mini toy-brawler bots (same styles as the fighters)
							local st = FAN_STYLES[(math.floor(h * 7919) % #FAN_STYLES) + 1]
							local fan = cf * CFrame.new(x, 3.4, 0)
							miniBotFan(S, fan, st, h, n)
						end
					end
				end
			end
			-- striped canopy over the top tier + poles
			local top = at(3)
			for _, sx in { -1, 1 } do
				S({ Name = "CanopyPole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(12, 0.9, 0.9), CFrame = top * CFrame.new(sx * (width / 2 - 1), 7, -3) * CFrame.Angles(0, 0, math.rad(90)), Color = WOOD_DARK })
			end
			-- v0.9.10: every segment has its own canopy colour, striped with cream, scalloped per stripe
			local NSTR = 4
			for q = 0, NSTR - 1 do
				local x = -width / 2 + (q + 0.5) * (width / NSTR)
				local col = q % 2 == 0 and segCol or CREAM
				S({ Name = "Canopy", Size = Vector3.new(width / NSTR + 0.02, 0.6, 30), CFrame = top * CFrame.new(0, 10, 9) * CFrame.Angles(math.rad(10), 0, 0) * CFrame.new(x, 0, 0), Color = col })
				S({ Name = "CanopyScallop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(width / NSTR - 0.3, 1.4, 1.4), CFrame = top * CFrame.new(x, 7.2, 23.8), Color = col })
			end
			S({ Name = "CanopyBand", Size = Vector3.new(width, 0.5, 0.7), CFrame = top * CFrame.new(0, 7.6, 23.2), Color = Art.Shade(segCol, 0.75) })
			-- pennants on both poles (two other accent colours)
			for _, px in { -1, 1 } do
				local pole = top * CFrame.new(px * (width / 2 - 1), 16, -3)
				S({ Name = "FlagPole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, 0.4, 0.4), CFrame = pole * CFrame.Angles(0, 0, math.rad(90)), Color = WOOD_DARK })
				local f = Instance.new("WedgePart")
				f.Name = "Pennant"
				f.Anchored, f.CanCollide, f.CanQuery, f.CanTouch = true, false, false, false
				f.Material = Enum.Material.SmoothPlastic
				f.Size = Vector3.new(0.15, 1.8, 3.4)
				f.CFrame = pole * CFrame.new(0, 2, 1.7) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(90), 0, 0)
				f.Color = px > 0 and Art.Brand.Gold or Art.Brand.Cream
				f.Parent = decor
			end
			-- floating island under the segment
			local under = at(0) * CFrame.new(0, 0, -10)
			S({ Name = "StandGrass", Size = Vector3.new(width + 3, 2, 36), CFrame = under * CFrame.new(0, -3.4, 0), Color = GRASS })
			S({ Name = "StandBase", Size = Vector3.new(width - 4, 10, 30), CFrame = under * CFrame.new(0, -9, 0), Color = ROCK })
			S({ Name = "StandBase2", Size = Vector3.new(width * 0.6, 10, 18), CFrame = under * CFrame.new(0, -17, 2), Color = ROCK_DARK })
			-- crystal clusters growing out of the rock underside (each segment its own gem colour)
			local gem = GEMS[(segId + (sideYaw > 0 and 0 or 2)) % #GEMS + 1]
			for q = 1, 2 do
				local gp = (under * CFrame.new((q == 1 and -1 or 1) * width * 0.18, -22, 2 + (q - 1.5) * 4)).Position
				Art.Shard(decor, gp, 1.2 + Art.Hash(sgi, q, 61) * 0.8, 4 + Art.Hash(sgi, q, 62) * 4, 900 + segId * 7 + q, gem, 5)
			end
		end
		-- pines at both ends of the crescent
		for _, e in { -1, 1 } do
			local yaw = math.rad(sideYaw + e * (spread / 2 + 4))
			pine(decor, (CFrame.new(c) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, -8, -(R0 + 8))).Position, 16)
		end
	end

	-- Scoreboard Island (north)
	local nb = c + Vector3.new(0, -8, -(HALF + 78))
	miniIsland(decor, nb, 40, 9)
	for _, sx in { -1, 1 } do
		S({ Name = "BoardTower", Size = Vector3.new(10, 34, 10), CFrame = CFrame.new(nb + Vector3.new(sx * 34, 17, 0)), Color = Color3.fromRGB(176, 168, 198) })
		S({ Name = "BoardTowerTrim", Size = Vector3.new(11, 1.6, 11), CFrame = CFrame.new(nb + Vector3.new(sx * 34, 30, 0)), Color = WOOD })
		-- v0.9.15: flat brand-coloured roof slab (the egg domes read as blobs)
		S({ Name = "BoardTowerRoof", Size = Vector3.new(13, 2.4, 13), CFrame = CFrame.new(nb + Vector3.new(sx * 34, 35, 0)), Color = sx < 0 and Art.Brand.Orange or Art.Brand.Teal })
		S({ Name = "BoardTowerCap", Size = Vector3.new(9, 2.6, 9), CFrame = CFrame.new(nb + Vector3.new(sx * 34, 37.4, 0)), Color = Color3.fromRGB(70, 66, 90) })
		-- firework cannon on each tower
		local barrel = S({ Name = "Cannon", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 2.6, 2.6), CFrame = CFrame.new(nb + Vector3.new(sx * 34, 42, 0)) * CFrame.Angles(0, 0, math.rad(80 * sx)), Color = Color3.fromRGB(60, 140, 240) })
		local fw = Instance.new("ParticleEmitter")
		fw.Rate = 3
		fw.Lifetime = NumberRange.new(1.4, 2)
		fw.Speed = NumberRange.new(18, 26)
		fw.SpreadAngle = Vector2.new(12, 12)
		fw.Acceleration = Vector3.new(0, -14, 0)
		fw.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		fw.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 140, 255)) })
		fw.LightEmission = 1
		fw.EmissionDirection = Enum.NormalId.Right
		fw.Parent = barrel
	end
	-- the board itself (rounded orange plate) + two "screens"
	local signCf = CFrame.new(nb + Vector3.new(0, 44, 0))
	local sign = S({ Name = "Sign", Size = Vector3.new(58, 20, 1), CFrame = signCf, Transparency = 1 })
	-- v0.9.15: a clean jumbotron (dark iron frame + navy screen) instead of the orange title plate
	S({ Name = "BoardBack", Size = Vector3.new(62, 24, 2.4), CFrame = signCf * CFrame.new(0, 0, -1.6), Color = Color3.fromRGB(70, 66, 90) })
	S({ Name = "BoardBeam", Size = Vector3.new(66, 3, 4), CFrame = signCf * CFrame.new(0, -12.5, -1), Color = Color3.fromRGB(70, 66, 90) })
	local function screen(cf: CFrame, text: string, color: Color3)
		local scr = S({ Name = "Screen", Size = Vector3.new(16, 9, 0.6), CFrame = cf, Color = Color3.fromRGB(34, 38, 60) })
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Back
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(0.9, 0.8)
		t.Position = UDim2.fromScale(0.05, 0.1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.TextColor3 = color
		t.Text = text
		t.Parent = sg
		sg.Parent = scr
		S({ Name = "ScreenFrame", Size = Vector3.new(17, 10, 0.4), CFrame = cf * CFrame.new(0, 0, -0.4), Color = Color3.fromRGB(70, 66, 90) })
	end
	screen(CFrame.new(nb + Vector3.new(-34, 22, 5.4)), "LAST ONE STANDING", Color3.fromRGB(120, 220, 255))
	screen(CFrame.new(nb + Vector3.new(34, 22, 5.4)), "MIND THE CRACKS!", Color3.fromRGB(255, 200, 120))
	for _, face in { Enum.NormalId.Back, Enum.NormalId.Front } do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face -- Back faces +Z, toward the arena
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = 0.3
		local plate = Instance.new("Frame")
		plate.Size = UDim2.fromScale(1, 1)
		plate.BackgroundColor3 = Color3.fromRGB(34, 38, 60)
		plate.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 40)
		corner.Parent = plate
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(30, 26, 40)
		st.Thickness = 12
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = plate
		plate.Parent = sg
		if face == Enum.NormalId.Back then
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(0.92, 0.8)
			t.Position = UDim2.fromScale(0.04, 0.1)
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.LuckiestGuy
			t.TextScaled = true
			t.Text = "CRUMBLE!"
			t.TextColor3 = Art.Brand.Gold
			local ts = Instance.new("UIStroke")
			ts.Color = Color3.fromRGB(30, 26, 40)
			ts.Thickness = 10
			ts.Parent = t
			t.Parent = plate
		end
		sg.Parent = sign
	end
	-- string lights between the towers
	for i = 0, 12 do
		local t = i / 12
		local p = nb + Vector3.new(-34 + 68 * t, 31 - math.sin(t * math.pi) * 5, 5)
		S({ Name = "StringLight", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(p), Color = i % 2 == 0 and Art.Brand.Gold or Color3.fromRGB(255, 200, 120), Material = Enum.Material.Neon })
	end
	pine(decor, nb + Vector3.new(-18, 0, -12), 18)
	pine(decor, nb + Vector3.new(20, 0, -14), 15)

	local snapSky = snapshot()
	-- hot-air balloons over the corners
	for i, corner in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		local isle = Vector3.new(c.X + corner.X * (HALF + 22), topY - 10, c.Z + corner.Y * (HALF + 22))
		miniIsland(decor, isle, 8, i + 20)
		pine(decor, isle + Vector3.new(corner.X * 3, 0, -corner.Y * 2), 12)
		local bpos = isle + Vector3.new(-corner.X * 4, 34 + Art.Hash(i, 2) * 8, -corner.Y * 4)
		local col = STRIPES[(i - 1) % #STRIPES + 1]
		Art.Egg(decor, Vector3.new(16, 19, 16), CFrame.new(bpos), col)
		Art.Egg(decor, Vector3.new(16.4, 6, 16.4), CFrame.new(bpos + Vector3.new(0, 1, 0)), Color3.fromRGB(252, 248, 238)) -- equator band
		Art.Egg(decor, Vector3.new(7, 4, 7), CFrame.new(bpos + Vector3.new(0, 9.2, 0)), col)
		cylY("BalloonThroat", bpos + Vector3.new(0, -9.4, 0), 2, 5, col)
		local basket = bpos + Vector3.new(0, -16, 0)
		S({ Name = "Basket", Size = Vector3.new(4.4, 3.2, 4.4), CFrame = CFrame.new(basket), Color = WOOD })
		S({ Name = "BasketRim", Size = Vector3.new(4.8, 0.6, 4.8), CFrame = CFrame.new(basket + Vector3.new(0, 1.7, 0)), Color = WOOD_DARK })
		local burner = S({ Name = "Burner", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(basket + Vector3.new(0, 4.2, 0)), Color = LANTERN, Material = Enum.Material.Neon })
		Art.Light(burner, LANTERN, 18, 1)
		for _, o in { Vector3.new(2, 0, 2), Vector3.new(-2, 0, 2), Vector3.new(2, 0, -2), Vector3.new(-2, 0, -2) } do
			local a = basket + o + Vector3.new(0, 1.8, 0)
			local b = bpos + o * 1.2 + Vector3.new(0, -8.6, 0)
			S({ Name = "Rope", Size = Vector3.new(0.18, 0.18, (b - a).Magnitude), CFrame = CFrame.lookAt((a + b) / 2, b), Color = WOOD_DARK })
		end
		-- tether down to the island
		local tb = isle + Vector3.new(-corner.X * 4, 0.2, -corner.Y * 4)
		S({ Name = "Tether", Size = Vector3.new(0.14, 0.14, (basket - tb).Magnitude), CFrame = CFrame.lookAt((basket + tb) / 2, basket), Color = Color3.fromRGB(252, 248, 238) })
	end

	-- south: a trail of tiny lantern islands under the Yard sight-line
	for k = 0, 3 do
		local top = Vector3.new(c.X + (k % 2 == 0 and -14 or 14), topY - 16 - k * 2, c.Z + HALF + 14 + k * 11)
		miniIsland(decor, top, 4.5, 40 + k)
		cylY("IsleLampPost", top + Vector3.new(0, 3, 0), 6, 0.6, WOOD_DARK)
		local l = S({ Name = "IsleLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = CFrame.new(top + Vector3.new(0, 6.4, 0)), Color = LANTERN, Material = Enum.Material.Neon })
		Art.Light(l, LANTERN, 14, 0.8)
	end

	-- far ring: tree islands + a blimp
	for k = 1, 10 do
		local ang = (k / 10) * math.pi * 2 + 0.3
		local rad = HALF + 120 + Art.Hash(k, 41) * 60
		local pos = c + Vector3.new(math.cos(ang) * rad, -30 + Art.Hash(k, 42) * 40, math.sin(ang) * rad)
		if not (pos.Z > HALF + 40 and math.abs(pos.X) < 160) then
			local r = 7 + Art.Hash(k, 43) * 7
			miniIsland(decor, pos, r, 60 + k, true)
			pine(decor, pos + Vector3.new(r * 0.2, 0, -r * 0.2), 10 + r * 0.4)
		end
	end
	local blimp = c + Vector3.new(HALF + 40, 70, -(HALF + 30))
	local bcf = CFrame.lookAt(blimp, blimp + Vector3.new(-1, 0, -0.4))
	Art.Egg(decor, Vector3.new(14, 14, 44), bcf, Color3.fromRGB(252, 248, 238))
	Art.Egg(decor, Vector3.new(14.4, 4, 44.4), bcf, Color3.fromRGB(255, 120, 60))
	for _, fin in { CFrame.Angles(0, 0, 0), CFrame.Angles(0, 0, math.rad(90)), CFrame.Angles(0, 0, math.rad(180)), CFrame.Angles(0, 0, math.rad(270)) } do
		S({ Name = "BlimpFin", Size = Vector3.new(0.6, 6, 6), CFrame = bcf * fin * CFrame.new(0, 7, 18), Color = Color3.fromRGB(60, 140, 240) })
	end
	S({ Name = "Gondola", Size = Vector3.new(4, 2.6, 9), CFrame = bcf * CFrame.new(0, -8, 0), Color = WOOD })
	local bannerCf = bcf * CFrame.new(7.3, 0, 0) * CFrame.Angles(0, math.rad(90), 0)
	local banner = S({ Name = "BlimpBanner", Size = Vector3.new(26, 6, 0.2), CFrame = bannerCf, Transparency = 1 })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 16
		sg.LightInfluence = 0.2
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.TextColor3 = Color3.fromRGB(255, 120, 60)
		t.Text = "CRUMBLE!"
		t.Parent = sg
		sg.Parent = banner
	end
	moveNew(snapSky)

	-- reference look: flat colours + rounded edges on every decorative block
	-- (tiles stay crisp squares: the grid must read)
	Art.Toon(decor)
	Art.SoftenAll(decor, { MaxRadius = 3, Ratio = 0.25 })
	Art.Toon(gs)
	Art.SoftenAll(gs, { MaxRadius = 3, Ratio = 0.25 })
	-- remember every rim rock's original colour so other maps can re-tint them
	for _, d in rr:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetAttribute("BaseColor", d.Color)
		end
	end	-- v0.8.3: classify the always-on stadium parts (grass + lavender rock) so maps can re-tint them
	local SKIP = { Fan = true, FanHead = true, FoamFinger = true, FanPlate = true, FanScreen = true, FanEye = true, FanArm = true, FanMitt = true, Pennant = true, StringLight = true, Screen = true, ScreenFrame = true }
	local rs = ROCK.R + ROCK.G + ROCK.B
	local rn = Vector3.new(ROCK.R / rs, ROCK.G / rs, ROCK.B / rs)
	for _, d in decor:GetDescendants() do
		if d:IsA("BasePart") and d.Material ~= Enum.Material.Neon and not SKIP[d.Name] and not d:IsDescendantOf(rr) then
			local col = d.Color
			local sum = col.R + col.G + col.B
			local kind: string? = nil
			if col.G > col.R * 1.25 and col.G > col.B * 1.25 then
				kind = "Grass"
			elseif sum > 0.05 and (Vector3.new(col.R / sum, col.G / sum, col.B / sum) - rn).Magnitude < 0.035 then
				kind = "Rock"
			end
			if kind then
				d:SetAttribute("BaseColor", col)
				d:SetAttribute("TintKind", kind)
				table.insert(tintParts, d)
			end
		end
	end
	-- v0.8.5: the rounded-edge extras of the rim (Rim_R...) recolour with the rim too
	local RIMK = { Rim_R = "Rim", RimBand_R = "RimBand", RimGlow_R = "RimGlow" }
	for _, ch in decor:GetChildren() do
		local k = RIMK[ch.Name]
		if k and ch:IsA("BasePart") then
			table.insert(rimParts, { Part = ch, Kind = k })
		end
	end
	-- v0.8.5: everything else in the decor (stands, crowd, scoreboard island, string lights)
	-- is "the stadium": Molten / Ice swap it for their own themed copy
	local st = Instance.new("Folder")
	st.Name = "Stadium"
	local KEEP = { Rim = true, Rim_R = true, RimBand = true, RimBand_R = true, RimGlow = true, RimGlow_R = true, CloudSea = true, RimRocks = true }
	for _, ch in decor:GetChildren() do
		if not KEEP[ch.Name] then
			ch.Parent = st
		end
	end
	st.Parent = decor
	stadium = st
end

-- v0.8.5 THEMED STADIUM: a recoloured copy of the stands + scoreboard for a map, plus its accents
type StadiumPalette = { Wood: Color3, WoodDark: Color3, Light: Color3, Accents: { Color3 }, Grass: Color3, Rock: Color3, Glow: Color3 }
local function themedStadium(parent: Instance, pal: StadiumPalette, mapId: string)
	local src = stadium
	if not src then
		return
	end
	local copy = (src :: Folder):Clone()
	copy.Name = "Stadium_" .. mapId
	local CROWD_N = { Fan = true, FanHead = true, FoamFinger = true, FanPlate = true, FanScreen = true, FanEye = true, FanArm = true, FanMitt = true, Screen = true, Sign = true }
	local rs = ROCK.R + ROCK.G + ROCK.B
	local rn = Vector3.new(ROCK.R / rs, ROCK.G / rs, ROCK.B / rs)
	for _, d in copy:GetDescendants() do
		if d:IsA("BasePart") and not CROWD_N[d.Name] and d.Transparency < 0.95 then
			local col = d.Color
			local mx, mn = math.max(col.R, col.G, col.B), math.min(col.R, col.G, col.B)
			local sat = mx - mn
			local lum = 0.299 * col.R + 0.587 * col.G + 0.114 * col.B
			local sum = col.R + col.G + col.B
			local h = Art.Hash(math.floor(d.Position.X), math.floor(d.Position.Z), 77)
			if d.Material == Enum.Material.Neon then
				d.Color = pal.Glow
			elseif col.G > col.R * 1.25 and col.G > col.B * 1.25 then
				d.Color = Art.Shade(pal.Grass, math.clamp(lum / 0.6, 0.7, 1.2))
			elseif (sum > 0.05 and (Vector3.new(col.R / sum, col.G / sum, col.B / sum) - rn).Magnitude < 0.05) or (col.B >= col.R and col.B > col.G and sat < 0.3) then
				d.Color = Art.Shade(pal.Rock, math.clamp(lum / 0.65, 0.7, 1.2))
			elseif sat < 0.12 and lum > 0.75 then
				d.Color = pal.Light
			elseif col.R > col.G and col.G > col.B and sat > 0.15 and sat < 0.6 and lum < 0.75 then
				d.Color = lum > 0.45 and pal.Wood or pal.WoodDark
			elseif sat > 0.3 then
				d.Color = pal.Accents[1 + math.floor(h * #pal.Accents) % #pal.Accents]
			end
		end
	end
	-- map accents on the stands
	for _, d in copy:GetDescendants() do
		if d:IsA("BasePart") then
			if mapId == "Molten" then
				if d.Name == "StandEdge" then
					d.Color = pal.Glow
					d.Material = Enum.Material.Neon
				elseif d.Name == "CanopyPole" then
					-- a burning torch on top of every canopy pole
					local top = (d.CFrame * CFrame.new(d.Size.X / 2 + 0.6, 0, 0)).Position
					local bowl = Art.Static(copy, { Name = "TorchBowl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 2, 2), CFrame = CFrame.new(top) * CFrame.Angles(0, 0, math.rad(90)), Color = pal.WoodDark })
					local f = Instance.new("Fire")
					f.Size = 3
					f.Heat = 9
					f.Color = Color3.fromRGB(255, 120, 20)
					f.SecondaryColor = Color3.fromRGB(255, 210, 80)
					f.Parent = bowl
				end
			elseif mapId == "Ice" then
				if d.Name == "Canopy" then
					-- snow lying on every canopy
					Art.Static(copy, { Name = "CanopySnow", Size = Vector3.new(d.Size.X + 0.4, 0.7, d.Size.Z + 0.4), CFrame = d.CFrame * CFrame.new(0, d.Size.Y / 2 + 0.3, 0), Color = Color3.fromRGB(248, 252, 255) })
				elseif d.Name == "CanopyScallop" then
					-- icicles hanging off the canopy edge
					local n = math.floor(d.Size.X / 5)
					for q = 0, n - 1 do
						local x = -d.Size.X / 2 + (q + 0.5) * (d.Size.X / n)
						local top = (d.CFrame * CFrame.new(x, 0, 0)).Position - Vector3.new(0, d.Size.Y * 0.4, 0)
						Art.Shard(copy, top, 0.35, 1.2 + Art.Hash(q, math.floor(top.X), 88) * 2.4, 2000 + q + math.floor(math.abs(top.X)), Color3.fromRGB(205, 236, 255), 3, false)
					end
				elseif d.Name == "StandGrass" then
					d.Color = Color3.fromRGB(246, 250, 255)
				end
			end
		end
	end
	copy.Parent = parent
end

-- v0.8: themed decor sets for Molten Core and Ice Rink (kept in ServerStorage until their map is up)
local function themeSpots(count: number, seed: number, rMin: number, rMax: number): { Vector3 }
	local c = A.Center
	local out = {}
	local k = 0
	while #out < count and k < count * 4 do
		k += 1
		local ang = (k / count) * math.pi * 2 + Art.Hash(seed, k) * 0.5
		local rad = HALF + rMin + Art.Hash(seed, k, 2) * (rMax - rMin)
		local p = c + Vector3.new(math.cos(ang) * rad, -24 + Art.Hash(seed, k, 3) * 30, math.sin(ang) * rad)
		-- keep the Yard side (south, +Z) and its sight-line clear
		if not (p.Z > c.Z + HALF * 0.5 and math.abs(p.X - c.X) < 170) then
			table.insert(out, p)
		end
	end
	return out
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	for k, v in props do
		(pe :: any)[k] = v
	end
	pe.Parent = parent
	return pe
end

local function bar(parent: Instance, a: Vector3, b: Vector3, th: number, col: Color3, name: string?): Part
	return Art.Static(parent, { Name = name or "Truss", Size = Vector3.new(th, th, (b - a).Magnitude), CFrame = CFrame.lookAt((a + b) / 2, b), Color = col })
end

-- v0.9.5: The Grid construction site (cranes, chevrons) was removed: the normal map is now
-- CLASSIC, the plain original arena with the default cozy sky-stadium look.

local function buildThemes()
	local MC = Config.Maps.Molten
	local IC = Config.Maps.Ice
	local c = A.Center
	local seaY = A.KillY - 16 -- the lava ocean / frozen sea sits just under the KO plane
	local function cylY(parent: Instance, name: string, pos: Vector3, d: number, h: number, col: Color3, mat: Enum.Material?, tr: number?): Part
		return Art.Static(parent, { Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, d, d), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = col, Material = mat or Enum.Material.SmoothPlastic, Transparency = tr or 0 })
	end
	local function around(k: number, salt: number, rMin: number, rMax: number): Vector3
		local ang = Art.Hash(k, salt) * math.pi * 2
		local rad = rMin + Art.Hash(k, salt, 2) * (rMax - rMin)
		return Vector3.new(c.X + math.cos(ang) * rad, 0, c.Z + math.sin(ang) * rad)
	end

	--------------------------------------------------------------------
	-- MOLTEN CORE (v0.8.3 rework): a basalt arena over a LAVA OCEAN, ringed by volcanoes
	--------------------------------------------------------------------
	local LAVA, HOT, DEEP, CRUST = MC.Lava, MC.LavaHot, MC.LavaDeep, MC.Crust
	local molten = Instance.new("Folder")
	molten.Name = "Theme_Molten"
	-- 1. the lava ocean: deep red-orange glow, brighter currents, dark crust rafts drifting on it
	cylY(molten, "LavaSea", Vector3.new(c.X, seaY, c.Z), 1100, 1, DEEP, Enum.Material.Neon)
	for k = 1, 16 do
		local p = around(k, 301, 40, 380)
		Art.Static(molten, {
			Name = "LavaCurrent", Size = Vector3.new(5 + Art.Hash(k, 303) * 9, 0.3, 50 + Art.Hash(k, 304) * 90),
			CFrame = CFrame.new(p.X, seaY + 0.6, p.Z) * CFrame.Angles(0, Art.Hash(k, 305) * math.pi, 0),
			Color = k % 3 == 0 and HOT or LAVA, Material = Enum.Material.Neon,
		})
	end
	for k = 1, 42 do
		local p = around(k, 311, 30, 420)
		local d = 14 + Art.Hash(k, 312) * 30
		for q = 0, 2 do
			local off = Vector3.new((Art.Hash(k, q, 313) - 0.5) * d * 0.7, 0, (Art.Hash(k, q, 314) - 0.5) * d * 0.7)
			cylY(molten, "CrustRaft", Vector3.new(p.X, seaY + 0.9 + q * 0.05, p.Z) + off, d * (0.55 + Art.Hash(k, q, 315) * 0.4), 1.2, Art.Shade(CRUST, 0.85 + q * 0.12))
		end
	end
	local seaFx = Art.Static(molten, { Name = "LavaSurface", Size = Vector3.new(560, 1, 560), CFrame = CFrame.new(c.X, seaY + 1, c.Z), Transparency = 1 })
	emitter(seaFx, { -- popping lava bubbles
		Rate = 70, Lifetime = NumberRange.new(0.6, 1.1), Speed = NumberRange.new(3, 7), EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(30, 30), Acceleration = Vector3.new(0, -14, 0), LightEmission = 1,
		Color = ColorSequence.new(HOT, LAVA), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.6, 2.4), NumberSequenceKeypoint.new(1, 0) }),
	})
	emitter(seaFx, { -- heat sparks rising up past the arena
		Rate = 90, Lifetime = NumberRange.new(6, 9), Speed = NumberRange.new(8, 14), EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(12, 12), LightEmission = 1, Color = ColorSequence.new(HOT, LAVA),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.35), NumberSequenceKeypoint.new(1, 0) }),
	})
	-- 2. (v0.8.3b) no glowing plate under the floor any more: a HOLE is a dark drop down to the
	-- distant red ocean, a LAVA TILE is a bright bubbling pool with a black crust rim.
	-- 3. floating basalt chunks with glowing veins, pouring lava falls into the ocean
	for k, p in themeSpots(9, 71, 46, 96) do
		local sz = 12 + Art.Hash(k, 72) * 12
		Art.Shard(molten, p, sz * 0.55, sz * 1.4, 700 + k, MC.Rock, 6, false)
		Art.Rock(molten, p - Vector3.new(0, sz * 0.08, 0), sz * 1.2, 710 + k, MC.RockLight)
		for v = 1, 3 do
			local ang = Art.Hash(k, v, 73) * math.pi * 2
			local vp = p + Vector3.new(math.cos(ang) * sz * 0.42, -sz * (0.1 + v * 0.18), math.sin(ang) * sz * 0.42)
			Art.Static(molten, { Name = "LavaVein", Size = Vector3.new(0.8, sz * 0.35, 0.8), CFrame = CFrame.new(vp) * CFrame.Angles(0, ang, (Art.Hash(k, v, 74) - 0.5) * 0.8), Color = HOT, Material = Enum.Material.Neon })
		end
		if k % 2 == 1 then
			local top = p + Vector3.new(sz * 0.3, -sz * 0.25, 0)
			local len = math.max(4, top.Y - seaY)
			local fall = cylY(molten, "LavaFall", top - Vector3.new(0, len / 2, 0), 3, len, LAVA, Enum.Material.Neon, 0.1)
			Art.Light(fall, LAVA, 30, 2)
			local splash = Art.Static(molten, { Name = "LavaSplash", Size = Vector3.new(4, 1, 4), CFrame = CFrame.new(top.X, seaY + 1, top.Z), Transparency = 1 })
			emitter(splash, { Rate = 14, Lifetime = NumberRange.new(2, 3), Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(40, 40), EmissionDirection = Enum.NormalId.Top, Color = ColorSequence.new(Color3.fromRGB(90, 70, 64)), Transparency = NumberSequence.new(0.3, 1), Size = NumberSequence.new(4, 12) })
		end
	end
	-- 4. volcanoes rising out of the lava ocean: dark cones, glowing craters, lava rivers, smoke
	for k, p in themeSpots(6, 91, 150, 250) do
		local base = Vector3.new(p.X, seaY - 2, p.Z)
		local r = 36 + Art.Hash(k, 92) * 18
		local h = 110 + Art.Hash(k, 93) * 55
		Art.Shard(molten, base, r, -h, 940 + k, MC.Rock, 8, false)
		local sh = Art.Hash(k, 95) * math.pi * 2
		Art.Shard(molten, base + Vector3.new(math.cos(sh) * r * 0.5, 0, math.sin(sh) * r * 0.5), r * 0.7, -h * 0.55, 950 + k, MC.RockLight, 7, false)
		local tip = base + Vector3.new(0, h * 0.86, 0)
		local crater = Art.Static(molten, { Name = "Crater", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.32, r * 0.32, r * 0.32), CFrame = CFrame.new(tip), Color = HOT, Material = Enum.Material.Neon })
		Art.Light(crater, LAVA, 60, 4)
		emitter(crater, { -- smoke column
			Rate = 5, Lifetime = NumberRange.new(14, 20), Speed = NumberRange.new(10, 16), EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(10, 10), Acceleration = Vector3.new(2.5, 0.6, 0), Color = ColorSequence.new(Color3.fromRGB(56, 46, 44), Color3.fromRGB(110, 96, 92)),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }), Size = NumberSequence.new(14, 46), RotSpeed = NumberRange.new(-10, 10),
		})
		emitter(crater, { -- glowing spatter
			Rate = 10, Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(18, 30), EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(30, 30), Acceleration = Vector3.new(0, -30, 0), LightEmission = 1, Color = ColorSequence.new(HOT, LAVA), Size = NumberSequence.new(1.6, 0.4),
		})
		for q = 1, 4 do
			local ang = Art.Hash(k, q, 94) * math.pi * 2
			local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
			local from = base + dir * (r * 0.16) + Vector3.new(0, h * 0.84, 0)
			local to = base + dir * (r * 1.0) + Vector3.new(0, 2, 0)
			bar(molten, from, to, 2.4, q % 2 == 0 and HOT or LAVA, "LavaRiver").Material = Enum.Material.Neon
		end
	end
	-- 5. jagged basalt spires poking out of the lava right around the arena
	for k, p in themeSpots(14, 97, 16, 80) do
		local base = Vector3.new(p.X, seaY - 1, p.Z)
		local h = (c.Y - 18 - seaY) + Art.Hash(k, 98) * 24
		local r = 5 + Art.Hash(k, 99) * 7
		Art.Shard(molten, base, r, -h, 990 + k, k % 2 == 0 and MC.Rock or MC.RockLight, 6, false)
		if k % 3 == 0 then
			bar(molten, base + Vector3.new(r * 0.5, h * 0.5, 0), base + Vector3.new(r * 0.95, 1, 0), 0.9, HOT, "LavaSeep").Material = Enum.Material.Neon
		end
	end
	-- 6. ash drifting down over the floor
	local ash = Art.Static(molten, { Name = "Ash", Size = Vector3.new(N * TS + 100, 1, N * TS + 100), CFrame = CFrame.new(c.X, c.Y + 70, c.Z), Transparency = 1 })
	emitter(ash, {
		Rate = 60, Lifetime = NumberRange.new(10, 14), Speed = NumberRange.new(3, 6), EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(25, 25), Color = ColorSequence.new(Color3.fromRGB(80, 74, 72)), Transparency = NumberSequence.new(0.2, 0.8),
		Size = NumberSequence.new(0.32, 0.16), RotSpeed = NumberRange.new(-90, 90),
	})
	--------------------------------------------------------------------
	-- v0.8.3b MOLTEN DETAIL PASS
	--------------------------------------------------------------------
	local topY = c.Y - A.TileThickness
	local RIM_OUT = HALF + 4
	local function rimPoint(side: number, along: number, out: number, y: number): (Vector3, Vector3)
		local horizontal = side < 2
		local sgn = (side % 2 == 0) and -1 or 1
		local pos = horizontal and Vector3.new(c.X + along, y, c.Z + sgn * out) or Vector3.new(c.X + sgn * out, y, c.Z + along)
		local normal = horizontal and Vector3.new(0, 0, sgn) or Vector3.new(sgn, 0, 0)
		return pos, normal
	end
	-- a cooled crust shelf directly under the arena: every HOLE now looks like a dark drop
	-- (black rock with faint glowing cracks) instead of glowing like a lava tile
	cylY(molten, "UnderCrust", Vector3.new(c.X, seaY + 1.4, c.Z), N * TS + 24, 1.4, Color3.fromRGB(14, 10, 10), Enum.Material.SmoothPlastic) -- v0.9.12 near-black: holes read darker than the tiles
	for k = 1, 12 do
		local p = around(k, 501, 0, HALF * 0.9)
		Art.Static(molten, { Name = "UnderCrack", Size = Vector3.new(0.6, 0.2, 14 + Art.Hash(k, 502) * 26), CFrame = CFrame.new(p.X, seaY + 2.2, p.Z) * CFrame.Angles(0, Art.Hash(k, 503) * math.pi, 0), Color = LAVA, Material = Enum.Material.Neon, Transparency = 0.3 })
	end
	-- lava dripping off the rim: glowing runs down the outer face + falling drops
	for side = 0, 3 do
		for k = 0, 15 do
			local along = -HALF + (k + 0.5) * (N * TS / 16) + (Art.Hash(side, k, 511) - 0.5) * 6
			local len = 3 + Art.Hash(side, k, 512) * 10
			local pos, n = rimPoint(side, along, RIM_OUT + 0.15, topY + 0.6 - len / 2)
			local run = Art.Static(molten, { Name = "RimLavaRun", Size = Vector3.new(0.9, len, 0.9), CFrame = CFrame.lookAt(pos, pos + n), Color = k % 3 == 0 and HOT or LAVA, Material = Enum.Material.Neon })
			if k % 3 == 0 then
				local drop = Art.Static(molten, { Name = "RimDrip", Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(pos - Vector3.new(0, len / 2, 0)), Transparency = 1 })
				emitter(drop, {
					Rate = 2.5, Lifetime = NumberRange.new(1.5, 2), Speed = NumberRange.new(0, 1), EmissionDirection = Enum.NormalId.Bottom,
					Acceleration = Vector3.new(0, -45, 0), LightEmission = 1, Color = ColorSequence.new(HOT, LAVA), Size = NumberSequence.new(0.5, 0.3),
				})
			end
			run.CastShadow = false
		end
		-- glowing cracks across the rim top
		for k = 0, 9 do
			local along = -HALF + (k + 0.5) * (N * TS / 10) + (Art.Hash(side, k, 521) - 0.5) * 10
			local pos, n = rimPoint(side, along, HALF + 2, topY + 1.06)
			local yaw = (Art.Hash(side, k, 522) - 0.5) * 1.2
			Art.Static(molten, { Name = "RimCrack", Size = Vector3.new(0.35, 0.12, 3.2), CFrame = CFrame.lookAt(pos, pos + n) * CFrame.Angles(0, yaw, 0), Color = LAVA, Material = Enum.Material.Neon })
		end
	end
	-- fire braziers on the four rim corners
	for _, cs in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(1, 1), Vector2.new(-1, 1) } do
		local base = Vector3.new(c.X + cs.X * (HALF + 2), topY + 1, c.Z + cs.Y * (HALF + 2))
		cylY(molten, "BrazierFoot", base + Vector3.new(0, 0.4, 0), 4.4, 0.8, MC.Rock)
		cylY(molten, "BrazierPost", base + Vector3.new(0, 2.2, 0), 2, 3, MC.RockLight)
		cylY(molten, "BrazierBowl", base + Vector3.new(0, 4.2, 0), 5, 1.4, MC.Rock)
		local coals = cylY(molten, "BrazierCoals", base + Vector3.new(0, 4.95, 0), 4.2, 0.3, HOT, Enum.Material.Neon)
		local fire = Instance.new("Fire")
		fire.Size = 6
		fire.Heat = 12
		fire.Color = Color3.fromRGB(255, 120, 20)
		fire.SecondaryColor = Color3.fromRGB(255, 210, 80)
		fire.Parent = coals
		Art.Light(coals, LAVA, 22, 2.5)
	end
	-- charred dead trees + obsidian crystals on the floating basalt chunks
	for k, p in themeSpots(9, 71, 46, 96) do
		local sz = 12 + Art.Hash(k, 72) * 12
		local top = p + Vector3.new(0, sz * 0.1, 0)
		if k % 2 == 0 then
			local lean = Vector3.new((Art.Hash(k, 531) - 0.5) * 2, 0, (Art.Hash(k, 532) - 0.5) * 2)
			local h = 7 + Art.Hash(k, 533) * 5
			local tip = top + Vector3.new(0, h, 0) + lean
			local CH = Color3.fromRGB(42, 34, 32)
			bar(molten, top, tip, 0.9, CH, "DeadTrunk")
			for b = 1, 3 do
				local from = top:Lerp(tip, 0.45 + b * 0.15)
				local ang = Art.Hash(k, b, 534) * math.pi * 2
				local to = from + Vector3.new(math.cos(ang) * (2 + b * 0.5), 1.5 + Art.Hash(k, b, 535) * 2, math.sin(ang) * (2 + b * 0.5))
				bar(molten, from, to, 0.4, CH, "DeadBranch")
				local ember = Art.Static(molten, { Name = "BranchEmber", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(to), Color = HOT, Material = Enum.Material.Neon })
				ember.CastShadow = false
			end
		else
			for q = 1, 3 do
				local ang = Art.Hash(k, q, 541) * math.pi * 2
				local d = q == 1 and 0 or sz * 0.18
				Art.Shard(molten, top + Vector3.new(math.cos(ang) * d, -0.5, math.sin(ang) * d), 0.9 + Art.Hash(k, q, 542) * 0.8, -(4 + Art.Hash(k, q, 543) * 5), 1500 + k * 5 + q, Color3.fromRGB(36, 28, 42), 5, false)
			end
		end
	end
	-- steam vents on some crust rafts
	for k = 1, 42, 5 do
		local p = around(k, 311, 30, 420)
		local vent = Art.Static(molten, { Name = "SteamVent", Size = Vector3.new(2, 1, 2), CFrame = CFrame.new(p.X, seaY + 2, p.Z), Transparency = 1 })
		emitter(vent, {
			Rate = 3, Lifetime = NumberRange.new(6, 9), Speed = NumberRange.new(5, 9), EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(8, 8),
			Color = ColorSequence.new(Color3.fromRGB(200, 180, 170)), Transparency = NumberSequence.new(0.5, 1), Size = NumberSequence.new(4, 16),
		})
	end
	-- molten drops falling from under the arena island
	local under = Art.Static(molten, { Name = "UnderDrips", Size = Vector3.new(N * TS, 1, N * TS), CFrame = CFrame.new(c.X, topY - 12, c.Z), Transparency = 1 })
	emitter(under, {
		Rate = 14, Lifetime = NumberRange.new(1.5, 2), Speed = NumberRange.new(2, 6), EmissionDirection = Enum.NormalId.Bottom,
		Acceleration = Vector3.new(0, -40, 0), LightEmission = 1, Color = ColorSequence.new(HOT, LAVA), Size = NumberSequence.new(0.6, 0.3),
	})
	Art.Toon(molten, 0) -- flat cozy shading, but NO lavender lift on the dark rock (it made v0.8.2 look pink)
	-- v0.8.5: Molten's own stadium: basalt stands, ember-red banners, lava trims and torches
	themedStadium(molten, {
		Wood = Color3.fromRGB(78, 62, 56), WoodDark = Color3.fromRGB(46, 38, 36), Light = Color3.fromRGB(112, 96, 88),
		Accents = { Color3.fromRGB(196, 54, 16), Color3.fromRGB(250, 132, 30), Color3.fromRGB(58, 44, 40) },
		Grass = MC.DecorGrass, Rock = MC.Rock, Glow = MC.Glow,
	}, "Molten")
	molten.Parent = ServerStorage
	themeFolders.Molten = molten

	--------------------------------------------------------------------
	-- ICE RINK (v0.8.3 rework): a frozen lake, icebergs, glacier mountains, aurora, snow
	--------------------------------------------------------------------
	local ice = Instance.new("Folder")
	ice.Name = "Theme_Ice"
	local SEA_ICE = Color3.fromRGB(150, 196, 232) -- v0.8.3b darker blue lake (white tiles stand out)
	cylY(ice, "FrozenSea", Vector3.new(c.X, seaY, c.Z), 1100, 1, SEA_ICE, Enum.Material.Glacier)
	for k = 1, 30 do -- snow drifts on the ice sheet
		local p = around(k, 401, 30, 430)
		local d = 18 + Art.Hash(k, 402) * 40
		for q = 0, 1 do
			local off = Vector3.new((Art.Hash(k, q, 403) - 0.5) * d * 0.6, 0, (Art.Hash(k, q, 404) - 0.5) * d * 0.6)
			cylY(ice, "SnowDrift", Vector3.new(p.X, seaY + 0.6 + q * 0.3, p.Z) + off, d * (0.6 + q * 0.3), 1, IC.Snow)
		end
	end
	for k = 1, 26 do -- long blue cracks in the ice
		local p = around(k, 411, 20, 400)
		Art.Static(ice, { Name = "IceCrack", Size = Vector3.new(0.7, 0.2, 30 + Art.Hash(k, 412) * 60), CFrame = CFrame.new(p.X, seaY + 0.55, p.Z) * CFrame.Angles(0, Art.Hash(k, 413) * math.pi, 0), Color = Color3.fromRGB(100, 160, 214) })
	end
	-- icebergs frozen into the lake around the arena (snow-capped)
	for k, p in themeSpots(12, 85, 18, 110) do
		local base = Vector3.new(p.X, seaY - 1, p.Z)
		local r = 8 + Art.Hash(k, 86) * 9
		local h = 26 + Art.Hash(k, 87) * 30
		Art.Shard(ice, base, r, -h, 860 + k, k % 2 == 0 and IC.Rock or IC.RockDark, 6, false)
		Art.Shard(ice, base + Vector3.new(0, h * 0.55, 0), r * 0.5, -h * 0.5, 880 + k, IC.Snow, 6, false)
	end
	-- glacier mountains on the horizon
	for k, p in themeSpots(6, 89, 150, 250) do
		local base = Vector3.new(p.X, seaY - 2, p.Z)
		local r = 40 + Art.Hash(k, 90) * 20
		local h = 100 + Art.Hash(k, 91) * 50
		Art.Shard(ice, base, r, -h, 900 + k, IC.RockDark, 8, false)
		Art.Shard(ice, base + Vector3.new(0, h * 0.5, 0), r * 0.55, -h * 0.52, 910 + k, IC.Snow, 8, false)
		local sh = Art.Hash(k, 93) * math.pi * 2
		Art.Shard(ice, base + Vector3.new(math.cos(sh) * r * 0.55, 0, math.sin(sh) * r * 0.55), r * 0.6, -h * 0.5, 920 + k, IC.Rock, 7, false)
	end
	-- floating floes with crystal spikes and snowy pines
	for k, p in themeSpots(8, 81, 44, 92) do
		local r = 7 + Art.Hash(k, 82) * 5
		Art.Island(ice, p, r, 800 + k, IC.Snow, IC.Rock, IC.RockDark, { Low = true, Dirt = IC.RockDark })
		for q = 1, 3 do
			local ang = Art.Hash(k, q, 83) * math.pi * 2
			local base = p + Vector3.new(math.cos(ang) * r * 0.45, -0.4, math.sin(ang) * r * 0.45)
			local len = r * (0.6 + Art.Hash(k, q, 84) * 0.7)
			Art.Shard(ice, base, r * 0.14, -len, 820 + k * 7 + q, IC.Crystal, 5, false)
		end
		Art.Pine(ice, p + Vector3.new(-r * 0.25, 0, r * 0.15), 9 + r * 0.5, 840 + k, false, { Snow = true })
	end
	local snow = Art.Static(ice, { Name = "Snowfall", Size = Vector3.new(N * TS + 120, 1, N * TS + 120), CFrame = CFrame.new(c.X, c.Y + 60, c.Z), Transparency = 1 })
	emitter(snow, {
		Rate = 140, Lifetime = NumberRange.new(9, 12), Speed = NumberRange.new(5, 8), EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(20, 20), Size = NumberSequence.new(0.28, 0.12), Color = ColorSequence.new(Color3.new(1, 1, 1)), LightEmission = 0.4,
	})
	-- aurora ribbons across the northern sky
	local AUR = { Color3.fromRGB(110, 255, 200), Color3.fromRGB(120, 200, 255), Color3.fromRGB(190, 140, 255) }
	for r = 1, 3 do
		local prev: Vector3? = nil
		for k = 0, 16 do
			local x = -230 + k * 29
			local pt = Vector3.new(c.X + x, c.Y + 115 + r * 14 + math.sin(k * 0.7 + r) * 9, c.Z - 300 - r * 26 + math.cos(k * 0.5 + r * 2) * 18)
			if prev then
				local seg = Art.Static(ice, { Name = "Aurora", Size = Vector3.new(0.4, 18, (pt - prev :: Vector3).Magnitude + 0.5), CFrame = CFrame.lookAt(((prev :: Vector3) + pt) / 2, pt), Color = AUR[r], Material = Enum.Material.Neon, Transparency = 0.5 })
				seg.CastShadow = false
			end
			prev = pt
		end
	end
	-- giant crystal clusters on far floes
	for k, p in themeSpots(6, 95, 100, 150) do
		local r = 10 + Art.Hash(k, 96) * 4
		Art.Island(ice, p, r, 960 + k, IC.Snow, IC.Rock, IC.RockDark, { Low = true, Dirt = IC.RockDark })
		for q = 1, 4 do
			local ang = Art.Hash(k, q, 97) * math.pi * 2
			local d = (q == 1) and 0 or r * 0.4
			Art.Shard(ice, p + Vector3.new(math.cos(ang) * d, -0.4, math.sin(ang) * d), 2 + Art.Hash(k, q, 98) * 2.5, -(16 + Art.Hash(k, q, 99) * 22), 980 + k * 9 + q, IC.Crystal, 6, false)
		end
		local glow = Art.Static(ice, { Name = "CrystalGlow", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(p + Vector3.new(0, 10, 0)), Transparency = 1 })
		Art.Light(glow, IC.Crystal, 26, 1.5)
	end
	-- blizzard streaks (switched on by the gusts; the part turns to face the wind)
	local bz = Art.Static(ice, { Name = "Blizzard", Size = Vector3.new(N * TS + 60, 26, N * TS + 60), CFrame = CFrame.new(c + Vector3.new(0, 12, 0)), Transparency = 1 })
	emitter(bz, {
		Enabled = false, Rate = 420, Lifetime = NumberRange.new(1.2, 1.8), Speed = NumberRange.new(70, 95),
		EmissionDirection = Enum.NormalId.Front, SpreadAngle = Vector2.new(4, 4), Orientation = Enum.ParticleOrientation.VelocityParallel,
		Squash = NumberSequence.new(2.5), Size = NumberSequence.new(0.22, 0.12), Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Transparency = NumberSequence.new(0.2, 0.7), LightEmission = 0.5,
	})
	blizzard = bz
	--------------------------------------------------------------------
	-- v0.8.3b ICE DETAIL PASS
	--------------------------------------------------------------------
	local itopY = c.Y - A.TileThickness
	local function rimPt(side: number, along: number, out: number, y: number): (Vector3, Vector3)
		local horizontal = side < 2
		local sgn = (side % 2 == 0) and -1 or 1
		local pos = horizontal and Vector3.new(c.X + along, y, c.Z + sgn * out) or Vector3.new(c.X + sgn * out, y, c.Z + along)
		return pos, horizontal and Vector3.new(0, 0, sgn) or Vector3.new(sgn, 0, 0)
	end
	-- dark open water directly under the arena: every HOLE reads as a dark drop into freezing water
	cylY(ice, "DarkWater", Vector3.new(c.X, seaY + 0.8, c.Z), N * TS + 24, 1, Color3.fromRGB(22, 46, 78))
	for k = 1, 16 do -- broken ice chunks floating in it
		local p = around(k, 601, 0, HALF * 0.95)
		cylY(ice, "FloatingIce", Vector3.new(p.X, seaY + 1.5, p.Z), 4 + Art.Hash(k, 602) * 9, 0.8, Color3.fromRGB(220, 238, 252))
	end
	-- open-water leads out on the lake
	for k = 1, 8 do
		local p = around(k, 611, HALF + 40, 380)
		local d = 16 + Art.Hash(k, 612) * 24
		cylY(ice, "LeadRim", Vector3.new(p.X, seaY + 0.7, p.Z), d + 3, 0.8, Color3.fromRGB(236, 246, 255))
		cylY(ice, "OpenWater", Vector3.new(p.X, seaY + 0.85, p.Z), d, 0.8, Color3.fromRGB(30, 64, 104))
	end
	-- snow piled along the rim + icicles hanging off its outer face
	for side = 0, 3 do
		local horizontal = side < 2
		local len = N * TS + 8
		local mid = rimPt(side, 0, HALF + 2, itopY + 1.25)
		Art.Static(ice, { Name = "RimSnow", Size = horizontal and Vector3.new(len, 0.5, 4.6) or Vector3.new(4.6, 0.5, len), CFrame = CFrame.new(mid), Color = IC.Snow })
		for k = 0, 13 do
			local along = -HALF + (k + 0.5) * (N * TS / 14) + (Art.Hash(side, k, 621) - 0.5) * 8
			local pos = rimPt(side, along, HALF + 2 + (Art.Hash(side, k, 622) - 0.5) * 1.5, itopY + 1.6)
			cylY(ice, "SnowLump", pos, 2.4 + Art.Hash(side, k, 623) * 2.4, 0.7, IC.Snow)
		end
		for k = 0, 27 do
			local along = -HALF + (k + 0.5) * (N * TS / 28) + (Art.Hash(side, k, 631) - 0.5) * 4
			local pos = rimPt(side, along, HALF + 3.6, itopY - 3.9)
			Art.Shard(ice, pos, 0.5 + Art.Hash(side, k, 632) * 0.5, 2 + Art.Hash(side, k, 633) * 6, 1600 + side * 40 + k, Color3.fromRGB(200, 234, 255), 3, false)
		end
	end
	-- frosted crystal lamp posts on the rim corners
	for _, cs in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(1, 1), Vector2.new(-1, 1) } do
		local base = Vector3.new(c.X + cs.X * (HALF + 2), itopY + 1, c.Z + cs.Y * (HALF + 2))
		cylY(ice, "LampFoot", base + Vector3.new(0, 0.5, 0), 3, 1, Color3.fromRGB(60, 80, 120))
		cylY(ice, "LampPole", base + Vector3.new(0, 4, 0), 0.7, 7, Color3.fromRGB(60, 80, 120))
		local head = Art.Static(ice, { Name = "LampCrystal", Size = Vector3.new(1.6, 2.6, 1.6), CFrame = CFrame.new(base + Vector3.new(0, 8.6, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = IC.Crystal, Material = Enum.Material.Neon })
		cylY(ice, "LampCap", base + Vector3.new(0, 10.1, 0), 2.6, 0.5, IC.Snow)
		Art.Light(head, IC.Crystal, 20, 1.6)
	end
	-- snowmen + frozen waterfalls on the floating floes
	for k, p in themeSpots(8, 81, 44, 92) do
		local r = 7 + Art.Hash(k, 82) * 5
		if k % 3 == 1 then
			local b = p + Vector3.new(r * 0.3, 0, -r * 0.2)
			local SN = Color3.fromRGB(250, 252, 255)
			local function ball(name: string, pos: Vector3, d: number, col: Color3)
				Art.Static(ice, { Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = CFrame.new(pos), Color = col })
			end
			ball("SnowBase", b + Vector3.new(0, 1.7, 0), 4, SN)
			ball("SnowBody", b + Vector3.new(0, 4.2, 0), 3, SN)
			ball("SnowHead", b + Vector3.new(0, 6.2, 0), 2.2, SN)
			local face = (A.Center - b) * Vector3.new(1, 0, 1)
			local fd = face.Magnitude > 0.1 and face.Unit or Vector3.zAxis
			local sd = Vector3.new(-fd.Z, 0, fd.X)
			Art.Static(ice, { Name = "Carrot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 0.35, 0.35), CFrame = CFrame.lookAt(b + Vector3.new(0, 6.2, 0) + fd * 1.4, b + Vector3.new(0, 6.2, 0) + fd * 3) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(255, 130, 30) })
			for e = -1, 1, 2 do
				ball("Eye", b + Vector3.new(0, 6.6, 0) + fd * 0.95 + sd * e * 0.45, 0.32, Color3.fromRGB(30, 30, 36))
			end
			for q = 0, 2 do
				ball("Button", b + Vector3.new(0, 3.6 + q * 0.6, 0) + fd * 1.42, 0.3, Color3.fromRGB(30, 30, 36))
			end
			for e = -1, 1, 2 do
				local from = b + Vector3.new(0, 4.6, 0) + sd * e * 1.3
				bar(ice, from, from + sd * e * 2.4 + Vector3.new(0, 1.2, 0), 0.22, Color3.fromRGB(110, 76, 50), "StickArm")
			end
			cylY(ice, "HatBrim", b + Vector3.new(0, 7.25, 0), 2.6, 0.25, Color3.fromRGB(36, 36, 44))
			cylY(ice, "HatTop", b + Vector3.new(0, 8.1, 0), 1.7, 1.6, Color3.fromRGB(36, 36, 44))
			cylY(ice, "HatBand", b + Vector3.new(0, 7.55, 0), 1.75, 0.35, Color3.fromRGB(220, 60, 60))
			Art.Static(ice, { Name = "Scarf", Size = Vector3.new(2.6, 0.5, 2.6), CFrame = CFrame.new(b + Vector3.new(0, 5.3, 0)), Color = Color3.fromRGB(220, 60, 60) })
		elseif k % 3 == 2 then
			-- a frozen waterfall pouring off the floe down to the lake
			local top = p + Vector3.new(r * 0.8, -0.5, 0)
			local len = math.max(4, top.Y - seaY)
			cylY(ice, "FrozenFall", top - Vector3.new(0, len / 2, 0), 4.5, len, Color3.fromRGB(176, 220, 250), nil, 0.15)
			cylY(ice, "FrozenFallCore", top - Vector3.new(0, len / 2, 0), 2.6, len, Color3.fromRGB(226, 244, 255), nil, 0)
			cylY(ice, "FrozenSplash", Vector3.new(top.X, seaY + 1.2, top.Z), 12, 1.6, IC.Snow)
		end
	end
	-- glittering diamond dust in the air
	emitter(snow, {
		Rate = 30, Lifetime = NumberRange.new(4, 7), Speed = NumberRange.new(1, 2.5), EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(40, 40), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(200, 240, 255)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.22), NumberSequenceKeypoint.new(1, 0) }),
	})
	Art.Toon(ice)
	for _, d in ice:GetChildren() do
		if d:IsA("BasePart") and (d.Name == "FrozenFall" or d.Name == "FrozenFallCore") then
			d.Material = Enum.Material.Glacier
		end
	end
	local fs = ice:FindFirstChild("FrozenSea") :: BasePart?
	if fs then
		fs.Material = Enum.Material.Glacier -- keep the real ice texture on the lake
		fs.Reflectance = 0.12
	end
	-- v0.8.5: the Ice Rink's own stadium: frosted-blue stands, snow on every canopy, icicles
	themedStadium(ice, {
		Wood = Color3.fromRGB(178, 212, 240), WoodDark = Color3.fromRGB(116, 160, 210), Light = Color3.fromRGB(246, 250, 255),
		Accents = { Color3.fromRGB(86, 156, 230), Color3.fromRGB(236, 246, 255), Color3.fromRGB(52, 104, 186) },
		Grass = IC.DecorGrass, Rock = IC.Rock, Glow = IC.Crystal,
	}, "Ice")
	ice.Parent = ServerStorage
	themeFolders.Ice = ice
end

-- v0.8.5 IMMERSION SETS: landmarks for the south sector (where the Yard + lobby normally block
-- the view). They live in ReplicatedStorage.Immersion.<Map>; MoodController clones them in for
-- players who are IN the match on that map, and hides the lobby for them, so all they see is
-- that map's world. Purely visual: nothing collides.
local function buildImmersion()
	local c = A.Center
	local seaY = A.KillY - 16
	local MC = Config.Maps.Molten
	local IC = Config.Maps.Ice
	local root = Instance.new("Folder")
	root.Name = "Immersion"
	local function cylY(parent: Instance, name: string, pos: Vector3, d: number, h: number, col: Color3, mat: Enum.Material?, tr: number?): Part
		return Art.Static(parent, { Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, d, d), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = col, Material = mat or Enum.Material.SmoothPlastic, Transparency = tr or 0 })
	end
	-- spots in the south wedge (z > c.Z + 56, |x| < 170), ring by ring
	local function south(count: number, seed: number, zMin: number, zMax: number, xMax: number): { Vector3 }
		local out = {}
		for k = 1, count do
			local x = c.X + ((k - 0.5) / count * 2 - 1) * xMax + (Art.Hash(seed, k) - 0.5) * (xMax / count)
			local z = c.Z + zMin + Art.Hash(seed, k, 2) * (zMax - zMin)
			table.insert(out, Vector3.new(x, 0, z))
		end
		return out
	end

	-- MOLTEN ------------------------------------------------------------
	local LAVA, HOT = MC.Lava, MC.LavaHot
	local m = Instance.new("Folder")
	m.Name = "Molten"
	-- jagged basalt spires right behind the south edge
	for k, p in south(9, 501, HALF + 18, HALF + 70, 150) do
		local base = Vector3.new(p.X, seaY - 1, p.Z)
		local h = (c.Y - 16 - seaY) + Art.Hash(k, 502) * 26
		local r = 5 + Art.Hash(k, 503) * 8
		Art.Shard(m, base, r, -h, 5000 + k, k % 2 == 0 and MC.Rock or MC.RockLight, 6, false)
		if k % 2 == 1 then
			bar(m, base + Vector3.new(r * 0.5, h * 0.55, 0), base + Vector3.new(r * 0.95, 1, 0), 1, HOT, "LavaSeep").Material = Enum.Material.Neon
		end
	end
	-- floating basalt chunks pouring lava falls
	for k, p in south(4, 511, HALF + 60, HALF + 120, 130) do
		local top = Vector3.new(p.X, c.Y - 10 + Art.Hash(k, 512) * 26, p.Z)
		local sz = 12 + Art.Hash(k, 513) * 12
		Art.Shard(m, top, sz * 0.55, sz * 1.4, 5100 + k, MC.Rock, 6, false)
		Art.Rock(m, top - Vector3.new(0, sz * 0.08, 0), sz * 1.2, 5110 + k, MC.RockLight)
		local from = top + Vector3.new(sz * 0.3, -sz * 0.25, 0)
		local len = math.max(4, from.Y - seaY)
		local fall = cylY(m, "LavaFall", from - Vector3.new(0, len / 2, 0), 3, len, LAVA, Enum.Material.Neon, 0.1)
		Art.Light(fall, LAVA, 30, 2)
	end
	-- three big volcanoes on the horizon
	for k, p in south(3, 521, HALF + 210, HALF + 290, 150) do
		local base = Vector3.new(p.X, seaY - 2, p.Z)
		local r = 40 + Art.Hash(k, 522) * 20
		local h = 120 + Art.Hash(k, 523) * 60
		Art.Shard(m, base, r, -h, 5200 + k, MC.Rock, 8, false)
		local sh = Art.Hash(k, 524) * math.pi * 2
		Art.Shard(m, base + Vector3.new(math.cos(sh) * r * 0.5, 0, math.sin(sh) * r * 0.5), r * 0.7, -h * 0.55, 5210 + k, MC.RockLight, 7, false)
		local tip = base + Vector3.new(0, h * 0.86, 0)
		local crater = Art.Static(m, { Name = "Crater", Shape = Enum.PartType.Ball, Size = Vector3.new(r * 0.32, r * 0.32, r * 0.32), CFrame = CFrame.new(tip), Color = HOT, Material = Enum.Material.Neon })
		Art.Light(crater, LAVA, 60, 4)
		emitter(crater, {
			Rate = 5, Lifetime = NumberRange.new(14, 20), Speed = NumberRange.new(10, 16), EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(10, 10), Acceleration = Vector3.new(2.5, 0.6, 0), Color = ColorSequence.new(Color3.fromRGB(56, 46, 44), Color3.fromRGB(110, 96, 92)),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }), Size = NumberSequence.new(14, 46), RotSpeed = NumberRange.new(-10, 10),
		})
		for q = 1, 4 do
			local ang = Art.Hash(k, q, 525) * math.pi * 2
			local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
			bar(m, base + dir * (r * 0.16) + Vector3.new(0, h * 0.84, 0), base + dir * r + Vector3.new(0, 2, 0), 2.6, q % 2 == 0 and HOT or LAVA, "LavaRiver").Material = Enum.Material.Neon
		end
	end
	-- lava fountains spurting out of the ocean
	for k, p in south(3, 531, HALF + 120, HALF + 170, 120) do
		local mound = Art.Static(m, { Name = "FountainMound", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), CFrame = CFrame.new(p.X, seaY - 3, p.Z), Color = HOT, Material = Enum.Material.Neon })
		Art.Light(mound, LAVA, 40, 3)
		emitter(mound, {
			Rate = 40, Lifetime = NumberRange.new(2.2, 3), Speed = NumberRange.new(34, 48), EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(9, 9), Acceleration = Vector3.new(0, -32, 0), LightEmission = 1,
			Color = ColorSequence.new(HOT, LAVA), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.6), NumberSequenceKeypoint.new(1, 0.6) }),
		})
		for q = 1, 5 do -- dark crust ring around each fountain
			local ang = q / 5 * math.pi * 2 + k
			cylY(m, "CrustRaft", Vector3.new(p.X + math.cos(ang) * 11, seaY + 0.9, p.Z + math.sin(ang) * 11), 7 + Art.Hash(k, q, 532) * 5, 1.2, MC.Crust)
		end
	end
	Art.Toon(m, 0)
	m.Parent = root

	-- ICE ---------------------------------------------------------------
	local i = Instance.new("Folder")
	i.Name = "Ice"
	local SNOW, BERG, BERG2, CRY = IC.Snow, IC.Rock, IC.RockDark, IC.Crystal
	-- icebergs just behind the south edge, with snow lids
	for k, p in south(8, 601, HALF + 20, HALF + 80, 150) do
		local base = Vector3.new(p.X, seaY - 1, p.Z)
		local h = 22 + Art.Hash(k, 602) * 38
		local r = 7 + Art.Hash(k, 603) * 9
		Art.Shard(i, base, r, -h, 6000 + k, k % 2 == 0 and BERG or Color3.fromRGB(226, 242, 255), 5, false)
		Art.Shard(i, base + Vector3.new(r * 0.6, 0, r * 0.3), r * 0.6, -h * 0.6, 6010 + k, BERG2, 5, false)
		cylY(i, "BergSnow", base + Vector3.new(0, 1.2, 0), r * 2.6, 1.4, SNOW)
	end
	-- big glacier mountains on the horizon with snow caps
	for k, p in south(4, 611, HALF + 200, HALF + 300, 160) do
		local base = Vector3.new(p.X, seaY - 2, p.Z)
		local r = 46 + Art.Hash(k, 612) * 24
		local h = 130 + Art.Hash(k, 613) * 70
		Art.Shard(i, base, r, -h, 6100 + k, BERG, 7, false)
		Art.Shard(i, base + Vector3.new(0, h * 0.62, 0), r * 0.42, -h * 0.4, 6110 + k, SNOW, 7, false)
		local sh = Art.Hash(k, 614) * math.pi * 2
		Art.Shard(i, base + Vector3.new(math.cos(sh) * r * 0.55, 0, math.sin(sh) * r * 0.55), r * 0.66, -h * 0.55, 6120 + k, BERG2, 6, false)
	end
	-- crystal ice arches over the frozen lake
	for k, p in south(2, 621, HALF + 110, HALF + 150, 90) do
		local span, rise = 34 + Art.Hash(k, 622) * 10, 30 + Art.Hash(k, 623) * 10
		local yaw = (Art.Hash(k, 624) - 0.5) * 0.8
		local rot = CFrame.new(p.X, seaY, p.Z) * CFrame.Angles(0, yaw, 0)
		local prev: Vector3? = nil
		for q = 0, 10 do
			local t = q / 10 * math.pi
			local pt = (rot * CFrame.new(math.cos(t) * span, math.sin(t) * rise, 0)).Position
			if prev then
				local seg = bar(i, prev :: Vector3, pt, 5.5 - math.sin(t) * 2, q % 3 == 0 and Color3.fromRGB(220, 244, 255) or CRY, "IceArch")
				seg.Material = Enum.Material.Glacier
			end
			prev = pt
		end
		local glow = Art.Static(i, { Name = "ArchGlow", Size = Vector3.new(1, 1, 1), CFrame = rot * CFrame.new(0, rise, 0), Transparency = 1 })
		Art.Light(glow, CRY, 40, 1.5)
	end
	-- frozen-solid waves (curling ice sheets) on the lake
	for k, p in south(5, 631, HALF + 70, HALF + 140, 150) do
		local yaw = Art.Hash(k, 632) * math.pi
		Art.Static(i, { Name = "IceWave", Size = Vector3.new(26, 7, 3), CFrame = CFrame.new(p.X, seaY + 3, p.Z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(-25), 0, 0), Color = Color3.fromRGB(196, 230, 252), Material = Enum.Material.Glacier })
		cylY(i, "SnowDrift", Vector3.new(p.X, seaY + 0.7, p.Z), 22, 1, SNOW)
	end
	Art.Toon(i)
	for _, d in i:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "IceArch" or d.Name == "IceWave") then
			d.Material = Enum.Material.Glacier
		end
	end
	i.Parent = root

	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	root.Parent = ReplicatedStorage
end

function ArenaService.Build()
	folder = Instance.new("Folder")
	folder.Name = "Arena"

	local tileFolder = Instance.new("Folder")
	tileFolder.Name = "Tiles"
	tileFolder.Parent = folder

	for iz = 0, N - 1 do
		for ix = 0, N - 1 do
			local i = index(ix, iz)
			local checker = (ix + iz) % 2 == 0
			local ring0 = ringOf(ix, iz)
			local p = Instance.new("Part")
			p.Name = tostring(i)
			p.Anchored = true
			-- v0.7: 0.3-stud grout seams (the void glows through), stable per-tile shade variation,
			-- and a steel diamond-plate core so the never-falling centre reads at a glance.
			p.Size = Vector3.new(TS - A.Grout, A.TileThickness, TS - A.Grout)
			p.CFrame = CFrame.new(MIN_X + (ix + 0.5) * TS, A.Center.Y - A.TileThickness / 2, MIN_Z + (iz + 0.5) * TS)
			local shade = 0.93 + Art.Hash(ix, iz) * 0.1
			if ring0 < Config.Shrink.CoreRings then
				p.Color = Art.Shade(A.CoreColor, shade)
				p.Material = Enum.Material.SmoothPlastic -- v0.7.2 flat reference look (core = sky-blue)
			else
				p.Color = Art.Shade(checker and A.ColorA or A.ColorB, shade)
				p.Material = checker and A.MaterialA or A.MaterialB
			end
			p.TopSurface = Enum.SurfaceType.Smooth
			p.BottomSurface = Enum.SurfaceType.Smooth
			p.Parent = tileFolder
			local ring = ringOf(ix, iz)
			tiles[i] = {
				Part = p,
				IX = ix,
				IZ = iz,
				Ring = ring,
				State = 0,
				Outer = ring >= A.OuterRingFrom,
				ListPos = 0,
				FallAt = 0,
				RedAt = 0,
				Red = false,
				CrackAt = 0,
				Cracked = false,
				BaseColor = p.Color,
				BaseMaterial = p.Material,
				OrigColor = p.Color,
				OrigMaterial = p.Material,
			}
			ringTiles[ring] = ringTiles[ring] or {}
			table.insert(ringTiles[ring], i)
		end
	end

	buildDecor(folder)
	buildThemes()
	buildImmersion()
	-- v0.9.10 variety pass on the CLASSIC stadium + sky (after the themed copies were cloned from it,
	-- so Molten / Ice keep their own recolours)
	do
		local F = Art.Families
		local fams = { F.Wood, F.WoodLight, F.WoodDark, F.Rock, F.RockDark, F.Grass, F.Dirt }
		for k, root in { stadium, gridSet, rimRocks } do
			if root then
				Art.Vary(root :: Instance, fams, k * 31)
			end
		end
	end
	for _, r in rimParts do
		rimOrig[r.Part] = { Color = r.Part.Color, Material = r.Part.Material }
	end
	if cloudSea then
		seaOrig = { Color = (cloudSea :: Part).Color, Material = (cloudSea :: Part).Material }
	end

	folder.Parent = workspace
	ArenaService.Reset()
end

------------------------------------------------------------------------
-- Tile state changes
------------------------------------------------------------------------
local function occupiedSet(): { [number]: boolean }
	local set = {}
	if occupancyProvider then
		for _, pos in occupancyProvider() do
			if pos.Y > A.Center.Y - 2 and pos.Y < A.Center.Y + 10 then
				local i = ArenaService.TileAt(pos)
				if i then
					set[i] = true
				end
			end
		end
	end
	return set
end

------------------------------------------------------------------------
-- v0.8.1 hazards: MAGMA POOLS (Molten Core) and FROST TRAPS (Ice Rink)
------------------------------------------------------------------------
local function mapDef(): any
	return Config.Maps[currentMap] or Config.Maps.Grid
end

clearMagma = function(i: number, restore: boolean)
	local pool = magma[i]
	if not pool then
		return
	end
	magma[i] = nil
	if pool.Floor then
		(pool.Floor :: Part):Destroy()
	end
	if pool.Fx then
		(pool.Fx :: Model):Destroy()
	end
	local t = tiles[i]
	t.Part:SetAttribute("Magma", nil)
	if restore and t.State == 0 then
		t.Part.CanCollide = true
		t.Part.Transparency = 0
		t.Part.Color = t.BaseColor
		t.Part.Material = t.BaseMaterial
		t.Part.Reflectance = mapDef().Reflectance or 0
	end
end

clearTrap = function(i: number, restore: boolean)
	if traps[i] == nil then
		return
	end
	traps[i] = nil
	local mark = trapMarks[i]
	if mark then
		mark:Destroy()
		trapMarks[i] = nil
	end
	local t = tiles[i]
	if restore and t.State == 0 then
		t.Part.Color = t.BaseColor
		t.Part.Material = t.BaseMaterial
		t.Part.Reflectance = mapDef().Reflectance or 0
	end
end

-- a random healthy tile (often near a fighter) that has no other hazard on it
local function pickHazardTile(near: number, minRing: number, occ: { Vector3 }): number?
	for _ = 1, 14 do
		local i: number? = nil
		if #occ > 0 and math.random() < near then
			local p = occ[math.random(1, #occ)]
			i = ArenaService.TileAt(p + Vector3.new(math.random(-2, 2) * TS, 0, math.random(-2, 2) * TS))
		else
			local list = (#innerList > 0 and math.random() < 0.6) and innerList or outerList
			if #list == 0 then
				list = innerList
			end
			i = #list > 0 and list[math.random(1, #list)] or nil
		end
		if i then
			local t = tiles[i]
			if t.State == 0 and not geysers[i] and not magma[i] and traps[i] == nil and t.Ring < shrinkRing and t.Ring >= minRing then
				return i
			end
		end
	end
	return nil
end

local function onTile(p: Vector3, c: Vector3, below: number, above: number): boolean
	local h = TS / 2
	return math.abs(p.X - c.X) < h and math.abs(p.Z - c.Z) < h and p.Y > c.Y - below and p.Y < c.Y + above
end

local function makeTrapMark(i: number): Model
	local IC = Config.Maps.Ice
	local c = ArenaService.TileCenter(i)
	local m = Instance.new("Model")
	m.Name = "FrostMark"
	for k = 0, 2 do
		local bar = Instance.new("Part")
		bar.Anchored = true
		bar.CanCollide = false
		bar.CanQuery = false
		bar.CanTouch = false
		bar.CastShadow = false
		bar.Material = Enum.Material.Neon
		bar.Color = IC.Crystal
		bar.Transparency = 0.35
		bar.Size = Vector3.new(4.6, 0.06, 0.32)
		bar.CFrame = CFrame.new(c + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, math.rad(k * 60), 0)
		bar.Parent = m
		for _, sx in { -1, 1 } do -- little snowflake ticks at both ends
			for _, sa in { -1, 1 } do
				local tick = bar:Clone()
				tick.Size = Vector3.new(0.9, 0.06, 0.22)
				tick.CFrame = bar.CFrame * CFrame.new(sx * 1.7, 0, 0) * CFrame.Angles(0, math.rad(sa * 45), 0) * CFrame.new(sx * 0.3, 0, 0)
				tick.Parent = m
			end
		end
	end
	local glint = Instance.new("Part")
	glint.Anchored, glint.CanCollide, glint.CanQuery, glint.CanTouch = true, false, false, false
	glint.Transparency = 1
	glint.Size = Vector3.new(5, 0.2, 5)
	glint.CFrame = CFrame.new(c + Vector3.new(0, 0.2, 0))
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(220, 250, 255))
	pe.Rate = 4
	pe.Lifetime = NumberRange.new(0.6, 1.0)
	pe.Speed = NumberRange.new(0.5, 1.5)
	pe.Size = NumberSequence.new(0.35, 0)
	pe.LightEmission = 0.8
	pe.Parent = glint
	glint.Parent = m
	m.Parent = folder
	return m
end

local function warnTile(i: number, now: number, occupied: { [number]: boolean }, fixedTime: number?)
	local t = tiles[i]
	if t.State ~= 0 then
		return
	end
	if magma[i] then
		if not fixedTime then
			return -- random holes skip magma pools (they already have their own way to drop)
		end
		clearMagma(i, true) -- the shrink ring hardens the pool, then drops it with the ring
	end
	listRemove(i)
	t.State = 1
	local wt = fixedTime or (occupied[i] and A.WarnTimeOccupied or A.WarnTime)
	t.FallAt = now + wt
	t.RedAt = now + wt * A.RedAt
	t.Red = false
	t.CrackAt = now + wt * A.CrackAt
	t.Cracked = false
	warned[i] = true
	geysers[i] = nil
	local frost = (Config.Maps[currentMap] or Config.Maps.Grid).FrostDelay or 0
	if frost > 0 and not fixedTime then
		-- Ice Rink: the crack shows up a moment late (the tile still drops on time)
		frostUntil[i] = now + frost
	else
		t.Part.Color = A.WarnColor
		t.Part.Material = Enum.Material.SmoothPlastic
		t.Part.Reflectance = 0
		table.insert(pendingWarn, i)
	end
end

-- v0.9.12 HOLE EDGES: every hole gets a glowing outline (a lip down the inside of the hole plus a
-- line on the floor around it) so holes read at a glance even when the drop below is dark.
-- Colour comes from the map (Config.Maps[x].HoleEdge); Classic has none (approved look).
local holeEdges: { [number]: { [number]: { Part } } } = {}
local holeFolder: Folder? = nil
local HOLE_DIRS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }

local function removeHoleEdge(i: number, d: number)
	local h = holeEdges[i]
	local list = h and h[d]
	if h and list then
		for _, p in list do
			p:Destroy()
		end
		h[d] = nil
	end
end

local function addHoleEdges(i: number)
	local map = Config.Maps[currentMap] or Config.Maps.Grid
	local col: Color3? = map.HoleEdge
	local t = tiles[i]
	for d, v in HOLE_DIRS do
		local jx, jz = t.IX + v[1], t.IZ + v[2]
		local opp = (d % 2 == 1) and d + 1 or d - 1
		if jx >= 0 and jz >= 0 and jx < N and jz < N then
			local j = index(jx, jz)
			if tiles[j].State == 2 then
				removeHoleEdge(j, opp) -- the wall between two holes is gone
			elseif col then
				local hf = holeFolder
				if not hf then
					local nf = Instance.new("Folder")
					nf.Name = "HoleEdges"
					nf.Parent = folder
					holeFolder = nf
					hf = nf
				end
				local c = ArenaService.TileCenter(i)
				local dv = Vector3.new(v[1], 0, v[2])
				local face = TS / 2 + A.Grout / 2
				local len = TS - A.Grout
				local xSide = v[1] ~= 0
				local lip = Art.Static(hf :: Folder, {
					Name = "HoleLip", Size = xSide and Vector3.new(0.24, 0.9, len) or Vector3.new(len, 0.9, 0.24),
					CFrame = CFrame.new(c + dv * (face - 0.13) - Vector3.new(0, 0.47, 0)), Color = col, Material = Enum.Material.Neon,
				})
				local line = Art.Static(hf :: Folder, {
					Name = "HoleLine", Size = xSide and Vector3.new(0.45, 0.06, len) or Vector3.new(len, 0.06, 0.45),
					CFrame = CFrame.new(c + dv * (face + 0.24) + Vector3.new(0, 0.04, 0)), Color = col, Material = Enum.Material.Neon, Transparency = 0.1,
				})
				holeEdges[i] = holeEdges[i] or {}
				holeEdges[i][d] = { lip, line }
			end
		end
	end
end

local function clearHoleEdges()
	table.clear(holeEdges)
	if holeFolder then
		holeFolder:ClearAllChildren()
	end
end

local function fallTile(i: number)
	local t = tiles[i]
	if t.State == 2 then
		return
	end
	if t.State == 0 then
		listRemove(i)
	end
	t.State = 2
	warned[i] = nil
	frostUntil[i] = nil
	geysers[i] = nil
	clearMagma(i, false)
	clearTrap(i, false)
	t.Part.Transparency = 1
	t.Part.CanCollide = false
	t.Part.CanQuery = false
	table.insert(pendingFall, i)
	addHoleEdges(i)
end

local function pickAndWarn(now: number, occupied: { [number]: boolean })
	local useOuter
	if #outerList > 0 and #innerList > 0 then
		useOuter = math.random() < A.FunnelOuterWeight
	else
		useOuter = #outerList > 0
	end
	local list = useOuter and outerList or innerList
	if #list == 0 then
		return
	end
	-- don't waste random holes on the ring that is about to shrink away anyway
	for attempt = 1, 4 do
		local i = list[math.random(1, #list)]
		if tiles[i].Ring < shrinkRing or attempt == 4 then
			warnTile(i, now, occupied)
			return
		end
	end
end

-- v0.9.20 Squeaky Hammer: the tile under the impact starts cracking (normal warn time, so it
-- drops a few seconds later). Healthy tiles only; returns true when a tile started cracking.
function ArenaService.CrackAt(pos: Vector3): boolean
	if not active then
		return false
	end
	local i = ArenaService.TileAt(pos)
	-- the never-falling centre (CoreRings) is safe from the hammer too
	if not i or tiles[i].State ~= 0 or tiles[i].Ring < Config.Shrink.CoreRings then
		return false
	end
	warnTile(i, workspace:GetServerTimeNow(), {})
	return tiles[i].State == 1
end

-- Bomb Bag: drop tiles that are ALREADY cracking inside the radius (never healthy ones)
function ArenaService.ForceFallWarnedInRadius(pos: Vector3, radius: number)
	local flat = Vector3.new(pos.X, A.Center.Y, pos.Z)
	for i in warned do
		if (ArenaService.TileCenter(i) - flat).Magnitude <= radius + TS * 0.5 then
			fallTile(i)
		end
	end
end

------------------------------------------------------------------------
-- Round lifecycle
------------------------------------------------------------------------
function ArenaService.Reset()
	active = false
	table.clear(outerList)
	table.clear(innerList)
	table.clear(warned)
	table.clear(frostUntil)
	table.clear(geysers)
	nextGeyserAt = math.huge
	for i in magma do
		clearMagma(i, false)
	end
	for i in traps do
		clearTrap(i, false)
	end
	nextMagmaAt, nextTrapAt = math.huge, math.huge
	magmaAnnounced, trapsAnnounced = false, false
	for _, d in drops do
		if d.Model then
			(d.Model :: Model):Destroy()
		end
	end
	table.clear(drops)
	nextDropAt, nextGustAt = math.huge, math.huge
	eruptionDone = false
	setGust("", Vector3.zero, 0)
	local map = Config.Maps[currentMap] or Config.Maps.Grid
	for i, t in tiles do
		t.State = 0
		t.Red = false
		t.Cracked = false
		t.Part.Color = t.BaseColor
		t.Part.Material = t.BaseMaterial
		t.Part.Reflectance = map.Reflectance or 0
		t.Part.Transparency = 0
		t.Part.CanCollide = true
		t.Part.CanQuery = true
		t.Part:SetAttribute("Magma", nil)
		listAdd(i)
	end
	table.clear(pendingWarn)
	table.clear(pendingFall)
	clearHoleEdges()
	tileEvent:FireAllClients("reset", {})
end

function ArenaService.Start(now: number, scale: number?, hazards: number?)
	active = true
	hazardScale = hazards or 1
	local mapDef = Config.Maps[currentMap] or Config.Maps.Grid
	nextMagmaAt = mapDef.Magma and (now + mapDef.Magma.FirstAt / hazardScale) or math.huge
	nextTrapAt = mapDef.Traps and (now + mapDef.Traps.FirstAt / hazardScale) or math.huge
	nextDropAt = mapDef.Drops and (now + mapDef.Drops.FirstAt / hazardScale) or math.huge
	nextGustAt = mapDef.Gusts and (now + mapDef.Gusts.FirstAt / hazardScale) or math.huge
	eruptionDone = false
	roundStart = now
	accum = 0
	collapseScale = scale or 1
	shrinkRing = N / 2 - 1
	nextShrinkAt = now + Config.Shrink.FirstAt / collapseScale
	local gz = (Config.Maps[currentMap] or Config.Maps.Grid).Geysers
	nextGeyserAt = gz and (now + gz.FirstAt) or math.huge
	dangerRing = math.huge
	ReplicatedStorage:SetAttribute("ShrinkAt", nextShrinkAt)
end

function ArenaService.Stop()
	active = false
	setGust("", Vector3.zero, 0)
	dangerRing = math.huge
	ReplicatedStorage:SetAttribute("ShrinkAt", 0)
end

-- Ring index of a world position (0 = centre). Used by bots and the HUD.
function ArenaService.RingAt(pos: Vector3): number
	local i = ArenaService.TileAt(pos)
	return i and tiles[i].Ring or math.huge
end

function ArenaService.NextShrink(): (number, number)
	return shrinkRing, nextShrinkAt
end

function ArenaService.CurrentPhase(now: number)
	local t = ArenaService.Elapsed(now)
	for _, ph in Config.Collapse do
		if t >= ph.From and t < ph.To then
			return ph
		end
	end
	return Config.Collapse[#Config.Collapse]
end

-- v0.8.2 BLIZZARD GUSTS (Ice Rink): replicated so every client (and the bot skater) can push
setGust = function(phase: string, dir: Vector3, untilT: number)
	gustPhase = phase
	gustDir = dir
	gustChangeAt = untilT
	ReplicatedStorage:SetAttribute("WindDir", dir)
	ReplicatedStorage:SetAttribute("WindPhase", phase)
	ReplicatedStorage:SetAttribute("WindUntil", untilT > 0 and (workspace:GetServerTimeNow() + (untilT - clockNow)) or 0)
	if blizzard then
		local bz = blizzard :: Part
		local pe = bz:FindFirstChildOfClass("ParticleEmitter")
		if dir.Magnitude > 0 then
			bz.CFrame = CFrame.lookAt(bz.Position, bz.Position + dir)
		end
		if pe then
			pe.Enabled = phase == "blow"
			pe.Rate = phase == "blow" and 420 or 0
		end
	end
end

-- the current wind push (studs/s) for skaters; zero when calm
function ArenaService.Wind(): Vector3
	if gustPhase == "blow" then
		local gu = (Config.Maps[currentMap] or Config.Maps.Grid).Gusts
		return gustDir * (gu and gu.Speed or 0)
	end
	return Vector3.zero
end

function ArenaService.SetDropHandler(fn: (Vector3, number) -> ())
	dropHandler = fn
end

-- v0.8.2 CRANE DROPS (The Grid): a 1-ton weight hangs over a tile, the cable snaps, it slams down
local function makeWeight(top: Vector3): (Model, BasePart)
	local m = Instance.new("Model")
	m.Name = "CraneWeight"
	local STEEL = Color3.fromRGB(70, 74, 90)
	local YEL = Color3.fromRGB(255, 196, 40)
	local body = Art.Static(m, { Name = "Body", Size = Vector3.new(5.6, 4, 5.6), CFrame = CFrame.new(top), Color = STEEL, Material = Enum.Material.Metal })
	Art.Static(m, { Name = "Band", Size = Vector3.new(5.8, 1, 5.8), CFrame = CFrame.new(top + Vector3.new(0, 0.6, 0)), Color = YEL })
	Art.Static(m, { Name = "Cap", Size = Vector3.new(3.6, 0.8, 3.6), CFrame = CFrame.new(top + Vector3.new(0, 2.4, 0)), Color = STEEL, Material = Enum.Material.Metal })
	Art.Static(m, { Name = "Eye", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 2, 2), CFrame = CFrame.new(top + Vector3.new(0, 3.4, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = YEL })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 24
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 0.55)
		t.Position = UDim2.fromScale(0, 0.42)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.TextColor3 = YEL
		t.Text = "1 TON"
		t.Parent = sg
		sg.Parent = body
	end
	m.PrimaryPart = body
	local cable = Art.Static(m, { Name = "Cable", Size = Vector3.new(0.25, 70, 0.25), CFrame = CFrame.new(top + Vector3.new(0, 3.8 + 35, 0)), Color = Color3.fromRGB(50, 52, 64) })
	m.Parent = folder
	return m, cable
end

local function stepDrops(dt: number, now: number, occ: { Vector3 })
	local dr = (Config.Maps[currentMap] or Config.Maps.Grid).Drops
	if active and dr and now >= nextDropAt then
		nextDropAt = now + dr.Every / hazardScale
		local elapsed = now - roundStart
		local picked: { number } = {}
		for _ = 1, (elapsed >= dr.MoreAfter and dr.CountLate or dr.Count) do
			local i = pickHazardTile(dr.NearPlayers, 0, occ)
			if i then
				local top = ArenaService.TileCenter(i) + Vector3.new(0, 2, 0)
				local hang = top + Vector3.new(0, 44, 0)
				local m, cable = makeWeight(hang)
				table.insert(drops, { Tile = i, At = now + dr.Warn, SnapAt = now + dr.Warn - dr.FallTime, Model = m, Cable = cable, Top = top, Landed = false, GoneAt = math.huge })
				table.insert(picked, i)
			end
		end
		if #picked > 0 then
			tileEvent:FireAllClients("drop", picked, dr.Warn)
			if math.random() < 0.5 then
				local lines = Config.Announcer.Drop
				announceRemote:FireAllClients(lines[math.random(1, #lines)], "phase")
			end
		end
	end
	for k = #drops, 1, -1 do
		local d = drops[k]
		local m = d.Model
		if not d.Landed then
			if m then
				local hang = d.Top + Vector3.new(0, 44, 0)
				local y
				if now < d.SnapAt then
					-- swaying on the cable
					local sway = math.sin(now * 3 + d.Tile) * 0.6
					(m :: Model):PivotTo(CFrame.new(hang + Vector3.new(sway, 0, 0)) * CFrame.Angles(0, 0, math.rad(sway * 3)))
				else
					if d.Cable then
						(d.Cable :: BasePart):Destroy()
						d.Cable = nil
					end
					local u = math.clamp((now - d.SnapAt) / math.max(0.05, d.At - d.SnapAt), 0, 1)
					y = 44 * (1 - u * u)
					;(m :: Model):PivotTo(CFrame.new(d.Top + Vector3.new(0, y, 0)))
				end
			end
			if now >= d.At then
				d.Landed = true
				d.GoneAt = now + 2.5
				if m then
					(m :: Model):PivotTo(CFrame.new(d.Top) * CFrame.Angles(0, 0, math.rad(4)))
				end
				local center = ArenaService.TileCenter(d.Tile)
				tileEvent:FireAllClients("slam", { d.Tile })
				if dropHandler and dr then
					task.spawn(dropHandler :: (Vector3, number) -> (), center, dr.Radius)
				end
				-- crack the impact tile + its 4 neighbours (never the core)
				local t0 = tiles[d.Tile]
				for _, o in { { 0, 0 }, { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
					local ix, iz = t0.IX + o[1], t0.IZ + o[2]
					if ix >= 0 and iz >= 0 and ix < N and iz < N then
						local j = index(ix, iz)
						if tiles[j].Ring >= Config.Shrink.CoreRings and tiles[j].State == 0 then
							warnTile(j, now, {}, dr and dr.BreakTime or 0.9)
						end
					end
				end
			end
		elseif now >= d.GoneAt or tiles[d.Tile].State == 2 then
			if m then
				(m :: Model):Destroy()
			end
			table.remove(drops, k)
		end
	end
end

local function stepGusts(now: number)
	local gu = (Config.Maps[currentMap] or Config.Maps.Grid).Gusts
	if not gu then
		return
	end
	if active and gustPhase == "" and now >= nextGustAt then
		local dirs = { { Vector3.new(0, 0, 1), "NORTH" }, { Vector3.new(0, 0, -1), "SOUTH" }, { Vector3.new(1, 0, 0), "WEST" }, { Vector3.new(-1, 0, 0), "EAST" } }
		local pickD = dirs[math.random(1, #dirs)]
		setGust("warn", pickD[1] :: Vector3, now + gu.Warn)
		local lines = Config.Announcer.Gust
		announceRemote:FireAllClients(string.format(lines[math.random(1, #lines)], pickD[2] :: string), "warn")
		tileEvent:FireAllClients("gustwarn", {}, pickD[1])
	elseif gustPhase == "warn" and now >= gustChangeAt then
		setGust("blow", gustDir, now + gu.Duration)
	elseif gustPhase == "blow" and (now >= gustChangeAt or not active) then
		setGust("", Vector3.zero, 0)
		nextGustAt = now + gu.Every / hazardScale
	end
end

-- v0.8.3b a live lava pool: raised black crust rim, glowing surface swirl, bubbles, heat haze and
-- an orange light, so it can never be mistaken for a hole in the floor.
function makeMagmaFx(center: Vector3, i: number): Model
	local m = Instance.new("Model")
	m.Name = "MagmaFx"
	local top = center + Vector3.new(0, 0.05, 0)
	local w = TS - A.Grout
	local CR = Color3.fromRGB(38, 28, 26)
	for k = 0, 3 do
		local horizontal = k < 2
		local sgn = (k % 2 == 0) and -1 or 1
		local off = horizontal and Vector3.new(0, 0.3, sgn * (w / 2 - 0.45)) or Vector3.new(sgn * (w / 2 - 0.45), 0.3, 0)
		local size = horizontal and Vector3.new(w, 0.6, 0.9) or Vector3.new(0.9, 0.6, w)
		Art.Static(m, { Name = "Crust", Size = size, CFrame = CFrame.new(top + off), Color = CR, Material = Enum.Material.Basalt })
	end
	for q = 1, 3 do -- crust lumps floating on the surface
		local a = Art.Hash(i, q, 61) * math.pi * 2
		local r = 1.2 + Art.Hash(i, q, 62) * 1.6
		Art.Static(m, { Name = "CrustLump", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 1 + Art.Hash(i, q, 63), 1 + Art.Hash(i, q, 63)), CFrame = CFrame.new(top + Vector3.new(math.cos(a) * r, 0.1, math.sin(a) * r)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 34, 24), Material = Enum.Material.Basalt })
	end
	local core = Art.Static(m, { Name = "HotCore", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, w * 0.55, w * 0.55), CFrame = CFrame.new(top + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 230, 120), Material = Enum.Material.Neon })
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 130, 30)
	l.Range = 16
	l.Brightness = 2.5
	l.Parent = core
	emitter(core, {
		Rate = 10, Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(1, 3), EmissionDirection = Enum.NormalId.Right,
		SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(0, -4, 0), LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(255, 110, 20)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.7, 1.3), NumberSequenceKeypoint.new(1, 0) }),
	})
	emitter(core, {
		Rate = 6, Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(2, 4), EmissionDirection = Enum.NormalId.Right,
		SpreadAngle = Vector2.new(15, 15), Color = ColorSequence.new(Color3.fromRGB(255, 200, 150)),
		Transparency = NumberSequence.new(0.75, 1), Size = NumberSequence.new(2, 4),
	})
	m.Parent = folder
	return m
end

local function stepHazards(dt: number, now: number)
	local map = mapDef()
	local occ = occupancyProvider and occupancyProvider() or {}
	local elapsed = now - roundStart
	stepDrops(dt, now, occ)
	stepGusts(now)
	local spreads: { number } = {}

	-- MAGMA: spawn
	local mg = map.Magma
	if active and mg and now >= nextMagmaAt then
		nextMagmaAt = now + mg.Every / hazardScale
		local picked: { number } = {}
		for _ = 1, (elapsed >= mg.MoreAfter and mg.CountLate or mg.Count) do
			local i = pickHazardTile(mg.NearPlayers, Config.Shrink.CoreRings, occ)
			if i then
				magma[i] = { Phase = "warn", LiveAt = now + mg.Warn, EndAt = now + mg.Warn + mg.Life, Depth = 0, Floor = nil }
				local part = tiles[i].Part
				part.Color = mg.Crust
				part.Material = Enum.Material.CrackedLava
				part.Reflectance = 0
				table.insert(picked, i)
			end
		end
		if #picked > 0 then
			tileEvent:FireAllClients("magma", picked, mg.Warn)
			if not magmaAnnounced then
				magmaAnnounced = true
				local lines = Config.Announcer.Magma
				announceRemote:FireAllClients(lines[math.random(1, #lines)], "phase")
			end
		end
	end
	-- MAGMA: warn → live → sink / swallow / cool
	for i, pool in magma do
		local t = tiles[i]
		local c = ArenaService.TileCenter(i)
		if pool.Phase == "warn" then
			if now >= pool.LiveAt and t.State == 0 then
				pool.Phase = "live"
				t.Part.CanCollide = false
				t.Part.Material = Enum.Material.Neon
				t.Part.Color = Color3.fromRGB(255, 150, 30) -- bright molten yellow-orange (holes are dark)
				t.Part.Transparency = 0
				t.Part:SetAttribute("Magma", true)
				pool.Fx = makeMagmaFx(c, i)
				local f = Instance.new("Part")
				f.Name = "MagmaFloor"
				f.Anchored = true
				f.Transparency = 1
				f.CanQuery = false
				f.CanTouch = false
				f.Size = Vector3.new(TS - A.Grout, 1, TS - A.Grout)
				f.CFrame = CFrame.new(c - Vector3.new(0, 0.5, 0))
				f.Parent = folder
				pool.Floor = f
				tileEvent:FireAllClients("magmalive", { i })
			end
		elseif mg then
			-- v0.8.2: each pool creeps once into a neighbouring tile
			if active and not (pool :: any).Spread and now >= pool.LiveAt + (mg.SpreadAfter or 999) then
				(pool :: any).Spread = true
				local opts = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
				for _ = 1, 4 do
					local o = opts[math.random(1, #opts)]
					local ix, iz = t.IX + o[1], t.IZ + o[2]
					if ix >= 0 and iz >= 0 and ix < N and iz < N then
						local j = index(ix, iz)
						local tj = tiles[j]
						if tj.State == 0 and not magma[j] and not geysers[j] and tj.Ring >= Config.Shrink.CoreRings and tj.Ring < shrinkRing then
							table.insert(spreads, j)
							break
						end
					end
				end
			end
			local occupied = false
			for _, p in occ do
				if onTile(p, c, mg.MaxDepth + 4, 5) then
					occupied = true
					break
				end
			end
			if occupied then
				pool.Depth += mg.SinkRate * dt
			else
				pool.Depth = math.max(0, pool.Depth - mg.RiseRate * dt)
			end
			if pool.Depth >= mg.MaxDepth then
				tileEvent:FireAllClients("swallow", { i })
				fallTile(i) -- the pool swallows the tile (and whoever is still in it)
			else
				if pool.Floor then
					(pool.Floor :: Part).CFrame = CFrame.new(c - Vector3.new(0, 0.5 + pool.Depth, 0))
				end
				if (now >= pool.EndAt or not active) and pool.Depth < 0.3 and not occupied then
					clearMagma(i, true) -- cooled back into solid rock
					tileEvent:FireAllClients("magmacool", { i })
				end
			end
		end
	end

	if mg and #spreads > 0 then
		local count = 0
		for _ in magma do
			count += 1
		end
		local added: { number } = {}
		for _, j in spreads do
			if count < (mg.MaxPools or 14) and not magma[j] then
				magma[j] = { Phase = "warn", LiveAt = now + mg.Warn, EndAt = now + mg.Warn + mg.Life, Depth = 0, Floor = nil }
				local part = tiles[j].Part
				part.Color = mg.Crust
				part.Material = Enum.Material.CrackedLava
				part.Reflectance = 0
				count += 1
				table.insert(added, j)
			end
		end
		if #added > 0 then
			tileEvent:FireAllClients("magma", added, mg.Warn)
		end
	end

	-- FROST TRAPS: spawn
	local tp = map.Traps
	if active and tp and now >= nextTrapAt then
		nextTrapAt = now + tp.Every / hazardScale
		local count = 0
		for _ in traps do
			count += 1
		end
		local picked: { number } = {}
		for _ = 1, (elapsed >= tp.MoreAfter and tp.CountLate or tp.Count) do
			if count >= tp.MaxActive then
				break
			end
			local i = pickHazardTile(tp.NearPlayers, 0, occ)
			if i then
				traps[i] = now + tp.Life
				local t = tiles[i]
				t.Part.Color = t.BaseColor:Lerp(Config.Maps.Ice.Crystal, tp.Tint)
				t.Part.Material = Enum.Material.Glacier
				t.Part.Reflectance = 0.3
				trapMarks[i] = makeTrapMark(i)
				count += 1
				table.insert(picked, i)
			end
		end
		if #picked > 0 and not trapsAnnounced then
			trapsAnnounced = true
			local lines = Config.Announcer.Traps
			announceRemote:FireAllClients(lines[math.random(1, #lines)], "phase")
		end
	end
	-- FROST TRAPS: expire / trigger
	for i, expiry in traps do
		local t = tiles[i]
		if t.State ~= 0 then
			clearTrap(i, false)
		elseif now >= expiry or not active then
			clearTrap(i, true)
		else
			local c = ArenaService.TileCenter(i)
			for _, p in occ do
				if onTile(p, c, 1, 6) then
					clearTrap(i, true)
					tileEvent:FireAllClients("trapsnap", { i })
					if trapHandler then
						task.spawn(trapHandler :: (number, Vector3) -> (), i, c)
					end
					break
				end
			end
		end
	end
end

function ArenaService.Step(dt: number, now: number)
	if active then
		local occupied = occupiedSet()
		local phase = ArenaService.CurrentPhase(now)
		accum += phase.Rate * collapseScale * dt
		while accum >= 1 do
			accum -= 1
			pickAndWarn(now, occupied)
		end

		-- SHRINK: whole outer ring flashes, then drops together
		local SH = Config.Shrink
		if shrinkRing >= SH.CoreRings and now >= nextShrinkAt then
			local ringList: { number } = ringTiles[shrinkRing] or {}
			for _, i in ringList do
				if tiles[i].State == 0 then
					warnTile(i, now, occupied, SH.WarnTime)
				end
			end
			if shrinkRing == N / 2 - 1 then
				announceRemote:FireAllClients(Config.Announcer.Shrink, "warn")
			end
			shrinkRing -= 1
			if shrinkRing >= SH.CoreRings then
				nextShrinkAt = now + (SH.Interval[phase.Name] or 10) / collapseScale
			else
				nextShrinkAt = math.huge
			end
			ReplicatedStorage:SetAttribute("ShrinkAt", nextShrinkAt < math.huge and nextShrinkAt or 0)
		end
		if shrinkRing >= SH.CoreRings and now >= nextShrinkAt - SH.BotAvoidLead then
			dangerRing = shrinkRing
		else
			dangerRing = shrinkRing + 1
		end
	end

	clockNow = now
	-- v0.8 Ice Rink frost: reveal hidden warnings once their frost melts
	for i, untilT in frostUntil do
		if now >= untilT then
			frostUntil[i] = nil
			local tile = tiles[i]
			if tile.State == 1 then
				tile.Part.Color = A.WarnColor
				tile.Part.Material = Enum.Material.SmoothPlastic
				tile.Part.Reflectance = 0
				table.insert(pendingWarn, i)
			end
		end
	end
	-- v0.8 Molten Core geysers
	local gz = (Config.Maps[currentMap] or Config.Maps.Grid).Geysers
	local function addGeysers(count: number)
		local picked: { number } = {}
		local occ = occupancyProvider and occupancyProvider() or {}
		for _ = 1, count do
			local choice: number? = nil
			for _ = 1, 12 do
				local i: number?
				if #occ > 0 and math.random() < gz.NearPlayers then
					local p = occ[math.random(1, #occ)]
					i = ArenaService.TileAt(p + Vector3.new(math.random(-2, 2) * TS, 0, math.random(-2, 2) * TS))
				else
					local list = #innerList > 0 and innerList or outerList
					i = #list > 0 and list[math.random(1, #list)] or nil
				end
				if i and tiles[i].State == 0 and not geysers[i] and not magma[i] and tiles[i].Ring < shrinkRing then
					choice = i
					break
				end
			end
			if choice then
				geysers[choice] = now + gz.Warn
				table.insert(picked, choice)
			end
		end
		if #picked > 0 then
			tileEvent:FireAllClients("geyser", picked, gz.Warn)
		end
	end
	if active and gz and now >= nextGeyserAt then
		local elapsed = now - roundStart
		nextGeyserAt = now + gz.Every / hazardScale
		addGeysers(elapsed >= gz.MoreAfter and gz.CountLate or gz.Count)
	end
	-- v0.8.2 ERUPTION: once per Molten match, geysers all over the floor at the same moment
	local er = (Config.Maps[currentMap] or Config.Maps.Grid).Eruption
	if active and gz and er and not eruptionDone and now - roundStart >= er.At then
		eruptionDone = true
		local lines = Config.Announcer.Eruption
		announceRemote:FireAllClients(lines[math.random(1, #lines)], "warn")
		tileEvent:FireAllClients("eruption", {})
		addGeysers(er.Geysers)
	end
	for i, at in geysers do
		if now >= at then
			geysers[i] = nil
			if tiles[i].State ~= 2 and gz then
				local pos = ArenaService.TileCenter(i)
				tileEvent:FireAllClients("erupt", { i })
				if geyserHandler then
					task.spawn(geyserHandler :: (Vector3, number) -> (), pos, gz.Radius)
				end
			end
		end
	end

	stepHazards(dt, now)

	-- Warned tiles progress even after the round ends (so nothing freezes mid-crack)
	for i in warned do
		local tile = tiles[i]
		if not tile.Red and now >= tile.RedAt then
			tile.Red = true
			tile.Part.Color = A.DangerColor
			tile.Part.Material = Enum.Material.Neon
		end
		-- v0.7 crack stage 3: the tile visibly breaks up just before it drops
		if tile.Red and not tile.Cracked and now >= tile.CrackAt then
			tile.Cracked = true
			tile.Part.Material = Enum.Material.CrackedLava
		end
		if now >= tile.FallAt then
			fallTile(i)
		end
	end

	if #pendingWarn > 0 then
		tileEvent:FireAllClients("warn", pendingWarn)
		pendingWarn = {}
	end
	if #pendingFall > 0 then
		tileEvent:FireAllClients("fall", pendingFall)
		pendingFall = {}
	end
end

------------------------------------------------------------------------
-- v0.8 maps
------------------------------------------------------------------------
function ArenaService.SetGeyserHandler(fn: (Vector3, number) -> ())
	geyserHandler = fn
end

-- v0.8.1: called when someone steps on a frost trap (tile index, tile centre)
function ArenaService.SetTrapHandler(fn: (number, Vector3) -> ())
	trapHandler = fn
end

-- Is this position standing (or sinking) in a live magma pool?
function ArenaService.InMagma(pos: Vector3): boolean
	local i = ArenaService.TileAt(pos)
	local pool = i and magma[i]
	return pool ~= nil and pool.Phase == "live" and pos.Y < A.Center.Y + 3.4 and pos.Y > A.Center.Y - 9
end

function ArenaService.CurrentMap(): string
	return currentMap
end

-- v0.8.5: the cozy stadium + the Yard's green tree islands only belong to the default look and
-- The Grid. On Molten / Ice they're parked so the player only ever sees that map's world.
local parkedScenery: Instance? = nil
local function setShared(show: boolean)
	local decor = folder and folder:FindFirstChild("Decor")
	if stadium then
		(stadium :: Folder).Parent = show and decor or ServerStorage
	end
	local lobby = workspace:FindFirstChild("Lobby")
	if show then
		if parkedScenery and lobby then
			(parkedScenery :: Instance).Parent = lobby
			parkedScenery = nil
		end
	else
		local sc = lobby and lobby:FindFirstChild("Scenery")
		if sc then
			sc.Parent = ServerStorage
			parkedScenery = sc
		end
	end
end

-- v0.8.3b: back to the normal cozy sky stadium between matches (call before Reset).
function ArenaService.SetDefault()
	currentMap = "Default"
	for _, t in tiles do
		t.BaseColor = t.OrigColor
		t.BaseMaterial = t.OrigMaterial
	end
	for part, o in rimOrig do
		part.Color = o.Color
		part.Material = o.Material
	end
	if rimRocks then
		for _, d in (rimRocks :: Folder):GetDescendants() do
			local base = d:GetAttribute("BaseColor")
			if d:IsA("BasePart") and typeof(base) == "Color3" then
				d.Color = base
			end
		end
	end
	for _, d in tintParts do
		local base = d:GetAttribute("BaseColor")
		if typeof(base) == "Color3" then
			d.Color = base
		end
	end
	if cloudSea and seaOrig then
		(cloudSea :: Part).Color = (seaOrig :: any).Color
		;(cloudSea :: Part).Material = (seaOrig :: any).Material
	end
	for _, f in themeFolders do
		f.Parent = ServerStorage
	end
	if gridSet then
		(gridSet :: Folder).Parent = folder
	end
	setShared(true)
	ReplicatedStorage:SetAttribute("Map", "Default")
end

-- Re-skin the pooled grid + swap themed decor. Call between rounds (before Reset).
function ArenaService.SetMap(id: string)
	local map = Config.Maps[id]
	if not map then
		id, map = "Grid", Config.Maps.Grid
	end
	-- v0.9.5 CLASSIC: the plain original arena: default look, no themed props, no hazards
	if map.Classic then
		ArenaService.SetDefault()
		currentMap = id
		ReplicatedStorage:SetAttribute("Map", id)
		ReplicatedStorage:SetAttribute("MapName", map.Name)
		return
	end
	currentMap = id
	for _, t in tiles do
		local checker = (t.IX + t.IZ) % 2 == 0
		local shade = 0.93 + Art.Hash(t.IX, t.IZ) * 0.1
		if t.Ring < Config.Shrink.CoreRings then
			t.BaseColor = Art.Shade(map.Core, shade)
			t.BaseMaterial = map.CoreMaterial or Enum.Material.SmoothPlastic
		else
			t.BaseColor = Art.Shade(checker and map.ColorA or map.ColorB, shade)
			t.BaseMaterial = map.TileMaterial or Enum.Material.SmoothPlastic
		end
	end
	-- v0.8.2: rim + hanging rocks match the map
	for _, r in rimParts do
		local col = (r.Kind == "Rim" and map.Rim) or (r.Kind == "RimBand" and map.RimBand) or map.RimGlow
		if col then
			r.Part.Color = col
		end
		if r.Kind ~= "RimGlow" then
			r.Part.Material = map.RimMaterial or Enum.Material.SmoothPlastic
		end
	end
	if rimRocks then
		local ref = ROCK
		local refL = (ref.R + ref.G + ref.B) / 3
		for _, d in (rimRocks :: Folder):GetDescendants() do
			if d:IsA("BasePart") then
				local base = d:GetAttribute("BaseColor")
				if typeof(base) == "Color3" then
					if map.RockTint then
						local l = (base.R + base.G + base.B) / 3
						d.Color = Art.Shade(map.RockTint, l / refL)
					else
						d.Color = base
					end
				end
			end
		end
	end
	-- v0.8.3: the shared stadium (stands' grass + rock, scoreboard island, pines) follows the map
	for _, d in tintParts do
		local base = d:GetAttribute("BaseColor")
		if typeof(base) == "Color3" then
			local kind = d:GetAttribute("TintKind")
			local tint = (kind == "Grass" and map.DecorGrass) or (kind == "Rock" and map.RockTint) or nil
			if tint then
				local l = (base.R + base.G + base.B) / 3
				local refL = kind == "Grass" and ((GRASS.R + GRASS.G + GRASS.B) / 3) or ((ROCK.R + ROCK.G + ROCK.B) / 3)
				d.Color = Art.Shade(tint, math.clamp(l / refL, 0.6, 1.3))
			else
				d.Color = base
			end
		end
	end
	if cloudSea then
		(cloudSea :: Part).Color = map.Sea
		;(cloudSea :: Part).Material = map.SeaGlow and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
	for name, f in themeFolders do
		f.Parent = (name == id) and folder or ServerStorage
	end
	if gridSet then
		(gridSet :: Folder).Parent = (id == "Grid") and folder or ServerStorage
	end
	local themed = (id == "Molten" or id == "Ice")
	setShared(not themed)
	ReplicatedStorage:SetAttribute("Map", id)
	ReplicatedStorage:SetAttribute("MapName", map.Name)
end

------------------------------------------------------------------------
-- Bot helpers
------------------------------------------------------------------------
local function areaHealthy(ix: number, iz: number, margin: number): boolean
	for dz = -margin, margin do
		for dx = -margin, margin do
			local x, z = ix + dx, iz + dz
			if x < 0 or z < 0 or x >= N or z >= N then
				return false
			end
			local ti = index(x, z)
			local t = tiles[ti]
			if seenState(ti) ~= 0 or t.Ring >= dangerRing then
				return false
			end
		end
	end
	return true
end

-- Returns a random safe tile centre inside a patch around `around`. `margin` = how many
-- healthy tiles must surround it (bot lookahead − 1).
function ArenaService.RandomSafeNear(around: Vector3, patch: number, tries: number, margin: number): Vector3?
	local ci = ArenaService.TileAt(around)
	local cx, cz
	if ci then
		cx, cz = tiles[ci].IX, tiles[ci].IZ
	else
		cx, cz = N / 2, N / 2
	end
	local h = math.floor(patch / 2)
	for _ = 1, tries do
		local x = math.clamp(cx + math.random(-h, h), 0, N - 1)
		local z = math.clamp(cz + math.random(-h, h), 0, N - 1)
		if areaHealthy(x, z, margin) then
			return ArenaService.TileCenter(index(x, z))
		end
	end
	-- fall back: any healthy tile inside the safe rings, preferring the inner list
	local list = #innerList > 0 and innerList or outerList
	for _ = 1, 20 do
		if #list == 0 then
			break
		end
		local i = list[math.random(1, #list)]
		if tiles[i].Ring < dangerRing then
			return ArenaService.TileCenter(i)
		end
	end
	if #list > 0 then
		return ArenaService.TileCenter(list[math.random(1, #list)])
	end
	return nil
end

-- Is the straight walk from a to b over healthy tiles only?
function ArenaService.PathSafe(a: Vector3, b: Vector3): boolean
	local d = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local dist = d.Magnitude
	if dist < 0.1 then
		return ArenaService.TileState(ArenaService.TileAt(b)) == 0
	end
	local steps = math.ceil(dist / 2)
	for s = 1, steps do
		local p = a + d * (s / steps)
		-- walkable = tile still standing (crossing the soon-to-shrink ring on the way OUT is fine)
		if ArenaService.TileState(ArenaService.TileAt(p)) ~= 0 then
			return false
		end
	end
	return true
end

-- Any non-healthy tile within `margin` tiles of pos?
function ArenaService.DangerNear(pos: Vector3, margin: number): boolean
	local i = ArenaService.TileAt(pos)
	if not i then
		return true
	end
	return not areaHealthy(tiles[i].IX, tiles[i].IZ, margin)
end

function ArenaService.Center(): Vector3
	return A.Center
end

function ArenaService.SpawnPoints(count: number): { CFrame }
	local pts = {}
	for k = 1, count do
		local ang = (k - 1) / count * math.pi * 2
		local pos = A.Center + Vector3.new(math.cos(ang) * A.SpawnRadius, 3.5, math.sin(ang) * A.SpawnRadius)
		table.insert(pts, CFrame.lookAt(pos, Vector3.new(A.Center.X, pos.Y, A.Center.Z)))
	end
	return pts
end

return ArenaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — BotService ("League Drones")
	Fills empty seats up to 12. Bots can use ANY launch weapon (pool depends on difficulty),
	are matched to the lobby's weapon level, and always wear a [BOT] nameplate.

	Think loop: every ~0.35 s →  safety (lookahead) → target (anti-swarm) → weapon-specific
	attack decision → movement over safe tiles only. Blocking/parrying reacts to swings.

	ART PIPELINE: put a custom R15 character in ReplicatedStorage/BotModels named after the
	bot (e.g. "BLITZ") and it will be used instead of the default rig.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local BotStyles = require(script.Parent.BotStyles)
local WeaponVisuals = require(Shared.WeaponVisuals)

local ArenaService = require(script.Parent.ArenaService)
local RumbleBoxService = require(script.Parent.RumbleBoxService)
local CombatService = require(script.Parent.CombatService)

local B = Config.Bots
local CC = Config.Combat

type Brain = {
	Combatant: CombatService.Combatant,
	DiffName: string,
	Diff: any,
	NextThink: number,
	Goal: Vector3?,
	Target: CombatService.Combatant?,
	TargetSince: number,
	Tracks: { [string]: AnimationTrack },
	Playing: string,
	-- v0.8.3 anti-idle
	GoalAt: number, -- when the current goal was set
	LastPos: Vector3,
	StillFor: number, -- seconds without real movement while not stunned/frozen
	StrafeSign: number,
	StrafeFlip: number,
	Moved: boolean, -- v0.8.3b did this think issue a walk order?
	Prey: CombatService.Combatant?, -- v1.0.1 the real player this bot was matched to (hunts them first)
}

-- v0.8 spawn options (Rumble weapons, adaptive difficulty)
-- v1.0.1 Prey = one entry per real player: their combatant, their skill tier and weapon level.
-- Bots are dealt out round-robin, each one matched to one player's skill.
export type Prey = { C: CombatService.Combatant, Tier: string, WeaponLevel: number }
export type SpawnOpts = { TierShift: number?, RandomWeapon: boolean?, Level: number?, Humans: number?, Prey: { Prey }? }
local humanTier: { [CombatService.Combatant]: number } = {} -- each real player's skill tier (index) this match
local soloLobby = false

local BotService = {}

local brains: { Brain } = {}
local template: Model? = nil
local botFolder: Folder

local ANIMS = {
	Idle = "rbxassetid://507766666",
	Run = "rbxassetid://507767714",
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

------------------------------------------------------------------------
-- Model creation
------------------------------------------------------------------------
local function ensureTemplate(): Model?
	if template then
		return template
	end
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		template = result
		return template
	end
	warn("[CRUMBLE] Could not create bot rig:", result)
	return nil
end

local function makeNameplate(model: Model, name: string, color: Color3, weaponId: string, level: number, diffName: string)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local def = Weapons.Get(weaponId)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate"
	gui.Size = UDim2.fromOffset(200, 46)
	gui.StudsOffset = Vector3.new(0, 3.2, 0) -- v0.7.3: clears the big toy helmets
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.Adornee = head
	local top = Instance.new("TextLabel")
	top.BackgroundTransparency = 1
	top.Size = UDim2.new(1, 0, 0.58, 0)
	top.Font = Enum.Font.FredokaOne
	top.TextScaled = true
	top.TextColor3 = color
	top.TextStrokeTransparency = 0.3
	top.Text = "[BOT] " .. name
	top.Parent = gui
	local bottom = Instance.new("TextLabel")
	bottom.BackgroundTransparency = 1
	bottom.Position = UDim2.new(0, 0, 0.58, 0)
	bottom.Size = UDim2.new(1, 0, 0.42, 0)
	bottom.Font = Enum.Font.FredokaOne
	bottom.TextScaled = true
	bottom.TextColor3 = Rarity.Colors[def.Rarity]
	bottom.TextStrokeTransparency = 0.4
	bottom.Text = ("%s L%d · PWR %d · %s"):format(def.Name, level, Rarity.PWR(def.Rarity, level), diffName)
	bottom.Parent = gui
	gui.Parent = head
end

local styledCache: { [string]: Model } = {}
local styleColor: { [string]: Color3 } = {}

-- v0.9.3 THE DUMMY-HEAP FIX. Rigs built from a HumanoidDescription can come with Avatar Joint
-- Upgrade joints (AnimationConstraint) that are FORCE-LIMITED (IsKinematic = false): nothing holds
-- the limbs up unless a live Humanoid balances them, so an anchored-root dummy sags into a pile on
-- the floor. Kinematic joints behave exactly like Motor6Ds (rigid + animatable), like players' ones.
function BotService.Rigidify(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("AnimationConstraint") then
			pcall(function()
				(d :: any).IsKinematic = true
			end)
		elseif d:IsA("Motor6D") then
			d.Enabled = true
		end
	end
end

local function buildBot(name: string, color: Color3): Model?
	local custom = ReplicatedStorage:FindFirstChild("BotModels")
	local src = custom and custom:FindFirstChild(name)
	local model: Model
	if src and src:IsA("Model") and src:FindFirstChildOfClass("Humanoid") then
		model = src:Clone()
	else
		local cached = styledCache[name]
		if not cached then
			local t = ensureTemplate()
			if not t then
				return nil
			end
			local styled = t:Clone()
			styleColor[name] = BotStyles.Apply(styled, name, color)
			styledCache[name] = styled
			cached = styled
		end
		model = (cached :: Model):Clone()
	end
	model.Name = name
	BotService.Rigidify(model)
	model:AddTag("CrumbleRig") -- client AnimationController animates tagged rigs
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.WalkSpeed = Config.Movement.WalkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = Config.Movement.JumpPower
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false) -- tile edges are never ladders
	return model
end

-- Training Range dummies reuse the bot rig (or your custom BotModels/<name>).
function BotService.MakeDummy(name: string, color: Color3): Model?
	return buildBot(name, color)
end

local function loadAnims(model: Model): { [string]: AnimationTrack }
	local tracks = {}
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return tracks
	end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = hum
	for key, id in ANIMS do
		local a = Instance.new("Animation")
		a.AnimationId = id
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(a)
		end)
		if ok and track then
			track.Looped = true
			tracks[key] = track
		end
	end
	return tracks
end

------------------------------------------------------------------------
-- Spawning
------------------------------------------------------------------------
local TIERS = { "Easy", "Medium", "Hard", "Pro" } -- v1.0.1: + Pro

local function tierIndex(name: string): number
	for i, n in TIERS do
		if n == name then
			return i
		end
	end
	return 1
end

function BotService.TierFromLevel(avgLevel: number): string
	if avgLevel >= B.HardFromLevel then
		return "Hard"
	elseif avgLevel >= B.MediumFromLevel then
		return "Medium"
	end
	return "Easy"
end

local function rollTier(base: string): string
	local i = tierIndex(base)
	local r = math.random()
	if r < 0.25 then
		i -= 1
	elseif r < 0.5 then
		i += 1
	end
	return TIERS[math.clamp(i, 1, #TIERS)]
end

local function rollWeapon(pool: { string }, counts: { high: number, epic: number }, highLimit: number?): string
	if math.random() < B.BootWeight then
		return "Boot"
	end
	local options = {}
	for _, id in pool do
		local r = Weapons.Get(id).Rarity
		local ok = id ~= "Boot"
		if r == "Legendary" or r == "Mythic" then
			ok = ok and counts.high < (highLimit or B.MaxHighRarityBots)
		elseif r == "Epic" then
			ok = ok and counts.epic < B.MaxEpicBots
		end
		if ok then
			table.insert(options, id)
		end
	end
	if #options == 0 then
		return "Boot"
	end
	local id = options[math.random(1, #options)]
	local r = Weapons.Get(id).Rarity
	if r == "Legendary" or r == "Mythic" then
		counts.high += 1
	elseif r == "Epic" then
		counts.epic += 1
	end
	return id
end

-- spawns: list of CFrames; avgAccountLevel: lobby avg; avgWeaponLevel/maxWeaponLevel from humans
function BotService.Spawn(spawns: { CFrame }, avgAccountLevel: number, avgWeaponLevel: number, maxWeaponLevel: number, opts: SpawnOpts?): { CombatService.Combatant }
	local o: SpawnOpts = opts or {}
	local result = {}
	if #spawns == 0 then
		return result
	end
	soloLobby = (o.Humans or 0) > 0 and (o.Humans or 0) <= B.SoloHumans
	local baseTier = TIERS[math.clamp(tierIndex(BotService.TierFromLevel(avgAccountLevel)) + (o.TierShift or 0), 1, #TIERS)]
	local names = table.clone(B.Names)
	for k = #names, 2, -1 do
		local j = math.random(1, k)
		names[k], names[j] = names[j], names[k]
	end
	local counts = { high = 0, epic = 0 }
	local prey = o.Prey or {}
	table.clear(humanTier)
	for _, pr in prey do
		humanTier[pr.C] = tierIndex(pr.Tier)
	end

	for k, cf in spawns do
		local nameIndex = ((k - 1) % #names) + 1
		local name = names[nameIndex]
		local colorIndex = table.find(B.Names, name) or k
		local color = B.Colors[((colorIndex - 1) % #B.Colors) + 1]
		local model = buildBot(name, color)
		if not model then
			break
		end
		local tier = rollTier(baseTier)
		local myPrey: Prey? = if #prey > 0 then prey[((k - 1) % #prey) + 1] else nil
		if myPrey then
			-- v1.0.1: matched to one player = that player's tier (sometimes one easier, rarely harder)
			local i = tierIndex(myPrey.Tier)
			local r = math.random()
			if r < 0.2 then
				i -= 1
			elseif r < 0.32 then
				i += 1
			end
			tier = TIERS[math.clamp(i, 1, #TIERS)]
		end
		local diff = B.Difficulty[tier]
		local weaponId = rollWeapon(diff.Pool, counts, if tier == "Pro" then B.MaxHighRarityPro else nil)
		local bonus = diff.LevelBonus or 0
		local baseLevel = if myPrey then myPrey.WeaponLevel else avgWeaponLevel
		local level = math.clamp(math.floor(baseLevel + math.random(-1, 1) + bonus + 0.5), 1, math.min(10, math.max(1, maxWeaponLevel + bonus)))
		if o.RandomWeapon then
			-- Rumble: everyone gets a random weapon at a fixed level
			weaponId = Weapons.List[math.random(1, #Weapons.List)].Id
			level = o.Level or 5
		end

		model:PivotTo(cf)
		model.Parent = botFolder
		local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
		end
		WeaponVisuals.Attach(model, weaponId, level)
		makeNameplate(model, name, styleColor[name] or color, weaponId, level, tier)

		local c = CombatService.Register(model, {
			Player = nil,
			IsBot = true,
			Name = name,
			WeaponId = weaponId,
			Level = level,
		})
		if c then
			local brain: Brain = {
				Combatant = c,
				DiffName = tier,
				Diff = diff,
				NextThink = now() + math.random() * 0.6, -- staggered first think
				Goal = nil,
				Target = nil,
				TargetSince = 0,
				Tracks = loadAnims(model),
				Playing = "",
				GoalAt = 0,
				LastPos = c.Root.Position,
				StillFor = 0,
				StrafeSign = math.random() < 0.5 and -1 or 1,
				StrafeFlip = 0,
				Moved = false,
				Prey = myPrey and myPrey.C or nil,
			}
			c.BotBrain = brain
			table.insert(brains, brain)
			table.insert(result, c)
		end
	end
	return result
end

function BotService.Clear()
	for _, b in brains do
		CombatService.Unregister(b.Combatant.Model)
		b.Combatant.Model:Destroy()
	end
	table.clear(brains)
	table.clear(humanTier)
end

function BotService.Remove(model: Model)
	for k, b in brains do
		if b.Combatant.Model == model then
			table.remove(brains, k)
			break
		end
	end
	task.delay(3, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

------------------------------------------------------------------------
-- Brain
------------------------------------------------------------------------
-- v0.9.12: only counts hunters that are CLOSER to the target than `myDist`, so the anti-dogpile
-- slots always go to the nearest bots (a far bot that grabbed a slot first can no longer block a
-- bot standing right next to the target; it re-picks on its next think)
local function countTargeting(target: CombatService.Combatant, except: Brain, myDist: number): number
	local n = 0
	local tp = target.Root.Position
	for _, b in brains do
		if b ~= except and b.Target == target and b.Combatant.Alive then
			if flat(b.Combatant.Root.Position - tp).Magnitude < myDist then
				n += 1
			end
		end
	end
	return n
end

local function chooseTarget(brain: Brain): CombatService.Combatant?
	local me = brain.Combatant
	local pos = me.Root.Position
	local best, bestDist = nil, B.TargetRange
	local t = now()
	for _, c in CombatService.All() do
		if c ~= me and c.Alive then
			-- v0.9.12 HUMAN FOCUS: real players count as closer than they are, so bots go for
			-- them more often than for other bots (anti-dogpile caps + breathing room still apply)
			local real = flat(c.Root.Position - pos).Magnitude
			local d = real * (c.IsBot and 1 or (B.HumanFocus or 1))
			if not c.IsBot then
				if c == brain.Prey then
					d *= B.PreyFocus or 1 -- v1.0.1: my own player first
				elseif humanTier[c] and tierIndex(brain.DiffName) - humanTier[c] >= 2 then
					d *= B.MismatchAvoid or 1 -- v1.0.1: tough bots leave beginners alone
				end
			end
			if d < bestDist and math.abs(c.Root.Position.Y - pos.Y) < 8 then
				local cap = brain.Diff.MaxPerTarget
				if soloLobby and not c.IsBot then
					cap = math.min(cap, B.SoloMaxPerHuman) -- v0.8: small lobbies never get dog-piled
				end
				local swarmed = countTargeting(c, brain, real) >= cap
				-- breathing room: give a human 0.5 s after they were just hit
				local justHit = (not c.IsBot) and #c.Hits > 0 and (t - c.Hits[#c.Hits].Time) < (brain.Diff.Breather or B.HumanBreather or 0.5)
				if not swarmed and not justHit then
					best, bestDist = c, d
				end
			end
		end
	end
	return best
end

-- v0.8.3: ALWAYS re-issue MoveTo. Roblox cancels a Humanoid:MoveTo after 8 s (and after
-- ragdoll/launch), which left wandering bots frozen in place until something forced a new goal.
local function moveTo(brain: Brain, goal: Vector3)
	local old = brain.Goal
	if old == nil or flat(goal - old).Magnitude > 2 then
		brain.GoalAt = now()
	end
	brain.Goal = goal
	brain.Moved = true
	brain.Combatant.Humanoid:MoveTo(goal)
end

local function safeGoalNear(brain: Brain, around: Vector3): Vector3?
	local margin = math.max(0, brain.Diff.Lookahead - 1)
	return ArenaService.RandomSafeNear(around, B.PatchSize, B.SearchTries, margin)
end

local function wander(brain: Brain)
	local me = brain.Combatant
	local pos = me.Root.Position
	local center = ArenaService.Center()
	local goal = brain.Goal
	if goal == nil or flat(goal - pos).Magnitude < 3 or now() - brain.GoalAt > 3 or not ArenaService.IsSafeAt(goal) or not ArenaService.PathSafe(pos, goal) then
		local g = safeGoalNear(brain, pos:Lerp(center, 0.45))
		if g then
			moveTo(brain, g)
		else
			moveTo(brain, center) -- nothing found: head for the core, never stand still
		end
	else
		moveTo(brain, goal :: Vector3)
	end
end

local function approach(brain: Brain, point: Vector3)
	local me = brain.Combatant
	local pos = me.Root.Position
	if ArenaService.IsSafeAt(point) and ArenaService.PathSafe(pos, point) then
		moveTo(brain, point)
	else
		local g = safeGoalNear(brain, point)
		if g then
			moveTo(brain, g)
		end
	end
end

-- v0.8.3: circle the target while the weapon is on cooldown (like a player would)
-- instead of standing still in front of them.
local function strafe(brain: Brain, tpos: Vector3, dir: Vector3, radius: number)
	local t = now()
	if t >= brain.StrafeFlip then
		if math.random() < 0.6 then
			brain.StrafeSign = -brain.StrafeSign
		end
		brain.StrafeFlip = t + 0.7 + math.random() * 1.1
	end
	local side = Vector3.new(-dir.Z, 0, dir.X) * brain.StrafeSign
	local wobble = (math.random() - 0.4) * 2 -- sometimes step in, sometimes back off
	approach(brain, tpos - dir * math.max(2, radius + wobble) + side * 5)
end

local function attack(brain: Brain, aim: Vector3)
	-- unit aim: bots keep their full-reach throws (a long aim vector = assisted throw length, v0.9.3)
	local f = flat(aim)
	CombatService.Request(brain.Combatant, "Shove", if f.Magnitude > 1e-3 then f.Unit else aim)
end

local function think(brain: Brain)
	local me = brain.Combatant
	local t = now()
	if not me.Alive or t < me.StunnedUntil then
		return
	end
	local diff = brain.Diff
	local pos = me.Root.Position
	local margin = math.max(0, diff.Lookahead - 1)

	-- v0.8.3 anti-idle: if we haven't really moved for ~1 s (and aren't frozen), drop the goal
	if t < me.IcedUntil or me.Frozen then
		brain.StillFor = 0
	elseif flat(pos - brain.LastPos).Magnitude < 0.8 then
		brain.StillFor += B.ThinkInterval
	else
		brain.StillFor = 0
	end
	brain.LastPos = pos
	if brain.StillFor > 1.0 then
		brain.StillFor = 0
		brain.Goal = nil
		brain.StrafeSign = -brain.StrafeSign
		brain.StrafeFlip = t + 0.8
	end

	-- 1. SAFETY FIRST: tile under me (or nearby, with lookahead) is cracking → escape
	if not ArenaService.IsSafeAt(pos) then
		local g = safeGoalNear(brain, pos:Lerp(ArenaService.Center(), 0.35))
		if g then
			-- escape rush (v0.8.1: stuck in magma = rush is the ONLY way out, so try much harder)
			local inMagma = me.InMagma
			local chance = inMagma and math.max(0.55, diff.Rush) or diff.Rush
			if t >= me.RushReadyAt and math.random() < chance and (inMagma or ArenaService.PathSafe(pos, g)) then
				CombatService.Request(me, "Rush", flat(g - pos))
			end
			moveTo(brain, g)
		end
		return
	elseif ArenaService.DangerNear(pos, margin) then
		local g = safeGoalNear(brain, pos:Lerp(ArenaService.Center(), 0.35))
		if g and (brain.Goal == nil or not ArenaService.IsSafeAt(brain.Goal :: Vector3)) then
			moveTo(brain, g)
		end
		-- still allowed to fight below (movement may be overridden by the attack logic)
	end

	-- 2. TARGET
	local target = chooseTarget(brain)
	if target ~= brain.Target then
		brain.Target = target
		brain.TargetSince = t
	end
	if not target then
		wander(brain)
		return
	end

	local def = Weapons.Get(me.WeaponId)
	local tpos = target.Root.Position
	local offset = flat(tpos - pos)
	local dist = offset.Magnitude
	local dir = dist > 0.01 and offset.Unit or me.Aim
	local ready = t >= me.ShoveReadyAt and (t - brain.TargetSince) >= diff.Reaction
	local repelArmed = def.RepelKB ~= nil and t < me.Follow.RepelUntil -- v0.9.18 Magnet push-pull
	if def.RepelKB and not repelArmed and t < me.Follow.CycleAt then
		ready = false
	end
	local aggression = diff.Aggression
	if soloLobby and not target.IsBot and tierIndex(brain.DiffName) <= 2 then
		aggression *= B.SoloHumanAggression
	end
	local wants = math.random() < aggression
	local reach = def.Range + CC.BodyRadius

	-- v0.9.17 RUMBLE BOXES: bots grab a nearby weapon box when nobody is in their face
	local box = RumbleBoxService.Nearest(pos, 26)
	if box and dist > reach + 3 and flat(box - pos).Magnitude < dist and ArenaService.IsSafeAt(box) and ArenaService.PathSafe(pos, box) then
		moveTo(brain, box)
		return
	end

	-- 3. WEAPON-SPECIFIC ATTACK
	local kind = def.Kind
	if kind == "melee" or kind == "arc" or kind == "slam" then
		if dist <= reach * 0.9 then
			if ready and wants then
				attack(brain, dir)
			else
				strafe(brain, tpos, dir, reach * 0.7)
			end
		else
			if dist > 6 and dist < 12 and t >= me.RushReadyAt and math.random() < diff.Rush and ArenaService.PathSafe(pos, pos + dir * 12) then
				CombatService.Request(me, "Rush", dir)
			end
			approach(brain, tpos - dir * (reach * 0.6))
		end
	elseif kind == "aoe" then
		local near = 0
		for _, c in CombatService.All() do
			if c ~= me and c.Alive and flat(c.Root.Position - pos).Magnitude <= reach then
				near += 1
			end
		end
		if (near >= 2 or dist <= reach * 0.75) and ready and wants then
			attack(brain, dir)
		else
			approach(brain, tpos - dir * 3)
		end
	elseif kind == "projectile" then
		if dist >= 6 and dist <= def.Range * 0.85 then
			if ready and wants then
				local vel = flat(target.Root.AssemblyLinearVelocity)
				local lead = tpos + vel * (dist / (def.Speed or 90))
				attack(brain, flat(lead - pos))
			end
		end
		if dist < 12 then
			approach(brain, pos - dir * 8)
		elseif dist > 30 then
			approach(brain, tpos - dir * 20)
		else
			strafe(brain, tpos, dir, dist)
		end
	elseif kind == "pull" and repelArmed then
		-- the 2nd click: blast them back out once they're in the cone (the pull just dragged them close)
		local rr = (def.RepelRange or 9) + CC.BodyRadius
		if dist <= rr * 0.9 and t >= me.ShoveReadyAt then
			attack(brain, dir)
		elseif dist > rr * 0.9 then
			approach(brain, tpos - dir * 4)
		end
	elseif kind == "pull" then
		if dist >= 7 and dist <= def.Range and ready and wants then
			attack(brain, dir)
		elseif dist >= 7 and dist <= def.Range then
			strafe(brain, tpos, dir, math.clamp(dist, 9, def.Range * 0.8))
		elseif dist < 7 then
			approach(brain, pos - dir * 6)
		else
			approach(brain, tpos - dir * 12)
		end
	elseif kind == "thrown" then
		if math.abs(dist - def.Range) <= 6 and ready and wants then
			attack(brain, dir)
		elseif math.abs(dist - def.Range) <= 6 then
			strafe(brain, tpos, dir, def.Range)
		elseif dist < def.Range - 6 then
			approach(brain, pos - dir * 6)
		else
			approach(brain, tpos - dir * def.Range)
		end
	elseif kind == "tether" then
		if dist <= def.Range * 0.95 and dist > 5 and ready and wants then
			-- v0.7.1: the hook yanks the target to us, so only our own footing matters
			local safeHere = ArenaService.IsSafeAt(pos)
			local go = (brain.DiffName == "Hard" and safeHere)
				or (brain.DiffName == "Medium" and (safeHere or math.random() < 0.5))
				or brain.DiffName == "Easy"
			if go then
				attack(brain, dir)
			else
				strafe(brain, tpos, dir, math.min(dist, 14))
			end
		else
			approach(brain, tpos - dir * 14)
		end
	end
end

local function updateAnim(brain: Brain)
	local root = brain.Combatant.Root
	local speed = flat(root.AssemblyLinearVelocity).Magnitude
	local want = speed > 2 and "Run" or "Idle"
	if brain.Combatant.Humanoid.PlatformStand then
		want = "Idle"
	end
	if want ~= brain.Playing then
		local old = brain.Tracks[brain.Playing]
		if old then
			old:Stop(0.15)
		end
		local nt = brain.Tracks[want]
		if nt then
			nt:Play(0.15)
		end
		brain.Playing = want
	end
end

------------------------------------------------------------------------
-- Reactive blocking: bots see a swing coming and may block (and maybe parry)
------------------------------------------------------------------------
local function onSwing(attacker: CombatService.Combatant, def: Weapons.WeaponDef, aim: Vector3)
	for _, b in brains do
		local me = b.Combatant
		if me ~= attacker and me.Alive and now() >= me.StunnedUntil then
			local d = me.Root.Position - attacker.Root.Position
			local fd = flat(d)
			local dist = fd.Magnitude
			local facing = dist > 0.01 and aim:Dot(fd.Unit) or 1
			local threatened = false
			local delay = 0
			if def.Kind == "projectile" then
				threatened = dist <= def.Range and facing > 0.9
				delay = def.Windup + dist / (def.Speed or 90)
			elseif def.Kind == "aoe" then
				threatened = dist <= def.Range + CC.BodyRadius + 1
				delay = def.Windup
			elseif def.Kind == "thrown" then
				threatened = false
			elseif def.Kind == "slam" then
				-- v0.9.20 hammer: only rivals standing on the impact spot need to guard
				local center = attacker.Root.Position + flat(aim) * (def.SlamOffset or 4.5)
				threatened = flat(me.Root.Position - center).Magnitude <= (def.SlamRadius or 4.5) + CC.BodyRadius + 0.5
				delay = def.Windup
			else
				threatened = dist <= def.Range + CC.BodyRadius + 1 and facing > 0.3
				delay = def.Windup
			end
			if threatened and math.random() < b.Diff.Block then
				local canParry = math.random() < b.Diff.Parry
				-- start the block just before impact so a parry lands inside the 0.18 s window
				local startIn = math.max(0, delay - 0.1)
				task.delay(startIn, function()
					CombatService.BotBlock(me, canParry, 0.45)
				end)
			end
		end
	end
end

------------------------------------------------------------------------
-- Step / Init
------------------------------------------------------------------------
function BotService.Step(_dt: number)
	local t = now()
	for _, b in brains do
		if b.Combatant.Alive and t >= b.NextThink then
			b.NextThink = t + B.ThinkInterval + math.random() * 0.05
			b.Moved = false
			local ok, err = pcall(think, b)
			if not ok then
				warn("[CRUMBLE] bot think error:", err)
			end
			-- v0.8.3b guarantee: a bot that can act always has somewhere to go
			local me = b.Combatant
			if not b.Moved and me.Alive and t >= me.StunnedUntil and not me.Frozen and t >= me.IcedUntil then
				local g = b.Goal
				if g and flat(g - me.Root.Position).Magnitude > 3 then
					me.Humanoid:MoveTo(g)
				else
					pcall(wander, b)
				end
			end
			updateAnim(b)
		end
	end
end

-- v0.8.3b: the match just started: everyone re-plans right now (no stale countdown goals)
function BotService.Go()
	local t = now()
	for _, b in brains do
		b.NextThink = t + math.random() * 0.15
		b.Goal = nil
		b.Target = nil
		b.TargetSince = t - 1
		b.StillFor = 0
		b.LastPos = b.Combatant.Root.Position
	end
end

function BotService.Count(): number
	return #brains
end

function BotService.Init()
	botFolder = Instance.new("Folder")
	botFolder.Name = "Bots"
	botFolder.Parent = workspace
	CombatService.OnSwing(onSwing)
	task.spawn(ensureTemplate)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">BotStyles</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — BotStyles (v0.7.3 "Cozy+", v0.9.15 "Toy Kit" clean-up: one glow per bot — the face + chest emblem)
	12 chunky toy-brawler designs built on the R15 template: big round helmet with a dark screen
	face (glowing eyes + smile), mitts, chunky boots, a belly badge and a signature accessory set.
	Saturated colours only (no pastels), no amber/red/gold (reserved for cracking tiles and winners).
	Real models can replace any bot via ReplicatedStorage/BotModels/<NAME>.

	Roster (name -> look):
		BLITZ    lime + navy    lightning crest, goggles, chest stripes
		NOVA     violet + white star antenna, cape
		TURBO    royal blue     racing stripe, spoiler, jetpack
		VOLT     teal + ink     coil antennas, battery pack
		JINX     magenta + ink  cat ears, cat face, tail
		ZEPHYR   sky blue       scarf, headband
		KABOOM   green          hard hat with lamp, bomb tank
		GLITCH   cyan + purple  LED pixel face, hovering pixels
		TITAN    steel lavender huge shoulder pads, horns, mono-eye
		MOCHI    white + pink   bunny ears, bow, blush
		RAPTOR   emerald + ink  dino spikes, tail
		RANGEDUMMY canvas       stitched X eyes, bucket, target chest (Training Range)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Art = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Art"))

local M = Enum.Material
local rgb = Color3.fromRGB
local SCREEN = rgb(22, 24, 36)
local WHITE = rgb(250, 250, 255)

export type Style = {
	Body: Color3, -- torso / arms / helmet
	Trim: Color3, -- plates, mitts, boots
	Legs: Color3,
	Glow: Color3, -- eyes / seams (also the nameplate colour)
	Face: string, -- Eyes | Goggles | Visor | Cat | Pixel | Mono | Stitch
	Acc: { string },
}

local STYLES: { [string]: Style } = {
	BLITZ = { Body = rgb(120, 200, 40), Trim = rgb(30, 44, 96), Legs = rgb(30, 44, 96), Glow = rgb(170, 240, 0), Face = "Goggles", Acc = { "BoltCrest", "Stripes" } },
	NOVA = { Body = rgb(120, 70, 220), Trim = rgb(244, 244, 250), Legs = rgb(60, 40, 120), Glow = rgb(200, 150, 255), Face = "Eyes", Acc = { "StarAntenna", "Cape" } },
	TURBO = { Body = rgb(40, 90, 220), Trim = rgb(244, 244, 250), Legs = rgb(24, 40, 100), Glow = rgb(0, 229, 255), Face = "Visor", Acc = { "RaceStripe", "Spoiler", "Jetpack" } },
	VOLT = { Body = rgb(20, 160, 150), Trim = rgb(36, 40, 52), Legs = rgb(20, 60, 64), Glow = rgb(0, 240, 200), Face = "Eyes", Acc = { "Coils", "Battery" } },
	JINX = { Body = rgb(220, 40, 170), Trim = rgb(34, 30, 44), Legs = rgb(34, 30, 44), Glow = rgb(255, 90, 210), Face = "Cat", Acc = { "CatEars", "Tail" } },
	ZEPHYR = { Body = rgb(70, 170, 240), Trim = rgb(244, 244, 250), Legs = rgb(30, 80, 140), Glow = rgb(140, 210, 255), Face = "Eyes", Acc = { "Headband", "Scarf" } },
	KABOOM = { Body = rgb(70, 150, 60), Trim = rgb(40, 44, 52), Legs = rgb(40, 44, 52), Glow = rgb(120, 255, 120), Face = "Visor", Acc = { "HardHat", "BombTank" } },
	GLITCH = { Body = rgb(0, 190, 220), Trim = rgb(50, 30, 80), Legs = rgb(40, 24, 64), Glow = rgb(0, 255, 240), Face = "Pixel", Acc = { "PixelHover", "Vents" } },
	TITAN = { Body = rgb(130, 130, 170), Trim = rgb(36, 40, 80), Legs = rgb(36, 40, 80), Glow = rgb(230, 230, 255), Face = "Mono", Acc = { "BigPads", "Horns" } },
	MOCHI = { Body = rgb(248, 246, 250), Trim = rgb(240, 70, 150), Legs = rgb(240, 70, 150), Glow = rgb(255, 120, 190), Face = "Eyes", Acc = { "BunnyEars", "Bow", "Blush" } },
	RAPTOR = { Body = rgb(20, 150, 90), Trim = rgb(26, 28, 34), Legs = rgb(16, 90, 56), Glow = rgb(100, 255, 160), Face = "Visor", Acc = { "DinoSpikes", "DinoTail" } },
	-- Training Range dummies: stitched canvas practice bots with a target chest
	RANGEDUMMY = { Body = rgb(200, 170, 120), Trim = rgb(110, 80, 50), Legs = rgb(150, 120, 80), Glow = rgb(240, 240, 255), Face = "Stitch", Acc = { "Bucket", "Target" } },
}

local BotStyles = {}

function BotStyles.Get(name: string): Style?
	return STYLES[name]
end

local UPPER = { "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand" }
local LOWER = { "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }

local function part(model: Model, n: string): BasePart?
	return model:FindFirstChild(n) :: BasePart?
end

local function has(s: Style, a: string): boolean
	return table.find(s.Acc, a) ~= nil
end

------------------------------------------------------------------------
-- Head: big round helmet + screen face
------------------------------------------------------------------------
local D = 1.9 -- helmet diameter (chibi proportions)

local function head(model: Model, s: Style, hd: BasePart)
	local k = Art.Kit(model, hd, hd.CFrame, 1)
	hd.Transparency = 1
	for _, d in hd:GetChildren() do
		if d:IsA("Decal") then
			d:Destroy()
		end
	end
	local R = D / 2
	local c = Vector3.new(0, 0.2, 0)
	local fz = c.Z - R
	Art.Ball(k, D, c, s.Body, M.SmoothPlastic)
	-- ear caps (v0.9.15: chin guard and glowing ear cores removed — the face is the one glow)
	for _, sx in { -1, 1 } do
		Art.CylX(k, 0.72, 0.22, c + Vector3.new(sx * (R - 0.02), -0.02, 0), s.Trim, M.SmoothPlastic)
	end

	-- the screen (dark rounded panel) — every face style draws on it
	local sc = c + Vector3.new(0, -0.02, -R * 0.78)
	if s.Face ~= "Stitch" then
		Art.Box(k, Vector3.new(D * 0.74, D * 0.46, 0.5), sc, SCREEN, M.SmoothPlastic)
	end
	local f = sc.Z - 0.26 -- just in front of the screen
	local function smile(width: number, y: number)
		Art.Arc(k, function(t)
			return Vector3.new(math.cos(t) * width, sc.Y + y + math.sin(t) * width * 0.5, f)
		end, 200, 340, 5, 0.07, s.Glow, M.Neon)
	end
	if s.Face == "Eyes" then
		for _, sx in { -1, 1 } do
			Art.CylZ(k, 0.3, 0.06, Vector3.new(sx * 0.25, sc.Y + 0.08, f), s.Glow, M.Neon)
			Art.Ball(k, 0.09, Vector3.new(sx * 0.25 + 0.06, sc.Y + 0.14, f - 0.03), WHITE, M.Neon)
		end
		smile(0.16, -0.06)
	elseif s.Face == "Goggles" then
		Art.CylY(k, D * 0.99, 0.2, c + Vector3.new(0, 0.12, 0), s.Trim, M.SmoothPlastic) -- strap
		for _, sx in { -1, 1 } do
			Art.CylZ(k, 0.46, 0.05, Vector3.new(sx * 0.27, sc.Y + 0.1, f + 0.02), s.Trim, M.SmoothPlastic) -- goggle rim
			Art.CylZ(k, 0.32, 0.06, Vector3.new(sx * 0.27, sc.Y + 0.1, f), s.Glow, M.Neon)
		end
		smile(0.14, -0.1)
	elseif s.Face == "Visor" then
		Art.Box(k, Vector3.new(D * 0.58, 0.16, 0.06), Vector3.new(0, sc.Y + 0.08, f), s.Glow, M.Neon)
		Art.Box(k, Vector3.new(0.12, 0.05, 0.06), Vector3.new(0.38, sc.Y + 0.08, f - 0.02), WHITE, M.Neon)
		smile(0.14, -0.08)
	elseif s.Face == "Cat" then
		for _, sx in { -1, 1 } do
			Art.Arc(k, function(t)
				return Vector3.new(sx * 0.25 + math.cos(t) * 0.12, sc.Y + 0.02 + math.sin(t) * 0.12, f)
			end, 20, 160, 3, 0.07, s.Glow, M.Neon)
		end
		Art.Ball(k, 0.1, Vector3.new(0, sc.Y - 0.08, f), s.Glow, M.Neon) -- nose
		smile(0.1, -0.1)
	elseif s.Face == "Pixel" then
		local px = 0.1
		local cells = { { -3, 1 }, { -2, 1 }, { -3, 0 }, { -2, 0 }, { 2, 1 }, { 3, 1 }, { 2, 0 }, { 3, 0 }, { -2, -2 }, { -1, -3 }, { 0, -3 }, { 1, -3 }, { 2, -2 } }
		for _, cl in cells do
			Art.Box(k, Vector3.new(px * 0.9, px * 0.9, 0.05), Vector3.new(cl[1] * px, sc.Y + 0.04 + cl[2] * px, f), s.Glow, M.Neon)
		end
	elseif s.Face == "Mono" then
		Art.CylZ(k, 0.52, 0.05, Vector3.new(0, sc.Y + 0.04, f + 0.02), s.Trim, M.SmoothPlastic) -- lens rim
		Art.CylZ(k, 0.36, 0.06, Vector3.new(0, sc.Y + 0.04, f), s.Glow, M.Neon)
		Art.CylZ(k, 0.14, 0.08, Vector3.new(0, sc.Y + 0.04, f - 0.02), SCREEN, M.SmoothPlastic)
		Art.Box(k, Vector3.new(0.3, 0.05, 0.05), Vector3.new(0, sc.Y - 0.22, f), s.Glow, M.Neon)
	else -- Stitch (range dummy): sewn X eyes on canvas + stitched mouth
		for _, sx in { -1, 1 } do
			for _, a in { 45, -45 } do
				Art.Box(k, Vector3.new(0.3, 0.06, 0.06), CFrame.new(sx * 0.3, c.Y + 0.08, fz + 0.06) * CFrame.Angles(0, 0, math.rad(a)), rgb(60, 44, 30), M.Fabric)
			end
		end
		Art.Box(k, Vector3.new(0.5, 0.05, 0.05), Vector3.new(0, c.Y - 0.28, fz + 0.12), rgb(60, 44, 30), M.Fabric)
		for i = -2, 2 do
			Art.Box(k, Vector3.new(0.04, 0.14, 0.05), Vector3.new(i * 0.1, c.Y - 0.28, fz + 0.11), rgb(60, 44, 30), M.Fabric)
		end
	end
	if has(s, "Blush") then
		for _, sx in { -1, 1 } do
			Art.CylZ(k, 0.2, 0.04, Vector3.new(sx * 0.46, sc.Y - 0.08, f + 0.02), rgb(255, 130, 180), M.SmoothPlastic)
		end
	end

	-- headgear
	local top = c + Vector3.new(0, R, 0)
	if has(s, "BoltCrest") then
		local pts = { top + Vector3.new(0, -0.1, 0.3), top + Vector3.new(0, 0.42, 0.05), top + Vector3.new(0, 0.26, -0.08), top + Vector3.new(0, 0.7, -0.36) }
		for i = 1, #pts - 1 do
			Art.Segment(k, pts[i], pts[i + 1], 0.22, s.Glow, M.Neon)
		end
	end
	if has(s, "StarAntenna") then
		Art.Segment(k, top + Vector3.new(0, -0.1, 0), top + Vector3.new(0, 0.6, 0), 0.08, s.Trim, M.Metal)
		local sc2 = top + Vector3.new(0, 0.72, 0)
		Art.Ball(k, 0.24, sc2, s.Glow, M.Neon)
		for i = 0, 4 do
			local a = math.rad(90 + i * 72)
			Art.Segment(k, sc2, sc2 + Vector3.new(math.cos(a) * 0.26, math.sin(a) * 0.26, 0), 0.1, s.Glow, M.Neon)
		end
	end
	if has(s, "RaceStripe") then
		Art.Arc(k, function(t)
			return c + Vector3.new(0, math.cos(t) * (R + 0.01), math.sin(t) * (R + 0.01))
		end, -50, 120, 8, 0.32, s.Trim, M.SmoothPlastic)
	end
	if has(s, "Spoiler") then
		for _, sx in { -1, 1 } do
			Art.Segment(k, c + Vector3.new(sx * 0.3, R * 0.6, R * 0.6), c + Vector3.new(sx * 0.3, R * 0.95, R * 1.0), 0.1, s.Trim, M.SmoothPlastic)
		end
		Art.Box(k, Vector3.new(1.2, 0.08, 0.4), CFrame.new(c + Vector3.new(0, R * 0.98, R * 1.04)) * CFrame.Angles(math.rad(-12), 0, 0), s.Trim, M.SmoothPlastic)
	end
	if has(s, "Coils") then
		for _, sx in { -1, 1 } do
			local base = c + Vector3.new(sx * 0.42, R * 0.8, 0)
			Art.CylY(k, 0.1, 0.6, base + Vector3.new(0, 0.3, 0), s.Trim, M.Metal)
			Art.Ball(k, 0.26, base + Vector3.new(0, 0.66, 0), s.Glow, M.Neon)
		end
	end
	if has(s, "CatEars") or has(s, "BunnyEars") then
		local bunny = has(s, "BunnyEars")
		for _, sx in { -1, 1 } do
			if bunny then
				local rot = CFrame.Angles(0, 0, math.rad(-sx * 12))
				Art.CylY(k, 0.36, 1.2, c + Vector3.new(sx * 0.36, R + 0.4, 0.05), s.Body, M.SmoothPlastic, nil, rot)
				Art.CylY(k, 0.2, 0.9, c + Vector3.new(sx * 0.37, R + 0.42, -0.1), s.Trim, M.SmoothPlastic, nil, rot)
			else
				Art.Wedge(k, Vector3.new(0.2, 0.62, 0.56), CFrame.new(c + Vector3.new(sx * 0.46, R * 0.88, 0.05)) * CFrame.Angles(0, 0, math.rad(-sx * 18)) * CFrame.Angles(0, math.rad(sx * 90), 0), s.Body, M.SmoothPlastic)
				Art.Wedge(k, Vector3.new(0.22, 0.36, 0.3), CFrame.new(c + Vector3.new(sx * 0.46, R * 0.84, -0.04)) * CFrame.Angles(0, 0, math.rad(-sx * 18)) * CFrame.Angles(0, math.rad(sx * 90), 0), s.Glow, M.Neon)
			end
		end
	end
	if has(s, "Headband") then
		Art.CylY(k, D * 0.93, 0.22, c + Vector3.new(0, R * 0.42, 0), s.Trim, M.SmoothPlastic)
		for _, sx in { -1, 1 } do
			Art.Segment(k, c + Vector3.new(sx * 0.1, R * 0.42, R * 0.9), c + Vector3.new(sx * 0.32, R * 0.05, R * 1.3), 0.14, s.Trim, M.SmoothPlastic)
		end
	end
	if has(s, "HardHat") then
		Art.Ball(k, D * 1.06, c + Vector3.new(0, 0.18, 0.02), rgb(240, 240, 232), M.SmoothPlastic)
		Art.CylY(k, D * 1.18, 0.1, c + Vector3.new(0, 0.12, 0.02), rgb(240, 240, 232), M.SmoothPlastic)
		Art.Box(k, Vector3.new(0.16, 0.12, D * 1.0), c + Vector3.new(0, R + 0.2, 0), s.Body, M.SmoothPlastic) -- ridge
		Art.CylZ(k, 0.42, 0.2, c + Vector3.new(0, R * 0.62, -R - 0.02), s.Trim, M.SmoothPlastic)
		local lamp = Art.CylZ(k, 0.3, 0.22, c + Vector3.new(0, R * 0.62, -R - 0.06), rgb(255, 250, 220), M.Neon)
		Art.Light(lamp, rgb(255, 250, 220), 8, 0.6)
	end
	if has(s, "Horns") then
		for _, sx in { -1, 1 } do
			local b = c + Vector3.new(sx * R * 0.7, R * 0.6, 0)
			Art.Segment(k, b, b + Vector3.new(sx * 0.32, 0.32, -0.06), 0.24, s.Trim, M.SmoothPlastic)
			Art.Segment(k, b + Vector3.new(sx * 0.32, 0.32, -0.06), b + Vector3.new(sx * 0.4, 0.62, -0.12), 0.14, WHITE, M.SmoothPlastic)
		end
	end
	if has(s, "Bow") then
		local b = c + Vector3.new(0.5, R * 0.86, 0)
		Art.Ball(k, 0.36, b + Vector3.new(-0.16, 0, 0), s.Trim, M.SmoothPlastic)
		Art.Ball(k, 0.36, b + Vector3.new(0.16, 0, 0), s.Trim, M.SmoothPlastic)
		Art.Ball(k, 0.18, b, WHITE, M.SmoothPlastic)
	end
	if has(s, "DinoSpikes") then
		for i = 0, 4 do
			local a = math.rad(-30 + i * 32)
			local p = c + Vector3.new(0, math.cos(a) * R, math.sin(a) * R)
			Art.Wedge(k, Vector3.new(0.14, 0.4 - i * 0.04, 0.4), CFrame.lookAt(p, p + Vector3.new(0, math.cos(a), math.sin(a))) * CFrame.Angles(math.rad(-90), 0, 0), s.Trim, M.SmoothPlastic)
		end
	end
	if has(s, "PixelHover") then
		for i = 0, 2 do
			local a = math.rad(40 + i * 110)
			Art.Box(k, Vector3.new(0.2, 0.2, 0.2), CFrame.new(c + Vector3.new(math.cos(a) * (R + 0.45), 0.5 + i * 0.18, math.sin(a) * (R + 0.45))) * CFrame.Angles(0.4, a, 0.3), s.Glow, M.Neon)
		end
	end
	if has(s, "Bucket") then
		Art.CylY(k, D * 0.8, 0.7, c + Vector3.new(0.05, R + 0.15, 0.05), rgb(120, 126, 136), M.Metal, nil, CFrame.Angles(math.rad(8), 0, math.rad(-10)))
		Art.CylY(k, D * 0.84, 0.08, c + Vector3.new(0.02, R - 0.18, 0.02), rgb(90, 96, 106), M.Metal, nil, CFrame.Angles(math.rad(8), 0, math.rad(-10)))
	end
end

------------------------------------------------------------------------
-- Body: chest plate, belly badge, belt, mitts, chunky boots, accessories
------------------------------------------------------------------------
local function body(model: Model, s: Style)
	for _, n in UPPER do
		local p = part(model, n)
		if p then
			p.Color = s.Body
			p.Material = M.SmoothPlastic
		end
	end
	for _, n in LOWER do
		local p = part(model, n)
		if p then
			p.Color = s.Legs
			p.Material = M.SmoothPlastic
		end
	end

	local ut = part(model, "UpperTorso")
	if ut then
		local k = Art.Kit(model, ut, ut.CFrame, 1)
		local z = ut.Size
		local fz = -z.Z / 2
		local bz = z.Z / 2
		-- rounded chest plate + belly badge
		Art.Box(k, Vector3.new(z.X * 0.82, z.Y * 0.62, 0.24), Vector3.new(0, z.Y * 0.06, fz - 0.06), s.Trim, M.SmoothPlastic)
		if not has(s, "Target") then
			Art.CylZ(k, 0.56, 0.1, Vector3.new(0, z.Y * 0.04, fz - 0.2), s.Glow, M.Neon) -- chest emblem
		end
		-- collar + back plate
		Art.CylY(k, 1.0, 0.18, Vector3.new(0, z.Y / 2, 0), s.Trim, M.SmoothPlastic)
		Art.Box(k, Vector3.new(z.X * 0.66, z.Y * 0.54, 0.18), Vector3.new(0, z.Y * 0.06, bz + 0.05), s.Trim, M.SmoothPlastic)
		if has(s, "Stripes") then
			for _, sx in { -1, 1 } do
				Art.Box(k, Vector3.new(0.16, z.Y * 0.9, 0.06), CFrame.new(sx * 0.62, 0, fz - 0.02) * CFrame.Angles(0, 0, math.rad(sx * 8)), s.Legs, M.SmoothPlastic)
			end
		end
		if has(s, "Target") then
			local tc = Vector3.new(0, z.Y * 0.04, fz - 0.2)
			Art.CylZ(k, 1.1, 0.06, tc, WHITE, M.SmoothPlastic)
			Art.CylZ(k, 0.8, 0.08, tc + Vector3.new(0, 0, -0.01), rgb(40, 110, 220), M.SmoothPlastic)
			Art.CylZ(k, 0.5, 0.1, tc + Vector3.new(0, 0, -0.02), WHITE, M.SmoothPlastic)
			Art.CylZ(k, 0.22, 0.12, tc + Vector3.new(0, 0, -0.03), rgb(40, 110, 220), M.SmoothPlastic)
		end
		if has(s, "Cape") then
			Art.Box(k, Vector3.new(z.X * 0.96, z.Y * 1.7, 0.08), CFrame.new(0, -z.Y * 0.38, bz + 0.2) * CFrame.Angles(math.rad(8), 0, 0), s.Trim, M.Fabric)
			Art.Box(k, Vector3.new(z.X * 0.96, 0.12, 0.1), Vector3.new(0, -z.Y * 1.2, bz + 0.34), s.Glow, M.Neon)
		end
		if has(s, "Jetpack") then
			for _, sx in { -1, 1 } do
				Art.CylY(k, 0.56, 1.1, Vector3.new(sx * 0.36, z.Y * 0.04, bz + 0.42), s.Trim, M.SmoothPlastic)
				Art.Ball(k, 0.56, Vector3.new(sx * 0.36, z.Y * 0.04 + 0.55, bz + 0.42), s.Trim, M.SmoothPlastic)
				Art.CylY(k, 0.4, 0.2, Vector3.new(sx * 0.36, z.Y * 0.04 - 0.64, bz + 0.42), s.Glow, M.Neon)
			end
		end
		if has(s, "Battery") then
			Art.Box(k, Vector3.new(1.0, 1.1, 0.5), Vector3.new(0, z.Y * 0.04, bz + 0.36), s.Trim, M.SmoothPlastic)
			Art.Box(k, Vector3.new(1.02, 0.36, 0.52), Vector3.new(0, z.Y * 0.04 + 0.26, bz + 0.36), s.Glow, M.Neon)
		end
		if has(s, "BombTank") then
			Art.Ball(k, 1.3, Vector3.new(0, z.Y * 0.1, bz + 0.62), rgb(40, 44, 60), M.SmoothPlastic)
			Art.CylY(k, 0.36, 0.22, Vector3.new(0, z.Y * 0.1 + 0.7, bz + 0.62), rgb(70, 74, 82), M.Metal)
			Art.Segment(k, Vector3.new(0, z.Y * 0.1 + 0.8, bz + 0.62), Vector3.new(0.18, z.Y * 0.1 + 1.06, bz + 0.74), 0.07, rgb(230, 214, 170), M.Fabric)
			Art.Ball(k, 0.14, Vector3.new(0.2, z.Y * 0.1 + 1.12, bz + 0.76), rgb(255, 244, 210), M.Neon)
			Art.Box(k, Vector3.new(z.X * 0.9, 0.14, 0.1), Vector3.new(0, z.Y * 0.1, bz + 0.08), rgb(110, 66, 38), M.Leather) -- strap
		end
		if has(s, "Vents") then
			for i = 0, 2 do
				Art.Box(k, Vector3.new(z.X * 0.46, 0.07, 0.06), Vector3.new(0, z.Y * (0.22 - i * 0.14), bz + 0.16), s.Glow, M.Neon)
			end
		end
		if has(s, "Scarf") then
			Art.CylY(k, 1.3, 0.34, Vector3.new(0, z.Y / 2 - 0.05, 0), s.Trim, M.Fabric)
			Art.Box(k, Vector3.new(0.4, 0.9, 0.1), CFrame.new(0.3, z.Y * 0.1, bz + 0.2) * CFrame.Angles(math.rad(14), 0, math.rad(-10)), s.Trim, M.Fabric)
			Art.Box(k, Vector3.new(0.42, 0.1, 0.12), CFrame.new(0.38, -z.Y * 0.22, bz + 0.3) * CFrame.Angles(math.rad(14), 0, math.rad(-10)), s.Glow, M.Neon)
		end
		if has(s, "DinoSpikes") then
			for i = 0, 3 do
				local y = z.Y * (0.4 - i * 0.26)
				Art.Wedge(k, Vector3.new(0.14, 0.44 - i * 0.05, 0.44 - i * 0.05), CFrame.new(0, y, bz + 0.3) * CFrame.Angles(math.rad(90), 0, 0), s.Trim, M.SmoothPlastic)
			end
		end
	end

	local lt = part(model, "LowerTorso")
	if lt then
		local k = Art.Kit(model, lt, lt.CFrame, 1)
		local z = lt.Size
		Art.Box(k, Vector3.new(z.X * 1.06, 0.26, z.Z * 1.1), Vector3.new(0, z.Y * 0.2, 0), s.Trim, M.SmoothPlastic)
		Art.Box(k, Vector3.new(0.44, 0.32, 0.1), Vector3.new(0, z.Y * 0.2, -z.Z * 0.56 - 0.04), WHITE, M.SmoothPlastic) -- buckle
		if has(s, "Tail") or has(s, "DinoTail") then
			local dino = has(s, "DinoTail")
			local p0 = Vector3.new(0, 0, z.Z / 2)
			local dirs = { Vector3.new(0, -0.1, 0.5), Vector3.new(0, 0.05, 0.45), Vector3.new(0, 0.3, 0.35), Vector3.new(0, 0.42, 0.15) }
			local thick = dino and 0.62 or 0.32
			for i, dv in dirs do
				local p1 = p0 + dv
				Art.Segment(k, p0, p1, thick * (1 - (i - 1) * 0.18), s.Body, M.SmoothPlastic)
				Art.Ball(k, thick * (1 - (i - 1) * 0.18), p1, s.Body, M.SmoothPlastic)
				p0 = p1
			end
			Art.Ball(k, dino and 0.3 or 0.3, p0 + Vector3.new(0, 0.08, 0), dino and s.Trim or s.Glow, dino and M.SmoothPlastic or M.Neon)
		end
	end

	for _, side in { "Left", "Right" } do
		local sx = side == "Left" and -1 or 1
		local ua = part(model, side .. "UpperArm")
		if ua then
			local k = Art.Kit(model, ua, ua.CFrame, 1)
			if has(s, "BigPads") then
				Art.Ball(k, 1.5, Vector3.new(sx * 0.12, ua.Size.Y * 0.36, 0), s.Trim, M.SmoothPlastic)
			else
				Art.Ball(k, math.max(ua.Size.X, ua.Size.Z) * 1.3, Vector3.new(sx * 0.06, ua.Size.Y * 0.36, 0), s.Trim, M.SmoothPlastic)
			end
		end
		local la = part(model, side .. "LowerArm")
		if la then
			local k = Art.Kit(model, la, la.CFrame, 1)
			Art.CylY(k, math.max(la.Size.X, la.Size.Z) * 1.12, la.Size.Y * 0.36, Vector3.new(0, -la.Size.Y * 0.22, 0), s.Trim, M.SmoothPlastic)
		end
		local hand = part(model, side .. "Hand")
		if hand then
			local k = Art.Kit(model, hand, hand.CFrame, 1)
			Art.Ball(k, math.max(hand.Size.X, hand.Size.Z) * 1.35, Vector3.new(0, -0.04, 0), WHITE, M.SmoothPlastic) -- cartoon mitt
		end
		local ll = part(model, side .. "LowerLeg")
		if ll then
			local k = Art.Kit(model, ll, ll.CFrame, 1)
			Art.CylY(k, math.max(ll.Size.X, ll.Size.Z) * 1.16, ll.Size.Y * 0.4, Vector3.new(0, -ll.Size.Y * 0.28, 0), s.Trim, M.SmoothPlastic) -- boot shaft
		end
		local ft = part(model, side .. "Foot")
		if ft then
			local k = Art.Kit(model, ft, ft.CFrame, 1)
			local f = ft.Size
			Art.Box(k, Vector3.new(f.X * 1.2, f.Y * 1.1, f.Z * 1.2), Vector3.new(0, 0.02, -0.06), s.Trim, M.SmoothPlastic)
			Art.Ball(k, f.X * 1.2, Vector3.new(0, 0.0, -f.Z * 0.55), s.Trim, M.SmoothPlastic) -- round toe
			Art.Box(k, Vector3.new(f.X * 1.26, 0.14, f.Z * 1.36), Vector3.new(0, -f.Y / 2 - 0.02, -0.1), WHITE, M.SmoothPlastic) -- sole
		end
	end
end

-- Returns the bot's signature colour (used by the nameplate).
function BotStyles.Apply(model: Model, name: string, fallback: Color3): Color3
	local st: Style
	local found = STYLES[name] or (if string.sub(name, 1, 10) == "RangeDummy" then STYLES.RANGEDUMMY else nil)
	if found then
		st = found
	else
		local copy = table.clone(STYLES.BLITZ)
		copy.Glow = fallback
		st = copy
	end
	body(model, st)
	local hd = part(model, "Head")
	if hd then
		head(model, st, hd)
	end
	-- flat toon colours on body + plates (glows stay neon)
	Art.Toon(model, 0.18)
	-- rounded edges on plates ≥ 0.8 studs (keeps part counts mobile-friendly)
	Art.SoftenAll(model, { MaxRadius = 0.3, Ratio = 0.3, MinRadius = 0.1, Filter = function(p)
		local sz = p.Size
		return p.Name == "Art" and math.max(sz.X, sz.Y, sz.Z) >= 0.8
	end })
	return st.Glow
end

return BotStyles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — CombatService (server-authoritative)

	Clients only send INTENT ("Shove", "Rush", "BlockStart", "BlockEnd" + aim direction).
	The server checks cooldowns, range, cone, stun and protection, then computes the final
	knockback:  base × (rarity bonus + level bonus) × juggle decay  → block/parry → 28-stud cap.

	Players own their character physics, so the server tells the victim's client to apply
	the launch velocity (Knockback remote). Bots are server-owned and launched directly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local Net = require(Shared.Net)

local ArenaService = require(script.Parent.ArenaService)

local C = Config.Combat

export type Hit = { Attacker: any, Time: number }

export type Combatant = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Player: Player?,
	IsBot: boolean,
	Name: string,
	WeaponId: string,
	Level: number,
	Alive: boolean,
	Aim: Vector3,
	ThrowDist: number?, -- v0.9.3 aim-assisted throw length (length of the client's aim vector)

	ShoveReadyAt: number,
	RushReadyAt: number,
	Blocking: boolean,
	BlockStart: number,
	LastBlockStart: number,
	ParryEligible: boolean,
	Guard: number,
	GuardRegenAt: number,
	LastGuardAttr: number,

	StunnedUntil: number,
	ProtectedUntil: number,
	RushingUntil: number,
	RushDir: Vector3,
	RushHit: { [any]: boolean },
	SlowUntil: number,
	LaunchToken: number,

	SwingStart: number,
	SwingWeapon: string,
	ComboCount: number,
	ComboStart: number,
	Follow: Weapons.FollowState, -- v0.9.18 Magnet push-pull
	Pulled: any?, -- v0.9.18c: the rival the Magnet just pulled in (the repel always reaches them)

	Hits: { Hit },
	BotBrain: any?,
	Frozen: boolean,
	LastFrozen: boolean?,
	IcedUntil: number, -- v0.8.1 frost trap
	IceBlock: BasePart?,
	InMagma: boolean, -- v0.8.1 standing in a magma pool
	SkateVel: Vector2, -- v0.8.2 bot skating on the Ice Rink
}

local CombatService = {}

local combatants: { [Model]: Combatant } = {}
local enabled = false
local swingListeners: { (Combatant, Weapons.WeaponDef, Vector3) -> () } = {}

local knockbackRemote = Net.Get("Knockback")
local effectRemote = Net.Get("Effect")
local _announceRemote = Net.Get("Announce") -- (v0.9.12: no combat banners)
local actionRemote = Net.Get("Action")

local effectsFolder: Folder

type Projectile = {
	Part: Part,
	Pos: Vector3,
	Vel: Vector3,
	Owner: Combatant,
	Def: Weapons.WeaponDef,
	Traveled: number,
	Deflected: number,
}
type Bomb = {
	Part: Part,
	From: Vector3,
	To: Vector3,
	T0: number,
	Owner: Combatant,
	Def: Weapons.WeaponDef,
}

local projectiles: { Projectile } = {}
local bombs: { Bomb } = {}

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
local function now(): number
	return workspace:GetServerTimeNow()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3, fallback: Vector3): Vector3
	local f = flat(v)
	if f.Magnitude < 1e-3 then
		return fallback
	end
	return f.Unit
end

local function isFiniteVector(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

local function fx(kind: string, data: { [string]: any })
	effectRemote:FireAllClients(kind, data)
end


-- v0.8: per-map knockback scale (Ice Rink = launches carry farther). Range uses scale 1.
local kbScale = 1
function CombatService.SetKBScale(x: number)
	kbScale = x
end

local function launchVelocityScaled(dir: Vector3, kb: number, height: number?, scale: number): (Vector3, number)
	kb *= scale
	local g = workspace.Gravity
	local vy
	if height and height > 0 then
		vy = math.sqrt(2 * g * height)
	else
		vy = C.LaunchBaseVy + kb * C.LaunchVyPerKB
	end
	local air = 2 * vy / g
	local vx = kb / air
	return dir * vx + Vector3.new(0, vy, 0), air + C.StunPadding
end

local function launchVelocity(dir: Vector3, kb: number, height: number?): (Vector3, number)
	return launchVelocityScaled(dir, kb, height, kbScale)
end

-- Shared with the Training Range so its measurements match real combat exactly (always scale 1).
CombatService.LaunchVelocity = function(dir: Vector3, kb: number, height: number?): (Vector3, number)
	return launchVelocityScaled(dir, kb, height, 1)
end

-- Swap a fighter's weapon for the rest of the round.
function CombatService.SetWeapon(c: Combatant, weaponId: string, level: number)
	c.WeaponId = Weapons.Get(weaponId).Id
	c.Level = math.clamp(level, 1, Rarity.MaxLevel)
	c.ComboCount = 0
	c.ComboStart = -10
	c.ShoveReadyAt = math.min(c.ShoveReadyAt, now() + 0.3)
	c.Follow = Weapons.NewFollow()
end

------------------------------------------------------------------------
-- Registry
------------------------------------------------------------------------
function CombatService.Register(model: Model, opts: { Player: Player?, IsBot: boolean, Name: string, WeaponId: string, Level: number }): Combatant?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return nil
	end
	local c: Combatant = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Player = opts.Player,
		IsBot = opts.IsBot,
		Name = opts.Name,
		WeaponId = Weapons.Get(opts.WeaponId).Id,
		Level = math.clamp(opts.Level or 1, 1, Rarity.MaxLevel),
		Alive = true,
		Aim = root.CFrame.LookVector,

		ShoveReadyAt = 0,
		Follow = Weapons.NewFollow(),
		RushReadyAt = 0,
		Blocking = false,
		BlockStart = 0,
		LastBlockStart = -10,
		ParryEligible = true,
		Guard = C.GuardMax,
		GuardRegenAt = 0,
		LastGuardAttr = C.GuardMax,

		StunnedUntil = 0,
		ProtectedUntil = 0,
		RushingUntil = 0,
		RushDir = Vector3.new(0, 0, -1),
		RushHit = {},
		SlowUntil = 0,
		LaunchToken = 0,

		SwingStart = -10,
		SwingWeapon = "",
		ComboCount = 0,
		ComboStart = -10,

		Hits = {},
		BotBrain = nil,
		Frozen = false,
		LastFrozen = nil,
		IcedUntil = 0,
		IceBlock = nil,
		InMagma = false,
		SkateVel = Vector2.zero,
	}
	combatants[model] = c
	model:SetAttribute("Guard", C.GuardMax)
	model:SetAttribute("Blocking", false)
	model:SetAttribute("InRound", true)
	model:SetAttribute("Alive", true)
	model:SetAttribute("IsBot", opts.IsBot)
	model:SetAttribute("DisplayName", opts.Name)
	return c
end

function CombatService.Unregister(model: Model)
	local c = combatants[model]
	if c then
		c.Alive = false
		combatants[model] = nil
		if c.IceBlock then
			(c.IceBlock :: BasePart):Destroy()
			c.IceBlock = nil
		end
		c.IcedUntil = 0
		if model.Parent then
			model:SetAttribute("InRound", false)
			model:SetAttribute("Alive", false)
			model:SetAttribute("Blocking", false)
		end
	end
end

function CombatService.Get(model: Model?): Combatant?
	if not model then
		return nil
	end
	return combatants[model]
end

function CombatService.All(): { [Model]: Combatant }
	return combatants
end

function CombatService.SetFrozen(c: Combatant, frozen: boolean)
	c.Frozen = frozen
end

function CombatService.SetEnabled(on: boolean)
	enabled = on
end

function CombatService.IsEnabled(): boolean
	return enabled
end

function CombatService.OnSwing(fn: (Combatant, Weapons.WeaponDef, Vector3) -> ())
	table.insert(swingListeners, fn)
end

function CombatService.SetProtection(c: Combatant, seconds: number)
	c.ProtectedUntil = now() + seconds
	local ff = c.Model:FindFirstChild("SpawnShield")
	if not ff then
		local f = Instance.new("ForceField")
		f.Name = "SpawnShield"
		f.Visible = true
		f.Parent = c.Model
	end
end

local function endProtection(c: Combatant)
	c.ProtectedUntil = 0
	local ff = c.Model:FindFirstChild("SpawnShield")
	if ff then
		ff:Destroy()
	end
end

function CombatService.MarkDead(c: Combatant)
	c.Alive = false
	c.Blocking = false
	if c.Model.Parent then
		c.Model:SetAttribute("Alive", false)
		c.Model:SetAttribute("Blocking", false)
	end
end

------------------------------------------------------------------------
-- KO credit: last hitter within 6 s gets the KO, others in the window get assists
------------------------------------------------------------------------
function CombatService.GetCredit(victim: Combatant): (Combatant?, { Combatant })
	local t = now()
	local killer: Combatant? = nil
	local assists: { Combatant } = {}
	local seen: { [any]: boolean } = {}
	for k = #victim.Hits, 1, -1 do
		local h = victim.Hits[k]
		if t - h.Time <= C.KOCreditWindow and h.Attacker ~= victim and not seen[h.Attacker] then
			seen[h.Attacker] = true
			if killer == nil then
				killer = h.Attacker
			else
				table.insert(assists, h.Attacker)
			end
		end
	end
	return killer, assists
end

local function recordHit(target: Combatant, attacker: Combatant)
	local t = now()
	table.insert(target.Hits, { Attacker = attacker, Time = t })
	-- prune
	while #target.Hits > 0 and t - target.Hits[1].Time > C.KOCreditWindow do
		table.remove(target.Hits, 1)
	end
end

------------------------------------------------------------------------
-- Movement application
------------------------------------------------------------------------
local function stopBlock(c: Combatant)
	if c.Blocking then
		c.Blocking = false
		c.GuardRegenAt = now() + C.GuardRegenDelay
		c.Model:SetAttribute("Blocking", false)
	end
end

-- v0.8.1 Ice Rink frost trap: frozen solid in an ice block (no moving, attacking or blocking).
-- Any hit shatters the ice early (see Launch), so frozen fighters are a target, not a free KO.
local function thaw(c: Combatant)
	c.IcedUntil = 0
	if c.IceBlock then
		(c.IceBlock :: BasePart):Destroy()
		c.IceBlock = nil
	end
	if c.Model.Parent then
		c.Model:SetAttribute("Iced", false)
	end
end

function CombatService.Freeze(c: Combatant, duration: number)
	if not c.Alive then
		return
	end
	local t = now()
	c.IcedUntil = t + duration
	c.StunnedUntil = math.max(c.StunnedUntil, t + duration)
	c.RushingUntil = 0
	stopBlock(c)
	c.Model:SetAttribute("Iced", true)
	if not c.IceBlock then
		local block = Instance.new("Part")
		block.Name = "IceBlock"
		block.Size = Vector3.new(4.6, 6.4, 4.6)
		block.Color = Config.Maps.Ice.Crystal
		block.Material = Enum.Material.Ice
		block.Transparency = 0.35
		block.Reflectance = 0.2
		block.CanCollide = false
		block.CanQuery = false
		block.CanTouch = false
		block.Massless = true
		block.CastShadow = false
		block.CFrame = c.Root.CFrame * CFrame.new(0, -0.2, 0) * CFrame.Angles(0, math.rad(math.random(-12, 12)), 0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = block
		w.Part1 = c.Root
		w.Parent = block
		block.Parent = c.Model
		c.IceBlock = block
	end
	if not c.Player then
		c.Root.AssemblyLinearVelocity = Vector3.new(0, c.Root.AssemblyLinearVelocity.Y, 0)
	end
end

-- v0.8.2 Ice Rink: bots skate with the same physics as the client skater (a touch grippier,
-- they can't anticipate like people) and get pushed by blizzard gusts.
local function stepBotSkate(c: Combatant, dt: number)
	local root, hum = c.Root, c.Humanoid
	local lv = root:FindFirstChild("SkateVelocity") :: LinearVelocity?
	local on = enabled
		and ArenaService.CurrentMap() == "Ice"
		and math.abs(root.Position.Y - Config.Arena.Center.Y) < 12
		and not hum.PlatformStand
		and hum.FloorMaterial ~= Enum.Material.Air
		and root:FindFirstChild("RushVelocity") == nil
		and hum.WalkSpeed > 0
	if not on then
		if lv then
			lv.Enabled = false
		end
		return
	end
	local att = root:FindFirstChild("RootAttachment") :: Attachment?
	if not att then
		return
	end
	if not lv then
		local n = Instance.new("LinearVelocity")
		n.Name = "SkateVelocity"
		n.Attachment0 = att
		n.RelativeTo = Enum.ActuatorRelativeTo.World
		n.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		n.PrimaryTangentAxis = Vector3.xAxis
		n.SecondaryTangentAxis = Vector3.zAxis
		n.MaxForce = 1e5
		n.Enabled = false
		n.Parent = root
		lv = n
	end
	local s = lv :: LinearVelocity
	if not s.Enabled then
		local v = root.AssemblyLinearVelocity
		c.SkateVel = Vector2.new(v.X, v.Z)
		s.Enabled = true
	end
	local sk = Config.Maps.Ice.Skate
	-- v0.8.3b: steer toward the brain's goal (Humanoid.MoveDirection can stay zero for
	-- server-driven MoveTo NPCs, which made the skate constraint pin bots in place)
	local want = Vector2.zero
	local brain = (c :: any).BotBrain
	local goal: Vector3? = brain and brain.Goal
	if goal then
		local d = Vector2.new(goal.X - root.Position.X, goal.Z - root.Position.Z)
		if d.Magnitude > 1.5 then
			want = d.Unit
		end
	else
		local md = hum.MoveDirection
		want = Vector2.new(md.X, md.Z)
	end
	local wind = ArenaService.Wind()
	local target = want * hum.WalkSpeed + Vector2.new(wind.X, wind.Z)
	if want.Magnitude > 0.05 then
		local delta = target - c.SkateVel
		local step = (sk.BotPush or sk.Push) * dt
		c.SkateVel = delta.Magnitude <= step and target or (c.SkateVel + delta.Unit * step)
	else
		c.SkateVel = target + (c.SkateVel - target) * math.exp(-sk.Glide * dt)
	end
	s.PlaneVelocity = c.SkateVel
end

function CombatService.Launch(c: Combatant, velocity: Vector3, stun: number)
	if not c.Alive then
		return
	end
	local t = now()
	if c.IcedUntil > t then
		-- a hit shatters the ice: the launch replaces the freeze
		thaw(c)
		c.StunnedUntil = t
		effectRemote:FireAllClients("IceShatter", { Position = c.Root.Position })
	end
	c.StunnedUntil = math.max(c.StunnedUntil, t + stun)
	c.RushingUntil = 0
	stopBlock(c)
	-- v0.7: replicated so every client can play the airborne flail animation
	c.Model:SetAttribute("LaunchedUntil", workspace:GetServerTimeNow() + math.max(stun, 0.6))
	if c.Player then
		knockbackRemote:FireClient(c.Player, velocity, stun)
	else
		local skate = c.Root:FindFirstChild("SkateVelocity") :: LinearVelocity?
		if skate then
			skate.Enabled = false
		end
		c.LaunchToken += 1
		local token = c.LaunchToken
		local hum, root = c.Humanoid, c.Root
		hum.PlatformStand = true
		root.AssemblyLinearVelocity = velocity
		task.delay(stun, function()
			if c.LaunchToken == token and hum.Parent then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end
end

local function applyRushMotion(c: Combatant, dir: Vector3)
	-- Bots only; players dash on their own client for instant response.
	local root = c.Root
	local att = root:FindFirstChild("RootAttachment") :: Attachment?
	if not att then
		return
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "RushVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.MaxAxesForce = Vector3.new(1e5, 0, 1e5)
	lv.VectorVelocity = dir * (C.RushDistance / C.RushTime)
	lv.Parent = root
	if c.InMagma then
		-- v0.8.1: rushing out of a magma pool pops you up and over the rim
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, Config.Maps.Molten.Magma.RushPop, root.AssemblyLinearVelocity.Z)
	end
	task.delay(C.RushTime, function()
		lv:Destroy()
	end)
end

------------------------------------------------------------------------
-- Core hit resolution
------------------------------------------------------------------------
type HitOpts = {
	Fixed: boolean?, -- no rarity/level scaling (Rush)
	Lift: number?, -- pop height in studs, scales with rarity (Big Boot)
	Arc: number?, -- fixed pop height (pulls)
	MaxKB: number?, -- clamp after scaling (Magnet never pulls past you)
	Projectile: boolean?,
}

function CombatService.ApplyHit(attacker: Combatant, target: Combatant, baseKB: number, dir: Vector3, opts: HitOpts?)
	local o: HitOpts = opts or {}
	if not enabled or not target.Alive or not attacker.Alive then
		return
	end
	local t = now()
	if t < target.ProtectedUntil then
		fx("Shielded", { Model = target.Model })
		return
	end
	if o.Projectile and t < target.RushingUntil then
		return
	end

	local def = Weapons.Get(attacker.WeaponId)
	local mult = o.Fixed and 1 or Rarity.Multiplier(def.Rarity, attacker.Level)
	local kb = baseKB * mult

	-- Juggle decay: each OTHER attacker who hit this target in the last 2 s → ×0.8 (min ×0.5)
	local others, seen = 0, {}
	for _, h in target.Hits do
		if t - h.Time <= C.JuggleWindow and h.Attacker ~= attacker and not seen[h.Attacker] then
			seen[h.Attacker] = true
			others += 1
		end
	end
	local decay = math.max(C.JuggleMin, C.JuggleFactor ^ others)
	kb *= decay

	-- PARRY: reflects the attacker's full scaled knockback
	if target.Blocking and target.ParryEligible and t - target.BlockStart <= C.ParryWindow then
		local back = flatUnit(attacker.Root.Position - target.Root.Position, -dir)
		local rkb = math.min(kb, C.KBCap)
		local vel, stun = launchVelocity(back, rkb)
		CombatService.Launch(attacker, vel, math.max(stun, C.ParryStagger))
		recordHit(attacker, target)
		target.ParryEligible = false
		fx("Parry", { Model = target.Model, Position = target.Root.Position })
		-- v0.9.12 quieter Foreman: no PARRY banner (the PARRY! pop-up is enough)
		return
	end

	local height = o.Arc
	if o.Lift then
		height = o.Lift * mult * decay
	end

	if target.Blocking then
		local fullKB, fullHeight = kb, height
		kb *= (1 - C.BlockReduction)
		if height and o.Lift then
			height *= (1 - C.BlockReduction)
		end
		target.Guard -= baseKB * C.GuardDrainPerKB -- BASE kb: rarity can't shatter guards faster
		target.GuardRegenAt = t + C.GuardRegenDelay
		if target.Guard <= 0 then
			target.Guard = 0
			stopBlock(target)
			fx("GuardBreak", { Model = target.Model, Position = target.Root.Position })
			if C.GuardBreakFullKB then
				-- the hit that shatters your shield lands at full strength
				kb, height = fullKB, fullHeight
			end
			kb = math.max(kb, 2)
			local vel, stun = launchVelocity(dir, math.min(kb, C.KBCap), height)
			CombatService.Launch(target, vel, math.max(stun, C.GuardBreakStun))
			recordHit(target, attacker)
			return
		else
			fx("Blocked", { Model = target.Model, Position = target.Root.Position })
		end
	end

	kb = math.min(kb, C.KBCap)
	if o.MaxKB then
		kb = math.min(kb, o.MaxKB)
	end
	local vel, stun = launchVelocity(dir, kb, height)
	CombatService.Launch(target, vel, stun)
	recordHit(target, attacker)
	fx("Hit", {
		Model = target.Model,
		Position = target.Root.Position,
		KB = kb,
		Rarity = o.Fixed and "Common" or def.Rarity,
		Attacker = attacker.Model,
	})
end

------------------------------------------------------------------------
-- Targeting
------------------------------------------------------------------------
type Cand = { C: Combatant, Dist: number, Dir: Vector3 }

local function candidates(attacker: Combatant, range: number, cone: number?): { Cand }
	local list: { Cand } = {}
	local pos = attacker.Root.Position
	local fwd = attacker.Aim
	for _, c in combatants do
		if c ~= attacker and c.Alive then
			local d = c.Root.Position - pos
			if math.abs(d.Y) <= C.MaxVerticalReach then
				local fd = flat(d)
				local dist = fd.Magnitude
				if dist <= range + C.BodyRadius then
					local dir = dist > 1e-3 and fd.Unit or fwd
					local dot = fwd:Dot(dir)
					if cone == nil or dot >= cone or dist < 2.2 then
						table.insert(list, { C = c, Dist = dist, Dir = dir })
					end
				end
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Dist < b.Dist
	end)
	return list
end

------------------------------------------------------------------------
-- Weapon resolution (runs after the windup)
------------------------------------------------------------------------
local function spawnProjectile(c: Combatant, def: Weapons.WeaponDef)
	local p = Instance.new("Part")
	p.Name = "Pellet"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.9, 0.9, 0.9)
	p.Material = Enum.Material.Neon
	p.Color = Rarity.Colors[def.Rarity]
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	local start = c.Root.Position + c.Aim * 2 + Vector3.new(0, 1, 0)
	p.CFrame = CFrame.new(start)
	local trail = Instance.new("Trail")
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 0)
	a1.Parent = p
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.25
	trail.Color = ColorSequence.new(p.Color)
	trail.LightEmission = 1
	trail.Parent = p
	p.Parent = effectsFolder
	table.insert(projectiles, {
		Part = p,
		Pos = start,
		Vel = c.Aim * (def.Speed or 90),
		Owner = c,
		Def = def,
		Traveled = 0,
		Deflected = 0,
	})
end

local function spawnBomb(c: Combatant, def: Weapons.WeaponDef)
	local from = c.Root.Position + Vector3.new(0, 2, 0)
	local dist = def.Range
	if c.ThrowDist then
		dist = math.clamp(c.ThrowDist, 6, def.Range) -- never further than the weapon's reach
	end
	local to = c.Root.Position + c.Aim * dist
	to = Vector3.new(to.X, Config.Arena.Center.Y + 0.8, to.Z)
	local p = Instance.new("Part")
	p.Name = "Bomb"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(1.6, 1.6, 1.6)
	p.Material = Enum.Material.Metal
	p.Color = Color3.fromRGB(25, 25, 30)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CFrame = CFrame.new(from)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 80, 40)
	light.Range = 10
	light.Brightness = 3
	light.Parent = p
	p.Parent = effectsFolder
	table.insert(bombs, { Part = p, From = from, To = to, T0 = now(), Owner = c, Def = def })
	fx("BombThrown", { Position = to, Radius = def.BlastRadius, Fuse = def.Fuse })
end

-- v0.9.18 Magnet REPEL blast: everyone in a cone in front, pushed straight away from you
-- v0.9.18c playtest fix ("when you pull someone they're too close, the repel doesn't work on
-- them"): a pulled rival lands right on top of you (often beside you, still mid-air), where the
-- old cone + height check missed them. Now the repel hits (1) the rival you just pulled, wherever
-- they are within reach + 4 studs, (2) anyone within 5 studs at any angle, (3) anyone in the cone.
-- Close targets are pushed along your aim (forward), not sideways or back through you.
local function resolveRepel(c: Combatant, def: Weapons.WeaponDef)
	if not c.Alive or not enabled then
		return
	end
	local pos = c.Root.Position
	local fwd = c.Aim
	local range = (def.RepelRange or 9) + C.BodyRadius
	local cone = def.RepelCone or 0.3
	local pulled = c.Pulled :: Combatant?
	c.Pulled = nil
	local hits: { { C: Combatant, Dist: number, Dir: Vector3 } } = {}
	for _, o in combatants do
		if o ~= c and o.Alive then
			local d = o.Root.Position - pos
			local fd = flat(d)
			local dist = fd.Magnitude
			local dir = dist > 1e-3 and fd.Unit or fwd
			local isPulled = o == pulled and dist <= range + 4 and math.abs(d.Y) <= 12
			local near = dist <= 5 and math.abs(d.Y) <= C.MaxVerticalReach + 2
			local inCone = dist <= range and math.abs(d.Y) <= C.MaxVerticalReach and fwd:Dot(dir) >= cone
			if isPulled or near or inCone then
				-- blend toward the aim: close rivals fly where you face, far ones straight away
				local blend = math.clamp(1 - dist / range, 0, 1)
				local push = (dir * (1 - blend) + fwd * (blend + 0.35))
				push = flat(push).Magnitude > 1e-3 and flat(push).Unit or fwd
				table.insert(hits, { C = o, Dist = if isPulled then -1 else dist, Dir = push })
			end
		end
	end
	table.sort(hits, function(a, b)
		return a.Dist < b.Dist
	end)
	local n = math.min(#hits, def.RepelMaxTargets or 3)
	for k = 1, n do
		CombatService.ApplyHit(c, hits[k].C, def.RepelKB or def.KB, hits[k].Dir)
	end
	fx("Repel", { Model = c.Model, Position = pos, Dir = fwd, Range = def.RepelRange or 9, Hits = n })
end

local function resolveShove(c: Combatant, def: Weapons.WeaponDef, combo: boolean)
	if not c.Alive or not enabled then
		return
	end
	local kind = def.Kind
	if kind == "melee" then
		local list = candidates(c, def.Range, def.Cone)
		local first = list[1]
		if first then
			local kb = combo and (def.ComboKB or def.KB) or def.KB
			CombatService.ApplyHit(c, first.C, kb, first.Dir, { Lift = def.Lift })
		end
	elseif kind == "arc" then
		local list = candidates(c, def.Range, def.Cone)
		for k = 1, math.min(#list, def.MaxTargets or 3) do
			CombatService.ApplyHit(c, list[k].C, def.KB, list[k].Dir)
		end
	elseif kind == "aoe" then
		local list = candidates(c, def.Range, nil)
		for _, cand in list do
			CombatService.ApplyHit(c, cand.C, def.KB, cand.Dir)
		end
		fx("PanRing", { Position = c.Root.Position, Radius = def.Range, Rarity = def.Rarity })
		c.SlowUntil = now() + (def.SelfSlowTime or 0.6)
	elseif kind == "projectile" then
		spawnProjectile(c, def)
	elseif kind == "pull" then
		local list = candidates(c, def.Range, def.Cone)
		local first = list[1]
		if first then
			-- v0.9.18c: stop ~4.5 studs IN FRONT (was 3: bodies touched and the rival slid aside)
			local maxPull = math.max(0, first.Dist - 4.5)
			c.Pulled = first.C
			CombatService.ApplyHit(c, first.C, def.KB, -first.Dir, { Arc = 2.5, MaxKB = maxPull })
			fx("Tether", { From = c.Model, To = first.C.Model, Color = Rarity.Colors[def.Rarity], Weapon = def.Id, Hold = 0.3 })
		end
	elseif kind == "thrown" then
		spawnBomb(c, def)
	elseif kind == "slam" then
		-- v0.9.20 Squeaky Hammer: smash a spot in front; everyone near it pops up and away (mostly
		-- forward), and the tile under the impact starts cracking
		local pos = c.Root.Position
		local center = pos + c.Aim * (def.SlamOffset or 4.5)
		local rad = (def.SlamRadius or 4.5) + C.BodyRadius
		local hits: { { C: Combatant, Dist: number, Dir: Vector3 } } = {}
		for _, o in combatants do
			if o ~= c and o.Alive then
				local d = o.Root.Position - center
				local fd = flat(d)
				local dist = fd.Magnitude
				if dist <= rad and math.abs(o.Root.Position.Y - pos.Y) <= C.MaxVerticalReach then
					local away = if dist > 0.5 then fd.Unit else c.Aim
					local push = flat(away + c.Aim * 0.8)
					table.insert(hits, { C = o, Dist = dist, Dir = if push.Magnitude > 1e-3 then push.Unit else c.Aim })
				end
			end
		end
		table.sort(hits, function(a, b)
			return a.Dist < b.Dist
		end)
		for k = 1, math.min(#hits, def.MaxTargets or 4) do
			CombatService.ApplyHit(c, hits[k].C, def.KB, hits[k].Dir, { Lift = def.Lift })
		end
		local cracked = def.CrackTile == true and ArenaService.CrackAt(center)
		fx("Slam", { Position = center - Vector3.new(0, 2.85, 0), Radius = def.SlamRadius or 4.5, Rarity = def.Rarity, Cracked = cracked, Hits = #hits })
	elseif kind == "tether" then
		local list = candidates(c, def.Range, def.Cone)
		local first = list[1]
		if first then
			local target = first.C
			local t = now()
			if t < target.ProtectedUntil then
				fx("Shielded", { Model = target.Model })
				return
			end
			local A = c.Root.Position
			local T = target.Root.Position
			fx("Tether", { From = c.Model, To = target.Model, Color = Rarity.Colors[def.Rarity], Weapon = def.Id, Hold = def.SlamDelay or 0.4 })

			if target.Blocking and target.ParryEligible and t - target.BlockStart <= C.ParryWindow then
				-- parried: YOU get yanked all the way to them
				local d = flat(T - A)
				local vel, stun = launchVelocity(flatUnit(d, c.Aim), d.Magnitude, 3)
				CombatService.Launch(c, vel, math.max(stun, C.ParryStagger))
				recordHit(c, target)
				target.ParryEligible = false
				fx("Parry", { Model = target.Model, Position = T })
				-- v0.9.12 quieter Foreman: no PARRY banner (the PARRY! pop-up is enough)
				return
			end

			-- v0.7.1 YANK: pull the target to ~4 studs in front of you (a block holds them in place)
			local toMe = flat(A - T)
			local pull = math.max(0, toMe.Magnitude - 4)
			if target.Blocking then
				pull *= (1 - C.BlockReduction)
			end
			if pull > 0.5 then
				local v1, s1 = launchVelocity(flatUnit(toMe, -first.Dir), math.min(pull, C.KBCap), 3)
				CombatService.Launch(target, v1, s1)
				recordHit(target, c)
			end
			-- ...then LAUNCH along your aim with full Mythic power (normal hit rules: block, parry, guard)
			task.delay(def.SlamDelay or 0.4, function()
				if not enabled or not c.Alive or not target.Alive then
					return
				end
				CombatService.ApplyHit(c, target, def.KB, flatUnit(c.Aim, first.Dir))
			end)
		end
	end
end

------------------------------------------------------------------------
-- Requests (players via remote, bots directly)
------------------------------------------------------------------------
-- v0.7.5 lag compensation: the client stamps each Shove with its (server-synced) click time, so the
-- strike resolves at click + windup instead of arrival + windup. Capped at 0.2 s so it can't be abused.
local MAX_LAG_COMP = 0.2
local function strikeDelay(windup: number, clickTime: number?, t: number): number
	if type(clickTime) ~= "number" or clickTime ~= clickTime then
		return windup
	end
	local lag = math.clamp(t - clickTime, 0, MAX_LAG_COMP)
	return math.max(0.02, windup - lag)
end
CombatService.StrikeDelay = strikeDelay

function CombatService.Request(c: Combatant, action: string, aim: Vector3?, clickTime: number?)
	if not enabled or not c.Alive then
		return
	end
	local t = now()
	if aim and isFiniteVector(aim) then
		c.Aim = flatUnit(aim, c.Aim)
		-- v0.9.3: a long aim vector = "throw this far" (bombs land on the assist target); unit = full reach
		local len = Vector3.new(aim.X, 0, aim.Z).Magnitude
		c.ThrowDist = if len > 1.5 then len else nil
	end

	if action == "BlockEnd" then
		stopBlock(c)
		return
	end
	if t < c.StunnedUntil then
		return
	end

	if action == "Shove" then
		if t < c.ShoveReadyAt then
			return
		end
		local def = Weapons.Get(c.WeaponId)
		local step, readyAt = Weapons.FollowUp(def, c.Follow, t)
		if not step then
			return
		end
		c.ShoveReadyAt = readyAt
		stopBlock(c)
		endProtection(c)
		if step == "repel" then
			-- v0.9.18 Magnet REPEL: the blue pole's blast (short windup, cone push, several targets)
			c.SwingStart = t
			c.SwingWeapon = def.Id
			if c.IsBot then
				local pos = c.Root.Position
				c.Root.CFrame = CFrame.lookAt(pos, pos + c.Aim)
			end
			local w = def.RepelWindup or 0.1
			local delay = c.IsBot and w or strikeDelay(w, clickTime, t)
			c.Model:SetAttribute("RepelUntil", nil)
			fx("Swing", { Model = c.Model, Weapon = def.Id, Combo = true, Windup = delay })
			for _, fn in swingListeners do
				task.spawn(fn, c, def, c.Aim)
			end
			task.delay(delay, resolveRepel, c, def)
			return
		end
		if def.RepelKB then
			c.Model:SetAttribute("RepelUntil", c.Follow.RepelUntil)
		end

		local combo = false
		if def.ComboHits then
			if t - c.ComboStart > (def.ComboWindow or 1.5) then
				c.ComboStart = t
				c.ComboCount = 1
			else
				c.ComboCount += 1
			end
			if c.ComboCount >= def.ComboHits then
				combo = true
				c.ComboCount = 0
				c.ComboStart = -10
			end
		end

		c.SwingStart = t
		c.SwingWeapon = def.Id
		if c.IsBot then
			local pos = c.Root.Position
			c.Root.CFrame = CFrame.lookAt(pos, pos + c.Aim)
		end
		local delay = c.IsBot and def.Windup or strikeDelay(def.Windup, clickTime, t)
		fx("Swing", { Model = c.Model, Weapon = def.Id, Combo = combo, Windup = delay })
		for _, fn in swingListeners do
			task.spawn(fn, c, def, c.Aim)
		end
		task.delay(delay, resolveShove, c, def, combo)
	elseif action == "Rush" then
		if t < c.RushReadyAt then
			return
		end
		c.RushReadyAt = t + C.RushCooldown
		c.RushingUntil = t + C.RushTime + 0.05
		c.RushDir = c.Aim
		c.RushHit = {}
		stopBlock(c)
		endProtection(c)
		if c.IsBot then
			applyRushMotion(c, c.Aim)
		end
		c.Model:SetAttribute("RushUntil", t + C.RushTime + 0.12) -- v0.9.2 dash pose for everyone
		fx("Rush", { Model = c.Model })
	elseif action == "BlockStart" then
		if c.Guard < C.MinBlockGuard or c.Blocking then
			return
		end
		c.Blocking = true
		c.ParryEligible = (t - c.LastBlockStart) >= C.ParrySpamLockout
		c.LastBlockStart = t
		c.BlockStart = t
		c.Model:SetAttribute("Blocking", true)
	end
end

-- Bots can pre-decide whether a block will be a parry (their Parry chance roll)
function CombatService.BotBlock(c: Combatant, canParry: boolean, duration: number)
	if not enabled or not c.Alive or now() < c.StunnedUntil or c.Guard < C.MinBlockGuard then
		return
	end
	CombatService.Request(c, "BlockStart")
	c.ParryEligible = canParry
	task.delay(duration, function()
		if c.Blocking then
			stopBlock(c)
		end
	end)
end

------------------------------------------------------------------------
-- Per-frame step
------------------------------------------------------------------------
local function removeAt<T>(list: { T }, k: number)
	list[k] = list[#list]
	list[#list] = nil
end

function CombatService.Step(dt: number)
	local t = now()

	for _, c in combatants do
		if c.Alive then
			-- guard regen
			if c.Blocking then
				-- holding the shield slowly drains it, so nobody can turtle forever
				c.Guard -= C.GuardDrainHeld * dt
				if c.Guard <= 0 then
					c.Guard = 0
					stopBlock(c)
				end
			elseif t >= c.GuardRegenAt and c.Guard < C.GuardMax then
				c.Guard = math.min(C.GuardMax, c.Guard + C.GuardRegen * dt)
			end
			local g = math.floor(c.Guard)
			if g ~= c.LastGuardAttr then
				c.LastGuardAttr = g
				c.Model:SetAttribute("Guard", g)
			end

			-- v0.8.1 hazards
			if c.IcedUntil > 0 and t >= c.IcedUntil then
				thaw(c)
			end
			local inMagma = ArenaService.InMagma(c.Root.Position)
			if inMagma ~= c.InMagma then
				c.InMagma = inMagma
				c.Model:SetAttribute("InMagma", inMagma)
			end

			-- walk speed
			local speed = c.Blocking and Config.Movement.BlockWalkSpeed or Config.Movement.WalkSpeed
			if t < c.SlowUntil then
				speed *= 0.7
			end
			if c.InMagma then
				speed *= Config.Maps.Molten.Magma.SlowMul
			end
			local noJump = c.Frozen or c.IcedUntil > t or c.InMagma
			-- v0.8.5 fast ice: skating on the Ice Rink is 45% faster than running
			if enabled and ArenaService.CurrentMap() == "Ice" and not c.InMagma and math.abs(c.Root.Position.Y - Config.Arena.Center.Y) < 12 then
				speed *= Config.Maps.Ice.Skate.SpeedMul
			end
			if c.Frozen or c.IcedUntil > t then
				speed = 0
			end
			if c.Humanoid.WalkSpeed ~= speed then
				c.Humanoid.WalkSpeed = speed
			end
			if not c.Player then
				stepBotSkate(c, dt)
			end
			if c.LastFrozen ~= noJump then
				c.LastFrozen = noJump
				c.Humanoid.UseJumpPower = true
				c.Humanoid.JumpPower = noJump and 0 or Config.Movement.JumpPower
			end

			-- protection timeout
			if c.ProtectedUntil > 0 and t >= c.ProtectedUntil then
				endProtection(c)
			end

			-- rush contact
			if t < c.RushingUntil then
				for _, o in combatants do
					if o ~= c and o.Alive and not c.RushHit[o] then
						local d = o.Root.Position - c.Root.Position
						if flat(d).Magnitude <= C.RushHitRadius and math.abs(d.Y) < 5 then
							c.RushHit[o] = true
							CombatService.ApplyHit(c, o, C.RushKB, c.RushDir, { Fixed = true })
							local vel, stun = launchVelocity(-c.RushDir, C.RushKB * C.RushRecoil)
							CombatService.Launch(c, vel, stun)
							c.RushingUntil = 0
							break
						end
					end
				end
			end
		end
	end

	-- projectiles
	for k = #projectiles, 1, -1 do
		local pr = projectiles[k]
		local step = pr.Vel * dt
		local newPos = pr.Pos + step
		pr.Traveled += step.Magnitude
		local hitSomething = false
		for _, o in combatants do
			if o ~= pr.Owner and o.Alive then
				local dist = (o.Root.Position - newPos).Magnitude
				local distMid = (o.Root.Position - (pr.Pos + step * 0.5)).Magnitude
				if math.min(dist, distMid) <= (pr.Def.HitRadius or 2.4) then
					-- Bat deflect: a target mid-swing with a Bat sends it back
					if o.SwingWeapon == "Bat" and t - o.SwingStart <= 0.5 and pr.Deflected < 3 then
						pr.Owner = o
						pr.Vel = o.Aim * pr.Vel.Magnitude
						pr.Traveled = 0
						pr.Deflected += 1
						fx("Deflect", { Position = newPos })
					else
						CombatService.ApplyHit(pr.Owner, o, pr.Def.KB, flatUnit(pr.Vel, o.Aim), { Projectile = true })
						hitSomething = true
					end
					break
				end
			end
		end
		pr.Pos = newPos
		if hitSomething or pr.Traveled > pr.Def.Range or newPos.Y < Config.Arena.KillY then
			pr.Part:Destroy()
			removeAt(projectiles, k)
		else
			pr.Part.CFrame = CFrame.new(newPos)
		end
	end

	-- bombs
	for k = #bombs, 1, -1 do
		local b = bombs[k]
		local age = t - b.T0
		local landTime = 0.5
		if age < landTime then
			local a = age / landTime
			local pos = b.From:Lerp(b.To, a) + Vector3.new(0, math.sin(a * math.pi) * 9, 0)
			b.Part.CFrame = CFrame.new(pos)
		else
			b.Part.CFrame = CFrame.new(b.To)
			local blink = math.floor(age * 10) % 2 == 0
			b.Part.Color = blink and Color3.fromRGB(255, 60, 40) or Color3.fromRGB(25, 25, 30)
		end
		if age >= (b.Def.Fuse or 1.2) then
			local radius = b.Def.BlastRadius or 7
			for _, o in combatants do
				if o ~= b.Owner and o.Alive then
					local d = o.Root.Position - b.To
					if flat(d).Magnitude <= radius + C.BodyRadius and math.abs(d.Y) < 8 then
						CombatService.ApplyHit(b.Owner, o, b.Def.KB, flatUnit(d, Vector3.new(1, 0, 0)))
					end
				end
			end
			ArenaService.ForceFallWarnedInRadius(b.To, radius)
			fx("Explosion", { Position = b.To, Radius = radius })
			b.Part:Destroy()
			removeAt(bombs, k)
		end
	end
end

function CombatService.ClearProjectiles()
	for _, pr in projectiles do
		pr.Part:Destroy()
	end
	for _, b in bombs do
		b.Part:Destroy()
	end
	table.clear(projectiles)
	table.clear(bombs)
end

function CombatService.ResetCooldowns(c: Combatant)
	c.ShoveReadyAt = 0
	c.Follow = Weapons.NewFollow()
	c.RushReadyAt = 0
	c.Guard = C.GuardMax
	c.StunnedUntil = 0
	c.Blocking = false
	c.Hits = {}
end

------------------------------------------------------------------------
-- Init
------------------------------------------------------------------------
local VALID_ACTIONS = { Shove = true, Rush = true, BlockStart = true, BlockEnd = true }
local rate: { [Player]: { count: number, window: number } } = {}

function CombatService.Init()
	effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "Effects"
	effectsFolder.Parent = workspace

	actionRemote.OnServerEvent:Connect(function(player: Player, action: any, aim: any, clickTime: any)
		if type(action) ~= "string" or not VALID_ACTIONS[action] then
			return
		end
		-- simple rate limit: 25 actions / second
		local r = rate[player]
		local t = os.clock()
		if not r or t - r.window > 1 then
			r = { count = 0, window = t }
			rate[player] = r
		end
		r.count += 1
		if r.count > 25 then
			return
		end
		local c = CombatService.Get(player.Character)
		if not c then
			return
		end
		local aimVec = typeof(aim) == "Vector3" and aim or nil
		CombatService.Request(c, action, aimVec, if type(clickTime) == "number" then clickTime else nil)
	end)

	Players.PlayerRemoving:Connect(function(p)
		rate[p] = nil
	end)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — DataService
	Loads/saves player profiles with DataStoreService (UpdateAsync + retries).
	If DataStores are unavailable (e.g. Studio without API access), the game still runs
	with a temporary profile and simply doesn't save.

	Enable saving in Studio: Game Settings → Security → "Enable Studio Access to API Services".
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local Retention = require(Shared.Retention)

local STORE_NAME = "CrumbleProfiles_v1"
local AUTOSAVE = 120

export type Profile = {
	Version: number,
	Coins: number,
	XP: number,
	Level: number,
	Spins: number,
	Wins: number,
	LeaderboardWins: number,
	KOs: number,
	Rounds: number,
	FirstWinDay: number,
	Equipped: string,
	Weapons: { [string]: { Level: number, Copies: number } },
	-- v2 (v0.6 Power)
	Wildcards: { [string]: number },
	Pity: { Epic: number, Legendary: number, Mythic: number },
	TotalSpins: number,
	CoinSpinAt: number, -- v0.9.23: unix time the next hourly COIN SPIN is ready (0 = ready now)
	SkipDay: number, -- v0.9.22: day index of the SKIP TIMER counter
	SkipsToday: number,
	AutoMerge: boolean, -- v0.9.22: AUTO MERGE pass setting (merge new copies after spins)
	DevPasses: { [string]: boolean }, -- v0.9.22: game passes SIMULATED in DevMode (real ones come from Roblox)
	Quests: { [string]: boolean },
	-- v3 (v0.9 Retention)
	Tutorial: number, -- tutorial step; Config.Tutorial.Done (100) = finished / skipped
	Daily: { [string]: any },
	Weekly: { [string]: any },
	Season: { [string]: any },
	BoostUntil: number, -- 2x Coins active until this unix time
	Receipts: { [string]: number }, -- PurchaseId → unix time (receipt replay protection)
	Badges: { [string]: boolean },
}

local DataService = {}

local profiles: { [Player]: Profile } = {}
local canSave: { [Player]: boolean } = {}
local store: DataStore? = nil
local devOverride: { [Player]: { Id: string, Level: number } } = {}

local profileRemote = Net.Get("Profile")
local toastRemote = Net.Get("Toast")

local function defaultProfile(): Profile
	return {
		Version = 2,
		Coins = 0,
		XP = 0,
		Level = 1,
		Spins = 0,
		Wins = 0,
		LeaderboardWins = 0,
		KOs = 0,
		Rounds = 0,
		FirstWinDay = 0,
		Equipped = "Boot",
		Weapons = { Boot = { Level = 1, Copies = 0 } },
		Wildcards = { Common = 0, Uncommon = 0, Rare = 0, Epic = 0, Legendary = 0, Mythic = 0 },
		Pity = { Epic = 0, Legendary = 0, Mythic = 0 },
		TotalSpins = 0,
		CoinSpinAt = 0,
		SkipDay = 0,
		SkipsToday = 0,
		AutoMerge = true,
		DevPasses = {},
		Quests = {},
		Tutorial = 0,
		Daily = {},
		Weekly = {},
		Season = {},
		BoostUntil = 0,
		Receipts = {},
		Badges = {},
	}
end

local function reconcile(data: any): Profile
	local base = defaultProfile()
	if type(data) ~= "table" then
		return base
	end
	-- v0.9: players who already played before the tutorial existed skip it
	if data.Tutorial == nil and (tonumber(data.Rounds) or 0) > 0 then
		data.Tutorial = Config.Tutorial.Done
	end
	for k, v in base :: any do
		if data[k] == nil then
			data[k] = v
		end
	end
	if type(data.Weapons) ~= "table" then
		data.Weapons = base.Weapons
	end
	if not data.Weapons.Boot then
		data.Weapons.Boot = { Level = 1, Copies = 0 }
	end
	-- drop unknown weapon ids, sanitize numbers
	for id, w in data.Weapons do
		if not Weapons.ById[id] or type(w) ~= "table" then
			data.Weapons[id] = nil
		else
			w.Level = math.clamp(math.floor(tonumber(w.Level) or 1), 1, Rarity.MaxLevel)
			w.Copies = math.max(0, math.floor(tonumber(w.Copies) or 0))
		end
	end
	for _, r in Rarity.Order do
		data.Wildcards[r] = math.max(0, math.floor(tonumber(data.Wildcards[r]) or 0))
	end
	data.CoinSpinAt = math.max(0, math.floor(tonumber(data.CoinSpinAt) or 0))
	-- v0.9.23: the free spin timer and the weekly coin spin counter are gone
	data.FreeSpinAt, data.CoinSpinWeek, data.CoinSpinsUsed = nil, nil, nil
	data.SkipDay = math.floor(tonumber(data.SkipDay) or 0)
	data.SkipsToday = math.max(0, math.floor(tonumber(data.SkipsToday) or 0))
	data.AutoMerge = data.AutoMerge ~= false
	if type(data.DevPasses) ~= "table" then
		data.DevPasses = {}
	end
	for k in base.Pity :: any do
		data.Pity[k] = math.max(0, math.floor(tonumber(data.Pity[k]) or 0))
	end
	if type(data.Quests) ~= "table" then
		data.Quests = {}
	end
	for _, k in { "Daily", "Weekly", "Season", "Receipts", "Badges" } do
		if type(data[k]) ~= "table" then
			data[k] = {}
		end
	end
	data.Tutorial = math.clamp(math.floor(tonumber(data.Tutorial) or 0), 0, Config.Tutorial.Done)
	data.BoostUntil = tonumber(data.BoostUntil) or 0
	if not data.Weapons[data.Equipped] then
		data.Equipped = "Boot"
	end
	data.Version = 3
	return data :: Profile
end

local function withRetries<T>(fn: () -> T, tries: number): (boolean, T?)
	for attempt = 1, tries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(("[CRUMBLE] DataStore attempt %d failed: %s"):format(attempt, tostring(result)))
		task.wait(1.5 * attempt)
	end
	return false, nil
end

local function key(player: Player): string
	return "p_" .. player.UserId
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

-- Weapon + level the player brings into a round.
function DataService.GetLoadout(player: Player): (string, number)
	local dev = Config.DevMode and devOverride[player]
	if dev then
		return dev.Id, dev.Level
	end
	local p = profiles[player]
	if not p then
		return "Boot", 1
	end
	local id = Weapons.Get(p.Equipped).Id
	local owned = p.Weapons[id]
	if not owned then
		return "Boot", (p.Weapons.Boot and p.Weapons.Boot.Level) or 1
	end
	return id, owned.Level
end

local function updateLeaderstats(player: Player, p: Profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local coins = ls:FindFirstChild("Coins") :: IntValue?
	local level = ls:FindFirstChild("Level") :: IntValue?
	local wins = ls:FindFirstChild("Wins") :: IntValue?
	if coins then
		coins.Value = p.Coins
	end
	if level then
		level.Value = p.Level
	end
	if wins then
		wins.Value = p.Wins
	end
end

function DataService.Push(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	updateLeaderstats(player, p)
	player:SetAttribute("AccountLevel", p.Level)
	profileRemote:FireClient(player, {
		Coins = p.Coins,
		XP = p.XP,
		Level = p.Level,
		XPNeeded = Config.XPForLevel(p.Level),
		Spins = p.Spins,
		Wins = p.Wins,
		LeaderboardWins = p.LeaderboardWins or 0, -- v1.0 patch: the Leaders tab showed 0 without it
		KOs = p.KOs,
		Rounds = p.Rounds, -- v1.0: the one-time favorite prompt waits for a few matches
		Equipped = p.Equipped,
		Weapons = p.Weapons,
		Wildcards = p.Wildcards,
		Pity = p.Pity,
		TotalSpins = p.TotalSpins,
		CoinSpinIn = math.max(0, p.CoinSpinAt - os.time()), -- seconds (client clocks can be off)
		SkipsLeft = DataService.SkipsLeft(p),
		AutoMerge = p.AutoMerge,
		Quests = p.Quests,
		Tutorial = p.Tutorial,
		Daily = p.Daily,
		Weekly = p.Weekly,
		Season = p.Season,
		SeasonUnclaimed = Retention.UnclaimedSeason(p),
		BoostLeft = math.max(0, p.BoostUntil - os.time()),
		Badges = p.Badges,
		Saving = canSave[player] == true,
		DevWeapon = devOverride[player] and devOverride[player].Id or nil,
		DevLevel = devOverride[player] and devOverride[player].Level or nil,
	})
end

-- v0.9: daily / weekly / season roll-over before anything reads them
function DataService.EnsureRetention(player: Player): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	return Retention.Ensure(p, player.UserId, os.time())
end

function DataService.CanSave(player: Player): boolean
	return canSave[player] == true
end

-- v0.9.22 game passes: ShopService sets the "Pass_<Key>" attribute (Roblox ownership or a DevMode
-- simulation); everything else asks here
function DataService.HasPass(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

function DataService.CoinSpinEvery(player: Player): number
	return if DataService.HasPass(player, "FastSpins") then Config.Spins.CoinSpinFastEvery else Config.Spins.CoinSpinEvery
end

function DataService.SkipsLeft(p: Profile): number
	if p.SkipDay ~= math.floor(os.time() / 86400) then
		return Config.Spins.SkipsPerDay
	end
	return math.max(0, Config.Spins.SkipsPerDay - p.SkipsToday)
end

function DataService.ClearDevOverride(player: Player)
	devOverride[player] = nil
end

function DataService.HasDevOverride(player: Player): boolean
	return devOverride[player] ~= nil
end

-- Save a few seconds after something valuable changed (spins, merges), coalescing bursts.
local saveQueued: { [Player]: boolean } = {}
function DataService.SaveSoon(player: Player)
	if saveQueued[player] then
		return
	end
	saveQueued[player] = true
	task.delay(6, function()
		saveQueued[player] = nil
		if player.Parent and profiles[player] then
			DataService.Save(player)
		end
	end)
end

function DataService.AddCoins(player: Player, amount: number)
	local p = profiles[player]
	if p then
		p.Coins = math.max(0, p.Coins + math.floor(amount))
	end
end

-- Returns number of levels gained
function DataService.AddXP(player: Player, amount: number): number
	local p = profiles[player]
	if not p then
		return 0
	end
	p.XP += math.floor(amount)
	local gained = 0
	while p.Level < Config.MaxLevel and p.XP >= Config.XPForLevel(p.Level) do
		p.XP -= Config.XPForLevel(p.Level)
		p.Level += 1
		gained += 1
		if p.Level % Config.MilestoneSpinEvery == 0 or table.find(Config.EarlySpinLevels, p.Level) ~= nil then
			p.Spins += 1
			toastRemote:FireClient(player, ("LEVEL %d! Milestone reward: +1 SPIN"):format(p.Level))
		else
			toastRemote:FireClient(player, ("LEVEL UP! You are now level %d"):format(p.Level))
		end
	end
	return gained
end

function DataService.SetEquipped(player: Player, weaponId: string, level: number?)
	local p = profiles[player]
	if not p then
		return
	end
	local def = Weapons.Get(weaponId)
	p.Equipped = def.Id
	if level then
		p.Weapons[def.Id] = p.Weapons[def.Id] or { Level = 1, Copies = 0 }
		p.Weapons[def.Id].Level = math.clamp(math.floor(level), 1, 10)
	end
end

-- v1.0 patch 7: saves + the leaderboard posts that follow them are COUNTED, and the server waits for
-- them when it shuts down. (A visitor alone in a server who left used to lose the leaderboard post:
-- the server closed the moment they left, before the post finished.)
local inflight = 0
-- v1.0 patch 9: Roblox allows ONE write per player key every 6 s; faster writes get queued (the
-- "DataStore request was added to queue" warning). Saves for the same player now wait their turn.
local saving: { [Player]: boolean } = {}
local lastSaveAt: { [Player]: number } = {}

function DataService.Save(player: Player): boolean
	local p = profiles[player]
	if not p or not canSave[player] or not store then
		return false
	end
	local s = store :: DataStore
	inflight += 1
	while saving[player] do
		task.wait(0.25)
	end
	saving[player] = true
	local gap = (lastSaveAt[player] or -1e9) + 6.5 - os.clock()
	if gap > 0 then
		task.wait(gap)
	end
	local ok = withRetries(function()
		s:UpdateAsync(key(player), function()
			return p
		end)
		return true
	end, 3)
	lastSaveAt[player] = os.clock()
	saving[player] = nil
	local onSaved = DataService.OnSaved
	if ok and onSaved then
		inflight += 1
		task.spawn(function()
			local okPost, err = pcall(onSaved, player, p)
			if not okPost then
				warn("[CRUMBLE] after-save hook failed:", err)
			end
			inflight -= 1
		end)
	end
	inflight -= 1
	return ok
end

local function onJoin(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, n in { "Coins", "Level", "Wins" } do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end
	ls.Parent = player

	local profile: Profile = defaultProfile()
	local saving = false
	if store then
		local s = store :: DataStore
		local ok, data = withRetries(function()
			return s:GetAsync(key(player))
		end, 3)
		if ok then
			profile = reconcile(data)
			saving = true
		else
			toastRemote:FireClient(player, "Couldn't load your save. Progress this session won't be saved.")
		end
	end
	if not player.Parent then
		return
	end
	profiles[player] = profile
	canSave[player] = saving
	Retention.Ensure(profile, player.UserId, os.time())
	DataService.Push(player)
	if DataService.OnLoaded then
		task.spawn(DataService.OnLoaded, player, profile)
	end
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[CRUMBLE] DataStores unavailable — running without saving:", result)
	end

	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
		canSave[player] = nil
		lastSaveAt[player] = nil
		devOverride[player] = nil
	end)

	game:BindToClose(function()
		local threads = 0
		for player in profiles do
			threads += 1
			task.spawn(function()
				DataService.Save(player)
				threads -= 1
			end)
		end
		local start = os.clock()
		task.wait(0.5) -- (lets a just-started leave save / leaderboard post register itself)
		while (threads > 0 or inflight > 0) and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	-- DEV: test any weapon at any level (v0.6 replaces this with spins + merging)
	Net.Get("DevLoadout").OnServerEvent:Connect(function(player: Player, weaponId: any, level: any)
		if not Config.DevMode then
			return
		end
		if type(weaponId) ~= "string" or not Weapons.ById[weaponId] then
			return
		end
		local lvl = type(level) == "number" and math.clamp(math.floor(level), 1, 10) or 1
		-- test loadouts are session-only: never written into the saved profile
		devOverride[player] = { Id = weaponId, Level = lvl }
		DataService.Push(player)
		if DataService.OnLoadoutChanged then
			DataService.OnLoadoutChanged(player)
		end
	end)
end

DataService.OnLoadoutChanged = nil :: ((Player) -> ())?
DataService.OnSaved = nil :: ((Player, Profile) -> ())? -- v0.9 leaderboards post after a save
DataService.OnLoaded = nil :: ((Player, Profile) -> ())? -- v0.9 shop policy check, tutorial
DataService.OnRoundResult = nil :: ((Player, { [string]: any }) -> ())?

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">FeedbackService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — FeedbackService (v1.0 patch)
	Players send short feedback from the FEEDBACK tile in the lobby dock.
	* Text goes through Roblox's text filter (TextService) before it is stored.
	* Rate limit: one message a minute, 5 per player per server.
	* Stored in the DataStore "Feedback":
	    - one key per message  "fb_<time>_<userId>"  (readable in Creator Hub > Data Stores Manager)
	    - key "inbox" = the newest 200 messages (the in-game owner INBOX reads this one key)
	* Only the game's owner (or Studio) can open the INBOX.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Services = script.Parent
local ProgressionService = require(Services.ProgressionService)

local FeedbackService = {}

local TAGS = { BUG = true, IDEA = true, HARD = true, LOVE = true }
local MIN_LEN, MAX_LEN = 4, 300
local GAP = 60 -- seconds between messages
local PER_SERVER = 5
local INBOX_KEEP = 200

local store: DataStore? = nil
local lastSent: { [Player]: number } = {}
local sentCount: { [Player]: number } = {}

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore("Feedback")
	end)
	if ok then
		store = s
	end
	return store
end

local function isOwner(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return (player :: any):GetRankInGroupAsync(game.CreatorId)
	end)
	return ok and rank == 255
end

local function filter(text: string, userId: number): string?
	local ok, out = pcall(function()
		local result = TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(out) == "string" then
		return out
	end
	return nil
end

-- the client sends "TAG:device" (device = phone / tablet / pc / console), e.g. "BUG:phone"
local DEVICES = { phone = true, tablet = true, pc = true, console = true }
local function parseTag(raw: any): (string, string)
	if type(raw) ~= "string" then
		return "IDEA", "?"
	end
	local tag, dev = string.match(raw, "^(%u+):(%l+)$")
	tag = tag or raw
	return (if TAGS[tag] then tag else "IDEA"), (if dev and DEVICES[dev] then dev else "?")
end

FeedbackService.IsOwner = isOwner -- (used by VisitorService)

function FeedbackService.Init()
	Players.PlayerAdded:Connect(function(p)
		p:SetAttribute("IsOwner", isOwner(p))
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(function()
			p:SetAttribute("IsOwner", isOwner(p))
		end)
	end
	Players.PlayerRemoving:Connect(function(p)
		lastSent[p] = nil
		sentCount[p] = nil
	end)

	ProgressionService.RegisterAction("Feedback", function(player, p, tag, text)
		if type(text) ~= "string" then
			return { Ok = false, Msg = "Write something first." }
		end
		text = string.gsub(text, "^%s+", "")
		text = string.gsub(text, "%s+$", "")
		text = string.gsub(text, "[%c]", " ")
		if utf8.len(text) == nil then
			return { Ok = false, Msg = "That text can't be sent." }
		end
		if #text < MIN_LEN then
			return { Ok = false, Msg = "Write a little more first." }
		end
		if #text > MAX_LEN then
			text = string.sub(text, 1, MAX_LEN)
		end
		local t = os.clock()
		if lastSent[player] and t - lastSent[player] < GAP then
			return { Ok = false, Msg = string.format("Thanks! You can send again in %ds.", math.ceil(GAP - (t - lastSent[player]))) }
		end
		if (sentCount[player] or 0) >= PER_SERVER then
			return { Ok = false, Msg = "Thanks! That's the limit for this server." }
		end
		local clean = filter(text, player.UserId)
		if not clean then
			return { Ok = false, Msg = "Couldn't send right now. Try again in a bit." }
		end
		local ds = getStore()
		if not ds then
			return { Ok = false, Msg = "Feedback is offline right now. Try again later." }
		end
		lastSent[player] = t
		sentCount[player] = (sentCount[player] or 0) + 1
		local tagName, dev = parseTag(tag)
		local entry = {
			At = os.time(),
			UserId = player.UserId,
			Name = player.Name,
			Tag = tagName,
			Text = clean,
			Version = Config.Version,
			Device = dev,
			Level = p.Level or 1,
			Wins = p.Wins or 0,
		}
		local ok = pcall(function()
			(ds :: DataStore):SetAsync(string.format("fb_%d_%d", entry.At, player.UserId), entry)
		end)
		pcall(function()
			(ds :: DataStore):UpdateAsync("inbox", function(old: any)
				local list = type(old) == "table" and old or {}
				table.insert(list, 1, entry)
				while #list > INBOX_KEEP do
					table.remove(list)
				end
				return list
			end)
		end)
		if not ok then
			return { Ok = false, Msg = "Couldn't save it. Try again later." }
		end
		return { Ok = true, Silent = true }
	end, true)

	ProgressionService.RegisterAction("FeedbackInbox", function(player, _p)
		if not isOwner(player) then
			return { Ok = false, Msg = "Only the game owner can read feedback." }
		end
		local ds = getStore()
		if not ds then
			return { Ok = false, Msg = "Feedback store is offline." }
		end
		local ok, list = pcall(function()
			return (ds :: DataStore):GetAsync("inbox")
		end)
		if not ok then
			return { Ok = false, Msg = "Couldn't load the inbox (Studio needs API access ON)." }
		end
		return { Ok = true, Silent = true, List = type(list) == "table" and list or {} }
	end, true)
end

return FeedbackService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — LeaderboardService (v0.9 Retention)
	Global top-10 lists (OrderedDataStores) for WINS (4+ human lobbies only), SHOVERS (players
	knocked off, bots never count) and LEVEL. Scores are posted after a profile save (throttled)
	and the lists are re-fetched every Config.Leaderboards.Refresh seconds.

	Shown on three HALL OF FAME boards at the back of the Yard and in the LEADERS window
	(ReplicatedStorage.LeaderboardData = JSON). If DataStores aren't available (Studio without
	API access) the boards fall back to THIS SERVER's players, labelled as such.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Art = require(Shared.Art)
local Icons = require(Shared.Icons)

local DataService = require(script.Parent.DataService)

local LB = Config.Leaderboards

local LeaderboardService = {}

type Row = { Name: string, Value: number, UserId: number }
type Board = { Source: string, Rows: { Row } }

local stores: { [string]: OrderedDataStore } = {}
local lastPosted: { [number]: { [string]: number } } = {}
local lastPostAt: { [number]: number } = {}
local names: { [number]: string } = {}
local data: { [string]: Board } = {}
local value: StringValue
local gone: { [Player]: boolean } = {} -- left (or the server is closing): post now, no throttle
local closing = false
local boardGuis: { [string]: { Rows: { TextLabel }, Source: TextLabel } } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local pl = Players:GetPlayerByUserId(userId)
	if pl then
		names[userId] = pl.DisplayName
		return pl.DisplayName
	end
	local ok, n = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = (ok and type(n) == "string") and n or ("Player " .. userId)
	names[userId] = name
	return name
end

local function statOf(p: any, stat: string): number
	return math.max(0, math.floor(tonumber(p[stat]) or 0))
end

-- post a player's scores (after a save; throttled unless they're leaving)
local function post(player: Player, p: any)
	if next(stores) == nil then
		return
	end
	local uid = player.UserId
	if uid <= 0 then
		return -- Studio test players
	end
	local t = os.clock()
	local leaving = closing or gone[player] == true or player.Parent == nil
	gone[player] = nil
	if not leaving and t - (lastPostAt[uid] or -1e9) < LB.PostEvery then
		return
	end
	lastPostAt[uid] = t
	lastPosted[uid] = lastPosted[uid] or {}
	for _, b in LB.Boards do
		local v = statOf(p, b.Stat)
		local store = stores[b.Key]
		if store and v > 0 and lastPosted[uid][b.Key] ~= v then
			local ok, err = pcall(function()
				store:SetAsync(tostring(uid), v)
			end)
			if ok then
				lastPosted[uid][b.Key] = v
			else
				warn("[CRUMBLE] leaderboard post failed:", err)
			end
		end
	end
	if leaving then
		lastPosted[uid] = nil
		lastPostAt[uid] = nil
	end
end

local function serverRows(stat: string): { Row }
	local rows: { Row } = {}
	for _, pl in Players:GetPlayers() do
		local p = DataService.Get(pl)
		if p then
			table.insert(rows, { Name = pl.DisplayName, Value = statOf(p, stat), UserId = pl.UserId })
		end
	end
	table.sort(rows, function(a, b)
		return a.Value > b.Value
	end)
	while #rows > LB.Top do
		table.remove(rows)
	end
	return rows
end

local function render()
	for key, gui in boardGuis do
		local b = data[key]
		local rows = b and b.Rows or {}
		for i, label in gui.Rows do
			local r = rows[i]
			if r then
				label.Text = string.format("%d.  %s", i, r.Name)
				local v = label:FindFirstChild("Value") :: TextLabel?
				if v then
					v.Text = tostring(r.Value)
				end
			else
				label.Text = string.format("%d.  —", i)
				local v = label:FindFirstChild("Value") :: TextLabel?
				if v then
					v.Text = ""
				end
			end
		end
		gui.Source.Text = (b and b.Source == "global") and "ALL SERVERS · updates every 90 s" or "THIS SERVER only"
	end
	value.Value = HttpService:JSONEncode({ Boards = data, Updated = os.time() })
end

local function refresh()
	for _, b in LB.Boards do
		local store = stores[b.Key]
		local board: Board? = nil
		if store then
			local ok, page = pcall(function()
				return store:GetSortedAsync(false, LB.Top):GetCurrentPage()
			end)
			if ok and type(page) == "table" and #page > 0 then
				local rows: { Row } = {}
				for _, e in page do
					local uid = tonumber(e.key) or 0
					table.insert(rows, { Name = nameOf(uid), Value = tonumber(e.value) or 0, UserId = uid })
				end
				board = { Source = "global", Rows = rows }
			elseif ok then
				-- v1.0: DataStores work but nobody has scored yet (brand-new game) — still the global board,
				-- show this server's players until the first scores arrive
				board = { Source = "global", Rows = serverRows(b.Stat) }
			end
		end
		data[b.Key] = board or { Source = "server", Rows = serverRows(b.Stat) }
	end
	render()
end

-- three Hall of Fame boards in the HALL district (back row), facing the plaza
local function buildBoards()
	local lobby = workspace:FindFirstChild("Lobby")
	if not lobby then
		return
	end
	local L = Config.Lobby
	local c = L.Center
	local backZ = c.Z + L.Size.Y / 2
	local folder = Instance.new("Folder")
	folder.Name = "HallOfFame"
	local IRON = Color3.fromRGB(70, 66, 90)
	local INK = Color3.fromRGB(30, 26, 40)
	-- v0.9.15: the HALL district back row — How To Play (x −30) and the Quest board (x 0) sit left of these,
	-- each with its own space (they used to overlap the HOW TO PLAY sign)
	local xs = { 20, 36, 52 }
	local ICONS = { "crown", "trophy", "swords" }
	for i, spec in LB.Boards do
		local x = c.X + xs[i]
		local z = backZ - 4
		local W, H = 13, 12.5
		local base = Vector3.new(x, c.Y, z)
		for _, sx in { -1, 1 } do
			Art.Static(folder, { Name = "BoardPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(H + 2.4, 1.1, 1.1), CFrame = CFrame.new(base + Vector3.new(sx * (W / 2 + 0.2), (H + 2.4) / 2, 0.4)) * CFrame.Angles(0, 0, math.rad(90)), Color = IRON, CanCollide = true })
			Art.Static(folder, { Name = "BoardPostCap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 1.6, 1.6), CFrame = CFrame.new(base + Vector3.new(sx * (W / 2 + 0.2), H + 2.65, 0.4)) * CFrame.Angles(0, 0, math.rad(90)), Color = spec.Color })
		end
		local board = Art.Static(folder, { Name = "LeaderBoard", Size = Vector3.new(W, H, 0.6), CFrame = CFrame.new(base + Vector3.new(0, 2 + H / 2, 0)), Color = Color3.fromRGB(236, 226, 206), CanCollide = true })
		if i == 2 then
			local pp = Instance.new("ProximityPrompt")
			pp.ActionText = "Open"
			pp.ObjectText = "Leaders"
			pp.HoldDuration = 0
			pp.MaxActivationDistance = 14
			pp.RequiresLineOfSight = false
			pp.KeyboardKeyCode = Enum.KeyCode.F
			pp:SetAttribute("Menu", "Leaders")
			pp.Parent = board
		end
		local g = Instance.new("SurfaceGui")
		g.Face = Enum.NormalId.Front -- −Z: towards the plaza
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 40
		g.LightInfluence = 0.2
		g.Parent = board
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, -20, 1, -20)
		frame.Position = UDim2.fromOffset(10, 10)
		frame.BackgroundColor3 = Color3.fromRGB(255, 248, 232)
		frame.Parent = g
		local fc = Instance.new("UICorner")
		fc.CornerRadius = UDim.new(0, 22)
		fc.Parent = frame
		-- coloured header band with a drawn icon + LuckiestGuy title
		local band = Instance.new("Frame")
		band.Size = UDim2.new(1, 52, 0, 76)
		band.Position = UDim2.fromOffset(-26, -14)
		band.BackgroundColor3 = spec.Color
		band.BorderSizePixel = 0
		band.Parent = frame
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 22)
		bc.Parent = band
		Icons.make(ICONS[i] or "trophy", { Position = UDim2.fromOffset(18, 10), Size = UDim2.fromOffset(56, 56), Parent = band })
		local bt = Instance.new("TextLabel")
		bt.BackgroundTransparency = 1
		bt.Position = UDim2.fromOffset(84, 10)
		bt.Size = UDim2.new(1, -100, 0, 56)
		bt.Font = Enum.Font.LuckiestGuy
		bt.TextScaled = true
		bt.TextXAlignment = Enum.TextXAlignment.Left
		bt.TextColor3 = Color3.new(1, 1, 1)
		bt.TextStrokeColor3 = INK
		bt.TextStrokeTransparency = 0
		bt.Text = string.upper(spec.Title)
		bt.Parent = band
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 26)
		pad.PaddingRight = UDim.new(0, 26)
		pad.PaddingTop = UDim.new(0, 14)
		pad.Parent = frame
		local function text(y: number, h: number, t: string, col: Color3, font: Enum.Font?): TextLabel
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Position = UDim2.fromOffset(0, y)
			l.Size = UDim2.new(1, 0, 0, h)
			l.Font = font or Enum.Font.FredokaOne
			l.TextScaled = true
			l.TextColor3 = col
			l.Text = t
			l.Parent = frame
			return l
		end
		text(68, 24, spec.Sub, Color3.fromRGB(128, 112, 100), Enum.Font.FredokaOne)
		local rows = {}
		for r = 1, LB.Top do
			local l = text(90 + (r - 1) * 36, 32, string.format("%d.  —", r), r <= 3 and Color3.fromRGB(200, 120, 10) or Color3.fromRGB(42, 36, 52))
			l.TextXAlignment = Enum.TextXAlignment.Left
			local v = Instance.new("TextLabel")
			v.Name = "Value"
			v.BackgroundTransparency = 1
			v.AnchorPoint = Vector2.new(1, 0)
			v.Position = UDim2.fromScale(1, 0)
			v.Size = UDim2.fromScale(0.3, 1)
			v.Font = Enum.Font.FredokaOne
			v.TextScaled = true
			v.TextXAlignment = Enum.TextXAlignment.Right
			v.TextColor3 = l.TextColor3
			v.Text = ""
			v.Parent = l
			-- the name never runs into the number
			local cons = Instance.new("UITextSizeConstraint")
			cons.MaxTextSize = 30
			cons.Parent = l
			table.insert(rows, l)
		end
		local src = text(H * 40 - 40, 20, "", Color3.fromRGB(128, 112, 100), Enum.Font.FredokaOne)
		boardGuis[spec.Key] = { Rows = rows, Source = src }
	end
	Art.Toon(folder, 0)
	folder.Parent = lobby
end

function LeaderboardService.Init()
	value = Instance.new("StringValue")
	value.Name = "LeaderboardData"
	value.Value = "{}"
	value.Parent = ReplicatedStorage
	for _, b in LB.Boards do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("CrumbleLB_" .. b.Key .. "_v1")
		end)
		if ok and store then
			stores[b.Key] = store
		end
	end
	local okB, errB = pcall(buildBoards)
	if not okB then
		warn("[CRUMBLE] leaderboard boards:", errB)
	end
	DataService.OnSaved = post
	Players.PlayerRemoving:Connect(function(player)
		gone[player] = true
		task.delay(60, function()
			gone[player] = nil
		end)
	end)
	game:BindToClose(function()
		closing = true
	end)
	task.spawn(function()
		task.wait(5)
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[CRUMBLE] leaderboard refresh:", err)
			end
			local anyLocal = false
			for _, bd in data do
				anyLocal = anyLocal or bd.Source ~= "global"
			end
			-- (GetSortedAsync has a per-minute budget: never faster than every 45 s with stores)
			task.wait(if not anyLocal then LB.Refresh elseif next(stores) == nil then 20 else 45)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">LobbyBuilder</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — LobbyBuilder (v0.7.3 "Plaza" layout, v0.7.2 reference style)
	Builds "The Yard": a soft, low-poly floating meadow island overlooking the arena.
	Look (from the reference screenshot, not its winter theme): flat SmoothPlastic colours, chunky
	rounded props, log fences, pines, barrels and crates, cream paths with glowing guide lines,
	wooden market stalls with floating coloured name plates, and glowing green pads in front of
	every station. Lavender-tinted soft lighting with drifting white sparkles.

	Kept for the rest of the game: Config.Lobby footprint, SpawnLocation, invisible walls,
	ProximityPrompts (attribute Menu = "Vault" / "Forge"), RangeInfo() and RandomSpawnCFrame().
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Rarity = require(Shared.Rarity)
local Weapons = require(Shared.Weapons)
local Descriptions = require(Shared.Descriptions)
local WeaponVisuals = require(Shared.WeaponVisuals)
local Art = require(Shared.Art)
local Icons = require(Shared.Icons)

local LobbyBuilder = {}

export type RangeInfo = { Min: Vector3, Max: Vector3, Posts: { CFrame } }
local rangeInfo: RangeInfo? = nil

local L = Config.Lobby

------------------------------------------------------------------------
-- Palette (flat, clean, saturated — soft because of the lighting, not washed out)
------------------------------------------------------------------------
local GRASS = Color3.fromRGB(116, 196, 98)
local GRASS_DARK = Color3.fromRGB(92, 170, 84)
local DIRT = Color3.fromRGB(156, 112, 82)
local ROCK = Color3.fromRGB(168, 158, 196)
local ROCK_DARK = Color3.fromRGB(128, 118, 162)
local PATH = Color3.fromRGB(240, 230, 208)
local WOOD = Color3.fromRGB(212, 156, 100)
local WOOD_LIGHT = Color3.fromRGB(232, 190, 132)
local WOOD_DARK = Color3.fromRGB(150, 102, 70)
local RED = Color3.fromRGB(226, 76, 70)
local GOLD = Color3.fromRGB(246, 176, 40)
local CREAM = Color3.fromRGB(252, 248, 238)
local INK = Color3.fromRGB(38, 42, 66)
local GUIDE = Color3.fromRGB(120, 228, 255)
local PAD = Color3.fromRGB(80, 235, 140)
local LANTERN = Color3.fromRGB(255, 220, 160)
-- v0.9.15 kit: warm cream stone + one dark iron for every structure
local STONE = Color3.fromRGB(236, 226, 206)
local STONE_D = Color3.fromRGB(200, 186, 164)
local IRON = Color3.fromRGB(70, 66, 90)
-- v0.9.14 BRAND PALETTE: repeated props rotate through orange / teal / gold only
local ACCENTS = { Art.Brand.Orange, Art.Brand.Teal, Art.Brand.Gold }
local FLOWERS = { -- v0.9.14: 4 flower colours (was 8)
	Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 110, 255),
}
local accentN = 0
local function nextAccent(): Color3
	accentN += 1
	return ACCENTS[accentN % #ACCENTS + 1] -- neighbours never match
end

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- vertical cylinder helper (Roblox cylinders run along X)
local UP = CFrame.Angles(0, 0, math.rad(90))
local function cyl(parent: Instance, name: string, pos: Vector3, height: number, diameter: number, color: Color3, collide: boolean?): Part
	return part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(pos) * UP,
		Color = color,
		CanCollide = collide ~= false,
	})
end

local function ball(parent: Instance, name: string, pos: Vector3, size: Vector3, color: Color3, collide: boolean?): Part
	if math.abs(size.X - size.Y) < 0.01 and math.abs(size.Y - size.Z) < 0.01 then
		return part(parent, { Name = name, Shape = Enum.PartType.Ball, Size = size, CFrame = CFrame.new(pos), Color = color, CanCollide = collide == true })
	end
	-- v0.7.3: Ball parts are always uniform, so squashed canopies/caps/hedges use a sphere mesh
	local p = Art.Egg(parent, size, CFrame.new(pos), color, collide)
	p.Name = name
	p.CanQuery = collide == true
	return p
end

------------------------------------------------------------------------
-- Signs & labels
------------------------------------------------------------------------
-- v0.9.15 "Toy Box" signage (matches the UI the playtesters liked): cream or coloured cards with a
-- thick ink outline, LuckiestGuy titles, FredokaOne body text and drawn icons (Shared/Icons).
local SIGN_PPS = 40
local DISPLAY = Enum.Font.LuckiestGuy
local BODY = Enum.Font.FredokaOne
local function card(parent: Instance, bg: Color3, cornerPx: number, strokePx: number, line: Color3?): Frame
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = bg
	f.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, cornerPx)
	c.Parent = f
	local st = Instance.new("UIStroke")
	st.Color = line or INK
	st.Thickness = strokePx
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = f
	f.Parent = parent
	return f
end

local function lum(c: Color3): number
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

-- v1.0: text width ÷ text height for a one-line string (TextService when it's there, else an estimate),
-- so an icon + word can be centred as ONE group on signs and plates.
local TextService = game:GetService("TextService")
local function textRatio(text: string, font: Enum.Font): number
	local ok, v = pcall(function()
		return TextService:GetTextSize(text, 100, font, Vector2.new(100000, 1000))
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return v.X / 100
	end
	return #text * (font == DISPLAY and 0.66 or 0.56)
end

-- A sign: lines = { { text, color?, size? (px row height), icon?, display? } }. The first line is the title
-- (LuckiestGuy); a line with an icon draws the icon on the left of its text.
-- v0.9.15b: two-sided = the text is drawn on BOTH faces (arches, portal beams, signpost arms are seen from
-- the spawn/plaza side as well as from the far side).
-- v0.9.18: `back` = different text (and colour) on the Back face, e.g. arches that read the district
-- name from the plaza and "HALL" from inside the district.
type SignLine = { text: string, color: Color3?, size: number?, icon: string?, display: boolean? }
local function sign(parent: Instance, cf: CFrame, size: Vector3, frontLines: { SignLine }, bg: Color3?, twoSided: boolean?, back: { lines: { SignLine }, bg: Color3? }?)
	local board = part(parent, { Name = "Sign", Size = size, CFrame = cf, Transparency = 1 })
	local minPx = math.min(size.X, size.Y) * SIGN_PPS
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local isBack = face == Enum.NormalId.Back and back ~= nil
		local lines = if isBack and back then back.lines else frontLines
		local color = (if isBack and back then back.bg else nil) or bg or CREAM
		local light = lum(color) > 0.6
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = SIGN_PPS
		gui.LightInfluence = 0.15
		gui.Parent = board
		local inset = Instance.new("Frame")
		inset.BackgroundTransparency = 1
		inset.Size = UDim2.new(1, -16, 1, -16)
		inset.Position = UDim2.fromOffset(8, 8)
		inset.Parent = gui
		local panel = card(inset, color, math.floor(minPx * 0.16), math.max(6, math.floor(minPx * 0.04)), INK)
		if face == Enum.NormalId.Front or twoSided or isBack then
			local layout = Instance.new("UIListLayout")
			layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			layout.VerticalAlignment = Enum.VerticalAlignment.Center
			layout.Padding = UDim.new(0, 10)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Parent = panel
			for i, ln in lines do
				local h = ln.size or 60
				local row = Instance.new("Frame")
				row.LayoutOrder = i
				row.BackgroundTransparency = 1
				row.Size = UDim2.new(1, -60, 0, h)
				row.Parent = panel
				local t = Instance.new("TextLabel")
				t.BackgroundTransparency = 1
				local isTitle = ln.display or i == 1
				t.Font = isTitle and DISPLAY or BODY
				t.TextScaled = true
				t.TextColor3 = ln.color or (light and INK or Color3.new(1, 1, 1))
				if isTitle then
					t.TextStrokeColor3 = INK
					t.TextStrokeTransparency = (light and lum(t.TextColor3) < 0.5) and 1 or 0
				else
					t.TextStrokeTransparency = 1
				end
				t.Text = ln.text
				if ln.icon then
					-- v1.0: icon + word centred together as one group (they used to sit at the left)
					local rowW = size.X * SIGN_PPS - 16 - 60
					local gap = math.floor(h * 0.18)
					local avail = math.max(20, rowW - h - gap)
					local ts = math.min(h, 100)
					local tw = textRatio(ln.text, t.Font) * ts
					if tw > avail then
						ts = math.max(8, math.floor(ts * avail / tw))
						tw = textRatio(ln.text, t.Font) * ts
					end
					local hl = Instance.new("UIListLayout")
					hl.FillDirection = Enum.FillDirection.Horizontal
					hl.HorizontalAlignment = Enum.HorizontalAlignment.Center
					hl.VerticalAlignment = Enum.VerticalAlignment.Center
					hl.Padding = UDim.new(0, gap)
					hl.SortOrder = Enum.SortOrder.LayoutOrder
					hl.Parent = row
					local ic = Icons.make(ln.icon, { Size = UDim2.fromOffset(h, h), Parent = row })
					ic.LayoutOrder = 1
					t.LayoutOrder = 2
					t.TextScaled = false
					t.TextSize = ts
					t.Size = UDim2.fromOffset(math.ceil(tw) + 6, h)
					t.TextXAlignment = Enum.TextXAlignment.Center
				else
					t.Size = UDim2.fromScale(1, 1)
				end
				t.Parent = row
			end
		end
	end
	return board
end

-- Floating name plate (always faces the camera): a coloured pill with an ink outline, a drawn icon and a
-- LuckiestGuy title; the optional subtitle sits on a small cream tag underneath.
local function plate(parent: Instance, pos: Vector3, title: string, sub: string?, color: Color3, widthStuds: number?, icon: string?)
	local anchor = part(parent, { Name = "PlateAnchor", Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	local bb = Instance.new("BillboardGui")
	bb.Name = "Plate"
	local w = widthStuds or 11
	bb.Size = UDim2.new(w, 0, sub and w * 0.34 or w * 0.22, 0)
	bb.MaxDistance = 160
	bb.LightInfluence = 0
	bb.Parent = anchor
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, sub and 0.64 or 1)
	holder.Parent = bb
	local f = card(holder, color, 999, 3, INK)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(0.9, 0.72)
	t.Position = UDim2.fromScale(0.05, 0.14)
	if icon then
		-- v1.0: centre the icon + title as one group (widths in fractions of the pill width)
		local hw = sub and 0.34 * 0.64 or 0.22 -- pill height ÷ pill width
		local iconW = 0.8 * hw
		local gap = 0.12 * hw
		local textW = math.min(0.9 - iconW - gap, textRatio(title, DISPLAY) * 0.72 * hw)
		local x0 = (1 - (iconW + gap + textW)) / 2
		Icons.make(icon, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(x0, 0.5), Size = UDim2.fromScale(0.8, 0.8), Parent = f })
		t.Size = UDim2.fromScale(textW + 0.02, 0.72)
		t.Position = UDim2.fromScale(x0 + iconW + gap - 0.01, 0.14)
	end
	t.Font = DISPLAY
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeColor3 = INK
	t.TextStrokeTransparency = 0
	t.Text = title
	t.Parent = f
	if sub then
		local tagHolder = Instance.new("Frame")
		tagHolder.BackgroundTransparency = 1
		tagHolder.AnchorPoint = Vector2.new(0.5, 0)
		tagHolder.Position = UDim2.fromScale(0.5, 0.7)
		tagHolder.Size = UDim2.fromScale(0.8, 0.28)
		tagHolder.Parent = bb
		local tag = card(tagHolder, CREAM, 999, 2, INK)
		local s2 = Instance.new("TextLabel")
		s2.BackgroundTransparency = 1
		s2.Size = UDim2.fromScale(0.9, 0.76)
		s2.Position = UDim2.fromScale(0.05, 0.12)
		s2.Font = BODY
		s2.TextScaled = true
		s2.TextColor3 = INK
		s2.Text = sub
		s2.Parent = tag
	end
end

-- Station pad on the ground (where you stand to open it) + a small floating label
local function pad(parent: Instance, pos: Vector3, title: string, sub: string, extra: string?, extraColor: Color3?)
	local col = extraColor or PAD
	local rim = cyl(parent, "PadRing", pos + Vector3.new(0, 0.27, 0), 0.1, 6.2, INK, false)
	rim.CanQuery = false
	local disc = cyl(parent, "Pad", pos + Vector3.new(0, 0.3, 0), 0.12, 5.4, col, false)
	disc.CanQuery = false
	local anchor = part(parent, { Name = "PadLabel", Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos + Vector3.new(0, 4.6, 0)), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(8, 0, 2.2, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = anchor
	local rows = { { title, 0.58, Color3.new(1, 1, 1), DISPLAY } }
	if extra then
		table.insert(rows, { extra, 0.4, col, DISPLAY })
	end
	local y = 0
	for _, r in rows do
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0, y)
		t.Size = UDim2.fromScale(1, r[2])
		t.Font = r[4]
		t.TextScaled = true
		t.TextColor3 = r[3]
		t.TextStrokeColor3 = INK
		t.TextStrokeTransparency = 0
		t.Text = string.upper(r[1])
		t.Parent = bb
		y += r[2] + 0.02
	end
	local _ = sub
end

-- Cream path with a glowing guide line down the middle (reference: the cyan floor beams)
local function path(parent: Instance, y: number, a: Vector2, b: Vector2, width: number?)
	local d = b - a
	local len = d.Magnitude
	if len < 0.5 then
		return
	end
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(Vector3.new(mid.X, y, mid.Y), Vector3.new(b.X, y, b.Y))
	local wd = width or 5
	-- v0.9.15b: a clean stone border UNDER every path (always below every path top, so crossings and
	-- branch joints merge into one shape instead of pebbles poking across the other path)
	part(parent, { Name = "PathBorder", Size = Vector3.new(wd + 1, 0.12, len + wd + 1), CFrame = cf + Vector3.new(0, 0.05, 0), Color = Color3.fromRGB(214, 200, 176), CanCollide = false, CanQuery = false }):SetAttribute("NoVary", true)
	part(parent, { Name = "Path", Size = Vector3.new(wd, 0.16, len + wd), CFrame = cf + Vector3.new(0, 0.08, 0), Color = PATH, CanCollide = false, CanQuery = false })
	-- the guide line stops well short of both ends (never crosses a junction or pokes into a pad)
	local gl = len - 8
	if gl < 1 then
		return
	end
	local g = part(parent, { Name = "GuideLine", Size = Vector3.new(0.4, 0.06, gl), CFrame = cf + Vector3.new(0, 0.19, 0), Color = GUIDE, Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, CanQuery = false })
	g:SetAttribute("Softened", true) -- keep the guide line a crisp beam
end

------------------------------------------------------------------------
-- Props
------------------------------------------------------------------------
local function pine(parent: Instance, base: Vector3, h: number, collide: boolean?)
	Art.Pine(parent, base, h, nil, collide ~= false) -- v0.8 low-poly faceted pine
end

-- v0.8: low-poly round tree (faceted canopy clusters instead of smooth balls)
local function roundTree(parent: Instance, base: Vector3, h: number)
	local sd = math.floor(base.X * 3 + base.Z * 5)
	-- v0.9.10: each round tree is one of several species (green, deep green, autumn, blossom, golden, plum)
	local sp = Art.LeafSpecies[1 + math.floor(Art.Hash(sd, 993) * #Art.LeafSpecies) % #Art.LeafSpecies]
	local bark = Art.Barks[1 + math.floor(Art.Hash(sd, 994) * #Art.Barks) % #Art.Barks]
	cyl(parent, "Trunk", base + Vector3.new(0, h * 0.25, 0), h * 0.5, h * 0.13, bark)
	-- v0.9.14: one clean faceted canopy (the 3-blob cluster read as lumpy)
	Art.Blob(parent, base + Vector3.new(0, h * 0.7, 0), h * 0.82, h * 0.7, sd, sp[1])
end

local function barrel(parent: Instance, base: Vector3)
	cyl(parent, "Barrel", base + Vector3.new(0, 1.5, 0), 3, 2.6, WOOD)
	for _, y in { 0.6, 2.4 } do
		cyl(parent, "BarrelBand", base + Vector3.new(0, y, 0), 0.3, 2.75, WOOD_DARK, false)
	end
	cyl(parent, "BarrelTop", base + Vector3.new(0, 3.02, 0), 0.06, 2.2, WOOD_LIGHT, false)
end

local function crate(parent: Instance, base: Vector3, s: number, yaw: number)
	part(parent, { Name = "Crate", Size = Vector3.new(s, s, s), CFrame = CFrame.new(base + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, yaw, 0), Color = WOOD })
	part(parent, { Name = "CrateBand", Size = Vector3.new(s + 0.1, s * 0.16, s + 0.1), CFrame = CFrame.new(base + Vector3.new(0, s * 0.82, 0)) * CFrame.Angles(0, yaw, 0), Color = WOOD_DARK, CanCollide = false })
end

-- v0.8: faceted low-poly boulder (+ an invisible collider so it stays solid)
local function rock(parent: Instance, base: Vector3, s: number, seed: number)
	Art.Rock(parent, base, s, seed, seed % 2 == 0 and ROCK or ROCK_DARK)
	part(parent, { Name = "RockCollider", Size = Vector3.new(s * 0.8, s * 0.55, s * 0.75), CFrame = CFrame.new(base + Vector3.new(0, s * 0.27, 0)), Transparency = 1, CanCollide = true })
end

-- log fence (reference: chunky wooden palisade with rounded tips)


local function miniIsland(parent: Instance, top: Vector3, r: number, seed: number)
	-- v0.8 low-poly floating island (far away = the cheaper Low version)
	Art.Island(parent, top, r, seed, GRASS, ROCK, ROCK_DARK, { Low = true })
end

local function prompt(parent: BasePart, action: string, object: string, menu: string)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.F
	pp:SetAttribute("Menu", menu)
	pp.Parent = parent
end

local function display(parent: Instance, weaponId: string, level: number, top: Vector3, scale: number)
	local ok, model = pcall(WeaponVisuals.BuildDisplay, weaponId, level)
	if not ok or not model then
		return
	end
	local def = Weapons.Get(weaponId)
	local flip = def.Limb == "Leg" and CFrame.identity or CFrame.Angles(math.pi, 0, 0)
	pcall(function()
		model:ScaleTo(scale)
	end)
	model:PivotTo(CFrame.new(top) * CFrame.Angles(0, math.rad(200), 0) * flip)
	local cf, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + Vector3.new(0, top.Y - (cf.Position.Y - size.Y / 2) + 0.15, 0))
	model.Parent = parent
end

------------------------------------------------------------------------
-- v0.7.3 plaza props
------------------------------------------------------------------------
-- The Tile Fountain: two stone basins with water and a floating, glowing arena tile on top.




local function flowerBed(parent: Instance, base: Vector3, w: number, d: number, seed: number)
	part(parent, { Name = "BedFrame", Size = Vector3.new(w, 0.8, d), CFrame = CFrame.new(base + Vector3.new(0, 0.4, 0)), Color = WOOD })
	part(parent, { Name = "BedSoil", Size = Vector3.new(w - 0.6, 0.2, d - 0.6), CFrame = CFrame.new(base + Vector3.new(0, 0.82, 0)), Color = DIRT, CanCollide = false })
	local n = math.floor(w / 1.1)
	for i = 0, n - 1 do
		for j = 0, 1 do
			local x = -w / 2 + 0.8 + i * ((w - 1.6) / math.max(n - 1, 1))
			local z = (j - 0.5) * (d * 0.45)
			local h = 0.9 + Art.Hash(seed * 10 + i, j) * 0.6
			cyl(parent, "Stem", base + Vector3.new(x, 0.9 + h / 2, z), h, 0.14, GRASS_DARK, false)
			ball(parent, "Bloom", base + Vector3.new(x, 0.95 + h, z), Vector3.new(0.7, 0.55, 0.7), FLOWERS[(i + j + seed) % #FLOWERS + 1])
		end
	end
end


local function mushroom(parent: Instance, base: Vector3, s: number, seed: number)
	cyl(parent, "MushStem", base + Vector3.new(0, s * 0.5, 0), s, s * 0.45, CREAM, false)
	local CAPS = { Color3.fromRGB(226, 70, 62), Color3.fromRGB(240, 120, 50) } -- v0.9.14: classic red / orange caps
	local capColor = CAPS[seed % #CAPS + 1]
	ball(parent, "MushCap", base + Vector3.new(0, s * 1.05, 0), Vector3.new(s * 1.3, s * 0.7, s * 1.3), capColor)
	for k = 0, 2 do
		local a = k * 2.1 + seed
		ball(parent, "MushDot", base + Vector3.new(math.cos(a) * s * 0.36, s * 1.3, math.sin(a) * s * 0.36), Vector3.new(s * 0.22, s * 0.12, s * 0.22), CREAM)
	end
end

local function telescope(parent: Instance, base: Vector3, target: Vector3)
	local top = base + Vector3.new(0, 3.6, 0)
	for k = 0, 2 do
		local a = k * 2.094
		local foot = base + Vector3.new(math.cos(a) * 1.3, 0, math.sin(a) * 1.3)
		local mid = (foot + top) / 2
		part(parent, { Name = "TripodLeg", Size = Vector3.new(0.3, (top - foot).Magnitude, 0.3), CFrame = CFrame.lookAt(mid, top) * CFrame.Angles(math.rad(90), 0, 0), Color = WOOD_DARK })
	end
	local look = CFrame.lookAt(top, Vector3.new(target.X, top.Y - 6, target.Z))
	part(parent, { Name = "ScopeTube", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, 0.9, 0.9), CFrame = look * CFrame.new(0, 0.3, -0.6) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, CanCollide = false })
	part(parent, { Name = "ScopeLens", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.2, 1.2), CFrame = look * CFrame.new(0, 0.3, -2.3) * CFrame.Angles(0, math.rad(90), 0), Color = WOOD_DARK, CanCollide = false })
	part(parent, { Name = "ScopeEye", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 0.5, 0.5), CFrame = look * CFrame.new(0, 0.3, 1.3) * CFrame.Angles(0, math.rad(90), 0), Color = WOOD_DARK, CanCollide = false })
end




local function fence(parent: Instance, y: number, a: Vector2, b: Vector2, h: number)
	-- v0.9.15: clean post-and-rail fence (was a log every 1.8 studs with lumpy egg tips)
	local d = b - a
	local n = math.max(1, math.floor(d.Magnitude / 7))
	for i = 0, n do
		local p = a + d * (i / n)
		cyl(parent, "FencePost", Vector3.new(p.X, y + (h + 0.6) / 2, p.Y), h + 0.6, 1.1, WOOD_DARK)
		cyl(parent, "FenceCap", Vector3.new(p.X, y + h + 0.75, p.Y), 0.3, 1.4, CREAM, false)
	end
	local mid = (a + b) / 2
	local yaw = math.atan2(-(b.Y - a.Y), b.X - a.X)
	for k, ry in { h * 0.42, h * 0.86 } do
		part(parent, { Name = "FenceRail", Size = Vector3.new(d.Magnitude, k == 2 and 0.5 or 0.42, 0.4), CFrame = CFrame.new(mid.X, y + ry, mid.Y) * CFrame.Angles(0, yaw, 0), Color = WOOD_LIGHT })
	end
end

-- Lamp post (v0.9.15): dark iron post, warm lantern box, a roof cap in the district colour. No cages,
-- baskets or finials.
local function lampPost(parent: Instance, base: Vector3, accent: Color3?)
	local acc = accent or nextAccent()
	cyl(parent, "LampFoot", base + Vector3.new(0, 0.4, 0), 0.8, 1.8, IRON)
	cyl(parent, "LampPost", base + Vector3.new(0, 4.6, 0), 8, 0.7, IRON)
	local lamp = part(parent, { Name = "Lamp", Size = Vector3.new(1.6, 1.9, 1.6), CFrame = CFrame.new(base + Vector3.new(0, 9.4, 0)), Color = LANTERN, Material = Enum.Material.Neon, CanCollide = false })
	Art.Light(lamp, LANTERN, 14, 0.5)
	part(parent, { Name = "LampBase", Size = Vector3.new(2, 0.4, 2), CFrame = CFrame.new(base + Vector3.new(0, 8.3, 0)), Color = IRON, CanCollide = false })
	part(parent, { Name = "LampRoof", Size = Vector3.new(2.6, 0.7, 2.6), CFrame = CFrame.new(base + Vector3.new(0, 10.7, 0)), Color = acc, CanCollide = false })
end

-- District arch (v0.9.15): two cream posts and a coloured banner with a drawn icon + the district name.
-- v0.9.18: the plaza side (Back face) reads the district name; the district side (Front face) reads
-- where the arch takes you back to (HALL, or PLAZA on the HALL arch itself).
local function districtArch(parent: Instance, pos: Vector3, yaw: number, name: string, icon: string, color: Color3, width: number?, backTo: { name: string, icon: string?, color: Color3 }?)
	local w = width or 11
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	for _, sx in { -1, 1 } do
		local p = (cf * CFrame.new(sx * w / 2, 0, 0)).Position
		cyl(parent, "ArchFoot", p + Vector3.new(0, 0.5, 0), 1, 2.2, IRON)
		cyl(parent, "ArchPost", p + Vector3.new(0, 4.6, 0), 8.2, 1.4, STONE)
		cyl(parent, "ArchCap", p + Vector3.new(0, 10.6, 0), 0.6, 2, color, false)
	end
	part(parent, { Name = "ArchBanner", Size = Vector3.new(w + 1.6, 2.8, 0.6), CFrame = cf * CFrame.new(0, 9, 0), Color = color, CanCollide = false })
	local districtSide = backTo and { { text = backTo.name, color = Color3.new(1, 1, 1), size = 80, icon = backTo.icon, display = true } }
		or { { text = name, color = Color3.new(1, 1, 1), size = 80, icon = icon, display = true } }
	-- Front (−Z of cf) faces into the district, Back faces the plaza
	sign(parent, cf * CFrame.new(0, 9, 0), Vector3.new(w + 1.6, 2.8, 0.66), districtSide, backTo and backTo.color or color, true, {
		lines = { { text = name, color = Color3.new(1, 1, 1), size = 80, icon = icon, display = true } },
		bg = color,
	}).CanCollide = false
end

local function tileFountain(parent: Instance, base: Vector3)
	-- v0.9.15: one clean basin, one bowl, the floating arena tile. (No lily pads, spout balls or panel ribs.)
	local WATER = Color3.fromRGB(96, 196, 255)
	cyl(parent, "FountainStep", base + Vector3.new(0, 0.3, 0), 0.6, 15, STONE_D)
	cyl(parent, "FountainBasin", base + Vector3.new(0, 1.3, 0), 1.6, 13, STONE)
	cyl(parent, "FountainLip", base + Vector3.new(0, 2.2, 0), 0.3, 13.4, Art.Brand.Teal, false)
	local water = cyl(parent, "FountainWater", base + Vector3.new(0, 2.05, 0), 0.3, 11.4, WATER, false)
	water.CanQuery = false
	cyl(parent, "FountainColumn", base + Vector3.new(0, 3.7, 0), 3.2, 2.2, STONE)
	cyl(parent, "FountainBowl", base + Vector3.new(0, 5.5, 0), 0.8, 6, STONE, false)
	cyl(parent, "FountainBowlLip", base + Vector3.new(0, 5.95, 0), 0.25, 6.3, Art.Brand.Teal, false)
	cyl(parent, "FountainWaterTop", base + Vector3.new(0, 5.92, 0), 0.2, 5.2, WATER, false)
	for k = 0, 3 do
		local a = k * math.pi / 2 + math.pi / 4
		local sheet = part(parent, { Name = "WaterFall", Size = Vector3.new(0.7, 3.4, 0.2), CFrame = CFrame.new(base + Vector3.new(math.cos(a) * 3.1, 4, math.sin(a) * 3.1)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = WATER, Transparency = 0.3, CanCollide = false, CanQuery = false })
		sheet:SetAttribute("Softened", true)
	end
	local tileCf = CFrame.new(base + Vector3.new(0, 9.4, 0)) * CFrame.Angles(math.rad(12), math.rad(45), math.rad(8))
	part(parent, { Name = "FloatTile", Size = Vector3.new(4, 1.2, 4), CFrame = tileCf, Color = Config.Arena.ColorA, CanCollide = false })
	local core = part(parent, { Name = "FloatTileCore", Size = Vector3.new(2.6, 1.26, 2.6), CFrame = tileCf, Color = Config.Arena.CoreColor, Material = Enum.Material.Neon, CanCollide = false })
	Art.Light(core, Config.Arena.CoreColor, 14, 0.7)
end

local function bench(parent: Instance, cf: CFrame)
	-- cf faces the plaza centre (−Z = the direction the sitter looks)
	part(parent, { Name = "BenchSeat", Size = Vector3.new(5, 0.6, 1.8), CFrame = cf * CFrame.new(0, 1.5, 0), Color = WOOD_LIGHT })
	part(parent, { Name = "BenchBack", Size = Vector3.new(5, 1.3, 0.45), CFrame = cf * CFrame.new(0, 2.6, 0.8) * CFrame.Angles(math.rad(-10), 0, 0), Color = WOOD_LIGHT, CanCollide = false })
	for _, sx in { -1, 1 } do
		part(parent, { Name = "BenchLeg", Size = Vector3.new(0.6, 1.3, 1.7), CFrame = cf * CFrame.new(sx * 2, 0.65, 0.05), Color = IRON })
	end
end

local function planter(parent: Instance, base: Vector3, seed: number)
	-- square cream planter with one clipped round bush and a single flower colour
	part(parent, { Name = "Planter", Size = Vector3.new(3.4, 1.6, 3.4), CFrame = CFrame.new(base + Vector3.new(0, 0.8, 0)), Color = STONE })
	part(parent, { Name = "PlanterRim", Size = Vector3.new(3.8, 0.4, 3.8), CFrame = CFrame.new(base + Vector3.new(0, 1.7, 0)), Color = Art.Brand.Teal, CanCollide = false })
	cyl(parent, "PlanterBush", base + Vector3.new(0, 2.8, 0), 2, 3, GRASS_DARK)
	local col = FLOWERS[seed % #FLOWERS + 1]
	for k = 0, 3 do
		local a = k * math.pi / 2 + 0.6
		ball(parent, "Flower", base + Vector3.new(math.cos(a) * 1.05, 3.85, math.sin(a) * 1.05), Vector3.new(0.6, 0.6, 0.6), col)
	end
end


-- Signpost: iron pole with one arm per district, each pointing its way (icon + name)
local function signpost(parent: Instance, base: Vector3, arms: { { any } })
	cyl(parent, "SignFoot", base + Vector3.new(0, 0.4, 0), 0.8, 1.6, IRON)
	cyl(parent, "SignPole", base + Vector3.new(0, 4, 0), 8, 0.6, IRON)
	cyl(parent, "SignPoleCap", base + Vector3.new(0, 8.15, 0), 0.3, 1, GOLD, false)
	for i, arm in arms do
		local dir = arm[3] :: Vector3
		local yaw = math.atan2(-dir.Z, dir.X)
		sign(parent, CFrame.new(base + Vector3.new(0, 7.6 - i * 1.45, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new(3.1, 0, 0), Vector3.new(5.6, 1.25, 0.3), {
			{ text = arm[1] :: string, color = Color3.new(1, 1, 1), size = 36, icon = arm[4] :: string, display = true },
		}, arm[2] :: Color3, true).CanCollide = false
	end
end

-- Armory pedestal: round cream plinth with a rarity-coloured band; the weapon floats on top
local function armoryStump(parent: Instance, pos: Vector3, col: Color3)
	cyl(parent, "PedestalBase", pos + Vector3.new(0, 0.4, 0), 0.8, 4.4, STONE_D)
	cyl(parent, "Pedestal", pos + Vector3.new(0, 1.7, 0), 2.2, 3.2, STONE)
	cyl(parent, "PedestalBand", pos + Vector3.new(0, 2.2, 0), 0.5, 3.4, col, false)
	cyl(parent, "PedestalTop", pos + Vector3.new(0, 2.9, 0), 0.3, 3.8, STONE_D, false)
end

local function windmill(parent: Instance, wm: Vector3)
	cyl(parent, "MillTower", wm + Vector3.new(0, 6, 0), 12, 7, WOOD)
	for _, y in { 2.5, 6.5, 10.5 } do
		cyl(parent, "MillBand", wm + Vector3.new(0, y, 0), 0.6, 7.4, WOOD_DARK, false)
	end
	part(parent, { Name = "MillDoor", Size = Vector3.new(2.4, 3.6, 0.4), CFrame = CFrame.new(wm + Vector3.new(0, 1.8, -3.4)), Color = WOOD_DARK, CanCollide = false })
	part(parent, { Name = "MillWindow", Size = Vector3.new(1.4, 1.4, 0.3), CFrame = CFrame.new(wm + Vector3.new(0, 7.6, -3.45)), Color = LANTERN, Material = Enum.Material.Neon, CanCollide = false })
	cyl(parent, "MillRoof", wm + Vector3.new(0, 12.8, 0), 1.6, 8, RED, false)
	ball(parent, "MillCap", wm + Vector3.new(0, 13.8, 0), Vector3.new(6.4, 3.6, 6.4), RED)
	local hubCf = CFrame.new(wm + Vector3.new(0, 10.6, -4))
	part(parent, { Name = "MillHub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 1.6, 1.6), CFrame = hubCf * CFrame.Angles(0, math.rad(90), 0), Color = WOOD_DARK, CanCollide = false })
	for k = 0, 3 do
		local rot = hubCf * CFrame.Angles(0, 0, math.rad(20 + k * 90))
		part(parent, { Name = "MillBlade", Size = Vector3.new(1.8, 8.4, 0.3), CFrame = rot * CFrame.new(0, 5, -0.6), Color = WOOD_LIGHT, CanCollide = false })
		part(parent, { Name = "MillBladeSpar", Size = Vector3.new(0.3, 9.4, 0.4), CFrame = rot * CFrame.new(0, 4.9, -0.75), Color = WOOD_DARK, CanCollide = false })
	end
end

------------------------------------------------------------------------
-- Lighting: bright, soft, lavender-tinted shadows (reference mood)
------------------------------------------------------------------------
local function lighting()
	Lighting.ClockTime = 14.2
	Lighting.GeographicLatitude = 28
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(128, 122, 162)
	Lighting.OutdoorAmbient = Color3.fromRGB(172, 162, 212)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 238, 222)
	Lighting.ColorShift_Bottom = Color3.fromRGB(150, 140, 214)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.15
	Lighting.ShadowSoftness = 0.75
	Lighting.GlobalShadows = true

	local function ensure(className: string, name: string): Instance
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(className)
			e.Name = name
			e.Parent = Lighting
		end
		return e
	end
	local atm = ensure("Atmosphere", "CrumbleAtmosphere") :: Atmosphere
	atm.Density = 0.28
	atm.Offset = 0.1
	atm.Color = Color3.fromRGB(206, 204, 255)
	atm.Decay = Color3.fromRGB(170, 160, 232)
	atm.Glare = 0
	atm.Haze = 1.1

	local bloom = ensure("BloomEffect", "CrumbleBloom") :: BloomEffect
	bloom.Intensity = 0.3 -- v0.9.13: was 0.45 / 24 / 1.6 (lobby glows were blinding)
	bloom.Size = 20
	bloom.Threshold = 1.9

	local cc = ensure("ColorCorrectionEffect", "CrumbleGrade") :: ColorCorrectionEffect
	cc.Contrast = 0.03
	cc.Saturation = 0.08
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(246, 244, 255)

	local rays = ensure("SunRaysEffect", "CrumbleRays") :: SunRaysEffect
	rays.Intensity = 0.03
	rays.Spread = 0.6

	ensure("Sky", "CrumbleSky")

	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.5
		clouds.Density = 0.55
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end
end

-- floating mini islands with trees around the play space
local function scenery(folder: Folder)
	local rng = Random.new(1337)
	for k = 1, 16 do
		local ang = (k / 16) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local radius = rng:NextNumber(185, 290)
		local r = rng:NextNumber(8, 18)
		local pos = Config.Arena.Center + Vector3.new(math.cos(ang) * radius, rng:NextNumber(-40, 30), math.sin(ang) * radius)
		if not (pos.Z > 120 and math.abs(pos.X) < 160) then -- keep the Yard (and its sight-line) clear
			miniIsland(folder, pos, r, k)
			local n = r > 13 and 2 or 1
			for t = 1, n do
				local off = Vector3.new(rng:NextNumber(-r * 0.4, r * 0.4), 0, rng:NextNumber(-r * 0.4, r * 0.4))
				if rng:NextNumber() < 0.5 then
					pine(folder, pos + off, rng:NextNumber(10, 16), false)
				else
					roundTree(folder, pos + off, rng:NextNumber(9, 13))
				end
			end
		end
	end
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
		end
	end
end

------------------------------------------------------------------------
-- Stations
------------------------------------------------------------------------
-- market stall frame: wooden deck, 4 posts, striped awning (colour A / cream)

------------------------------------------------------------------------
-- v0.9.15 STATIONS — one clear palette per model, chunky rounded forms, nothing without a purpose.
------------------------------------------------------------------------
-- Spin Vault (SHOP district), v1.0 patch: a GIANT PRIZE WHEEL. 12 slices in the rarity colours
-- (Common to Mythic, twice), gold rim with marquee bulbs, red A-frame stand, red ticker on top and a
-- big SPIN button on a post. The wheel turns slowly on every client (tag CrumbleSpinWheel) and
-- whirls when YOU spin in the Vault (MenuController).
function LobbyBuilder.BuildVault(parent: Instance, base: CFrame)
	local m = Instance.new("Model")
	m.Name = "SpinVault"
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	local RED_D = Art.Shade(RED, 0.78)
	local FACE = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis (X) -> facing the plaza (Z)
	-- a cylinder between two points (axis along the segment)
	local function rod(parentM: Instance, name: string, a: Vector3, b: Vector3, d: number, color: Color3): Part
		local len = (b - a).Magnitude
		return part(parentM, { Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, d, d), CFrame = CFrame.lookAt((a + b) / 2, b) * FACE, Color = color, CanCollide = false })
	end

	-- plinth + stand
	cyl(m, "Plinth", at(0, 0.5, 1).Position, 1, 13, STONE)
	cyl(m, "PlinthRim", at(0, 1.05, 1).Position, 0.2, 13.4, GOLD, false)
	part(m, { Name = "Feet", Size = Vector3.new(9.4, 0.9, 3.2), CFrame = at(0, 1.45, 2.4), Color = RED_D })
	local HUB_Y, HUB_Z = 8.8, 1.2
	for _, sx in { -1, 1 } do
		rod(m, "Leg", at(sx * 3.9, 1.6, 2.5).Position, at(sx * 0.45, HUB_Y + 0.3, 2.5).Position, 1.0, RED)
	end
	part(m, { Name = "Axle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1.3, 1.3), CFrame = at(0, HUB_Y, 2.4) * FACE, Color = GOLD, CanCollide = false })
	part(m, { Name = "AxleCap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.1, 2.1), CFrame = at(0, HUB_Y, 3.2) * FACE, Color = RED_D, CanCollide = false })
	-- ticker: spine up the back, arm over the rim, red pointer in a gold outline
	local TOP = HUB_Y + 6.8
	rod(m, "Spine", at(0, HUB_Y + 0.6, 2.6).Position, at(0, TOP, 2.6).Position, 0.8, RED)
	rod(m, "Arm", at(0, TOP, 2.6).Position, at(0, TOP, 0.45).Position, 0.8, RED)
	part(m, { Name = "Hinge", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.7, 1.1, 1.1), CFrame = at(0, TOP, 0.55) * FACE, Color = GOLD, CanCollide = false })
	Art.Tri(m, at(0, HUB_Y + 5.05, 0.62).Position, at(-1.15, TOP - 0.1, 0.62).Position, at(1.15, TOP - 0.1, 0.62).Position, GOLD, 0.3)
	Art.Tri(m, at(0, HUB_Y + 5.35, 0.42).Position, at(-0.8, TOP - 0.3, 0.42).Position, at(0.8, TOP - 0.3, 0.42).Position, RED, 0.3)

	-- the wheel (its own model, pivot = hub, so clients can turn it)
	local wheel = Instance.new("Model")
	wheel.Name = "Wheel"
	local hub = at(0, HUB_Y, HUB_Z)
	local function W(x: number, y: number, z: number): Vector3
		return (hub * CFrame.new(x, y, z)).Position
	end
	local back = part(wheel, { Name = "WheelBack", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.7, 12.4, 12.4), CFrame = hub * CFrame.new(0, 0, 0.25) * FACE, Color = INK, CanCollide = false }) -- dark marquee rim: every slice pops (gold hid Legendary)
	local slices = { Rarity.Colors.Common, Rarity.Colors.Uncommon, Rarity.Colors.Rare, Rarity.Colors.Epic, Rarity.Colors.Legendary, Rarity.Colors.Mythic }
	local R, N = 5.5, 12
	for k = 0, N - 1 do
		local a1, a2 = math.rad(k * 360 / N), math.rad((k + 1) * 360 / N)
		Art.Tri(wheel, W(0, 0, -0.2), W(R * math.sin(a1), R * math.cos(a1), -0.2), W(R * math.sin(a2), R * math.cos(a2), -0.2), slices[k % 6 + 1], 0.3)
		-- gold divider on the slice edge + a marquee bulb on the rim (slice middle)
		local mid = (a1 + a2) / 2
		part(wheel, { Name = "Divider", Size = Vector3.new(0.2, R - 1.3, 0.14), CFrame = hub * CFrame.Angles(0, 0, -a1) * CFrame.new(0, (R + 1.3) / 2, -0.4), Color = GOLD, CanCollide = false })
		part(wheel, { Name = "Peg", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 0.38, 0.38), CFrame = hub * CFrame.Angles(0, 0, -a1) * CFrame.new(0, R + 0.25, -0.4) * FACE, Color = CREAM, CanCollide = false })
		part(wheel, { Name = "Bulb", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(W(5.95 * math.sin(mid), 5.95 * math.cos(mid), -0.15)), Color = LANTERN, Material = Enum.Material.Neon, CanCollide = false })
	end
	part(wheel, { Name = "HubRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.8, 2.8), CFrame = hub * CFrame.new(0, 0, -0.5) * FACE, Color = GOLD, CanCollide = false })
	part(wheel, { Name = "HubCap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 1.9, 1.9), CFrame = hub * CFrame.new(0, 0, -0.8) * FACE, Color = RED, CanCollide = false })
	part(wheel, { Name = "HubDot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 0.8, 0.8), CFrame = hub * CFrame.new(0, 0, -1.0) * FACE, Color = GOLD, CanCollide = false })
	Art.Light(back, Color3.fromRGB(255, 220, 150), 14, 0.7)
	wheel.WorldPivot = hub
	wheel:SetAttribute("Hub", hub)
	wheel.Parent = m
	wheel:AddTag("CrumbleSpinWheel")

	-- SPIN button on a post (front right) + one coin stack (front left)
	local post = cyl(m, "ButtonPost", at(5.3, 2.4, -2.6).Position, 2.8, 1.2, RED_D)
	cyl(m, "ButtonCollar", at(5.3, 3.95, -2.6).Position, 0.35, 2.0, GOLD, false)
	cyl(m, "SpinButton", at(5.3, 4.25, -2.6).Position, 0.4, 1.5, RED, false)
	for q = 0, 2 do
		cyl(m, "CoinStack", at(-5.0, 1.3 + q * 0.5, -2.6).Position, 0.42, 1.5, GOLD, false)
	end
	prompt(post, "Open", "Spin Vault", "Vault")
	m.Parent = parent
	plate(parent, at(0, 18.6, 0).Position, "SPIN VAULT", Descriptions.Stations.Vault, GOLD, 10, "spin")
	pad(parent, at(0, 0, -8).Position, "Spin", "", "Press F", GOLD)
end

-- Shop kiosk (SHOP district): teal booth with a gold/cream awning and a big gem on the roof.
function LobbyBuilder.BuildShop(parent: Instance, base: CFrame)
	local m = Instance.new("Model")
	m.Name = "ShopKiosk"
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	local TEAL = Art.Brand.Teal
	local TEAL_D = Art.Shade(TEAL, 0.78)
	part(m, { Name = "Deck", Size = Vector3.new(11, 0.8, 8), CFrame = at(0, 0.4, 1), Color = STONE })
	part(m, { Name = "BackWall", Size = Vector3.new(9, 8, 1), CFrame = at(0, 4.8, 3.6), Color = TEAL })
	for _, sx in { -1, 1 } do
		part(m, { Name = "SideWall", Size = Vector3.new(1, 8, 5), CFrame = at(sx * 4.5, 4.8, 1.6), Color = TEAL })
	end
	local counter = part(m, { Name = "Counter", Size = Vector3.new(9.6, 3.2, 2), CFrame = at(0, 2.4, -0.8), Color = TEAL_D })
	part(m, { Name = "CounterTop", Size = Vector3.new(10.2, 0.5, 2.6), CFrame = at(0, 4.2, -0.8), Color = WOOD_LIGHT, CanCollide = false })
	part(m, { Name = "CounterBand", Size = Vector3.new(9.8, 0.7, 2.1), CFrame = at(0, 1.6, -0.8), Color = GOLD, CanCollide = false })
	-- awning: four flat stripes
	for i = 0, 3 do
		part(m, { Name = "Awning", Size = Vector3.new(11 / 4 + 0.02, 0.5, 4.4), CFrame = at(-11 / 2 + (i + 0.5) * (11 / 4), 9.4, -0.6) * CFrame.Angles(math.rad(-16), 0, 0), Color = i % 2 == 0 and GOLD or CREAM, CanCollide = false })
	end
	part(m, { Name = "Roof", Size = Vector3.new(10.4, 0.8, 6), CFrame = at(0, 9.2, 1.9), Color = TEAL_D, CanCollide = false })
	-- the gem
	part(m, { Name = "Gem", Size = Vector3.new(2.6, 2.6, 2.6), CFrame = at(0, 11.8, 1.6) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = Color3.fromRGB(80, 210, 255), CanCollide = false })
	-- goods on the counter: three gift boxes in the brand colours
	for k, col in { Art.Brand.Orange, GOLD, Art.Brand.Red } do
		local x = (k - 2) * 2.6
		part(m, { Name = "GiftBox", Size = Vector3.new(1.6, 1.4, 1.6), CFrame = at(x, 5.15, -0.8) * CFrame.Angles(0, math.rad(k * 12), 0), Color = col, CanCollide = false })
		part(m, { Name = "GiftRibbon", Size = Vector3.new(1.66, 1.46, 0.3), CFrame = at(x, 5.15, -0.8) * CFrame.Angles(0, math.rad(k * 12), 0), Color = CREAM, CanCollide = false })
	end
	prompt(counter, "Open", "Shop", "Shop")
	m.Parent = parent
	plate(parent, at(0, 15.5, 0).Position, "SHOP", Descriptions.Stations.Shop, GOLD, 7, "gem")
	pad(parent, at(0, 0, -6).Position, "Shop", "", "Press F", GOLD)
end

-- The Forge (TRAIN district): warm grey furnace with a glowing arched mouth, iron roof + chimney,
-- anvil on a stump (the prompt) and a water trough.
function LobbyBuilder.BuildForge(parent: Instance, base: CFrame)
	local m = Instance.new("Model")
	m.Name = "Forge"
	local function at(x: number, y: number, z: number): CFrame
		return base * CFrame.new(x, y, z)
	end
	local BRICK = Color3.fromRGB(186, 170, 164)
	local BRICK_D = Color3.fromRGB(150, 134, 130)
	local FIRE = Color3.fromRGB(255, 140, 50)
	part(m, { Name = "Plinth", Size = Vector3.new(16, 1, 13), CFrame = at(0, 0.5, 1.5), Color = STONE_D })
	part(m, { Name = "Furnace", Size = Vector3.new(10, 7, 7), CFrame = at(0, 4.5, 3), Color = BRICK })
	part(m, { Name = "FurnaceFoot", Size = Vector3.new(10.8, 1, 7.8), CFrame = at(0, 1.5, 3), Color = BRICK_D, CanCollide = false })
	part(m, { Name = "Roof", Size = Vector3.new(11.4, 1.1, 8.4), CFrame = at(0, 8.5, 3), Color = IRON, CanCollide = false })
	-- arched mouth: dark recess + glowing fire + round top
	part(m, { Name = "Mouth", Size = Vector3.new(4.6, 3, 0.4), CFrame = at(0, 3.9, -0.45), Color = INK, CanCollide = false })
	part(m, { Name = "MouthTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 4.6, 4.6), CFrame = at(0, 5.4, -0.45) * CFrame.Angles(0, math.rad(90), 0), Color = INK, CanCollide = false })
	local mouth = part(m, { Name = "Fire", Size = Vector3.new(3.6, 2.4, 0.3), CFrame = at(0, 3.6, -0.6), Color = FIRE, Material = Enum.Material.Neon, CanCollide = false })
	Art.Light(mouth, Color3.fromRGB(255, 150, 70), 12, 0.8)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 4
	fire.Color = FIRE
	fire.SecondaryColor = Color3.fromRGB(255, 220, 120)
	fire.Parent = mouth
	cyl(m, "Chimney", at(2.8, 11.5, 4.2).Position, 6, 2.8, BRICK)
	local top = cyl(m, "ChimneyCap", at(2.8, 14.7, 4.2).Position, 0.8, 3.4, IRON, false)
	local smoke = Instance.new("Smoke")
	smoke.Opacity = 0.12
	smoke.RiseVelocity = 4
	smoke.Size = 3
	smoke.Color = Color3.fromRGB(235, 232, 250)
	smoke.Parent = top
	-- anvil on a stump (front left)
	cyl(m, "AnvilStump", at(-3.6, 2.1, -3.4).Position, 2.2, 2.8, WOOD)
	part(m, { Name = "AnvilWaist", Size = Vector3.new(1.2, 1, 1), CFrame = at(-3.6, 3.7, -3.4), Color = IRON })
	local anvilTop = part(m, { Name = "AnvilTop", Size = Vector3.new(3.2, 0.9, 1.5), CFrame = at(-3.6, 4.6, -3.4), Color = IRON })
	part(m, { Name = "AnvilHorn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 0.8, 0.8), CFrame = at(-5.6, 4.7, -3.4), Color = IRON, CanCollide = false })
	-- the hammer resting on the anvil
	part(m, { Name = "HammerHandle", Size = Vector3.new(0.35, 0.35, 2.6), CFrame = at(-3.2, 5.25, -3.6) * CFrame.Angles(0, math.rad(25), 0), Color = WOOD_LIGHT, CanCollide = false })
	part(m, { Name = "HammerHead", Size = Vector3.new(1.4, 0.8, 0.8), CFrame = at(-3.2, 5.4, -3.6) * CFrame.Angles(0, math.rad(25), 0) * CFrame.new(0, 0, -1.2), Color = Art.Brand.Orange, CanCollide = false })
	-- water trough (front right)
	part(m, { Name = "Trough", Size = Vector3.new(4, 1.6, 2.2), CFrame = at(4, 1.8, -3.4), Color = WOOD })
	part(m, { Name = "TroughWater", Size = Vector3.new(3.4, 0.2, 1.6), CFrame = at(4, 2.55, -3.4), Color = Color3.fromRGB(96, 196, 255), CanCollide = false })
	prompt(anvilTop, "Merge", "The Forge", "Forge")
	m.Parent = parent
	plate(parent, at(0, 14, 0).Position, "FORGE", Descriptions.Stations.Forge, Color3.fromRGB(56, 140, 255), 8, "hammer")
	pad(parent, at(0, 0, -10).Position, "Merge", "", "Press F", Color3.fromRGB(56, 140, 255))
end

-- Quest board (HALL district): a notice board with three pinned cards (opens Quests)
local function questBoard(parent: Instance, base: Vector3)
	local TEAL = Art.Brand.Teal
	for _, sx in { -1, 1 } do
		cyl(parent, "QuestPost", base + Vector3.new(sx * 5.6, 5, 0.3), 10, 1.1, WOOD_DARK)
	end
	local board = part(parent, { Name = "QuestBoard", Size = Vector3.new(10.4, 6.4, 0.6), CFrame = CFrame.new(base + Vector3.new(0, 5.8, 0)), Color = WOOD })
	part(parent, { Name = "QuestRoof", Size = Vector3.new(12.6, 0.8, 2.4), CFrame = CFrame.new(base + Vector3.new(0, 10.1, 0.2)), Color = TEAL, CanCollide = false })
	local cards = { Art.Brand.Cream, Color3.fromRGB(255, 236, 170), Color3.fromRGB(255, 220, 200) }
	for k = 1, 3 do
		local x = (k - 2) * 3.2
		local cf = CFrame.new(base + Vector3.new(x, 5.8 + (k == 2 and 0.3 or -0.1), -0.36)) * CFrame.Angles(0, 0, math.rad((k - 2) * -5))
		part(parent, { Name = "QuestCard", Size = Vector3.new(2.6, 3.6, 0.1), CFrame = cf, Color = cards[k], CanCollide = false })
		ball(parent, "QuestPin", (cf * CFrame.new(0, 1.5, -0.1)).Position, Vector3.new(0.45, 0.45, 0.45), Art.Brand.Red)
	end
	sign(parent, CFrame.new(base + Vector3.new(0, 10.1, -1)), Vector3.new(8, 1.6, 0.2), {
		{ text = "QUESTS", color = Color3.new(1, 1, 1), size = 50, icon = "scroll", display = true },
	}, TEAL, true).CanCollide = false
	prompt(board, "Open", "Quests", "Quests")
end

function LobbyBuilder.BuildRange(parent: Instance, xMin: number, xMax: number, zMin: number, zMax: number, y: number)
	local m = Instance.new("Model")
	m.Name = "TrainingRange"
	local zMid = (zMin + zMax) / 2
	local postX = xMax - 6
	part(m, { Name = "RangeFloor", Size = Vector3.new(xMax - xMin - 1, 0.12, zMax - zMin - 1), CFrame = CFrame.new((xMin + xMax) / 2, y + 0.06, zMid), Color = Color3.fromRGB(232, 200, 150), CanCollide = false })
	-- low cream wall with a blue (TRAIN) cap along the front (z = zMin); the east side stays open
	part(m, { Name = "Divider", Size = Vector3.new(xMax - xMin, 2.6, 1), CFrame = CFrame.new((xMin + xMax) / 2, y + 1.3, zMin), Color = STONE })
	part(m, { Name = "DividerCap", Size = Vector3.new(xMax - xMin + 0.4, 0.5, 1.4), CFrame = CFrame.new((xMin + xMax) / 2, y + 2.85, zMin), Color = Color3.fromRGB(56, 140, 255), CanCollide = false })
	-- hay-bale crash wall at the far (west) end, two layers
	local laneW = (zMax - zMin - 1) / 4
	for i = 0, 3 do
		local z = zMin + 0.5 + (i + 0.5) * laneW
		part(m, { Name = "HayBale", Size = Vector3.new(3, 4, laneW - 0.2), CFrame = CFrame.new(xMin + 2, y + 2, z), Color = Color3.fromRGB(236, 200, 96) })
		part(m, { Name = "HayBale", Size = Vector3.new(3, 3.6, laneW - 0.6), CFrame = CFrame.new(xMin + 2, y + 5.8, z), Color = Color3.fromRGB(226, 186, 80) })
		part(m, { Name = "HayTie", Size = Vector3.new(3.1, 4.05, 0.2), CFrame = CFrame.new(xMin + 2, y + 2, z), Color = Color3.fromRGB(170, 120, 60), CanCollide = false })
	end
	-- distance stripes every 4 studs from the posts (v0.7.4: as far as the paddock allows, ~60)
	for k = 1, math.floor((postX - xMin - 6) / 4) do
		local x = postX - k * 4
		local stripe = part(m, { Name = "Stripe" .. k, Size = Vector3.new(0.3, 0.14, zMax - zMin - 3), CFrame = CFrame.new(x, y + 0.13, zMid), Color = k % 5 == 0 and GOLD or Color3.new(1, 1, 1), CanCollide = false })
		stripe:SetAttribute("Softened", true)
		local tag = part(m, { Name = "Tag" .. k, Size = Vector3.new(1.6, 0.12, 2.4), CFrame = CFrame.new(x + 1, y + 0.15, zMin + 2.2) * CFrame.Angles(0, math.rad(90), 0), Transparency = 1, CanCollide = false })
		local g = Instance.new("SurfaceGui")
		g.Face = Enum.NormalId.Top
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 40
		g.LightInfluence = 0.3
		g.Parent = tag
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = k % 5 == 0 and Color3.fromRGB(200, 120, 10) or INK
		tl.Text = tostring(k * 4)
		tl.Parent = g
	end
	-- lanes with glowing rails and posts (dummies face the open east side), rope dividers between
	local posts = {}
	local n = Config.Range.DummyCount
	for i = 1, n - 1 do
		local z = zMin + (zMax - zMin) * (i + 0.5) / (n + 1)
		for k = 0, 4 do
			cyl(m, "LaneStake", Vector3.new(postX - 2 - k * (postX - xMin - 8) / 4, y + 0.9, z), 1.8, 0.5, WOOD_DARK, false)
		end
		local rope = part(m, { Name = "LaneRope", Size = Vector3.new(postX - xMin - 6, 0.25, 0.25), CFrame = CFrame.new((postX - 2 + xMin + 6) / 2, y + 1.7, z), Color = Color3.fromRGB(252, 248, 238), CanCollide = false })
		rope:SetAttribute("Softened", true)
	end
	for i = 1, n do
		local z = zMin + (zMax - zMin) * i / (n + 1)
		local rail = part(m, { Name = "Rail" .. i, Size = Vector3.new(postX - xMin - 4, 0.15, 0.3), CFrame = CFrame.new((postX + xMin + 4) / 2, y + 0.16, z), Material = Enum.Material.Neon, Color = GUIDE, Transparency = 0.2, CanCollide = false })
		rail:SetAttribute("Softened", true)
		cyl(m, "Post" .. i, Vector3.new(postX, y + 0.16, z), 0.3, 4, GOLD, false).Material = Enum.Material.Neon
		table.insert(posts, CFrame.lookAt(Vector3.new(postX, y + 3, z), Vector3.new(xMax + 10, y + 3, z)))
	end
	-- scoreboard-ish target sign on the hay
	sign(m, CFrame.new(xMin + 3.7, y + 10.5, zMid) * CFrame.Angles(0, math.rad(-90), 0), Vector3.new(22, 5, 0.4), {
		{ text = "HOW FAR CAN YOU SEND THEM?", color = Color3.fromRGB(56, 140, 255), size = 70 },
	})
	m.Parent = parent
	plate(parent, Vector3.new(postX - 8, y + 12, zMid), "RANGE", Descriptions.Stations.Range, Color3.fromRGB(56, 140, 255), 8, "target")
	pad(parent, Vector3.new(xMax + 5, y, zMid), "Range", "", "Free", Color3.fromRGB(56, 140, 255))
	rangeInfo = {
		Min = Vector3.new(xMin, y - 4, zMin),
		Max = Vector3.new(xMax + 2, y + 30, zMax),
		Posts = posts,
	}
end

------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------
function LobbyBuilder.Build(): SpawnLocation
	lighting()

	local folder = Instance.new("Folder")
	folder.Name = "Lobby"

	local c = L.Center
	local w, d = L.Size.X, L.Size.Y
	local frontZ = c.Z - d / 2 -- side facing the arena
	local backZ = c.Z + d / 2
	local Y = c.Y

	-- island: grass top, dirt band, craggy lavender rock underneath
	part(folder, { Name = "Floor", Size = Vector3.new(w, 2, d), CFrame = CFrame.new(c - Vector3.new(0, 1, 0)), Color = GRASS })
	part(folder, { Name = "Dirt", Size = Vector3.new(w - 1, 3, d - 1), CFrame = CFrame.new(c - Vector3.new(0, 3.5, 0)), Color = DIRT, CanCollide = false })
	-- v0.8: faceted low-poly underside that hugs the slab and tapers to a point, plus hanging shards
	Art.IslandUnder(folder, c - Vector3.new(0, 4.6, 0), w * 0.98, d * 0.96, 58, 7, ROCK, ROCK_DARK, 24)
	for k = 1, 12 do
		local a = (k / 12) * math.pi * 2 + Art.Hash(k, 7) * 0.4
		local rr = 0.25 + Art.Hash(k, 8) * 0.18
		local p = c + Vector3.new(math.cos(a) * w * rr, -20 - Art.Hash(k, 9) * 10, math.sin(a) * d * rr)
		Art.Shard(folder, p, 4 + Art.Hash(k, 3) * 4, 14 + Art.Hash(k, 4) * 14, 300 + k, k % 2 == 0 and ROCK or ROCK_DARK)
	end
	-- grass tufts / darker patches for variation
	for k = 1, 14 do
		local x = c.X + (Art.Hash(k, 11) - 0.5) * (w - 16)
		local z = c.Z + (Art.Hash(k, 12) - 0.5) * (d - 12)
		local PATCHES = { GRASS_DARK, Color3.fromRGB(132, 206, 96), Color3.fromRGB(104, 184, 104), Color3.fromRGB(150, 204, 90) }
		local patch = cyl(folder, "GrassPatch", Vector3.new(x, Y + 0.03, z), 0.06, 6 + Art.Hash(k, 13) * 8, PATCHES[k % #PATCHES + 1], false)
		patch.CanQuery = false
	end

	-- invisible walls keep everyone on the island
	for _, spec in {
		{ Vector3.new(w, 30, 1), Vector3.new(0, 15, -d / 2 - 0.5) },
		{ Vector3.new(w, 30, 1), Vector3.new(0, 15, d / 2 + 0.5) },
		{ Vector3.new(1, 30, d), Vector3.new(-w / 2 - 0.5, 15, 0) },
		{ Vector3.new(1, 30, d), Vector3.new(w / 2 + 0.5, 15, 0) },
	} do
		part(folder, { Name = "InvisibleWall", Size = spec[1], CFrame = CFrame.new(c + spec[2]), Transparency = 1, CanQuery = false })
	end

	-- log fences: low along the arena side (keeps the view), taller around the rest
	local fences = Instance.new("Folder")
	fences.Name = "Fences"
	fences.Parent = folder
	local xL, xR = c.X - w / 2 + 1, c.X + w / 2 - 1
	fence(fences, Y, Vector2.new(xL, frontZ + 1), Vector2.new(c.X - 9, frontZ + 1), 2)
	fence(fences, Y, Vector2.new(c.X + 9, frontZ + 1), Vector2.new(xR, frontZ + 1), 2)
	fence(fences, Y, Vector2.new(xL, backZ - 1), Vector2.new(xR, backZ - 1), 4)
	fence(fences, Y, Vector2.new(xR, frontZ + 3), Vector2.new(xR, backZ - 3), 4)
	fence(fences, Y, Vector2.new(xL, frontZ + 3), Vector2.new(xL, backZ - 3), 4)

	--------------------------------------------------------------------
	-- v0.9.15 DISTRICT LAYOUT — four districts around the central plaza, each with its own colour,
	-- arch and signpost arm:
	--   PLAY  (front, orange)  the Launch Gate portals + both Armory rows on the overlook
	--   TRAIN (west, blue)     The Forge + the fenced Training Range paddock
	--   SHOP  (east, gold)     Spin Vault + Shop kiosk
	--   HALL  (back, teal)     spawn deck, How To Play, Quest board, the Hall of Fame boards and the
	--                          Ascended podium — every board has its own spot (nothing overlaps)
	--------------------------------------------------------------------
	local PLAY_C, TRAIN_C, SHOP_C, HALL_C = Art.Brand.Orange, Color3.fromRGB(56, 140, 255), GOLD, Art.Brand.Teal
	local plazaC = Vector3.new(c.X, Y, c.Z)
	local PLAZA_R = 22

	-- spawn: round deck with a teal rim (the SpawnLocation itself is invisible)
	local spawnPos = Vector3.new(c.X, Y, backZ - 18)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "YardSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 0.2, 14)
	spawn.CFrame = CFrame.new(spawnPos + Vector3.new(0, 0.1, 0))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = folder
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	cyl(folder, "SpawnRing", spawnPos + Vector3.new(0, 0.25, 0), 0.5, 18, HALL_C, false)
	cyl(folder, "SpawnDeck", spawnPos + Vector3.new(0, 0.3, 0), 0.5, 16, STONE, false)
	cyl(folder, "SpawnDeckInner", spawnPos + Vector3.new(0, 0.34, 0), 0.5, 9, STONE_D, false)

	-- the plaza: cream disc with one inlaid ring
	cyl(folder, "Plaza", plazaC + Vector3.new(0, 0.1, 0), 0.2, PLAZA_R * 2, PATH, false)
	cyl(folder, "PlazaRing", plazaC + Vector3.new(0, 0.14, 0), 0.2, PLAZA_R * 2 - 6, Color3.fromRGB(226, 212, 186), false)
	cyl(folder, "PlazaInner", plazaC + Vector3.new(0, 0.18, 0), 0.2, PLAZA_R * 2 - 9, PATH, false)
	-- four district-coloured inlays on the ring, one per direction
	for _, q in { { 0, -1, PLAY_C }, { -1, 0, TRAIN_C }, { 1, 0, SHOP_C }, { 0, 1, HALL_C } } do
		local pos = plazaC + Vector3.new(q[1] * (PLAZA_R - 3.75), 0.26, q[2] * (PLAZA_R - 3.75))
		part(folder, { Name = "Mosaic", Size = Vector3.new(2.2, 0.1, 2.2), CFrame = CFrame.new(pos) * CFrame.Angles(0, math.pi / 4, 0), Color = q[3], CanCollide = false, CanQuery = false })
	end
	tileFountain(folder, plazaC)
	for k = 0, 3 do
		local a = math.rad(45 + k * 90)
		local pos = plazaC + Vector3.new(math.cos(a) * 16.5, 0, math.sin(a) * 16.5)
		bench(folder, CFrame.lookAt(pos, Vector3.new(plazaC.X, Y, plazaC.Z)))
	end
	for k, pl in { Vector2.new(-16, -8), Vector2.new(16, -8), Vector2.new(-16, 8), Vector2.new(16, 8) } do
		planter(folder, plazaC + Vector3.new(pl.X, 0, pl.Y), k)
	end

	-- avenues: straight from the plaza into each district, then short branches to every station pad
	local paths = Instance.new("Folder")
	paths.Name = "Paths"
	paths.Parent = folder
	local P = function(x: number, z: number): Vector2
		return Vector2.new(c.X + x, c.Z + z)
	end
	local VAULT_C, SHOP_K, FORGE_C = Vector2.new(84, -14), Vector2.new(84, 16), Vector2.new(-84, -14)
	local RANGE = { xMin = c.X - w / 2 + 1, xMax = c.X - 46, zMin = c.Z + 4, zMax = backZ - 1 }
	local rangePad = Vector2.new(RANGE.xMax + 5 - c.X, (RANGE.zMin + RANGE.zMax) / 2 - c.Z)
	local TRAIN_J = rangePad.X -- junction straight in front of the Range pad (x −41)
	local ARMORY_Z = -(d / 2) + 16 -- armory walkway (pedestals sit at frontZ + 10)
	-- v0.9.16 Launch Gate walk: ONE straight promenade runs right behind all three portal steps and both
	-- Armory rows; the PLAY trunk meets it in the middle (no more diagonals cutting past the RUMBLE / DUEL
	-- pillars, no portal left standing on bare grass)
	path(paths, Y, P(0, -PLAZA_R + 1), P(0, ARMORY_Z)) -- PLAY: plaza -> Launch Gate promenade
	path(paths, Y, P(-w / 2 + 6, ARMORY_Z), P(0, ARMORY_Z))
	path(paths, Y, P(0, ARMORY_Z), P(w / 2 - 6, ARMORY_Z))
	-- v0.9.16b: the TRAIN junction sits 5 studs clear of the Range divider wall (x −46); the Range branch
	-- runs straight down the open east side of the Range instead of cutting across the wall's end
	path(paths, Y, P(-PLAZA_R + 1, 0), P(TRAIN_J, 0)) -- TRAIN avenue
	path(paths, Y, P(TRAIN_J, 0), P(FORGE_C.X + 10, FORGE_C.Y)) -- -> Forge pad
	path(paths, Y, P(TRAIN_J, 0), rangePad + Vector2.new(c.X, c.Z)) -- -> Range pad
	path(paths, Y, P(PLAZA_R - 1, 0), P(52, 0)) -- SHOP avenue
	path(paths, Y, P(52, 0), P(VAULT_C.X - 8, VAULT_C.Y)) -- -> Spin Vault pad
	path(paths, Y, P(52, 0), P(SHOP_K.X - 6, SHOP_K.Y)) -- -> Shop pad
	path(paths, Y, P(0, PLAZA_R - 1), P(0, 37)) -- HALL: plaza -> spawn
	path(paths, Y, P(10, 44), P(36, 53)) -- spawn -> Hall of Fame boards
	path(paths, Y, P(-10, 44), P(-30, 52)) -- spawn -> How To Play
	-- round junction pads where branches split (one clean shape, no crossing guide lines)
	for _, jn in { P(TRAIN_J, 0), P(52, 0), P(0, ARMORY_Z) } do
		cyl(paths, "PathBorder", Vector3.new(jn.X, Y + 0.05, jn.Y), 0.12, 9, Color3.fromRGB(214, 200, 176), false):SetAttribute("NoVary", true)
		cyl(paths, "Path", Vector3.new(jn.X, Y + 0.09, jn.Y), 0.18, 8, PATH, false)
		cyl(paths, "PathHub", Vector3.new(jn.X, Y + 0.2, jn.Y), 0.06, 2.2, GUIDE, false).Material = Enum.Material.Neon
	end

	-- district arches where each avenue leaves the plaza
	local toHall = { name = "HALL", icon = "trophy", color = HALL_C }
	districtArch(folder, plazaC + Vector3.new(0, 0, -31), 0, "PLAY", "portal", PLAY_C, 10, toHall)
	districtArch(folder, plazaC + Vector3.new(-30, 0, 0), math.rad(90), "TRAIN", "target", TRAIN_C, 10, toHall)
	districtArch(folder, plazaC + Vector3.new(30, 0, 0), math.rad(-90), "SHOP", "coins", SHOP_C, 10, toHall)
	districtArch(folder, plazaC + Vector3.new(0, 0, 29), math.rad(180), "HALL", "trophy", HALL_C, 10, { name = "PLAZA", color = Art.Brand.Ink })

	-- PLAY: the Launch Gate on the overlook — big CLASSIC arch flanked by RUMBLE / DUEL
	local portals = {
		{ "CLASSIC", "walk in to join", PLAY_C, 0, 8, 13, "Classic" },
		{ "RUMBLE", "walk in · random weapons", Color3.fromRGB(150, 90, 230), -26, 5, 9, "Rumble" },
		{ "DUEL", "coming soon", Color3.fromRGB(56, 140, 255), 26, 5, 9, "Duel" },
	}
	for _, spec in portals do
		local x, z = c.X + spec[4], frontZ + (spec[4] == 0 and 9 or 11)
		local half, hgt = spec[5], spec[6]
		local col = spec[3]
		for _, sx in { -1, 1 } do
			cyl(folder, "GatePillarBase", Vector3.new(x + sx * half, Y + 0.6, z), 1.2, 3.6, IRON)
			cyl(folder, "GatePillar", Vector3.new(x + sx * half, Y + hgt / 2, z), hgt, 2.6, STONE)
		end
		part(folder, { Name = "GateBeam", Size = Vector3.new(half * 2 + 4, 2.4, 3.2), CFrame = CFrame.new(x, Y + hgt + 0.6, z), Color = col })
		part(folder, { Name = "GateBeamUnder", Size = Vector3.new(half * 2 + 2.6, 0.6, 3.4), CFrame = CFrame.new(x, Y + hgt - 0.6, z), Color = STONE_D, CanCollide = false })
		sign(folder, CFrame.new(x, Y + hgt + 0.6, z), Vector3.new(half * 2 + 3, 2.2, 3.3), {
			{ text = spec[1], color = Color3.new(1, 1, 1), size = 70, display = true },
		}, col, true).CanCollide = false
		part(folder, { Name = "GateStep", Size = Vector3.new(half * 2 + 2, 0.4, 3), CFrame = CFrame.new(x, Y + 0.2, z + 1.8), Color = STONE_D })
		local field = part(folder, { Name = "PortalField", Size = Vector3.new(half * 2 - 2.6, hgt - 0.8, 0.3), CFrame = CFrame.new(x, Y + hgt / 2 - 0.1, z), Material = Enum.Material.ForceField, Color = col, Transparency = 0, CanCollide = false })
		Art.Light(field, col, 10, 0.5)
		-- v1.0.1: the portals WORK: walking through = join the next match + vote this mode
		-- (RoundService listens for the "CrumblePortal" tag; DUEL says "coming soon")
		local trigger = part(folder, { Name = "PortalTrigger", Size = Vector3.new(half * 2 - 2.6, hgt - 0.8, 3), CFrame = CFrame.new(x, Y + hgt / 2 - 0.1, z), Transparency = 1, CanCollide = false })
		trigger.CanTouch = true
		trigger.CastShadow = false
		trigger:SetAttribute("PortalMode", spec[7])
		trigger:AddTag("CrumblePortal")
		plate(folder, Vector3.new(x, Y + hgt + 4.4, z), spec[2], nil, col, spec[4] == 0 and 9 or 7)
	end
	for _, sx in { -1, 1 } do
		telescope(folder, Vector3.new(c.X + sx * 15, Y, frontZ + 4), Config.Arena.Center)
	end

	-- lamp posts: plaza rim + district avenues (roof cap = district colour)
	for _, lp in { { -12, 20, HALL_C }, { 12, 20, HALL_C }, { -26, -15, PLAY_C }, { 26, -15, PLAY_C }, { -52, -9, TRAIN_C }, { 44, -8, SHOP_C }, { -26, 12, TRAIN_C }, { 26, 12, SHOP_C } } do
		lampPost(folder, plazaC + Vector3.new(lp[1], 0, lp[2]), lp[3])
	end
	for _, corner in { Vector2.new(-1, -1), Vector2.new(1, -1) } do
		lampPost(folder, c + Vector3.new(corner.X * (w / 2 - 4), 0, corner.Y * (d / 2 - 4)), PLAY_C)
	end

	-- TRAIN + SHOP stations (local −Z = the side facing the plaza)
	LobbyBuilder.BuildVault(folder, CFrame.new(c.X + VAULT_C.X, Y, c.Z + VAULT_C.Y) * CFrame.Angles(0, math.rad(90), 0))
	LobbyBuilder.BuildShop(folder, CFrame.new(c.X + SHOP_K.X, Y, c.Z + SHOP_K.Y) * CFrame.Angles(0, math.rad(90), 0))
	LobbyBuilder.BuildForge(folder, CFrame.new(c.X + FORGE_C.X, Y, c.Z + FORGE_C.Y) * CFrame.Angles(0, math.rad(-90), 0))
	LobbyBuilder.BuildRange(folder, RANGE.xMin, RANGE.xMax, RANGE.zMin, RANGE.zMax, Y)

	-- signpost in the plaza: one arm per district
	signpost(folder, plazaC + Vector3.new(-9, 0, -19), {
		{ "PLAY", PLAY_C, Vector3.new(0, 0, -1), "portal" },
		{ "TRAIN", TRAIN_C, Vector3.new(-1, 0, 0), "target" },
		{ "SHOP", SHOP_C, Vector3.new(1, 0, 0), "coins" },
		{ "HALL", HALL_C, Vector3.new(0, 0, 1), "trophy" },
	})

	-- set dressing
	local deco = Instance.new("Folder")
	deco.Name = "YardDecor"
	deco.Parent = folder
	-- PLAY: the Armory — two rows of pedestals along the arena-side fence
	local slots = {}
	for i = 1, #Weapons.List do
		if i <= 5 then
			table.insert(slots, Vector3.new(c.X - 106 + (i - 1) * 12, Y, frontZ + 10))
		else
			table.insert(slots, Vector3.new(c.X + 50 + (i - 6) * 12, Y, frontZ + 10))
		end
	end
	for i, def in Weapons.List do
		local pos = slots[i]
		local col = Rarity.Colors[def.Rarity] or Color3.new(1, 1, 1)
		armoryStump(deco, pos, col)
		display(deco, def.Id, 1, pos + Vector3.new(0, 3.05, 0), def.Limb == "Leg" and 1.6 or 1.35)
		plate(deco, pos + Vector3.new(0, 7.4, 0), string.upper(def.Name), string.upper(def.Rarity) .. " · " .. Descriptions.Weapon(def.Id).Tag, col, 5.6)
	end
	do -- mystery pedestal (next content drop)
		local pos = Vector3.new(c.X + 50 + (#Weapons.List - 5) * 12, Y, frontZ + 10)
		if #Weapons.List - 5 < 5 then
			armoryStump(deco, pos, Color3.fromRGB(200, 196, 214))
			crate(deco, pos + Vector3.new(0, 3.05, 0), 2.2, 0.4)
			plate(deco, pos + Vector3.new(0, 7.4, 0), "???", "SOON", Color3.fromRGB(120, 120, 150), 4.4)
		end
	end
	plate(deco, Vector3.new(c.X - 82, Y + 12, frontZ + 10), "ARMORY", Descriptions.Stations.Armory, PLAY_C, 8, "swords")
	plate(deco, Vector3.new(c.X + 74, Y + 12, frontZ + 10), "ARMORY", Descriptions.Stations.Armory, PLAY_C, 8, "swords")

	-- HALL: the back row — How To Play (left), Quest board (centre), Hall of Fame boards (right, built by
	-- LeaderboardService at x +20/+36/+52) — and the Ascended podium in front of the boards
	local hallZ = backZ - 4
	for _, sx in { -1, 1 } do
		cyl(folder, "HowToPost", Vector3.new(c.X - 30 + sx * 12.6, Y + 5, hallZ + 0.4), 10, 1.2, WOOD_DARK)
	end
	part(folder, { Name = "HowToBoard", Size = Vector3.new(23.4, 11.4, 0.5), CFrame = CFrame.new(c.X - 30, Y + 7.6, hallZ), Color = CREAM })
	part(folder, { Name = "HowToRoof", Size = Vector3.new(26.4, 0.9, 2.2), CFrame = CFrame.new(c.X - 30, Y + 14, hallZ + 0.2), Color = HALL_C, CanCollide = false })
	sign(folder, CFrame.new(c.X - 30, Y + 7.6, hallZ), Vector3.new(24, 12, 0.8), {
		{ text = "HOW TO PLAY", color = PLAY_C, size = 100 },
		{ text = "KNOCK THEM OFF · LAST ONE UP WINS", size = 52, display = true },
		{ text = "SHOVE  —  CLICK / F", size = 56, icon = "boot" },
		{ text = "RUSH  —  SHIFT / Q", size = 56, icon = "bolt" },
		{ text = "BLOCK  —  HOLD E", size = 56, icon = "lock" },
		{ text = "AMBER CRACKS · RED DROPS", size = 56, icon = "warn", color = Color3.fromRGB(200, 110, 10) },
	})
	questBoard(folder, Vector3.new(c.X, Y, hallZ))
	local sp = Vector3.new(c.X + 36, Y, c.Z + 41)
	cyl(deco, "PodiumStep", sp + Vector3.new(0, 0.4, 0), 0.8, 9, STONE_D)
	cyl(deco, "Podium", sp + Vector3.new(0, 1.3, 0), 1.4, 7, STONE)
	cyl(deco, "PodiumRing", sp + Vector3.new(0, 2.05, 0), 0.2, 7.3, GOLD, false)
	display(deco, "Boot", 10, sp + Vector3.new(0, 2.2, 0), 2.2)
	plate(deco, sp + Vector3.new(0, 8.6, 0), "L10 BOOT", "max level", GOLD, 6, "crown")

	-- east corner garden (behind the Shop): flower beds + windmill
	for k = 0, 2 do
		flowerBed(deco, Vector3.new(c.X + 74 + k * 11, Y, c.Z + 44), 8, 3.4, k)
	end
	windmill(deco, Vector3.new(c.X + 106, Y, c.Z + 30))

	-- trees, hedges, barrels, crates, rocks, mushrooms (kept off paths and sight-lines)
	for _, t in {
		{ "pine", 66, 57, 12 }, { "pine", 114, 54, 13 }, { "round", -44, -30, 10 }, { "round", 44, -30, 10 },
		{ "round", -108, -18, 9 }, { "pine", 114, -22, 12 }, { "pine", -114, -26, 12 }, -- v0.9.15: nothing stands in front of the HALL boards
		{ "pine", -60, -32, 11 }, { "pine", 62, -32, 11 }, { "round", 112, 12, 9 },
	} do
		local pos = Vector3.new(c.X + t[2], Y, c.Z + t[3])
		if t[1] == "pine" then
			pine(deco, pos, t[4])
		else
			roundTree(deco, pos, t[4])
		end
	end
	for _, b in { { -97, 2 }, { -99.5, 5 }, { 98, 2 } } do
		barrel(deco, Vector3.new(c.X + b[1], Y, c.Z + b[2]))
	end
	for k, cr in { { 98, -2, 2.4 }, { -94, 6, 2.2 }, { 62, 50, 2.6 } } do
		crate(deco, Vector3.new(c.X + cr[1], Y, c.Z + cr[2]), cr[3], k * 0.4)
	end
	for k, r in { { -28, 40, 3.5 }, { 36, 18, 3 }, { 98, 52, 4 }, { -38, -56, 2.4 }, { 38, -56, 2.2 } } do
		rock(deco, Vector3.new(c.X + r[1], Y, c.Z + r[2]), r[3], k)
	end
	for k, mpos in { { -26, 44 }, { -25, 46 }, { 30, 12 }, { 96, 55 }, { 62, 12 } } do
		mushroom(deco, Vector3.new(c.X + mpos[1], Y, c.Z + mpos[2]), 1 + (k % 2) * 0.5, k)
	end

	-- drifting white sparkles over the Yard (reference look)
	local sparkle = part(folder, { Name = "Sparkles", Size = Vector3.new(w, 1, d), CFrame = CFrame.new(c + Vector3.new(0, 24, 0)), Transparency = 1, CanCollide = false, CanQuery = false })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 10
	pe.Lifetime = NumberRange.new(6, 9)
	pe.Speed = NumberRange.new(1.5, 3)
	pe.EmissionDirection = Enum.NormalId.Bottom
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.3), NumberSequenceKeypoint.new(1, 0) })
	pe.Color = ColorSequence.new(Color3.new(1, 1, 1))
	pe.LightEmission = 0.8
	pe.Transparency = NumberSequence.new(0.1, 0.6)
	pe.Parent = sparkle

	local sceneryFolder = Instance.new("Folder")
	sceneryFolder.Name = "Scenery"
	sceneryFolder.Parent = folder
	scenery(sceneryFolder)

	-- invisible rectangular collider so rounded floor corners never drop anyone
	part(folder, { Name = "FloorCollider", Size = Vector3.new(w, 4, d), CFrame = CFrame.new(c - Vector3.new(0, 2.02, 0)), Transparency = 1 })
	-- v0.9.10 detail: wildflower clusters along the side and back fences (every cluster a new colour)
	local wild = Instance.new("Folder")
	wild.Name = "Wildflowers"
	wild.Parent = folder
	local function cluster(pos: Vector3, k: number)
		local col = FLOWERS[k % #FLOWERS + 1]
		for q = 1, 3 do
			local a = q * 2.1 + k
			local p = pos + Vector3.new(math.cos(a) * 0.7, 0, math.sin(a) * 0.7)
			local h = 0.7 + Art.Hash(k, q, 31) * 0.6
			cyl(wild, "WildStem", p + Vector3.new(0, h / 2, 0), h, 0.12, GRASS_DARK, false)
			ball(wild, "WildBloom", p + Vector3.new(0, h + 0.1, 0), Vector3.new(0.6, 0.45, 0.6), col, false)
		end
		ball(wild, "WildLeaf", pos + Vector3.new(0, 0.2, 0), Vector3.new(1.8, 0.5, 1.4), Art.Shade(GRASS_DARK, 1.06), false)
	end
	local kk = 0
	for z = frontZ + 24, backZ - 8, 9 do
		for _, sx in { -1, 1 } do
			kk += 1
			if not (sx < 0 and z > RANGE.zMin - 4) then -- (the Training Range owns the west back corner)
				cluster(Vector3.new(c.X + sx * (w / 2 - 3), Y, z + (Art.Hash(kk, 41) - 0.5) * 3), kk)
			end
		end
	end
	for x = c.X - w / 2 + 10, c.X + w / 2 - 10, 10 do
		if x > c.X + 64 then -- (the HALL back row and the Range own the rest of the back fence)
			kk += 1
			cluster(Vector3.new(x + (Art.Hash(kk, 42) - 0.5) * 3, Y, backZ - 3.2), kk)
		end
	end
	-- v0.9.10 variety pass: logs, crates, barrels, rocks and island stone get related tones
	do
		local F = Art.Families
		Art.Vary(folder, { F.Wood, F.WoodLight, F.WoodDark, F.Rock, F.RockDark, F.Grass, F.Dirt }, 7, function(p)
			return p.Name == "Floor" or p.Name == "Path" or p.Name == "Plaza" or p.Name == "PlazaInner"
		end)
	end
	-- reference look: flat colours + rounded edges on every block
	-- (weapon display models are finished by WeaponVisuals; station models are softened here)
	Art.Toon(folder, 0)
	local stations = { SpinVault = true, Forge = true, TrainingRange = true }
	Art.SoftenAll(folder, { MaxRadius = 6, Ratio = 0.22, MinRadius = 0.2, Filter = function(p)
		if p.Name == "InvisibleWall" or p.Name == "FloorCollider" then
			return false
		end
		local model = p:FindFirstAncestorWhichIsA("Model")
		return model == nil or stations[model.Name] == true
	end })
	-- v0.9.13: tame lobby glare (big/white neon + strong lights); also covers weapon displays and the
	-- Hall of Fame boards that are added later
	Art.TameGlow(folder)
	folder.Parent = workspace
	return spawn
end

function LobbyBuilder.RangeInfo(): RangeInfo?
	return rangeInfo
end

function LobbyBuilder.RandomSpawnCFrame(): CFrame
	local c = L.Center
	local d = L.Size.Y
	local pos = Vector3.new(c.X + math.random(-6, 6), c.Y + 4, c.Z + d / 2 - 18 + math.random(-4, 4))
	return CFrame.lookAt(pos, Vector3.new(Config.Arena.Center.X, pos.Y, Config.Arena.Center.Z))
end

return LobbyBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — ProgressionService (server-authoritative)
	Spin Vault (earned spins + the hourly coin spin, pity), Forge (merge, Merge All; the Boot merges too),
	wildcards (2:1 same rarity, 3:1 up-tier), equipping, starter quests, DEV grants.

	Every request goes through one RemoteFunction ("Request") and is fully validated here.
	Each action runs WITHOUT yielding between the check and the write, so merges/spins are
	atomic: they either fully happen or don't happen at all (no lost items).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local Progression = require(Shared.Progression)

local DataService = require(script.Parent.DataService)

local S = Config.Spins
local MG = Config.Merge

local ProgressionService = {}

local toastRemote = Net.Get("Toast")
local lastRequest: { [Player]: number } = {}
local inRoundCheck: ((Player) -> boolean)? = nil
local rangeModeSetter: ((Player, string) -> ())? = nil

type Result = { [string]: any }

local function fail(msg: string): Result
	return { Ok = false, Msg = msg }
end

------------------------------------------------------------------------
-- Spins
------------------------------------------------------------------------
local function rollFrom(tiers: { string }): string
	local total = 0
	for _, r in tiers do
		total += S.Odds[r]
	end
	local x = math.random() * total
	for _, r in tiers do
		x -= S.Odds[r]
		if x <= 0 then
			return r
		end
	end
	return tiers[#tiers]
end

local function rollRarity(p: DataService.Profile): (string, string?)
	p.Pity.Epic += 1
	p.Pity.Legendary += 1
	p.Pity.Mythic += 1
	local rarity: string
	local pity: string? = nil
	if p.Pity.Mythic >= S.Pity.Mythic then
		rarity, pity = "Mythic", "Mythic"
	elseif p.Pity.Legendary >= S.Pity.Legendary then
		rarity, pity = rollFrom({ "Legendary", "Mythic" }), "Legendary"
	elseif p.Pity.Epic >= S.Pity.Epic then
		rarity, pity = rollFrom({ "Epic", "Legendary", "Mythic" }), "Epic"
	else
		rarity = rollFrom(Rarity.Order)
	end
	local idx = Rarity.Index(rarity)
	if idx >= 4 then
		p.Pity.Epic = 0
	end
	if idx >= 5 then
		p.Pity.Legendary = 0
	end
	if idx >= 6 then
		p.Pity.Mythic = 0
	end
	return rarity, pity
end

-- One spin, applied to the profile. Returns a description for the reveal.
local function spinOnce(p: DataService.Profile): Result
	local rarity, pity = rollRarity(p)
	p.TotalSpins += 1

	-- pick a weapon in that rarity; ones you don't own come first
	local pool = Progression.WeaponsOfRarity(rarity, true) -- v0.9.1: Boot copies come from spins
	if #pool == 0 then
		pool = Progression.WeaponsOfRarity("Common")
	end
	local unowned = {}
	for _, def in pool do
		if not p.Weapons[def.Id] then
			table.insert(unowned, def)
		end
	end
	local list = #unowned > 0 and unowned or pool
	local def = list[math.random(1, #list)]

	local res: Result = { WeaponId = def.Id, Rarity = def.Rarity, Pity = pity }
	local owned = p.Weapons[def.Id]
	if not owned then
		p.Weapons[def.Id] = { Level = 1, Copies = 0 }
		res.Kind = "New"
	elseif owned.Level >= Rarity.MaxLevel then
		local coins = MG.MaxedRefund[def.Rarity] or 40
		p.Coins += coins
		res.Kind = "Refund"
		res.Coins = coins
	else
		owned.Copies += 1
		res.Kind = "Copy"
		res.Copies = owned.Copies
		res.Need = Progression.CopiesFor(def.Rarity, owned.Level)
		res.Level = owned.Level
	end
	return res
end

------------------------------------------------------------------------
-- Actions
------------------------------------------------------------------------
local Actions: { [string]: (Player, DataService.Profile, any, any) -> Result } = {}

-- v0.9.22 AUTO MERGE pass: merge every weapon as far as its own copies + coins allow. Returns the upgrades.
local mergeOne: (DataService.Profile, string) -> (boolean, string?)
local function mergeEverything(p: DataService.Profile): { { WeaponId: string, From: number, To: number } }
	local ups = {}
	for _, def in Weapons.List do
		local owned = p.Weapons[def.Id]
		if owned then
			local from = owned.Level
			for _ = 1, Rarity.MaxLevel do
				-- own copies only: wildcards stay for the player to spend where they want
				local check = Progression.CheckMerge(p, def.Id)
				if not check.Ok or check.UseWild > 0 or not mergeOne(p, def.Id) then
					break
				end
			end
			if owned.Level > from then
				table.insert(ups, { WeaponId = def.Id, From = from, To = owned.Level })
			end
		end
	end
	return ups
end

-- after any spin: pass owners with AUTO MERGE on get their new copies merged right away
local function afterSpins(player: Player, p: DataService.Profile, res: Result): Result
	if p.AutoMerge and DataService.HasPass(player, "AutoMerge") then
		local ups = mergeEverything(p)
		if #ups > 0 then
			res.Merged = ups
		end
	end
	return res
end

Actions.Spin = function(player, p, count)
	local n = math.clamp(math.floor(tonumber(count) or 1), 1, S.MaxBatch)
	n = math.min(n, p.Spins)
	if n <= 0 then
		return fail(string.format("No spins left. Earn them from levels (every %d), quests, the season, or the hourly coin spin.", Config.MilestoneSpinEvery))
	end
	local results = {}
	for _ = 1, n do
		p.Spins -= 1
		table.insert(results, spinOnce(p))
	end
	DataService.SaveSoon(player)
	return afterSpins(player, p, { Ok = true, Results = results })
end

-- v0.9.23: the COIN SPIN, once an hour (30 min with the FAST COIN SPINS pass), no weekly cap
local function waitText(left: number): string
	if left >= 3600 then
		return string.format("%dh %02dm", left // 3600, (left % 3600) // 60)
	end
	return string.format("%dm %02ds", left // 60, left % 60)
end

Actions.CoinSpin = function(player, p)
	local t = os.time()
	local at = p.CoinSpinAt or 0
	if t < at then
		return fail("Next coin spin in " .. waitText(at - t) .. ".")
	end
	if p.Coins < S.CoinSpinCost then
		return fail(string.format("A coin spin costs %d coins. Play rounds to earn more!", S.CoinSpinCost))
	end
	p.Coins -= S.CoinSpinCost
	p.CoinSpinAt = t + DataService.CoinSpinEvery(player)
	local results = { spinOnce(p) }
	DataService.SaveSoon(player)
	return afterSpins(player, p, { Ok = true, Results = results })
end

mergeOne = function(p: DataService.Profile, weaponId: string): (boolean, string?)
	local check = Progression.CheckMerge(p, weaponId)
	if not check.Ok then
		return false, check.Reason
	end
	local owned = p.Weapons[weaponId]
	local def = Weapons.ById[weaponId]
	p.Coins -= check.Coins
	owned.Copies -= check.UseOwn
	p.Wildcards[def.Rarity] -= check.UseWild
	owned.Level += 1
	return true, nil
end

Actions.Merge = function(player, p, weaponId)
	if type(weaponId) ~= "string" or not Weapons.ById[weaponId] then
		return fail("Unknown weapon.")
	end
	local from = p.Weapons[weaponId] and p.Weapons[weaponId].Level or 0
	local ok, reason = mergeOne(p, weaponId)
	if not ok then
		return fail(reason or "Can't merge.")
	end
	DataService.SaveSoon(player)
	return { Ok = true, WeaponId = weaponId, From = from, To = p.Weapons[weaponId].Level }
end

Actions.MergeAll = function(player, p, weaponId)
	if type(weaponId) ~= "string" or not Weapons.ById[weaponId] then
		return fail("Unknown weapon.")
	end
	local owned = p.Weapons[weaponId]
	if not owned then
		return fail("You don't own this weapon yet.")
	end
	local from = owned.Level
	local lastReason: string? = nil
	for _ = 1, Rarity.MaxLevel do
		local ok, reason = mergeOne(p, weaponId)
		if not ok then
			lastReason = reason
			break
		end
	end
	if owned.Level == from then
		return fail(lastReason or "Can't merge.")
	end
	DataService.SaveSoon(player)
	return { Ok = true, WeaponId = weaponId, From = from, To = owned.Level }
end

-- v0.9.22 AUTO MERGE pass: one button merges every weapon you own as far as it can go
Actions.MergeEverything = function(player, p)
	if not DataService.HasPass(player, "AutoMerge") then
		return fail("MERGE EVERYTHING comes with the AUTO MERGE pass (top of the Shop).")
	end
	local ups = mergeEverything(p)
	if #ups == 0 then
		return fail("Nothing to merge yet: you need more copies or coins.")
	end
	DataService.SaveSoon(player)
	return { Ok = true, Merged = ups }
end

Actions.SetAutoMerge = function(player, p, on)
	if type(on) ~= "boolean" then
		return fail("Bad value.")
	end
	p.AutoMerge = on
	DataService.SaveSoon(player)
	return { Ok = true }
end

-- 2 copies of one weapon → 1 wildcard of the same rarity
Actions.ToWildcard = function(player, p, weaponId)
	local def = type(weaponId) == "string" and Weapons.ById[weaponId]
	local owned = def and p.Weapons[weaponId]
	if not def or not owned then
		return fail("Pick a weapon you own.")
	end
	if owned.Copies < MG.SameRarityRate then
		return fail(string.format("Needs %d spare copies.", MG.SameRarityRate))
	end
	owned.Copies -= MG.SameRarityRate
	p.Wildcards[def.Rarity] += 1
	DataService.SaveSoon(player)
	return { Ok = true, Msg = string.format("+1 %s wildcard", def.Rarity) }
end

-- 3 copies of one weapon → 1 wildcard of the NEXT rarity
Actions.UpTier = function(player, p, weaponId)
	local def = type(weaponId) == "string" and Weapons.ById[weaponId]
	local owned = def and p.Weapons[weaponId]
	if not def or not owned then
		return fail("Pick a weapon you own.")
	end
	local nextR = Progression.NextRarity(def.Rarity)
	if not nextR then
		return fail("Mythic is the top rarity.")
	end
	if owned.Copies < MG.UpTierRate then
		return fail(string.format("Needs %d spare copies.", MG.UpTierRate))
	end
	owned.Copies -= MG.UpTierRate
	p.Wildcards[nextR] += 1
	DataService.SaveSoon(player)
	return { Ok = true, Msg = string.format("+1 %s wildcard", nextR) }
end

Actions.Equip = function(player, p, weaponId)
	if type(weaponId) ~= "string" or not p.Weapons[weaponId] then
		return fail("You don't own that weapon.")
	end
	p.Equipped = weaponId
	DataService.ClearDevOverride(player)
	return { Ok = true }
end

Actions.RangeMode = function(player, _p, mode)
	if mode ~= "current" and mode ~= "next" then
		return fail("Bad mode.")
	end
	if rangeModeSetter then
		(rangeModeSetter :: (Player, string) -> ())(player, mode)
	end
	return { Ok = true, Silent = true }
end

Actions.DevGrant = function(player, p, what)
	if not Config.DevMode then
		return fail("DevMode is off.")
	end
	if what == "spins" then
		p.Spins += 10
	elseif what == "coins" then
		p.Coins += 5000
	elseif what == "copies" then
		for _, def in Weapons.List do
			local o = p.Weapons[def.Id]
			if o then
				o.Copies += 2
			end
		end
	else
		return fail("Unknown grant.")
	end
	return { Ok = true }
end

------------------------------------------------------------------------
-- Starter quests (checked after every round)
------------------------------------------------------------------------
local function onRoundResult(player: Player, you: { [string]: any })
	local p = DataService.Get(player)
	if not p then
		return
	end
	local changed = false
	for _, q in Config.StarterQuests do
		if not p.Quests[q.Id] then
			local done = false
			if q.Id == "Survive60" then
				done = (you.SecondsAlive or 0) >= 60
			elseif q.Id == "KO1" then
				done = ((you.KOs or 0) + (you.BotKOs or 0)) >= 1
			elseif q.Id == "Top3" then
				done = (you.Placement or 99) <= 3 or you.Timeout == true
			end
			if done then
				p.Quests[q.Id] = true
				changed = true
				local reward = q.Coins and (q.Coins .. " coins") or ((q.Spins or 1) .. " SPIN")
				if q.Coins then
					p.Coins += q.Coins
				end
				if q.Spins then
					p.Spins += q.Spins
				end
				toastRemote:FireClient(player, "QUEST COMPLETE: " .. q.Text .. "  →  +" .. reward)
			end
		end
	end
	-- v0.9: daily quests, weekly chain, season XP (RetentionService)
	if ProgressionService.OnRoundResultExtra then
		local ok, err = pcall(ProgressionService.OnRoundResultExtra :: any, player, p, you)
		if not ok then
			warn("[CRUMBLE] retention round hook:", err)
		end
		changed = true
	end
	if changed then
		DataService.Push(player)
		DataService.SaveSoon(player)
	end
end

-- v0.9: other services add their own validated requests (quests, season, shop, tutorial)
ProgressionService.OnRoundResultExtra = nil :: ((Player, any, { [string]: any }) -> ())?
local inRoundOk: { [string]: boolean } = { RangeMode = true }
function ProgressionService.RegisterAction(name: string, fn: (Player, any, any, any) -> Result, allowInRound: boolean?)
	Actions[name] = fn
	if allowInRound then
		inRoundOk[name] = true
	end
end

------------------------------------------------------------------------
-- Init
------------------------------------------------------------------------
function ProgressionService.SetInRoundCheck(fn: (Player) -> boolean)
	inRoundCheck = fn
end

function ProgressionService.SetRangeModeSetter(fn: (Player, string) -> ())
	rangeModeSetter = fn
end

local LOADOUT_ACTIONS = { Merge = true, MergeAll = true, Equip = true }

function ProgressionService.Init()
	DataService.OnRoundResult = onRoundResult

	Net.GetFunction("Request").OnServerInvoke = function(player: Player, action: any, a: any, b: any): Result
		if type(action) ~= "string" or not Actions[action] then
			return fail("Unknown request.")
		end
		local t = os.clock()
		if lastRequest[player] and t - lastRequest[player] < 0.12 then
			return fail("Slow down!")
		end
		lastRequest[player] = t
		local p = DataService.Get(player)
		if not p then
			return fail("Your profile is still loading.")
		end
		if not inRoundOk[action] and inRoundCheck and (inRoundCheck :: (Player) -> boolean)(player) then
			return fail("Finish your round first!")
		end
		local ok, result = pcall(Actions[action], player, p, a, b)
		if not ok then
			warn("[CRUMBLE] request failed", action, result)
			return fail("Something went wrong. Nothing was spent.")
		end
		if result.Ok and not result.Silent then
			DataService.Push(player)
			if LOADOUT_ACTIONS[action] and DataService.OnLoadoutChanged then
				DataService.OnLoadoutChanged(player)
			end
		end
		return result
	end

	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">RangeService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — RangeService (Training Range in the Yard)
	Dummies on rails. Shove one and it flies exactly as far as it would in a real round
	(same launch formula + gravity), then shows the measured distance and glides back.
	v0.9.3: the flight is KINEMATIC (anchored root moved along the ballistic arc), joints are rigid,
	and the dummy stands back up where it lands — they can no longer collapse into a heap.
	Players can toggle "preview next level" to feel a merge before paying for it.

	Lives outside CombatService on purpose: combat is off between rounds, and the range must
	never interact with real matches.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)

local DataService = require(script.Parent.DataService)
local CombatService = require(script.Parent.CombatService)
local BotService = require(script.Parent.BotService)
local LobbyBuilder = require(script.Parent.LobbyBuilder)

local C = Config.Combat
local TU_FLASH = 0.25 -- the white "NOW!" flash before the sparring bot's swing lands

type Dummy = {
	Model: Model,
	Root: BasePart,
	Humanoid: Humanoid,
	Post: CFrame,
	Busy: boolean,
	Token: number,
	Label: TextLabel,
	Index: number,
}

local RangeService = {}

local dummies: { Dummy } = {}
local respawns: { [number]: number } = {} -- v0.9.3 watchdog rebuilds per dummy (max 3)
local mode: { [Player]: string } = {}
local readyAt: { [Player]: number } = {}
local follow: { [Player]: { Weapon: string, State: Weapons.FollowState } } = {} -- v0.9.18 Magnet push-pull
local combo: { [Player]: { Count: number, Start: number } } = {}
local info: LobbyBuilder.RangeInfo? = nil
local inRoundCheck: ((Player) -> boolean)? = nil

local effectRemote = Net.Get("Effect")
local resultRemote = Net.Get("RangeResult")
local sparRemote = Net.Get("Spar")
local knockbackRemote = Net.Get("Knockback")

-- v0.9 SPARRING BOT (tutorial + practice): stands at the front of the Range. Step close and
-- it winds up ("GET READY" red → "NOW!" white flash) and swings at you. Hold BLOCK through it
-- = BLOCKED; press BLOCK during the flash = PARRY; otherwise it shoves you back a little.
local blocking: { [Player]: boolean } = {}
local blockAt: { [Player]: number } = {}
local spar: { [Player]: { Block: boolean, Parry: boolean, Strikes: number } } = {}
-- v0.9.2 the real fight kit in the Range: shield (guard drains / recharges like a match) + rush
local guard: { [Player]: number } = {}
local guardRegenAt: { [Player]: number } = {}
local rushReadyAt: { [Player]: number } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function inZone(pos: Vector3): boolean
	local z = info
	if not z then
		return false
	end
	return pos.X >= z.Min.X and pos.X <= z.Max.X and pos.Y >= z.Min.Y and pos.Y <= z.Max.Y and pos.Z >= z.Min.Z and pos.Z <= z.Max.Z
end

------------------------------------------------------------------------
-- Dummies
------------------------------------------------------------------------
-- v0.9.4: every joint back to its rest pose (stops any animation track that might be holding a pose)
local function restPose(d: Dummy)
	local animator = d.Humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in animator:GetPlayingAnimationTracks() do
			track:Stop(0)
		end
	end
	for _, j in d.Model:GetDescendants() do
		if j:IsA("Motor6D") then
			j.Transform = CFrame.identity
		elseif j:IsA("AnimationConstraint") then
			pcall(function()
				(j :: any).Transform = CFrame.identity
			end)
		end
	end
end

local function resetDummy(d: Dummy)
	d.Token += 1
	local token = d.Token
	d.Busy = true
	d.Model:SetAttribute("LaunchedUntil", nil)
	d.Humanoid.PlatformStand = false
	d.Root.AssemblyLinearVelocity = Vector3.zero
	d.Root.AssemblyAngularVelocity = Vector3.zero
	d.Root.Anchored = true
	local tween = TweenService:Create(d.Root, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { CFrame = d.Post })
	tween:Play()
	tween.Completed:Wait()
	if d.Token ~= token then
		return
	end
	-- v0.9.1: dummies stay ANCHORED (upright) at rest. Un-anchoring them here handed their physics
	-- to the nearest player's client, and they slowly toppled into a heap on their posts.
	d.Root.CFrame = d.Post
	restPose(d)
	d.Busy = false
end

local function makeDummy(i: number, post: CFrame): Dummy?
	local model = BotService.MakeDummy("RangeDummy" .. i, Color3.fromRGB(230, 120, 40))
	if not model then
		return nil
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.AutoRotate = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	model:SetAttribute("IsDummy", true)
	model:SetAttribute("DisplayName", "Dummy")
	model:PivotTo(post)
	-- v0.9.1: never fall over by themselves
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum.BreakJointsOnDeath = false

	local gui = Instance.new("BillboardGui")
	gui.Name = "RangeLabel"
	-- v0.7.4: sized in studs (shrinks with distance) and not drawn on top of everything, so three
	-- results no longer cover the whole screen
	gui.Size = UDim2.new(6, 0, 1.3, 0)
	gui.StudsOffset = Vector3.new(0, 3.8, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	gui.Parent = root
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(230, 235, 245)
	label.TextStrokeTransparency = 0.2
	label.Text = "SHOVE ME"
	label.Parent = gui

	local folder = workspace:FindFirstChild("RangeDummies")
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "RangeDummies"
		f.Parent = workspace
		folder = f
	end
	model.Parent = folder
	root.Anchored = true -- at rest: anchored & upright (launch() frees it, resetDummy() re-anchors)
	-- v0.9.3: the WHOLE rig hangs off an anchored root with rigid joints: it can't sag or topple
	BotService.Rigidify(model)
	model.PrimaryPart = root
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			part.Anchored = false
			part.CanCollide = false -- limbs never shove the dummy over
		end
	end
	return { Model = model, Root = root, Humanoid = hum, Post = post, Busy = false, Token = 0, Label = label, Index = i }
end

-- Launch a dummy and measure where it lands.
local function launch(d: Dummy, velocity: Vector3, stun: number, labelPrefix: string, color: Color3, player: Player, extra: { [string]: any })
	-- v0.9.3: KINEMATIC flight. The root stays anchored and the server moves it along the exact
	-- ballistic arc of the launch velocity (same gravity as a real round), tumbling back onto the
	-- ground; then the dummy STANDS UP where it landed and glides home. No physics = no heaps.
	d.Token += 1
	local token = d.Token
	d.Busy = true
	d.Root.Anchored = true
	d.Humanoid.PlatformStand = false
	local start = d.Root.Position
	local groundY = d.Post.Position.Y
	local g = workspace.Gravity
	local vh = Vector3.new(velocity.X, 0, velocity.Z)
	local vy = math.max(velocity.Y, 6)
	local dy0 = math.max(start.Y - groundY, 0)
	local tFly = math.max((vy + math.sqrt(vy * vy + 2 * g * dy0)) / g, 0.4)
	local dirH = vh.Magnitude > 0.1 and vh.Unit or d.Post.LookVector
	-- knocked backwards: it tips over away from the hit and lands flat on its back
	local axis = dirH:Cross(Vector3.yAxis)
	local flips = vh.Magnitude > 40 and 1 or 0
	local tilt = -(math.pi / 2 + flips * 2 * math.pi)
	local base = d.Post.Rotation
	d.Model:SetAttribute("LaunchedUntil", workspace:GetServerTimeNow() + tFly + 0.1)
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		local t = math.min(os.clock() - t0, tFly)
		if d.Token ~= token then
			if conn then
				conn:Disconnect()
			end
			return
		end
		local u = t / tFly
		local p = start + vh * t + Vector3.new(0, vy * t - 0.5 * g * t * t, 0)
		-- lying flat puts the root lower (it's a body on the floor, not standing on its feet)
		local lie = math.clamp((u - 0.6) / 0.4, 0, 1)
		p = Vector3.new(p.X, math.max(p.Y, groundY) - 1.9 * lie * lie, p.Z)
		d.Root.CFrame = CFrame.new(p) * CFrame.fromAxisAngle(axis, tilt * (1 - (1 - u) * (1 - u))) * base
		if t >= tFly and conn then
			conn:Disconnect()
		end
	end)
	task.delay(tFly + 0.03, function()
		if d.Token ~= token then
			return
		end
		local landed = d.Root.Position
		local dist = flat(landed - start).Magnitude
		d.Model:SetAttribute("LaunchedUntil", nil)
		d.Label.Text = string.format("%s  %.1f st", labelPrefix, dist)
		d.Label.TextColor3 = color
		extra.Distance = math.floor(dist * 10 + 0.5) / 10
		if player.Parent then
			resultRemote:FireClient(player, extra)
		end
		local z = info
		local insideYard = z == nil
			or (landed.X >= z.Min.X and landed.X <= z.Max.X and landed.Z >= z.Min.Z and landed.Z <= z.Max.Z)
		if not insideYard then
			d.Root.CFrame = d.Post -- flew out of the yard: straight back onto its post
			restPose(d)
			d.Busy = false
			return
		end
		-- lie there a beat, then GET UP into the standing pose where it fell
		task.wait(0.35)
		if d.Token ~= token then
			return
		end
		restPose(d)
		local upright = base + Vector3.new(landed.X, groundY, landed.Z)
		TweenService:Create(d.Root, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = upright }):Play()
		task.wait(Config.Range.ResetDelay)
		if d.Token == token then
			resetDummy(d)
		end
	end)
end

------------------------------------------------------------------------
-- Shoving in the range
------------------------------------------------------------------------
local function onShove(player: Player, aim: any, clickTime: any)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not root or char:GetAttribute("InRange") ~= true then
		return
	end
	if inRoundCheck and (inRoundCheck :: (Player) -> boolean)(player) then
		return
	end
	local id, level = DataService.GetLoadout(player)
	local def = Weapons.Get(id)
	local preview = mode[player] == "next" and level < Rarity.MaxLevel
	if preview then
		level += 1
	end
	local t = now()
	if readyAt[player] and t < readyAt[player] then
		return
	end
	local fs = follow[player]
	if not fs or fs.Weapon ~= def.Id then
		fs = { Weapon = def.Id, State = Weapons.NewFollow() }
		follow[player] = fs
	end
	local step, nextReady = Weapons.FollowUp(def, fs.State, t)
	if not step then
		return
	end
	local repel = step == "repel"
	readyAt[player] = nextReady - 0.1

	local dir = Vector3.new(0, 0, -1)
	-- v0.9.7 RC: only the FLAT part counts (a straight-up vector would make .Unit NaN)
	if typeof(aim) == "Vector3" and aim.Magnitude < 1e4 and flat(aim).Magnitude > 0.01 then
		dir = flat(aim).Unit
	end
	-- v0.7.5 lag compensation (same rule as combat: resolve at click time + windup, max 0.2 s back)
	local windup = if repel then (def.RepelWindup or 0.1) else def.Windup
	local delay = windup
	if type(clickTime) == "number" and clickTime == clickTime then
		delay = math.max(0.02, windup - math.clamp(t - clickTime, 0, 0.2))
	end
	effectRemote:FireAllClients("Swing", { Model = char, Weapon = def.Id, Combo = repel, Windup = delay })

	task.delay(delay, function()
		if not root.Parent then
			return
		end
		local origin = root.Position
		local mult = Rarity.Multiplier(def.Rarity, level)
		local reach = (if repel then (def.RepelRange or 9) else def.Range) + C.BodyRadius
		local cone = if repel then (def.RepelCone or 0.3) else (def.Cone or 0.5)

		-- gather dummies in reach and in the aim cone (Pan = 360°)
		local hits: { { D: Dummy, Dist: number, Dir: Vector3? } } = {}
		for _, d in dummies do
			-- v0.9.18c: the REPEL also hits dummies that are still flying from your pull (Busy),
			-- and anything within 5 studs at any angle (a pulled dummy lands right next to you)
			if repel or not d.Busy then
				local off = flat(d.Root.Position - origin)
				local dist = off.Magnitude
				local okCone = def.Kind == "aoe" or (dist > 0.01 and dir:Dot(off.Unit) >= cone) or (repel and dist <= 5)
				if dist <= reach and okCone then
					table.insert(hits, { D = d, Dist = dist })
				end
			end
		end
		if def.Kind == "slam" then
			-- v0.9.20 Squeaky Hammer: everything around the impact spot in front of you
			hits = {}
			local center = origin + dir * (def.SlamOffset or 4.5)
			for _, d in dummies do
				if not d.Busy then
					local off = flat(d.Root.Position - center)
					if off.Magnitude <= (def.SlamRadius or 4.5) + C.BodyRadius then
						local away = if off.Magnitude > 0.5 then off.Unit else dir
						local push = flat(away + dir * 0.8)
						table.insert(hits, { D = d, Dist = off.Magnitude, Dir = if push.Magnitude > 1e-3 then push.Unit else dir })
					end
				end
			end
			effectRemote:FireAllClients("Slam", { Position = center - Vector3.new(0, 2.85, 0), Radius = def.SlamRadius or 4.5, Rarity = def.Rarity, Hits = #hits })
		end
		table.sort(hits, function(a, b)
			return a.Dist < b.Dist
		end)
		-- v0.9.11 polish: the Range shows the Slingshot pellet, the Bomb Bag lob and the Pan ring,
		-- exactly like the arena does (hits land when the shot arrives)
		if def.Kind == "projectile" or def.Kind == "thrown" then
			local first = hits[1]
			local from = origin + Vector3.new(0, 1.5, 0)
			local to = if first then first.D.Root.Position else origin + dir * def.Range
			if def.Kind == "thrown" and not first then
				to -= Vector3.new(0, 2.4, 0)
			end
			local speed = if def.Kind == "projectile" then (def.Speed or 90) else 45
			local travel = math.clamp((to - from).Magnitude / speed, 0.08, 0.5)
			effectRemote:FireAllClients("RangeShot", { From = from, To = to, Time = travel, Kind = def.Kind, Rarity = def.Rarity })
			task.wait(travel)
			if not root.Parent then
				return
			end
			if def.Kind == "thrown" and not first then
				effectRemote:FireAllClients("Explosion", { Position = to, Radius = def.BlastRadius or 7 })
			end
		elseif def.Kind == "aoe" then
			effectRemote:FireAllClients("PanRing", { Position = origin, Radius = def.Range, Rarity = def.Rarity })
		end
		local maxTargets = (def.Kind == "arc" or def.Kind == "slam") and (def.MaxTargets or 3) or (def.Kind == "aoe" and 99 or 1)
		if repel then
			maxTargets = def.RepelMaxTargets or 3
			effectRemote:FireAllClients("Repel", { Model = char, Position = origin, Dir = dir, Range = def.RepelRange or 9 })
		end
		if def.Kind == "thrown" and hits[1] then
			-- bomb: everything within the blast radius of the first target
			local center = hits[1].D.Root.Position
			local blast = {}
			for _, d in dummies do
				if not d.Busy and flat(d.Root.Position - center).Magnitude <= (def.BlastRadius or 7) then
					table.insert(blast, { D = d, Dist = 0 })
				end
			end
			hits = blast
			maxTargets = 99
			effectRemote:FireAllClients("Explosion", { Position = center, Radius = def.BlastRadius or 7 })
		end

		-- Gloves combo: 3rd jab within the window uses the combo knockback
		local kbBase = if repel then (def.RepelKB or def.KB) else def.KB
		local comboText = ""
		if def.ComboKB and #hits > 0 then
			local cs = combo[player]
			if not cs or t - cs.Start > (def.ComboWindow or 1.5) then
				cs = { Count = 0, Start = t }
				combo[player] = cs
			end
			local state = cs :: { Count: number, Start: number }
			state.Count += 1
			if state.Count >= (def.ComboHits or 3) then
				kbBase = def.ComboKB
				comboText = " COMBO"
				combo[player] = nil
			end
		end

		local color = Rarity.Colors[def.Rarity]
		if repel then
			comboText = " REPEL"
		end
		local prefix = string.format("L%d%s%s", level, preview and " (preview)" or "", comboText)
		for k, h in hits do
			if k > maxTargets then
				break
			end
			local d = h.D
			local away = flat(d.Root.Position - origin)
			local awayDir = away.Magnitude > 0.01 and away.Unit or dir
			if h.Dir then
				awayDir = h.Dir
			end
			if repel then
				-- close dummies fly where you face (same rule as the arena repel)
				local blend = math.clamp(1 - away.Magnitude / reach, 0, 1)
				local push = flat(awayDir * (1 - blend) + dir * (blend + 0.35))
				awayDir = push.Magnitude > 1e-3 and push.Unit or dir
			end
			local vel, stun
			local kb = math.min(kbBase * mult, C.KBCap)
			if def.Kind == "pull" and not repel then
				local pull = math.min(kb, math.max(0, h.Dist - 4.5)) -- v0.9.18c: stop in front, not on top
				vel, stun = CombatService.LaunchVelocity(-awayDir, pull, 3)
				kb = pull
				effectRemote:FireAllClients("Tether", { From = char, To = d.Model, Color = color, Weapon = def.Id, Hold = 0.3 }) -- v0.9.11 magnet field
			elseif def.Kind == "tether" then
				-- v0.7.1: yank to the player, then launch along the player's aim (measured from the yank point)
				local pull = math.max(0, h.Dist - 4)
				local pv, ps = CombatService.LaunchVelocity(-awayDir, math.min(pull, C.KBCap), 3)
				effectRemote:FireAllClients("Tether", { From = char, To = d.Model, Color = color, Weapon = def.Id, Hold = def.SlamDelay or 0.4 })
				launch(d, pv, ps, prefix .. " yank", color, player, { Weapon = def.Id, Level = level, Preview = preview, Expected = 0, Combo = false })
				local slamKB = kb
				task.delay(def.SlamDelay or 0.4, function()
					if not d.Model.Parent then
						return
					end
					local sv, ss = CombatService.LaunchVelocity(dir, slamKB)
					effectRemote:FireAllClients("Hit", { Model = d.Model, Position = d.Root.Position, KB = slamKB, Rarity = def.Rarity, Attacker = char })
					launch(d, sv, ss, prefix, color, player, { Weapon = def.Id, Level = level, Preview = preview, Expected = math.floor(slamKB * 10 + 0.5) / 10, Combo = false })
				end)
				continue
			elseif def.Lift then
				vel, stun = CombatService.LaunchVelocity(awayDir, kb, def.Lift * mult)
			else
				vel, stun = CombatService.LaunchVelocity(awayDir, kb)
			end
			effectRemote:FireAllClients("Hit", { Model = d.Model, Position = d.Root.Position, KB = kb, Rarity = def.Rarity, Attacker = char })
			launch(d, vel, stun, prefix, color, player, {
				Weapon = def.Id,
				Level = level,
				Preview = preview,
				Expected = math.floor(kb * 10 + 0.5) / 10,
				Combo = comboText ~= "",
			})
		end
	end)
end

------------------------------------------------------------------------
-- v0.9 sparring bot
------------------------------------------------------------------------
local function charOf(player: Player): Model?
	local ch = player.Character
	if ch and ch:GetAttribute("InRange") == true then
		return ch
	end
	return nil
end

local function stopRangeBlock(player: Player)
	if blocking[player] then
		blocking[player] = false
		guardRegenAt[player] = now() + C.GuardRegenDelay
	end
	local ch = player.Character
	if ch and ch:GetAttribute("InRound") ~= true then
		ch:SetAttribute("Blocking", false)
	end
end

local function sparFor(player: Player): { Block: boolean, Parry: boolean, Strikes: number }
	local s = spar[player]
	if not s then
		s = { Block = false, Parry = false, Strikes = 0 }
		spar[player] = s
	end
	return s
end

function RangeService.SparInfo(player: Player): { Block: boolean, Parry: boolean, Strikes: number }
	return sparFor(player)
end

local function startSparBot(z: LobbyBuilder.RangeInfo)
	local y = z.Posts[1] and z.Posts[1].Position.Y or (z.Min.Y + 7)
	local home = Vector3.new(z.Max.X - 26, y, z.Min.Z + 4.6)
	local model = BotService.MakeDummy("SparringBot", Color3.fromRGB(56, 140, 255))
	if not model then
		return
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.AutoRotate = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	model:SetAttribute("IsDummy", true)
	model:SetAttribute("DisplayName", "Sparring Bot")
	local post = CFrame.lookAt(home, home + Vector3.new(1, 0, 0))
	model:PivotTo(post)
	root.Anchored = true
	-- v0.9.1: big, readable two-line sign (name + what to do right now)
	local gui = Instance.new("BillboardGui")
	gui.Name = "SparLabel"
	gui.Size = UDim2.new(14, 0, 3.4, 0)
	gui.StudsOffset = Vector3.new(0, 5, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 90
	gui.Parent = root
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.38)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextStrokeTransparency = 0
	title.TextStrokeColor3 = Color3.fromRGB(20, 40, 90)
	title.TextColor3 = Color3.fromRGB(120, 196, 255)
	title.Text = "SPARRING BOT"
	title.Parent = gui
	local label = Instance.new("TextLabel")
	label.Position = UDim2.fromScale(0, 0.4)
	label.Size = UDim2.fromScale(1, 0.6)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextWrapped = false -- v1.0: one line, never split over two lines
	label.Text = "Come close · hold BLOCK (E)"
	label.Parent = gui
	local folder = workspace:FindFirstChild("RangeDummies")
	model.Parent = folder or workspace

	task.spawn(function()
		while model.Parent do
			task.wait(0.25)
			-- the nearest player in the range within reach
			local best: Player? = nil
			local bestD = 10
			for _, pl in Players:GetPlayers() do
				local ch = pl.Character
				local r = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
				if ch and r and ch:GetAttribute("InRange") == true then
					local d = flat(r.Position - home).Magnitude
					if d < bestD and math.abs(r.Position.Y - home.Y) < 6 then
						best, bestD = pl, d
					end
				end
			end
			if not best then
				label.Text = "Come close · hold BLOCK (E)"
				label.TextColor3 = Color3.new(1, 1, 1)
				root.CFrame = post
				continue
			end
			local target = best :: Player
			local function targetRoot(): BasePart?
				local ch = target.Character
				return ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
			end
			local tr = targetRoot()
			if not tr then
				continue
			end
			local face = CFrame.lookAt(home, Vector3.new(tr.Position.X, home.Y, tr.Position.Z))
			root.CFrame = face
			-- wind-up: red "get ready", then the white "NOW!" flash
			label.Text = "GET READY..."
			label.TextColor3 = Color3.fromRGB(255, 80, 70)
			sparRemote:FireClient(target, { Kind = "WindUp" })
			task.wait(0.65)
			label.Text = "NOW! BLOCK!"
			label.TextColor3 = Color3.new(1, 1, 1)
			effectRemote:FireAllClients("Swing", { Model = model, Weapon = "Gloves", Combo = false, Windup = TU_FLASH })
			task.wait(TU_FLASH)
			local strikeAt = now()
			tr = targetRoot()
			local s = sparFor(target)
			s.Strikes += 1
			local result = "Miss"
			if tr and target.Character and target.Character:GetAttribute("InRange") == true and flat(tr.Position - home).Magnitude <= 11 then
				if blocking[target] then
					local early = strikeAt - (blockAt[target] or -99)
					if early <= Config.Tutorial.ParryWindow + TU_FLASH then
						result = "Parry"
						s.Parry = true
						effectRemote:FireAllClients("Parry", { Position = tr.Position })
					else
						result = "Block"
						s.Block = true
						effectRemote:FireAllClients("Blocked", { Position = tr.Position })
						guard[target] = math.max(0, (guard[target] or C.GuardMax) - C.GuardDrainPerKB * 8)
						guardRegenAt[target] = now() + C.GuardRegenDelay
					end
				else
					result = "Hit"
					local dir = flat(tr.Position - home)
					dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(1, 0, 0)
					knockbackRemote:FireClient(target, dir * 34 + Vector3.new(0, 16, 0), 0.45)
					effectRemote:FireAllClients("Hit", { Model = target.Character, Position = tr.Position, KB = 8, Rarity = "Common", Attacker = model })
				end
			end
			-- lunge forward and back
			local lunge = TweenService:Create(root, TweenInfo.new(0.1), { CFrame = face * CFrame.new(0, 0, -1.4) })
			lunge:Play()
			lunge.Completed:Wait()
			TweenService:Create(root, TweenInfo.new(0.3), { CFrame = face }):Play()
			label.Text = result == "Parry" and "PARRY!! PERFECT" or result == "Block" and "BLOCKED! Tap BLOCK at NOW!" or result == "Hit" and "OOF! Hold BLOCK (E)" or "..."
			label.TextColor3 = result == "Parry" and Color3.fromRGB(255, 220, 100) or result == "Block" and Color3.fromRGB(110, 210, 255) or Color3.fromRGB(255, 150, 120)
			sparRemote:FireClient(target, { Kind = result, Strikes = s.Strikes })
			task.wait(1.6)
		end
	end)
end

------------------------------------------------------------------------
-- Init / Step
------------------------------------------------------------------------
function RangeService.SetMode(player: Player, m: string)
	mode[player] = m
end

function RangeService.SetInRoundCheck(fn: (Player) -> boolean)
	inRoundCheck = fn
end

function RangeService.Init()
	info = LobbyBuilder.RangeInfo()
	if info then
		local posts = (info :: LobbyBuilder.RangeInfo).Posts
		task.spawn(function() -- building rigs can yield; don't hold up server start
			for i, post in posts do
				local d = makeDummy(i, post)
				if d then
					table.insert(dummies, d)
				end
			end
			startSparBot(info :: LobbyBuilder.RangeInfo)
		end)
	end
	Net.Get("Action").OnServerEvent:Connect(function(player: Player, action: any, aim: any, clickTime: any)
		if action == "Shove" then
			onShove(player, aim, clickTime)
		elseif action == "BlockStart" then
			local ch = charOf(player)
			if not ch or (inRoundCheck and (inRoundCheck :: (Player) -> boolean)(player)) then
				return
			end
			if (guard[player] or C.GuardMax) < C.MinBlockGuard then
				return -- shield still recharging (same rule as a match)
			end
			blocking[player] = true
			blockAt[player] = now()
			ch:SetAttribute("Blocking", true) -- shield bubble + guard pose + HUD
		elseif action == "BlockEnd" then
			stopRangeBlock(player)
		elseif action == "Rush" then
			local ch = charOf(player)
			if not ch or (inRoundCheck and (inRoundCheck :: (Player) -> boolean)(player)) then
				return
			end
			local t = now()
			if t < (rushReadyAt[player] or 0) then
				return
			end
			rushReadyAt[player] = t + C.RushCooldown - 0.1
			stopRangeBlock(player)
			ch:SetAttribute("RushUntil", t + C.RushTime + 0.12)
			effectRemote:FireAllClients("Rush", { Model = ch })
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		mode[player] = nil
		readyAt[player] = nil
		follow[player] = nil
		combo[player] = nil
		blocking[player] = nil
		blockAt[player] = nil
		spar[player] = nil
		guard[player] = nil
		guardRegenAt[player] = nil
		rushReadyAt[player] = nil
	end)
end

local accum = 0
function RangeService.Step(dt: number)
	accum += dt
	if accum < 0.25 then
		return
	end
	local stepDt = accum
	accum = 0
	local t = now()
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if char and root then
			local inside = inZone(root.Position) and not (inRoundCheck and (inRoundCheck :: (Player) -> boolean)(p))
			if (char:GetAttribute("InRange") == true) ~= inside then
				char:SetAttribute("InRange", inside)
				if not inside then
					stopRangeBlock(p) -- walked out holding the shield
				end
			end
			-- v0.9.2 shield guard in the Range: same drain / recharge rules as a match
			if inside then
				local g = guard[p] or C.GuardMax
				if blocking[p] then
					g -= C.GuardDrainHeld * stepDt
					if g <= 0 then
						g = 0
						stopRangeBlock(p)
					end
				elseif t >= (guardRegenAt[p] or 0) then
					g = math.min(C.GuardMax, g + C.GuardRegen * stepDt)
				end
				guard[p] = g
				local gi = math.floor(g)
				if char:GetAttribute("Guard") ~= gi then
					char:SetAttribute("Guard", gi)
				end
			end
		end
	end
	-- dummies that fell or drifted off get put back
	for idx, d in dummies do
		if not d.Busy then
			-- v0.9.3 watchdog: a collapsed rig (head at/below the hips, or limbs torn away) is rebuilt
			local head = d.Model:FindFirstChild("Head")
			local collapsed = d.Model.Parent == nil
				or (head ~= nil and head:IsA("BasePart") and (head.Position.Y < d.Root.Position.Y + 0.4 or (head.Position - d.Root.Position).Magnitude > 6))
			if collapsed and (respawns[d.Index] or 0) < 3 then
				respawns[d.Index] = (respawns[d.Index] or 0) + 1
				d.Busy = true
				d.Token += 1
				task.spawn(function()
					d.Model:Destroy()
					local nd = makeDummy(d.Index, d.Post)
					if nd then
						dummies[idx] = nd
					end
				end)
			elseif d.Root.Position.Y < Config.Lobby.KillY or flat(d.Root.Position - d.Post.Position).Magnitude > 1.5 then
				task.spawn(resetDummy, d)
			end
		end
	end
end

return RangeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">RetentionService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — RetentionService (v0.9 Retention, server-authoritative)
	  • Daily quests (3/day) + the weekly chain (5 steps, last one = +1 spin): counted after
	    every round, rewards paid at once (outside the round coin cap).
	  • Season 1 track: season XP = match XP; claim tier rewards in the SEASON window.
	  • First-time tutorial: the client reports steps, the server checks them (in order, with the
	    sparring-bot block/parry and Boot L2 verified here) and pays the Range-basics reward.
	All requests go through ProgressionService's validated "Request" function.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Retention = require(Shared.Retention)

local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local TU = Config.Tutorial

local RetentionService = {}

local toastRemote = Net.Get("Toast")
local sparInfo: ((Player) -> { Block: boolean, Parry: boolean, Strikes: number })? = nil

-- tutorial steps (the client shows them; the server checks the ones it can)
RetentionService.Steps = {
	"GoRange", -- 1 walk into the Training Range
	"Shove", -- 2 shove a dummy twice
	"Block", -- 3 block the sparring bot
	"Parry", -- 4 parry it (or 6 tries)
	"Rush", -- 5 rush once
	"AimAssist", -- 6 land an aim-assisted hit in the Range (hits go where you face) → Range basics done: +150 coins + 1 Boot copy
	"JoinMatch", -- 7 answer JOIN and get into a match
	"FirstMatch", -- 8 finish the match (three tips on screen)
	"Merge", -- 9 MERGE the Boot to L2 at the Forge → tutorial complete
}

local function fail(msg: string): { [string]: any }
	return { Ok = false, Msg = msg }
end

local function onRound(player: Player, p: any, you: { [string]: any })
	DataService.EnsureRetention(player)
	local now = os.time()
	-- quests
	local done = Retention.Apply(p, player.UserId, Retention.StatsFromResult(you), now)
	for i, d in done do
		local reward = d.Spins and string.format("+%d SPIN", d.Spins) or string.format("+%d coins", d.Coins or 0)
		task.delay(0.8 * i, function()
			if player.Parent then
				toastRemote:FireClient(player, (d.Kind == "Daily" and "DAILY QUEST DONE: " or "WEEKLY CHAIN STEP: ") .. d.Text .. "  →  " .. reward)
			end
		end)
	end
	-- season XP
	local before = Retention.SeasonTier(p.Season.XP)
	if now < Config.Season.EndsAt then -- v1.0: the season stops counting when it ends
		p.Season.XP += math.max(0, math.floor(tonumber(you.XP) or 0))
	end
	local after = Retention.SeasonTier(p.Season.XP)
	if after > before then
		task.delay(0.8 * (#done + 1), function()
			if player.Parent then
				toastRemote:FireClient(player, string.format("SEASON TIER %d REACHED!  Claim your reward in SEASON", after))
			end
		end)
	end
end

function RetentionService.SetSparInfo(fn: (Player) -> { Block: boolean, Parry: boolean, Strikes: number })
	sparInfo = fn
end

function RetentionService.Init()
	ProgressionService.OnRoundResultExtra = onRound

	ProgressionService.RegisterAction("SeasonClaim", function(player, p, tier)
		DataService.EnsureRetention(player)
		local t = type(tier) == "number" and math.floor(tier) or 0
		if t < 0 or t > Retention.SeasonTiers() then
			return fail("Unknown tier.")
		end
		local paid = Retention.ClaimSeason(p, t)
		if #paid == 0 then
			return fail(t == 0 and "Nothing to claim yet. Play matches to earn season XP!" or "You can't claim that tier yet.")
		end
		DataService.SaveSoon(player)
		return { Ok = true, Paid = paid }
	end)

	-- the tutorial: steps must arrive in order; some are verified here
	ProgressionService.RegisterAction("TutorialStep", function(player, p, step)
		if type(step) ~= "number" then
			return fail("Bad step.")
		end
		local n = math.floor(step)
		if p.Tutorial >= TU.Done then
			return { Ok = true, Silent = true }
		end
		if n ~= p.Tutorial + 1 then
			return { Ok = true, Silent = true } -- out of order (double fire): ignore quietly
		end
		local spar = sparInfo and (sparInfo :: any)(player) or { Block = true, Parry = true, Strikes = 99 }
		if n == 3 and not (spar.Block or spar.Parry) then
			return fail("Block the sparring bot's swing first (hold E).")
		elseif n == 4 and not (spar.Parry or spar.Strikes >= 6) then
			return fail("Tap block right as the sparring bot swings.")
		elseif n == 9 then
			local boot = p.Weapons.Boot
			if not boot or boot.Level < 2 then
				return fail("Merge your Boot to L2 at the Forge first (pick Boot → MERGE).")
			end
		end
		p.Tutorial = n
		local res: { [string]: any } = { Ok = true, Step = n }
		if n == 6 and not p.Badges.Basics then
			p.Badges.Basics = true
			p.Coins += TU.BasicsCoins
			local boot = p.Weapons.Boot
			if boot then
				boot.Copies += TU.BasicsBootCopies
			end
			if spar.Parry then
				p.Badges.Parry = true
			end
			res.Coins = TU.BasicsCoins
			toastRemote:FireClient(player, string.format("TRAINING COMPLETE!  +%d coins and +%d Boot copy: MERGE your Boot at the Forge", TU.BasicsCoins, TU.BasicsBootCopies))
		end
		if n >= #RetentionService.Steps then
			p.Tutorial = TU.Done
			toastRemote:FireClient(player, "YOU'RE READY!  Daily quests, the weekly chain and Season 1 are in the menu")
		end
		DataService.SaveSoon(player)
		return res
	end, true)

	-- replay the tutorial any time (the Range-basics reward is only ever paid once)
	ProgressionService.RegisterAction("TutorialRestart", function(player, p)
		p.Tutorial = 0
		DataService.SaveSoon(player)
		return { Ok = true }
	end)

	ProgressionService.RegisterAction("TutorialSkip", function(player, p)
		p.Tutorial = TU.Done
		DataService.SaveSoon(player)
		return { Ok = true }
	end, true)
end

return RetentionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — RoundService
	Waiting → Intermission → Countdown → Live → Results → (repeat)

	• Starts with 2+ humans, or 1 human after 30 s (4 s in Studio). Bots fill to 12.
	• Elimination = falling below the kill plane. KO credit = last hitter within 6 s.
	• Rewards follow v3 doc §15 (coins capped at 120/round, bot KOs pay 2, placement ×0.67 in
	  bot-heavy lobbies, first win of the day +100).

	Replicated state lives in attributes on ReplicatedStorage:
	  State, EndsAt, Phase, Alive, Total, Message, RoundNumber
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)
local Descriptions = require(Shared.Descriptions)
local WeaponVisuals = require(Shared.WeaponVisuals)

local ArenaService = require(script.Parent.ArenaService)
local CombatService = require(script.Parent.CombatService)
local BotService = require(script.Parent.BotService)
local RumbleBoxService = require(script.Parent.RumbleBoxService)
local DataService = require(script.Parent.DataService)
local LobbyBuilder = require(script.Parent.LobbyBuilder)

local R = Config.Round
local RW = Config.Rewards

type Entry = {
	Combatant: CombatService.Combatant,
	Player: Player?,
	IsBot: boolean,
	Name: string,
	WeaponId: string,
	Level: number,
	Alive: boolean,
	DeathTime: number?,
	Placement: number?,
	KOs: number,
	BotKOs: number,
	Assists: number,
	Score: number,
	Timeout: boolean,
}

local RoundService = {}

local state = "Waiting"
local entries: { Entry } = {}
local entryByModel: { [Model]: Entry } = {}
local roundStart = 0
local roundOver = false
local endReason = ""
local lastPhaseName = ""
local finalThreeAnnounced = false
local humansAtStart = 0
local roundNumber = 0

local announceRemote = Net.Get("Announce")
local killFeedRemote = Net.Get("KillFeed")
local resultsRemote = Net.Get("RoundResults")
local joinRemote = Net.Get("JoinReply")
local joinAnswers: { [Player]: boolean } = {}
-- v1.0 patch PLAY NOW: a player who skips a bots-only match is auto-joined into the next one
local autoJoinNext: { [Player]: boolean } = {}
local portalMode: { [Player]: string } = {} -- v1.0.1: mode picked at a lobby portal, applied when the vote opens
local exhibitionSkip = false
local joinRound = 0
local effectRemote = Net.Get("Effect")

-- v0.8 modes, maps (now voted, v0.8.1) and adaptive bots
local matchCount = 0
local nextModeId, nextMapId = "Classic", "Grid"
local curMode: any = Config.Modes.Classic
local form: { [number]: number } = {} -- v1.0.1 per-player session form (UserId -> −2..+2)

-- v1.0.1 PER-PLAYER BOT SKILL: Easy / Medium / Hard / Pro from the player's stats + session form
local SKILL_TIERS = { "Easy", "Medium", "Hard", "Pro" }
function RoundService.SkillTier(player: Player): string
	local B = Config.Bots
	local p = DataService.Get(player)
	local rounds = p and tonumber(p.Rounds) or 0
	local base = 1
	if p and rounds >= B.SkillMinRounds then
		local wins = tonumber(p.Wins) or 0
		local kos = tonumber(p.KOs) or 0
		local level = tonumber(p.Level) or 1
		local wr, kpr = wins / rounds, kos / rounds
		local score = 0
		score += (level >= 10 and 1 or 0) + (level >= 30 and 1 or 0)
		score += (rounds >= 5 and wr >= 0.15 and 1 or 0) + (rounds >= 5 and wr >= 0.35 and 1 or 0)
		score += (kpr >= 1 and 1 or 0) + (kpr >= 2.5 and 1 or 0)
		base = if score <= 1 then 1 elseif score <= 3 then 2 elseif score <= 4 then 3 else 4
	end
	local i = math.clamp(base + (form[player.UserId] or 0), 1, #SKILL_TIERS)
	return SKILL_TIERS[i]
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function setAttr(name: string, value: any)
	ReplicatedStorage:SetAttribute(name, value)
end

local function setState(s: string, endsAt: number?, message: string?)
	state = s
	setAttr("State", s)
	setAttr("EndsAt", endsAt or 0)
	setAttr("Message", message or "")
end

local function pick<T>(list: { T }): T
	return list[math.random(1, #list)]
end

function RoundService.State(): string
	return state
end

function RoundService.IsInRound(player: Player): boolean
	-- v1.0 patch: only while a match is actually running. Survivors stay "Alive" in the entry list until
	-- Results end, which blocked spins/equips after a win with "Finish your round first!".
	if state ~= "Live" and state ~= "Countdown" then
		return false
	end
	for _, e in entries do
		if e.Player == player and e.Alive then
			return true
		end
	end
	return false
end

------------------------------------------------------------------------
-- Player characters
------------------------------------------------------------------------
local function attachLoadout(player: Player)
	local char = player.Character
	if not char then
		return
	end
	local id, level = DataService.GetLoadout(player)
	WeaponVisuals.Attach(char, id, level)
end

local function readyPlayers(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if DataService.Get(p) and hum and root and hum.Health > 0 then
			table.insert(list, p)
		end
	end
	return list
end

local function spawnInLobby(player: Player)
	if not player.Parent then
		return
	end
	-- v0.9.10: LoadCharacter is deprecated; use LoadCharacterAsync and fall back on older servers
	local ok = pcall(function()
		(player :: any):LoadCharacterAsync()
	end)
	if not ok and player.Parent then
		(player :: any):LoadCharacter()
	end
end

local function onCharacterAdded(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	hum.WalkSpeed = Config.Movement.WalkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = Config.Movement.JumpPower
	hum.BreakJointsOnDeath = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	char:SetAttribute("InRound", false)
	char:SetAttribute("Alive", false)
	task.defer(function()
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if root and char.Parent then
			char:PivotTo(LobbyBuilder.RandomSpawnCFrame())
		end
		attachLoadout(player)
	end)
	hum.Died:Connect(function()
		task.delay(R.RespawnDelay, function()
			if player.Parent and player.Character == char then
				spawnInLobby(player)
			end
		end)
	end)
end

------------------------------------------------------------------------
-- Elimination
------------------------------------------------------------------------
local function aliveCount(): (number, number)
	local all, humans = 0, 0
	for _, e in entries do
		if e.Alive then
			all += 1
			if not e.IsBot then
				humans += 1
			end
		end
	end
	return all, humans
end

local function eliminate(e: Entry, reason: string)
	if not e.Alive then
		return
	end
	e.Alive = false
	e.DeathTime = now()
	local remaining = aliveCount()
	e.Placement = remaining + 1

	local killer, assists = nil, {}
	local left = e.Player ~= nil and e.Player.Parent == nil
	if not left then
		killer, assists = CombatService.GetCredit(e.Combatant)
	end
	CombatService.MarkDead(e.Combatant)

	local killerEntry = killer and entryByModel[killer.Model]
	if killerEntry and killerEntry ~= e then
		if e.IsBot then
			killerEntry.BotKOs += 1
		else
			killerEntry.KOs += 1
		end
	end
	for _, a in assists do
		local ae = entryByModel[a.Model]
		if ae and ae ~= e then
			ae.Assists += 1
		end
	end

	local model = e.Combatant.Model
	if model.Parent then
		model:SetAttribute("Placement", e.Placement)
		model:SetAttribute("Alive", false)
	end

	local killerDef = killerEntry and Weapons.Get(killerEntry.WeaponId)
	-- v0.7: L8+ weapons leave a rarity-coloured light pillar where the victim went down
	if killerEntry and killerEntry ~= e and killerDef and killerEntry.Combatant.Model:GetAttribute("KOEffect") == true then
		local root = e.Combatant.Root
		if root and root.Parent then
			effectRemote:FireAllClients("KOPillar", { Position = root.Position, Rarity = killerDef.Rarity, Ascended = killerEntry.Combatant.Model:GetAttribute("Ascended") == true })
		end
	end
	killFeedRemote:FireAllClients({
		Victim = e.Name,
		VictimBot = e.IsBot,
		Killer = killerEntry and killerEntry.Name or nil,
		KillerBot = killerEntry and killerEntry.IsBot or false,
		Weapon = killerDef and killerDef.Name or nil,
		Rarity = killerDef and killerDef.Rarity or nil,
		Placement = e.Placement,
		Reason = left and "left" or reason,
	})
	if false then -- v0.9.12 quieter Foreman: KOs are in the kill feed, no banner
		announceRemote:FireAllClients(pick(Config.Announcer.KO), "ko")
	end

	if e.IsBot then
		CombatService.Unregister(model)
		BotService.Remove(model)
	else
		CombatService.Unregister(model)
		local player = e.Player
		if player and player.Parent then
			task.delay(R.RespawnDelay, function()
				if player.Parent and player.Character == model then
					spawnInLobby(player)
				end
			end)
		end
	end
end

------------------------------------------------------------------------
-- Rewards
------------------------------------------------------------------------
type Reward = {
	Coins: number,
	CoinBreakdown: { [string]: number },
	FirstWinBonus: number,
	XP: number,
	LevelUps: number,
	Score: number,
}

local function computeScore(e: Entry, endTime: number): number
	local S = RW.Score
	local alive = math.clamp((e.DeathTime or endTime) - roundStart, 0, R.Cap)
	local score = math.floor(alive) * S.PerSecond + e.KOs * S.HumanKO + e.BotKOs * S.BotKO + e.Assists * S.Assist
	if e.Placement == 1 and not e.Timeout then
		score += S.Win
	end
	if e.Timeout then
		score += S.TimeoutSurvivor
	end
	return score
end

local function rewardPlayer(e: Entry, endTime: number, hadWinner: boolean): Reward?
	local player = e.Player
	if not player or not player.Parent then
		return nil
	end
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	local secondsAlive = math.clamp((e.DeathTime or endTime) - roundStart, 0, R.Cap)
	local breakdown: { [string]: number } = {}

	breakdown.Survival = math.min(math.floor(secondsAlive / RW.SurvivalCoinEvery), RW.SurvivalCoinMax)

	local placementCoins = 0
	local p = e.Placement or 99
	if e.Timeout then
		breakdown.Timeout = RW.TimeoutSurvivor
	elseif p <= #RW.Placement and (p > 1 or hadWinner) then
		placementCoins = RW.Placement[p]
		if humansAtStart <= RW.BotHeavyMaxHumans then
			placementCoins = math.floor(placementCoins * RW.BotHeavyMultiplier)
		end
	end
	breakdown.Placement = placementCoins
	breakdown.PlayerKOs = math.min(e.KOs * RW.HumanKO, RW.HumanKOMax)
	breakdown.BotKOs = math.min(e.BotKOs * RW.BotKO, RW.BotKOMax)

	local total = 0
	for _, v in breakdown do
		total += v
	end
	-- v0.9: 2x Coins boost (shop) doubles the round coins AND the cap.
	-- v0.9.22: the 2x COINS FOREVER pass adds another ×1 (pass + boost = 3x, cap 3 × 120).
	local boosted = (profile.BoostUntil or 0) > os.time()
	local mult = 1 + (boosted and 1 or 0) + (DataService.HasPass(player, "Coins2x") and 1 or 0)
	total = math.min(total * mult, RW.RoundCap * mult)

	local won = p == 1 and not e.Timeout and hadWinner
	local firstWin = 0
	local today = math.floor(os.time() / 86400)
	if won and profile.FirstWinDay ~= today then
		firstWin = RW.FirstWinOfDay
		profile.FirstWinDay = today
	end

	local X = RW.XP
	local xp = X.Participation
		+ math.min(math.floor(secondsAlive) * X.PerSecondAlive, X.PerSecondMax)
		+ e.KOs * X.HumanKO
		+ e.BotKOs * X.BotKO
		+ e.Assists * X.Assist
	if e.Timeout then
		xp += X.Placement[2]
	elseif X.Placement[p] and (p > 1 or hadWinner) then
		xp += X.Placement[p]
	end

	DataService.AddCoins(player, total + firstWin)
	local levelUps = DataService.AddXP(player, xp)
	profile.Rounds += 1
	profile.KOs += e.KOs
	if won then
		profile.Wins += 1
		if humansAtStart >= RW.LeaderboardWinMinHumans then
			profile.LeaderboardWins += 1
		end
	end
	DataService.Push(player)
	DataService.SaveSoon(player) -- v1.0 patch 7: save (and post to the leaderboards) right after every match

	return {
		Coins = total,
		CoinBreakdown = breakdown,
		FirstWinBonus = firstWin,
		Boosted = boosted,
		XP = xp,
		LevelUps = levelUps,
		Score = e.Score,
	}
end

------------------------------------------------------------------------
-- Round
------------------------------------------------------------------------
local function shuffled<T>(list: { T }): { T }
	local out = table.clone(list)
	for k = #out, 2, -1 do
		local j = math.random(1, k)
		out[k], out[j] = out[j], out[k]
	end
	return out
end

local function addEntry(c: CombatService.Combatant, player: Player?, weaponId: string, level: number)
	local e: Entry = {
		Combatant = c,
		Player = player,
		IsBot = player == nil,
		Name = c.Name,
		WeaponId = weaponId,
		Level = level,
		Alive = true,
		DeathTime = nil,
		Placement = nil,
		KOs = 0,
		BotKOs = 0,
		Assists = 0,
		Score = 0,
		Timeout = false,
	}
	table.insert(entries, e)
	entryByModel[c.Model] = e
end

local function waitUntil(t: number, abortIfEmpty: boolean): boolean
	while now() < t do
		if abortIfEmpty and #readyPlayers() == 0 then
			return false
		end
		task.wait(0.1)
	end
	return true
end

-- v0.8.1 LOBBY VOTE: everyone in the lobby votes for the next map (and mode) during the join
-- window. Majority wins; a tie is settled at random among the leaders; no votes = random map.
local mapVotes: { [Player]: string } = {}
local modeVotes: { [Player]: string } = {}
local voteOpen = false

local function tally(votes: { [Player]: string }, options: { string }): { [string]: number }
	local counts: { [string]: number } = {}
	for _, id in options do
		counts[id] = 0
	end
	for p, id in votes do
		if p.Parent and counts[id] ~= nil then
			counts[id] += 1
		end
	end
	return counts
end

local function publishVotes()
	local V = Config.Vote
	for id, n in tally(mapVotes, V.Maps) do
		setAttr("Votes_" .. id, n)
	end
	for id, n in tally(modeVotes, V.Modes) do
		setAttr("Votes_" .. id, n)
	end
end

local function openVote()
	table.clear(mapVotes)
	table.clear(modeVotes)
	for _, p in Players:GetPlayers() do
		p:SetAttribute("VoteMap", nil)
		p:SetAttribute("VoteMode", nil)
	end
	for p, modeId in portalMode do
		if p.Parent then
			modeVotes[p] = modeId
			p:SetAttribute("VoteMode", modeId)
		end
	end
	table.clear(portalMode)
	voteOpen = true
	setAttr("VoteOpen", true)
	setAttr("NextMap", nil)
	setAttr("NextMapName", nil)
	setAttr("NextMode", nil)
	setAttr("NextModeName", nil)
	publishVotes()
end

-- returns the winner and whether it had to be picked at random
local function winnerOf(votes: { [Player]: string }, options: { string }, default: string?): (string, boolean)
	local counts = tally(votes, options)
	local best, leaders = 0, {}
	for _, id in options do
		local n = counts[id]
		if n > best then
			best, leaders = n, { id }
		elseif n == best and n > 0 then
			table.insert(leaders, id)
		end
	end
	if best == 0 then
		if default then
			return default, false
		end
		return options[math.random(1, #options)], true
	end
	if #leaders > 1 then
		return leaders[math.random(1, #leaders)], true
	end
	return leaders[1], false
end

local function closeVote()
	if not voteOpen then
		return
	end
	voteOpen = false
	setAttr("VoteOpen", false)
	local V = Config.Vote
	local mapId, mapRandom = winnerOf(mapVotes, V.Maps, nil)
	local modeId = winnerOf(modeVotes, V.Modes, "Classic")
	nextMapId, nextModeId = mapId, modeId
	setAttr("NextMode", modeId)
	setAttr("NextModeName", Config.Modes[modeId].Name)
	setAttr("NextMap", mapId)
	setAttr("NextMapName", Config.Maps[mapId].Name)
	local label = Config.Maps[mapId].Name .. (modeId == "Rumble" and " RUMBLE" or "")
	local lines = mapRandom and Config.Announcer.VoteRandom or Config.Announcer.VoteResult
	announceRemote:FireAllClients(string.format(pick(lines), label), "phase")
end

local function randomWeaponId(except: string?): string
	local list = Weapons.List
	for _ = 1, 6 do
		local id = list[math.random(1, #list)].Id
		if id ~= except then
			return id
		end
	end
	return list[math.random(1, #list)].Id
end

local function runRound(joined: { Player })
	roundNumber += 1
	setAttr("RoundNumber", roundNumber)
	-- v0.8: this match's mode + map
	curMode = Config.Modes[nextModeId] or Config.Modes.Classic
	local mapId = nextMapId
	local mapDef = Config.Maps[mapId] or Config.Maps.Grid
	ArenaService.SetMap(mapId)
	CombatService.SetKBScale(mapDef.KBScale or 1)
	setAttr("Mode", nextModeId)
	setAttr("ModeName", curMode.Name)
	ArenaService.Reset()
	CombatService.ClearProjectiles()
	table.clear(entries)
	table.clear(entryByModel)
	roundOver = false
	endReason = ""
	exhibitionSkip = false
	lastPhaseName = ""
	finalThreeAnnounced = false

	-- v0.7.1: only players who said YES to the join prompt (and are still here) play
	local humans = {}
	for _, p in readyPlayers() do
		if table.find(joined, p) then
			table.insert(humans, p)
		end
	end
	if #humans > Config.MaxSeats then
		humans = { table.unpack(shuffled(humans), 1, Config.MaxSeats) }
	end
	humansAtStart = #humans
	setAttr("Exhibition", #humans == 0) -- v1.0 patch: bots-only match -> the Yard gets a PLAY NOW button
	local spawns = shuffled(ArenaService.SpawnPoints(Config.MaxSeats))

	local levelSum, weaponLevelSum, maxWeaponLevel = 0, 0, 1
	local preyList: { BotService.Prey } = {}
	for i, player in humans do
		local char = player.Character :: Model
		local weaponId, level = DataService.GetLoadout(player)
		if curMode.RandomWeapon then
			-- Rumble: a random weapon (any of them, as a try-out) at a fixed level, this round only
			weaponId, level = randomWeaponId(), curMode.WeaponLevel or 5
		end
		WeaponVisuals.Attach(char, weaponId, level)
		char:PivotTo(spawns[i])
		local c = CombatService.Register(char, {
			Player = player,
			IsBot = false,
			Name = player.DisplayName,
			WeaponId = weaponId,
			Level = level,
		})
		if c then
			CombatService.SetFrozen(c, true)
			addEntry(c, player, weaponId, level)
			local tierName = RoundService.SkillTier(player)
			player:SetAttribute("BotTier", tierName)
			table.insert(preyList, { C = c, Tier = tierName, WeaponLevel = level })
		end
		local profile = DataService.Get(player)
		levelSum += profile and profile.Level or 1
		weaponLevelSum += level
		maxWeaponLevel = math.max(maxWeaponLevel, level)
	end

	local botCount = Config.MaxSeats - #humans
	if botCount > 0 then
		local botSpawns = {}
		for k = #humans + 1, Config.MaxSeats do
			table.insert(botSpawns, spawns[k])
		end
		local avgLevel = #humans > 0 and levelSum / #humans or 1
		local avgWeapon = #humans > 0 and weaponLevelSum / #humans or 1
		for _, c in BotService.Spawn(botSpawns, avgLevel, avgWeapon, maxWeaponLevel, {
			TierShift = 0,
			Prey = preyList, -- v1.0.1: bots matched to each player's skill
			RandomWeapon = curMode.RandomWeapon,
			Level = curMode.WeaponLevel,
			Humans = #humans,
		}) do
			CombatService.SetFrozen(c, true)
			addEntry(c, nil, c.WeaponId, c.Level)
		end
	end

	setAttr("Total", #entries)
	setAttr("Alive", #entries)
	setAttr("Phase", "Grace")

	-- COUNTDOWN (frozen on spawn pads) + the Foreman introduces the map / mode
	-- v0.9.17: the hint pill says what is special about this round (map rule, or the Rumble rule)
	local rule = curMode.RandomWeapon and Descriptions.Modes.Rumble or Descriptions.Maps[mapId]
	setState("Countdown", now() + R.Countdown, rule and ("GET READY  ·  " .. rule) or "GET READY")
	local intro = Config.Announcer.MapIntro[mapId]
	if curMode.RandomWeapon then
		intro = Config.Announcer.ModeIntro.Rumble
	end
	if intro then
		announceRemote:FireAllClients(pick(intro), "phase")
	end
	waitUntil(now() + R.Countdown, false)

	-- GO
	for _, e in entries do
		if e.Combatant.Model.Parent then
			CombatService.SetFrozen(e.Combatant, false)
			CombatService.ResetCooldowns(e.Combatant)
			CombatService.SetProtection(e.Combatant, R.SpawnProtection)
		end
	end
	roundStart = now()
	ArenaService.Start(roundStart, curMode.CollapseScale or 1, curMode.HazardScale or 1)
	if curMode.Boxes then
		RumbleBoxService.Start(roundStart) -- v0.9.17: Rumble-only weapon boxes
	end
	CombatService.SetEnabled(true)
	BotService.Go() -- v0.8.3b: every bot re-plans and starts moving the moment the match starts
	setState("Live", roundStart + R.Cap)
	announceRemote:FireAllClients(pick(Config.Announcer.Start), "start")

	while not roundOver do
		task.wait(0.1)
	end

	-- END
	local endTime = now()
	local skipped = exhibitionSkip
	setAttr("Exhibition", false)
	local resultsLen = skipped and 1.5 or R.Results
	CombatService.SetEnabled(false)
	ArenaService.Stop()
	RumbleBoxService.Stop()
	CombatService.SetKBScale(1)

	local all = aliveCount()
	local hadWinner = false
	local winnerName = nil
	if endReason == "timeout" then
		for _, e in entries do
			if e.Alive then
				e.Placement = 1
				e.Timeout = true
			end
		end
		announceRemote:FireAllClients(Config.Announcer.Timeout, "win")
	elseif endReason == "bots" then
		local k = 1
		for _, e in entries do
			if e.Alive then
				e.Placement = k
				k += 1
			end
		end
		if not skipped then
			announceRemote:FireAllClients(Config.Announcer.BotsWin, "win")
		end
	else
		for _, e in entries do
			if e.Alive then
				e.Placement = 1
				hadWinner = true
				winnerName = e.Name
				if e.Combatant.Model.Parent then
					e.Combatant.Model:SetAttribute("Victory", true) -- client plays the victory pose
				end
			end
		end
		if all == 0 then
			-- simultaneous fall: best placement wins nothing extra
			hadWinner = false
		end
		announceRemote:FireAllClients(pick(Config.Announcer.WinLines), "win")
	end

	-- v1.0.1 per-player FORM: winning makes your bots tougher next match, losing to a bot eases them
	if humansAtStart > 0 and endReason ~= "timeout" then
		local botWon = false
		for _, e in entries do
			if e.Placement == 1 and e.IsBot then
				botWon = true
			end
		end
		local B = Config.Bots
		for _, e in entries do
			local pl = e.Player
			if not e.IsBot and pl then
				local f = form[pl.UserId] or 0
				if e.Placement == 1 then
					f += 1
				elseif botWon then
					f -= 1
				end
				form[pl.UserId] = math.clamp(f, B.FormMin, B.FormMax)
			end
		end
	end
	matchCount += 1

	for _, e in entries do
		e.Score = computeScore(e, endTime)
	end

	-- standings
	local standings = {}
	for _, e in entries do
		table.insert(standings, {
			Name = e.Name,
			IsBot = e.IsBot,
			Placement = e.Placement or 99,
			Score = e.Score,
			KOs = e.KOs + e.BotKOs,
			Weapon = Weapons.Get(e.Combatant.WeaponId or e.WeaponId).Name, -- Rumble boxes can swap it
			Rarity = Weapons.Get(e.Combatant.WeaponId or e.WeaponId).Rarity,
			Level = e.Level,
			Timeout = e.Timeout,
		})
	end
	table.sort(standings, function(a, b)
		if a.Placement ~= b.Placement then
			return a.Placement < b.Placement
		end
		return a.Score > b.Score
	end)

	setState("Results", now() + resultsLen)

	for _, e in entries do
		if not e.IsBot and e.Player then
			local reward = rewardPlayer(e, endTime, hadWinner)
			if e.Player.Parent then
				local you = {
					Placement = e.Placement,
					Timeout = e.Timeout,
					KOs = e.KOs,
					BotKOs = e.BotKOs,
					Assists = e.Assists,
					SecondsAlive = math.floor(math.clamp((e.DeathTime or endTime) - roundStart, 0, R.Cap)),
					-- v0.9 (quests / season)
					Won = e.Placement == 1 and not e.Timeout and hadWinner,
					Map = nextMapId,
					Mode = nextModeId,
					XP = reward and reward.XP or 0,
				}
				resultsRemote:FireClient(e.Player, {
					Reason = endReason,
					Winner = winnerName,
					Standings = standings,
					You = you,
					Reward = reward,
				})
				if DataService.OnRoundResult then
					local player = e.Player
					task.delay(1.5, function()
						if player.Parent and DataService.OnRoundResult then
							DataService.OnRoundResult(player, you)
						end
					end)
				end
			end
		end
	end
	-- spectators who didn't play still see the standings
	for _, p in Players:GetPlayers() do
		local played = false
		for _, e in entries do
			if e.Player == p then
				played = true
				break
			end
		end
		if not played and not skipped then
			resultsRemote:FireClient(p, { Reason = endReason, Winner = winnerName, Standings = standings })
		end
	end

	-- send survivors home after a short victory moment
	task.delay(3, function()
		for _, e in entries do
			if e.Alive and not e.IsBot and e.Player and e.Player.Parent then
				CombatService.Unregister(e.Combatant.Model)
				spawnInLobby(e.Player)
			end
		end
		BotService.Clear()
	end)

	waitUntil(now() + resultsLen, false)
	for _, e in entries do
		e.Alive = false
		CombatService.Unregister(e.Combatant.Model)
	end
	table.clear(entries)
	table.clear(entryByModel)
	-- v0.8.3b: the match is over: the arena + surroundings go back to the normal cozy look
	ArenaService.SetDefault()
	ArenaService.Reset()
	CombatService.SetKBScale(1)
end

------------------------------------------------------------------------
-- Live step (called every Heartbeat from Main)
------------------------------------------------------------------------
function RoundService.Step(_dt: number)
	-- lobby safety: anyone not in a round who falls off the Yard is put back
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and not RoundService.IsInRound(p) and root.Position.Y < Config.Lobby.KillY and not char:GetAttribute("Alive") and char:GetAttribute("Placement") == nil then
			if root.Position.Y > Config.Arena.KillY - 200 then
				char:PivotTo(LobbyBuilder.RandomSpawnCFrame())
			end
		end
	end

	if state ~= "Live" or roundOver then
		return
	end
	local t = now()

	for _, e in entries do
		if e.Alive then
			local c = e.Combatant
			local model = c.Model
			local root = c.Root
			local gone = model.Parent == nil or root.Parent == nil
			if gone or root.Position.Y < Config.Arena.KillY or c.Humanoid.Health <= 0 then
				eliminate(e, "fell")
			end
		end
	end

	local all = aliveCount()
	setAttr("Alive", all)

	local phase = ArenaService.CurrentPhase(t)
	if phase.Name ~= lastPhaseName then
		lastPhaseName = phase.Name
		setAttr("Phase", phase.Name)
		local line = Config.Announcer.Phase[phase.Name]
		if line then
			announceRemote:FireAllClients(line, "phase")
		end
	end
	if all == 3 and not finalThreeAnnounced then
		finalThreeAnnounced = true
		announceRemote:FireAllClients(Config.Announcer.FinalThree, "phase")
	end

	-- v0.7.4: the match always plays out to a real winner (or the time cap), even when every human
	-- has fallen and only bots are left; the Yard watches the finish.
	if exhibitionSkip then
		endReason = "bots" -- v1.0 patch PLAY NOW: a waiting player cut the bots-only match short
		roundOver = true
	elseif all <= 1 then
		endReason = "win"
		roundOver = true
	elseif t >= roundStart + R.Cap then
		endReason = "timeout"
		roundOver = true
	end
end

------------------------------------------------------------------------
-- Main loop
------------------------------------------------------------------------
-- v0.7.1: "Join the next match?" window. Returns the players who said YES.
local function runJoinWindow(): { Player }
	joinRound += 1
	table.clear(joinAnswers)
	for _, p in Players:GetPlayers() do
		p:SetAttribute("JoinAnswer", nil)
	end
	setAttr("Exhibition", false) -- (also clears it if a bots round ever errored out)
	for p in autoJoinNext do
		if p.Parent then
			joinAnswers[p] = true
			p:SetAttribute("JoinAnswer", "yes")
		end
	end
	table.clear(autoJoinNext)
	setAttr("JoinRound", joinRound)
	setAttr("JoinedCount", 0)
	local endsAt = now() + R.JoinWindow
	local allAnsweredAt: number? = nil
	openVote()
	setState("Joining", endsAt, "Join the next match? · vote for the map")
	while now() < endsAt do
		local ready = readyPlayers()
		if #ready == 0 then
			closeVote()
			return {}
		end
		local yes, answered = 0, 0
		for _, p in ready do
			local a = joinAnswers[p]
			if a == nil and p:GetAttribute("AFK") == true then
				answered += 1 -- v1.0 patch: AFK players sit out (and don't hold the window open)
			elseif a ~= nil then
				answered += 1
				if a then
					yes += 1
				end
			end
		end
		setAttr("JoinedCount", yes)
		local voted = 0
		for _, p in ready do
			if mapVotes[p] or p:GetAttribute("AFK") == true then
				voted += 1
			end
		end
		if answered >= #ready then
			allAnsweredAt = allAnsweredAt or now()
		else
			allAnsweredAt = nil
		end
		-- everyone answered: go as soon as they've all voted too, or after a short grace for the vote
		if allAnsweredAt and (voted >= #ready or now() - (allAnsweredAt :: number) >= R.VoteGrace) then
			break
		end
		task.wait(0.1)
	end
	closeVote()
	local joined = {}
	for _, p in readyPlayers() do
		if joinAnswers[p] == true then
			table.insert(joined, p)
		end
	end
	return joined
end

function RoundService.Run()
	while true do
		-- WAITING: at least one player in the server
		while #readyPlayers() == 0 do
			setState("Waiting", 0, "Waiting for players")
			task.wait(0.25)
		end

		-- JOIN PROMPT
		local joined = runJoinWindow()
		if #joined == 0 then
			-- v0.7.4: nobody joined -> the bots play an exhibition match anyway (watch it from the
			-- Yard), and the join question only comes back after that match is over.
			setState("Intermission", now() + R.NoJoinPause, "Nobody joined: the bots play this one! Watch from the Yard")
			if waitUntil(now() + R.NoJoinPause, true) then
				local ok, err = pcall(runRound, {})
				if not ok then
					warn("[CRUMBLE] bot round error:", err)
					CombatService.SetEnabled(false)
					ArenaService.Stop()
					CombatService.SetKBScale(1)
					BotService.Clear()
					for _, e in entries do
						CombatService.Unregister(e.Combatant.Model)
					end
					table.clear(entries)
					table.clear(entryByModel)
					task.wait(2)
				end
			end
			continue
		end
		-- INTERMISSION (v0.7.2: longer): countdown in the Yard. Players can still JOIN late or
		-- back out (J / N or the pill buttons); the seat count updates live.
		local startAt = now() + R.StartDelay
		local function seatText(): string
			local n = 0
			for _, p in readyPlayers() do
				if joinAnswers[p] == true then
					n += 1
				end
			end
			n = math.min(n, Config.MaxSeats)
			setAttr("JoinedCount", n)
			return ("Match starting: %d player%s + %d bots"):format(n, n == 1 and "" or "s", Config.MaxSeats - n)
		end
		setAttr("LateJoin", true)
		setState("Intermission", startAt, seatText())
		local alive = true
		while now() < startAt do
			local ready = readyPlayers()
			if #ready == 0 then
				alive = false
				break
			end
			-- v1.0 patch: everyone here is already in -> nobody left to late-join, start in ~3 s
			local allIn = true
			for _, p in ready do
				if joinAnswers[p] ~= true and p:GetAttribute("AFK") ~= true then
					allIn = false
					break
				end
			end
			if allIn and startAt - now() > R.StartDelayAllIn then
				startAt = now() + R.StartDelayAllIn
				setAttr("EndsAt", startAt)
			end
			setAttr("Message", seatText())
			task.wait(0.25)
		end
		setAttr("LateJoin", false)
		joined = {}
		for _, p in readyPlayers() do
			if joinAnswers[p] == true then
				table.insert(joined, p)
			end
		end
		if alive and #joined > 0 then
			local ok, err = pcall(runRound, joined)
			if not ok then
				warn("[CRUMBLE] round error:", err)
				CombatService.SetEnabled(false)
				ArenaService.Stop()
				CombatService.SetKBScale(1)
				BotService.Clear()
				for _, e in entries do
					CombatService.Unregister(e.Combatant.Model)
				end
				table.clear(entries)
				table.clear(entryByModel)
				for _, p in Players:GetPlayers() do
					spawnInLobby(p)
				end
				task.wait(2)
			end
		end
	end
end

function RoundService.Init()
	-- v0.8 Molten Core geysers: launch everyone standing on the erupting tile straight up
	ArenaService.SetGeyserHandler(function(pos: Vector3, radius: number)
		local gz = Config.Maps.Molten.Geysers
		local hit = false
		for _, e in entries do
			local c = e.Combatant
			if e.Alive and c.Root.Parent then
				local d = c.Root.Position - pos
				if Vector3.new(d.X, 0, d.Z).Magnitude <= radius and d.Y > -3 and d.Y < 8 then
					local a = math.random() * math.pi * 2
					local vel = Vector3.new(math.cos(a) * gz.Drift, gz.LaunchVy, math.sin(a) * gz.Drift)
					CombatService.Launch(c, vel, gz.Stun)
					hit = true
				end
			end
		end
		if hit and false then -- v0.9.12 quieter Foreman (the geyser effect speaks for itself)
			announceRemote:FireAllClients(pick(Config.Announcer.Geyser), "phase")
		end
	end)
	-- v0.8.2 The Grid crane drops: the slam blasts everyone nearby outward (half if blocking)
	ArenaService.SetDropHandler(function(pos: Vector3, radius: number)
		local dr = Config.Maps.Grid.Drops -- v0.9.5: Classic has no drops (handler stays dormant)
		if not dr then
			return
		end
		local hitAny = false
		for _, e in entries do
			local c = e.Combatant
			if e.Alive and c.Root.Parent then
				local d = c.Root.Position - pos
				local flatD = Vector3.new(d.X, 0, d.Z)
				local dist = flatD.Magnitude
				if dist <= radius and d.Y > -3 and d.Y < 9 then
					local dir = dist > 0.2 and flatD.Unit or Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit
					local kb = dr.KB + (dr.KBEdge - dr.KB) * (dist / radius)
					if c.Blocking then
						kb *= 0.5
					end
					local vel, stun = CombatService.LaunchVelocity(dir, kb, dr.Lift)
					CombatService.Launch(c, vel, stun)
					hitAny = true
				end
			end
		end
		if hitAny and false then -- v0.9.12 quieter Foreman
			announceRemote:FireAllClients(pick(Config.Announcer.Slam), "phase")
		end
	end)
	-- v0.8.1 Ice Rink frost traps: freeze everyone standing on the trapped tile
	ArenaService.SetTrapHandler(function(i: number, center: Vector3)
		local tp = Config.Maps.Ice.Traps
		local half = Config.Arena.TileSize / 2 + 0.6
		for _, e in entries do
			local c = e.Combatant
			if e.Alive and c.Root.Parent then
				local d = c.Root.Position - center
				if math.abs(d.X) < half and math.abs(d.Z) < half and d.Y > -1 and d.Y < 7 then
					CombatService.Freeze(c, tp.FreezeTime)
					effectRemote:FireAllClients("Freeze", { Position = c.Root.Position })
					if false then -- v0.9.12 quieter Foreman (the frozen player gets their own toast)
						announceRemote:FireAllClients(string.format(pick(Config.Announcer.Freeze), string.upper(e.Name)), "phase")
					end
				end
			end
		end
	end)
	ArenaService.SetOccupancyProvider(function()
		local list = {}
		for _, e in entries do
			if e.Alive and e.Combatant.Root.Parent then
				table.insert(list, e.Combatant.Root.Position)
			end
		end
		return list
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(char)
			onCharacterAdded(player, char)
		end)
		task.spawn(function()
			local start = os.clock()
			while player.Parent and not DataService.Get(player) and os.clock() - start < 15 do
				task.wait(0.2)
			end
			if player.Parent then
				spawnInLobby(player)
			end
		end)
	end
	local lastVote: { [Player]: number } = {}
	Net.Get("Vote").OnServerEvent:Connect(function(player: Player, kind: any, id: any)
		if not voteOpen or type(id) ~= "string" then
			return
		end
		-- v0.9.7 RC: max ~6 votes / s per player (spam can't flood the vote attributes)
		local t = os.clock()
		if t - (lastVote[player] or 0) < 0.15 then
			return
		end
		lastVote[player] = t
		local V = Config.Vote
		if kind == "map" and table.find(V.Maps, id) then
			mapVotes[player] = id
			player:SetAttribute("VoteMap", id)
		elseif kind == "mode" and table.find(V.Modes, id) then
			modeVotes[player] = id
			player:SetAttribute("VoteMode", id)
		else
			return
		end
		publishVotes()
	end)
	joinRemote.OnServerEvent:Connect(function(player: Player, join: any)
		if join == "playnow" then
			-- v1.0 patch: only during a bots-only match; ends it and auto-joins this player into the next one
			if state == "Live" and ReplicatedStorage:GetAttribute("Exhibition") == true and not roundOver then
				exhibitionSkip = true
				autoJoinNext[player] = true
				player:SetAttribute("AFK", false)
				announceRemote:FireAllClients(player.DisplayName .. " wants to play: new match!", "phase")
			end
			return
		end
		local open = state == "Joining" or ReplicatedStorage:GetAttribute("LateJoin") == true
		if not open or type(join) ~= "boolean" then
			return
		end
		joinAnswers[player] = join
		player:SetAttribute("JoinAnswer", join and "yes" or "no")
		if join then
			player:SetAttribute("AFK", false) -- joining a match ends AFK mode
		end
	end)
	-- v1.0.1 LOBBY PORTALS: walk through CLASSIC / RUMBLE = join the next match + vote that mode.
	-- During a bots-only match it works like PLAY NOW (that match ends, you're in the next one).
	local toastRemote = Net.Get("Toast")
	local lastPortal: { [Player]: number } = {}
	local function enterPortal(player: Player, modeId: string)
		if RoundService.IsInRound(player) then
			return
		end
		local t = os.clock()
		if t - (lastPortal[player] or -1e9) < 3 then
			return
		end
		lastPortal[player] = t
		if modeId == "Duel" then
			toastRemote:FireClient(player, "DUEL (1v1) is coming soon! Try CLASSIC or RUMBLE.")
			return
		end
		if not table.find(Config.Vote.Modes, modeId) then
			return
		end
		player:SetAttribute("AFK", false) -- joining ends AFK mode
		local modeName = Config.Modes[modeId].Name
		local msg
		if state == "Joining" or ReplicatedStorage:GetAttribute("LateJoin") == true then
			joinAnswers[player] = true
			player:SetAttribute("JoinAnswer", "yes")
			msg = "You're IN the next match!"
		elseif state == "Live" and ReplicatedStorage:GetAttribute("Exhibition") == true and not roundOver then
			exhibitionSkip = true
			autoJoinNext[player] = true
			announceRemote:FireAllClients(player.DisplayName .. " wants to play: new match!", "phase")
			msg = "New match coming: you're IN!"
		else
			autoJoinNext[player] = true
			msg = "You're IN the next match!"
		end
		if voteOpen then
			modeVotes[player] = modeId
			player:SetAttribute("VoteMode", modeId)
			publishVotes()
		else
			portalMode[player] = modeId
		end
		toastRemote:FireClient(player, msg .. " Voted " .. modeName .. ".")
	end
	local function hookPortal(inst: Instance)
		if not inst:IsA("BasePart") then
			return
		end
		local modeId = inst:GetAttribute("PortalMode")
		if type(modeId) ~= "string" then
			return
		end
		inst.Touched:Connect(function(hit: BasePart)
			local char = hit.Parent
			local player = char and Players:GetPlayerFromCharacter(char)
			if player then
				enterPortal(player, modeId)
			end
		end)
	end
	for _, inst in CollectionService:GetTagged("CrumblePortal") do
		hookPortal(inst)
	end
	pcall(function()
		CollectionService:GetInstanceAddedSignal("CrumblePortal"):Connect(hookPortal)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastPortal[player] = nil
		portalMode[player] = nil
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastVote[player] = nil
		joinAnswers[player] = nil
		autoJoinNext[player] = nil
		mapVotes[player] = nil
		modeVotes[player] = nil
	end)
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayer, p)
	end

	DataService.OnLoadoutChanged = function(player: Player)
		if not RoundService.IsInRound(player) then
			attachLoadout(player)
		end
	end

	setAttr("State", "Waiting")
	setAttr("EndsAt", 0)
	setAttr("Alive", 0)
	setAttr("Total", 0)
	setAttr("Phase", "")
	setAttr("Message", "")
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">RumbleBoxService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — RumbleBoxService (v0.9.17)

	RUMBLE ONLY weapon boxes. Classic stays crate-free (owning a weapon is the only way to fight with
	it there). In a Rumble round a box falls onto a healthy tile near the middle every few seconds;
	walking into it swaps your weapon for a random different one at the Rumble level until the round
	ends. Nothing is ever unlocked or kept.

	RoundService calls Start(roundStart) / Stop(); Main steps it every Heartbeat. Bots ask Nearest()
	so they go for boxes too.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local WeaponVisuals = require(Shared.WeaponVisuals)
local Net = require(Shared.Net)
local Art = require(Shared.Art)

local ArenaService = require(script.Parent.ArenaService)
local CombatService = require(script.Parent.CombatService)

local RumbleBoxService = {}

type Box = {
	Id: number,
	Model: Model,
	Base: Vector3, -- tile top centre
	Tile: number?,
	Born: number, -- landing starts at Born, lands at Born + Fall
	Landed: boolean,
	Shadow: BasePart,
}

local BOX = Config.Modes.Rumble.Boxes
local ORANGE, GOLD, INK, CREAM = Art.Brand.Orange, Art.Brand.Gold, Art.Brand.Ink, Art.Brand.Cream

local active = false
local nextAt = 0
local boxes: { Box } = {}
local folder: Folder? = nil
local idSeq = 0
local announced = false
local effectRemote = Net.Get("Effect")
local announceRemote = Net.Get("Announce")

local function now(): number
	return workspace:GetServerTimeNow()
end

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- Toy-kit crate: orange body, ink edge frame, a big white "?" on all four sides, gold beam above.
local function buildBox(): Model
	local m = Instance.new("Model")
	m.Name = "WeaponBox"
	local core = part(m, { Name = "Core", Size = Vector3.new(3, 3, 3), Color = ORANGE })
	m.PrimaryPart = core
	-- edge frame (12 bars)
	local e, L = 0.32, 3.12
	for _, a in { -1, 1 } do
		for _, b in { -1, 1 } do
			part(m, { Name = "Edge", Size = Vector3.new(L, e, e), CFrame = CFrame.new(0, a * 1.5, b * 1.5), Color = INK })
			part(m, { Name = "Edge", Size = Vector3.new(e, L, e), CFrame = CFrame.new(a * 1.5, 0, b * 1.5), Color = INK })
			part(m, { Name = "Edge", Size = Vector3.new(e, e, L), CFrame = CFrame.new(a * 1.5, b * 1.5, 0), Color = INK })
		end
	end
	-- gold band round the middle
	part(m, { Name = "Band", Size = Vector3.new(3.08, 0.4, 3.08), Color = GOLD })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top } do
		local g = Instance.new("SurfaceGui")
		g.Face = face
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 50
		g.LightInfluence = 0
		g.Parent = core
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.LuckiestGuy
		t.TextScaled = true
		t.Text = "?"
		t.TextColor3 = CREAM
		t.TextStrokeColor3 = INK
		t.TextStrokeTransparency = 0
		t.Parent = g
	end
	local beam = part(m, { Name = "Beam", Shape = Enum.PartType.Cylinder, Size = Vector3.new(16, 0.7, 0.7), CFrame = CFrame.new(0, 9.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD, Material = Enum.Material.Neon, Transparency = 0.45 })
	beam:SetAttribute("Softened", true)
	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 12
	light.Brightness = 1.6
	light.Parent = core
	-- the model is built around the origin; parts store their offset from the core for PivotTo
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= core then
			d:SetAttribute("BoxOffset", d.CFrame)
		end
	end
	return m
end

local function place(b: Box, cf: CFrame)
	for _, d in b.Model:GetDescendants() do
		if d:IsA("BasePart") then
			local off = d:GetAttribute("BoxOffset")
			d.CFrame = typeof(off) == "CFrame" and cf * off or cf
		end
	end
end

local function remove(b: Box, poof: boolean)
	if poof then
		effectRemote:FireAllClients("BoxPoof", { Pos = b.Base + Vector3.new(0, 1.5, 0) })
	end
	b.Model:Destroy()
	b.Shadow:Destroy()
	local i = table.find(boxes, b)
	if i then
		table.remove(boxes, i)
	end
end

local function randomOther(except: string): string
	local list = Weapons.List
	for _ = 1, 8 do
		local id = list[math.random(1, #list)].Id
		if id ~= except then
			return id
		end
	end
	return list[1].Id ~= except and list[1].Id or list[2].Id
end

local function spawnBox(t: number)
	if not folder then
		return
	end
	local center = ArenaService.Center()
	local pos: Vector3? = nil
	for _ = 1, 6 do
		local p = ArenaService.RandomSafeNear(center, 14, 16, 1)
		if p then
			local clear = true
			for _, o in boxes do
				if (o.Base - p).Magnitude < 9 then
					clear = false
					break
				end
			end
			if clear then
				pos = p
				break
			end
		end
	end
	if not pos then
		return
	end
	idSeq += 1
	local model = buildBox()
	model.Parent = folder
	local shadow = part(folder :: Folder, { Name = "BoxShadow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 4.4, 4.4), CFrame = CFrame.new(pos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = INK, Transparency = 0.55 })
	local b: Box = { Id = idSeq, Model = model, Base = pos, Tile = ArenaService.TileAt(pos), Born = t, Landed = false, Shadow = shadow }
	place(b, CFrame.new(pos + Vector3.new(0, 1.5 + 34, 0)))
	table.insert(boxes, b)
	if not announced then
		announced = true
		announceRemote:FireAllClients(Config.Announcer.Boxes, "phase")
	end
end

local function grab(b: Box, c: any)
	local level = Config.Modes.Rumble.WeaponLevel or 5
	local id = randomOther(c.WeaponId)
	CombatService.SetWeapon(c, id, level)
	WeaponVisuals.Attach(c.Model, id, level)
	effectRemote:FireAllClients("BoxGrab", { Pos = b.Base + Vector3.new(0, 1.5, 0), WeaponId = id, Model = c.Model })
	remove(b, false)
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------
function RumbleBoxService.Start(roundStart: number)
	RumbleBoxService.Stop()
	active = true
	announced = false
	nextAt = roundStart + BOX.First
	local f = Instance.new("Folder")
	f.Name = "RumbleBoxes"
	f.Parent = ArenaService.GetFolder()
	folder = f
end

function RumbleBoxService.Stop()
	active = false
	for i = #boxes, 1, -1 do
		remove(boxes[i], false)
	end
	if folder then
		folder:Destroy()
		folder = nil
	end
end

function RumbleBoxService.Count(): number
	return #boxes
end

-- Closest landed box within maxDist (flat distance), for bots.
function RumbleBoxService.Nearest(pos: Vector3, maxDist: number): Vector3?
	local best, bestD = nil, maxDist
	for _, b in boxes do
		if b.Landed then
			local d = Vector2.new(b.Base.X - pos.X, b.Base.Z - pos.Z).Magnitude
			if d < bestD then
				best, bestD = b.Base, d
			end
		end
	end
	return best
end

function RumbleBoxService.Step(_dt: number)
	if not active then
		return
	end
	local t = now()
	if t >= nextAt then
		nextAt = t + BOX.Interval
		if #boxes < BOX.Max then
			spawnBox(t)
		end
	end
	for i = #boxes, 1, -1 do
		local b = boxes[i]
		local age = t - b.Born
		if not b.Landed then
			local k = math.clamp(age / BOX.Fall, 0, 1)
			local y = 34 * (1 - k * k) -- falls faster and faster
			place(b, CFrame.new(b.Base + Vector3.new(0, 1.5 + y, 0)) * CFrame.Angles(0, age * 3, 0))
			b.Shadow.Transparency = 0.8 - 0.4 * k
			if k >= 1 then
				b.Landed = true
				effectRemote:FireAllClients("BoxLand", { Pos = b.Base })
			end
		else
			-- idle: slow spin + bob so it reads as a pickup
			local s = age - BOX.Fall
			place(b, CFrame.new(b.Base + Vector3.new(0, 1.7 + math.sin(s * 3) * 0.25, 0)) * CFrame.Angles(0, s * 1.4, 0))
			-- vanishes with its tile, or after Life s
			local state = ArenaService.TileState(b.Tile)
			if state ~= 0 or age > BOX.Life then
				remove(b, true)
				continue
			end
			-- grab: nearest living, unfrozen fighter touching it
			local best, bestD = nil, BOX.GrabRadius
			for _, c in CombatService.All() do
				if c.Alive and not c.Frozen and c.Root.Parent then
					local p = c.Root.Position
					local d = Vector2.new(p.X - b.Base.X, p.Z - b.Base.Z).Magnitude
					if d < bestD and math.abs(p.Y - (b.Base.Y + 3)) < 5 then
						best, bestD = c, d
					end
				end
			end
			if best then
				grab(b, best)
			end
		end
	end
end

return RumbleBoxService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — ShopService (v0.9 Retention · doc §16 "Rare, honest, visible")
	Developer products: spins ×1/×5/×12, coins 500/2,500, a 30-minute 2x Coins boost and (v0.9.22)
	SKIP TIMER (hourly coin spin ready now, 3 a day).
	v0.9.22 GAME PASSES (one-time): AUTO MERGE, FAST COIN SPINS, 2x COINS FOREVER, VIP. Ownership comes
	from MarketplaceService (checked on join + PromptGamePassPurchaseFinished) and is mirrored on the
	player as the "Pass_<Key>" attribute; DataService.HasPass reads it. Id = 0 → DevMode simulates
	(saved in profile.DevPasses so it survives a rejoin in Studio).

	Rules this file enforces:
	  • PolicyService: players for whom paid random items are restricted never see or get
	    prompted for paid SPINS (coins and the boost stay available). Unknown policy = restricted.
	  • Never prompt during a round, on results, or before the tutorial is done (requests from
	    the menu only; ProgressionService blocks requests while you're in a round).
	  • Receipts are idempotent (PurchaseId stored in the profile) and the profile is SAVED
	    before a receipt is acknowledged; if the save fails the grant is rolled back and Roblox
	    retries later.
	  • Kill switches: Config.Shop.Enabled, plus DataStore "CrumbleFlags" key "Shop" = false
	    (checked every 5 minutes) closes the shop on every server without an update.
	  • Product Id = 0 → "not on sale yet". In DevMode the button SIMULATES the purchase instead
	    (no Robux), so the whole grant path can be tested in Studio.
]]

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local SH = Config.Shop

local ShopService = {}

local toastRemote = Net.Get("Toast")
local byKey: { [string]: { [string]: any } } = {}
local byId: { [number]: { [string]: any } } = {}
local passByKey: { [string]: { [string]: any } } = {}
local passById: { [number]: { [string]: any } } = {}
local remoteOpen = true

local function fail(msg: string): { [string]: any }
	return { Ok = false, Msg = msg }
end

local function shopOpen(): boolean
	return SH.Enabled and remoteOpen
end

local function grant(p: any, prod: { [string]: any }): string
	if prod.Spins then
		p.Spins += prod.Spins
		return string.format("+%d SPIN%s", prod.Spins, prod.Spins > 1 and "S" or "")
	elseif prod.Coins then
		p.Coins += prod.Coins
		return string.format("+%d COINS", prod.Coins)
	elseif prod.BoostMinutes then
		p.BoostUntil = math.max(os.time(), p.BoostUntil or 0) + prod.BoostMinutes * 60
		return string.format("2x COINS for %d minutes", prod.BoostMinutes)
	elseif prod.SkipTimer then
		local day = math.floor(os.time() / 86400)
		if p.SkipDay ~= day then
			p.SkipDay = day
			p.SkipsToday = 0
		end
		p.SkipsToday += 1
		p.CoinSpinAt = 0
		return "your COIN SPIN is ready! Open the Vault"
	end
	return ""
end

-- v0.9.22 game passes ------------------------------------------------------
local function onPassOwned(player: Player, pass: { [string]: any })
	if not player.Parent then
		return
	end
	player:SetAttribute("Pass_" .. pass.Key, true)
	local p = DataService.Get(player)
	if p and pass.Key == "FastSpins" then
		-- a running 1 h timer drops to at most 30 min right away
		local cap = os.time() + Config.Spins.CoinSpinFastEvery
		if p.CoinSpinAt > cap then
			p.CoinSpinAt = cap
		end
	end
end

local function checkPasses(player: Player, p: any)
	for _, pass in SH.Passes do
		local owns = false
		if Config.DevMode and p and p.DevPasses and p.DevPasses[pass.Key] then
			owns = true
		elseif pass.Id and pass.Id > 0 then
			local ok, res = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			owns = ok and res == true
		end
		if owns then
			onPassOwned(player, pass)
		end
	end
	if p then
		DataService.Push(player)
	end
end

local function trimReceipts(p: any)
	local list = {}
	for id, t in p.Receipts do
		table.insert(list, { Id = id, T = t })
	end
	if #list <= 100 then
		return
	end
	table.sort(list, function(a, b)
		return a.T > b.T
	end)
	for i = 101, #list do
		p.Receipts[list[i].Id] = nil
	end
end

local function processReceipt(info: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = DataService.Get(player)
	if not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local pid = tostring(info.PurchaseId)
	if p.Receipts[pid] then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- replay: already granted
	end
	local prod = byId[info.ProductId]
	if not prod then
		warn("[CRUMBLE] receipt for an unknown product id", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local snap = { Coins = p.Coins, Spins = p.Spins, BoostUntil = p.BoostUntil, CoinSpinAt = p.CoinSpinAt, SkipDay = p.SkipDay, SkipsToday = p.SkipsToday }
	local text = grant(p, prod)
	p.Receipts[pid] = os.time()
	trimReceipts(p)
	local saved = DataService.CanSave(player) and DataService.Save(player)
	if not saved and not RunService:IsStudio() then
		-- never acknowledge what isn't saved: undo, Roblox will retry the receipt later
		p.Coins, p.Spins, p.BoostUntil = snap.Coins, snap.Spins, snap.BoostUntil
		p.CoinSpinAt, p.SkipDay, p.SkipsToday = snap.CoinSpinAt, snap.SkipDay, snap.SkipsToday
		p.Receipts[pid] = nil
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.Push(player)
	toastRemote:FireClient(player, "THANK YOU!  " .. text)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPolicy(player: Player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	local restricted: boolean
	if ok and type(info) == "table" then
		restricted = info.ArePaidRandomItemsRestricted == true
	else
		restricted = not RunService:IsStudio() -- unknown → play it safe (Studio: allow testing)
	end
	if player.Parent then
		player:SetAttribute("PaidRandomRestricted", restricted)
	end
end

function ShopService.Init()
	for _, prod in SH.Products do
		byKey[prod.Key] = prod
		if prod.Id and prod.Id > 0 then
			byId[prod.Id] = prod
		end
	end
	ReplicatedStorage:SetAttribute("ShopOpen", shopOpen())
	MarketplaceService.ProcessReceipt = processReceipt
	for _, pass in SH.Passes do
		passByKey[pass.Key] = pass
		if pass.Id and pass.Id > 0 then
			passById[pass.Id] = pass
		end
	end
	DataService.OnLoaded = function(player, profile)
		checkPolicy(player)
		checkPasses(player, profile)
	end
	for _, pl in Players:GetPlayers() do
		task.spawn(checkPolicy, pl)
		task.spawn(checkPasses, pl, DataService.Get(pl))
	end
	pcall(function()
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
			local pass = passById[passId]
			if purchased and pass then
				onPassOwned(player, pass)
				DataService.Push(player)
				toastRemote:FireClient(player, "THANK YOU!  " .. pass.Name .. " is yours forever")
			end
		end)
	end)

	-- remote kill switch
	task.spawn(function()
		local okS, flags = pcall(function()
			return DataStoreService:GetDataStore("CrumbleFlags")
		end)
		if not okS then
			return
		end
		while true do
			local ok, v = pcall(function()
				return (flags :: DataStore):GetAsync("Shop")
			end)
			if ok then
				remoteOpen = v ~= false
				ReplicatedStorage:SetAttribute("ShopOpen", shopOpen())
			end
			task.wait(300)
		end
	end)

	ProgressionService.RegisterAction("Buy", function(player, p, key)
		if type(key) ~= "string" or not byKey[key] then
			return fail("Unknown product.")
		end
		if not shopOpen() then
			return fail("The shop is closed right now.")
		end
		if p.Tutorial < Config.Tutorial.Done then
			return fail("Finish (or skip) the tutorial first.")
		end
		local prod = byKey[key]
		if (prod.Random or prod.FeedsSpins) and player:GetAttribute("PaidRandomRestricted") ~= false then
			return fail("This item isn't available for your account. Everything can still be earned by playing!")
		end
		if prod.SkipTimer then
			if p.CoinSpinAt <= os.time() then
				return fail("Your coin spin is already ready: use it in the Vault!")
			end
			if DataService.SkipsLeft(p) <= 0 then
				return fail(string.format("You can skip the timer %d times a day. More tomorrow!", Config.Spins.SkipsPerDay))
			end
		end
		if not prod.Id or prod.Id <= 0 then
			if Config.DevMode then
				local text = grant(p, prod)
				DataService.SaveSoon(player)
				return { Ok = true, Simulated = true, Text = "DEV: simulated purchase (no Robux) · " .. text }
			end
			return fail("Not on sale yet.")
		end
		local ok = pcall(function()
			MarketplaceService:PromptProductPurchase(player, prod.Id)
		end)
		if not ok then
			return fail("The Roblox purchase window didn't open. Try again in a moment.")
		end
		return { Ok = true, Prompted = true, Silent = true }
	end)

	-- v0.9.22 game passes
	ProgressionService.RegisterAction("BuyPass", function(player, p, key)
		local pass = type(key) == "string" and passByKey[key]
		if not pass then
			return fail("Unknown pass.")
		end
		if not shopOpen() then
			return fail("The shop is closed right now.")
		end
		if DataService.HasPass(player, pass.Key) then
			return fail("You already own " .. pass.Name .. "!")
		end
		if pass.FeedsSpins and player:GetAttribute("PaidRandomRestricted") ~= false then
			return fail("This pass isn't available for your account. Everything can still be earned by playing!")
		end
		if not pass.Id or pass.Id <= 0 then
			if Config.DevMode then
				p.DevPasses[pass.Key] = true
				onPassOwned(player, pass)
				DataService.SaveSoon(player)
				return { Ok = true, Simulated = true, Text = "DEV: simulated pass (no Robux) · " .. pass.Name }
			end
			return fail("Not on sale yet.")
		end
		local ok = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		end)
		if not ok then
			return fail("The Roblox purchase window didn't open. Try again in a moment.")
		end
		return { Ok = true, Prompted = true, Silent = true }
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">SocialService</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — SocialService (v1.0)
	"FavoriteClaim": pays Config.Social.FavoriteSpins ONCE per player (profile flag Badges.FavReward)
	after the player answered Roblox's "favorite this game" pop-up with YES.
	Roblox can't tell a game whether someone favorited it (that answer only exists on the player's
	own device), so this reward is once-only and small on purpose. Likes can't be detected at all and
	Roblox's rules don't allow rewards for a thumbs-up, so the game only ASKS for the like.
	The pop-ups themselves are client-only: src/client/Controllers/Social.luau.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Services = script.Parent
local DataService = require(Services.DataService)
local ProgressionService = require(Services.ProgressionService)

local SocialService = {}

function SocialService.Init()
	ProgressionService.RegisterAction("FavoriteClaim", function(player, p)
		p.Badges = p.Badges or {}
		if p.Badges.FavReward then
			return { Ok = false, Msg = "Free spin already claimed. Thanks!" }
		end
		p.Badges.FavReward = true
		local spins = Config.Social.FavoriteSpins
		p.Spins += spins
		DataService.SaveSoon(player)
		Net.Get("Toast"):FireClient(player, string.format("THANKS FOR THE FAVORITE!  +%d SPIN  ·  a LIKE helps too!", spins))
		return { Ok = true, Spins = spins }
	end, true)
end

return SocialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">VisitorService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — VisitorService (v1.0 patch 8)
	An owner-only VISITOR LOG (no Creator Hub needed). Every server records each visit and, when the
	player leaves, adds one line to DataStore "CrumbleVisitors" / key "log":
	  name · device · NEW or returning · time played · the furthest stage reached · level.
	Stages: 1 LOADING (left before the game finished loading) · 2 LOBBY · 3 RANGE · 4 SHOVED (did the
	first tutorial shoves) · 5 MATCH (was in a match) · 6 FINISHED (finished a whole match).
	It also keeps running totals (how long people stay, how far they get). The owner reads it in
	FEEDBACK > INBOX > VISITORS (action "VisitorLog"). Studio test players (UserId <= 0) aren't logged.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Services = script.Parent
local DataService = require(Services.DataService)
local ProgressionService = require(Services.ProgressionService)
local FeedbackService = require(Services.FeedbackService)

local VisitorService = {}

local KEEP = 150 -- newest visits kept in the log
local DEVICES = { phone = true, tablet = true, pc = true, console = true }

type Sess = {
	Join: number,
	Clock: number,
	New: boolean?,
	Device: string,
	Stage: number,
	Rounds0: number?,
	Tut0: number?,
}

local sessions: { [Player]: Sess } = {}
local store: DataStore? = nil
local pending = 0
local addEntry: (data: any, entry: { [string]: any }) -> any

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore("CrumbleVisitors")
	end)
	if ok then
		store = s
	end
	return store
end

local function bump(sess: Sess, stage: number)
	if stage > sess.Stage then
		sess.Stage = stage
	end
end

-- read the profile once it has loaded: NEW = never played a round and never started the tutorial
local function watchProfile(player: Player, sess: Sess)
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < 60 do
		local p = DataService.Get(player)
		if p then
			sess.New = (tonumber(p.Rounds) or 0) == 0 and (tonumber(p.Tutorial) or 0) == 0
			sess.Rounds0 = tonumber(p.Rounds) or 0
			sess.Tut0 = tonumber(p.Tutorial) or 0
			return
		end
		task.wait(0.5)
	end
end

-- v1.0 patch 9: visits are buffered and written together, at most once every 7 s per server
-- (one write per key every 6 s, or Roblox queues it and logs a warning)
local buffer: { { [string]: any } } = {}
local flushing = false
local lastFlush = -1e9

local function flush()
	if flushing then
		return
	end
	flushing = true
	pending += 1
	while #buffer > 0 do
		local gap = lastFlush + 7 - os.clock()
		if gap > 0 then
			task.wait(gap)
		end
		local batch = buffer
		buffer = {}
		local ds = getStore()
		if ds then
			local ok, err = pcall(function()
				(ds :: DataStore):UpdateAsync("log", function(old: any)
					local data = type(old) == "table" and old or {}
					for _, entry in batch do
						data = addEntry(data, entry)
					end
					return data
				end)
			end)
			if not ok then
				warn("[CRUMBLE] visitor log write failed:", err)
			end
		end
		lastFlush = os.clock()
	end
	pending -= 1
	flushing = false
end

local function write(entry: { [string]: any })
	table.insert(buffer, entry)
	task.spawn(flush)
end

addEntry = function(data: any, entry: { [string]: any }): any
	do
		do
			local list = type(data.List) == "table" and data.List or {}
			table.insert(list, 1, entry)
			while #list > KEEP do
				table.remove(list)
			end
			local tot = type(data.Totals) == "table" and data.Totals or {}
			tot.Visits = (tonumber(tot.Visits) or 0) + 1
			if entry.nw then
				tot.New = (tonumber(tot.New) or 0) + 1
			end
			local s = tonumber(entry.s) or 0
			local bucket = if s < 30 then "Under30s" elseif s < 120 then "Under2m" elseif s < 300 then "Under5m" else "Over5m"
			tot[bucket] = (tonumber(tot[bucket]) or 0) + 1
			local st = type(tot.Stages) == "table" and tot.Stages or {}
			for i = 1, 6 do
				st[i] = (tonumber(st[i]) or 0) + (if (tonumber(entry.st) or 1) >= i then 1 else 0)
			end
			tot.Stages = st
			data.List = list
			data.Totals = tot
			return data
		end
	end
end

local function finish(player: Player)
	local sess = sessions[player]
	sessions[player] = nil
	if not sess or player.UserId <= 0 then
		return
	end
	local p = DataService.Get(player)
	if p and sess.Rounds0 and (tonumber(p.Rounds) or 0) > sess.Rounds0 then
		bump(sess, 6)
	end
	write({
		n = player.DisplayName,
		un = player.Name,
		u = player.UserId,
		t = sess.Join,
		s = math.floor(os.clock() - sess.Clock),
		d = sess.Device,
		nw = sess.New == true,
		st = sess.Stage,
		lv = p and tonumber(p.Level) or nil,
		tu = p and tonumber(p.Tutorial) or nil,
		own = player:GetAttribute("IsOwner") == true or nil,
	})
end

function VisitorService.Init()
	local function onJoin(player: Player)
		local sess: Sess = { Join = os.time(), Clock = os.clock(), Device = "?", Stage = 1 }
		sessions[player] = sess
		task.spawn(watchProfile, player, sess)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, pl in Players:GetPlayers() do
		onJoin(pl)
	end
	Players.PlayerRemoving:Connect(function(player)
		finish(player)
	end)
	game:BindToClose(function()
		for player in sessions do
			task.spawn(finish, player)
		end
		local t0 = os.clock()
		task.wait(0.5)
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)

	-- the client says hello once its UI is up and the character has spawned = it really LOADED
	ProgressionService.RegisterAction("Hello", function(player, _p, device)
		local sess = sessions[player]
		if sess then
			if type(device) == "string" and DEVICES[device] then
				sess.Device = device
			end
			bump(sess, 2)
		end
		return { Ok = true, Silent = true }
	end, true)

	-- stage tracking (Range / first shoves / match / finished)
	task.spawn(function()
		while true do
			task.wait(1)
			for player, sess in sessions do
				local char = player.Character
				if char then
					if char:GetAttribute("InRange") == true then
						bump(sess, 3)
					end
					if char:GetAttribute("InRound") == true then
						bump(sess, 5)
					end
				end
				local p = DataService.Get(player)
				if p then
					local tut = tonumber(p.Tutorial) or 0
					if sess.Tut0 and tut >= 2 and tut ~= sess.Tut0 then
						bump(sess, 4) -- did the first shoves THIS visit
					end
					if sess.Rounds0 and (tonumber(p.Rounds) or 0) > sess.Rounds0 then
						bump(sess, 6)
					end
				end
			end
		end
	end)

	ProgressionService.RegisterAction("VisitorLog", function(player, _p)
		if not FeedbackService.IsOwner(player) then
			return { Ok = false, Msg = "Only the game owner can see visitors." }
		end
		local ds = getStore()
		if not ds then
			return { Ok = false, Msg = "Visitor log is offline." }
		end
		local ok, data = pcall(function()
			return (ds :: DataStore):GetAsync("log")
		end)
		if not ok then
			return { Ok = false, Msg = "Couldn't load visitors (Studio needs API access ON)." }
		end
		local d = type(data) == "table" and data or {}
		return { Ok = true, Silent = true, List = d.List or {}, Totals = d.Totals or {} }
	end, true)
end

return VisitorService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="37">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="38">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="AvatarJointUpgrade_SerializedRollout">1</token>
      <float name="CameraMaxZoomDistance">45</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="42">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">AfkController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — AfkController (v1.0 patch 5)
	Makes AFK MODE impossible to miss:
	  * a big gold AFK card at the top of the screen (first row of the top stack): sleepy "zZ" badge,
	    AFK MODE title, a bar counting down to the next reward, this session's haul and a STOP button;
	  * a soft gold glow pulsing around the screen edges;
	  * a pop + sound + floating "+18" whenever a reward lands.
	(The server also puts a gold "AFK zZ" tag over the player's head for everyone to see.)
	Shown while the player attribute AFK is true (works in the Yard AND the Training Range).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Controllers = script.Parent
local UI = require(Controllers.UI)
local Layout = require(Controllers.Layout)
local EffectsController = require(Controllers.EffectsController)

local AfkController = {}

local player = Players.LocalPlayer
local INK = UI.Outline
local GOLD = Color3.fromRGB(255, 196, 40)
local CREAM = Color3.fromRGB(255, 248, 232)

local function now(): number
	return workspace:GetServerTimeNow()
end

local function tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local ok = pcall(function()
		TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
	end)
	if not ok then
		for k, v in props do
			(obj :: any)[k] = v
		end
	end
end

local function corner(p: Instance, r: number, scale: boolean?)
	local c = Instance.new("UICorner")
	c.CornerRadius = if scale then UDim.new(r, 0) else UDim.new(0, r)
	c.Parent = p
end

local function stroke(p: Instance, t: number, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = t
	s.Color = color or INK
	s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border
	s.Parent = p
	return s
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = UI.Font
	l.TextScaled = true
	l.TextColor3 = INK
	for k, v in props do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

function AfkController.Init()
	-- the card ----------------------------------------------------------------------------
	local card = Instance.new("Frame")
	card.Name = "AfkCard"
	card.Size = UDim2.fromOffset(460, 92)
	card.BackgroundColor3 = GOLD
	card.BorderSizePixel = 0
	card.Visible = false
	card:SetAttribute("NoSkin", true)
	corner(card, 22)
	stroke(card, 3)
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(226, 214, 200))
	grad.Parent = card
	local pop = Instance.new("UIScale")
	pop.Name = "Pop"
	pop.Parent = card

	-- sleepy badge
	local badge = Instance.new("Frame")
	badge.Name = "Badge"
	badge.Position = UDim2.fromOffset(12, 11)
	badge.Size = UDim2.fromOffset(70, 70)
	badge.BackgroundColor3 = Color3.fromRGB(42, 36, 64)
	badge.BorderSizePixel = 0
	corner(badge, 1, true)
	stroke(badge, 3)
	badge.Parent = card
	local zBig = text(badge, { Font = UI.Display, Text = "Z", TextColor3 = CREAM, Position = UDim2.fromScale(0.16, 0.3), Size = UDim2.fromScale(0.46, 0.5), Rotation = -10, ZIndex = 3 })
	local zSmall = text(badge, { Font = UI.Display, Text = "z", TextColor3 = GOLD, Position = UDim2.fromScale(0.56, 0.12), Size = UDim2.fromScale(0.28, 0.32), Rotation = 12, ZIndex = 3 })

	text(card, { Font = UI.Display, Text = "AFK MODE", TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(94, 8), Size = UDim2.new(1, -210, 0, 28) })

	-- countdown bar
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Position = UDim2.fromOffset(94, 41)
	track.Size = UDim2.new(1, -210, 0, 18)
	track.BackgroundColor3 = Color3.fromRGB(150, 96, 10)
	track.BorderSizePixel = 0
	corner(track, 1, true)
	stroke(track, 2)
	track.Parent = card
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = CREAM
	fill.BorderSizePixel = 0
	corner(fill, 1, true)
	fill.Parent = track
	local barText = text(track, { Text = "NEXT REWARD 2:00", Position = UDim2.fromScale(0.04, 0.08), Size = UDim2.fromScale(0.92, 0.84), ZIndex = 3 })

	local haul = text(card, { RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Text = "", Position = UDim2.fromOffset(94, 64), Size = UDim2.new(1, -210, 0, 20) })

	-- STOP
	local stop = Instance.new("TextButton")
	stop.Name = "StopAfk"
	stop.AnchorPoint = Vector2.new(1, 0.5)
	stop.Position = UDim2.new(1, -12, 0.5, 0)
	stop.Size = UDim2.fromOffset(98, 56)
	stop.BackgroundColor3 = Color3.fromRGB(240, 70, 90)
	stop.BorderSizePixel = 0
	stop.AutoButtonColor = true
	stop.Font = UI.Display
	stop.TextScaled = true
	stop.Text = "STOP"
	stop.TextColor3 = Color3.new(1, 1, 1)
	corner(stop, 18)
	stroke(stop, 3)
	local sp = Instance.new("UIPadding")
	sp.PaddingTop = UDim.new(0, 12)
	sp.PaddingBottom = UDim.new(0, 12)
	sp.PaddingLeft = UDim.new(0, 10)
	sp.PaddingRight = UDim.new(0, 10)
	sp.Parent = stop
	stroke(stop, 2, INK, Enum.ApplyStrokeMode.Contextual)
	stop.Parent = card
	stop.Activated:Connect(function()
		EffectsController.Play("Click", 0.5)
		task.spawn(function()
			pcall(function()
				Net.GetFunction("Request"):InvokeServer("AfkToggle", false)
			end)
		end)
	end)

	Layout.AddToStack(card, 9, 460) -- the very first row of the top stack

	-- the gold edge glow ------------------------------------------------------------------
	local glowGui = Instance.new("ScreenGui")
	glowGui.Name = "CrumbleAfkGlow"
	glowGui.IgnoreGuiInset = true
	glowGui.ResetOnSpawn = false
	glowGui.DisplayOrder = 0
	glowGui.Enabled = false
	glowGui.Parent = player:WaitForChild("PlayerGui")
	local edges: { Frame } = {}
	local EDGES: { { name: string, rot: number } } = { { name = "Top", rot = 90 }, { name = "Bottom", rot = 270 }, { name = "Left", rot = 0 }, { name = "Right", rot = 180 } }
	for _, e in EDGES do
		local f = Instance.new("Frame")
		f.Name = e.name
		f.BackgroundColor3 = GOLD
		f.BorderSizePixel = 0
		f.Active = false
		local horiz = e.name == "Top" or e.name == "Bottom"
		f.Size = if horiz then UDim2.new(1, 0, 0.16, 0) else UDim2.new(0.12, 0, 1, 0)
		f.AnchorPoint = if e.name == "Bottom" then Vector2.new(0, 1) elseif e.name == "Right" then Vector2.new(1, 0) else Vector2.zero
		f.Position = if e.name == "Bottom" then UDim2.fromScale(0, 1) elseif e.name == "Right" then UDim2.fromScale(1, 0) else UDim2.fromScale(0, 0)
		local g = Instance.new("UIGradient")
		g.Rotation = e.rot
		g.Transparency = NumberSequence.new(0, 1)
		g.Parent = f
		f.Parent = glowGui
		table.insert(edges, f)
	end

	-- state ---------------------------------------------------------------------------------
	local shown = false
	local last = { Coins = 0, Spins = 0, Wilds = 0 }
	local function readHaul(): (number, number, number)
		return (player:GetAttribute("AfkCoins") :: number?) or 0, (player:GetAttribute("AfkSpins") :: number?) or 0, (player:GetAttribute("AfkWilds") :: number?) or 0
	end
	local function floatText(msg: string)
		local f = text(card, { Font = UI.Display, Text = msg, TextColor3 = CREAM, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 47, 0, 10), Size = UDim2.fromOffset(120, 30), ZIndex = 20 })
		stroke(f, 2.5, INK, Enum.ApplyStrokeMode.Contextual)
		tween(f, 1.1, { Position = UDim2.new(0, 47, 0, -40), TextTransparency = 1 })
		task.delay(1.2, function()
			f:Destroy()
		end)
	end
	local function onReward()
		local c, s, w = readHaul()
		local msg: string? = nil
		if c > last.Coins then
			msg = string.format("+%d", c - last.Coins)
		elseif s > last.Spins then
			msg = "+1 SPIN"
		elseif w > last.Wilds then
			msg = "+1 WILD"
		end
		local grew = msg ~= nil
		last.Coins, last.Spins, last.Wilds = c, s, w
		if grew and shown then
			pop.Scale = 1.12
			tween(pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			floatText(msg :: string)
			EffectsController.Play("Win", 0.45, 1.35)
		end
	end
	for _, a in { "AfkCoins", "AfkSpins", "AfkWilds" } do
		player:GetAttributeChangedSignal(a):Connect(onReward)
	end

	local function setShown(on: boolean)
		if on == shown then
			return
		end
		shown = on
		card.Visible = on
		glowGui.Enabled = on
		if on then
			last.Coins, last.Spins, last.Wilds = readHaul()
			pop.Scale = 0.6
			tween(pop, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end

	local interval = Config.Afk.Interval
	RunService.RenderStepped:Connect(function()
		local char = player.Character
		local on = player:GetAttribute("AFK") == true and not (char ~= nil and char:GetAttribute("InRound") == true)
		setShown(on)
		if not on then
			return
		end
		local t = os.clock()
		-- breathing glow + bobbing zZ
		local a = 0.62 + 0.14 * math.sin(t * 2.2)
		for _, f in edges do
			f.BackgroundTransparency = a
		end
		zBig.Position = UDim2.fromScale(0.16, 0.3 + 0.04 * math.sin(t * 2))
		zSmall.Position = UDim2.fromScale(0.56, 0.12 + 0.05 * math.sin(t * 2 + 1.4))
		local nextAt = (player:GetAttribute("AfkNextAt") :: number?) or now()
		local left = math.max(0, nextAt - now())
		fill.Size = UDim2.fromScale(math.clamp(1 - left / interval, 0, 1), 1)
		local secs = math.ceil(left)
		barText.Text = string.format("NEXT REWARD %d:%02d", secs // 60, secs % 60)
		local c, s, w = readHaul()
		haul.Text = string.format("<b>+%d</b> coins  ·  <b>+%d</b> wild  ·  <b>+%d</b> spin", c, w, s)
	end)
end

return AfkController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — AnimationController (v0.7.3)
	Code-driven R15 animation layer. On classic rigs it writes Motor6D.C0 offsets, which compose
	with the default Animate script's Motor6D.Transform (walk / idle / jump keep playing underneath).
	v0.7.4: Roblox's Avatar Joint Upgrade swaps player joints for AnimationConstraints (C0 is read-only
	there). The place opts out (StarterPlayer.AvatarJointUpgrade = Disabled), and as a safety net
	constraint joints are driven by layering the same offset into .Transform on PreSimulation.

	v0.7.3: every weapon has a HOLDING pose (bat on the shoulder, gloves up, pan raised, slingshot
	forward, magnet aimed, bomb at the chest, crook upright) plus a small idle bob, and every weapon
	has its own swing clip that starts from and returns to that hold. All pose data lives in
	Shared/WeaponPoses (generated by tools/weapon_poses.py, which also renders previews).

	Clips (one-shot, per weapon):  Kick, BigKick, JabR/JabL, Uppercut, BatSwing, PanSpin, SlingShot,
	                               Throw, MagnetYank, HookWhip
	Loops (from replicated attributes):
		Blocking = true            -> guard pose (v0.9.2: also in the Training Range)
		RushUntil > server now     -> v0.9.2 dash pose (lean in, arms swept back, long stride)
		LaunchedUntil > server now -> airborne flail
		Victory = true             -> victory bounce
	Additive:  Flinch on every hit.

	Uploaded AnimationIds can replace any of this later; the swing timings come from the server's
	Windup so the strike frame always matches the hit frame.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local isStill: (Model) -> boolean -- defined below (dummy rigs: no Animator underneath)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponPoses = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("WeaponPoses"))

local AnimationController = {}

type Pose = { [string]: CFrame }
type Key = { t: number, pose: Pose, e: string? } -- e = easing used to ARRIVE at this key
type Clip = { Keys: { Key }, Start: number, Length: number, TrailOn: number, TrailOff: number, Weapon: string }
type Rig = {
	Model: Model,
	Motors: { [string]: Instance },
	Base: { [string]: CFrame },
	Off: { [string]: CFrame },
	Under: { [string]: CFrame },
	Wrote: { [string]: CFrame },
	HasConstraints: boolean,
	Clip: Clip?,
	FlinchAt: number,
	LoopW: { [string]: number },
	Alt: boolean,
	Dirty: boolean,
	HoldW: number,
	JustEnded: boolean,
	FreezeUntil: number,
}

local JOINTS: { [string]: string } = {
	RightShoulder = "RightUpperArm", LeftShoulder = "LeftUpperArm",
	RightElbow = "RightLowerArm", LeftElbow = "LeftLowerArm",
	RightHip = "RightUpperLeg", LeftHip = "LeftUpperLeg",
	RightKnee = "RightLowerLeg", LeftKnee = "LeftLowerLeg",
	Waist = "UpperTorso", Neck = "Head",
	Root = "LowerTorso", -- v0.9.16: whole-body weight (dips, lunges, spins); clips may translate it
}

local rigs: { [Model]: Rig } = setmetatable({}, { __mode = "k" }) :: any
local ID = CFrame.identity

local function E(x: number, y: number, z: number): CFrame
	return CFrame.fromEulerAnglesYXZ(math.rad(x), math.rad(y), math.rad(z))
end

local function smooth(a: number): number
	return a * a * (3 - 2 * a)
end

-- v0.9.16 per-key easing: snap = fast start, soft landing (strikes); accel = slow start, fast end
-- (wind-ups that whip into the strike); linear = spins; smooth = default
local EASE: { [string]: (number) -> number } = {
	smooth = smooth,
	snap = function(a: number): number
		local u = 1 - a
		return 1 - u * u * u
	end,
	accel = function(a: number): number
		return a * a * a
	end,
	linear = function(a: number): number
		return a
	end,
}

local function getRig(model: Model): Rig?
	local r = rigs[model]
	if r then
		return r
	end
	local motors: { [string]: Instance }, base: { [string]: CFrame } = {}, {}
	local hasConstraints = false
	for joint, partName in JOINTS do
		local p = model:FindFirstChild(partName)
		if not p then
			continue
		end
		local m = p:FindFirstChild(joint)
		if m and m:IsA("Motor6D") then
			motors[joint] = m
			base[joint] = m.C0
		else
			-- Avatar Joint Upgrade rigs: an AnimationConstraint (same name, or attached to this part)
			local ac: Instance? = nil
			if m and m:IsA("AnimationConstraint") then
				ac = m
			else
				for _, d in p:GetChildren() do
					if d:IsA("AnimationConstraint") and d.Attachment1 and d.Attachment1.Parent == p then
						ac = d
						break
					end
				end
			end
			if ac then
				motors[joint] = ac
				base[joint] = CFrame.identity
				hasConstraints = true
			end
		end
	end
	if not motors.RightShoulder then
		return nil -- not R15
	end
	local rig: Rig = { Model = model, Motors = motors, Base = base, Off = {}, Under = {}, Wrote = {}, HasConstraints = hasConstraints, Clip = nil, FlinchAt = -10, LoopW = { Block = 0, Flail = 0, Victory = 0, Rush = 0 }, Alt = false, Dirty = false, HoldW = 0, JustEnded = false, FreezeUntil = 0 }
	rigs[model] = rig
	return rig
end

------------------------------------------------------------------------
-- Clip library (data in Shared/WeaponPoses).  Key time = a * windup + b.
------------------------------------------------------------------------
local function holdOf(weaponId: string?): Pose
	if weaponId then
		return WeaponPoses.Hold[weaponId] or {}
	end
	return {}
end

local function clipFor(rig: Rig, weaponId: string, w: number, combo: boolean): { Key }
	local name: string
	if weaponId == "Gloves" then
		if combo then
			name = "Uppercut"
		else
			rig.Alt = not rig.Alt
			name = rig.Alt and "JabL" or "JabR"
		end
	elseif weaponId == "Magnet" and combo then
		name = "MagnetRepel" -- v0.9.18 push-pull: the 2nd click
	else
		name = WeaponPoses.ClipFor[weaponId] or "Kick"
	end
	local def = WeaponPoses.Clips[name]
	local hold = holdOf(weaponId)
	local keys: { Key } = { { t = 0, pose = hold } }
	local last = 0
	for _, k in def.Keys do
		local t = math.max(k.a * w + k.b, last + 0.02)
		table.insert(keys, { t = t, pose = k.pose, e = k.e })
		last = t
	end
	table.insert(keys, { t = last + def.Recover, pose = hold })
	return keys
end

local function setTrails(model: Model, on: boolean)
	for _, name in { "CrumbleWeapon", "CrumbleWeaponL" } do
		local m = model:FindFirstChild(name)
		if m then
			for _, d in m:GetDescendants() do
				if d:IsA("Trail") then
					d.Enabled = on
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------
function AnimationController.PlaySwing(model: Model, weaponId: string, windup: number, combo: boolean)
	local rig = getRig(model)
	if not rig then
		return
	end
	local w = math.max(windup, 0.06)
	local keys = clipFor(rig, weaponId, w, combo)
	rig.Clip = { Keys = keys, Start = os.clock(), Length = keys[#keys].t, TrailOn = w - 0.03, TrailOff = w + 0.3, Weapon = weaponId }
	rig.Dirty = true
end

-- v0.9.11: shorten the current swing (e.g. the Void Hook missed: no reel + slam). Keeps every key
-- already reached plus the next one, then eases back to the hold pose.
function AnimationController.CutSwing(model: Model, recover: number)
	local rig = rigs[model]
	local clip = rig and rig.Clip
	if not rig or not clip then
		return
	end
	local el = os.clock() - clip.Start
	local hold = clip.Keys[#clip.Keys].pose
	local keys: { Key } = {}
	for _, k in clip.Keys do
		table.insert(keys, k)
		if k.t > el then
			break
		end
	end
	local last = keys[#keys].t
	if last >= clip.Length - 0.001 then
		return -- already easing home
	end
	table.insert(keys, { t = last + recover, pose = hold })
	clip.Keys = keys
	clip.Length = last + recover
	rig.Dirty = true
end

-- v0.7.5 hit-stop: freeze the current swing for a few frames on impact (sells the hit)
function AnimationController.HitStop(model: Model, duration: number)
	local rig = rigs[model]
	if rig and rig.Clip then
		rig.FreezeUntil = math.max(rig.FreezeUntil, os.clock() + duration)
	end
end

function AnimationController.Flinch(model: Model)
	local rig = getRig(model)
	if rig then
		rig.FlinchAt = os.clock()
		rig.Dirty = true
	end
end

------------------------------------------------------------------------
-- Evaluation
------------------------------------------------------------------------
local function sampleClip(clip: Clip, t: number, joint: string): CFrame
	local keys = clip.Keys
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t <= b.t then
			local span = math.max(b.t - a.t, 1e-3)
			local ease = (b.e and EASE[b.e]) or smooth
			local f = ease(math.clamp((t - a.t) / span, 0, 1))
			local ca = a.pose[joint] or ID
			local cb = b.pose[joint] or ID
			return ca:Lerp(cb, f)
		end
	end
	return ID
end

local function loopPose(kind: string, joint: string, t: number): CFrame
	if kind == "Block" then
		local P: Pose = {
			RightShoulder = E(85, 35, 0), LeftShoulder = E(85, -35, 0),
			RightElbow = E(75, 0, 0), LeftElbow = E(75, 0, 0),
			Waist = E(-8, 0, 0), RightKnee = E(-14, 0, 0), LeftKnee = E(-14, 0, 0),
		}
		return P[joint] or ID
	elseif kind == "Flail" then
		local s1, s2 = math.sin(t * 15), math.sin(t * 13 + 1.3)
		if joint == "RightShoulder" then
			return E(150 + 25 * s1, 0, 35)
		elseif joint == "LeftShoulder" then
			return E(150 - 25 * s1, 0, -35)
		elseif joint == "RightElbow" or joint == "LeftElbow" then
			return E(30 + 20 * s2, 0, 0)
		elseif joint == "RightHip" then
			return E(25 * s2, 0, 12)
		elseif joint == "LeftHip" then
			return E(-25 * s2, 0, -12)
		elseif joint == "RightKnee" or joint == "LeftKnee" then
			return E(-45 - 15 * s1, 0, 0)
		elseif joint == "Waist" then
			return E(14, 0, 0)
		elseif joint == "Neck" then
			return E(18, 0, 0)
		end
	elseif kind == "Rush" then
		-- v0.9.2 dash: lean forward hard, arms swept back, long stride, head up
		local s = math.sin(t * 22)
		local P: Pose = {
			Waist = E(-30, 0, 0), Neck = E(22, 0, 0),
			RightShoulder = E(-62 + 6 * s, 0, 22), LeftShoulder = E(-62 - 6 * s, 0, -22),
			RightElbow = E(25, 0, 0), LeftElbow = E(25, 0, 0),
			RightHip = E(48, 0, 0), LeftHip = E(-38, 0, 0),
			RightKnee = E(-55, 0, 0), LeftKnee = E(-20, 0, 0),
		}
		return P[joint] or ID
	elseif kind == "Victory" then
		local b = math.abs(math.sin(t * 6))
		if joint == "RightShoulder" then
			return E(0, 0, 150 + 20 * b)
		elseif joint == "LeftShoulder" then
			return E(0, 0, -150 - 20 * b)
		elseif joint == "Waist" then
			return E(10 * b, 0, 0)
		elseif joint == "Neck" then
			return E(15 * b, 0, 0)
		elseif joint == "RightKnee" or joint == "LeftKnee" then
			return E(-20 * (1 - b), 0, 0)
		end
	end
	return ID
end

local function flinchPose(joint: string, age: number): CFrame
	if age > 0.35 then
		return ID
	end
	local f = age < 0.06 and age / 0.06 or 1 - (age - 0.06) / 0.29
	if joint == "Waist" then
		return E(18 * f, 0, 0)
	elseif joint == "Neck" then
		return E(14 * f, 0, 0)
	elseif joint == "RightShoulder" then
		return E(-20 * f, 0, 25 * f)
	elseif joint == "LeftShoulder" then
		return E(-20 * f, 0, -25 * f)
	end
	return ID
end

local LOOPS = { "Block", "Flail", "Victory", "Rush" }

local function wantLoop(model: Model, kind: string, serverNow: number): boolean
	if kind == "Block" then
		return model:GetAttribute("Blocking") == true
	elseif kind == "Flail" then
		local u = model:GetAttribute("LaunchedUntil")
		return type(u) == "number" and serverNow < u
	elseif kind == "Rush" then
		local u = model:GetAttribute("RushUntil")
		return type(u) == "number" and serverNow < u
	end
	return model:GetAttribute("Victory") == true
end

local function wantsHold(model: Model): boolean
	local id = model:GetAttribute("WeaponId")
	if type(id) ~= "string" then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end
	local pose = WeaponPoses.Hold[id]
	return pose ~= nil and next(pose) ~= nil
end

local function holdPose(weaponId: string, joint: string, t: number): CFrame
	local base = (WeaponPoses.Hold[weaponId] or {})[joint] or ID
	local bobs = WeaponPoses.Bob[weaponId]
	if bobs then
		for _, b in bobs do
			if b.Joint == joint then
				local a = math.rad(b.Amp * math.sin(t * b.Freq))
				if b.Axis == "X" then
					base = base * CFrame.Angles(a, 0, 0)
				elseif b.Axis == "Y" then
					base = base * CFrame.Angles(0, a, 0)
				else
					base = base * CFrame.Angles(0, 0, a)
				end
			end
		end
	end
	return base
end

-- Range dummies + the Sparring Bot: no Animator plays on them, only our procedural poses
isStill = function(model: Model): boolean
	return model:GetAttribute("IsDummy") == true
end

-- v0.9.4 safety sweep: an idle dummy (no pose running, not flying) is forced into its rest pose
local sweepAt = 0
local function sweepDummies(serverNow: number)
	for _, inst in CollectionService:GetTagged("CrumbleRig") do
		if inst:IsA("Model") and not rigs[inst] and isStill(inst) then
			local u = inst:GetAttribute("LaunchedUntil")
			if not (type(u) == "number" and serverNow < u) then
				for _, j in inst:GetDescendants() do
					if j:IsA("Motor6D") then
						if j.Transform ~= CFrame.identity then
							j.Transform = CFrame.identity
						end
					elseif j:IsA("AnimationConstraint") then
						local ac = j :: any
						if not (ac.Transform :: CFrame):FuzzyEq(CFrame.identity, 1e-4) then
							ac.Transform = CFrame.identity
						end
					end
				end
			end
		end
	end
end

local function step(dt: number)
	local clock = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	if clock >= sweepAt then
		sweepAt = clock + 0.5
		sweepDummies(serverNow)
	end
	-- pick up rigs that just entered a loop state or are holding a weapon
	for _, p in Players:GetPlayers() do
		local ch = p.Character
		if ch and not rigs[ch] then
			if wantsHold(ch) then
				getRig(ch)
			else
				for _, kind in LOOPS do
					if wantLoop(ch, kind, serverNow) then
						getRig(ch)
						break
					end
				end
			end
		end
	end
	for _, inst in CollectionService:GetTagged("CrumbleRig") do
		if inst:IsA("Model") and not rigs[inst] then
			if wantsHold(inst) then
				getRig(inst)
			else
				for _, kind in LOOPS do
					if wantLoop(inst, kind, serverNow) then
						getRig(inst)
						break
					end
				end
			end
		end
	end

	for model, rig in rigs do
		if not model.Parent then
			rigs[model] = nil
			continue
		end
		local active = false
		-- loop weights ease toward targets (flail wins over block)
		local flail = wantLoop(model, "Flail", serverNow)
		local rush = not flail and wantLoop(model, "Rush", serverNow)
		for _, kind in LOOPS do
			local target = 0
			if kind == "Flail" then
				target = flail and 1 or 0
			elseif kind == "Rush" then
				target = rush and 1 or 0
			elseif not flail and not rush and wantLoop(model, kind, serverNow) then
				target = 1
			end
			-- the dash pose snaps in fast (a rush only lasts a fraction of a second)
			local speed = kind == "Rush" and 30 or 14
			local wv = rig.LoopW[kind]
			wv += (target - wv) * math.min(1, dt * speed)
			if wv < 0.01 and target == 0 then
				wv = 0
			end
			rig.LoopW[kind] = wv
			if wv > 0 then
				active = true
			end
		end
		local clip = rig.Clip
		local ct = 0
		if clip and clock < rig.FreezeUntil then
			clip.Start += dt -- hold the pose while frozen
		end
		if clip then
			ct = clock - clip.Start
			-- v1.0 patch: a swing of the weapon you just swapped away from stops at once (it was keyed on the old hold)
			local nowId = model:GetAttribute("WeaponId")
			if ct > clip.Length or (type(nowId) == "string" and nowId ~= clip.Weapon) then
				rig.Clip = nil
				clip = nil
				rig.JustEnded = true
				setTrails(model, false)
			else
				active = true
				setTrails(model, ct >= clip.TrailOn and ct <= clip.TrailOff)
			end
		end
		local fage = clock - rig.FlinchAt
		if fage < 0.35 then
			active = true
		end
		-- weapon holding pose (clips start/end on it, so it hands over instantly)
		local weaponId = model:GetAttribute("WeaponId")
		local holding = wantsHold(model)
		local loopsOn = rig.LoopW.Block > 0.5 or rig.LoopW.Flail > 0.5 or rig.LoopW.Victory > 0.5 or rig.LoopW.Rush > 0.5
			or wantLoop(model, "Block", serverNow) or flail or rush or wantLoop(model, "Victory", serverNow)
		if clip then
			rig.HoldW = 0
		elseif holding and not loopsOn then
			rig.HoldW += (1 - rig.HoldW) * math.min(1, dt * 10)
		else
			rig.HoldW += (0 - rig.HoldW) * math.min(1, dt * 12)
			if rig.HoldW < 0.01 then
				rig.HoldW = 0
			end
		end
		if rig.JustEnded and holding and not loopsOn then
			rig.HoldW = 1
		end
		rig.JustEnded = false
		if rig.HoldW > 0 then
			active = true
		end

		if active then
			rig.Dirty = true
			for joint, motor in rig.Motors do
				local off = ID
				if rig.HoldW > 0 and type(weaponId) == "string" then
					off = ID:Lerp(holdPose(weaponId, joint, clock), rig.HoldW)
				end
				for _, kind in LOOPS do
					local wv = rig.LoopW[kind]
					if wv > 0 then
						off = off * ID:Lerp(loopPose(kind, joint, clock), wv)
					end
				end
				if clip then
					off = off * sampleClip(clip, ct, joint)
				end
				off = off * flinchPose(joint, fage)
				if motor:IsA("Motor6D") then
					motor.C0 = rig.Base[joint] * off
				else
					rig.Off[joint] = off -- applied to .Transform on PreSimulation
				end
			end
		elseif rig.Dirty then
			local still = isStill(model)
			for joint, motor in rig.Motors do
				if motor:IsA("Motor6D") then
					motor.C0 = rig.Base[joint]
				else
					rig.Off[joint] = nil
					if still then
						-- v0.9.4: nothing else animates a dummy: put the joint straight back to rest
						(motor :: any).Transform = CFrame.identity
					else
						local under = rig.Under[joint]
						local wrote = rig.Wrote[joint]
						if under and wrote and ((motor :: any).Transform :: CFrame):FuzzyEq(wrote, 1e-3) then
							(motor :: any).Transform = under
						end
					end
				end
			end
			rig.Dirty = false
			rigs[model] = nil -- forget idle rigs (base C0 re-read next time)
		end
	end
end

-- AnimationConstraint joints: layer our offset in front of whatever the Animator wrote this frame.
-- If no track touched the joint (Transform still equals what we wrote), reuse last frame's base so
-- the offset doesn't accumulate.
local hasPreAnim = false

local function preSim()
	for _, rig in rigs do
		if not rig.HasConstraints then
			continue
		end
		local still = isStill(rig.Model)
		for joint, inst in rig.Motors do
			local off = rig.Off[joint]
			if off and not inst:IsA("Motor6D") then
				local ac = inst :: any
				if still then
					-- v0.9.4: dummies have no Animator underneath: the pose IS our offset (on top of rest).
					-- (The old "did anyone overwrite it?" test compared CFrames exactly; the engine hands
					-- Transform back with tiny rounding, so offsets piled up and the end-of-pose restore
					-- never ran: dummies stood up still frozen in their flail pose.)
					ac.Transform = off
					rig.Wrote[joint] = off
					continue
				end
				local cur: CFrame = ac.Transform -- clean: preAnim put our layer back before the Animator ran
				if not hasPreAnim then
					-- fallback (no PreAnimation event): untouched joint still holds what we wrote last frame
					local wrote = rig.Wrote[joint]
					if wrote and cur:FuzzyEq(wrote, 1e-3) then
						cur = rig.Under[joint] or CFrame.identity
					end
				end
				rig.Under[joint] = cur
				local out = off * cur
				ac.Transform = out
				rig.Wrote[joint] = out
			end
		end
	end
end

-- v1.0 patch weapon-switch fix: before the Animator runs, take our layer back off every joint we wrote.
-- Joints the Animator animates get overwritten anyway; joints it leaves alone go back to their clean
-- base, so an old weapon's hold offset can never get baked in (it used to stick after equipping).
local function preAnim()
	for _, rig in rigs do
		if not rig.HasConstraints or isStill(rig.Model) then
			continue
		end
		for joint, _ in rig.Wrote do
			local inst = rig.Motors[joint]
			local under = rig.Under[joint]
			if inst and under and not inst:IsA("Motor6D") then
				(inst :: any).Transform = under
			end
		end
	end
end

function AnimationController.Init()
	RunService.RenderStepped:Connect(step)
	hasPreAnim = pcall(function()
		RunService.PreAnimation:Connect(preAnim)
	end)
	RunService.PreSimulation:Connect(preSim)
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — CameraController (v1.0.1)
	FIRST-PERSON VIEW: scroll / pinch all the way in and the camera goes into first person (Roblox's
	normal first-person mode: your body hides, the camera turns with the mouse).
	  · The over-the-shoulder offset fades out as you zoom in, so first person looks straight ahead
	    (EffectsController reads CameraController.OffsetScale()).
	  · Your arms and your weapon stay visible in first person, so swings can be seen.
	  · The mouse is freed while a menu, the join question or the results are on screen, so buttons
	    can still be clicked in first person.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CameraController = {}

local MIN_ZOOM = 0.5 -- Roblox switches to first person below ~1 stud
local FIRST_PERSON_AT = 1.5 -- camera-to-focus distance that counts as first person
local OFFSET_FULL_AT = 6 -- shoulder offset is at full strength from this zoom outwards

local VISIBLE_IN_FP = {
	LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true,
	["Left Arm"] = true, ["Right Arm"] = true,
}

local zoom = 12
local firstPerson = false

local function currentZoom(): number
	local cam = workspace.CurrentCamera
	if not cam then
		return 12
	end
	return (cam.CFrame.Position - cam.Focus.Position).Magnitude
end

-- 0 in first person … 1 when zoomed out (used for the over-the-shoulder CameraOffset)
function CameraController.OffsetScale(): number
	return math.clamp((zoom - FIRST_PERSON_AT) / (OFFSET_FULL_AT - FIRST_PERSON_AT), 0, 1)
end

function CameraController.IsFirstPerson(): boolean
	return firstPerson
end

function CameraController.Init()
	local player = Players.LocalPlayer
	pcall(function()
		player.CameraMinZoomDistance = MIN_ZOOM
	end)

	-- invisible Modal button = frees the mouse in first person while UI needs clicking
	local gui = Instance.new("ScreenGui")
	gui.Name = "CrumbleCursor"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	local modal = Instance.new("TextButton")
	modal.Name = "FreeMouse"
	modal.Size = UDim2.fromOffset(0, 0)
	modal.BackgroundTransparency = 1
	modal.Text = ""
	modal.Modal = true
	modal.Visible = false
	modal.Parent = gui
	gui.Parent = player:WaitForChild("PlayerGui")

	local function needsMouse(): boolean
		if player:GetAttribute("MenuOpen") == true then
			return true
		end
		local st = ReplicatedStorage:GetAttribute("State")
		if st == "Results" then
			return true
		end
		if st == "Joining" and player:GetAttribute("JoinAnswer") == nil then
			return true
		end
		return false
	end

	local function step()
		zoom = currentZoom()
		firstPerson = zoom < FIRST_PERSON_AT
		modal.Visible = firstPerson and needsMouse()
		if not firstPerson then
			return
		end
		local char = player.Character
		if not char then
			return
		end
		-- runs right after Roblox's camera hid the body: bring back the arms + weapon
		for _, child in char:GetChildren() do
			if child:IsA("BasePart") and VISIBLE_IN_FP[child.Name] then
				child.LocalTransparencyModifier = 0
			elseif child:IsA("Model") and (child.Name == "CrumbleWeapon" or child.Name == "CrumbleWeaponL") then
				for _, d in child:GetDescendants() do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = 0
					end
				end
			end
		end
	end

	local ok = pcall(function()
		RunService:BindToRenderStep("CrumbleFirstPerson", Enum.RenderPriority.Camera.Value + 1, step)
	end)
	if not ok then
		RunService.RenderStepped:Connect(step)
	end
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — EffectsController (all local / visual only)
	Swing animations, hit bursts with floating knockback numbers, parry rings, block shields,
	bomb warnings, explosions, tether beams, tile shake + falling debris, screen shake, sounds.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local UI = require(script.Parent.UI)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local AnimationController = require(script.Parent.AnimationController)
local CameraController = require(script.Parent.CameraController)

local player = Players.LocalPlayer

local EffectsController = {}

local fxFolder: Folder
local shake = 0
local BASE_CAM_OFFSET = Vector3.new(1.4, 0.6, 0)

------------------------------------------------------------------------
-- Sounds (built-in Roblox sounds; replace with your own asset ids later)
------------------------------------------------------------------------
local SOUND_IDS = {
	Swing = "rbxasset://sounds/swordlunge.wav",
	Hit = "rbxasset://sounds/action_jump_land.mp3",
	Parry = "rbxasset://sounds/electronicpingshort.wav",
	Fall = "rbxasset://sounds/action_falling.mp3",
	Tick = "rbxasset://sounds/clickfast.wav",
	Click = "rbxasset://sounds/button.wav",
	Win = "rbxasset://sounds/electronicpingshort.wav",
	-- v0.8 sound pass (Roblox-owned classic sounds, free to use in any experience)
	Boom = "rbxassetid://12221984", -- collide.wav: bomb blast, magma swallow, ice shatter
	Whoosh = "rbxassetid://12222095", -- Rocket whoosh 01: geysers, huge launches
	Victory = "rbxassetid://12222253", -- victory.wav: you won the round
	Bubble = "rbxasset://sounds/impact_water.mp3", -- geyser bubbling
	Voice = "rbxasset://sounds/button.wav", -- the Foreman's robot babble (pitched)
}
local soundCache: { [string]: Sound } = {}

function EffectsController.Play(name: string, volume: number?, pitch: number?)
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local s = soundCache[name]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Parent = SoundService
		soundCache[name] = s
	end
	local snd = s :: Sound
	snd.Volume = volume or 0.6
	snd.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(snd)
end

-- v0.8 THE FOREMAN's voice: robot babble, one pitched blip per syllable-ish chunk.
-- Volume scale comes from the player's "ForemanVolume" attribute (V cycles 1 → 0.5 → 0).
local babbleToken = 0
function EffectsController.Babble(text: string)
	local vol = player:GetAttribute("ForemanVolume")
	local scale = if type(vol) == "number" then vol else 1
	if scale <= 0 then
		return
	end
	babbleToken += 1
	local mine = babbleToken
	local letters = #string.gsub(text, "[^%a]", "")
	local blips = math.clamp(math.floor(letters / 2.5), 3, 14)
	task.spawn(function()
		for i = 1, blips do
			if babbleToken ~= mine then
				return
			end
			local pitch = 0.55 + math.random() * 0.25 + (i == blips and -0.08 or 0)
			EffectsController.Play("Voice", 0.45 * scale, pitch)
			task.wait(0.065 + math.random() * 0.03)
		end
	end)
end


local function distanceVolume(pos: Vector3, base: number): number
	local cam = workspace.CurrentCamera
	if not cam then
		return base
	end
	local d = (cam.CFrame.Position - pos).Magnitude
	return base * math.clamp(1 - d / 160, 0.05, 1)
end

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
local function fxPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = fxFolder
	return p
end

local function burst(pos: Vector3, color: Color3, count: number, speed: number)
	local p = fxPart({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos) })
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.25, 0.5)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 4
	pe.Rate = 0
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Parent = p
	pe:Emit(count)
	Debris:AddItem(p, 1)
end

local function ring(pos: Vector3, color: Color3, fromSize: number, toSize: number, time: number)
	local r = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, fromSize, fromSize),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.25,
	})
	TweenService:Create(r, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, toSize, toSize),
		Transparency = 1,
	}):Play()
	Debris:AddItem(r, time + 0.05)
end

local function floatingText(pos: Vector3, text: string, color: Color3, big: boolean)
	local anchor = fxPart({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(big and 140 or 100, big and 56 or 40)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(0.8, Enum.EasingStyle.Quad), { CFrame = anchor.CFrame + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 0.85)
end

function EffectsController.Shake(amount: number)
	shake = math.max(shake, math.clamp(amount, 0, 1.5))
end

local function rootOf(model: Instance?): BasePart?
	if model and model:IsA("Model") then
		return model:FindFirstChild("HumanoidRootPart") :: BasePart?
	end
	return nil
end

------------------------------------------------------------------------
-- Procedural swing animation (rotates the shoulder/hip Motor6D locally)
------------------------------------------------------------------------

-- v0.7.5: shockwave disc facing a direction (cylinder axis = dir)
local function shock(pos: Vector3, dir: Vector3, color: Color3, fromSize: number, toSize: number, time: number)
	local cf = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0)
	local r = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, fromSize, fromSize), CFrame = cf, Color = color, Transparency = 0.2 })
	TweenService:Create(r, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.05, toSize, toSize), Transparency = 1 }):Play()
	Debris:AddItem(r, time + 0.05)
end

-- v0.7.5: a bright crescent "swoosh" that traces the weapon's path at the strike frame.
-- Kicks draw a vertical arc from the floor up past the chest; arm weapons a horizontal sweep.
local function swoosh(root: BasePart, def: any, combo: boolean)
	local color = Rarity.Colors[def.Rarity] or Color3.new(1, 1, 1)
	local cf = root.CFrame
	local leg = def.Limb == "Leg"
	local segs = leg and 11 or 9
	local r = math.clamp(def.Range * 0.5, 2.6, 4.2)
	local from, to, pivot
	if leg then
		from, to = -75, 80
		pivot = cf * CFrame.new(0.55, -0.9, 0)
		r = def.Id == "BigBoot" and 4.4 or 3.6
	elseif def.Kind == "arc" then
		from, to = -95, 95
		pivot = cf * CFrame.new(0, 0.6, 0)
	elseif def.Kind == "slam" then
		-- v0.9.20 hammer: a tall vertical arc from over the head down to the floor in front
		from, to = -40, 125
		pivot = cf * CFrame.new(0.3, 0.9, -0.6)
		r = 3.6
		leg = true
	elseif def.Id == "Gloves" and combo then
		from, to = -60, 85
		pivot = cf * CFrame.new(0.6, -0.4, 0)
		leg = true -- uppercut: vertical arc too
	else
		from, to = -28, 28
		pivot = cf * CFrame.new(0.5, 0.5, 0)
	end
	local span = math.rad(to - from)
	local segLen = r * span / segs + 0.25
	for i = 0, segs - 1 do
		local f = i / (segs - 1)
		local ang = math.rad(from) + span * f
		local seg
		if leg then
			local at = pivot * CFrame.Angles(ang, 0, 0) * CFrame.new(0, 0, -r)
			seg = fxPart({ Size = Vector3.new(0.5 + f * 1.3, segLen, 0.14), CFrame = at, Color = i >= segs - 3 and Color3.new(1, 1, 1) or color, Transparency = 0.65 - f * 0.55 })
		else
			local at = pivot * CFrame.Angles(0, -ang, 0) * CFrame.new(0, 0, -r)
			seg = fxPart({ Size = Vector3.new(segLen, 0.4 + f * 1.1, 0.14), CFrame = at, Color = i >= segs - 3 and Color3.new(1, 1, 1) or color, Transparency = 0.65 - f * 0.55 })
		end
		TweenService:Create(seg, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.04 * f), { Transparency = 1, Size = seg.Size * Vector3.new(0.6, 1, 1) }):Play()
		Debris:AddItem(seg, 0.32)
	end
	-- air puff where the strike lands
	local tip = (leg and (cf * CFrame.new(0.55, 0.6, -r - 0.4)) or (cf * CFrame.new(0, 0.6, -r - 0.4))).Position
	shock(tip, cf.LookVector, Color3.new(1, 1, 1), 1, leg and 6 or 4.5, 0.2)
end

------------------------------------------------------------------------
-- v0.9.11 CAST EFFECTS: the Magnet and the Void Hook now visibly DO their attack, hit or miss.
--   Magnet:    v0.9.18 PUSH-PULL. Pull (red pole): the tip charges red -> red field rings close in
--              while sparks stream INTO the magnet -> on a hit a red+blue beam clamps the target.
--              Repel (2nd click, blue pole): blue charge -> a shock cone + streaks blast outward.
--   Void Hook: the core charges magenta -> the hook head flies out on a whipping void rope ->
--              on a hit it LATCHES onto the target and stays on them while they are reeled in,
--              then a void burst on the slam; on a miss it reels back empty (the arm cuts the slam).
------------------------------------------------------------------------
local MAG_RED = Color3.fromRGB(240, 64, 64)
local MAG_BLUE = Color3.fromRGB(80, 176, 255)
local VOID = Color3.fromRGB(140, 56, 255)
local VOID_HOT = Color3.fromRGB(240, 130, 255)
local VOID_DARK = Color3.fromRGB(34, 22, 56)

local function attWorld(att: Attachment): Vector3
	local par = att.Parent
	if par and par:IsA("BasePart") then
		return par.CFrame * att.Position
	end
	return Vector3.zero
end

local function weaponTip(model: Model): (Attachment?, Vector3)
	local w = model:FindFirstChild("CrumbleWeapon")
	local h = w and w:IsA("Model") and w.PrimaryPart
	local att = h and h:FindFirstChild("FxTip")
	if att and att:IsA("Attachment") then
		return att, attWorld(att)
	end
	local root = rootOf(model)
	return nil, root and (root.CFrame * Vector3.new(0.9, 0.4, -1.6)) or Vector3.zero
end

local function flatLook(root: BasePart): Vector3
	local lv = root.CFrame.LookVector
	local f = Vector3.new(lv.X, 0, lv.Z)
	return f.Magnitude > 0.01 and f.Unit or Vector3.new(0, 0, -1)
end

-- run fn(elapsed) every frame until it returns true (or maxTime passes)
local function everyFrame(maxTime: number, fn: (number) -> boolean?)
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local e = os.clock() - t0
		local ok, done = pcall(fn, e)
		if not ok then
			warn("[CRUMBLE fx] " .. tostring(done))
		end
		if not ok or done or e > maxTime then
			if conn then
				conn:Disconnect()
			end
		end
	end)
end

-- the tip glows brighter and bigger through the windup
local function tipCharge(model: Model, color: Color3, windup: number)
	local att = weaponTip(model)
	if not att then
		return
	end
	local orb = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3), CFrame = CFrame.new(attWorld(att)), Color = color, Transparency = 0.5 })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 6
	light.Brightness = 0
	light.Parent = orb
	everyFrame(windup + 0.2, function(e)
		local k = math.clamp(e / math.max(windup, 0.05), 0, 1)
		if k >= 1 or not att.Parent then
			orb:Destroy()
			return true
		end
		local sz = 0.3 + k * 1.1 + math.sin(e * 50) * 0.08 * k
		orb.Size = Vector3.new(sz, sz, sz)
		orb.CFrame = CFrame.new(attWorld(att))
		orb.Transparency = 0.5 - k * 0.35
		light.Brightness = k * 3
		return false
	end)
end

local function magnetCast(model: Model, def: any)
	local root = rootOf(model)
	if not root then
		return
	end
	local _, tip = weaponTip(model)
	local dir = flatLook(root)
	local range = def.Range or 18
	EffectsController.Play("Parry", distanceVolume(tip, 0.45), 0.42)
	-- v0.9.18 PULL = the red pole: field rings close IN on the magnet from the far end of the reach
	for i = 0, 3 do
		task.delay(i * 0.05, function()
			local cf0 = CFrame.lookAt(tip, tip + dir) * CFrame.Angles(0, math.rad(90), 0)
			local r = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.14, 6 - i, 6 - i), CFrame = cf0 + dir * range * (0.85 - i * 0.1), Color = MAG_RED, Transparency = 0.2 })
			TweenService:Create(r, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = cf0, Size = Vector3.new(0.05, 0.8, 0.8), Transparency = 0.9,
			}):Play()
			Debris:AddItem(r, 0.34)
		end)
	end
	-- metal sparks stream back INTO the magnet (sells the pull)
	local side = dir:Cross(Vector3.yAxis)
	for k = 1, 12 do
		local along = 3 + math.random() * (range - 3)
		local from = tip + dir * along + side * (math.random() - 0.5) * along * 0.5 + Vector3.new(0, (math.random() - 0.5) * 2.5, 0)
		local sp = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.32, 0.32, 0.32), CFrame = CFrame.new(from), Color = k % 3 == 0 and Color3.new(1, 1, 1) or MAG_RED, Transparency = 0.05 })
		local tt = 0.18 + along / range * 0.16
		TweenService:Create(sp, TweenInfo.new(tt, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(tip), Size = Vector3.new(0.08, 0.08, 0.08) }):Play()
		Debris:AddItem(sp, tt + 0.03)
	end
	burst(tip, MAG_RED, 8, 8)
end

-- v0.9.18 REPEL = the blue pole: a fat shock cone blasts OUT of the magnet
local function repelCast(model: Model, def: any)
	local root = rootOf(model)
	if not root then
		return
	end
	local _, tip = weaponTip(model)
	local dir = flatLook(root)
	local range = def.RepelRange or 9
	EffectsController.Play("Hit", distanceVolume(tip, 0.8), 0.55)
	if model == player.Character then
		EffectsController.Shake(0.22)
	end
	for i = 0, 2 do
		task.delay(i * 0.04, function()
			local cf0 = CFrame.lookAt(tip, tip + dir) * CFrame.Angles(0, math.rad(90), 0)
			local r = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.5, 1.5), CFrame = cf0, Color = i == 1 and Color3.new(1, 1, 1) or MAG_BLUE, Transparency = 0.1 })
			TweenService:Create(r, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				CFrame = cf0 + dir * range * (1 - i * 0.15), Size = Vector3.new(0.08, range * 1.1, range * 1.1), Transparency = 1,
			}):Play()
			Debris:AddItem(r, 0.3)
		end)
	end
	-- streaks spray out across the cone
	local side = dir:Cross(Vector3.yAxis)
	for k = 1, 10 do
		local spread = (k / 10 - 0.55) * 1.6
		local d = (dir + side * spread).Unit
		local sp = fxPart({ Size = Vector3.new(0.18, 0.18, 1.6), CFrame = CFrame.lookAt(tip, tip + d), Color = k % 3 == 0 and Color3.new(1, 1, 1) or MAG_BLUE, Transparency = 0.05 })
		TweenService:Create(sp, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.lookAt(tip + d * range, tip + d * (range + 1)), Transparency = 1 }):Play()
		Debris:AddItem(sp, 0.27)
	end
	burst(tip + dir * 1.5, MAG_BLUE, 16, 22)
end

local function magnetLatch(fromModel: Model, toModel: Model, hold: number)
	local tr = rootOf(toModel)
	local att = weaponTip(fromModel)
	local fr = rootOf(fromModel)
	if not tr or not fr then
		return
	end
	local a0 = att
	local made0: Attachment? = nil
	if not a0 then
		local na = Instance.new("Attachment")
		na.Position = Vector3.new(0.9, 0.4, -1.6)
		na.Parent = fr
		made0 = na
		a0 = na
	end
	local a1 = Instance.new("Attachment")
	a1.Parent = tr
	local beams = {}
	for i, col in { MAG_RED, MAG_BLUE, Color3.new(1, 1, 1) } do
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.Color = ColorSequence.new(col)
		b.LightEmission = 1
		b.Width0 = i == 3 and 0.12 or 0.4
		b.Width1 = i == 3 and 0.08 or 0.25
		b.Segments = 18
		b.FaceCamera = true
		b.Parent = a1
		table.insert(beams, b)
	end
	-- clamp rings + sparks on the target
	ring(tr.Position - Vector3.new(0, 1, 0), MAG_RED, 1.5, 6, 0.3)
	task.delay(0.08, function()
		ring(tr.Position + Vector3.new(0, 0.6, 0), MAG_BLUE, 1.5, 6, 0.3)
	end)
	burst(tr.Position, MAG_BLUE, 12, 12)
	floatingText(tr.Position + Vector3.new(0, 1, 0), "YANK!", MAG_BLUE, false)
	EffectsController.Play("Parry", distanceVolume(tr.Position, 0.6), 0.6)
	everyFrame(hold + 0.25, function(e)
		local alive = e < hold + 0.15 and a1.Parent ~= nil
		if not alive then
			a1:Destroy()
			if made0 then
				made0:Destroy()
			end
			return true
		end
		local crack = math.sin(e * 46)
		beams[1].CurveSize0, beams[1].CurveSize1 = 1.6 * crack, -1.2 * crack
		beams[2].CurveSize0, beams[2].CurveSize1 = -1.6 * crack, 1.2 * crack
		local fade = math.clamp((e - hold) / 0.15, 0, 1)
		for _, b in beams do
			b.Transparency = NumberSequence.new(fade)
		end
		return false
	end)
end

-- Void Hook state per caster (so the server's latch can find the flying hook)
type HookState = { Model: Model, Orb: Part, Ring: Part, Pos: Vector3, Phase: string, PhaseT: number, T0: number, Target: BasePart?, Hold: number, Back0: Vector3, Cut: boolean }
local hooks: { [Model]: HookState } = {}

local function hookSlam(pos: Vector3)
	ring(pos - Vector3.new(0, 2, 0), VOID, 2, 16, 0.4)
	ring(pos, VOID_HOT, 1, 9, 0.3)
	burst(pos, VOID_HOT, 26, 26)
	EffectsController.Play("Boom", distanceVolume(pos, 0.6), 1.25)
end

local function hookCast(model: Model, def: any, latched: BasePart?, hold: number?)
	local root = rootOf(model)
	if not root then
		return
	end
	local old = hooks[model]
	if old then
		old.Orb:Destroy()
		old.Ring:Destroy()
		hooks[model] = nil
	end
	local att, tip = weaponTip(model)
	local dir = flatLook(root)
	local range = (def and def.Range) or 18
	local endPos = tip + dir * range
	-- hook head: glowing void orb inside a dark iron ring, with a trail
	local orb = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), CFrame = CFrame.new(tip), Color = VOID_HOT, Transparency = 0 })
	local rg = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 1.8, 1.8), CFrame = CFrame.new(tip), Color = VOID_DARK, Material = Enum.Material.SmoothPlastic, Transparency = 0 })
	local light = Instance.new("PointLight")
	light.Color = VOID_HOT
	light.Range = 10
	light.Brightness = 2.5
	light.Parent = orb
	local oa = Instance.new("Attachment")
	oa.Parent = orb
	local ta = Instance.new("Attachment")
	ta.Position = Vector3.new(0, 0.45, 0)
	ta.Parent = orb
	local tb = Instance.new("Attachment")
	tb.Position = Vector3.new(0, -0.45, 0)
	tb.Parent = orb
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = ta, tb
	trail.Color = ColorSequence.new(VOID_HOT, VOID)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.18
	trail.LightEmission = 1
	trail.Parent = orb
	-- the rope (from the crook tip to the hook head)
	local ropeFrom = att
	local madeFrom: Attachment? = nil
	if not ropeFrom then
		local na = Instance.new("Attachment")
		na.Position = Vector3.new(0.9, 0.4, -1.6)
		na.Parent = root
		madeFrom = na
		ropeFrom = na
	end
	local rope = Instance.new("Beam")
	rope.Attachment0, rope.Attachment1 = ropeFrom, oa
	rope.Color = ColorSequence.new(VOID, VOID_HOT)
	rope.LightEmission = 0.8
	rope.Width0, rope.Width1 = 0.32, 0.22
	rope.Segments = 24
	rope.FaceCamera = true
	rope.Parent = orb
	local core = Instance.new("Beam")
	core.Attachment0, core.Attachment1 = ropeFrom, oa
	core.Color = ColorSequence.new(Color3.new(1, 1, 1))
	core.LightEmission = 1
	core.Width0, core.Width1 = 0.08, 0.06
	core.Segments = 24
	core.FaceCamera = true
	core.Parent = orb

	local t0 = os.clock()
	local st: HookState = { Model = model, Orb = orb, Ring = rg, Pos = tip, Phase = "out", PhaseT = 0, T0 = t0, Target = latched, Hold = hold or 0.45, Back0 = tip, Cut = false }
	if latched then
		st.Phase = "hold"
	end
	hooks[model] = st
	EffectsController.Play("Whoosh", distanceVolume(tip, 0.35), 1.6)
	local OUT, GRACE, BACK = 0.14, 0.08, 0.17
	local function finish()
		if hooks[model] == st then
			hooks[model] = nil
		end
		orb:Destroy()
		rg:Destroy()
		if madeFrom then
			madeFrom:Destroy()
		end
	end
	everyFrame(3, function(e)
		if not orb.Parent then
			finish()
			return true
		end
		local now = os.clock()
		local pt = now - t0 - st.PhaseT
		local _, curTip = weaponTip(model)
		local look = dir
		if st.Phase == "out" then
			local k = math.clamp(pt / OUT, 0, 1)
			local ek = 1 - (1 - k) * (1 - k)
			st.Pos = tip:Lerp(endPos, ek)
			rope.CurveSize0 = (1 - k) * 3.5 * math.sin(pt * 30)
			rope.CurveSize1 = -(1 - k) * 2
			if pt >= OUT + GRACE then
				st.Phase, st.PhaseT, st.Back0 = "back", now - t0, st.Pos
				if not st.Cut then
					st.Cut = true
					AnimationController.CutSwing(model, 0.25)
				end
			end
		elseif st.Phase == "hold" then
			local tg = st.Target
			if not tg or not tg.Parent then
				st.Phase, st.PhaseT, st.Back0 = "back", now - t0, st.Pos
			else
				local want = tg.Position + Vector3.new(0, 0.6, 0)
				st.Pos = st.Pos:Lerp(want, math.clamp(pt * 3 + 0.35, 0, 1))
				rope.CurveSize0, rope.CurveSize1 = 0, 0
				look = (curTip - st.Pos).Magnitude > 0.1 and (curTip - st.Pos).Unit or dir
				if pt >= st.Hold then
					hookSlam(st.Pos)
					st.Phase, st.PhaseT, st.Back0 = "back", now - t0, st.Pos
				end
			end
		elseif st.Phase == "back" then
			local k = math.clamp(pt / BACK, 0, 1)
			st.Pos = st.Back0:Lerp(curTip, k * k)
			rope.CurveSize0 = math.sin(pt * 40) * (1 - k) * 1.2
			rope.CurveSize1 = 0
			if k >= 1 then
				finish()
				return true
			end
		end
		local spin = CFrame.Angles(e * 14, 0, 0) -- spin in the ring's own plane
		orb.CFrame = CFrame.new(st.Pos)
		rg.CFrame = CFrame.lookAt(st.Pos, st.Pos + look) * CFrame.Angles(0, math.rad(90), 0) * spin
		if e > 2.6 then
			finish()
			return true
		end
		return false
	end)
end

local function hookLatch(fromModel: Model, toModel: Model, hold: number)
	local tr = rootOf(toModel)
	if not tr then
		return
	end
	local st = hooks[fromModel]
	if st and st.Orb.Parent then
		st.Target = tr
		st.Hold = hold
		st.Phase = "hold"
		st.PhaseT = os.clock() - st.T0 -- restart the phase clock at "now"
	else
		hookCast(fromModel, Weapons.Get("VoidHook"), tr, hold)
	end
	ring(tr.Position, VOID_HOT, 1.2, 7, 0.28)
	burst(tr.Position, VOID, 14, 14)
	floatingText(tr.Position + Vector3.new(0, 1, 0), "HOOKED!", VOID_HOT, true)
	EffectsController.Play("Parry", distanceVolume(tr.Position, 0.7), 0.7)
end

local function swing(model: Model, weaponId: string, windup: number, combo: boolean)
	local def = Weapons.Get(weaponId)
	AnimationController.PlaySwing(model, weaponId, windup, combo)

	local root = rootOf(model)
	if root then
		-- v0.9.11 polish: every weapon has its own swing voice (heavy = lower, quick = higher)
		local PITCH = { Boot = 1, BigBoot = 0.82, Gloves = 1.25, Bat = 0.9, Pan = 0.76, Slingshot = 1.4, Magnet = 0.7, Hammer = 0.85, BombBag = 1.1, VoidHook = 0.62 }
		local base = PITCH[weaponId] or 1
		EffectsController.Play("Swing", distanceVolume(root.Position, combo and 0.9 or 0.6), combo and base * 0.8 or (base * (0.95 + math.random() * 0.15)))
		if def.Kind == "pull" or def.Kind == "tether" then
			local repel = def.Kind == "pull" and combo
			tipCharge(model, def.Kind == "pull" and (repel and MAG_BLUE or MAG_RED) or VOID_HOT, windup)
			task.delay(windup, function()
				if root.Parent and model.Parent then
					if repel then
						repelCast(model, def)
					elseif def.Kind == "pull" then
						magnetCast(model, def)
					else
						hookCast(model, def)
					end
				end
			end)
		end
		if def.Kind == "melee" or def.Kind == "arc" or def.Kind == "slam" then
			task.delay(windup, function()
				if root.Parent then
					swoosh(root, def, combo)
					if model == player.Character then
						EffectsController.Shake(def.Limb == "Leg" and 0.18 or 0.1)
					end
				end
			end)
		end
	end
end

-- v0.7.5: your own swing plays the instant you click (the server echo for you is skipped)
local lastLocalSwing = -10
function EffectsController.LocalSwing(weaponId: string, windup: number, combo: boolean)
	local char = player.Character
	if not char then
		return
	end
	lastLocalSwing = os.clock()
	swing(char, weaponId, windup, combo)
end

------------------------------------------------------------------------
-- Effect handlers
------------------------------------------------------------------------
local HANDLERS: { [string]: (data: { [string]: any }) -> () } = {}

HANDLERS.Swing = function(d)
	if d.Model == player.Character and os.clock() - lastLocalSwing < 0.6 then
		return -- already played locally on click
	end
	if d.Model and d.Model.Parent then
		swing(d.Model, d.Weapon, d.Windup or 0.15, d.Combo == true)
	end
end

HANDLERS.Hit = function(d)
	local pos: Vector3 = d.Position
	local color = Rarity.Colors[d.Rarity] or Color3.new(1, 1, 1)
	local kb: number = d.KB or 10
	burst(pos, color, 10 + math.floor(kb), 18 + kb)
	EffectsController.Play("Hit", distanceVolume(pos, 0.9), math.clamp(1.4 - kb / 40, 0.6, 1.4))
	floatingText(pos, tostring(math.floor(kb + 0.5)), color, kb >= 18)
	-- v0.7.5 juicier impact: white flash ball, shockwave facing the hit, comic word, hit-stop
	local flash = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.5, 1.5, 1.5), CFrame = CFrame.new(pos), Color = Color3.new(1, 1, 1), Transparency = 0.05 })
	TweenService:Create(flash, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(4 + kb * 0.15, 4 + kb * 0.15, 4 + kb * 0.15), Transparency = 1 }):Play()
	Debris:AddItem(flash, 0.16)
	local atk = d.Attacker
	local hitDir = Vector3.new(0, 0, -1)
	if typeof(atk) == "Instance" and atk:IsA("Model") then
		local ar = rootOf(atk)
		if ar then
			local v = pos - ar.Position
			if v.Magnitude > 0.1 then
				hitDir = v.Unit
			end
		end
		AnimationController.HitStop(atk, 0.07)
	end
	shock(pos, hitDir, color, 1.5, 7 + kb * 0.2, 0.26)
	if kb >= 12 then
		local words = kb >= 24 and { "KABOOM!", "MEGA!" } or (kb >= 17 and { "WHAM!", "BAM!" } or { "POW!", "BOP!" })
		floatingText(pos + Vector3.new(0, 1.5, 0), words[math.random(1, #words)], Color3.fromRGB(255, 236, 110), true)
	end
	if typeof(d.Model) == "Instance" and d.Model:IsA("Model") then
		AnimationController.Flinch(d.Model)
		AnimationController.HitStop(d.Model, 0.07)
	end
	if d.Model == player.Character then
		EffectsController.Shake(0.35 + kb / 40)
	elseif d.Attacker == player.Character then
		EffectsController.Shake(0.25 + kb / 80)
	end
end

-- v0.7: L8+ KO effect — a rarity-coloured light pillar where the victim fell
HANDLERS.KOPillar = function(d)
	local pos: Vector3 = d.Position
	local color = d.Ascended and Color3.fromRGB(255, 244, 214) or (Rarity.Colors[d.Rarity] or Color3.new(1, 1, 1))
	local height = 90
	local beam = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 2.5, 2.5),
		CFrame = CFrame.new(pos.X, pos.Y + height / 2 - 10, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
	})
	local core = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 0.8, 0.8),
		CFrame = beam.CFrame,
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
		Transparency = 0,
	})
	TweenService:Create(beam, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(height, 7, 7), Transparency = 1 }):Play()
	TweenService:Create(core, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.new(height, 0.05, 0.05), Transparency = 1 }):Play()
	Debris:AddItem(beam, 1.2)
	Debris:AddItem(core, 1.0)
	EffectsController.Play("Parry", distanceVolume(pos, 0.7), 0.6)
end

HANDLERS.Parry = function(d)
	ring(d.Position, Color3.fromRGB(255, 230, 140), 3, 16, 0.35)
	burst(d.Position, Color3.fromRGB(255, 240, 180), 30, 30)
	EffectsController.Play("Parry", distanceVolume(d.Position, 1), 1.2)
	floatingText(d.Position, "PARRY!", Color3.fromRGB(255, 220, 100), true)
end

HANDLERS.Blocked = function(d)
	burst(d.Position, Color3.fromRGB(110, 210, 255), 8, 14)
end

HANDLERS.GuardBreak = function(d)
	ring(d.Position, Color3.fromRGB(110, 210, 255), 4, 10, 0.3)
	burst(d.Position, Color3.fromRGB(150, 230, 255), 26, 26)
	floatingText(d.Position, "GUARD BREAK", Color3.fromRGB(130, 220, 255), true)
	EffectsController.Play("Parry", distanceVolume(d.Position, 0.8), 0.6)
end

HANDLERS.Deflect = function(d)
	burst(d.Position, Color3.fromRGB(255, 255, 255), 14, 22)
	EffectsController.Play("Parry", distanceVolume(d.Position, 0.5), 1.6)
end

HANDLERS.Shielded = function(d)
	local root = rootOf(d.Model)
	if root then
		burst(root.Position, Color3.fromRGB(200, 220, 255), 6, 8)
	end
end

-- v0.9.18 Magnet REPEL landed: a blue ground ring in front (the cone blast itself plays with the swing)
HANDLERS.Repel = function(d)
	local pos: Vector3 = d.Position
	local dir: Vector3 = d.Dir or Vector3.new(0, 0, -1)
	ring(pos + dir * ((d.Range or 9) * 0.5) + Vector3.new(0, -2.6, 0), MAG_BLUE, 2, (d.Range or 9) * 1.4, 0.3)
end

HANDLERS.PanRing = function(d)
	ring(d.Position + Vector3.new(0, -1.5, 0), Rarity.Colors[d.Rarity] or Color3.new(1, 1, 1), 2, (d.Radius or 6) * 2 + 3, 0.3)
end

-- v0.9.20 Squeaky Hammer impact: a big ground ring + dust + a toy SQUEAK, extra crunch when the
-- tile under the hammer starts cracking
HANDLERS.Slam = function(d)
	local pos: Vector3 = d.Position
	local col = Rarity.Colors[d.Rarity] or Color3.new(1, 1, 1)
	ring(pos + Vector3.new(0, 0.2, 0), col, 2, (d.Radius or 4.5) * 2 + 2, 0.3)
	ring(pos + Vector3.new(0, 0.25, 0), Color3.fromRGB(252, 248, 238), 1, (d.Radius or 4.5) * 1.3, 0.22)
	burst(pos + Vector3.new(0, 0.6, 0), Color3.fromRGB(214, 200, 176), 16, 10)
	EffectsController.Play("Click", distanceVolume(pos, 0.9), 1.9) -- the squeak
	EffectsController.Play("Hit", distanceVolume(pos, 0.7), 0.6)
	if d.Cracked then
		EffectsController.Play("Boom", distanceVolume(pos, 0.4), 1.5)
	end
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - pos).Magnitude < 40 then
		EffectsController.Shake(0.25)
	end
end

HANDLERS.BombThrown = function(d)
	local r = d.Radius or 7
	local warn = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, r * 2, r * 2),
		CFrame = CFrame.new(d.Position - Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 50, 30),
		Transparency = 0.7,
	})
	TweenService:Create(warn, TweenInfo.new(d.Fuse or 1.2, Enum.EasingStyle.Linear), { Transparency = 0.35 }):Play()
	Debris:AddItem(warn, d.Fuse or 1.2)
end

-- v0.8.1 frost traps
local ICE = Color3.fromRGB(150, 232, 255)
HANDLERS.Freeze = function(d)
	burst(d.Position, ICE, 22, 14)
	ring(d.Position - Vector3.new(0, 2.6, 0), ICE, 2, 10, 0.35)
	EffectsController.Play("Parry", distanceVolume(d.Position, 0.8), 0.55)
	EffectsController.Play("Hit", distanceVolume(d.Position, 0.5), 1.6)
end
HANDLERS.IceShatter = function(d)
	burst(d.Position, Color3.fromRGB(230, 250, 255), 30, 24)
	for _ = 1, 6 do
		local shard = fxPart({
			Size = Vector3.new(0.5, 0.9, 0.2), Color = ICE, Material = Enum.Material.Ice, Transparency = 0.2,
			CFrame = CFrame.new(d.Position + Vector3.new(math.random(-10, 10) / 10, math.random(-10, 20) / 10, math.random(-10, 10) / 10)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
		})
		shard.Anchored = false
		shard.AssemblyLinearVelocity = Vector3.new(math.random(-14, 14), math.random(6, 18), math.random(-14, 14))
		Debris:AddItem(shard, 1.2)
	end
	EffectsController.Play("Boom", distanceVolume(d.Position, 0.5), 1.8)
end

-- v0.9.17 RUMBLE WEAPON BOXES
local BOX_GOLD = Color3.fromRGB(246, 176, 40)
HANDLERS.BoxLand = function(d)
	ring(d.Pos + Vector3.new(0, 0.2, 0), BOX_GOLD, 2, 9, 0.35)
	burst(d.Pos + Vector3.new(0, 1, 0), BOX_GOLD, 10, 12)
	EffectsController.Play("Hit", distanceVolume(d.Pos, 0.45), 0.7)
end
HANDLERS.BoxPoof = function(d)
	burst(d.Pos, Color3.fromRGB(252, 248, 238), 14, 10)
	EffectsController.Play("Tick", distanceVolume(d.Pos, 0.4), 0.8)
end
HANDLERS.BoxGrab = function(d)
	local def = Weapons.Get(d.WeaponId)
	local col = Rarity.Colors[def.Rarity] or BOX_GOLD
	burst(d.Pos, col, 26, 18)
	burst(d.Pos, BOX_GOLD, 12, 10)
	ring(d.Pos - Vector3.new(0, 1.2, 0), col, 2, 11, 0.4)
	floatingText(d.Pos + Vector3.new(0, 1, 0), string.upper(def.Name) .. "!", col, true)
	local mine = d.Model ~= nil and d.Model == player.Character
	EffectsController.Play("Win", mine and 0.8 or distanceVolume(d.Pos, 0.5), 1.15)
end

HANDLERS.Explosion = function(d)
	EffectsController.Play("Boom", distanceVolume(d.Position, 0.9), 0.9)
	local e = Instance.new("Explosion")
	e.Position = d.Position
	e.BlastRadius = 0
	e.BlastPressure = 0
	e.DestroyJointRadiusPercent = 0
	e.ExplosionType = Enum.ExplosionType.NoCraters
	e.Parent = workspace
	ring(d.Position, Color3.fromRGB(255, 120, 40), 2, (d.Radius or 7) * 2, 0.35)
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - d.Position).Magnitude < 60 then
		EffectsController.Shake(0.5)
	end
end

HANDLERS.Tether = function(d)
	if typeof(d.From) == "Instance" and d.From:IsA("Model") and typeof(d.To) == "Instance" and d.To:IsA("Model") then
		if d.Weapon == "VoidHook" then
			hookLatch(d.From, d.To, tonumber(d.Hold) or 0.45)
			return
		elseif d.Weapon == "Magnet" then
			magnetLatch(d.From, d.To, tonumber(d.Hold) or 0.3)
			return
		end
	end
	local a, b = rootOf(d.From), rootOf(d.To)
	if not a or not b then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = a
	local a1 = Instance.new("Attachment")
	a1.Parent = b
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(d.Color or Color3.fromRGB(176, 124, 255))
	beam.LightEmission = 1
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Parent = a
	Debris:AddItem(beam, 0.35)
	Debris:AddItem(a0, 0.35)
	Debris:AddItem(a1, 0.35)
end

-- v0.9.2 RUSH: a white-blue speed streak from shoulders to feet + a dust kick at the start
local lastLocalRush = -10
local function rushFx(model: Model)
	local root = rootOf(model)
	if not root then
		return
	end
	burst(root.Position - Vector3.new(0, 2.6, 0), Color3.fromRGB(235, 225, 205), 14, 14)
	local a0 = Instance.new("Attachment")
	a0.Name = "RushTrailTop"
	a0.Position = Vector3.new(0, 1.4, 0.4)
	local a1 = Instance.new("Attachment")
	a1.Name = "RushTrailBottom"
	a1.Position = Vector3.new(0, -2.2, 0.4)
	a0.Parent = root
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.28
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 0.7
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(110, 180, 255))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new(1, 0.3)
	trail.Parent = root
	-- two thin speed lines at the sides
	for _, side in { -1, 1 } do
		local s0 = Instance.new("Attachment")
		s0.Position = Vector3.new(side * 1.3, 0.2, 0.3)
		local s1 = Instance.new("Attachment")
		s1.Position = Vector3.new(side * 1.3, 0.05, 0.3)
		s0.Parent = root
		s1.Parent = root
		local line = Instance.new("Trail")
		line.Attachment0 = s0
		line.Attachment1 = s1
		line.Lifetime = 0.2
		line.FaceCamera = true
		line.LightEmission = 1
		line.Color = ColorSequence.new(Color3.new(1, 1, 1))
		line.Transparency = NumberSequence.new(0.2, 1)
		line.Parent = root
		Debris:AddItem(line, 0.6)
		Debris:AddItem(s0, 0.6)
		Debris:AddItem(s1, 0.6)
	end
	Debris:AddItem(trail, 0.6)
	Debris:AddItem(a0, 0.6)
	Debris:AddItem(a1, 0.6)
	EffectsController.Play("Whoosh", distanceVolume(root.Position, 0.5), 1.25)
end

function EffectsController.LocalRush(char: Model)
	lastLocalRush = os.clock()
	pcall(rushFx, char)
end

HANDLERS.Rush = function(d)
	if d.Model == player.Character and os.clock() - lastLocalRush < 0.6 then
		return -- already played locally
	end
	if d.Model and d.Model.Parent then
		rushFx(d.Model)
	end
end

------------------------------------------------------------------------
-- Block shields (driven by the "Blocking" attribute on any combatant model)
------------------------------------------------------------------------
local shields: { [Model]: Part } = {}

local function combatantModels(): { Model }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, m in bots:GetChildren() do
			if m:IsA("Model") then
				table.insert(list, m)
			end
		end
	end
	return list
end

local function updateShields()
	local seen = {}
	for _, m in combatantModels() do
		local root = rootOf(m)
		if root and m:GetAttribute("Blocking") == true then
			seen[m] = true
			local s = shields[m]
			if not s or not s.Parent then
				local sh = fxPart({
					Name = "Shield",
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(7, 7, 7),
					Material = Enum.Material.ForceField,
					Color = Color3.fromRGB(90, 200, 255),
					Transparency = 0.1,
				})
				shields[m] = sh
				s = sh
			end
			local guard = (m:GetAttribute("Guard") :: number?) or 100
			local sp = s :: Part
			sp.CFrame = root.CFrame
			sp.Color = Color3.fromRGB(90, 200, 255):Lerp(Color3.fromRGB(255, 70, 70), 1 - guard / 100)
		end
	end
	for m, s in shields do
		if not seen[m] then
			s:Destroy()
			shields[m] = nil
		end
	end
end

------------------------------------------------------------------------
-- Tiles: shake while cracking, spawn debris when they drop
------------------------------------------------------------------------
type Shaking = { Part: BasePart, Base: CFrame }
local shaking: { [number]: Shaking } = {}
local debrisCount = 0
local MAX_DEBRIS = 140

local function tilePart(i: number): BasePart?
	local arena = workspace:FindFirstChild("Arena")
	local tiles = arena and arena:FindFirstChild("Tiles")
	return tiles and tiles:FindFirstChild(tostring(i)) :: BasePart?
end

local function spawnDebris(part: BasePart, base: CFrame, color: Color3)
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - base.Position).Magnitude > 150 then
		return
	end
	for k = 1, 4 do
		if debrisCount >= MAX_DEBRIS then
			return
		end
		debrisCount += 1
		local ox = (k % 2 == 0) and 1 or -1
		local oz = (k > 2) and 1 or -1
		local chunk = Instance.new("Part")
		chunk.Size = Vector3.new(part.Size.X * 0.48, part.Size.Y, part.Size.Z * 0.48)
		chunk.CFrame = base * CFrame.new(ox * part.Size.X * 0.25, 0, oz * part.Size.Z * 0.25)
		chunk.Color = color
		chunk.Material = Enum.Material.Slate
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.CanTouch = false
		chunk.CastShadow = false
		chunk.AssemblyLinearVelocity = Vector3.new(ox * math.random(2, 6), math.random(-2, 4), oz * math.random(2, 6))
		chunk.AssemblyAngularVelocity = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
		chunk.Parent = fxFolder
		task.delay(2.5, function()
			chunk:Destroy()
			debrisCount -= 1
		end)
	end
end

-- v0.8 Molten Core geysers: bubbling glow + steam on the tile, then a launch column
local GEYSER = Color3.fromRGB(255, 120, 20) -- v0.8.3 real lava orange
local function geyserWarn(p: BasePart, warnTime: number)
	local top = p.Position + Vector3.new(0, p.Size.Y / 2 + 0.05, 0)
	local disc = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 2, 2), CFrame = CFrame.new(top) * CFrame.Angles(0, 0, math.rad(90)), Color = GEYSER, Transparency = 0.25 })
	TweenService:Create(disc, TweenInfo.new(warnTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.new(0.12, 7.2, 7.2), Transparency = 0.05 }):Play()
	Debris:AddItem(disc, warnTime)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 30
	pe.Lifetime = NumberRange.new(0.6, 1.1)
	pe.Speed = NumberRange.new(4, 9)
	pe.SpreadAngle = Vector2.new(20, 20)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	pe.Transparency = NumberSequence.new(0.3, 1)
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(120, 100, 96))
	local anchor = fxPart({ Transparency = 1, Size = Vector3.new(6, 0.2, 6), CFrame = CFrame.new(top) })
	pe.Parent = anchor
	Debris:AddItem(anchor, warnTime + 0.2)
	EffectsController.Play("Bubble", distanceVolume(top, 0.6), 0.6)
end

local function geyserErupt(p: BasePart)
	local base = p.Position + Vector3.new(0, p.Size.Y / 2, 0)
	local col = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 5, 5), CFrame = CFrame.new(base + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 170, 50), Material = Enum.Material.Neon, Transparency = 0.15 })
	TweenService:Create(col, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(34, 3, 3), CFrame = CFrame.new(base + Vector3.new(0, 17, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 1 }):Play()
	Debris:AddItem(col, 0.5)
	burst(base + Vector3.new(0, 1, 0), GEYSER, 24, 26)
	ring(base + Vector3.new(0, 0.3, 0), GEYSER, 2, 12, 0.35)
	EffectsController.Play("Whoosh", distanceVolume(base, 0.9), 1.15)
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - base).Magnitude < 50 then
		EffectsController.Shake(0.35)
	end
end

local lastDropSound = 0
local function onTileEvent(kind: string, indices: { number }, extra: any)
	-- v0.8.2 crane drops / eruption
	if kind == "drop" or kind == "slam" then
		for _, i in indices do
			local p = tilePart(i)
			if p then
				local top = p.Position + Vector3.new(0, p.Size.Y / 2 + 0.06, 0)
				if kind == "drop" then
					local warn = type(extra) == "number" and extra or 2
					-- a dark shadow that grows as the weight is about to fall + a hazard ring
					local shadow = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 2, 2), CFrame = CFrame.new(top) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(30, 30, 40), Material = Enum.Material.SmoothPlastic, Transparency = 0.6 })
					TweenService:Create(shadow, TweenInfo.new(warn, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.new(0.1, 7.5, 7.5), Transparency = 0.15 }):Play()
					Debris:AddItem(shadow, warn + 0.1)
					local ringP = fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.08, 22, 22), CFrame = CFrame.new(top + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 196, 40), Transparency = 0.7 })
					TweenService:Create(ringP, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.35 }):Play()
					Debris:AddItem(ringP, warn + 0.1)
					local anchor = fxPart({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(top + Vector3.new(0, 6, 0)) })
					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(60, 60)
					bb.AlwaysOnTop = true
					bb.MaxDistance = 220
					local t = Instance.new("TextLabel")
					t.Size = UDim2.fromScale(1, 1)
					t.BackgroundTransparency = 1
					t.Font = Enum.Font.GothamBlack
					t.TextScaled = true
					t.Text = ""
					UI.setIcon(t, "warn", nil, 0.9)
					t.TextColor3 = Color3.fromRGB(255, 196, 40)
					t.TextStrokeTransparency = 0
					t.Parent = bb
					bb.Parent = anchor
					Debris:AddItem(anchor, warn)
					EffectsController.Play("Tick", distanceVolume(top, 0.6), 0.7)
				else
					burst(top + Vector3.new(0, 0.5, 0), Color3.fromRGB(214, 206, 190), 36, 22)
					ring(top, Color3.fromRGB(255, 196, 40), 3, 24, 0.35)
					ring(top, Color3.new(1, 1, 1), 2, 16, 0.25)
					floatingText(top + Vector3.new(0, 2, 0), "CLANG!", Color3.fromRGB(255, 196, 40), true)
					EffectsController.Play("Boom", distanceVolume(top, 1), 0.75)
					local cam = workspace.CurrentCamera
					if cam and (cam.CFrame.Position - top).Magnitude < 70 then
						EffectsController.Shake(0.8)
					end
				end
			end
		end
		return
	end
	if kind == "eruption" then
		EffectsController.Play("Whoosh", 0.9, 0.6)
		EffectsController.Play("Boom", 0.8, 0.5)
		EffectsController.Shake(1)
		return
	end
	if kind == "gustwarn" then
		EffectsController.Play("Whoosh", 0.7, 0.45)
		return
	end
	-- v0.8.1 hazards
	if kind == "magma" or kind == "magmalive" or kind == "swallow" or kind == "magmacool" or kind == "trapsnap" then
		for _, i in indices do
			local p = tilePart(i)
			if p then
				local top = p.Position + Vector3.new(0, p.Size.Y / 2 + 0.2, 0)
				if kind == "magma" then
					geyserWarn(p, type(extra) == "number" and extra or 1.5)
				elseif kind == "magmalive" then
					burst(top, Color3.fromRGB(255, 150, 40), 14, 8)
					EffectsController.Play("Bubble", distanceVolume(top, 0.5), 0.5)
				elseif kind == "swallow" then
					burst(top, Color3.fromRGB(255, 110, 20), 30, 18)
					ring(top, Color3.fromRGB(255, 110, 20), 3, 14, 0.4)
					floatingText(top, "GULP!", Color3.fromRGB(255, 130, 30), true)
					EffectsController.Play("Boom", distanceVolume(top, 0.6), 0.6)
				elseif kind == "magmacool" then
					burst(top, Color3.fromRGB(110, 100, 96), 10, 5)
				else
					ring(top, Color3.fromRGB(150, 232, 255), 2, 12, 0.3)
				end
			end
		end
		return
	end
	if kind == "geyser" or kind == "erupt" then
		for _, i in indices do
			local p = tilePart(i)
			if p then
				if kind == "geyser" then
					geyserWarn(p, type(extra) == "number" and extra or 1.6)
				else
					geyserErupt(p)
				end
			end
		end
		return
	end
	if kind == "fall" and os.clock() - lastDropSound > 0.25 then
		-- v0.8 sound pass: a soft thud when tiles drop near you
		local p = indices[1] and tilePart(indices[1])
		if p then
			lastDropSound = os.clock()
			EffectsController.Play("Hit", distanceVolume(p.Position, 0.35), 0.55)
		end
	end
	if kind == "reset" then
		for _, s in shaking do
			s.Part.CFrame = s.Base
		end
		table.clear(shaking)
		return
	end
	for _, i in indices do
		local p = tilePart(i)
		if p then
			if kind == "warn" then
				shaking[i] = { Part = p, Base = p.CFrame }
			elseif kind == "fall" then
				local s = shaking[i]
				local base = s and s.Base or p.CFrame
				p.CFrame = base
				shaking[i] = nil
				spawnDebris(p, base, p.Color)
			end
		end
	end
end

------------------------------------------------------------------------
-- Per-frame
------------------------------------------------------------------------
local shieldTimer = 0

local function onRender(dt: number)
	-- tile shake (only near the camera)
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	for _, s in shaking do
		if (s.Base.Position - camPos).Magnitude < 110 then
			local a = 0.12
			s.Part.CFrame = s.Base * CFrame.new(math.random() * a * 2 - a, math.random() * a * 2 - a, math.random() * a * 2 - a)
		end
	end

	-- screen shake via camera offset
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		-- v1.0.1: the over-the-shoulder offset fades out as you zoom into first person
		local base = BASE_CAM_OFFSET * CameraController.OffsetScale()
		if shake > 0.01 then
			local m = shake
			hum.CameraOffset = base + Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, (math.random() - 0.5) * m)
			shake = math.max(0, shake - dt * 2.5)
		elseif (hum.CameraOffset - base).Magnitude > 0.01 then
			hum.CameraOffset = base
		end
	end

	shieldTimer += dt
	if shieldTimer > 0.033 then
		shieldTimer = 0
		updateShields()
	end
end

-- v0.9.11 Training Range shots: Slingshot pellet (straight, fast) / Bomb Bag lob (arc + spark)
HANDLERS.RangeShot = function(d)
	local from, to = d.From, d.To
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return
	end
	local tt = math.max(tonumber(d.Time) or 0.2, 0.05)
	local bomb = d.Kind == "thrown"
	local p = fxPart({
		Shape = Enum.PartType.Ball,
		Size = bomb and Vector3.new(1.5, 1.5, 1.5) or Vector3.new(0.6, 0.6, 0.6),
		CFrame = CFrame.new(from),
		Color = bomb and Color3.fromRGB(40, 44, 60) or (Rarity.Colors[d.Rarity] or Color3.fromRGB(230, 230, 230)),
		Material = bomb and Enum.Material.SmoothPlastic or Enum.Material.Neon,
	})
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.25, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.25, 0)
	a1.Parent = p
	local tr = Instance.new("Trail")
	tr.Attachment0, tr.Attachment1 = a0, a1
	tr.Color = ColorSequence.new(bomb and Color3.fromRGB(255, 200, 120) or Color3.new(1, 1, 1))
	tr.Transparency = NumberSequence.new(0.3, 1)
	tr.Lifetime = 0.15
	tr.LightEmission = 1
	tr.Parent = p
	local peak = bomb and math.max(4, (to - from).Magnitude * 0.25) or 0
	everyFrame(tt + 0.3, function(e)
		local k = math.clamp(e / tt, 0, 1)
		local pos = from:Lerp(to, k) + Vector3.new(0, peak * 4 * k * (1 - k), 0)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(e * 8, e * 5, 0)
		if k >= 1 then
			if not bomb then
				burst(pos, Color3.new(1, 1, 1), 6, 8)
			end
			p:Destroy()
			return true
		end
		return false
	end)
end

-- test hook (headless smoke test drives the effect handlers directly)
EffectsController.TestHandlers = HANDLERS

function EffectsController.Init()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFX"
	fxFolder.Parent = workspace

	Net.Get("Effect").OnClientEvent:Connect(function(kind: string, data: { [string]: any })
		local h = HANDLERS[kind]
		if h then
			local ok, err = pcall(h, data)
			if not ok then
				warn("[CRUMBLE] effect error", kind, err)
			end
		end
	end)
	Net.Get("TileEvent").OnClientEvent:Connect(onTileEvent)
	RunService.RenderStepped:Connect(onRender)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — HUDController
	Top bar (phase · timer · alive), profile card, action bar (cooldowns + guard),
	kill feed, Foreman banners, countdown, "YOU FELL" card + spectate, results screen,
	toasts, and the DEV test-loadout panel.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Weapons = require(Shared.Weapons)
local Rarity = require(Shared.Rarity)
local Descriptions = require(Shared:WaitForChild("Descriptions"))

local UI = require(script.Parent.UI)
local Layout = require(script.Parent:WaitForChild("Layout"))
local InputController = require(script.Parent.InputController)
local EffectsController = require(script.Parent.EffectsController)

local player = Players.LocalPlayer
local Col = UI.Colors

local HUDController = {}

local gui: ScreenGui
local refs: { [string]: any } = {}
local _profile: { [string]: any } = {}
local spectating = false
local spectateIndex = 1
local lastCountdown = -1

local function now(): number
	return workspace:GetServerTimeNow()
end

local function hex(c: Color3): string
	return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end

------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------
local function panel(props: { [string]: any }): Frame
	local base = { BackgroundColor3 = Col.Panel, BackgroundTransparency = 0.04, BorderSizePixel = 0 }
	for k, v in props do
		base[k] = v
	end
	local f = UI.new("Frame", base)
	UI.corner(12).Parent = f
	UI.stroke(Col.Line, 1.5, 0.3).Parent = f
	return f
end

local function bar(parent: Instance, pos: UDim2, size: UDim2, color: Color3, labelText: string): (Frame, TextLabel)
	local back = UI.new("Frame", {
		Parent = parent,
		Position = pos,
		Size = size,
		BackgroundColor3 = Col.Panel2,
		BorderSizePixel = 0,
	})
	UI.corner(6).Parent = back
	local fill = UI.new("Frame", {
		Parent = back,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	})
	UI.corner(6).Parent = fill
	local label = UI.label({
		Parent = back,
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromOffset(6, 3),
		Text = labelText,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
	})
	return fill, label
end

local function buildTopBar()
	-- v0.7.3 layout: three separate rounded chips (phase | round timer bubble | players left)
	local top = UI.new("Frame", {
		Name = "TopBar",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(470, 70),
		BackgroundTransparency = 1,
	})
	refs.TopBar = top
	local left = panel({ Name = "PhaseChip", Parent = top, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(176, 52) })
	local amberDot = UI.new("Frame", { Parent = left, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(10, 32), BackgroundColor3 = Col.Amber, BorderSizePixel = 0 })
	UI.corner(5).Parent = amberDot
	refs.Phase = UI.label({ Parent = left, Position = UDim2.fromOffset(28, 6), Size = UDim2.fromOffset(140, 22), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Amber, Font = Enum.Font.GothamBlack, Text = "WAITING" })
	refs.Map = UI.label({ Parent = left, Position = UDim2.fromOffset(28, 29), Size = UDim2.fromOffset(200, 16), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "CLASSIC" })
	local bubble = UI.new("Frame", { Name = "TimerBubble", Parent = top, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(104, 70), BackgroundColor3 = Col.Panel, BorderSizePixel = 0 })
	UI.corner(35).Parent = bubble
	UI.stroke(Col.Amber, 4, 0).Parent = bubble
	refs.Timer = UI.label({ Parent = bubble, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(88, 40), Font = Enum.Font.GothamBlack, Text = "--:--" })
	local right = panel({ Name = "AliveChip", Parent = top, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(176, 52) })
	local blueDot = UI.new("Frame", { Parent = right, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(10, 32), BackgroundColor3 = Col.Blue, BorderSizePixel = 0 })
	UI.corner(5).Parent = blueDot
	refs.Alive = UI.label({ Parent = right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -28, 0, 5), Size = UDim2.fromOffset(140, 26), TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBlack, Text = "" })
	refs.AliveSub = UI.label({ Parent = right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -28, 0, 30), Size = UDim2.fromOffset(140, 16), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Col.Mute, Text = "" })

	-- v0.7.2 hint pill (reference style): white pill, dark "i" bubble, short instruction
	local pill = UI.new("Frame", {
		Name = "HintPill",
