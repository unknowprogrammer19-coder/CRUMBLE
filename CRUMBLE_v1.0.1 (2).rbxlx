local function buildVault()
	local page = pages.Vault
	local left = UI.new("Frame", { Parent = page, Size = UDim2.new(0, 270, 1, 0), BackgroundColor3 = Col.Panel2, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 22 })
	UI.corner(10).Parent = left
	UI.label({ Parent = left, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 20), Font = Enum.Font.GothamBlack, TextColor3 = Col.Gold, TextXAlignment = Enum.TextXAlignment.Left, Text = "EXACT ODDS", ZIndex = 23 })
	for i, r in Rarity.Order do
		local y = 32 + (i - 1) * 22
		UI.label({ Parent = left, Position = UDim2.fromOffset(12, y), Size = UDim2.fromOffset(150, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Rarity.Colors[r], Font = Enum.Font.GothamBlack, Text = r, ZIndex = 23 })
		UI.label({ Parent = left, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, y), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(Config.Spins.Odds[r]) .. "%", ZIndex = 23 })
	end
	UI.label({ Parent = left, Position = UDim2.fromOffset(12, 172), Size = UDim2.new(1, -24, 0, 20), Font = Enum.Font.GothamBlack, TextColor3 = Col.Gold, TextXAlignment = Enum.TextXAlignment.Left, Text = "PITY (guaranteed)", ZIndex = 23 })
	refs.Pity = {}
	for i, tier in { "Epic", "Legendary", "Mythic" } do
		local fill, label = bar(left, UDim2.fromOffset(12, 196 + (i - 1) * 28), UDim2.new(1, -24, 0, 22), Rarity.Colors[tier])
		refs.Pity[tier] = { Fill = fill, Label = label }
	end
	refs.PoolNote = UI.label({ Parent = left, Position = UDim2.fromOffset(12, 286), Size = UDim2.new(1, -24, 0, 70), TextWrapped = true, TextScaled = false, TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Col.Mute, Text = "New weapons first. Dupes = merge copies. Maxed dupes = coins.\n" .. Descriptions.RarityLine, ZIndex = 23 })

	-- reveal box
	local box = UI.new("TextButton", { Parent = page, Position = UDim2.fromOffset(284, 0), Size = UDim2.new(1, -284, 0, 158), BackgroundColor3 = Color3.fromRGB(44, 50, 86), AutoButtonColor = false, Text = "", BorderSizePixel = 0, ZIndex = 22 })
	UI.corner(12).Parent = box
	refs.RevealStroke = UI.stroke(Col.Line, 3, 0)
	refs.RevealStroke.Parent = box
	refs.RevealBox = box
	refs.RevealName = UI.label({ Parent = box, Position = UDim2.fromOffset(10, 34), Size = UDim2.new(1, -20, 0, 58), Font = Enum.Font.GothamBlack, Text = "SPIN VAULT", TextColor3 = Col.Gold, ZIndex = 23 })
	refs.RevealSub = UI.label({ Parent = box, Position = UDim2.fromOffset(10, 94), Size = UDim2.new(1, -20, 0, 38), TextWrapped = true, Text = "Odds + pity always shown.", TextColor3 = Col.Mute, ZIndex = 23 })
	UI.new("UITextSizeConstraint", { Parent = refs.RevealSub, MaxTextSize = 20 })
	refs.RevealTag = UI.label({ Parent = box, Position = UDim2.fromOffset(10, 12), Size = UDim2.new(1, -20, 0, 22), Font = Enum.Font.GothamBlack, Text = "", TextColor3 = Col.Gold, ZIndex = 23 })
	refs.RevealCount = UI.label({ Parent = box, Position = UDim2.fromOffset(10, 134), Size = UDim2.new(1, -20, 0, 18), Text = "", TextColor3 = Col.Mute, ZIndex = 23 })
	box.Activated:Connect(function()
		if revealing then
			skipReveal = true
		end
	end)

	-- v0.9.23: the hourly COIN SPIN (full-width bar: gold "COIN SPIN!" when ready, a countdown otherwise)
	refs.CoinSpinBtn = UI.button({ Parent = page, Position = UDim2.fromOffset(284, 166), Size = UDim2.new(1, -284, 0, 42), Text = "COIN SPIN", BackgroundColor3 = Col.Gold, ZIndex = 22 })
	-- v0.9.22: SKIP TIMER (Robux) sits right of the countdown while it runs
	refs.SkipBtn = UI.button({ Parent = page, Position = UDim2.fromOffset(662, 166), Size = UDim2.new(1, -662, 0, 42), Text = "SKIP", BackgroundColor3 = Col.Gold, Visible = false, ZIndex = 22 })
	refs.SpinBtn = UI.button({ Parent = page, Position = UDim2.fromOffset(284, 216), Size = UDim2.fromOffset(250, 42), Text = "SPIN", BackgroundColor3 = Col.Lava, ZIndex = 22 })
	refs.SpinAllBtn = UI.button({ Parent = page, Position = UDim2.fromOffset(542, 216), Size = UDim2.new(1, -542, 0, 42), Text = "SPIN ALL", ZIndex = 22 })
	UI.label({ Parent = page, Position = UDim2.fromOffset(284, 264), Size = UDim2.new(1, -284, 0, 16), TextColor3 = Col.Mute, Text = string.format("Spins: L2 · L3 · every %d levels · dailies · quests · season · coin spin %s coins every hour", Config.MilestoneSpinEvery, UI.comma(Config.Spins.CoinSpinCost)), ZIndex = 22 })

	local log = UI.new("ScrollingFrame", { Parent = page, Position = UDim2.fromOffset(284, 286), Size = UDim2.new(1, -284, 1, -286), BackgroundColor3 = Col.Panel2, BackgroundTransparency = 0.3, BorderSizePixel = 0, ScrollBarThickness = 5, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 22 })
	UI.corner(8).Parent = log
	UI.padding(6).Parent = log
	UI.new("UIListLayout", { Parent = log, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.SpinLog = log
end

local logOrder = 0
local function logLine(text: string, color: Color3)
	logOrder += 1
	UI.label({ Parent = refs.SpinLog, LayoutOrder = -logOrder, Size = UDim2.new(1, -6, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, TextColor3 = color, Text = text, ZIndex = 23 })
	local rows = {}
	for _, ch in (refs.SpinLog :: ScrollingFrame):GetChildren() do
		if ch:IsA("TextLabel") then
			table.insert(rows, ch)
		end
	end
	if #rows > 40 then
		table.sort(rows, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		rows[#rows]:Destroy()
	end
end

local function describe(r: { [string]: any }): (string, string)
	local def = Weapons.Get(r.WeaponId)
	if r.Kind == "New" then
		return "NEW WEAPON!", Descriptions.Weapon(def.Id).Desc .. " Equip it in WEAPONS."
	elseif r.Kind == "Refund" then
		return "+" .. tostring(r.Coins) .. " COINS", def.Name .. " is already L10, so the copy became coins"
	else
		local need = r.Need and (" / " .. r.Need) or ""
		return "+1 COPY", string.format("%s: %d%s copies toward L%d", def.Name, r.Copies or 0, need, (r.Level or 1) + 1)
	end
end

local function revealOne(r: { [string]: any }, fast: boolean)
	local def = Weapons.Get(r.WeaponId)
	local rc = Rarity.Colors[def.Rarity]
	local name, sub = refs.RevealName :: TextLabel, refs.RevealSub :: TextLabel
	refs.RevealTag.Text = ""
	sub.Text = ""
	-- reel: cycle random weapons, slowing down
	local steps = fast and 6 or 16
	for i = 1, steps do
		if skipReveal then
			break
		end
		local other = Weapons.List[math.random(2, #Weapons.List)]
		name.Text = string.upper(other.Name)
		name.TextColor3 = Rarity.Colors[other.Rarity]
		EffectsController.Play("Tick", 0.35, 1 + i / steps)
		task.wait((fast and 0.03 or 0.04) + (i / steps) ^ 2 * (fast and 0.08 or 0.18))
	end
	name.Text = string.upper(def.Name)
	name.TextColor3 = rc
	refs.RevealStroke.Color = rc
	local head, detail = describe(r)
	refs.RevealTag.Text = string.upper(def.Rarity) .. "  ·  " .. head .. (r.Pity and ("  ·  " .. string.upper(r.Pity) .. " PITY") or "")
	refs.RevealTag.TextColor3 = rc
	sub.Text = detail
	local idx = Rarity.Index(def.Rarity)
	refs.RevealBox.BackgroundColor3 = rc:Lerp(Color3.new(0, 0, 0), 0.65)
	TweenService:Create(refs.RevealBox, TweenInfo.new(0.8), { BackgroundColor3 = Color3.fromRGB(44, 50, 86) }):Play()
	if idx >= 5 then
		EffectsController.Play("Parry", 0.9, 0.8)
		EffectsController.Play("Win", 0.9, 1.0)
	elseif idx >= 3 then
		EffectsController.Play("Win", 0.7, 1.3)
	else
		EffectsController.Play("Hit", 0.5, 1.2)
	end
	logLine(string.format('<font color="#%s"><b>%s</b></font> (%s) — %s', rc:ToHex(), def.Name, def.Rarity, head), Col.Text)
end

-- v0.9.22 AUTO MERGE pass: "Bat L2→L4 · Pan L1→L2"
local function mergedText(list: { any }?): string
	local parts = {}
	for _, m in (list or {}) :: { any } do
		table.insert(parts, string.format("%s L%d→L%d", Weapons.Get(m.WeaponId).Name, m.From, m.To))
	end
	return table.concat(parts, " · ")
end

local function hasPass(key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

-- v1.0 patch: the lobby PRIZE WHEEL (Spin Vault) turns slowly and whirls when you spin
local wheelBoostUntil = 0
local function runPrizeWheels()
	local angle = 0
	local wheels: { [Model]: CFrame } = {}
	local function add(inst: Instance)
		local hubCf = inst:GetAttribute("Hub")
		if inst:IsA("Model") and typeof(hubCf) == "CFrame" then
			wheels[inst] = hubCf
		end
	end
	for _, w in CollectionService:GetTagged("CrumbleSpinWheel") do
		add(w)
	end
	pcall(function()
		CollectionService:GetInstanceAddedSignal("CrumbleSpinWheel"):Connect(add)
		CollectionService:GetInstanceRemovedSignal("CrumbleSpinWheel"):Connect(function(inst)
			wheels[inst :: Model] = nil
		end)
	end)
	RunService.RenderStepped:Connect(function(dt)
		if next(wheels) == nil then
			return
		end
		local left = wheelBoostUntil - os.clock()
		local speed = 0.35 + (if left > 0 then 9 * math.min(1, left / 2.5) else 0) -- rad/s, eases out
		angle = (angle + speed * dt) % (math.pi * 2)
		for w, hubCf in wheels do
			if w.Parent then
				w:PivotTo(hubCf * CFrame.Angles(0, 0, angle))
			end
		end
	end)
end

local function doSpin(action: string, count: number?)
	wheelBoostUntil = os.clock() + 3.2
	if revealing then
		return
	end
	local res = call(action, count)
	if not res or not res.Ok then
		return
	end
	setStatus("")
	revealing = true
	skipReveal = false
	local results = res.Results or {}
	for i, r in results do
		refs.RevealCount.Text = #results > 1 and string.format("%d / %d   (click to skip)", i, #results) or "(click to skip)"
		revealOne(r, #results > 1)
		if i < #results and not skipReveal then
			task.wait(0.45)
		end
	end
	refs.RevealCount.Text = ""
	revealing = false
	skipReveal = false
	if res.Merged then
		setStatus("AUTO MERGE: " .. mergedText(res.Merged), Col.Good)
	end
	if refreshers.Vault then
		refreshers.Vault()
	end
end

-- v0.9.23 hourly COIN SPIN: the server sends seconds-left; we count down on os.clock
local coinReadyAt = math.huge
local function coinSpinLeft(): number
	return math.max(0, coinReadyAt - os.clock())
end

local function refreshCoinSpin()
	local btn = refs.CoinSpinBtn :: TextButton?
	local left = coinSpinLeft()
	local cost = Config.Spins.CoinSpinCost
	local coins = profile and profile.Coins or 0
	local ready = coinReadyAt ~= math.huge and left <= 0
	if refs.SpinBadge and profile then
		-- the dock badge counts a coin spin only when it's ready AND affordable
		local n = (profile.Spins or 0) + ((ready and coins >= cost) and 1 or 0)
		refs.SpinBadge.Visible = n > 0
		refs.SpinBadge.Text = tostring(n)
	end
	if not btn then
		return
	end
	if coinReadyAt == math.huge then
		btn.Text = "COIN SPIN  " .. UI.comma(cost)
		btn.BackgroundColor3 = Col.Panel2
	elseif ready then
		if coins >= cost then
			btn.Text = "COIN SPIN!  " .. UI.comma(cost) .. " COINS"
			btn.BackgroundColor3 = Col.Gold
		else
			btn.Text = string.format("COIN SPIN  %s COINS  (YOU HAVE %s)", UI.comma(cost), UI.comma(coins))
			btn.BackgroundColor3 = Col.Panel2
		end
	else
		local sec = math.ceil(left)
		btn.Text = string.format("NEXT COIN SPIN  %d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60)
		btn.BackgroundColor3 = Col.Panel2
	end
	-- SKIP TIMER: only while counting down, not for restricted accounts, 3 a day
	local skip = refs.SkipBtn :: TextButton?
	if skip then
		local show = coinReadyAt ~= math.huge and left > 0 and player:GetAttribute("PaidRandomRestricted") == false and ReplicatedStorage:GetAttribute("ShopOpen") ~= false and (profile and (profile.SkipsLeft or 0) > 0 and (profile.Tutorial or 0) >= Config.Tutorial.Done) == true
		skip.Visible = show
		btn.Size = show and UDim2.fromOffset(370, 42) or UDim2.new(1, -284, 0, 42)
		for _, prod in Config.Shop.Products do
			if prod.SkipTimer then
				skip.Text = "SKIP  R$" .. prod.Price
			end
		end
	end
end

refreshers.Vault = function()
	local p = profile
	if not p then
		return
	end
	local spins = p.Spins or 0
	refs.SpinBtn.Text = spins > 0 and string.format("SPIN  (%d)", spins) or "NO SPINS"
	refs.SpinBtn.BackgroundColor3 = spins > 0 and Col.Lava or Col.Panel2
	local batch = math.min(spins, Config.Spins.MaxBatch)
	refs.SpinAllBtn.Visible = batch > 1
	refs.SpinAllBtn.Text = string.format("SPIN x%d", batch)
	refreshCoinSpin()
	local pity = p.Pity or {}
	for tier, r in refs.Pity do
		local limit = Config.Spins.Pity[tier]
		local count = pity[tier] or 0
		r.Fill.Size = UDim2.fromScale(math.clamp(count / limit, 0, 1), 1)
		r.Label.Text = string.format("%s%s guaranteed in %d", tier, tier == "Mythic" and "" or "+", math.max(1, limit - count))
	end
end

