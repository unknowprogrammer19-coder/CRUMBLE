local function buildQuests()
	local page = pages.Quests
	refs.QTitleDaily = heading(page, UDim2.fromOffset(0, 0), UDim2.fromOffset(380, 22), "DAILY QUESTS")
	refs.QDaily = {}
	for i = 1, Config.Retention.DailyCount do
		local c = card(page, UDim2.fromOffset(0, 28 + (i - 1) * 74), UDim2.fromOffset(380, 66))
		local text = UI.label({ Parent = c, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -110, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 23 })
		local reward = UI.label({ Parent = c, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(92, 24), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Col.Gold, ZIndex = 23 })
		local fill, label = bar(c, UDim2.fromOffset(12, 36), UDim2.new(1, -24, 0, 20), Col.Good)
		refs.QDaily[i] = { Card = c, Text = text, Reward = reward, Fill = fill, Label = label }
	end
	refs.QStarterTitle = heading(page, UDim2.fromOffset(0, 262), UDim2.fromOffset(380, 22), "STARTER QUESTS")
	refs.QStarter = {}
	for i, q in Config.StarterQuests do
		refs.QStarter[q.Id] = UI.label({ Parent = page, Position = UDim2.fromOffset(4, 288 + (i - 1) * 26), Size = UDim2.fromOffset(376, 22), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 23 })
	end
	UI.label({ Parent = page, Position = UDim2.fromOffset(0, 376), Size = UDim2.fromOffset(380, 40), TextWrapped = true, TextScaled = false, TextSize = 13, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Col.Mute, Text = "Rewards pay instantly. Bot KOs count.", ZIndex = 23 })

	local replay = UI.button({ Parent = page, Position = UDim2.fromOffset(400, 390), Size = UDim2.fromOffset(190, 36), Text = "REPLAY TUTORIAL", BackgroundColor3 = Col.Blue, TextColor3 = Color3.new(1, 1, 1), ZIndex = 23 })
	-- v1.0: Roblox's own "invite friends" pop-up
	local inv = UI.button({ Name = "InviteButton", Parent = page, Position = UDim2.fromOffset(602, 390), Size = UDim2.fromOffset(190, 36), Text = "INVITE FRIENDS", BackgroundColor3 = Col.Good, TextColor3 = Color3.new(1, 1, 1), ZIndex = 23 })
	inv.Activated:Connect(function()
		EffectsController.Play("Click", 0.4)
		local ok, msg = Social.Invite()
		if not ok and msg then
			setStatus(msg, Col.Mute)
		end
	end)
	replay.Activated:Connect(function()
		local res = call("TutorialRestart")
		if res and res.Ok then
			MenuController.Close()
		end
	end)
	refs.QTitleWeekly = heading(page, UDim2.fromOffset(400, 0), UDim2.new(1, -400, 0, 22), "WEEKLY CHAIN", Col.Blue)
	refs.QWeekly = {}
	for i, step in Config.Retention.Weekly do
		local c = card(page, UDim2.fromOffset(400, 28 + (i - 1) * 70), UDim2.new(1, -400, 0, 62))
		local num = UI.label({ Parent = c, Position = UDim2.fromOffset(8, 11), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 0, BackgroundColor3 = Col.Panel, Text = tostring(i), ZIndex = 23 })
		UI.corner(20).Parent = num
		local text = UI.label({ Parent = c, Position = UDim2.fromOffset(56, 6), Size = UDim2.new(1, -170, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Text = step.Text, ZIndex = 23 })
		local reward = UI.label({ Parent = c, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 6), Size = UDim2.fromOffset(104, 22), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Col.Gold, Text = step.Spins and ("+" .. step.Spins .. " SPIN") or ("+" .. tostring(step.Coins) .. " coins"), ZIndex = 23 })
		local fill, label = bar(c, UDim2.fromOffset(56, 34), UDim2.new(1, -66, 0, 18), Col.Blue)
		refs.QWeekly[i] = { Card = c, Num = num, Text = text, Reward = reward, Fill = fill, Label = label }
	end
end

refreshers.Quests = function()
	local p = profile
	if not p then
		return
	end
	local now = os.time()
	local daily = p.Daily or {}
	-- v0.9.13: all-dailies bonus spin
	local bonus = (Config.Retention.DailyAllSpins or 0) > 0
			and (daily.BonusPaid and '<font color="#%s">BONUS SPIN GOT</font> ' or '<font color="#%s">ALL 3 = +1 SPIN</font> ')
		or ""
	if bonus ~= "" then
		bonus = string.format(bonus, Col.Good:ToHex())
	end
	refs.QTitleDaily.Text = string.format('DAILY QUESTS  %s<font color="#%s">· new in %s</font>', bonus, Col.Mute:ToHex(), timeLeft(86400 - now % 86400))
	local fresh = daily.Day == Retention.DayIndex(now)
	for i, r in refs.QDaily do
		local id = fresh and daily.Ids and daily.Ids[i]
		local q = id and Retention.DailyDef(id)
		r.Card.Visible = q ~= nil
		if q then
			local prog = (daily.Progress and daily.Progress[id]) or 0
			local done = daily.Done and daily.Done[id]
			r.Text.Text = done and ('<font color="#34BA60"><s>' .. q.Text .. '</s>  DONE</font>') or q.Text
			r.Reward.Text = q.Spins and ("+" .. q.Spins .. " SPIN") or ("+" .. tostring(q.Coins) .. " coins")
			r.Fill.Size = UDim2.fromScale(math.clamp(prog / q.Goal, 0, 1), 1)
			r.Label.Text = done and "DONE!" or string.format("%d / %d", prog, q.Goal)
		end
	end
	local allStarter = true
	for _, q in Config.StarterQuests do
		local done = p.Quests and p.Quests[q.Id]
		allStarter = allStarter and done == true
		local reward = q.Coins and ("+" .. q.Coins .. " coins") or ("+" .. (q.Spins or 1) .. " spin")
		refs.QStarter[q.Id].Text = string.format('<font color="#%s">%s</font> %s  <font color="#%s">%s</font>', (done and Col.Good or Col.Mute):ToHex(), done and "DONE" or "•", q.Text, Col.Gold:ToHex(), reward)
	end
	refs.QStarterTitle.Text = allStarter and "STARTER QUESTS · ALL DONE" or "STARTER QUESTS"
	local w = p.Weekly or {}
	local week = Retention.WeekIndex(now)
	local step = (w.Week == week) and (w.Step or 1) or 1
	local progress = (w.Week == week) and (w.Progress or 0) or 0
	local nextWeek = (week + 1) * 7 * 86400 + 4 * 86400
	refs.QTitleWeekly.Text = string.format('WEEKLY CHAIN  <font color="#%s">· resets in %s</font>', Col.Mute:ToHex(), timeLeft(nextWeek - now))
	for i, r in refs.QWeekly do
		local def = Config.Retention.Weekly[i]
		local state = i < step and "done" or (i == step and "now" or "locked")
		UI.setIcon(r.Num, state == "done" and "check" or nil, Color3.new(1, 1, 1), 0.7)
		if state ~= "done" then
			r.Num.Text = tostring(i)
		end
		r.Num.BackgroundColor3 = state == "done" and Col.Good or (state == "now" and Col.Blue or Col.Panel)
		r.Text.TextColor3 = state == "locked" and Col.Mute or Col.Text
		r.Fill.Size = UDim2.fromScale(state == "done" and 1 or (state == "now" and math.clamp(progress / def.Goal, 0, 1) or 0), 1)
		r.Label.Text = state == "done" and "DONE!" or (state == "now" and string.format("%d / %d", progress, def.Goal) or "LOCKED")
		r.Card.BackgroundTransparency = state == "locked" and 0.45 or 0.1
	end
end

------------------------------------------------------------------------
-- SEASON (free track). v1.0: the locked "PASS" preview lane is gone (the premium Season Pass is
-- a concept in the design doc for now); the free track uses the whole page.
------------------------------------------------------------------------
local seasonCells: { { [string]: any } } = {}
local MONTHS = { "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC" }
local CELL_W, CELL_GAP = 120, 10

local function dayMonth(unix: number): (string, number)
	local d = os.date("!*t", unix) :: any
	return string.format("%d %s", d.day, MONTHS[d.month]), d.year
end

local function seasonDates(): string
	local a = dayMonth(Config.Season.StartsAt)
	local b, y = dayMonth(Config.Season.EndsAt - 1)
	return string.format("%s – %s %d", a, b, y)
end

local function buildSeason()
	local page = pages.Season
	local purple = Color3.fromRGB(150, 90, 230)
	refs.SName = heading(page, UDim2.fromOffset(0, 0), UDim2.new(1, -200, 0, 26), Config.Season.Name, purple)
	refs.SWhen = UI.label({ Parent = page, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, -200, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, ZIndex = 23 })
	refs.STier = UI.label({ Parent = page, Position = UDim2.fromOffset(0, 54), Size = UDim2.fromOffset(150, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = UI.Font, TextColor3 = Col.Text, ZIndex = 23 })
	refs.SFill, refs.SLabel = bar(page, UDim2.fromOffset(150, 58), UDim2.new(1, -350, 0, 22), purple)
	refs.SClaimAll = UI.button({ Parent = page, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 6), Size = UDim2.fromOffset(190, 44), Text = "CLAIM ALL", BackgroundColor3 = Col.Good, ZIndex = 23 })
	refs.SClaimAll.Activated:Connect(function()
		local res = call("SeasonClaim", 0)
		if res and res.Ok then
			setStatus(string.format("Claimed %d reward%s!", #res.Paid, #res.Paid > 1 and "s" or ""), Col.Good)
			EffectsController.Play("Win", 0.7, 1.2)
		end
	end)
	UI.label({ Parent = page, Position = UDim2.fromOffset(0, 94), Size = UDim2.fromOffset(400, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Good, Font = Enum.Font.GothamBlack, Text = "FREE REWARDS · FOR EVERY PLAYER", ZIndex = 23 })
	local n = #Config.Season.Free
	local scroll = UI.new("ScrollingFrame", { Parent = page, Position = UDim2.fromOffset(0, 116), Size = UDim2.new(1, 0, 1, -140), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.fromOffset(n * (CELL_W + CELL_GAP) - CELL_GAP, 0), ZIndex = 22 })
	refs.SScroll = scroll
	for t, r in Config.Season.Free do
		local x = (t - 1) * (CELL_W + CELL_GAP)
		local cell = UI.button({ Parent = scroll, Position = UDim2.fromOffset(x, 0), Size = UDim2.new(0, CELL_W, 1, -12), Text = "", BackgroundColor3 = Col.Panel2, ZIndex = 23 })
		UI.label({ Parent = cell, Position = UDim2.fromOffset(6, 8), Size = UDim2.new(1, -12, 0, 20), Text = "TIER " .. t, Font = UI.Font, TextColor3 = Col.Mute, ZIndex = 24 })
		local icon = r.Spins and "spin" or (r.Wild and "card" or "coin")
		UI.icon(icon, { Parent = cell, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 40), Size = UDim2.fromOffset(72, 72), ZIndex = 24 }, r.Wild and Rarity.Colors[r.Wild] or nil)
		UI.label({ Parent = cell, Position = UDim2.fromOffset(6, 122), Size = UDim2.new(1, -12, 0, 48), TextWrapped = true, Font = UI.Font, Text = Retention.SeasonRewardText(r), TextColor3 = r.Spins and Col.Lava or (r.Wild and Rarity.Colors[r.Wild] or Col.Gold), ZIndex = 24 })
		local state = UI.label({ Parent = cell, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -10), Size = UDim2.new(1, -16, 0, 32), BackgroundTransparency = 0, BackgroundColor3 = Col.Panel, Text = "", ZIndex = 24 })
		UI.corner(10).Parent = state
		local ring = UI.stroke(Col.Gold, 4)
		ring.Enabled = false
		ring.Parent = cell
		cell.Activated:Connect(function()
			local res = call("SeasonClaim", t)
			if res and res.Ok then
				setStatus("Claimed tier " .. t .. ": " .. Retention.SeasonRewardText(r), Col.Good)
				EffectsController.Play("Win", 0.6, 1.3)
			end
		end)
		seasonCells[t] = { Button = cell, State = state, Ring = ring }
	end
	UI.label({ Parent = page, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 18), TextColor3 = Col.Mute, TextXAlignment = Enum.TextXAlignment.Left, Text = "Season XP = the XP you earn in matches (about 4 rounds a tier). Spins at tiers 8, 16, 24 and 30.", ZIndex = 23 })
end

refreshers.Season = function()
	local p = profile
	if not p then
		return
	end
	local se = p.Season or {}
	local now = os.time()
	local sid = Config.SeasonIdAt(now)
	local xp = (se.Id == sid) and (se.XP or 0) or 0
	local claimed = (se.Id == sid) and (se.Claimed or {}) or {}
	local tier, into, need = Retention.SeasonTier(xp)
	local dates = seasonDates()
	if now < Config.Season.StartsAt then
		refs.SWhen.Text = dates .. " · PREVIEW (resets when the season starts)"
	elseif now >= Config.Season.EndsAt then
		refs.SWhen.Text = dates .. " · SEASON ENDED · claim what you reached"
	else
		refs.SWhen.Text = dates .. " · ends in " .. timeLeft(Config.Season.EndsAt - now)
	end
	refs.STier.Text = string.format("TIER %d / %d", tier, Retention.SeasonTiers())
	refs.SFill.Size = UDim2.fromScale(tier >= Retention.SeasonTiers() and 1 or math.clamp(into / need, 0, 1), 1)
	refs.SLabel.Text = tier >= Retention.SeasonTiers() and "TRACK COMPLETE!" or string.format("%d / %d XP to tier %d", into, need, tier + 1)
	local unclaimed = 0
	for t, cell in seasonCells do
		local got = claimed[tostring(t)] == true
		local can = t <= tier and not got
		if can then
			unclaimed += 1
		end
		local isNext = t == tier + 1
		cell.State.Text = got and "GOT IT" or (can and "CLAIM!" or (isNext and "NEXT" or ""))
		UI.setIcon(cell.State, (not got and not can and not isNext) and "lock" or nil, nil, 0.85)
		cell.Ring.Enabled = can or isNext
		cell.State.BackgroundColor3 = got and Col.Good or (can and Col.Gold or Col.Panel)
		cell.State.TextColor3 = (got or can) and Color3.new(1, 1, 1) or Col.Mute
		cell.Button.BackgroundColor3 = can and Color3.fromRGB(255, 236, 190) or (t <= tier and Col.Panel or Col.Panel2)
	end
	refs.SClaimAll.Visible = unclaimed > 0
	refs.SClaimAll.Text = string.format("CLAIM ALL (%d)", unclaimed)
	-- scroll so the first unclaimed (or the next) tier is in view, only when that tier changes
	local focus = tier + 1
	for t = 1, math.min(tier, #seasonCells) do
		if claimed[tostring(t)] ~= true then
			focus = t
			break
		end
	end
	if refs.SFocus ~= focus and refs.SScroll then
		refs.SFocus = focus
		refs.SScroll.CanvasPosition = Vector2.new(math.max(0, (focus - 2) * (CELL_W + CELL_GAP)), 0)
	end
end

------------------------------------------------------------------------
-- SHOP (developer products)
------------------------------------------------------------------------
local shopCards: { [string]: { [string]: any } } = {}

-- one shop card (items 4 across, passes 2 across)
local function shopCard(page: Instance, item: { [string]: any }, w: number, onBuy: () -> ()): { [string]: any }
	local wide = w > 300
	local c = card(page, UDim2.fromOffset(0, 0), UDim2.fromOffset(w, 160), Col.Panel2)
	local ic = wide and 58 or 44
	UI.icon(item.Icon or "gift", { Parent = c, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(ic, ic), ZIndex = 23 })
	UI.label({ Parent = c, Position = UDim2.fromOffset(ic + 18, 10), Size = UDim2.new(1, -(ic + 26), 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Text = item.Name, ZIndex = 23 })
	UI.label({ Parent = c, Position = UDim2.fromOffset(ic + 18, 38), Size = UDim2.new(1, -(ic + 26), 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = item.Tag or (item.Random and "random weapon per spin" or ""), ZIndex = 23 })
	local descY = wide and 72 or 58
	UI.label({ Parent = c, Position = UDim2.fromOffset(10, descY), Size = UDim2.new(1, -20, 0, wide and 36 or 42), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextScaled = false, TextSize = wide and 13 or 12, TextWrapped = true, TextColor3 = Col.Text, Text = Descriptions.Shop[item.Key] or "", ZIndex = 23 })
	local price = UI.label({ Parent = c, Position = UDim2.fromOffset(10, 120), Size = UDim2.fromOffset(wide and 120 or 64, 32), TextXAlignment = Enum.TextXAlignment.Left, Text = "R$ " .. tostring(item.Price), TextColor3 = Col.Good, ZIndex = 23 })
	local bx = wide and 140 or 78
	local buy = UI.button({ Parent = c, Position = UDim2.fromOffset(bx, 120), Size = UDim2.new(1, -(bx + 10), 0, 32), Text = "BUY", BackgroundColor3 = Col.Good, ZIndex = 23 })
	buy.Activated:Connect(onBuy)
	return { Card = c, Buy = buy, Price = price }
end

local function buyResult(res: { [string]: any }?)
	if res and res.Ok then
		if res.Simulated then
			setStatus(res.Text, Col.Good)
			EffectsController.Play("Win", 0.6, 1.2)
		else
			setStatus("Opening the Roblox purchase window…", Col.Mute)
		end
	end
end

local passCards: { [string]: { [string]: any } } = {}

-- v0.9.23c: ONE scrolling shop page. GAME PASSES first (2 across), scroll down for ITEMS (4 across).
local SHOP_HEAD = 46 -- odds + pity lines above the scroll
local PASS_Y = 32 -- pass cards start under the GAME PASSES header
local ITEMS_GAP = 12 -- space between the last pass row and the ITEMS header

local function shopSection(parent: Instance, y: number, title: string, titleW: number, sub: string): Frame
	local row = UI.new("Frame", { Name = title, Parent = parent, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, ZIndex = 22 })
	UI.label({ Parent = row, Size = UDim2.fromOffset(titleW, 26), TextXAlignment = Enum.TextXAlignment.Left, Text = title, TextColor3 = Col.Gold, TextStrokeTransparency = 0, TextStrokeColor3 = UI.Outline, ZIndex = 23 })
	UI.label({ Parent = row, Position = UDim2.fromOffset(titleW + 10, 5), Size = UDim2.fromOffset(300, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = sub, ZIndex = 23 })
	return row
end

local function updateShopNote()
	local note = refs.ShopNote :: TextLabel?
	local scroll = refs.ShopScroll :: ScrollingFrame?
	if not note or not scroll then
		return
	end
	local restricted = player:GetAttribute("PaidRandomRestricted") ~= false
	if scroll.CanvasPosition.Y < (refs.ShopItemsY or 300) - 150 then
		note.Text = restricted and "Some items aren't offered for your account. Everything can be earned by playing." or "Scroll down for ITEMS: spins, coins, 2x coin boost and Skip Timer."
	else
		note.Text = restricted and "Paid spins and coins aren't offered for your account. Earned spins, coin spins and wildcards still reach every level." or "Earned spins (levels, quests, season) and coin spins work exactly like paid ones. Every level is reachable without paying."
	end
end

local function buildShop()
	local page = pages.Shop
	local odds = {}
	for _, r in Rarity.Order do
		table.insert(odds, string.format('<font color="#%s">%s %s%%</font>', Rarity.Colors[r]:ToHex(), string.sub(r, 1, 1), tostring(Config.Spins.Odds[r])))
	end
	refs.ShopOdds = UI.label({ Parent = page, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = "SPIN ODDS (exact): " .. table.concat(odds, "  ·  "), ZIndex = 23 })
	refs.ShopPity = UI.label({ Parent = page, Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, ZIndex = 23 })
	local scroll = UI.new("ScrollingFrame", {
		Name = "ShopScroll",
		Parent = page,
		Position = UDim2.fromOffset(0, SHOP_HEAD),
		Size = UDim2.new(1, 0, 1, -(SHOP_HEAD + 20)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Col.Gold,
		VerticalScrollBarInset = Enum.ScrollBarInset.Always,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.fromOffset(0, 800),
		ZIndex = 22,
	}) :: ScrollingFrame
	refs.ShopScroll = scroll
	-- 1) GAME PASSES (one-time, forever)
	local passHead = shopSection(scroll, 0, "GAME PASSES", 170, "buy once, keep forever")
	refs.ShopBoost = UI.label({ Parent = passHead, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4), Size = UDim2.fromOffset(300, 20), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Col.Good, Font = Enum.Font.GothamBlack, ZIndex = 23 })
	for i, pass in Config.Shop.Passes do
		local ref = shopCard(scroll, pass, 388, function()
			buyResult(call("BuyPass", pass.Key))
		end)
		ref.Card.Position = UDim2.fromOffset(((i - 1) % 2) * 396, PASS_Y + math.floor((i - 1) / 2) * 168)
		passCards[pass.Key] = ref
	end
	-- 2) ITEMS (buy any time); y is set in the refresher because hidden cards change the rows
	refs.ShopItemsHead = shopSection(scroll, 0, "ITEMS", 84, "buy any time: spins, coins, boosts")
	for _, prod in Config.Shop.Products do
		shopCards[prod.Key] = shopCard(scroll, prod, 190, function()
			buyResult(call("Buy", prod.Key))
		end)
	end
	refs.ShopNote = UI.label({ Parent = page, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "", ZIndex = 23 })
	refs.ShopClosed = UI.label({ Parent = page, Position = UDim2.fromOffset(0, SHOP_HEAD), Size = UDim2.new(1, 0, 1, -(SHOP_HEAD + 20)), BackgroundTransparency = 0.1, BackgroundColor3 = Col.Panel, Text = "THE SHOP IS CLOSED RIGHT NOW", TextColor3 = Col.Mute, Visible = false, ZIndex = 30 })
	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(updateShopNote)
end

refreshers.Shop = function()
	local p = profile
	if not p then
		return
	end
	local pity = p.Pity or {}
	local P = Config.Spins.Pity
	refs.ShopPity.Text = string.format("PITY: Epic+ guaranteed in %d · Legendary+ in %d · Mythic in %d spins (paid spins count too)", math.max(1, P.Epic - (pity.Epic or 0)), math.max(1, P.Legendary - (pity.Legendary or 0)), math.max(1, P.Mythic - (pity.Mythic or 0)))
	local boost = p.BoostLeft or 0
	local parts = {}
	if hasPass("Coins2x") then
		table.insert(parts, boost > 0 and "3x COINS (PASS + BOOST)" or "2x COINS FOREVER")
	elseif boost > 0 then
		table.insert(parts, "2x COINS")
	end
	if boost > 0 then
		table.insert(parts, "BOOST " .. timeLeft(boost) .. " LEFT")
	end
	refs.ShopBoost.Text = table.concat(parts, "  ·  ")
	local restricted = player:GetAttribute("PaidRandomRestricted") ~= false
	local tutorialDone = (p.Tutorial or 0) >= Config.Tutorial.Done
	-- odds + pity only for accounts that can buy spins; the scroll moves up when they're hidden
	refs.ShopOdds.Visible = not restricted
	refs.ShopPity.Visible = not restricted
	local head = restricted and 0 or SHOP_HEAD
	local scroll = refs.ShopScroll :: ScrollingFrame
	scroll.Position = UDim2.fromOffset(0, head)
	scroll.Size = UDim2.new(1, 0, 1, -(head + 20))
	refs.ShopClosed.Position = scroll.Position
	refs.ShopClosed.Size = scroll.Size
	-- passes first
	for _, pass in Config.Shop.Passes do
		local ref = passCards[pass.Key]
		local owns = hasPass(pass.Key)
		local onSale = pass.Id and pass.Id > 0
		local blocked = pass.FeedsSpins == true and restricted and not owns
		ref.Buy.Text = owns and "OWNED" or (blocked and "NOT AVAILABLE" or (onSale and "BUY · FOREVER" or (Config.DevMode and "SIMULATE (DEV)" or "SOON")))
		ref.Buy.BackgroundColor3 = (owns or blocked) and Col.Panel or ((onSale or Config.DevMode) and Col.Good or Col.Panel)
	end
	local passRows = math.ceil(#Config.Shop.Passes / 2)
	local itemsY = PASS_Y + passRows * 168 + ITEMS_GAP
	refs.ShopItemsY = itemsY
	refs.ShopItemsHead.Position = UDim2.fromOffset(0, itemsY)
	-- then items: visible cards flow 4 across (restricted accounts don't see the random ones)
	local n = 0
	for _, prod in Config.Shop.Products do
		local cardRef = shopCards[prod.Key]
		local show = not ((prod.Random or prod.FeedsSpins) and restricted)
		cardRef.Card.Visible = show
		if show then
			cardRef.Card.Position = UDim2.fromOffset((n % 4) * 198, itemsY + PASS_Y + math.floor(n / 4) * 168)
			n += 1
		end
		local onSale = prod.Id and prod.Id > 0
		local text = not tutorialDone and "TUTORIAL" or (onSale and "BUY" or (Config.DevMode and "SIMULATE" or "SOON"))
		local ok = tutorialDone and (onSale or Config.DevMode)
		if prod.SkipTimer and ok then
			if (p.CoinSpinIn or 0) <= 0 then
				text, ok = "SPIN READY", false
			elseif (p.SkipsLeft or 0) <= 0 then
				text, ok = "3/3 TODAY", false
			end
		end
		cardRef.Buy.Text = text
		cardRef.Buy.BackgroundColor3 = ok and Col.Good or Col.Panel
	end
	-- restricted accounts may see no items at all → hide the empty ITEMS header too
	refs.ShopItemsHead.Visible = n > 0
	scroll.CanvasSize = UDim2.fromOffset(0, n > 0 and (itemsY + PASS_Y + math.ceil(n / 4) * 168) or itemsY)
	updateShopNote()
	refs.ShopClosed.Visible = ReplicatedStorage:GetAttribute("ShopOpen") == false
end

------------------------------------------------------------------------
-- LEADERS (global top lists)
------------------------------------------------------------------------
local function buildLeaders()
	local page = pages.Leaders
	refs.LBoards = {}
	for i, b in Config.Leaderboards.Boards do
		local c = card(page, UDim2.fromOffset((i - 1) * 264, 0), UDim2.fromOffset(254, 360), Col.Panel2)
		UI.label({ Parent = c, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 28), Text = b.Title, TextColor3 = b.Color, ZIndex = 23 })
		UI.label({ Parent = c, Position = UDim2.fromOffset(10, 36), Size = UDim2.new(1, -20, 0, 16), Text = b.Sub, TextColor3 = Col.Mute, ZIndex = 23 })
		local rows = {}
		for r = 1, Config.Leaderboards.Top do
			local l = UI.label({ Parent = c, Position = UDim2.fromOffset(12, 60 + (r - 1) * 28), Size = UDim2.new(1, -80, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = r <= 3 and Col.Gold or Col.Text, Text = r .. ".  —", ZIndex = 23 })
			local v = UI.label({ Parent = c, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 60 + (r - 1) * 28), Size = UDim2.fromOffset(64, 24), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = l.TextColor3, Text = "", ZIndex = 23 })
			rows[r] = { Name = l, Value = v }
		end
		refs.LBoards[b.Key] = rows
	end
	refs.LYou = UI.label({ Parent = page, Position = UDim2.fromOffset(0, 370), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, RichText = true, ZIndex = 23 })
	refs.LSource = UI.label({ Parent = page, Position = UDim2.fromOffset(0, 396), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, ZIndex = 23 })
end

refreshers.Leaders = function()
	local sv = ReplicatedStorage:FindFirstChild("LeaderboardData") :: StringValue?
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(sv and sv.Value or "{}")
	end)
	local boards = ok and type(decoded) == "table" and decoded.Boards or {}
	local anyGlobal = false
	for key, rows in refs.LBoards do
		local b = boards[key]
		local list = b and b.Rows or {}
		anyGlobal = anyGlobal or (b ~= nil and b.Source == "global")
		for r, row in rows do
			local e = list[r]
			row.Name.Text = e and string.format("%d.  %s", r, tostring(e.Name)) or (r .. ".  —")
			row.Value.Text = e and tostring(e.Value) or ""
		end
	end
	local p: { [string]: any } = profile or {}
	refs.LYou.Text = string.format('YOU:  <font color="#%s">%d wins</font> (4+ player lobbies: %d)  ·  <font color="#%s">%d players knocked off</font>  ·  <font color="#%s">level %d</font>', Col.Gold:ToHex(), p.Wins or 0, p.LeaderboardWins or 0, Col.Lava:ToHex(), p.KOs or 0, Col.Blue:ToHex(), p.Level or 1)
	refs.LSource.Text = anyGlobal and "All servers · refreshed every 90 seconds · also on the HALL OF FAME boards at the back of the Yard" or "Showing THIS SERVER only · all-server boards load in the live game"
end

------------------------------------------------------------------------
-- v1.0 patch FEEDBACK: players write to the developer (filtered, rate-limited, saved in a DataStore).
-- The game owner also gets an INBOX on the right to read the newest messages in-game.
------------------------------------------------------------------------
local FEEDBACK_TAGS = { { "BUG", "BUG", Col.Bad }, { "IDEA", "IDEA", Col.Blue }, { "HARD", "TOO HARD", Col.Amber }, { "LOVE", "LOVE IT", Col.Good } }
local FEEDBACK_MAX = 300

local function escapeRich(t: string): string
	return (string.gsub(t, "[<>&\"']", { ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;", ['"'] = "&quot;", ["'"] = "&apos;" }))
end

local function deviceKind(): string
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled then
		return "console"
	end
	if Layout.IsTouch() then
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 400)
		return if math.min(vp.X, vp.Y) <= 500 then "phone" else "tablet"
	end
	return "pc"
end

local function buildFeedback()
	local page = pages.Feedback
	local tag = "IDEA"
	UI.label({ Parent = page, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(470, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = UI.Font, Text = "HELP MAKE CRUMBLE BETTER!", ZIndex = 23 })
	UI.label({ Parent = page, Position = UDim2.fromOffset(0, 32), Size = UDim2.fromOffset(470, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "Tell me what to fix or add. I read every message.", ZIndex = 23 })
	local tagButtons: { [string]: TextButton } = {}
	local function paintTags()
		for _, d in FEEDBACK_TAGS do
			local b = tagButtons[d[1]]
			local on = d[1] == tag
			b.BackgroundColor3 = on and d[3] or Col.Panel2
			b.TextColor3 = on and Color3.new(1, 1, 1) or Col.Text
		end
	end
	for i, d in FEEDBACK_TAGS do
		local b = UI.button({ Parent = page, Position = UDim2.fromOffset((i - 1) * 118, 62), Size = UDim2.fromOffset(110, 34), Text = d[2], BackgroundColor3 = Col.Panel2, ZIndex = 23 })
		tagButtons[d[1]] = b
		b.Activated:Connect(function()
			tag = d[1]
			paintTags()
			EffectsController.Play("Click", 0.4)
		end)
	end
	paintTags()
	local boxBack = card(page, UDim2.fromOffset(0, 106), UDim2.fromOffset(470, 196), Col.Panel2)
	local box = UI.new("TextBox", {
		Parent = boxBack,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 1, -20),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextScaled = false,
		TextSize = 17,
		Font = Enum.Font.GothamBold,
		TextColor3 = Col.Text,
		PlaceholderText = "Type here... What happened? Which map or weapon?",
		PlaceholderColor3 = Col.Mute,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		ZIndex = 24,
	}) :: TextBox
	local counter = UI.label({ Parent = page, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(470, 318), Size = UDim2.fromOffset(120, 18), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Col.Mute, Text = "0 / " .. FEEDBACK_MAX, ZIndex = 23 })
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > FEEDBACK_MAX then
			box.Text = string.sub(box.Text, 1, FEEDBACK_MAX)
		end
		counter.Text = string.format("%d / %d", #box.Text, FEEDBACK_MAX)
	end)
	local send = UI.button({ Parent = page, Position = UDim2.fromOffset(0, 312), Size = UDim2.fromOffset(170, 42), Text = "SEND", BackgroundColor3 = Col.Good, ZIndex = 23 })
	local sending = false
	send.Activated:Connect(function()
		if sending then
			return
		end
		if #string.gsub(box.Text, "%s", "") < 4 then
			setStatus("Write a little more first.", Col.Bad)
			return
		end
		sending = true
		send.Text = "SENDING..."
		local res = call("Feedback", tag .. ":" .. deviceKind(), box.Text)
		sending = false
		send.Text = "SEND"
		if res and res.Ok then
			box.Text = ""
			setStatus("Sent! Thank you, it really helps.", Col.Good)
			EffectsController.Play("Win", 0.4, 1.2)
		end
	end)
	UI.label({ Parent = page, Position = UDim2.fromOffset(0, 362), Size = UDim2.fromOffset(470, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "Never write passwords or personal info.", ZIndex = 23 })

	-- right side: tips for players, the INBOX for the owner
	local side = card(page, UDim2.fromOffset(490, 0), UDim2.fromOffset(302, 384), Col.Panel2)
	refs.FbTips = UI.label({ Parent = side, Position = UDim2.fromOffset(14, 14), Size = UDim2.new(1, -28, 1, -28), TextScaled = false, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, RichText = true, ZIndex = 23,
		Text = string.format('<font color="#%s"><b>GOOD FEEDBACK</b></font>\n\n- What were you doing?\n- Which map / weapon?\n- Phone, tablet or PC?\n- What would make you play longer?\n\nThe best ideas go into the next update!', Col.Gold:ToHex()) })
	local inbox = UI.new("Frame", { Parent = side, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 23 })
	refs.FbInbox = inbox
	-- v1.0 patch 8: two tabs: MESSAGES (feedback) and VISITORS (who joined, how long, how far)
	local tabMsg = UI.button({ Name = "InboxMsgs", Parent = inbox, Position = UDim2.fromOffset(10, 8), Size = UDim2.fromOffset(84, 30), Text = "MESSAGES", BackgroundColor3 = Col.Gold, TextColor3 = Color3.new(1, 1, 1), ZIndex = 24 })
	local tabVis = UI.button({ Name = "InboxVisitors", Parent = inbox, Position = UDim2.fromOffset(100, 8), Size = UDim2.fromOffset(84, 30), Text = "VISITORS", BackgroundColor3 = Col.Panel, ZIndex = 24 })
	local load = UI.button({ Parent = inbox, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(92, 30), Text = "REFRESH", BackgroundColor3 = Col.Blue, ZIndex = 24 })
	local inboxMode = "msgs"
	local list = UI.new("ScrollingFrame", { Parent = inbox, Position = UDim2.fromOffset(10, 46), Size = UDim2.new(1, -20, 1, -56), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 24 }) :: ScrollingFrame
	UI.new("UIListLayout", { Parent = list, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	local function fill(items: { any })
		for _, c in list:GetChildren() do
			if c:IsA("TextLabel") then
				c:Destroy()
			end
		end
		if #items == 0 then
			UI.label({ Parent = list, Size = UDim2.new(1, -8, 0, 40), TextScaled = false, TextSize = 14, TextWrapped = true, TextColor3 = Col.Mute, Text = "No feedback yet.", ZIndex = 25 })
			return
		end
		for i, e in items do
			if type(e) ~= "table" then
				continue
			end
			local when = os.date("%d %b %H:%M", tonumber(e.At) or 0)
			UI.label({ Parent = list, LayoutOrder = i, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.2, BackgroundColor3 = Col.Panel, TextScaled = false, TextSize = 13, TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 25,
				Text = string.format('<font color="#%s"><b>%s</b></font>  %s · %s · LV%s\n%s', Col.Gold:ToHex(), tostring(e.Tag or "?"), tostring(e.Name or "?"), tostring(e.Device or "?"), tostring(e.Level or "?"), when) .. "\n" .. escapeRich(tostring(e.Text or "")) })
		end
	end
	UI.label({ Parent = list, Size = UDim2.new(1, -8, 0, 60), TextScaled = false, TextSize = 14, TextWrapped = true, TextColor3 = Col.Mute, ZIndex = 25,
		Text = "Only YOU (the game owner) see this inbox. Tap REFRESH to load players' feedback. (In Studio, turn on API access first.)" })
	-- VISITORS: all-time totals, the biggest drop-off, then the newest visits
	local STAGES = { "LOADING", "LOBBY", "RANGE", "SHOVED", "MATCH", "FINISHED" }
	local STAGE_COL = { Col.Bad, Col.Amber, Col.Amber, Col.Blue, Col.Blue, Col.Good }
	local function dur(sec: number): string
		if sec < 60 then
			return string.format("%ds", sec)
		end
		return string.format("%dm %02ds", sec // 60, sec % 60)
	end
	local function fillVisitors(items: { any }, tot: { [string]: any })
		for _, c in list:GetChildren() do
			if c:IsA("TextLabel") then
				c:Destroy()
			end
		end
		local visits = tonumber(tot.Visits) or 0
		local st = type(tot.Stages) == "table" and tot.Stages or {}
		local function n(i: number): number
			return tonumber(st[i]) or 0
		end
		-- where do most people stop?
		local worst, worstN = 0, 0
		for i = 1, 5 do
			local drop = n(i) - n(i + 1)
			if drop > worstN then
				worst, worstN = i, drop
			end
		end
		local gold = Col.Gold:ToHex()
		local summary = string.format(
			'<font color="#%s"><b>ALL VISITS (every server): %d</b></font>\nNew players: %d\n\n<b>How long they stayed</b>\nunder 30s: %d  ·  30s-2m: %d\n2-5m: %d  ·  5m+: %d\n\n<b>How far they got</b>\nloaded %d · range %d · shoved %d\nmatch %d · finished %d',
			gold, visits, tonumber(tot.New) or 0, tonumber(tot.Under30s) or 0, tonumber(tot.Under2m) or 0, tonumber(tot.Under5m) or 0, tonumber(tot.Over5m) or 0,
			n(2), n(3), n(4), n(5), n(6))
		if worst > 0 then
			summary ..= string.format('\n\n<font color="#%s"><b>Most stop at: %s</b> (%d left there)</font>', Col.Bad:ToHex(), STAGES[worst], worstN)
		end
		UI.label({ Parent = list, LayoutOrder = 0, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.1, BackgroundColor3 = Col.Panel, TextScaled = false, TextSize = 13, TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 25, Text = summary })
		if #items == 0 then
			UI.label({ Parent = list, LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 60), TextScaled = false, TextSize = 14, TextWrapped = true, TextColor3 = Col.Mute, ZIndex = 25,
				Text = "No visits logged yet. Every visit from now on shows here (it's saved when the player leaves)." })
			return
		end
		for i, e in items do
			if type(e) ~= "table" then
				continue
			end
			local stage = math.clamp(tonumber(e.st) or 1, 1, 6)
			local when = os.date("%d %b %H:%M", tonumber(e.t) or 0)
			local who = escapeRich(tostring(e.n or "?"))
			if e.un and e.un ~= e.n then
				who ..= " (@" .. escapeRich(tostring(e.un)) .. ")"
			end
			UI.label({ Parent = list, LayoutOrder = i + 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.2, BackgroundColor3 = Col.Panel, TextScaled = false, TextSize = 13, TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 25,
				Text = string.format('<b>%s</b>%s%s\n%s · %s · <font color="#%s"><b>%s</b></font>\n%s · LV%s',
					who, e.own and ' <font color="#' .. gold .. '">YOU</font>' or "", e.nw and ' <font color="#' .. Col.Good:ToHex() .. '">NEW</font>' or "",
					tostring(e.d or "?"), dur(tonumber(e.s) or 0), STAGE_COL[stage]:ToHex(), STAGES[stage], when, tostring(e.lv or "?")) })
		end
	end
	local function paintTabs()
		tabMsg.BackgroundColor3 = if inboxMode == "msgs" then Col.Gold else Col.Panel
		tabMsg.TextColor3 = if inboxMode == "msgs" then Color3.new(1, 1, 1) else Col.Text
		tabVis.BackgroundColor3 = if inboxMode == "visitors" then Col.Gold else Col.Panel
		tabVis.TextColor3 = if inboxMode == "visitors" then Color3.new(1, 1, 1) else Col.Text
	end
	local function reload()
		load.Text = "..."
		if inboxMode == "visitors" then
			local res = call("VisitorLog")
			load.Text = "REFRESH"
			if res and res.Ok then
				fillVisitors(res.List or {}, res.Totals or {})
				setStatus(string.format("%d visit%s logged.", #(res.List or {}), #(res.List or {}) == 1 and "" or "s"), Col.Good)
			end
			return
		end
		local res = call("FeedbackInbox")
		load.Text = "REFRESH"
		if res and res.Ok then
			fill(res.List or {})
			setStatus(string.format("%d message%s.", #(res.List or {}), #(res.List or {}) == 1 and "" or "s"), Col.Good)
		end
	end
	tabMsg.Activated:Connect(function()
		inboxMode = "msgs"
		paintTabs()
		reload()
	end)
	tabVis.Activated:Connect(function()
		inboxMode = "visitors"
		paintTabs()
		reload()
	end)
	load.Activated:Connect(reload)
end

refreshers.Feedback = function()
	local owner = Players.LocalPlayer:GetAttribute("IsOwner") == true
	if refs.FbInbox then
		refs.FbInbox.Visible = owner
		refs.FbTips.Visible = not owner
	end
end

------------------------------------------------------------------------
-- DEV
------------------------------------------------------------------------
local function buildDev()
	local page = pages.Dev
	if not page then
		return
	end
	UI.label({ Parent = page, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Gold, Font = Enum.Font.GothamBlack, Text = "DEV TOOLS (Studio only)", ZIndex = 22 })
	local grants = { { "spins", "+10 SPINS" }, { "coins", "+5,000 COINS" }, { "copies", "+2 COPIES (all owned)" } }
	for i, g in grants do
		local b = UI.button({ Parent = page, Position = UDim2.fromOffset((i - 1) * 200, 28), Size = UDim2.fromOffset(190, 34), Text = g[2], BackgroundColor3 = Color3.fromRGB(110, 60, 200), ZIndex = 22 })
		b.Activated:Connect(function()
			local res = call("DevGrant", g[1])
			if res and res.Ok then
				setStatus("Granted " .. g[2], Col.Good)
			end
		end)
	end
	UI.label({ Parent = page, Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "TEST ANY WEAPON (not saved)", ZIndex = 22 })
	local levels: { [string]: number } = {}
	for i, def in Weapons.List do
		levels[def.Id] = 1
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		local x, y = col * 262, 98 + row * 48
		local rc = Rarity.Colors[def.Rarity]
		UI.label({ Parent = page, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(110, 18), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, TextColor3 = rc, Text = def.Name, ZIndex = 22 })
		local lvl = UI.label({ Parent = page, Position = UDim2.fromOffset(x, y + 20), Size = UDim2.fromOffset(110, 16), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Col.Mute, Text = "L1 · PWR " .. Rarity.PWR(def.Rarity, 1), ZIndex = 22 })
		local minus = UI.button({ Parent = page, Position = UDim2.fromOffset(x + 112, y + 4), Size = UDim2.fromOffset(28, 28), Text = "-", ZIndex = 22 })
		local plus = UI.button({ Parent = page, Position = UDim2.fromOffset(x + 144, y + 4), Size = UDim2.fromOffset(28, 28), Text = "+", ZIndex = 22 })
		local test = UI.button({ Parent = page, Position = UDim2.fromOffset(x + 176, y + 4), Size = UDim2.fromOffset(74, 28), Text = "TEST", BackgroundColor3 = Col.Lava, ZIndex = 22 })
		local function upd()
			lvl.Text = string.format("L%d · PWR %d", levels[def.Id], Rarity.PWR(def.Rarity, levels[def.Id]))
		end
		minus.Activated:Connect(function()
			levels[def.Id] = math.max(1, levels[def.Id] - 1)
			upd()
		end)
		plus.Activated:Connect(function()
			levels[def.Id] = math.min(Rarity.MaxLevel, levels[def.Id] + 1)
			upd()
		end)
		test.Activated:Connect(function()
			Net.Get("DevLoadout"):FireServer(def.Id, levels[def.Id])
			setStatus(string.format("Testing %s L%d (not saved).", def.Name, levels[def.Id]), Col.Good)
		end)
	end
end

------------------------------------------------------------------------
-- Side buttons, quest tracker, range panel
------------------------------------------------------------------------
local dockLayout: (cols: number) -> () = function(_cols: number) end

local function buildSide()
	-- v0.7.1 dock: one separate round button per menu (icon + label), Pet-Sim/BedWars style
	local names = table.clone(WINDOW_ORDER)
	if Config.DevMode then
		table.insert(names, "Dev")
	end
	-- v0.7.3 dock = a 2-column grid of square app tiles on the left edge (icon chip + label + key)
	local TILE_W, TILE_H, GAP = 86, 78, 8
	-- v1.0 patch MOBILE: phones/tablets get a 4-wide grid at the TOP-left, so the bottom-left stays
	-- free for Roblox's move stick (the 2-wide column used to run down over it)
	-- v1.0 patch 4: the grid is re-laid live (dockLayout) when the player switches touch <-> mouse or the
	-- screen is too short for the 2-wide column (then PCs get the 4-wide top-left grid too)
	local COLS = if Layout.IsTouch() then 4 else 2
	local rows = math.ceil(#names / COLS)
	local gridW = TILE_W * COLS + GAP * (COLS - 1)
	local pillW = TILE_W * 2 + GAP
	local side = UI.new("Frame", { Name = "Dock", Parent = gui, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.56, 0), Size = UDim2.fromOffset(gridW, 100), BackgroundTransparency = 1 })
	refs.Side = side
	for i, name in names do
		local spec = WINDOW_SPECS[name]
		local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
		local b = UI.button({ Name = name .. "Button", Parent = side, Position = UDim2.fromOffset(col * (TILE_W + GAP), row * (TILE_H + GAP)), Size = UDim2.fromOffset(TILE_W, TILE_H), Text = "", BackgroundColor3 = Col.Panel })
		UI.corner(16).Parent = b
		local chip = UI.label({ Parent = b, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 0, BackgroundColor3 = spec.Color, Text = "", ZIndex = 3 })
		UI.corner(12).Parent = chip
		UI.setIcon(chip, spec.Icon, nil, 0.78)
		UI.label({ Parent = b, Position = UDim2.new(0, 4, 1, -26), Size = UDim2.new(1, -8, 0, 20), Text = spec.Title, TextColor3 = Col.Text, ZIndex = 3 })
		if spec.Key then
			local key = UI.label({ Parent = b, Position = UDim2.fromOffset(5, 5), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 0, BackgroundColor3 = Col.Panel2, TextScaled = false, TextSize = 11, Text = spec.Key, TextColor3 = Col.Mute, ZIndex = 4 })
			UI.corner(6).Parent = key
		end
		b.Activated:Connect(function()
			if openName == name then
				MenuController.Close()
			else
				MenuController.Open(name)
			end
		end)
		dockButtons[name] = b
		if name == "Season" then
			local sb = UI.label({ Parent = b, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -4, 0, 4), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 0, BackgroundColor3 = Col.Bad, TextColor3 = Color3.new(1, 1, 1), Font = UI.Font, Text = "0", Visible = false, ZIndex = 5 })
			UI.corner(12).Parent = sb
			UI.stroke(Color3.new(1, 1, 1), 2).Parent = sb
			refs.SeasonBadge = sb
		end
		if name == "Vault" then
			local badge = UI.label({ Parent = b, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -4, 0, 4), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 0, BackgroundColor3 = Col.Bad, TextColor3 = Color3.new(1, 1, 1), Font = UI.Font, Text = "0", Visible = false, ZIndex = 5 })
			UI.corner(12).Parent = badge
			UI.stroke(Color3.new(1, 1, 1), 2).Parent = badge
			refs.SpinBadge = badge
		end
	end
	-- Help Tips toggle pill under the grid (reference: "Help Signs ON")
	-- v1.0 patch: the row is split: TIPS toggle (left half) + AFK MODE toggle (right half)
	local halfW = (pillW - GAP) / 2
	local tips = UI.button({ Name = "TipsToggle", Parent = side, Position = UDim2.fromOffset(0, rows * (TILE_H + GAP)), Size = UDim2.fromOffset(halfW, 34), Text = "", BackgroundColor3 = Col.Panel })
	UI.corner(17).Parent = tips
	UI.label({ Parent = tips, Position = UDim2.fromOffset(10, 7), Size = UDim2.new(1, -54, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Text = "TIPS", TextColor3 = Col.Text, ZIndex = 3 })
	local afk = UI.button({ Name = "AfkToggle", Parent = side, Position = UDim2.fromOffset(halfW + GAP, rows * (TILE_H + GAP)), Size = UDim2.fromOffset(halfW, 34), Text = "AFK", BackgroundColor3 = Col.Panel2 })
	UI.corner(17).Parent = afk
	refs.AfkButton = afk
	afk.Activated:Connect(function()
		local on = Players.LocalPlayer:GetAttribute("AFK") ~= true
		EffectsController.Play("Click", 0.4)
		call("AfkToggle", on)
	end)
	local function paintAfk()
		local on = Players.LocalPlayer:GetAttribute("AFK") == true
		afk.Text = on and "AFK ON" or "AFK"
		afk.BackgroundColor3 = on and Col.Gold or Col.Panel2
		afk.TextColor3 = on and Color3.new(0, 0, 0) or Col.Text
	end
	Players.LocalPlayer:GetAttributeChangedSignal("AFK"):Connect(paintAfk)
	paintAfk()
	-- Roblox disconnects players after 20 idle minutes and games may not fake input to stop it.
	-- patch 4: at 18 idle minutes in AFK MODE the server saves you and moves you to a fresh server,
	-- where AFK switches straight back on (AfkService "AfkRejoin")
	local lastInput = os.clock()
	local asked = false
	UserInputService.InputBegan:Connect(function()
		lastInput = os.clock()
		asked = false
	end)
	local function idleCheck(idle: number)
		if not asked and Players.LocalPlayer:GetAttribute("AFK") == true and idle >= Config.Afk.RejoinAfter then
			asked = true
			task.spawn(call, "AfkRejoin")
			task.delay(150, function()
				asked = false -- (try again if the hop failed)
			end)
		end
	end
	Players.LocalPlayer.Idled:Connect(function(t: number)
		idleCheck(math.max(t, os.clock() - lastInput))
	end)
	task.spawn(function()
		while true do
			task.wait(10)
			idleCheck(os.clock() - lastInput)
		end
	end)
	local onPill = UI.label({ Parent = tips, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(38, 22), BackgroundTransparency = 0, BackgroundColor3 = Col.Good, Text = "ON", ZIndex = 3 })
	UI.corner(11).Parent = onPill
	tips.Activated:Connect(function()
		local lp = Players.LocalPlayer
		local on = lp:GetAttribute("HelpTips") == false
		lp:SetAttribute("HelpTips", on)
		onPill.Text = on and "ON" or "OFF"
		onPill.BackgroundColor3 = on and Col.Good or Col.Mute
		EffectsController.Play("Click", 0.4)
	end)
	-- v1.0 FREE SPIN pill: Roblox's "favorite this game" pop-up; YES = +1 spin, once per player.
	-- It disappears for good once claimed (see refreshSide). It only ASKS for a like (no reward).
	local fav = UI.button({ Name = "FavoriteButton", Parent = side, Position = UDim2.fromOffset(0, rows * (TILE_H + GAP) + 42), Size = UDim2.fromOffset(pillW, 44), Text = "", BackgroundColor3 = Col.Gold, Visible = false })
	UI.corner(18).Parent = fav
	local favIcon = UI.label({ Parent = fav, Position = UDim2.fromOffset(8, 7), Size = UDim2.fromOffset(30, 30), Text = "", ZIndex = 3 })
	UI.setIcon(favIcon, "spin", nil, 0.9)
	UI.label({ Parent = fav, Position = UDim2.fromOffset(42, 4), Size = UDim2.new(1, -50, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Text = string.format("FREE %d SPIN", Config.Social.FavoriteSpins), TextColor3 = Color3.new(1, 1, 1), ZIndex = 3 })
	UI.label({ Parent = fav, Position = UDim2.fromOffset(42, 24), Size = UDim2.new(1, -50, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, Text = "Favorite + Like!", TextColor3 = Color3.new(1, 1, 1), ZIndex = 3 })
	refs.FavoriteButton = fav
	-- lay the dock out as a cols-wide grid (2 = left column on PCs, 4 = top-left grid)
	dockLayout = function(cols: number)
		local r = math.ceil(#names / cols)
		local wide = cols >= 4
		local gw = TILE_W * cols + GAP * (cols - 1)
		for i, name in names do
			local col, row = (i - 1) % cols, math.floor((i - 1) / cols)
			dockButtons[name].Position = UDim2.fromOffset(col * (TILE_W + GAP), row * (TILE_H + GAP))
		end
		local y = r * (TILE_H + GAP)
		tips.Position = UDim2.fromOffset(0, y)
		afk.Position = UDim2.fromOffset(halfW + GAP, y)
		fav.Position = if wide then UDim2.fromOffset(pillW + GAP, y) else UDim2.fromOffset(0, y + 42)
		side.Size = UDim2.fromOffset(gw, y + (if wide then 44 else 42 + 44))
	end
	dockLayout(COLS)
	local asking = false
	fav.Activated:Connect(function()
		if asking then
			return
		end
		asking = true
		EffectsController.Play("Click", 0.4)
		local answer = Social.Favorite()
		-- Studio can't open Roblox pop-ups: DevMode simulates the YES so the reward can be tested
		if answer == "yes" or (answer == "error" and Config.DevMode) then
			call("FavoriteClaim")
		end
		asking = false
	end)
	-- the HUD's "+" coin button asks for the Vault through a player attribute
	Players.LocalPlayer:GetAttributeChangedSignal("OpenMenu"):Connect(function()
		local want = Players.LocalPlayer:GetAttribute("OpenMenu")
		if type(want) == "string" and want ~= "" then
			Players.LocalPlayer:SetAttribute("OpenMenu", nil)
			if not inRound() then
				MenuController.Open(want)
			end
		end
	end)

	-- v0.9.3 quest tracker: top-right card that grows with its rows (it used to overflow its box)
	local q = UI.new("Frame", { Name = "Quests", Parent = gui, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 64), Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Col.Panel, BackgroundTransparency = 0.06, BorderSizePixel = 0, Visible = false })
	UI.corner(16).Parent = q
	UI.padding(10).Parent = q
	UI.new("UIListLayout", { Parent = q, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.QuestHead = UI.label({ Parent = q, LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, TextScaled = false, TextSize = 16, TextColor3 = Col.Gold, Text = "STARTER QUESTS" })
	refs.QuestFrame = q
	-- v0.9: the tracker shows the starter quests until they're done, then today's dailies
	refs.QuestRows = {}
	for i = 1, math.max(#Config.StarterQuests, Config.Retention.DailyCount) do
		refs.QuestRows[i] = UI.label({ Parent = q, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextScaled = false, TextSize = 15, RichText = true, Text = "" })
	end
	local open = UI.button({ Parent = q, LayoutOrder = 99, Size = UDim2.new(1, 0, 0, 30), Text = "ALL QUESTS >", TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Col.Blue })
	UI.corner(15).Parent = open
	open.Activated:Connect(function()
		MenuController.Open("Quests")
	end)

	-- v0.9.3 Training Range card: same top-right slot (replaces the quests while you're in the Range)
	local r = panel({ Name = "RangePanel", Parent = gui, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 64), Size = UDim2.fromOffset(300, 0), Visible = false })
	r.AutomaticSize = Enum.AutomaticSize.Y
	UI.padding(12).Parent = r
	UI.new("UIListLayout", { Parent = r, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.Range = r
	UI.label({ Parent = r, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack, TextScaled = false, TextSize = 18, TextColor3 = Col.Ice, Text = "TRAINING RANGE" })
	refs.RangeWeapon = UI.label({ Parent = r, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextScaled = false, TextSize = 15, RichText = true, Text = "" })
	local seg = UI.new("Frame", { Parent = r, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 })
	refs.RangeCur = UI.button({ Parent = seg, Position = UDim2.fromScale(0, 0), Size = UDim2.new(0.5, -4, 1, 0), Text = "CURRENT" })
	refs.RangeNext = UI.button({ Parent = seg, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.5, -4, 1, 0), Text = "NEXT LV" })
	refs.RangeLast = UI.label({ Parent = r, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextScaled = false, TextSize = 16, Font = Enum.Font.GothamBlack, TextColor3 = Col.Gold, Text = "Shove a dummy (Click / F)" })
	local rangeKeys = UI.label({ Parent = r, LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextScaled = false, TextSize = 13, TextColor3 = Col.Mute, Text = "Yellow ring = target  ·  E shield  ·  Shift rush" })
	Layout.OnModeChanged(function(touch: boolean)
		rangeKeys.Text = if touch then "Yellow ring = target  ·  tap SHOVE / RUSH / BLOCK" else "Yellow ring = target  ·  E shield  ·  Shift rush"
		if refs.RangeLast.Text == "Shove a dummy (Click / F)" or refs.RangeLast.Text == "Tap SHOVE next to a dummy" then
			refs.RangeLast.Text = if touch then "Tap SHOVE next to a dummy" else "Shove a dummy (Click / F)"
		end
	end)
	local function setMode(m: string)
		rangeMode = m
		task.spawn(call, "RangeMode", m)
		EffectsController.Play("Click", 0.4)
	end
	refs.RangeCur.Activated:Connect(function()
		setMode("current")
	end)
	refs.RangeNext.Activated:Connect(function()
		setMode("next")
	end)
end

local function refreshSide()
	local p = profile
	local lobby = not inRound()
	-- phones/tablets: the join card + vote take the screen centre for a few seconds; the dock steps aside
	refs.Side.Visible = lobby and not (Layout.IsTouch() and Layout.CenterBusy())
	if not lobby and isOpen() then
		MenuController.Close()
	end
	if p then
		refreshCoinSpin() -- also sets the dock badge (spins + a ready, affordable coin spin)
		local allDone = true
		for _, quest in Config.StarterQuests do
			if not (p.Quests and p.Quests[quest.Id]) then
				allDone = false
			end
		end
		local lines = {}
		if not allDone then
			refs.QuestHead.Text = "STARTER QUESTS"
			for _, quest in Config.StarterQuests do
				local done = p.Quests and p.Quests[quest.Id]
				local reward = quest.Coins and ("+" .. quest.Coins .. " coins") or ("+" .. (quest.Spins or 1) .. " spin")
				table.insert(lines, string.format('<font color="#%s">%s</font> %s  <font color="#%s">%s</font>', (done and Col.Good or Col.Mute):ToHex(), done and "DONE" or "•", quest.Text, Col.Gold:ToHex(), reward))
			end
		else
			refs.QuestHead.Text = "DAILY QUESTS"
			local daily = p.Daily or {}
			if daily.Day == Retention.DayIndex(os.time()) then
				for _, id in daily.Ids or {} do
					local q = Retention.DailyDef(id)
					if q then
						local done = daily.Done and daily.Done[id]
						local prog = (daily.Progress and daily.Progress[id]) or 0
						table.insert(lines, string.format('<font color="#%s">%s</font> %s  <font color="#%s">%s</font>', (done and Col.Good or Col.Mute):ToHex(), done and "DONE" or string.format("%d/%d", prog, q.Goal), q.Text, Col.Gold:ToHex(), "+" .. tostring(q.Coins or 0)))
					end
				end
			end
		end
		for i, row in refs.QuestRows do
			row.Text = lines[i] or ""
			row.Visible = lines[i] ~= nil
		end
		local ch = player.Character
		local inRange = ch ~= nil and ch:GetAttribute("InRange") == true
		refs.QuestFrame.Visible = lobby and #lines > 0 and not inRange -- the Range card takes the slot
		if refs.FavoriteButton then
			refs.FavoriteButton.Visible = not (p.Badges and p.Badges.FavReward)
		end
		if refs.SeasonBadge then
			local n = p.SeasonUnclaimed or 0
			refs.SeasonBadge.Visible = n > 0
			refs.SeasonBadge.Text = tostring(n)
		end
	end
end

------------------------------------------------------------------------
-- Init
------------------------------------------------------------------------
function MenuController.Init()
	task.spawn(runPrizeWheels)
	request = Net.GetFunction("Request")
	gui = Instance.new("ScreenGui")
	gui.Name = "CrumbleMenu"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 5
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	buildWindows()
	buildWeapons()
	buildVault()
	buildForge()
	buildDev()
	buildQuests()
	buildSeason()
	buildShop()
	buildLeaders()
	buildFeedback()
	buildSide()
	UI.Skin(gui)
	task.defer(function()
		-- v0.9.3 layout: scaled dock; quests + range card live in the shared right column
		Layout.Fit(refs.Side, function(sc: number, vp: Vector2)
			local top = Layout.TOP_INSET + 58 * sc + 8 -- under the coin / level cards
			if not Layout.IsTouch() then
				-- PC: the 2-wide column at the left-middle, if it fits the screen height
				dockLayout(2)
				local h = refs.Side.Size.Y.Offset * sc
				if vp.Y * 0.56 - h / 2 >= top and vp.Y * 0.56 + h / 2 <= vp.Y - 12 then
					return UDim2.new(0, 12, 0.56, 0)
				end
			end
			-- phones/tablets (and short PC windows): 4-wide grid at the TOP-left, so the bottom-left
			-- stays free for Roblox's move stick (Fit anchors the dock at its left-middle)
			dockLayout(4)
			-- patch 6: short screens shrink the grid so it ends ABOVE the joystick (phones) or the
			-- screen bottom (short PC windows), instead of running into it
			local h0 = refs.Side.Size.Y.Offset
			local bottom = if Layout.IsTouch() then Layout.StickTop(vp) - 8 else vp.Y - 12
			local k = sc
			if h0 * sc > bottom - top then
				k = math.max(0.36, (bottom - top) / h0)
				local ls = refs.Side:FindFirstChild("LayoutScale")
				if ls and ls:IsA("UIScale") then
					ls.Scale = k
				end
			end
			return UDim2.fromOffset(12, top + h0 * k / 2)
		end)
		Layout.AddToRight(refs.QuestFrame, 10)
		Layout.AddToRight(refs.Range, 20)
	end)

	refs.SpinBtn.Activated:Connect(function()
		task.spawn(doSpin, "Spin", 1)
	end)
	refs.SpinAllBtn.Activated:Connect(function()
		task.spawn(doSpin, "Spin", Config.Spins.MaxBatch)
	end)
	refs.CoinSpinBtn.Activated:Connect(function()
		task.spawn(doSpin, "CoinSpin")
	end)
	refs.SkipBtn.Activated:Connect(function()
		local res = call("Buy", "SkipTimer")
		if res and res.Ok then
			if res.Simulated then
				setStatus(res.Text, Col.Good)
				EffectsController.Play("Win", 0.6, 1.2)
			else
				setStatus("Opening the Roblox purchase window…", Col.Mute)
			end
		end
	end)
	-- v0.9.22: pass attributes can land after the profile push → refresh the open page
	pcall(function()
		player.AttributeChanged:Connect(function(attr)
			if string.sub(attr, 1, 5) == "Pass_" and isOpen() and not revealing then
				local r = refreshers[currentTab]
				if r then
					r()
				end
			end
		end)
	end)

	Net.Get("Profile").OnClientEvent:Connect(function(p)
		profile = p
		if type(p.CoinSpinIn) == "number" then
			coinReadyAt = os.clock() + p.CoinSpinIn
		end
		for _, wl in walletLabels do
			wl.Text = string.format("%s COINS  ·  %d SPINS%s", UI.comma(p.Coins or 0), p.Spins or 0, (p.BoostLeft or 0) > 0 and "  ·  2x" or "")
		end
		refreshSide()
		if isOpen() and not revealing then
			local r = refreshers[currentTab]
			if r then
				r()
			end
		end
	end)
	Net.Get("RangeResult").OnClientEvent:Connect(function(d)
		local def = Weapons.Get(d.Weapon)
		refs.RangeLast.Text = string.format("%s L%d%s%s → %.1f studs", def.Name, d.Level, d.Preview and " (preview)" or "", d.Combo and " COMBO" or "", d.Distance or 0)
		refs.RangeLast.TextColor3 = Rarity.Colors[def.Rarity]
	end)

	-- v0.9: timers (resets, boost) and the leaderboard JSON tick while those windows are open
	local LIVE = { Quests = true, Season = true, Shop = true, Leaders = true }
	task.spawn(function()
		while true do
			task.wait(2)
			if isOpen() and not revealing and LIVE[currentTab] and profile then
				local r = refreshers[currentTab]
				if r then
					pcall(r)
				end
			end
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= player then
			return
		end
		local menu = prompt:GetAttribute("Menu")
		if type(menu) == "string" then
			MenuController.Open(menu)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			if openName == "Weapons" then
				MenuController.Close()
			else
				MenuController.Open("Weapons")
			end
		end
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		accum = 0
		refreshSide()
		local char = player.Character
		local inRange = char ~= nil and char:GetAttribute("InRange") == true
		refs.Range.Visible = inRange
		if inRange and char then
			local def = Weapons.Get(char:GetAttribute("WeaponId") :: string?)
			local level = (char:GetAttribute("WeaponLevel") :: number?) or 1
			local preview = rangeMode == "next" and level < Rarity.MaxLevel
			local shown = preview and level + 1 or level
			refs.RangeWeapon.Text = string.format('Testing: <font color="#%s"><b>%s</b></font> L%d  ·  %s', Rarity.Colors[def.Rarity]:ToHex(), def.Name, shown, Progression.KBText(def, shown))
			refs.RangeCur.BackgroundColor3 = rangeMode == "current" and Col.Lava or Col.Panel2
			refs.RangeNext.BackgroundColor3 = rangeMode == "next" and Col.Lava or Col.Panel2
			refs.RangeNext.Text = level < Rarity.MaxLevel and ("PREVIEW L" .. (level + 1)) or "MAXED"
		end
	end)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">MoodController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — MoodController (v0.8.2, reworked v0.8.3 "Real Maps")
	The map changes the WORLD around you: sky, sun, fog, clouds, colour grade and weather.
	The sky/lighting switches for everyone while a match is on (Countdown → Live → Results);
	the weather particles follow your camera while you're near the arena.

	  • The Grid     clear sunny afternoon, puffy white clouds, soft dust motes in the sun
	  • Molten Core  smoky red sky: low blood-red sun, dark ash clouds, orange haze, falling ash +
	                 rising embers, volcanoes spitting glowing lava bombs into the lava ocean
	  • Ice Rink     overcast white-out sky: no sun, thick cold fog, heavy snowfall; during a
	                 blizzard gust the fog closes in and the snow blows sideways
	Also draws the blizzard wind arrow at the top of the screen.

	v0.8.5 IMMERSION: while YOU are fighting on Molten Core or the Ice Rink, the lobby, the Yard
	and the training range are hidden on your screen and the map's own landmarks (volcanoes,
	lava fountains / glacier mountains, ice arches) fill that side of the world instead, so you
	only ever see that map. Everything comes back the moment you're out (KO, results, lobby).
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UI = require(script.Parent.UI)
local Layout = require(script.Parent.Layout)

local player = Players.LocalPlayer

local MoodController = {}

type Mood = {
	ClockTime: number,
	Brightness: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	ColorShift_Top: Color3,
	AtmColor: Color3,
	AtmDecay: Color3,
	AtmDensity: number,
	AtmHaze: number,
	AtmGlare: number,
	Tint: Color3,
	Saturation: number,
	Contrast: number,
	CloudColor: Color3,
	CloudCover: number,
	CloudDensity: number,
	SunSize: number,
	Bodies: boolean,
}

local MOODS: { [string]: Mood } = {
	Grid = {
		ClockTime = 14.2,
		Brightness = 3,
		Ambient = Color3.fromRGB(140, 140, 150),
		OutdoorAmbient = Color3.fromRGB(170, 170, 180),
		ColorShift_Top = Color3.fromRGB(255, 244, 220),
		AtmColor = Color3.fromRGB(205, 225, 255),
		AtmDecay = Color3.fromRGB(120, 170, 235),
		AtmDensity = 0.24,
		AtmHaze = 0.6,
		AtmGlare = 0.4,
		Tint = Color3.fromRGB(255, 251, 242),
		Saturation = 0.12,
		Contrast = 0.05,
		CloudColor = Color3.fromRGB(255, 255, 255),
		CloudCover = 0.45,
		CloudDensity = 0.5,
		SunSize = 21,
		Bodies = true,
	},
	Molten = {
		ClockTime = 18.15,
		Brightness = 1.8,
		Ambient = Color3.fromRGB(112, 58, 40),
		OutdoorAmbient = Color3.fromRGB(150, 72, 44),
		ColorShift_Top = Color3.fromRGB(255, 120, 50),
		AtmColor = Color3.fromRGB(190, 86, 46),
		AtmDecay = Color3.fromRGB(86, 30, 18),
		AtmDensity = 0.46,
		AtmHaze = 2.8,
		AtmGlare = 0.8,
		Tint = Color3.fromRGB(255, 224, 200),
		Saturation = 0.14,
		Contrast = 0.14,
		CloudColor = Color3.fromRGB(64, 44, 40),
		CloudCover = 0.86,
		CloudDensity = 0.85,
		SunSize = 34,
		Bodies = true,
	},
	Ice = {
		ClockTime = 13,
		Brightness = 2.6,
		Ambient = Color3.fromRGB(150, 175, 210),
		OutdoorAmbient = Color3.fromRGB(186, 210, 240),
		ColorShift_Top = Color3.fromRGB(220, 236, 255),
		AtmColor = Color3.fromRGB(222, 236, 255),
		AtmDecay = Color3.fromRGB(160, 196, 236),
		AtmDensity = 0.42,
		AtmHaze = 2.6,
		AtmGlare = 0,
		Tint = Color3.fromRGB(232, 244, 255),
		Saturation = -0.1,
		Contrast = 0.04,
		CloudColor = Color3.fromRGB(236, 242, 250),
		CloudCover = 0.92,
		CloudDensity = 0.8,
		SunSize = 21,
		Bodies = false,
	},
}

local default: Mood? = nil
local current = ""
local whiteout = false
local arrowGui: ScreenGui? = nil
local arrow: TextLabel? = nil
local arrowText: TextLabel? = nil

------------------------------------------------------------------------
-- Lighting
------------------------------------------------------------------------
local function capture(): Mood?
	local atm = Lighting:FindFirstChild("CrumbleAtmosphere") :: Atmosphere?
	local cc = Lighting:FindFirstChild("CrumbleGrade") :: ColorCorrectionEffect?
	if not atm or not cc then
		return nil
	end
	local sky = Lighting:FindFirstChildOfClass("Sky")
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
	return {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		ColorShift_Top = Lighting.ColorShift_Top,
		AtmColor = atm.Color,
		AtmDecay = atm.Decay,
		AtmDensity = atm.Density,
		AtmHaze = atm.Haze,
		AtmGlare = atm.Glare,
		Tint = cc.TintColor,
		Saturation = cc.Saturation,
		Contrast = cc.Contrast,
		CloudColor = clouds and clouds.Color or Color3.new(1, 1, 1),
		CloudCover = clouds and clouds.Cover or 0.5,
		CloudDensity = clouds and clouds.Density or 0.5,
		SunSize = sky and sky.SunAngularSize or 21,
		Bodies = sky == nil or sky.CelestialBodiesShown,
	}
end

local function apply(m: Mood, time: number)
	local info = TweenInfo.new(time, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		ClockTime = m.ClockTime,
		Brightness = m.Brightness,
		Ambient = m.Ambient,
		OutdoorAmbient = m.OutdoorAmbient,
		ColorShift_Top = m.ColorShift_Top,
	}):Play()
	local atm = Lighting:FindFirstChild("CrumbleAtmosphere") :: Atmosphere?
	if atm then
		TweenService:Create(atm, info, { Color = m.AtmColor, Decay = m.AtmDecay, Density = m.AtmDensity, Haze = m.AtmHaze, Glare = m.AtmGlare }):Play()
	end
	local cc = Lighting:FindFirstChild("CrumbleGrade") :: ColorCorrectionEffect?
	if cc then
		TweenService:Create(cc, info, { TintColor = m.Tint, Saturation = m.Saturation, Contrast = m.Contrast }):Play()
	end
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		TweenService:Create(clouds, info, { Color = m.CloudColor, Cover = m.CloudCover, Density = m.CloudDensity }):Play()
	end
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if sky then
		TweenService:Create(sky, info, { SunAngularSize = m.SunSize }):Play()
		sky.CelestialBodiesShown = m.Bodies
	end
end

-- the map's sky is up while a match is on (everyone sees it: the sky is shared)
local function matchOn(): boolean
	local state = ReplicatedStorage:GetAttribute("State")
	return state == "Countdown" or state == "Live" or state == "Results"
end

local function nearArena(): boolean
	local cam = workspace.CurrentCamera
	if not cam then
		return false
	end
	local p = cam.CFrame.Position
	local c = Config.Arena.Center
	return Vector3.new(p.X - c.X, 0, p.Z - c.Z).Magnitude < 190
end

------------------------------------------------------------------------
-- Weather: particle boxes that follow the camera
------------------------------------------------------------------------
local skyBox: Part? = nil -- emits downward (snow, ash)
local groundBox: Part? = nil -- emits upward (embers, motes)
local fx: { [string]: { ParticleEmitter } } = {}

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Enabled = false
	for k, v in props do
		(pe :: any)[k] = v
	end
	pe.Parent = parent
	return pe
end

local function buildWeather()
	local f = Instance.new("Folder")
	f.Name = "CrumbleWeather"
	local function box(name: string): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(110, 1, 110)
		p.Parent = f
		return p
	end
	local top, low = box("WeatherSky"), box("WeatherGround")
	fx.Ice = {
		emitter(top, {
			Name = "Snow", Rate = 320, Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(9, 14),
			EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(15, 15),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.18) }),
			Color = ColorSequence.new(Color3.new(1, 1, 1)), LightEmission = 0.3, RotSpeed = NumberRange.new(-60, 60),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.1), NumberSequenceKeypoint.new(1, 0.4) }),
		}),
	}
	fx.Molten = {
		emitter(top, {
			Name = "Ash", Rate = 140, Lifetime = NumberRange.new(5, 8), Speed = NumberRange.new(4, 7),
			EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(25, 25),
			Size = NumberSequence.new(0.28, 0.16), Color = ColorSequence.new(Color3.fromRGB(70, 64, 62), Color3.fromRGB(120, 110, 106)),
			RotSpeed = NumberRange.new(-120, 120), Transparency = NumberSequence.new(0.15, 0.6),
		}),
		emitter(low, {
			Name = "Embers", Rate = 70, Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(6, 12),
			EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(20, 20), LightEmission = 1,
			Acceleration = Vector3.new(1.5, 2, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 0.28), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 200, 70), Color3.fromRGB(255, 90, 10)),
		}),
	}
	fx.Grid = {
		emitter(low, {
			Name = "SunMotes", Rate = 18, Lifetime = NumberRange.new(5, 8), Speed = NumberRange.new(1, 2.5),
			EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(60, 60), LightEmission = 0.8,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.18), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 244, 210)),
		}),
	}
	f.Parent = workspace
	skyBox, groundBox = top, low
end

local function setWeather(map: string)
	for id, list in fx do
		for _, pe in list do
			pe.Enabled = (id == map)
		end
	end
end

local function stepWeather(map: string, show: boolean)
	local top, low = skyBox, groundBox
	local cam = workspace.CurrentCamera
	if not top or not low or not cam then
		return
	end
	if not show then
		setWeather("")
		return
	end
	setWeather(map)
	local p = cam.CFrame.Position + cam.CFrame.LookVector * 20
	top.CFrame = CFrame.new(p.X, p.Y + 28, p.Z)
	low.CFrame = CFrame.new(p.X, p.Y - 18, p.Z)
	-- blizzard: the snow flies sideways with the wind
	local snow = fx.Ice and fx.Ice[1]
	if snow then
		local wd = ReplicatedStorage:GetAttribute("WindDir")
		if ReplicatedStorage:GetAttribute("WindPhase") == "blow" and typeof(wd) == "Vector3" then
			snow.Acceleration = wd * 70
			snow.Rate = 700
		else
			snow.Acceleration = Vector3.new(2, 0, 1)
			snow.Rate = 320
		end
	end
end

------------------------------------------------------------------------
-- Molten Core: volcanoes lob glowing lava bombs into the lava ocean (pure scenery)
------------------------------------------------------------------------
local nextBomb = 0

local function lavaBomb()
	local arena = workspace:FindFirstChild("Arena")
	local theme = arena and arena:FindFirstChild("Theme_Molten")
	if not theme then
		return
	end
	local craters = {}
	for _, d in theme:GetChildren() do
		if d.Name == "Crater" and d:IsA("BasePart") then
			table.insert(craters, d)
		end
	end
	if #craters == 0 then
		return
	end
	local cr = craters[math.random(1, #craters)] :: BasePart
	local from = cr.Position
	local c = Config.Arena.Center
	local toward = Vector3.new(c.X - from.X, 0, c.Z - from.Z)
	local dist = toward.Magnitude
	local dir = dist > 1 and toward.Unit or Vector3.xAxis
	local side = Vector3.new(-dir.Z, 0, dir.X)
	-- land in the lava between the volcano and the arena (never on the floor)
	local land = from + dir * (dist * (0.25 + math.random() * 0.35)) + side * ((math.random() - 0.5) * 80)
	land = Vector3.new(land.X, Config.Arena.KillY - 15, land.Z)
	local ball = Instance.new("Part")
	ball.Name = "LavaBomb"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(4, 4, 4)
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 150, 30)
	ball.CFrame = CFrame.new(from)
	local trail = Instance.new("ParticleEmitter")
	trail.Rate = 60
	trail.Lifetime = NumberRange.new(1, 1.8)
	trail.Speed = NumberRange.new(0.5, 2)
	trail.Size = NumberSequence.new(3, 7)
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 140, 30), Color3.fromRGB(60, 50, 48))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.LightEmission = 0.6
	trail.Parent = ball
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 30)
	light.Range = 30
	light.Brightness = 3
	light.Parent = ball
	ball.Parent = workspace
	local dur = 2.6 + math.random() * 1.2
	local peak = 50 + math.random() * 40
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local u = math.clamp((os.clock() - t0) / dur, 0, 1)
		local pos = from:Lerp(land, u) + Vector3.new(0, 4 * peak * u * (1 - u), 0)
		ball.CFrame = CFrame.new(pos)
		if u >= 1 then
			if conn then
				conn:Disconnect()
			end
			trail.Enabled = false
			ball.Transparency = 1
			light.Enabled = false
			-- splash in the lava
			local splash = Instance.new("ParticleEmitter")
			splash.Rate = 0
			splash.Speed = NumberRange.new(14, 26)
			splash.SpreadAngle = Vector2.new(35, 35)
			splash.Lifetime = NumberRange.new(0.8, 1.4)
			splash.Acceleration = Vector3.new(0, -40, 0)
			splash.Size = NumberSequence.new(1.6, 0.4)
			splash.LightEmission = 1
			splash.EmissionDirection = Enum.NormalId.Top
			splash.Color = ColorSequence.new(Color3.fromRGB(255, 190, 60), Color3.fromRGB(255, 80, 10))
			splash.Parent = ball
			splash:Emit(40)
			Debris:AddItem(ball, 2)
		end
	end)
	Debris:AddItem(ball, dur + 4)
end

------------------------------------------------------------------------
-- Wind arrow (Ice Rink blizzards)
------------------------------------------------------------------------
local function buildArrow()
	local gui = Instance.new("ScreenGui")
	gui.Name = "CrumbleWind"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 6
	gui.Enabled = false
	local holder = Instance.new("Frame")
	-- v0.9.3: left edge, mid-screen (the menu dock is hidden in matches) — the top centre is the
	-- notification stack now, so the wind gauge no longer covers toasts / tutorial tips
	holder.AnchorPoint = Vector2.new(0, 0.5)
	holder.Position = UDim2.new(0, 16, 0.42, 0)
	holder.Size = UDim2.fromOffset(240, 70)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	-- v1.0 patch: the wind gauge follows the shared HUD scale too
	local gaugeScale = Instance.new("UIScale")
	gaugeScale.Parent = holder
	Layout.OnChanged(function(s: number)
		gaugeScale.Scale = s
		holder.Position = UDim2.new(0, 16, 0.42, 0)
	end)
	local a = Instance.new("TextLabel")
	a.AnchorPoint = Vector2.new(0.5, 0.5)
	a.Position = UDim2.new(0.5, 0, 0, 24)
	a.Size = UDim2.fromOffset(52, 52)
	a.BackgroundTransparency = 1
	a.Font = Enum.Font.GothamBlack
	a.TextScaled = true
	a.Text = ""
	UI.setIcon(a, "arrow", Color3.fromRGB(150, 232, 255), 0.9)
	a.TextColor3 = Color3.fromRGB(150, 232, 255)
	a.TextStrokeTransparency = 0
	a.TextStrokeColor3 = Color3.fromRGB(20, 40, 70)
	a.Parent = holder
	local t = Instance.new("TextLabel")
	t.AnchorPoint = Vector2.new(0.5, 0)
	t.Position = UDim2.new(0.5, 0, 0, 50)
	t.Size = UDim2.fromOffset(240, 18)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = "WIND"
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.TextStrokeColor3 = Color3.fromRGB(20, 40, 70)
	t.Parent = holder
	gui.Parent = player:WaitForChild("PlayerGui")
	arrowGui, arrow, arrowText = gui, a, t
end

local function stepArrow()
	local gui, a, t = arrowGui, arrow, arrowText
	if not gui or not a or not t then
		return
	end
	local phase = ReplicatedStorage:GetAttribute("WindPhase")
	local dir = ReplicatedStorage:GetAttribute("WindDir")
	local show = (phase == "warn" or phase == "blow") and typeof(dir) == "Vector3" and nearArena()
	gui.Enabled = show
	if not show then
		return
	end
	local cam = workspace.CurrentCamera
	if cam and typeof(dir) == "Vector3" then
		-- rotate the arrow so it points the way the wind blows, relative to where you're looking
		local look = cam.CFrame.LookVector
		local camYaw = math.atan2(-look.X, -look.Z)
		local windYaw = math.atan2(-dir.X, -dir.Z)
		a.Rotation = math.deg(camYaw - windYaw) - 90
	end
	local untilT = (ReplicatedStorage:GetAttribute("WindUntil") :: number?) or 0
	local left = math.max(0, untilT - workspace:GetServerTimeNow())
	if phase == "warn" then
		t.Text = string.format("GUST IN %.1fs", left)
		a.TextColor3 = (math.floor(os.clock() * 6) % 2 == 0) and Color3.fromRGB(150, 232, 255) or Color3.new(1, 1, 1)
	else
		t.Text = string.format("BLIZZARD! %.1fs", left)
		a.TextColor3 = Color3.fromRGB(150, 232, 255)
	end
end

------------------------------------------------------------------------
-- v0.8.5 Immersion: hide the lobby world, show the map's own landmarks (local only)
------------------------------------------------------------------------
local HIDE = { "Lobby", "RangeDummies" }
local hidden: { [string]: Instance } = {}
local shownSet: Instance? = nil
local shownMap = ""

local function immersed(mapId: string): boolean
	if mapId ~= "Molten" and mapId ~= "Ice" then
		return false
	end
	local state = ReplicatedStorage:GetAttribute("State")
	if state ~= "Countdown" and state ~= "Live" then
		return false
	end
	local char = player.Character
	return char ~= nil and char:GetAttribute("InRound") == true and char:GetAttribute("Alive") ~= false
end

local function stepImmersion(mapId: string)
	local want = immersed(mapId) and mapId or ""
	if want == shownMap then
		return
	end
	shownMap = want
	if shownSet then
		(shownSet :: Instance):Destroy()
		shownSet = nil
	end
	if want == "" then
		for name, inst in hidden do
			if inst.Parent == nil then
				inst.Parent = workspace
			end
			hidden[name] = nil
		end
		return
	end
	for _, name in HIDE do
		local inst = workspace:FindFirstChild(name)
		if inst then
			hidden[name] = inst
			inst.Parent = nil
		end
	end
	local imm = ReplicatedStorage:FindFirstChild("Immersion")
	local src = imm and imm:FindFirstChild(want)
	if src then
		local set = src:Clone()
		set.Name = "Immersion_" .. want
		set.Parent = workspace
		shownSet = set
	end
end

------------------------------------------------------------------------
function MoodController.Init()
	-- wait until the server has set up the Lighting objects, then remember the Yard look
	for _ = 1, 50 do
		default = capture()
		if default then
			break
		end
		task.wait(0.2)
	end
	buildArrow()
	buildWeather()
	local acc = 0
	RunService.RenderStepped:Connect(function(dt: number)
		stepArrow()
		local map = ReplicatedStorage:GetAttribute("Map")
		local mapId = type(map) == "string" and map or "Grid"
		local on = matchOn()
		stepWeather(mapId, on and nearArena())
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local okI, errI = pcall(stepImmersion, mapId)
		if not okI then
			warn("[CRUMBLE] immersion:", errI)
		end
		-- sky / lighting
		local want = (on and MOODS[mapId]) and mapId or ""
		local blow = want == "Ice" and ReplicatedStorage:GetAttribute("WindPhase") == "blow"
		if want ~= current then
			current = want
			whiteout = false
			local m = MOODS[want] or default
			if m then
				apply(m, 2)
			end
		elseif blow ~= whiteout then
			-- blizzard white-out: the fog closes in while the gust blows
			whiteout = blow
			local atm = Lighting:FindFirstChild("CrumbleAtmosphere") :: Atmosphere?
			if atm then
				local m = MOODS.Ice
				TweenService:Create(atm, TweenInfo.new(blow and 0.8 or 1.6), { Density = blow and 0.6 or m.AtmDensity, Haze = blow and 3.4 or m.AtmHaze }):Play()
			end
		end
		-- Molten: distant volcanoes lob lava bombs into the ocean
		if current == "Molten" and os.clock() >= nextBomb then
			nextBomb = os.clock() + 2.5 + math.random() * 4
			task.spawn(lavaBomb)
		end
	end)
end

return MoodController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Social</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — Social (v1.0, client)
	Roblox's own pop-ups, each wrapped in pcall (they don't open in Studio):
	• Favorite()  → AvatarEditorService:PromptSetFavorite(PlaceId); yields for the answer and
	                returns "yes" | "no" | "error"
	• Invite()    → SocialService:PromptGameInvite (invite friends)
	There is no Roblox API for LIKE (thumbs up), so the game only asks for it.
]]

local Players = game:GetService("Players")

local Social = {}

local player = Players.LocalPlayer

function Social.Favorite(): string
	local okSvc, aes = pcall(function()
		return game:GetService("AvatarEditorService")
	end)
	if not okSvc or not aes then
		return "error"
	end
	local answer: string? = nil
	local conn: RBXScriptConnection? = nil
	pcall(function()
		conn = aes.PromptSetFavoriteCompleted:Connect(function(result)
			answer = (result == Enum.AvatarPromptResult.Success) and "yes" or "no"
		end)
	end)
	local ok = pcall(function()
		aes:PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
	end)
	if not ok then
		if conn then
			conn:Disconnect()
		end
		return "error"
	end
	local waited = 0
	while answer == nil and waited < 120 do
		waited += task.wait(0.25)
	end
	if conn then
		conn:Disconnect()
	end
	return answer or "no"
end

-- returns (opened, message-if-not)
function Social.Invite(): (boolean, string?)
	local SocialService = game:GetService("SocialService")
	local okCan, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if not okCan then
		return false, "Invites aren't available right now."
	end
	if can ~= true then
		return false, "Invites are turned off for your account."
	end
	local ok = pcall(function()
		SocialService:PromptGameInvite(player)
	end)
	return ok, (not ok) and "Invites aren't available right now." or nil
end

return Social
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">TouchController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CRUMBLE! — TouchController (v1.0 patch 5)
	Our own mobile controls (Roblox's stick + jump button are switched off in touch mode):

	  * JOYSTICK  - bottom-left. A faint ring shows where it lives; touch anywhere in the left part
	                of the screen and it jumps under your thumb (dynamic stick). Orange knob, ink ring.
	  * JUMP      - bottom-right corner, hold to keep hopping.
	  * SHOVE / RUSH / BLOCK - wrap around JUMP in an arc, only while you can fight (match / Range).
	                They fire on PRESS (no tap delay), squish when pressed, show a shrinking dark disk +
	                seconds while cooling down and pop when ready. BLOCK shows the guard while it refills.

	Sizes grow with the screen: k = clamp(shortSide / 390, 1, 1.6) (phone 1.0 -> tablet 1.6).
	Layout.TouchCluster(vp) returns the same cluster width so HUD cards keep clear of it.
	Movement: Player:Move(dir, cameraRelative) in a render step bound right AFTER Roblox's control
	script, so the stick always wins; JUMP sets Humanoid.Jump while held.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Controllers = script.Parent
local UI = require(Controllers.UI)
local Layout = require(Controllers.Layout)
local InputController = require(Controllers.InputController)

local TouchController = {}

local player = Players.LocalPlayer
local INK = UI.Outline
local WHITE = Color3.new(1, 1, 1)

-- button centres measured from the bottom-right corner (dx, dy) + diameter, at k = 1
local CLUSTER: { [string]: { number } } = {
	Jump = { 62, 62, 78 },
	Shove = { 152, 62, 86 },
	Block = { 55, 140, 62 },
	Rush = { 147, 147, 62 },
}
local STICK_D, KNOB_D, STICK_MARGIN = 126, 56, 20

local function factor(vp: Vector2): number
	return math.clamp(math.min(vp.X, vp.Y) / 390, 1, 1.6)
end
TouchController.Factor = factor

local function now(): number
	return workspace:GetServerTimeNow()
end

local function tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	local ok = pcall(function()
		TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
	end)
	if not ok then
		for k, v in props do
			(obj :: any)[k] = v
		end
	end
end

local function round(parent: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(r or 1, 0)
	c.Parent = parent
end

local function inkStroke(parent: Instance, thick: number, color: Color3?, transp: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = thick
	s.Color = color or INK
	s.Transparency = transp or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function shine(parent: GuiObject)
	-- light top -> darker bottom, like the dock tiles
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 196, 196))
	g.Parent = parent
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.AnchorPoint = Vector2.new(0.5, 0.5)
	gloss.Position = UDim2.fromScale(0.5, 0.24)
	gloss.Size = UDim2.fromScale(0.62, 0.22)
	gloss.BackgroundColor3 = WHITE
	gloss.BackgroundTransparency = 0.72
	gloss.BorderSizePixel = 0
	gloss.ZIndex = parent.ZIndex + 1
	round(gloss)
	gloss.Parent = parent
end

------------------------------------------------------------------------
-- Round action button
------------------------------------------------------------------------
type Btn = {
	B: TextButton,
	Scale: UIScale,
	Rim: UIStroke,
	Shade: Frame,
	Secs: TextLabel,
	Label: TextLabel,
	Color: Color3,
	Total: number,
	Left: number,
}

local function makeButton(parent: Instance, name: string, text: string, icon: string, color: Color3): Btn
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.ZIndex = 2
	b:SetAttribute("NoSkin", true)
	round(b)
	inkStroke(b, 3)
	shine(b)
	local sc = Instance.new("UIScale")
	sc.Parent = b
	-- white inner rim (flashes when the move is ready again)
	local rimHolder = Instance.new("Frame")
	rimHolder.Name = "Rim"
	rimHolder.AnchorPoint = Vector2.new(0.5, 0.5)
	rimHolder.Position = UDim2.fromScale(0.5, 0.5)
	rimHolder.Size = UDim2.new(1, -8, 1, -8)
	rimHolder.BackgroundTransparency = 1
	rimHolder.ZIndex = 3
	round(rimHolder)
	local rim = inkStroke(rimHolder, 2, WHITE, 0.45)
	rimHolder.Parent = b
	UI.icon(icon, { Parent = b, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromScale(0.42, 0.42), ZIndex = 4 })
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.76)
	label.Size = UDim2.fromScale(0.82, 0.2)
	label.Font = UI.Display
	label.TextScaled = true
	label.TextWrapped = false
	label.TextColor3 = WHITE
	label.Text = text
	label.ZIndex = 12
	local ls = Instance.new("UIStroke")
	ls.Thickness = 1.5
	ls.Color = INK
	ls.Parent = label
	label.Parent = b
	-- cooldown: a dark disk that shrinks to nothing as the move gets ready, + seconds
	local shade = Instance.new("Frame")
	shade.Name = "Shade"
	shade.AnchorPoint = Vector2.new(0.5, 0.5)
	shade.Position = UDim2.fromScale(0.5, 0.5)
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Color3.fromRGB(20, 16, 30)
	shade.BackgroundTransparency = 0.38
	shade.BorderSizePixel = 0
	shade.Visible = false
	shade.ZIndex = 10
	round(shade)
	shade.Parent = b
	local secs = Instance.new("TextLabel")
	secs.Name = "Secs"
	secs.BackgroundTransparency = 1
	secs.AnchorPoint = Vector2.new(0.5, 0.5)
	secs.Position = UDim2.fromScale(0.5, 0.42)
	secs.Size = UDim2.fromScale(0.56, 0.4)
	secs.Font = UI.Display
	secs.TextScaled = true
	secs.TextColor3 = WHITE
	secs.Text = ""
	secs.Visible = false
	secs.ZIndex = 13
	local ss = Instance.new("UIStroke")
	ss.Thickness = 2
	ss.Color = INK
	ss.Parent = secs
	secs.Parent = b
	b.Parent = parent
	return { B = b, Scale = sc, Rim = rim, Shade = shade, Secs = secs, Label = label, Color = color, Total = 0, Left = 0 }
end

-- press = fire immediately (no tap delay); release callback for hold buttons. The release is caught
-- globally, so sliding the thumb off the button still lets go of BLOCK / JUMP.
local function onPress(btn: Btn, down: () -> (), up: (() -> ())?)
	local active: { [InputObject]: boolean } = {}
	local count = 0
	btn.B.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if (t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1) and not active[input] then
			active[input] = true
			count += 1
			tween(btn.Scale, 0.06, { Scale = 0.86 })
			down()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local hit = active[input] == true
		if not hit and input.UserInputType == Enum.UserInputType.MouseButton1 then
			for i in active do
				if i.UserInputType == Enum.UserInputType.MouseButton1 then
					active[i] = nil
					hit = true
				end
			end
		end
		if not hit then
			return
		end
		active[input] = nil
		count = 0
		for _ in active do
			count += 1
		end
		if count == 0 then
			tween(btn.Scale, 0.16, { Scale = 1 }, Enum.EasingStyle.Back)
			if up then
				up()
			end
		end
	end)
end

local function readyPop(btn: Btn)
	btn.Scale.Scale = 1.16
	tween(btn.Scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	btn.Rim.Transparency = 0
	btn.Rim.Thickness = 4
	tween(btn.Rim, 0.35, { Transparency = 0.45, Thickness = 2 })
end

local function cool(btn: Btn, left: number)
	if left > 0.25 then -- (fast jabs don't flicker)
		if left > btn.Left + 0.05 or btn.Total <= 0 then
			btn.Total = left -- a new cooldown started
		end
		local f = math.clamp(left / math.max(btn.Total, 0.01), 0, 1)
		btn.Shade.Visible = true
		btn.Shade.Size = UDim2.fromScale(0.3 + 0.7 * f, 0.3 + 0.7 * f)
		btn.Secs.Visible = true
		btn.Secs.Text = if left >= 1 then tostring(math.ceil(left)) else string.format("%.1f", left)
	else
		if btn.Shade.Visible then
			btn.Shade.Visible = false
			btn.Secs.Visible = false
			readyPop(btn)
		end
		btn.Total = 0
	end
	btn.Left = left
end

------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------
function TouchController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "CrumbleTouch"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 3 -- under the HUD (4), menu windows (5) and join card (8)
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- keep clear of notches / home bar
	end)
	gui.Parent = player:WaitForChild("PlayerGui")
	TouchController.Gui = gui

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Parent = gui

	-- JOYSTICK ---------------------------------------------------------
	local zone = Instance.new("Frame")
	zone.Name = "StickZone"
	zone.BackgroundTransparency = 1
	zone.Active = true -- touches here move you; they don't turn the camera
	zone.Position = UDim2.fromScale(0, 0.32)
	zone.Size = UDim2.fromScale(0.45, 0.68)
	zone.Parent = root

	local base = Instance.new("Frame")
	base.Name = "StickBase"
	base.AnchorPoint = Vector2.new(0.5, 0.5)
	base.BackgroundColor3 = Color3.fromRGB(24, 20, 34)
	base.BackgroundTransparency = 0.6
	base.BorderSizePixel = 0
	base.ZIndex = 2
	round(base)
	local baseRing = inkStroke(base, 3, WHITE, 0.35)
	base.Parent = root
	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.AnchorPoint = Vector2.new(0.5, 0.5)
	inner.Position = UDim2.fromScale(0.5, 0.5)
	inner.Size = UDim2.fromScale(0.6, 0.6)
	inner.BackgroundTransparency = 1
	inner.ZIndex = 3
	round(inner)
	inkStroke(inner, 1.5, WHITE, 0.7)
	inner.Parent = base
	-- four little chevrons (N E S W)
	for i, rot in { -90, 0, 90, 180 } do
		local a = math.rad(rot)
		local holder = Instance.new("Frame")
		holder.Name = "Chevron" .. i
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Position = UDim2.fromScale(0.5 + 0.39 * math.cos(a), 0.5 + 0.39 * math.sin(a))
		holder.Size = UDim2.fromScale(0.14, 0.14)
		holder.Rotation = rot
		holder.BackgroundTransparency = 1
		holder.ZIndex = 3
		holder.Parent = base
		UI.icon("arrow", { Parent = holder, Size = UDim2.fromScale(1, 1), ZIndex = 3 })
	end
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.BackgroundColor3 = Color3.fromRGB(255, 120, 40)
	knob.BorderSizePixel = 0
	knob.ZIndex = 6
	round(knob)
	inkStroke(knob, 3)
	shine(knob)
	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromScale(0.32, 0.32)
	dot.BackgroundColor3 = Color3.fromRGB(255, 214, 150)
	dot.BorderSizePixel = 0
	dot.ZIndex = 8
	round(dot)
	dot.Parent = knob
	knob.Parent = base

	local k = 1
	local function restPos(): UDim2
		local r = STICK_D * k / 2
		return UDim2.new(0, STICK_MARGIN * k + r, 1, -(STICK_MARGIN * k + r))
	end
	local function setStickLook(active: boolean)
		base.BackgroundTransparency = if active then 0.4 else 0.62
		baseRing.Transparency = if active then 0 else 0.4
		knob.BackgroundTransparency = if active then 0 else 0.15
	end
	setStickLook(false)

	local stickInput: InputObject? = nil
	local origin = Vector2.zero
	local moveVec = Vector2.zero

	local function localPos(input: InputObject): Vector2
		-- InputObject.Position and AbsolutePosition share the same (inset) space
		return Vector2.new(input.Position.X, input.Position.Y) - root.AbsolutePosition
	end
	local function update(input: InputObject)
		local r = STICK_D * k / 2 * 0.86
		local d = localPos(input) - origin
		local m = d.Magnitude
		if m > r then
			d = d.Unit * r
			m = r
		end
		knob.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
		local f = m / r
		if f < 0.12 then
			moveVec = Vector2.zero
		else
			moveVec = d.Unit * ((f - 0.12) / 0.88)
		end
	end
	local function release()
		stickInput = nil
		moveVec = Vector2.zero
		knob.Position = UDim2.fromScale(0.5, 0.5)
		base.Position = restPos()
		setStickLook(false)
	end
	zone.InputBegan:Connect(function(input)
		if stickInput then
			return
		end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then
			return
		end
		stickInput = input
		-- the stick jumps under the thumb (kept fully on screen)
		local size = root.AbsoluteSize
		local r = STICK_D * k / 2 + 6
		local p = localPos(input)
		origin = Vector2.new(math.clamp(p.X, r, math.max(r, size.X - r)), math.clamp(p.Y, r, math.max(r, size.Y - r)))
		base.Position = UDim2.fromOffset(origin.X, origin.Y)
		setStickLook(true)
		update(input)
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		local si: InputObject? = stickInput
		if not si then
			return
		end
		if rawequal(input, si) or (si.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local si: InputObject? = stickInput
		if si and (rawequal(input, si) or (si.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			release()
		end
	end)

	-- BUTTONS ----------------------------------------------------------
	local cream = Color3.fromRGB(255, 248, 232)
	local btns: { [string]: Btn } = {
		Jump = makeButton(root, "Jump", "JUMP", "jump", cream),
		Shove = makeButton(root, "Shove", "SHOVE", "burst", Color3.fromRGB(255, 96, 40)),
		Rush = makeButton(root, "Rush", "RUSH", "bolt", Color3.fromRGB(70, 118, 255)),
		Block = makeButton(root, "Block", "BLOCK", "shield", Color3.fromRGB(34, 176, 206)),
	}
	btns.Jump.Label.TextColor3 = INK
	local jl = btns.Jump.Label:FindFirstChildOfClass("UIStroke")
	if jl then
		jl.Color = WHITE
	end
	local jumpHeld = false
	onPress(btns.Jump, function()
		jumpHeld = true
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Jump = true
		end
	end, function()
		jumpHeld = false
	end)
	onPress(btns.Shove, InputController.Shove)
	onPress(btns.Rush, InputController.Rush)
	onPress(btns.Block, InputController.BlockStart, InputController.BlockEnd)

	local function place()
		local size = root.AbsoluteSize
		if size.X < 10 then
			return
		end
		k = factor(size)
		for name, v in CLUSTER do
			local b = btns[name].B
			b.Size = UDim2.fromOffset(v[3] * k, v[3] * k)
			b.Position = UDim2.new(1, -v[1] * k, 1, -v[2] * k)
		end
		base.Size = UDim2.fromOffset(STICK_D * k, STICK_D * k)
		knob.Size = UDim2.fromOffset(KNOB_D * k, KNOB_D * k)
		if not stickInput then
			base.Position = restPos()
		end
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
	place()

	-- MOVE (runs right after Roblox's control script each frame, so the stick wins) ------------
	local sentZero = true
	local function stepMove()
		if not gui.Enabled then
			if not sentZero then
				player:Move(Vector3.zero, true)
				sentZero = true
			end
			return
		end
		if moveVec.Magnitude > 0 then
			player:Move(Vector3.new(moveVec.X, 0, moveVec.Y), true)
			sentZero = false
		elseif not sentZero then
			player:Move(Vector3.zero, true)
			sentZero = true
		end
		if jumpHeld then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Jump = true
			end
		end
	end
	local bound = pcall(function()
		RunService:BindToRenderStep("CrumbleStick", Enum.RenderPriority.Input.Value + 1, stepMove)
	end)
	if not bound then
		RunService.RenderStepped:Connect(stepMove)
	end

	-- Roblox's own stick + jump button only when we're NOT in touch mode
	Layout.OnModeChanged(function(touch: boolean)
		pcall(function()
			GuiService.TouchControlsEnabled = not touch
		end)
		if not touch then
			release()
			jumpHeld = false
		end
	end)

	-- STATE (visibility + cooldowns) -------------------------------------------------------
	local fightOn: boolean? = nil -- (nil = not applied yet: the fight buttons start HIDDEN)
	RunService.RenderStepped:Connect(function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local on = Layout.IsTouch() and hum ~= nil and hum.Health > 0
		if gui.Enabled ~= on then
			gui.Enabled = on
			if not on then
				release()
				jumpHeld = false
			end
		end
		if not on or not char then
			return
		end
		local fighting = InputController.CanAct()
			or (char:GetAttribute("InRound") == true and char:GetAttribute("Alive") == true and ReplicatedStorage:GetAttribute("State") == "Countdown")
		if fighting ~= fightOn then
			fightOn = fighting
			for _, name in { "Shove", "Rush", "Block" } do
				local b = btns[name]
				b.B.Visible = fighting
				if fighting then
					b.Scale.Scale = 0.4
					tween(b.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end
		end
		if not fighting then
			return
		end
		local t = now()
		local follow = InputController.Follow
		local armed = t < follow.RepelUntil
		local readyAt = InputController.ShoveReadyAt
		if not armed and t < follow.CycleAt then
			readyAt = math.max(readyAt, follow.CycleAt)
		end
		cool(btns.Shove, if armed then 0 else readyAt - t)
		btns.Shove.Label.Text = if armed then "REPEL!" else "SHOVE"
		cool(btns.Rush, InputController.RushReadyAt - t)
		-- BLOCK: the dark disk shows the empty part of the guard while it refills
		local guard = (char:GetAttribute("Guard") :: number?) or 100
		local blocking = char:GetAttribute("Blocking") == true
		local recharging = guard < Config.Combat.MinBlockGuard
		local bb = btns.Block
		if recharging then
			local f = 1 - guard / 100
			bb.Shade.Visible = true
			bb.Shade.Size = UDim2.fromScale(0.3 + 0.7 * f, 0.3 + 0.7 * f)
			bb.Secs.Visible = true
			bb.Secs.Text = tostring(math.floor(guard))
		elseif bb.Shade.Visible then
			bb.Shade.Visible = false
			bb.Secs.Visible = false
			readyPop(bb)
		end
		bb.Label.Text = if blocking then "UP!" else "BLOCK"
		bb.B.BackgroundColor3 = if blocking then Color3.fromRGB(120, 230, 250) else bb.Color
	end)
end

return TouchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — TutorialController (v0.9 Retention · doc FTUE "hooked before the first spin")
	A short first-time path with a guide arrow and a SKIP button:
	  1 walk to the Training Range   2 shove a dummy twice   3 block the sparring bot
	  4 parry it (or 6 tries)        5 rush once             6 aim-assist hit (hits go where you face) → +150 coins, +1 Boot copy
	  7 join a match                 8 finish it (3 tips)    9 MERGE the Boot to L2 at the Forge
	Then, when you have a spin you never used, a one-time "open the Vault" hint.
	The server checks every step (order, sparring result, Boot level) and pays the reward.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Controllers = script.Parent
local UI = require(Controllers.UI)
local Layout = require(Controllers.Layout)
local InputController = require(Controllers.InputController)

local player = Players.LocalPlayer
local Col = UI.Colors
local DONE = Config.Tutorial.Done

local TutorialController = {}

type Step = { Title: string, Hint: string }
local STEPS: { Step } = {
	{ Title = "GO TO THE TRAINING RANGE", Hint = "Follow the arrow." },
	{ Title = "SHOVE A DUMMY x2", Hint = "CLICK next to a dummy." },
	{ Title = "BLOCK THE SPARRING BOT", Hint = "On GET READY, HOLD E." },
	{ Title = "PARRY!", Hint = "TAP E on NOW!" },
	{ Title = "RUSH", Hint = "Press SHIFT to dash." },
	{ Title = "FACE & HIT", Hint = "Hits go where you FACE. Shove the ringed dummy!" },
	{ Title = "JOIN A MATCH", Hint = "Press JOIN when asked." },
	{ Title = "SURVIVE YOUR FIRST MATCH", Hint = "Stay near the middle!" },
	{ Title = "MERGE YOUR BOOT TO L2", Hint = "FORGE > BOOT > MERGE" },
}
-- v1.0 patch MOBILE: phones/tablets read button names instead of keys
local TOUCH_HINTS: { [number]: string } = {
	[2] = "TAP SHOVE next to a dummy.",
	[3] = "On GET READY, HOLD BLOCK.",
	[4] = "TAP BLOCK on NOW!",
	[5] = "TAP RUSH to dash.",
}
local function isTouch(): boolean
	return Layout.IsTouch()
end
local function hintOf(step: number): string
	return if isTouch() and TOUCH_HINTS[step] then TOUCH_HINTS[step] else STEPS[step].Hint
end
local MATCH_TIPS = {
	{ At = 2, Text = "Shove rivals off. Falling is the only way out!" },
	{ At = 22, Text = "Tiles crack, then fall. Keep moving!" },
	{ At = 50, Text = "Big hit? HOLD E to block. SHIFT to rush.", Touch = "Big hit? HOLD BLOCK. TAP RUSH to dash." },
}

local profile: { [string]: any }? = nil
local request: RemoteFunction
local gui: ScreenGui
local panel: Frame
local titleLabel: TextLabel
local hintLabel: TextLabel
local stepLabel: TextLabel
local tipLabel: TextLabel
local beam: Beam? = nil
local marker: BillboardGui? = nil
local targetPart: Part
local busy = false
local sent: { [number]: boolean } = {}
local shoves = 0
local strikes = 0
local rushMark = 0
local assistMark = 0 -- v0.9.2 step 6: InputController.AssistHits when the step started
local wasInRound = false
local roundStart = 0
local tipShown = 0
local spinHintShown = false

local function current(): number
	local p = profile
	if not p then
		return DONE
	end
	return (p.Tutorial or DONE) + 1
end

local function complete(n: number)
	if busy or sent[n] or n ~= current() then
		return
	end
	busy = true
	sent[n] = true
	task.spawn(function()
		local ok, res = pcall(function()
			return request:InvokeServer("TutorialStep", n)
		end)
		busy = false
		if not ok or type(res) ~= "table" or not res.Ok then
			sent[n] = nil -- try again later (e.g. the server wants the real block first)
			if ok and type(res) == "table" and res.Msg then
				hintLabel.Text = res.Msg
			end
			return
		end
		-- the server pushes the profile; reset the per-step counters
		shoves, strikes = 0, 0
		rushMark = InputController.RushReadyAt
	assistMark = InputController.AssistHits
	end)
end

local function lobby(): Instance?
	return workspace:FindFirstChild("Lobby")
end

local function findMenuPart(menu: string): BasePart?
	local l = lobby()
	if not l then
		return nil
	end
	for _, d in l:GetDescendants() do
		if d:IsA("ProximityPrompt") and d:GetAttribute("Menu") == menu and d.Parent and d.Parent:IsA("BasePart") then
			return d.Parent :: BasePart
		end
	end
	return nil
end

local function targetFor(step: number): Vector3?
	local dummies = workspace:FindFirstChild("RangeDummies")
	if step == 1 or step == 2 then
		if dummies then
			for _, m in dummies:GetChildren() do
				if m:IsA("Model") and m.Name ~= "SparringBot" then
					return m:GetPivot().Position
				end
			end
		end
	elseif step == 3 or step == 4 then
		local bot = dummies and dummies:FindFirstChild("SparringBot")
		if bot and bot:IsA("Model") then
			return bot:GetPivot().Position
		end
	elseif step == 9 then
		local part = findMenuPart("Forge")
		return part and part.Position
	end
	return nil
end

local function setArrow(pos: Vector3?)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not pos or not root or (char :: Model):GetAttribute("InRound") == true then
		if beam then
			beam.Enabled = false
		end
		if marker then
			marker.Enabled = false
		end
		return
	end
	targetPart.Position = pos + Vector3.new(0, 1, 0)
	local a0 = root:FindFirstChild("TutorialA0") :: Attachment?
	if not a0 then
		local a = Instance.new("Attachment")
		a.Name = "TutorialA0"
		a.Position = Vector3.new(0, -2.2, 0)
		a.Parent = root
		a0 = a
	end
	if not beam then
		local b = Instance.new("Beam")
		b.Name = "TutorialArrow"
		b.Attachment1 = targetPart:FindFirstChild("A1") :: Attachment
		-- v0.9.12: warm gold → orange, so it never blends with the blue/cyan guide strips and floor
		b.Color = ColorSequence.new(Color3.fromRGB(255, 214, 60), Color3.fromRGB(255, 140, 40))
		b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.5, 0.15), NumberSequenceKeypoint.new(1, 0.5) })
		b.Width0, b.Width1 = 0.8, 0.8
		b.FaceCamera = true
		b.LightEmission = 0.8
		b.LightInfluence = 0
		b.Segments = 20
		b.CurveSize0, b.CurveSize1 = 4, -4
		b.Parent = targetPart
		beam = b
	end
	local bm = beam :: Beam
	bm.Attachment0 = a0
	bm.Enabled = (root.Position - pos).Magnitude > 8
	if marker then
		marker.Enabled = true
	end
end

local progressSegs: { Frame } = {}

local function build()
	gui = UI.new("ScreenGui", { Name = "CrumbleTutorial", ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = 6, Parent = player:WaitForChild("PlayerGui") })
	panel = UI.new("Frame", { Name = "TutorialCard", Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 86), Size = UDim2.fromOffset(520, 96), BackgroundColor3 = Col.Panel, BackgroundTransparency = 0.04, Visible = false })
	UI.corner(18).Parent = panel
	UI.stroke(Col.Blue, 3).Parent = panel
	stepLabel = UI.label({ Parent = panel, Position = UDim2.fromOffset(14, 8), Size = UDim2.fromOffset(80, 18), TextColor3 = Col.Blue, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Left, Text = "" })
	titleLabel = UI.label({ Parent = panel, Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -110, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Font = UI.Font, Text = "" })
	hintLabel = UI.label({ Parent = panel, Position = UDim2.fromOffset(14, 52), Size = UDim2.new(1, -110, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = Col.Mute, Text = "" })
	local skip = UI.button({ Parent = panel, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(84, 40), Text = "SKIP", BackgroundColor3 = Col.Panel2, TextColor3 = Col.Mute })
	skip.Activated:Connect(function()
		task.spawn(function()
			pcall(function()
				request:InvokeServer("TutorialSkip")
			end)
		end)
		panel.Visible = false
	end)
	-- v0.9.3 progress: one segment per step along the bottom of the card
	local segs = UI.new("Frame", { Name = "Progress", Parent = panel, Position = UDim2.new(0, 14, 1, -12), Size = UDim2.new(1, -28, 0, 6), BackgroundTransparency = 1 })
	UI.new("UIListLayout", { Parent = segs, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
	for i = 1, #STEPS do
		local seg = UI.new("Frame", { Name = "Seg" .. i, Parent = segs, LayoutOrder = i, Size = UDim2.new(1 / #STEPS, -4, 1, 0), BackgroundColor3 = Col.Panel2, BorderSizePixel = 0 })
		UI.corner(3).Parent = seg
		progressSegs[i] = seg
	end
	tipLabel = UI.label({ Name = "TutorialTip", Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 150), Size = UDim2.fromOffset(620, 44), BackgroundTransparency = 0.05, BackgroundColor3 = Col.Panel, Font = UI.Font, TextColor3 = Col.Text, Text = "", Visible = false })
	UI.corner(14).Parent = tipLabel
	UI.stroke(Col.Gold, 3).Parent = tipLabel
	UI.padding(10).Parent = tipLabel
	-- v0.9.3: both live in the shared top stack under the timer (never on top of toasts / join pill)
	Layout.AddToStack(panel, 20, 540)
	Layout.AddToStack(tipLabel, 30, 620)
	tipLabel.TextWrapped = true

	targetPart = Instance.new("Part")
	targetPart.Name = "TutorialTarget"
	targetPart.Anchored = true
	targetPart.CanCollide = false
	targetPart.CanQuery = false
	targetPart.CanTouch = false
	targetPart.Transparency = 1
	targetPart.Size = Vector3.new(1, 1, 1)
	targetPart.Parent = workspace
	local a1 = Instance.new("Attachment")
	a1.Name = "A1"
	a1.Parent = targetPart
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(60, 60)
	bb.StudsOffset = Vector3.new(0, 7, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Enabled = false
	bb.Parent = targetPart
	-- v0.9.12: a gold arrow built from frames (matches the gold guide line; the old emoji was a blue box)
	local GOLD = Color3.fromRGB(255, 206, 50)
	local arrow = UI.new("Frame", { Name = "Arrow", Parent = bb, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local head = UI.new("Frame", { Name = "Head", Parent = arrow, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.fromScale(0.5, 0.5), Rotation = 45, BackgroundColor3 = GOLD, BorderSizePixel = 0, ZIndex = 2 })
	UI.corner(4).Parent = head
	UI.stroke(Color3.fromRGB(120, 60, 10), 2).Parent = head
	local stem = UI.new("Frame", { Name = "Stem", Parent = arrow, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.04), Size = UDim2.fromScale(0.3, 0.5), BackgroundColor3 = GOLD, BorderSizePixel = 0 })
	UI.corner(4).Parent = stem
	UI.stroke(Color3.fromRGB(120, 60, 10), 2).Parent = stem
	TweenService:Create(arrow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromOffset(0, -12) }):Play()
	marker = bb
end

local function showTip(text: string)
	tipLabel.Text = text
	tipLabel.Visible = true
	task.delay(7, function()
		if tipLabel.Text == text then
			tipLabel.Visible = false
		end
	end)
end

local function tick()
	local p = profile
	local char = player.Character
	local step = current()
	local tutorialOn = p ~= nil and step <= #STEPS
	-- v0.9.3: the "JOIN THE NEXT MATCH?" card is the call to action while it's up (step 7 = join),
	-- so the tutorial card steps aside instead of stacking above it
	local joinGui = player:FindFirstChild("PlayerGui") and (player :: any).PlayerGui:FindFirstChild("CrumbleJoin")
	local joinCard = joinGui and joinGui:FindFirstChild("JoinCard")
	local joinUp = joinCard ~= nil and joinCard:IsA("GuiObject") and joinCard.Visible
	panel.Visible = tutorialOn and not joinUp
	if not tutorialOn then
		setArrow(nil)
		-- after the tutorial: one nudge toward the first spin
		if p and not spinHintShown and (p.Spins or 0) > 0 and (p.TotalSpins or 0) == 0 and char and char:GetAttribute("InRound") ~= true then
			spinHintShown = true
			showTip("YOU HAVE A SPIN! Open the VAULT.")
		end
		return
	end
	stepLabel.Text = string.format("TUTORIAL %d/%d", step, #STEPS)
	for i, seg in progressSegs do
		seg.BackgroundColor3 = i < step and Col.Good or (i == step and Col.Blue or Col.Panel2)
	end
	titleLabel.Text = STEPS[step].Title
	if not busy and not sent[step] then
		hintLabel.Text = hintOf(step)
	end
	if step == 4 then
		hintLabel.Text = hintOf(4) .. (strikes > 0 and string.format("  (try %d/6)", strikes) or "")
	end
	setArrow(targetFor(step))
	local inRange = char ~= nil and char:GetAttribute("InRange") == true
	local inRound = char ~= nil and char:GetAttribute("InRound") == true
	if step == 1 and inRange then
		complete(1)
	elseif step == 2 and shoves >= 2 then
		complete(2)
	elseif step == 4 and strikes >= 6 then
		complete(4)
	elseif step == 5 and InputController.RushReadyAt > rushMark then
		complete(5)
	elseif step == 6 and inRange and InputController.AssistHits > assistMark then
		complete(6)
	elseif step == 7 and inRound then
		complete(7)
	elseif step == 8 then
		local state = ReplicatedStorage:GetAttribute("State")
		if inRound and state == "Live" then
			if not wasInRound then
				wasInRound, roundStart, tipShown = true, os.clock(), 0
			end
			local tip = MATCH_TIPS[tipShown + 1]
			if tip and os.clock() - roundStart >= tip.At then
				tipShown += 1
				showTip(if isTouch() and (tip :: any).Touch then (tip :: any).Touch else tip.Text)
			end
		elseif wasInRound and (state == "Results" or not inRound) then
			complete(8)
		elseif state == "Results" or state == "Joining" or state == "Intermission" then
			-- (joined but the round already ended) count it anyway
			if not inRound then
				complete(8)
			end
		end
	elseif step == 9 then
		local boot = p and p.Weapons and p.Weapons.Boot
		if boot and boot.Level >= 2 then
			complete(9)
		end
	end
end

function TutorialController.Init()
	request = Net.GetFunction("Request")
	build()
	Net.Get("Profile").OnClientEvent:Connect(function(p)
		local before = profile and profile.Tutorial
		profile = p
		if type(before) == "number" and type(p.Tutorial) == "number" and p.Tutorial < before then
			-- the tutorial was restarted (REPLAY TUTORIAL in QUESTS): start counting again
			table.clear(sent)
			shoves, strikes, tipShown = 0, 0, 0
			wasInRound = false
			rushMark = InputController.RushReadyAt
			assistMark = InputController.AssistHits
			hintLabel.Text = ""
		end
	end)
	Net.Get("RangeResult").OnClientEvent:Connect(function(d)
		if type(d) == "table" and not d.Preview then
			shoves += 1
		end
	end)
	Net.Get("Spar").OnClientEvent:Connect(function(d)
		if type(d) ~= "table" then
			return
		end
		local step = current()
		if d.Kind == "Block" or d.Kind == "Parry" or d.Kind == "Hit" then
			if step == 4 then
				strikes += 1
			end
		end
		if step == 3 and (d.Kind == "Block" or d.Kind == "Parry") then
			complete(3)
		elseif step == 4 and d.Kind == "Parry" then
			complete(4)
		end
	end)
	rushMark = InputController.RushReadyAt
	assistMark = InputController.AssistHits
	while true do
		task.wait(0.25)
		local ok, err = pcall(tick)
		if not ok then
			warn("[CRUMBLE] tutorial:", err)
			task.wait(2)
		end
	end
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--[[
	CRUMBLE! — UI helper + "Toy Box" skin (v0.9.14; replaces v0.7.2 "Cozy Cards")
	v0.9.14: cream cards with a thick ink outline, flat saturated buttons with a dark outline and a
	solid bottom lip (no gloss), LuckiestGuy display font with solid ink-stroked text, and DRAWN icons
	(UI.icon) instead of emoji.
	UI.new("Frame", { props }, { children })

	Style (inspired by the big Roblox hits — Pet Simulator 99's chunky buttons, BedWars' clean
	readable panels): no sharp rectangles. Every visible box gets rounded corners, buttons get a
	top-lit gradient, a thick dark outline, outlined FredokaOne text and a squishy hover/press
	bounce; panels get a soft gradient and a thick outline. UI.Skin(screenGui) applies all of this
	automatically, including to elements created later (cards, kill-feed rows...).
	Put the attribute NoSkin = true on anything that must stay untouched.
]]

local TweenService = game:GetService("TweenService")
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))

local UI = {}

UI.Font = Enum.Font.FredokaOne -- body text
UI.Display = Enum.Font.LuckiestGuy -- v0.9.14: chunky game font for buttons + titles
UI.Outline = Color3.fromRGB(30, 26, 40) -- ink outline (panels, buttons, text over the world)
UI.Ink = Color3.fromRGB(42, 36, 52) -- body text on cream cards
UI.CardLine = Color3.fromRGB(30, 26, 40) -- v0.9.14: cards get a real ink outline

-- v0.9.14 "Toy Box" palette: warm cream cards with ink outlines, flat saturated buttons
UI.Colors = {
	Panel = Color3.fromRGB(255, 248, 232),
	Panel2 = Color3.fromRGB(246, 232, 206),
	Line = Color3.fromRGB(30, 26, 40),
	Text = Color3.fromRGB(42, 36, 52),
	Mute = Color3.fromRGB(128, 112, 100),
	Gold = Color3.fromRGB(240, 166, 20),
	Lava = Color3.fromRGB(255, 104, 46),
	Amber = Color3.fromRGB(240, 150, 20),
	Ice = Color3.fromRGB(40, 150, 240),
	Good = Color3.fromRGB(52, 186, 96),
	Bad = Color3.fromRGB(240, 70, 90),
	Blue = Color3.fromRGB(56, 140, 255),
}

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in props do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

-- top-lit vertical gradient (multiplies the object's own colour)
function UI.gradient(parent: GuiObject, bottom: Color3?): UIGradient
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), bottom or Color3.fromRGB(176, 180, 196))
	g.Parent = parent
	return g
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Line,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number): UIPadding
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function UI.label(props: { [string]: any }): TextLabel
	local base = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
		Text = "",
	}
	for k, v in props do
		base[k] = v
	end
	return UI.new("TextLabel", base)
end

function UI.button(props: { [string]: any }): TextButton
	local base = {
		BackgroundColor3 = UI.Colors.Panel2,
		Font = UI.Font,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
		AutoButtonColor = true,
		Text = "",
	}
	for k, v in props do
		base[k] = v
	end
	local b = UI.new("TextButton", base)
	UI.corner(14).Parent = b
	return b
end

-- v0.9.1: a drawn "X" (two rounded bars). The ✕ character isn't in Roblox's fonts and showed
-- up as an empty button, so close buttons draw their cross instead of typing it.
function UI.cross(parent: GuiObject, color: Color3?, thickness: number?, zIndex: number?)
	for _, rot in { 45, -45 } do
		local bar = Instance.new("Frame")
		bar.Name = "Cross"
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.new(0.6, 0, 0, thickness or 6)
		bar.Rotation = rot
		bar.BackgroundColor3 = color or Color3.new(1, 1, 1)
		bar.BorderSizePixel = 0
		bar.ZIndex = zIndex or (parent.ZIndex + 1)
		bar:SetAttribute("NoSkin", true)
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = bar
		bar.Parent = parent
	end
end

------------------------------------------------------------------------
-- v0.9.14 DRAWN ICONS (replace every emoji) — v0.9.15: the drawing code lives in Shared/Icons so
-- the lobby's SurfaceGui signs can use the same icons. UI.icon(name, props?, color?) -> Frame
------------------------------------------------------------------------
UI.IconColors = Icons.Colors
UI.icon = Icons.make

-- Put a drawn icon inside a label/button (centred, 80 %), replacing its text. name=nil removes it.
function UI.setIcon(host: GuiObject, name: string?, color: Color3?, scale: number?)
	local old = host:FindFirstChild("Icon")
	if old and old:GetAttribute("IconName") == name and old:GetAttribute("IconColor") == color then
		return
	end
	if old then
		old:Destroy()
	end
	if name then
		local sc = scale or 0.8
		local ic = UI.icon(name, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(sc, sc), ZIndex = host.ZIndex + 1, Parent = host }, color)
		ic:SetAttribute("IconColor", color)
		if host:IsA("TextLabel") or host:IsA("TextButton") then
			(host :: any).Text = ""
		end
	end
end

function UI.ordinal(n: number): string
	local s = "th"
	local m100 = n % 100
	if m100 < 11 or m100 > 13 then
		local m10 = n % 10
		if m10 == 1 then
			s = "st"
		elseif m10 == 2 then
			s = "nd"
		elseif m10 == 3 then
			s = "rd"
		end
	end
	return tostring(n) .. s
end

function UI.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function UI.comma(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

------------------------------------------------------------------------
-- Skin (v0.7.2 "Cozy Cards", modelled on the reference screenshot)
--  • light cards: near-white, soft 1.5 px border, ~10 px corners, flat (no heavy gradient)
--  • text on light cards turns dark ink; text on coloured buttons stays white with a
--    darker outline of the button colour; text floating over the world is white + dark outline
--  • buttons keep a small bounce; colours that change at runtime are re-checked
------------------------------------------------------------------------
local skinned: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function lum(c: Color3): number
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function sat(c: Color3): number
	local mx, mn = math.max(c.R, c.G, c.B), math.min(c.R, c.G, c.B)
	return if mx <= 0 then 0 else (mx - mn) / mx
end

-- background the text actually sits on (itself or the first visibly-filled ancestor)
local function effectiveBg(g: GuiObject): Color3?
	local cur: Instance? = g
	while cur and cur:IsA("GuiObject") do
		local o = cur :: GuiObject
		if o.BackgroundTransparency < 0.5 and o.Visible then
			return o.BackgroundColor3
		end
		cur = cur.Parent
	end
	return nil
end

local function fixText(t: any)
	if t:GetAttribute("NoSkin") then
		return
	end
	local bg = effectiveBg(t)
	local c: Color3 = t.TextColor3
	if bg == nil then
		-- over the 3D world: white with a dark outline (like the reference's floating labels)
		if lum(c) < 0.45 then
			t.TextColor3 = Color3.new(1, 1, 1)
		end
		t.TextStrokeColor3 = UI.Outline
		t.TextStrokeTransparency = 0
	elseif lum(bg) > 0.62 and sat(bg) < 0.35 then
		-- light card
		if lum(c) > 0.82 and sat(c) < 0.2 then
			t.TextColor3 = UI.Ink
		end
		if lum(t.TextColor3) > 0.62 then
			t.TextStrokeColor3 = UI.Ink
			t.TextStrokeTransparency = 0.35 -- light coloured text (gold, rarity) stays readable on cream
		else
			t.TextStrokeTransparency = 1
		end
	else
		-- coloured or dark fill
		if lum(c) < 0.45 then
			t.TextColor3 = Color3.new(1, 1, 1)
		end
		t.TextStrokeColor3 = Color3.new(bg.R * 0.38, bg.G * 0.38, bg.B * 0.38)
		t.TextStrokeTransparency = 0 -- v0.9.14: solid sticker outline
	end
end

local function isCard(bg: Color3): boolean
	return lum(bg) > 0.62 and sat(bg) < 0.35
end

-- nested inside another visible card? (inner cards get a lighter outline so it never gets busy)
local function insideCard(g: GuiObject): boolean
	local cur = g.Parent
	while cur and cur:IsA("GuiObject") do
		local o = cur :: GuiObject
		if o.BackgroundTransparency < 0.5 and isCard(o.BackgroundColor3) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

-- v0.9.14 chunky button: thick dark outline + a solid darker "lip" along the bottom (hard-stop
-- gradient, no gloss). Pure text buttons get bottom padding so the label sits on the face.
local function lip(b: GuiObject)
	local h = b.AbsoluteSize.Y
	local px = if h > 0 and h < 34 then 3 else 5
	local stop = if h > 0 then math.clamp(1 - px / h, 0.75, 0.97) else 0.88
	local g = b:FindFirstChild("Lip") :: UIGradient?
	if not g then
		local ng = Instance.new("UIGradient")
		ng.Name = "Lip"
		ng.Rotation = 90
		ng:SetAttribute("Keep", true)
		ng.Parent = b
		g = ng
	end
	local shade = Color3.fromRGB(176, 170, 186)
	;(g :: UIGradient).Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(stop - 0.001, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(stop, shade),
		ColorSequenceKeypoint.new(1, shade),
	})
	if b:IsA("TextButton") and not b:FindFirstChildOfClass("UIPadding") then
		local hasKids = false
		for _, c in b:GetChildren() do
			if c:IsA("GuiObject") then
				hasKids = true
				break
			end
		end
		if not hasKids then
			local pd = Instance.new("UIPadding")
			pd.Name = "LipPad"
			pd.PaddingBottom = UDim.new(0, px)
			pd.PaddingTop = UDim.new(0, 1)
			pd.Parent = b
		end
	end
end

local function fixButton(b: GuiObject)
	local st = b:FindFirstChildOfClass("UIStroke")
	if not st then
		st = Instance.new("UIStroke")
		st.Parent = b
	end
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local bg = b.BackgroundColor3
	if isCard(bg) then
		st.Color = UI.Outline
		st.Thickness = 2.5
	else
		st.Color = Color3.new(bg.R * 0.4, bg.G * 0.4, bg.B * 0.4)
		st.Thickness = 3
	end
	st.Transparency = 0
end

local function bounce(b: GuiButton)
	local sc = Instance.new("UIScale")
	sc.Name = "Bounce"
	sc.Parent = b
	local function to(v: number)
		TweenService:Create(sc, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = v }):Play()
	end
	b.MouseEnter:Connect(function()
		to(1.05)
	end)
	b.MouseLeave:Connect(function()
		to(1)
	end)
	b.MouseButton1Down:Connect(function()
		to(0.94)
	end)
	b.MouseButton1Up:Connect(function()
		to(1.03)
	end)
end

function UI.SkinOne(inst: Instance)
	if skinned[inst] or not inst:IsA("GuiObject") or inst:GetAttribute("NoSkin") then
		return
	end
	skinned[inst] = true
	local g = inst :: GuiObject
	local isText = g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox")
	if isText then
		local t = g :: any
		if t.Font == Enum.Font.GothamBlack or t.Font == Enum.Font.GothamBold or t.Font == Enum.Font.SourceSansBold or t.Font == Enum.Font.Gotham then
			t.Font = UI.Font
		end
		-- v0.9.14: buttons + big scaled titles use the chunky display font
		if t.TextScaled and t.Font == UI.Font and not t.RichText and (g:IsA("TextButton") or g.AbsoluteSize.Y >= 30) then
			t.Font = UI.Display
		end
		fixText(t)
		g:GetPropertyChangedSignal("TextColor3"):Connect(function()
			fixText(t)
		end)
	end
	local visible = g.BackgroundTransparency < 0.9
	if visible then
		local a = g.AbsoluteSize
		local md = math.min(a.X, a.Y)
		local radius = if md > 0 then math.clamp(math.floor(md * 0.22), 6, 10) else 8
		local corner = g:FindFirstChildOfClass("UICorner")
		if not corner then
			corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, radius)
			corner.Parent = g
		end
		-- the old dark "bubbly" gradients don't belong on flat cards
		local grad = g:FindFirstChildOfClass("UIGradient")
		if grad and grad.Rotation == 90 and not grad:GetAttribute("Keep") then
			grad:Destroy()
		end
	end
	if g:IsA("TextButton") or g:IsA("ImageButton") then
		if visible then
			fixButton(g)
			lip(g)
			g:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
				fixButton(g)
				for _, d in g:GetDescendants() do
					if d:IsA("TextLabel") then
						fixText(d)
					end
				end
				if g:IsA("TextButton") then
					fixText(g)
				end
			end)
		end
		if not g:FindFirstChild("Bounce") then
			bounce(g :: GuiButton)
		end
	elseif visible and g:IsA("Frame") then
		local a = g.AbsoluteSize
		if math.min(a.X, a.Y) >= 40 then
			local st = g:FindFirstChildOfClass("UIStroke")
			if not st then
				st = Instance.new("UIStroke")
				st.Parent = g
			end
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			local bg = g.BackgroundColor3
			if isCard(bg) then
				-- v0.9.14: outer cards = 3 px ink; cards inside cards = a lighter 2 px line
				local inner = insideCard(g)
				st.Color = UI.Outline
				st.Thickness = inner and 2 or 3
				st.Transparency = inner and 0.6 or 0
			else
				st.Color = Color3.new(bg.R * 0.4, bg.G * 0.4, bg.B * 0.4)
				st.Thickness = 3
				st.Transparency = 0
			end
		end
	end
end

function UI.Skin(root: Instance)
	for _, d in root:GetDescendants() do
		UI.SkinOne(d)
	end
	root.DescendantAdded:Connect(function(d)
		task.defer(UI.SkinOne, d) -- after the creating code has set its own colours/corners
	end)
end

return UI
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="58">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	CRUMBLE! — Client bootstrap
	v0.7.5: every controller starts in its own protected thread, so one failing (or slow) controller
	can never stop the others — e.g. the "Join the next match?" card always gets built.
]]

local Controllers = script.Parent:WaitForChild("Controllers")

local KnockbackController = require(Controllers.KnockbackController)
local EffectsController = require(Controllers.EffectsController)
local AnimationController = require(Controllers.AnimationController)
local InputController = require(Controllers.InputController)
local TouchController = require(Controllers.TouchController)
local AfkController = require(Controllers.AfkController)
local CameraController = require(Controllers.CameraController)
local HUDController = require(Controllers.HUDController)
local MenuController = require(Controllers.MenuController)
local JoinController = require(Controllers.JoinController)
local MoodController = require(Controllers.MoodController)
local TutorialController = require(Controllers.TutorialController)

local function start(name: string, init: () -> ())
	task.spawn(function()
		local ok, err = pcall(init)
		if not ok then
			warn(("[CRUMBLE] %s failed to start: %s"):format(name, tostring(err)))
		end
	end)
end

start("Knockback", KnockbackController.Init)
start("Effects", EffectsController.Init)
start("Animation", AnimationController.Init)
start("Join", JoinController.Init)
start("Input", InputController.Init)
start("Touch", TouchController.Init) -- v1.0 patch 5: custom joystick + jump + fight buttons
start("Afk", AfkController.Init) -- v1.0 patch 5: big AFK card + gold glow
start("Camera", CameraController.Init) -- v1.0.1: first person when zoomed all the way in

-- v1.0 patch 8: tell the server we really LOADED (UI up + character spawned) and on which device,
-- for the owner's visitor log
start("Hello", function()
	local Players = game:GetService("Players")
	local UIS = game:GetService("UserInputService")
	local Layout = require(Controllers.Layout)
	local Net = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Net"))
	local lp = Players.LocalPlayer
	if not lp.Character then
		lp.CharacterAdded:Wait()
	end
	task.wait(2)
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local device = if Layout.IsTouch() then (if math.min(vp.X, vp.Y) <= 500 then "phone" else "tablet")
		elseif UIS.GamepadEnabled and not UIS.KeyboardEnabled then "console"
		else "pc"
	for _ = 1, 5 do
		local ok, res = pcall(function()
			return Net.GetFunction("Request"):InvokeServer("Hello", device)
		end)
		if ok and type(res) == "table" and res.Ok then
			break
		end
		task.wait(3)
	end
end)
start("HUD", HUDController.Init)
start("Menu", MenuController.Init)
start("Mood", MoodController.Init)
start("Tutorial", TutorialController.Init)

KnockbackController.OnLaunched(function(speed: number)
	EffectsController.Shake(math.clamp(speed / 90, 0.2, 1))
end)

-- v0.9.22 VIP pass: gold [VIP] in front of the name in chat (TextChatService only; legacy chat skips it)
start("VipChat", function()
	local TextChatService = game:GetService("TextChatService")
	local Players = game:GetService("Players")
	-- pcall: legacy chat / test harnesses don't have the callback
	pcall(function()
		TextChatService.OnIncomingMessage = function(message: TextChatMessage)
			local props = Instance.new("TextChatMessageProperties")
			local src = message.TextSource
			local pl = src and Players:GetPlayerByUserId(src.UserId)
			if pl and pl:GetAttribute("Pass_VIP") == true then
				props.PrefixText = '<font color="#FFC428">[VIP]</font> ' .. message.PrefixText
			end
			return props
		end
	end)
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="59">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-200</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>